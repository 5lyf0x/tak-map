]).length;const chipEl=$(\'localElevToolStatus\');if(chipEl)chipEl.textContent=\'Local: \'+n}catch(_){} }\n  function renderSelected(){try{const box=$(\'localElevSelected\'), files=state().pendingFiles||[];if(!box)return;if(!files.length){box.textContent=\'No selected files.\';return}box.innerHTML=files.map(function(f,i){const kind=fileKind(f.name), size=fmtSize(f.size), usable=isGeoTiff(f);return \'<div>\'+ (i+1)+\'. \'+esc(f.name||\'file\')+\' <span class="muted">(\'+esc(kind)+\', \'+esc(size)+(usable?\'\':\', not importable in v371\')+\')</span></div>\'}).join(\'\')}catch(_){} }\n  function briefBbox(b){try{return Array.isArray(b)&&b.length>=4?b.map(function(x){return Number(x).toFixed(5)}).join(\', \'):\'not available\'}catch(_){return \'not available\'}}\n  function renderIndexed(){try{const box=$(\'localElevList\');if(!box)return;const st=state();let arr=Array.isArray(st.meta)?st.meta:[];if(!arr.length){box.textContent=\'No local elevation GeoTIFF metadata imported in this browser session yet.\';updateToolStatus();return}box.innerHTML=arr.slice(0,100).map(function(m){return \'<div class="meta-row"><b>\'+esc(m.name||m.id||\'GeoTIFF\')+\'</b> <span class="muted">\'+esc(fmtSize(m.sizeBytes||0))+\'</span><br><span class="muted">\'+esc(m.width)+\'×\'+esc(m.height)+\' px · samples \'+esc(m.samplesPerPixel||\'?\')+\' · bbox \'+esc(briefBbox(m.bbox))+\'</span></div>\'}).join(\'\');updateToolStatus()}catch(_){} }\n  function ensureToolsButton(){try{let btn=$(\'localElevAddBtn\');if(!btn){const panel=qa(\'.panel\').find(function(p){return /tools/i.test((q(\'h2\',p)||{}).textContent||\'\')});if(panel){const row=d.createElement(\'div\');row.className=\'row local-elev-tools-row\';row.innerHTML=\'<button id="localElevAddBtn" class="layer-button" type="button">Add Elevation Data</button><span id="localElevToolStatus" class="chip local-elev-tool-chip">Local: 0</span>\';const ref=qa(\'button\',panel).find(function(b){return /export all data/i.test(b.textContent||\'\')});if(ref