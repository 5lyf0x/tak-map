        _base_adsb = r'''function iconFor(a){
    const s=stableAdsbState(a);
    const p=s.category==='military'?'mil':s.category==='govt'?'gov':s.category==='unknown'?'unk':'civ';
    return `/assets/adsb/adsb_${p}_${s.is_helo?'helo':'fixed'}.png`;
  }
  const adsbStableById=new Map();
  const adsbTrackState=window.takMapAdsbTrackState||{id:null,meta:null,points:[],trackLayer:null,labelLayer:null,line:null,label:null};
  window.takMapAdsbTrackState=adsbTrackState;
  function adsbId(a){return String((a&&(a.id||a.hex||a.icao||a.uid||a.callsign||a.registration))||'').trim().toLowerCase()}
  function adsbClassPriority(c){return c==='military'?4:c==='govt'?3:c==='civil'?2:c==='unknown'?1:0}
  function detectAdsbCategory(a){
    const raw=String((a&&a.category)||'').toLowerCase();
    if(raw==='military'||raw==='mil')return 'military';
    if(raw==='govt'||raw==='government'||raw==='public')return 'govt';
    if(raw==='unknown'||raw==='unk')return 'unknown';
    const blob=String([a&&a.type,a&&a.category,a&&a.owner_operator,a&&a.operator,a&&a.description,a&&a.registration,a&&a.callsign,a&&a.aircraft_type,a&&a.source].filter(Boolean).join(' ')).toUpperCase();
    if(/\b(MILITARY|USAF|USN|USMC|ARMY|NAVY|AIR FORCE|AFSOC|RCH|VIPER)\b/.test(blob)||blob.includes('A-F-A'))return 'military';
    if(/\b(LAW ENFORCEMENT|POLICE|SHERIFF|FIRE DEPT|FIRE DEPARTMENT|PUBLIC SAFETY|EMS|RESCUE|CHP|CAL FIRE|USFS|MEDICAL|HOSPITAL|RESPONSE|LAPD|FD|PD)\b/.test(blob))return 'govt';
    if(raw==='civil'||raw==='civ'||raw==='commercial')return 'civil';
    return raw||'unknown';
  }
  function detectAdsbHelo(a){
    const blob=String([a&&a.is_helo?'HELO':'',a&&a.type,a&&a.category,a&&a.aircraft_type,a&&a.description,a&&a.emitter_category,a&&a.model,a&&a.registration,a&&a.callsign,a&&a.source].filter(Boolean).join(' ')).toUpperCase();
    return !!(a&&a.is_helo)||/\b(HELICOPTER|HELO|ROTOR|ROTARY|GYRO|GYROCOPTER|BELL|ROBINSON|EUROCOPTER|AIRBUS HELICOPTERS|SIKORSKY|AGUSTA|LEONARDO|R22|R44|R66|H60|UH60|MH60|HH60|CH47|AH64|AS350|AS50|EC35|EC45|H125|H135|H145|B407|B412|S76|S92)\b/.test(blob)||/\b(A7|B7|H1|H2|H3|H4|H5|H6|H7|H8|H9)\b/.test(blob);
  }
  function stableAdsbState(a){
    const id=adsbId(a);let prev=id?adsbStableById.get(id):null;const cat=detectAdsbCategory(a);const helo=detectAdsbHelo(a);
    if(!prev)prev={category:cat||'unknown',is_helo:!!helo};
    else{
      if(helo)prev.is_helo=true;
      if(adsbClassPriority(cat)>=adsbClassPriority(prev.category))prev.category=cat||prev.category;
      else if(!prev.category||prev.category==='unknown')prev.category=cat||prev.category;
    }
    if(id)adsbStableById.set(id,prev);
    return prev;
  }
  function adsbMap(){try{return (typeof map!=='undefined'&&map)||window.map||window.takLeafletMap||null}catch(_){return window.map||window.takLeafletMap||null}}
  function ensureAdsbTrackLayers(){const m=adsbMap();if(!window.L||!m)return null;if(!adsbTrackState.trackLayer)adsbTrackState.trackLayer=L.layerGroup().addTo(m);else if(!m.hasLayer(adsbTrackState.trackLayer))adsbTrackState.trackLayer.addTo(m);if(!adsbTrackState.labelLayer)adsbTrackState.labelLayer=L.layerGroup().addTo(m);else if(!m.hasLayer(adsbTrackState.labelLayer))adsbTrackState.labelLayer.addTo(m);return {map:m,track:adsbTrackState.trackLayer,label:adsbTrackState.labelLayer}}
  function trackMeters(pts){let m=0;for(let i=1;i<(pts||[]).length;i++){const a=pts[i-1],b=pts[i];try{m+=L.latLng(a.lat,a.lon).distanceTo(L.latLng(b.lat,b.lon))}catch(_){}}return m}
  function adsbDistText(m){return (m/1609.344).toFixed(1)+'mi/'+(m/1000).toFixed(1)+'km'}
  function clearTrackVisual(){try{if(adsbTrackState.trackLayer)adsbTrackState.trackLayer.clearLayers();if(adsbTrackState.labelLayer)adsbTrackState.labelLayer.clearLayers()}catch(_){}}
  function redrawAdsbTrack(){const layers=ensureAdsbTrackLayers();if(!layers)return;layers.track.clearLayers();layers.label.clearLayers();const ll=(adsbTrackState.points||[]).map(p=>[p.lat,p.lon]);if(ll.length>=2){adsbTrackState.line=L.polyline(ll,{color:'#ff3b30',weight:4,opacity:.98,lineCap:'round',lineJoin:'round',interactive:false}).addTo(layers.track);try{adsbTrackState.line.bringToFront()}catch(_){}}if(ll.length>=1){const txt=adsbDistText(trackMeters(adsbTrackState.points));adsbTrackState.label=L.marker(ll[ll.length-1],{interactive:false,zIndexOffset:1900,icon:L.divIcon({className:'adsb-track-distance-label-wrap',html:'<div class="adsb-track-distance-label">'+esc(txt)+'</div>',iconAnchor:[0,0]})}).addTo(layers.label)}syncAdsbTrackButtons()}
  function addAdsbTrackPoint(a){if(!a||adsbId(a)!==adsbTrackState.id)return;const lat=Number(a.lat),lon=Number(a.lon);if(!Number.isFinite(lat)||!Number.isFinite(lon))return;const pts=adsbTrackState.points||(adsbTrackState.points=[]);const last=pts[pts.length-1];const now=Date.now();if(last){let d=0;try{d=L.latLng(last.lat,last.lon).distanceTo(L.latLng(lat,lon))}catch(_){}if(d<2&&(now-(last.t||0))<3000)return;}pts.push({lat:lat,lon:lon,alt:Number(a.altitude_ft)||0,t:now});if(pts.length>3000)pts.splice(0,pts.length-3000);adsbTrackState.meta=a;redrawAdsbTrack()}
  function syncAdsbTrackButtons(){const id=adsbTrackState.id;document.querySelectorAll('.adsb-track-btn').forEach(function(b){const bid=String(b.dataset.adsbTrackId||'').toLowerCase();const on=!!id&&bid===id;b.classList.toggle('active',on);b.classList.toggle('tracking',on);b.dataset.adsbTracking=on?'1':'0';const dot=b.querySelector('.adsb-track-light');if(dot)dot.classList.toggle('active',on);const t=b.querySelector('.adsb-track-text');if(t)t.textContent=on?'Untrack':'Track';else if(!b.querySelector('.adsb-track-light'))b.textContent=on?'Untrack':'Track';})}
  function saveDialog(id,meta,pts){try{const old=document.getElementById('adsbTrackSaveDialog');if(old)old.remove();pts=(pts||[]).slice();const title=String((meta&&(meta.callsign||meta.flight||meta.registration||meta.hex||meta.id))||id||'ADS-B Aircraft').trim();const meters=trackMeters(pts);const stamp=new Date().toISOString().slice(0,19).replace(/[T:]/g,'-');const def=(title+' ADS-B Track '+stamp).replace(/[^A-Za-z0-9_. -]+/g,'_').trim();const can=pts.length>=2;const div=document.createElement('div');div.id='adsbTrackSaveDialog';div.className='adsb-track-save-overlay';div.innerHTML='<div class="adsb-track-save-card" role="dialog" aria-modal="true"><button type="button" class="adsb-track-save-x" data-act="discard">×</button><div class="adsb-track-save-title">Save ADS-B Track</div><div class="adsb-track-save-sub">'+esc(title)+' · '+esc(adsbDistText(meters))+' · '+esc(String(pts.length))+' pts</div><input id="adsbTrackRouteName" class="adsb-track-save-input" value="'+esc(def)+'" '+(can?'':'disabled')+'>'+(can?'':'<div class="adsb-track-save-error">At least 2 track points are required to save a route.</div>')+'<div id="adsbTrackSaveMsg" class="adsb-track-save-msg"></div><div class="adsb-track-save-actions"><button type="button" class="layer-button" data-act="discard">Discard</button><button type="button" class="layer-button primary" data-act="save" '+(can?'':'disabled')+'>Save</button></div></div>';document.body.appendChild(div);const msg=document.getElementById('adsbTrackSaveMsg');div.addEventListener('click',async function(ev){const act=ev.target&&ev.target.getAttribute&&ev.target.getAttribute('data-act');if(act==='discard'||ev.target===div){ev.preventDefault();div.remove();clearTrackVisual();return}if(act==='save'&&can){ev.preventDefault();try{if(msg)msg.textContent='Saving…';const name=String((document.getElementById('adsbTrackRouteName')||{}).value||def).replace(/[^A-Za-z0-9_. -]+/g,'_').trim()||def;const fc={type:'FeatureCollection',features:[{type:'Feature',geometry:{type:'LineString',coordinates:pts.map(p=>[p.lon,p.lat,p.alt||0])},properties:{name:name,kind:'route',geometry:'route',source:'TAK Map ADS-B',route_type:'adsb_aircraft_track',point_count:pts.length,distance_miles:Number((meters/1609.344).toFixed(3)),distance_km:Number((meters/1000).toFixed(3)),distance_text:adsbDistText(meters)}}]};const file=new File([new Blob([JSON.stringify(fc,null,2)],{type:'application/geo+json'})],name+'.geojson',{type:'application/geo+json'});const fd=new FormData();fd.append('files',file,file.name);const r=await fetch('/api/tak-map/import',{method:'POST',body:fd,cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);try{if(typeof refreshLocalData==='function')await refreshLocalData()}catch(_){}try{if(typeof drawImportedObjects==='function')drawImportedObjects()}catch(_){}if(msg)msg.textContent='Saved';setTimeout(()=>{div.remove();clearTrackVisual()},450)}catch(e){if(msg){msg.textContent='Save failed: '+String(e&&e.message||e);msg.classList.add('bad')}}}});setTimeout(()=>{try{(document.getElementById('adsbTrackRouteName')||div.querySelector('[data-act="discard"]')).focus()}catch(_){}},30)}catch(e){console.warn('ADS-B save dialog failed',e);clearTrackVisual()}}
  function startAdsbTrack(id){id=String(id||'').toLowerCase();if(!id)return false;adsbTrackState.id=id;adsbTrackState.points=[];adsbTrackState.meta=null;clearTrackVisual();const a=(window.lastAircraft||[]).find(x=>adsbId(x)===id);if(a)addAdsbTrackPoint(a);syncAdsbTrackButtons();return true}
  function stopAdsbTrack(){const id=adsbTrackState.id,meta=adsbTrackState.meta,pts=(adsbTrackState.points||[]).slice();adsbTrackState.id=null;adsbTrackState.meta=null;adsbTrackState.points=[];syncAdsbTrackButtons();saveDialog(id,meta,pts);return false}
  function toggleAdsbTrack(id){id=String(id||'').toLowerCase();if(!id)return false;if(adsbTrackState.id===id)return stopAdsbTrack();if(adsbTrackState.id)stopAdsbTrack();return startAdsbTrack(id)}
  window.toggleAdsbTrack=toggleAdsbTrack;window.updateAdsbTrackPoint=addAdsbTrackPoint;window.syncAdsbTrackButtons=syncAdsbTrackButtons;
