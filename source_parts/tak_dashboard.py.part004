    _v371_script = '<script id="v371LocalElevationGeoTiffMetadataImportStableDialogPatch">\n\n(function(){\n  \'use strict\';\n  const V=\'v371\', d=document, w=window;\n  const MAX_MB=1024, WARN_MB=250, STRONG_WARN_MB=500;\n  let activeWorker=null, activeWorkerUrl=null, activeTimer=null, activeToken=0, activeFileName=\'\';\n  function $(id){try{return d.getElementById(id)}catch(_){return null}}\n  function q(s,r){try{return (r||d).querySelector(s)}catch(_){return null}}\n  function qa(s,r){try{return Array.from((r||d).querySelectorAll(s))}catch(_){return []}}\n  function esc(s){return String(s==null?\'\':s).replace(/[&<>"\']/g,function(c){return {\'&\':\'&amp;\',\'<\':\'&lt;\',\'>\':\'&gt;\',\'"\':\'&quot;\',"\'":\'&#39;\'}[c]})}\n  function stop(ev){try{if(ev){ev.preventDefault&&ev.preventDefault();ev.stopPropagation&&ev.stopPropagation();ev.stopImmediatePropagation&&ev.stopImmediatePropagation()}}catch(_){} }\n  function mb(bytes){return Math.round((Number(bytes)||0)/1048576)}\n  function fmtSize(bytes){const m=(Number(bytes)||0)/1048576;return m>=100?Math.round(m)+\' MB\':m>=10?m.toFixed(1)+\' MB\':m.toFixed(2)+\' MB\'}\n  function setVersion(){try{qa(\'.iteration-chip,.iteration-marker,[data-iteration]\').forEach(function(el){el.textContent=V;try{el.setAttribute(\'data-iteration\',V)}catch(_){}});d.documentElement.dataset.takMapIteration=V}catch(_){} }\n  function state(){w.takLocalElevation=w.takLocalElevation||{loaded:false,loading:null,tiles:new Map(),meta:[],pendingFiles:[]};if(!(w.takLocalElevation.tiles instanceof Map))w.takLocalElevation.tiles=new Map();if(!Array.isArray(w.takLocalElevation.meta))w.takLocalElevation.meta=[];if(!Array.isArray(w.takLocalElevation.pendingFiles))w.takLocalElevation.pendingFiles=[];return w.takLocalElevation}\n  function status(msg,kind){try{const el=$(\'localElevStatus\');if(!el)return;el.textContent=msg||\'\';el.classList.toggle(\'error\',kind===\'error\');el.classList.toggle(\'ok\',kind===\'ok\');el.classList.toggle(\'warn\',kind===\'warn\')}catch(_){} }\n  function chip(msg,kind){try{const el=$(\'localElevWorkerChip\');if(!el)return;el.textContent=msg||\'GeoTIFF worker: idle\';el.dataset.kind=kind||\'idle\'}catch(_){} }\n  function fileKind(name){name=String(name||\'\');if(/\\.hgt$/i.test(name))return \'SRTM HGT\';if(/\\.(dt0|dt1|dt2)$/i.test(name))return \'DTED\';if(/\\.(tif|tiff)$/i.test(name))return \'GeoTIFF/COG DEM\';if(/\\.zip$/i.test(name))return \'ZIP rejected\';return \'Unsupported\'}\n  function isGeoTiff(f){return !!(f&&/\\.(tif|tiff)$/i.test(String(f.name||\'\')))}\n  function isZip(f){return !!(f&&/\\.zip$/i.test(String(f.name||\'\')))}\n  function addCss(){try{if($(\'v371LocalElevationCss\'))return;const st=d.createElement(\'style\');st.id=\'v371LocalElevationCss\';st.textContent=`\n    #localElevationDialog.local-elev-dialog{position:fixed;inset:0;z-index:9600;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.34);box-sizing:border-box;}\n    #localElevationDialog.local-elev-dialog.active{display:flex!important;visibility:visible!important;opacity:1!important;pointer-events:auto!important;}\n    #localElevationDialog.local-elev-dialog:not(.active){display:none!important;visibility:hidden!important;opacity:0!important;pointer-events:none!important;}\n    #localElevationDialog .local-elev-card{width:min(660px,calc(100vw - 34px));max-height:calc(100vh - 42px);display:flex;flex-direction:column;border:1px solid rgba(53,69,86,.96);border-radius:16px;background:rgba(6,10,14,.97);box-shadow:0 22px 56px rgba(0,0,0,.58);color:#c7d1d7;overflow:hidden;}\n    #localElevationDialog .local-elev-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.08);background:rgba(18,29,37,.96);}\n    #localElevationDialog .local-elev-head h2{margin:0;font-size:.86rem;letter-spacing:.08em;text-transform:uppercase;color:#d7e1e8;}\n    #localElevationDialog .local-elev-close{width:32px;height:32px;border-radius:10px;border:1px solid #334553;background:#121d25;color:#c7d1d7;font-weight:950;cursor:pointer;}\n    #localElevationDialog .local-elev-body{padding:12px 14px;overflow:auto;}\n    #localElevationDialog .local-elev-note{margin:0 0 10px;color:#9fb0ba;font-size:.76rem;line-height:1.35;}\n    #localElevationDialog .local-elev-format-list{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:8px 0 10px;}\n    #localElevationDialog .local-elev-format-list span{border:1px solid rgba(255,255,255,.08);border-radius:10px;background:rgba(18,29,37,.55);padding:7px 8px;color:#cbd7dd;font-size:.70rem;font-weight:800;}\n    #localElevationDialog .local-elev-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:10px 0;}\n    #localElevationDialog .local-elev-actions button{margin:0;border:1px solid #334553;border-radius:10px;background:#121d25;color:#c7d1d7;font-size:.72rem;font-weight:850;padding:8px 10px;cursor:pointer;}\n    #localElevationDialog .local-elev-actions button:hover{border-color:#5b707a;background:#17252d;color:#fff;}\n    #localElevationDialog .local-elev-actions button:disabled{opacity:.48;cursor:not-allowed;}\n    #localElevationDialog .local-elev-primary,#localElevationDialog #localElevWorkerTest,#localElevationDialog #localElevImport{border-color:rgba(255,111,46,.48)!important;background:rgba(255,111,46,.11)!important;color:#ffd5c6!important;}\n    #localElevationDialog #localElevCancelImport{border-color:rgba(255,70,70,.38)!important;color:#ffb5ad!important;}\n    #localElevationDialog .local-elev-worker-chip{display:inline-flex;align-items:center;margin:7px 0 4px;padding:4px 9px;border:1px solid rgba(255,111,46,.36);border-radius:999px;background:rgba(255,111,46,.08);color:#ffb29d;font-size:.68rem;font-weight:950;letter-spacing:.02em;}\n    #localElevationDialog .local-elev-worker-chip[data-kind="ok"]{border-color:rgba(80,190,130,.45);background:rgba(80,190,130,.08);color:#b9f3d0;}\n    #localElevationDial