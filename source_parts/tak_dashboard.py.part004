nt-weight:850}.adsb-track-save-msg{min-height:16px;color:#8ff0b6;font-size:.76rem;font-weight:850}.adsb-track-save-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}.mil-icon-grid,#milGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(74px,1fr));gap:7px;max-height:360px;overflow:auto}.mil-icon-card{min-height:76px;border:1px solid rgba(255,255,255,.12);background:rgba(7,12,18,.72);border-radius:10px;color:#dce8ee;font-size:10px;font-weight:800;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:5px}.mil-icon-card img{width:36px;height:36px;object-fit:contain}.mil-icon-card.selected{border-color:rgba(255,122,26,.85);box-shadow:0 0 0 2px rgba(255,122,26,.16)}.mil-empty{color:#ffb6a8;font-weight:800;padding:10px}\';document.head.appendChild(st)}\n  function boot(){version();addCss();ownGlobals();try{renderAircraft(aircraftList())}catch(_){}patchPopups();renderMil()}\n  window.addEventListener(\'click\',function(ev){const btn=ev.target&&ev.target.closest&&ev.target.closest(\'.adsb-track-btn\');if(btn)return ownClick(ev,btn);const card=ev.target&&ev.target.closest&&ev.target.closest(\'.mil-icon-card[data-mil-name]\');if(card){const name=card.dataset.milName;loadMil().then(function(icons){window.v233MilSelected=icons.find(function(ic){return ic.name===name})||{name:name};qa(\'.mil-icon-card\').forEach(function(c){c.classList.toggle(\'selected\',c===card)});try{if(typeof window.updateMilPreview===\'function\')window.updateMilPreview()}catch(_){}})}const vs=ev.target&&ev.target.closest&&ev.target.closest(\'#toolViewshed,[data-tool="viewshed"],button[onclick*="Viewshed"],button[title*="Viewshed"]\');if(vs){ev.preventDefault();ev.stopPropagation();ev.stopImmediatePropagation();openViewshed(ev)}},true);\n  try{new MutationObserver(function(){patchPopups();syncButtons()}).observe(document.documentElement,{subtree:true,childList:true})}catch(_){}\n  if(document.readyState===\'loading\')document.addEventList