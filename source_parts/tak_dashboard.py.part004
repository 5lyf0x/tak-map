# --- end TAK Map v327 TAK Client private key help ---


# --- TAK Map v328 TAK Client file detection ---
try:
    import re as _v328_re

    def _v328_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v328_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v328'", _html)
        _html = _v328_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v328', _html)
        _html = _v328_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v328', _html)
        _html = _v328_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v328\2', _html, flags=_v328_re.I)
        _html = _v328_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v328\2', _html, flags=_v328_re.I)
        _html = _v328_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v328\2', _html, flags=_v328_re.I)
        return _html

    def _v328_safe_username(raw):
        val=str(raw or '').strip()[:128]
        return ''.join(ch for ch in val if ch.isalnum() or ch in ('-','_','.','@'))

    def _v328_marker_flags(path_obj):
        out={'contains_cert':False,'contains_private_key':False,'read_error':''}
        try:
            if not path_obj.is_file() or path_obj.stat().st_size > 25*1024*1024:
                return out
            data=path_obj.read_bytes()[:131072]
            text=data.decode('utf-8','ignore')
            out['contains_cert']='BEGIN CERTIFICATE' in text
            out['contains_private_key']=bool(_v328_re.search(r'BEGIN (?:RSA |EC |OPENSSH |ENCRYPTED )?PRIVATE KEY', text))
        except Exception as e:
            out['read_error']=str(e)
        return out

    def _v328_ots_ca_roots():
        roots=[]
        def add(p):
            try:
                pp=Path(str(p)).expanduser()
                if pp.exists() and pp.is_dir() and pp not in roots:
                    roots.append(pp)
            except Exception:
                pass
        try:
            add(Path.home() / 'ots' / 'ca')
        except Exception:
            pass
        try:
            for pp in Path('/home').glob('*/ots/ca'):
                add(pp)
        except Exception:
            pass
        try:
            cfg=_tak_client_identity_load(include_secret=True)
            for k in ('client_cert_path','client_key_path','ca_cert_path'):
                v=str(cfg.get(k) or '').strip()
                if v:
                    try:
                        p=Path(v).expanduser()
                        for parent in [p.parent, p.parent.parent]:
                            if parent.exists() and parent.is_dir(): add(parent)
                    except Exception:
                        pass
        except Exception:
            pass
        return roots[:20]

    def _v328_file_candidate(p, username):
        try:
            suffix=p.suffix.lower()
            if suffix not in ('.pem','.key','.p12','.pfx','.csr','.crt'):
                return None
            st=None
            try: st=p.stat()
            except Exception: pass
            readable=os.access(str(p), os.R_OK)
            flags=_v328_marker_flags(p) if readable and suffix in ('.pem','.key','.crt') else {'contains_cert':False,'contains_private_key':False,'read_error':''}
            name=p.name.lower()
            path_lower=str(p).lower()
            u=username.lower()
            kind=[]
            if suffix == '.csr': kind.append('csr')
            if suffix in ('.p12','.pfx'): kind.append('bundle')
            if flags.get('contains_cert') or suffix in ('.pem','.crt'): kind.append('cert')
            if flags.get('contains_private_key') or suffix == '.key': kind.append('key')
            if name == 'ca.pem' or name in ('ca.crt','ca.cert') or path_lower.endswith('/ca.pem'):
                kind.append('ca')
            score=0
            if u and u in name: score+=60
            if u and u in path_lower: score+=30
            if suffix == '.key': score+=24
            if suffix == '.pem': score+=15
            if suffix in ('.p12','.pfx'): score+=12
            if flags.get('contains_private_key'): score+=60
            if flags.get('contains_cert'): score+=25
            if 'ca' in kind: score+=80
            if 'csr' in kind: score-=70
            if 'do-not-share' in path_lower or 'donotshare' in path_lower: score-=100
            if 'opentakserver' in path_lower and (not u or u not in path_lower): score-=60
            return {'path':str(p),'name':p.name,'suffix':suffix,'readable':bool(readable),'exists':True,'size':int(st.st_size) if st else None,'kinds':kind,'contains_cert':bool(flags.get('contains_cert')),'contains_private_key':bool(flags.get('contains_private_key')),'read_error':flags.get('read_error',''),'score':score}
        except Exception:
            return None

    def tak_map_tak_client_detect(payload):
        payload=payload if isinstance(payload,dict) else {}
        username=_v328_safe_username(payload.get('username') or '')
        if not username:
            return {'ok':False,'error':'Enter a TAK client username before detecting files.'}
        roots=_v328_ots_ca_roots()
        candidates=[]; seen=set(); max_files=4500
        for root in roots:
            try:
                for dirpath, dirnames, filenames in os.walk(str(root), followlinks=False):
                    dirnames[:] = [d for d in dirnames if d not in ('.git','__pycache__','.cache')]
                    for fn in filenames:
                        if len(candidates)>=max_files: break
                        low=fn.lower()
                        if not low.endswith(('.pem','.key','.p12','.pfx','.csr','.crt')): continue
                        p=Path(dirpath)/fn; sp=str(p)
                        if sp in seen: continue
                        seen.add(sp)
                        c=_v328_file_candidate(p, username)
                        if c: candidates.append(c)
                    if len(candidates)>=max_files: break
            except Exception:
                pass
        def by_score(items):
            return sorted(items, key=lambda x:(x.get('score',0), x.get('readable',False), x.get('path','')), reverse=True)
        u=username.lower()
        non_csr=[c for c in candidates if 'csr' not in c.get('kinds',[])]
        csr=[c for c in candidates if 'csr' in c.get('kinds',[])]
        ca_cands=by_score([c for c in candidates if 'ca' in c.get('kinds',[]) and c.get('readable')])
        cert_cands=by_score([c for c in non_csr if c.get('readable') and c.get('contains_cert') and (u in c.get('path','').lower()) and 'ca' not in c.get('kinds',[])])
        key_cands=by_score([c for c in non_csr if c.get('readable') and c.get('contains_private_key') and (u in c.get('path','').lower()) and 'ca' not in c.get('kinds',[])])
        key_cands=by_score(key_cands + [c for c in non_csr if c.get('readable') and c.get('suffix')=='.key' and (u in c.get('path','').lower()) and c not in key_cands and 'ca' not in c.get('kinds',[])])
        bundle_cands=by_score([c for c in non_csr if c.get('readable') and c.get('suffix') in ('.p12','.pfx') and (u in c.get('path','').lower())])
        rec={'client_cert_path': cert_cands[0]['path'] if cert_cands else '', 'client_key_path': key_cands[0]['path'] if key_cands else '', 'ca_cert_path': ca_cands[0]['path'] if ca_cands else ''}
        msg=[]
        if rec['client_cert_path']: msg.append('Client certificate candidate found.')
        if rec['client_key_path']: msg.append('Private key candidate found.')
        elif bundle_cands: msg.append('No separate private key was found, but a .p12/.pfx bundle was found. Use Private Key Help to extract it.')
        else: msg.append('No readable private key was found for this username.')
        if rec['ca_cert_path']: msg.append('CA certificate found.')
        if csr and not rec['client_key_path']: msg.append('.csr files are certificate signing requests; they cannot be used as a private key.')
        return {'ok':True,'username':username,'roots':[str(r) for r in roots],'recommendation':rec,'complete_recommendation':bool(rec['client_cert_path'] and rec['client_key_path'] and rec['ca_cert_path']),'message':' '.join(msg),'candidates':{'client_cert':cert_cands[:8],'client_key':key_cands[:8],'ca_cert':ca_cands[:8],'p12_pfx':bundle_cands[:8],'csr':by_score(csr)[:8]},'counts':{'files_scanned':len(candidates),'cert_candidates':len(cert_cands),'key_candidates':len(key_cands),'ca_candidates':len(ca_cands),'p12_pfx_candidates':len(bundle_cands),'csr_files':len(csr)}}

    _v328_old_post = Handler.do_POST
    def _v328_do_POST(self):
        parsed=urlparse(self.path)
        try:
            if parsed.path=='/api/tak-map/tak-client/detect':
                if not self._tak_map_auth_ok():
                    return self._require_tak_map_login()
                payload=_read_json_body(self)
                return self._send_json(tak_map_tak_client_detect(payload))
        except Exception as e:
            return self._send_json({'ok':False,'error':'TAK Client file detection failed: '+str(e),'traceback':traceback.format_exc()},500)
        return _v328_old_post(self)
    Handler.do_POST = _v328_do_POST

    def _v328_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v328_versions(_html)
        runtime=r'''
<script id="v328TakClientFileDetection">
(function(){
  'use strict';
  const V='v328';
  const d=document;
  let autoTimer=null;
  function byId(id){try{return d.getElementById(id)}catch(_){return null}}
  function q(sel,root){try{return (root||d).querySelector(sel)}catch(_){return null}}
  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}
  function field(id){return byId('takClient'+id)}
  function setOut(text,bad){const el=byId('takClientOutput');if(el){el.textContent=String(text||'');el.classList.toggle('bad',!!bad)}}
  function installCss(){try{if(byId('takClientDetectStyle'))return;const st=d.createElement('style');st.id='takClientDetectStyle';st.textContent=`.tak-client-detect-btn{border-color:rgba(57,217,138,.38)!important;background:rgba(57,217,138,.08)!important;color:#e9f0f5!important}.tak-client-help-note .csr-note{color:#ffdca0}`;d.head.appendChild(st)}catch(e){try{console.warn('TAK Client detect CSS failed',e)}catch(_){}}}
  function addDetectButton(){try{installCss();const actions=q('#takClientModal .tak-client-actions');if(!actions)return false;if(!byId('takClientDetectBtn')){const b=d.createElement('button');b.id='takClientDetectBtn';b.type='button';b.className='layer-button tak-client-detect-btn';b.textContent='Detect Files';b.onclick=function(){detectTakClientFiles(false)};const refresh=qa('button',actions).find(function(x){return /refresh/i.test(x.textContent||'')});actions.insertBefore(b, refresh||actions.lastChild)} bindAutoDetect();return true}catch(e){try{console.warn('TAK Client detect button failed',e)}catch(_){}return false}}
  function bindAutoDetect(){try{const u=field('Username'),p=field('Password');[u,p].forEach(function(el){if(!el||el.dataset.v328DetectBound)return;el.dataset.v328DetectBound='1';el.addEventListener('blur',function(){scheduleAutoDetect()});el.addEventListener('change',function(){scheduleAutoDetect()})})}catch(_){}}
  function pathsEmpty(){return !(String((field('CertPath')||{}).value||'').trim()||String((field('KeyPath')||{}).value||'').trim()||String((field('CaPath')||{}).value||'').trim())}
  function scheduleAutoDetect(){try{clearTimeout(autoTimer);autoTimer=setTimeout(function(){if(String((field('Username')||{}).value||'').trim()&&pathsEmpty())detectTakClientFiles(true)},350)}catch(_){} }
  function describeCandidates(j){try{let lines=[];const r=j.recommendation||{};if(r.client_cert_path)lines.push('Client certificate: '+r.client_cert_path);if(r.client_key_path)lines.push('Private key: '+r.client_key_path);if(r.ca_cert_path)lines.push('CA certificate: '+r.ca_cert_path);const c=j.candidates||{};if((c.p12_pfx||[]).length&&!r.client_key_path)lines.push('P12/PFX found: '+c.p12_pfx[0].path);if((c.csr||[]).length&&!r.client_key_path)lines.push('CSR note: .csr files are requests and cannot be used as private keys.');return lines.join('\n')}catch(_){return ''}}
  function fillDetected(j,force){try{const r=(j&&j.recommendation)||{};const cert=field('CertPath'),key=field('KeyPath'),ca=field('CaPath');if(cert&&r.client_cert_path&&(force||!cert.value.trim()))cert.value=r.client_cert_path;if(key&&r.client_key_path&&(force||!key.value.trim()))key.value=r.client_key_path;if(ca&&r.ca_cert_path&&(force||!ca.value.trim()))ca.value=r.ca_cert_path}catch(_){} }
  window.detectTakClientFiles=async function(auto){try{addDetectButton();const username=String((field('Username')||{}).value||'').trim();if(!username){if(!auto)setOut('Enter the TAK client username first.',true);return null}if(!auto)setOut('Detecting OpenTAKServer cert/key files for '+username+'...');const r=await fetch('/api/tak-map/tak-client/detect',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:username})});const j=await r.json().catch(function(){return {ok:false,error:'Bad detect response'}});if(!r.ok||!j.ok)throw new Error(j.error||('HTTP '+r.status));fillDetected(j,!auto);let msg=(j.message||'Detection finished.')+'\n'+describeCandidates(j);if(auto)msg='Auto-detected files after username entry.\n'+msg;setOut(msg.trim(),!j.complete_recommendation);return j}catch(e){if(!auto)setOut('TAK Client file detection failed: '+e,true);return {ok:false,error:String(e)}}};
  function updateHelpNote(){try{const modal=byId('takClientKeyHelpModal');if(!modal)return;const first=q('.tak-client-help-step',modal);if(first&&!/CSR files/i.test(first.textContent||'')){const p=d.createElement('p');p.className='tak-client-help-note';p.innerHTML='<span class="csr-note">CSR files are certificate signing requests and are not useful for TAK Client Setup. They do not contain the private key.</span>';first.appendChild(p)}}catch(_){} }
  const prevOpen=window.openTakClientSetup;if(typeof prevOpen==='function'&&!prevOpen.__v328DetectWrapped){const wrapped=function(){const r=prevOpen.apply(this,arguments);[80,250,650,1200].forEach(function(ms){setTimeout(function(){addDetectButton();updateHelpNote()},ms)});return r};wrapped.__v328DetectWrapped=true;window.openTakClientSetup=wrapped}
  const prevHelp=window.openTakClientKeyHelp;if(typeof prevHelp==='function'&&!prevHelp.__v328CsrWrapped){const hw=function(){const r=prevHelp.apply(this,arguments);setTimeout(updateHelpNote,50);return r};hw.__v328CsrWrapped=true;window.openTakClientKeyHelp=hw}
  function boot(){installCss();addDetectButton();updateHelpNote();qa('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,220)},{once:true});else setTimeout(boot,220);
  [800,1800,3600].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
'''
        if 'id="v328TakClientFileDetection"' not in _html and "id='v328TakClientFileDetection'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v328_versions(_html)

    TAK_MAP_HTML = _v328_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML = _v328_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = _v328_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE', 'map')).strip().lower() == 'map':
        INDEX_HTML = TAK_MAP_HTML
except Exception as _v328_exc:
    try: print('v328 TAK Client file detection patch failed:', _v328_exc)
    except Exception: pass
# --- end TAK Map v328 TAK Client file detection ---


# --- TAK Map v330 TAK Client certificate automation ---
try:
    import re as _v330_re

    def _v330_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v330_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v330'", _html)
        _html = _v330_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v330', _html)
        _html = _v330_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v330', _html)
        _html = _v330_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v330\2', _html, flags=_v330_re.I)
        _html = _v330_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v330\2', _html, flags=_v330_re.I)
        _html = _v330_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v330\2', _html, flags=_v330_re.I)
        return _html

    def _v330_safe_username(value):
        u=str(value or '').strip()
        if not u or len(u)>64 or not _v330_re.match(r'^[A-Za-z0-9_.@-]+$', u):
            raise ValueError('Enter a TAK client username using letters, numbers, dot, dash, underscore, or @ only.')
        return u

    def _v330_client_cert_dir(username):
        u=_v330_safe_username(username)
        return DATA_DIR / 'client-certs' / u

    def _v330_find_ots_ca_dirs():
        roots=[]
        try:
            env=os.environ.get('TAK_MAP_OTS_CA_DIR','').strip()
            if env:
                roots.append(Path(env).expanduser())
        except Exception:
            pass
        try:
            cfg=_tak_client_identity_load(include_secret=True)
            for key in ('client_cert_path','client_key_path','ca_cert_path'):
                v=str(cfg.get(key) or '').strip()
                if v:
                    pp=Path(v).expanduser()
                    for parent in [pp.parent, pp.parent.parent, pp.parent.parent.parent]:
                        if parent and parent not in roots:
                            roots.append(parent)
        except Exception:
            pass
        try:
            for home in Path('/home').glob('*'):
                ca=home/'ots'/'ca'
                if ca not in roots:
                    roots.append(ca)
        except Exception:
            pass
        try:
            ca=Path.home()/'ots'/'ca'
            if ca not in roots:
                roots.append(ca)
        except Exception:
            pass
        out=[]; seen=set()
        for r in roots:
            try:
                rp=r.resolve() if r.exists() else r
                key=str(rp)
                if key in seen:
                    continue
                seen.add(key)
                out.append(rp)
            except Exception:
                pass
        return out

    def _v330_find_ca_pair():
        key_names=('ca-do-not-share.key','ca.key','ca.pem.key')
        cert_names=('ca.pem','ca.crt')
        for ca_dir in _v330_find_ots_ca_dirs():
            try:
                if not ca_dir.exists() or not ca_dir.is_dir():
                    continue
                ca_cert=None
                for n in cert_names:
                    p=ca_dir/n
                    if p.exists() and p.is_file() and os.access(str(p), os.R_OK):
                        ca_cert=p; break
                if not ca_cert:
                    continue
                ca_key=None
                for n in key_names:
                    p=ca_dir/n
                    if p.exists() and p.is_file() and os.access(str(p), os.R_OK):
                        ca_key=p; break
                if not ca_key:
                    for p in ca_dir.glob('*.key'):
                        try:
                            name=p.name.lower()
                            if 'opentakserver' in name or 'server' in name:
                                continue
                            if ('ca' in name or 'do-not-share' in name) and p.is_file() and os.access(str(p), os.R_OK):
                                ca_key=p; break
                        except Exception:
                            pass
                if ca_cert and ca_key:
                    return ca_cert, ca_key, ca_dir
            except Exception:
                pass
        return None, None, None

    def _v330_run(cmd, timeout=45, input_text=None):
        return subprocess.run(cmd, input=input_text, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout, check=False)

    def _v330_sign_client_cert_direct(username, ca_passphrase=""):
        u=_v330_safe_username(username)
        ca_cert, ca_key, ca_dir = _v330_find_ca_pair()
        if not ca_cert or not ca_key:
            return {'ok':False,'error':'Local OpenTAKServer CA certificate/key were not found or are not readable by TAK Map. A server admin can install ACL access or generate the client cert/key manually.'}
        outdir=_v330_client_cert_dir(u)
        outdir.mkdir(parents=True, exist_ok=True)
        key=outdir/(u+'.key')
        csr=outdir/(u+'.csr')
        cert=outdir/(u+'.pem')
        ca_out=outdir/'ca.pem'
        ca_passphrase=str(ca_passphrase or '')
        sign_cmd=['openssl','x509','-req','-in',str(csr),'-CA',str(ca_cert),'-CAkey',str(ca_key),'-CAcreateserial','-out',str(cert),'-days','3650','-sha256']
        if ca_passphrase:
            sign_cmd.extend(['-passin','pass:'+ca_passphrase])
        for cmd in [
            ['openssl','genrsa','-out',str(key),'2048'],
            ['openssl','req','-new','-key',str(key),'-out',str(csr),'-subj','/CN='+u],
            sign_cmd
        ]:
            r=_v330_run(cmd, timeout=60)
            if r.returncode != 0:
                err=(r.stderr or r.stdout or '').strip()
                low=err.lower()
                if 'enter pass phrase' in low or 'unable to get passphrase' in low or 'bad decrypt' in low or 'could not read private key' in low:
                    return {'ok':False,'requires_ca_passphrase':True,'error':'CA key found, but a passphrase is required. OpenTAKServer commonly uses the default CA key passphrase: atakatak','step':'openssl x509 -req'}
                return {'ok':False,'error':'OpenSSL failed while generating client certificate: '+err,'step':' '.join(cmd[:3])}
        try:
            shutil.copyfile(str(ca_cert), str(ca_out))
        except Exception as e:
            return {'ok':False,'error':'Client cert was generated but CA copy failed: '+str(e)}
        try: os.chmod(str(outdir),0o700)
        except Exception: pass
        try: os.chmod(str(key),0o600)
        except Exception: pass
        for fp in (cert,csr,ca_out):
            try: os.chmod(str(fp),0o644)
            except Exception: pass
        return {'ok':True,'generated':True,'username':u,'paths':{'client_cert_path':str(cert),'client_key_path':str(key),'ca_cert_path':str(ca_out),'csr_path':str(csr)},'message':'Generated new TAK client certificate/key pair signed by the local OpenTAKServer CA.'}

    def _v330_generate_client_cert(username, ca_passphrase=""):
        direct=_v330_sign_client_cert_direct(username, ca_passphrase)
        if direct.get('ok'):
            return direct
        wrapper=Path('/usr/local/sbin/tak-map-action')
        sudo=shutil.which('sudo') or '/usr/bin/sudo'
        if wrapper.exists():
            try:
                cmd=[sudo,'-n',str(wrapper),'tak-client-generate',_v330_safe_username(username)]
                if str(ca_passphrase or ''):
                    cmd.append(str(ca_passphrase))
                r=_v330_run(cmd, timeout=90)
                if r.returncode==0:
                    try:
                        j=json.loads(r.stdout.strip().splitlines()[-1])
                        if isinstance(j, dict):
                            return j
                    except Exception:
                        pass
                    return {'ok':False,'error':'Generation wrapper returned an unparseable response: '+(r.stdout or r.stderr)[:800]}
                err=(r.stderr or r.stdout or '').strip()
                return {'ok':False,'error':direct.get('error','Generation failed')+' Wrapper also failed: '+err[:900]}
            except Exception as e:
                return {'ok':False,'error':direct.get('error','Generation failed')+' Wrapper call failed: '+str(e)}
        return direct

    def _v330_extract_p12(payload):
        payload=payload if isinstance(payload,dict) else {}
        u=_v330_safe_username(payload.get('username'))
        bundle_path=str(payload.get('bundle_path') or '').strip()
        if not bundle_path:
            return {'ok':False,'error':'No .p12/.pfx path was provided.'}
        bundle=Path(bundle_path).expanduser()
        if not bundle.exists() or not bundle.is_file():
            return {'ok':False,'error':'Bundle file was not found: '+str(bundle)}
        if not os.access(str(bundle), os.R_OK):
            return {'ok':False,'error':'Bundle file is not readable by TAK Map: '+str(bundle)}
        if bundle.suffix.lower() not in ('.p12','.pfx'):
            return {'ok':False,'error':'Selected file is not a .p12 or .pfx bundle.'}
        ca_cert, ca_key, ca_dir = _v330_find_ca_pair()
        ca_pem = ca_cert
        if not ca_pem:
            for ca_dir2 in _v330_find_ots_ca_dirs():
                p=ca_dir2/'ca.pem'
                if p.exists() and os.access(str(p), os.R_OK):
                    ca_pem=p; break
        outdir=_v330_client_cert_dir(u)
        outdir.mkdir(parents=True, exist_ok=True)
        cert=outdir/(u+'.pem')
        key=outdir/(u+'.key')
        ca_out=outdir/'ca.pem'
        pwd=str(payload.get('bundle_password') or payload.get('password') or '')
        pass_arg='pass:'+pwd
        for cmd in [
            ['openssl','pkcs12','-in',str(bundle),'-clcerts','-nokeys','-out',str(cert),'-passin',pass_arg],
            ['openssl','pkcs12','-in',str(bundle),'-nocerts','-nodes','-out',str(key),'-passin',pass_arg],
        ]:
            r=_v330_run(cmd, timeout=60)
            if r.returncode != 0:
                return {'ok':False,'error':'OpenSSL could not extract the .p12/.pfx bundle. Check the bundle password/passphrase. '+(r.stderr or r.stdout or '').strip()[:900]}
        if ca_pem:
            try: shutil.copyfile(str(ca_pem), str(ca_out))
            except Exception: pass
        try: os.chmod(str(outdir),0o700)
        except Exception: pass
        try: os.chmod(str(key),0o600)
        except Exception: pass
        for fp in (cert,ca_out):
            try:
                if fp.exists(): os.chmod(str(fp),0o644)
            except Exception: pass
        return {'ok':True,'extracted':True,'username':u,'paths':{'client_cert_path':str(cert),'client_key_path':str(key),'ca_cert_path':str(ca_out) if ca_out.exists() else ''},'message':'Extracted TAK client certificate/key from bundle.'}

    def _v330_tak_client_detect(payload):
        base=tak_map_tak_client_detect(payload)
        try:
            username=_v330_safe_username((payload or {}).get('username') or base.get('username'))
        except Exception:
            return base
        ca_cert, ca_key, ca_dir=_v330_find_ca_pair()
        wrapper_gen = Path('/usr/local/sbin/tak-map-action').exists()
        c=base.get('candidates') or {}
        rec=base.get('recommendation') or {}
        missing_key=not bool(rec.get('client_key_path'))
        has_bundle=bool(c.get('p12_pfx'))
        has_csr=bool(c.get('csr'))
        base['automation']={
            'can_generate': bool(missing_key and ((ca_cert and ca_key) or wrapper_gen)),
            'can_extract': bool(missing_key and has_bundle),
            'ca_cert_found': bool(ca_cert),
            'ca_signing_available': bool(ca_cert and ca_key),
            'missing_private_key': bool(missing_key),
            'csr_found': bool(has_csr),
            'p12_pfx_found': bool(has_bundle),
            'output_dir': str(_v330_client_cert_dir(username)),
        }
        if missing_key and has_csr:
            base['message']=(base.get('message','')+' Certificate/CSR files were found, but CSR files cannot be used as private keys.').strip()
        if missing_key and ((ca_cert and ca_key) or wrapper_gen):
            base['message']=(base.get('message','')+' TAK Map can generate a new client cert/key using the local OpenTAKServer CA.').strip()
        return base

    _v330_old_post=Handler.do_POST
    def _v330_do_POST(self):
        parsed=urlparse(self.path)
        try:
            if parsed.path=='/api/tak-map/tak-client/detect':
                if not self._tak_map_auth_ok():
                    return self._require_tak_map_login()
                payload=_read_json_body(self)
                return self._send_json(_v330_tak_client_detect(payload))
            if parsed.path=='/api/tak-map/tak-client/generate':
                if not self._tak_map_auth_ok():
                    return self._require_tak_map_login()
                payload=_read_json_body(self)
                username=_v330_safe_username(payload.get('username'))
                gen=_v330_generate_client_cert(username, str(payload.get('ca_passphrase') or ''))
                if not gen.get('ok'):
                    return self._send_json(gen,500)
                paths=gen.get('paths') or {}
                save_payload={'username':username,'password':str(payload.get('password') or ''),'client_cert_path':paths.get('client_cert_path',''),'client_key_path':paths.get('client_key_path',''),'ca_cert_path':paths.get('ca_cert_path','')}
                gen['saved_status']=tak_map_tak_client_save(save_payload)
                gen['status']=tak_map_tak_client_status()
                return self._send_json(gen)
            if parsed.path=='/api/tak-map/tak-client/extract':
                if not self._tak_map_auth_ok():
                    return self._require_tak_map_login()
                payload=_read_json_body(self)
                ext=_v330_extract_p12(payload)
                if not ext.get('ok'):
                    return self._send_json(ext,500)
                paths=ext.get('paths') or {}
                save_payload={'username':_v330_safe_username(payload.get('username')),'password':str(payload.get('password') or ''),'client_cert_path':paths.get('client_cert_path',''),'client_key_path':paths.get('client_key_path',''),'ca_cert_path':paths.get('ca_cert_path','')}
                ext['saved_status']=tak_map_tak_client_save(save_payload)
                ext['status']=tak_map_tak_client_status()
                return self._send_json(ext)
        except Exception as e:
            return self._send_json({'ok':False,'error':'TAK Client certificate automation failed: '+str(e),'traceback':traceback.format_exc()},500)
        return _v330_old_post(self)
    Handler.do_POST=_v330_do_POST

    def _v330_patch_html(_html):
        if not isinstance(_html,str):
            return _html
        _html=_v330_versions(_html)
        runtime=r'''
<script id="v330TakClientCertificateAutomation">
(function(){
  'use strict';
  const V='v330';
  const d=document;
  let lastDetect=null;
  function byId(id){try{return d.getElementById(id)}catch(_){return null}}
  function q(sel,root){try{return (root||d).querySelector(sel)}catch(_){return null}}
  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}
  function field(id){return byId('takClient'+id)}
  function esc(s){return String(s??'').replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c})}
  function setOut(text,bad){const el=byId('takClientOutput');if(el){el.textContent=String(text||'');el.classList.toggle('bad',!!bad)}}
  function installCss(){try{if(byId('takClientAutomationStyle'))return;const st=d.createElement('style');st.id='takClientAutomationStyle';st.textContent=`.tak-client-automation-slot{margin-top:10px;border:1px solid rgba(255,255,255,.10);border-radius:12px;background:rgba(255,255,255,.035);padding:9px;color:#c8d2da;font-size:.78rem;line-height:1.35}.tak-client-automation-slot.empty{display:none}.tak-client-automation-title{font-weight:950;text-transform:uppercase;letter-spacing:.08em;color:#e9f0f5;margin-bottom:6px}.tak-client-automation-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.tak-client-generate-btn{border-color:rgba(57,217,138,.44)!important;background:rgba(57,217,138,.10)!important}.tak-client-extract-btn{border-color:rgba(255,204,102,.44)!important;background:rgba(255,204,102,.10)!important}.tak-client-automation-slot code{color:#9ff3c4}.tak-client-auto-warn{color:#ffdca0}.tak-client-auto-bad{color:#ffb4ae}.tak-client-ca-passphrase-label{display:block;margin-top:8px;color:#9fb1b9;font-size:.76rem;font-weight:800}.tak-client-ca-passphrase-label input{width:100%;margin-top:4px;background:#081018;color:#e9f0f5;border:1px solid #314253;border-radius:10px;padding:8px 9px;font-size:.84rem}.tak-client-ca-passphrase-note{margin-top:4px;color:#9fb1b9;font-size:.74rem;line-height:1.3}`;d.head.appendChild(st)}catch(e){try{console.warn('TAK Client automation CSS failed',e)}catch(_){}}}
  function slot(){installCss();let s=byId('takClientAutomationSlot');if(s)return s;const out=byId('takClientOutput');if(!out)return null;s=d.createElement('div');s.id='takClientAutomationSlot';s.className='tak-client-automation-slot empty';out.insertAdjacentElement('afterend',s);return s}
  function ensureDetectButton(){try{const actions=q('#takClientModal .tak-client-actions');if(!actions)return;let b=byId('takClientDetectBtn');if(!b){b=d.createElement('button');b.id='takClientDetectBtn';b.type='button';b.className='layer-button tak-client-detect-btn';b.textContent='Detect Files';const refresh=qa('button',actions).find(function(x){return /refresh/i.test(x.textContent||'')});actions.insertBefore(b, refresh||actions.lastChild)}b.onclick=function(){detectTakClientFiles(false)};bindAutoDetect()}catch(e){try{console.warn('detect button ensure failed',e)}catch(_){}}}
  let autoTimer=null;
  function pathsEmpty(){return !(String((field('CertPath')||{}).value||'').trim()||String((field('KeyPath')||{}).value||'').trim()||String((field('CaPath')||{}).value||'').trim())}
  function bindAutoDetect(){try{[field('Username'),field('Password')].forEach(function(el){if(!el||el.dataset.v330DetectBound)return;el.dataset.v330DetectBound='1';el.addEventListener('blur',scheduleAutoDetect);el.addEventListener('change',scheduleAutoDetect)})}catch(_){} }
  function scheduleAutoDetect(){try{clearTimeout(autoTimer);autoTimer=setTimeout(function(){if(String((field('Username')||{}).value||'').trim()&&pathsEmpty())detectTakClientFiles(true)},450)}catch(_){} }
  function fillDetected(j,force){try{const r=(j&&j.recommendation)||{};const cert=field('CertPath'),key=field('KeyPath'),ca=field('CaPath');if(cert&&r.client_cert_path&&(force||!cert.value.trim()))cert.value=r.client_cert_path;if(key&&r.client_key_path&&(force||!key.value.trim()))key.value=r.client_key_path;if(ca&&r.ca_cert_path&&(force||!ca.value.trim()))ca.value=r.ca_cert_path}catch(_){} }
  function describeCandidates(j){try{let lines=[];const r=j.recommendation||{};if(r.client_cert_path)lines.push('Client certificate: '+r.client_cert_path);if(r.client_key_path)lines.push('Private key: '+r.client_key_path);if(r.ca_cert_path)lines.push('CA certificate: '+r.ca_cert_path);const c=j.candidates||{};if((c.p12_pfx||[]).length&&!r.client_key_path)lines.push('P12/PFX found: '+c.p12_pfx[0].path);if((c.csr||[]).length&&!r.client_key_path)lines.push('CSR note: .csr files are requests and cannot be used as private keys.');return lines.join('\n')}catch(_){return ''}}
  function renderAutomation(j){try{lastDetect=j||lastDetect;const s=slot();if(!s)return;const a=(lastDetect&&lastDetect.automation)||{};const c=(lastDetect&&lastDetect.candidates)||{};const r=(lastDetect&&lastDetect.recommendation)||{};let html='';const missingKey=!r.client_key_path;const p12=(c.p12_pfx||[])[0];if(missingKey&&(a.can_generate||a.can_extract||a.csr_found||a.p12_pfx_found)){html+='<div class="tak-client-automation-title">Automation</div>';if(a.csr_found)html+='<div class="tak-client-auto-warn">Certificate/CSR files were found, but CSR files cannot be used as private keys.</div>';if(a.can_generate)html+='<div>TAK Map can generate a new client cert/key pair signed by the local OpenTAKServer CA and store it under <code>'+esc(a.output_dir||'TAK Map data directory')+'</code>.</div><label class="tak-client-ca-passphrase-label">CA key passphrase<input id="takClientCaPassphrase" type="password" autocomplete="new-password" placeholder="Required if CA key is encrypted"></label><div class="tak-client-ca-passphrase-note">OpenTAKServer commonly uses the default CA key passphrase: <code>atakatak</code>. This is used only for generation and is not saved.</div>';else if(a.missing_private_key&&!a.can_extract)html+='<div class="tak-client-auto-bad">No readable client private key was found. Local CA signing files were not available to TAK Map, so automatic generation is not available.</div>';if(a.can_extract&&p12)html+='<div>A .p12/.pfx bundle was found and can be extracted to TAK Map client cert storage.</div>';html+='<div class="tak-client-automation-actions">';if(a.can_generate)html+='<button type="button" class="layer-button tak-client-generate-btn" onclick="generateTakClientCertKey()">Generate Client Cert/Key</button>';if(a.can_extract&&p12)html+='<button type="button" class="layer-button tak-client-extract-btn" onclick="extractTakClientBundle()">Extract P12/PFX</button>';html+='</div>'}s.innerHTML=html;s.classList.toggle('empty',!html)}catch(e){try{console.warn('renderAutomation failed',e)}catch(_){}}}
  window.detectTakClientFiles=async function(auto){try{ensureDetectButton();const username=String((field('Username')||{}).value||'').trim();if(!username){if(!auto)setOut('Enter the TAK client username first.',true);return null}if(!auto)setOut('Detecting OpenTAKServer cert/key files for '+username+'...');const r=await fetch('/api/tak-map/tak-client/detect',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:username})});const j=await r.json().catch(function(){return {ok:false,error:'Bad detect response'}});if(!r.ok||!j.ok)throw new Error(j.error||('HTTP '+r.status));lastDetect=j;fillDetected(j,!auto);renderAutomation(j);let msg=(j.message||'Detection finished.')+'\n'+describeCandidates(j);if(auto)msg='Auto-detected files after username entry.\n'+msg;setOut(msg.trim(),!j.complete_recommendation);return j}catch(e){if(!auto)setOut('TAK Client file detection failed: '+e,true);return {ok:false,error:String(e)}}};
  window.generateTakClientCertKey=async function(){try{const username=String((field('Username')||{}).value||'').trim();if(!username){setOut('Enter the TAK client username first.',true);return}if(!confirm('Generate a new TAK client certificate/key pair for '+username+'? This will not use the CA private key as the client key.'))return;setOut('Generating TAK client certificate/key pair...');const r=await fetch('/api/tak-map/tak-client/generate',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:username,password:String((field('Password')||{}).value||''),ca_passphrase:String((byId('takClientCaPassphrase')||{}).value||'')})});const j=await r.json().catch(function(){return {ok:false,error:'Bad generate response'}});if(!r.ok||!j.ok)throw new Error(j.error||('HTTP '+r.status));try{const cp=byId('takClientCaPassphrase');if(cp)cp.value=''}catch(_){}const p=j.paths||{};if(field('CertPath'))field('CertPath').value=p.client_cert_path||'';if(field('KeyPath'))field('KeyPath').value=p.client_key_path||'';if(field('CaPath'))field('CaPath').value=p.ca_cert_path||'';if(typeof window.refreshTakClientSetup==='function')setTimeout(window.refreshTakClientSetup,100);setOut((j.message||'Generated TAK client certificate/key pair.')+'\nClient certificate: '+(p.client_cert_path||'')+'\nPrivate key: '+(p.client_key_path||'')+'\nCA certificate: '+(p.ca_cert_path||''));renderAutomation(null);return j}catch(e){setOut('Generate Client Cert/Key failed: '+e,true)}};
  window.extractTakClientBundle=async function(){try{const username=String((field('Username')||{}).value||'').trim();if(!username){setOut('Enter the TAK client username first.',true);return}const bundle=(((lastDetect||{}).candidates||{}).p12_pfx||[])[0];let bundlePath=bundle&&bundle.path;if(!bundlePath)bundlePath=prompt('Enter .p12/.pfx path to extract:','')||'';if(!bundlePath)return;setOut('Extracting TAK client cert/key from bundle...');const r=await fetch('/api/tak-map/tak-client/extract',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:username,password:String((field('Password')||{}).value||''),bundle_path:bundlePath,bundle_password:String((field('Password')||{}).value||'')})});const j=await r.json().catch(function(){return {ok:false,error:'Bad extract response'}});if(!r.ok||!j.ok)throw new Error(j.error||('HTTP '+r.status));try{const cp=byId('takClientCaPassphrase');if(cp)cp.value=''}catch(_){}const p=j.paths||{};if(field('CertPath'))field('CertPath').value=p.client_cert_path||'';if(field('KeyPath'))field('KeyPath').value=p.client_key_path||'';if(field('CaPath')&&p.ca_cert_path)field('CaPath').value=p.ca_cert_path;if(typeof window.refreshTakClientSetup==='function')setTimeout(window.refreshTakClientSetup,100);setOut((j.message||'Extracted TAK client certificate/key.')+'\nClient certificate: '+(p.client_cert_path||'')+'\nPrivate key: '+(p.client_key_path||'')+'\nCA certificate: '+(p.ca_cert_path||''));renderAutomation(null);return j}catch(e){setOut('Extract P12/PFX failed: '+e,true)}};
  const prevOpen=window.openTakClientSetup;if(typeof prevOpen==='function'&&!prevOpen.__v330AutomationWrapped){const wrapped=function(){const r=prevOpen.apply(this,arguments);[80,250,650,1200].forEach(function(ms){setTimeout(function(){ensureDetectButton();slot()},ms)});return r};wrapped.__v330AutomationWrapped=true;window.openTakClientSetup=wrapped}
  function boot(){installCss();ensureDetectButton();slot();qa('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,250)},{once:true});else setTimeout(boot,250);
  [800,1800,3600].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
'''
        if 'id="v330TakClientCertificateAutomation"' not in _html and "id='v330TakClientCertificateAutomation'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v330_versions(_html)

    TAK_MAP_HTML=_v330_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v330_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v330_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v330_exc:
    try: print('v330 TAK Client certificate automation patch failed:', _v330_exc)
    except Exception: pass
# --- end TAK Map v330 TAK Client certificate automation ---

# --- TAK Map v331 Mission/Data Sync TAK package publish fixes ---
try:
    import re as _v331_re
    import shutil as _v331_shutil

    TAK_MAP_SEND_PACKAGE_DIR = DATA_DIR / 'send_packages'

    def _v331_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v331_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v331'", _html)
        _html = _v331_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v331', _html)
        _html = _v331_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v331', _html)
        _html = _v331_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v331\2', _html, flags=_v331_re.I)
        _html = _v331_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v331\2', _html, flags=_v331_re.I)
        _html = _v331_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v331\2', _html, flags=_v331_re.I)
        return _html

    def _v331_tak_client_username(default='takmap'):
        getter=globals().get('_tak_client_identity_load')
        if callable(getter):
            try:
                cfg=getter(include_secret=True)
                u=str((cfg or {}).get('username') or '').strip()
                if u:
                    return u
            except Exception:
                pass
        return str(os.environ.get('TAK_DASH_OTS_CLIENT_NAME','').strip() or os.environ.get('TAK_MAP_CLIENT_USERNAME','').strip() or default).strip() or default

    _v331_old_mission_publish_creator_uid = globals().get('_mission_publish_creator_uid')
    def _mission_publish_creator_uid(preferred_uid=''):
        """v331: prefer the configured TAK Client identity for Mission API creatorUid."""
        env=(os.environ.get('TAK_DASH_MISSION_CREATOR_UID','').strip() or os.environ.get('TAK_DASH_DATA_SYNC_CREATOR_UID','').strip() or os.environ.get('TAK_DASH_NATIVE_CREATOR_UID','').strip() or os.environ.get('TAK_DASH_FILESHARE_CREATOR_UID','').strip())
        candidates=[]
        for val,src in ((env,'env'), (preferred_uid,'argument'), (_v331_tak_client_username('takmap'),'tak-client-identity')):
            val=str(val or '').strip()
            if val and val not in [x.get('uid') for x in candidates]:
                candidates.append({'uid':val,'source':src})
        if callable(_v331_old_mission_publish_creator_uid):
            try:
                old=_v331_old_mission_publish_creator_uid('')
                for cand in (old.get('candidates') or []):
                    uid=str(cand.get('uid') or '').strip()
                    if uid and uid.lower() not in ('takdash','tak-dashboard','tak_dashboard') and uid not in [x.get('uid') for x in candidates]:
                        candidates.append(cand)
            except Exception:
                pass
        pg_uris, _cfg_errors=_candidate_ots_pg_uris()
        for cand in candidates:
            uid=str(cand.get('uid') or '').strip()
            if not uid:
                continue
            if pg_uris:
                try:
                    cnt,err=_pg_first_value(pg_uris[0], 'select count(*) from public.euds where uid=' + _pg_sql_literal(uid))
                    if not err and int(cnt or 0) > 0:
                        return {'ok':True,'uid':uid,'source':cand.get('source'),'candidates':candidates}
                    if cand.get('source') in ('env','argument','tak-client-identity','dashboard-identity'):
                        return {'ok':True,'uid':uid,'source':str(cand.get('source'))+':unverified-preferred','candidates':candidates}
                except Exception:
                    if cand.get('source') in ('env','argument','tak-client-identity','dashboard-identity'):
                        return {'ok':True,'uid':uid,'source':str(cand.get('source'))+':unverified-error-preferred','candidates':candidates}
            else:
                return {'ok':True,'uid':uid,'source':str(cand.get('source'))+':unverified','candidates':candidates}
        return {'ok':False,'uid':'','error':'No Mission API creator UID available. Configure TAK Client Setup or set TAK_DASH_MISSION_CREATOR_UID.','candidates':candidates}

    def _v331_name_from_feature(f, fallback='Local Data'):
        f=f or {}
        props=f.get('properties') if isinstance(f.get('properties'), dict) else {}
        for k in ('name','callsign','title','label','uid','id'):
            v=str(f.get(k) or props.get(k) or '').strip()
            if v:
                return v[:120]
        return fallback

    def _v331_remarks_from_feature(f):
        f=f or {}
        props=f.get('properties') if isinstance(f.get('properties'), dict) else {}
        parts=[]
        for k,label in (('notes','Notes'),('remarks','Remarks'),('description','Description'),('source','Source'),('import_name','Import')):
            v=str(f.get(k) or props.get(k) or '').strip()
            if v:
                parts.append(f'{label}: {v}')
        return '\n'.join(parts)[:3000]

    def _v331_feature_uid(f, idx, package_uid):
        f=f or {}
        props=f.get('properties') if isinstance(f.get('properties'), dict) else {}
        for k in ('uid','cot_uid','event_uid','id'):
            v=str(f.get(k) or props.get(k) or '').strip()
            if v and len(v) <= 160 and not v.lower().startswith('feature'):
                return v
        basis=json.dumps(json_safe(f), sort_keys=True)[:4096] + str(idx) + str(package_uid)
        return 'TAKMAP-LOCAL-' + hashlib.sha1(basis.encode('utf-8','ignore')).hexdigest()[:24]

    def _v331_cot_type_for_feature(f):
        f=f or {}
        props=f.get('properties') if isinstance(f.get('properties'), dict) else {}
        for k in ('cot_type','atak_cot_type','type'):
            v=str(f.get(k) or props.get(k) or '').strip()
            if v and re.match(r'^[a-z]-', v, re.I):
                return v
        kind=_local_data_feature_kind(f)
        if kind == 'route':
            return 'b-m-r'
        return 'a-f-G-U-C'

    def _v331_cot_event_for_feature(f, idx, package_uid, sender_callsign='takmap'):
        pts=_local_data_feature_points(f)
        if not pts:
            return '', b''
        lat=sum(p[0] for p in pts)/len(pts)
        lon=sum(p[1] for p in pts)/len(pts)
        now=datetime.now(timezone.utc)
        stale=now + timedelta(days=3650)
        uid=_v331_feature_uid(f, idx, package_uid)
        name=_v331_name_from_feature(f, 'Local Point')
        cot_type=_v331_cot_type_for_feature(f)
        event=ET.Element('event', {'version':'2.0','uid':uid,'type':cot_type,'how':'h-e','time':_cot_time(now),'start':_cot_time(now),'stale':_cot_time(stale)})
        ET.SubElement(event, 'point', {'lat':f'{lat:.7f}','lon':f'{lon:.7f}','hae':str(_coerce_float((f or {}).get('hae') or (f or {}).get('alt') or (f or {}).get('altitude')) or '0'),'ce':'9999999.0','le':'9999999.0'})
        detail=ET.SubElement(event, 'detail')
        ET.SubElement(detail, 'contact', {'callsign':name})
        ET.SubElement(detail, 'precisionlocation', {'geopointsrc':'TAK Map', 'altsrc':'TAK Map'})
        ET.SubElement(detail, 'takv', {'device':'TAK Map', 'platform':'TAK Map', 'version':'v331', 'os':'web'})
        ET.SubElement(detail, 'archive')
        remarks=_v331_remarks_from_feature(f)
        if remarks:
            ET.SubElement(detail, 'remarks').text=remarks
        ET.SubElement(detail, 'link', {'uid':package_uid, 'type':'b-f-t-r', 'relation':'p-p'})
        return uid, ('<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)).encode('utf-8')

    def _v331_package_validation(zip_path):
        out={'has_manifest':False,'cot_files':0,'kml_files':0,'geojson_files':0,'entries':[]}
        try:
            with zipfile.ZipFile(zip_path, 'r') as zf:
                names=zf.namelist()
            out['entries']=names[:80]
            out['has_manifest']='MANIFEST/manifest.xml' in names
            out['cot_files']=sum(1 for n in names if n.lower().endswith(('.cot','.cot.xml')) or (n.lower().endswith('.xml') and '/cot/' in ('/'+n.lower())))
            out['kml_files']=sum(1 for n in names if n.lower().endswith('.kml'))
            out['geojson_files']=sum(1 for n in names if n.lower().endswith(('.geojson','.json')))
        except Exception as e:
            out['error']=str(e)
        out['tak_importable_hint']=bool(out.get('has_manifest') and out.get('cot_files'))
        return out

    def _v331_build_local_data_tak_package(features, label, stamp):
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
        package_uid=str(uuid.uuid4())
        safe_label=_safe_filename_label(label, 'zip')[:-4]
        zip_name=f'{safe_label}-{stamp}.zip'
        zip_id=_safe_offline_id('tak-dp-local-' + hashlib.sha256((package_uid+stamp).encode()).hexdigest()[:12])
        zip_path=TAK_MAP_SEND_PACKAGE_DIR/(zip_id + '.zip')
        kml_name=_safe_filename_label(label, 'kml')
        geojson_name=_safe_filename_label(label, 'geojson')
        kml_bytes=_local_data_kml_bytes(features, label)
        geojson_bytes=_local_data_geojson_bytes(features)
        content_dir=hashlib.md5((package_uid+kml_name).encode('utf-8')).hexdigest()
        kml_entry=content_dir + '/' + kml_name
        geojson_entry=content_dir + '/' + geojson_name
        cot_entries=[]
        for idx,f in enumerate(features or []):
            uid,cot=_v331_cot_event_for_feature(f, idx, package_uid, _v331_tak_client_username('takmap'))
            if uid and cot:
                cot_base=_safe_filename_label(_v331_name_from_feature(f, 'Local Point') + '-' + str(idx+1), 'cot')
                cot_entries.append({'uid':uid,'entry':'cot/' + cot_base,'root_entry':cot_base,'name':_v331_name_from_feature(f, 'Local Point'),'bytes':cot})
        root=ET.Element('MissionPackageManifest', {'version':'2'})
        cfg=ET.SubElement(root, 'Configuration')
        ET.SubElement(cfg, 'Parameter', {'name':'uid', 'value':package_uid})
        ET.SubElement(cfg, 'Parameter', {'name':'name', 'value':label})
        ET.SubElement(cfg, 'Parameter', {'name':'onReceiveImport', 'value':'true'})
        ET.SubElement(cfg, 'Parameter', {'name':'onReceiveDelete', 'value':'true'})
        contents=ET.SubElement(root, 'Contents')
        for ce in cot_entries:
            c=ET.SubElement(contents, 'Content', {'ignore':'false', 'zipEntry':ce['entry']})
            ET.SubElement(c, 'Parameter', {'name':'name', 'value':ce['name']})
            ET.SubElement(c, 'Parameter', {'name':'contentType', 'value':'CoT Events'})
            ET.SubElement(c, 'Parameter', {'name':'uid', 'value':ce['uid']})
            ET.SubElement(c, 'Parameter', {'name':'visible', 'value':'true'})
        c=ET.SubElement(contents, 'Content', {'ignore':'false', 'zipEntry':kml_entry})
        ET.SubElement(c, 'Parameter', {'name':'name', 'value':kml_name})
        ET.SubElement(c, 'Parameter', {'name':'contentType', 'value':'External Native Data'})
        ET.SubElement(c, 'Parameter', {'name':'visible', 'value':'true' if not cot_entries else 'false'})
        c2=ET.SubElement(contents, 'Content', {'ignore':'false', 'zipEntry':geojson_entry})
        ET.SubElement(c2, 'Parameter', {'name':'name', 'value':geojson_name})
        ET.SubElement(c2, 'Parameter', {'name':'contentType', 'value':'External Native Data'})
        ET.SubElement(c2, 'Parameter', {'name':'visible', 'value':'false'})
        manifest_text='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
        with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
            def write_stable(name, data):
                info=zipfile.ZipInfo(name)
                info.date_time=(2024,1,1,0,0,0)
                info.compress_type=zipfile.ZIP_DEFLATED
                zf.writestr(info, data)
            write_stable('MANIFEST/manifest.xml', manifest_text.encode('utf-8'))
            for ce in cot_entries:
                write_stable(ce['entry'], ce['bytes'])
                write_stable(ce['root_entry'], ce['bytes'])
            write_stable(kml_entry, kml_bytes)
            write_stable(geojson_entry, geojson_bytes)
            write_stable(kml_name, kml_bytes)
            write_stable(geojson_name, geojson_bytes)
            write_stable('TAKMAP/package-info.json', json.dumps({'package_uid':package_uid,'label':label,'created':datetime.now(timezone.utc).isoformat(),'feature_count':len(features or []),'cot_count':len(cot_entries),'generator':'TAK Map v331'}, indent=2).encode('utf-8'))
        return {'ok':True,'path':str(zip_path),'package_name':zip_name,'package_uid':package_uid,'sha256':hashlib.sha256(zip_path.read_bytes()).hexdigest(),'size_bytes':zip_path.stat().st_size,'feature_count':len(features or []),'cot_count':len(cot_entries),'kml_name':kml_name,'geojson_name':geojson_name,'manifest_path':'MANIFEST/manifest.xml','validation':_v331_package_validation(zip_path)}

    def _v331_status_line(label, obj):
        try:
            attempts=obj.get('attempts') or []
            a=attempts[-1] if attempts else obj
            status=a.get('status') or obj.get('status') or ''
            url=a.get('url') or obj.get('url') or ''
            err=a.get('error') or obj.get('error') or ''
            return f'{label}: status={status or "n/a"} ok={bool(obj.get("ok"))} {err} {url}'.strip()
        except Exception:
            return label + ': unavailable'

    def tak_map_publish_package_to_mission(zip_path, package_filename, sha256_hash, mission_name='', content_label='', content_kind='package', server_host='', preferred_creator_uid=''):
        mission=str(mission_name or '').strip() or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME','TAK Map Mission').strip() or 'TAK Map Mission'
        zp=Path(str(zip_path))
        if not zp.exists():
            return {'ok':False,'error':'Package ZIP does not exist.','path':str(zp),'mission':mission}
        creator=_mission_publish_creator_uid(preferred_creator_uid)
        if not creator.get('ok'):
            return {'ok':False,'error':creator.get('error') or 'No Mission API creator UID available.','creator':creator,'mission':mission}
        creator_uid=str(creator.get('uid') or '').strip() or _v331_tak_client_username('takmap')
        sha=str(sha256_hash or '').strip() or hashlib.sha256(zp.read_bytes()).hexdigest()
        base_fn=str(package_filename or zp.name or 'TAK-Map-Package.zip').strip() or 'TAK-Map-Package.zip'
        stem,ext=os.path.splitext(base_fn)
        if not ext: ext='.zip'
        publish_filename=f"{stem}-{sha[:12]}{ext}"
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
        saved_name=_safe_filename_label(publish_filename, 'zip')
        saved_path=TAK_MAP_SEND_PACKAGE_DIR / saved_name
        try:
            if zp.resolve() != saved_path.resolve():
                saved_path.write_bytes(zp.read_bytes())
        except Exception:
            try: _v331_shutil.copyfile(str(zp), str(saved_path))
            except Exception: saved_path=zp
        file_bytes=Path(saved_path).read_bytes()
        validation=_v331_package_validation(saved_path)
        keywords=['missionpackage','tak-map',str(content_kind or 'package')]
        if 'basemap' in str(content_kind).lower() or 'map' in str(content_kind).lower():
            keywords.append('basemap')
        if 'local' in str(content_kind).lower() and 'local-data' not in keywords:
            keywords.append('local-data')
        creator_attempts=[]
        def run_publish_with_creator(cuid):
            q='creatorUid='+quote(cuid, safe='')+'&tool=public&defaultRole=MISSION_SUBSCRIBER'
            create_path='/Marti/api/missions/'+quote(mission, safe='')+'?'+q
            create=_ots_mission_api_request(create_path, method='PUT', body=b'', headers={'Content-Length':'0'}, public_host=server_host, timeout=20)
            token=_extract_mission_token(create.get('json') or {})
            upload_q='name='+quote(publish_filename, safe='')+'&creatorUid='+quote(cuid, safe='')
            for kw in keywords:
                upload_q += '&keywords=' + quote(str(kw), safe='')
            upload=_ots_mission_api_request('/Marti/sync/upload?'+upload_q, method='POST', body=file_bytes, headers={'Content-Type':'application/zip','Content-Length':str(len(file_bytes))}, public_host=server_host, timeout=45)
            uploaded_hash=str(((upload.get('json') or {}).get('Hash') or (upload.get('json') or {}).get('hash') or sha)).strip()
            assoc_body=json.dumps({'hashes':[uploaded_hash]}).encode('utf-8')
            assoc_path='/Marti/api/missions/'+quote(mission, safe='')+'/contents?creatorUid='+quote(cuid, safe='')
            assoc=_ots_mission_api_request(assoc_path, method='PUT', body=assoc_body, headers={'Content-Type':'application/json','Content-Length':str(len(assoc_body))}, token=token, public_host=server_host, timeout=25)
            return create, upload, assoc, uploaded_hash
        def publish_ok(c,u,a):
            return bool(u.get('ok') and a.get('ok'))
        create, upload, assoc, uploaded_hash = run_publish_with_creator(creator_uid)
        creator_attempts.append({'uid':creator_uid,'source':creator.get('source'),'ok':publish_ok(create,upload,assoc)})
        if not publish_ok(create,upload,assoc):
            fallback=_mission_publish_creator_uid('')
            for cand in (fallback.get('candidates') or []):
                uid=str(cand.get('uid') or '').strip()
                if cand.get('source') == 'tak_map_euds' and uid and uid != creator_uid:
                    c2,u2,a2,h2=run_publish_with_creator(uid)
                    creator_attempts.append({'uid':uid,'source':'tak_map_euds-fallback','ok':publish_ok(c2,u2,a2)})
                    if publish_ok(c2,u2,a2):
                        creator_uid=uid
                        creator={'ok':True,'uid':uid,'source':'tak_map_euds-fallback','candidates':fallback.get('candidates') or []}
                        create,upload,assoc,uploaded_hash=c2,u2,a2,h2
                    break
        ok=publish_ok(create,upload,assoc)
        create_nonfatal=bool((not create.get('ok')) and ok)
        out={'ok':ok,'mission':mission,'creator_uid':creator_uid,'creator':creator,'creator_attempts':creator_attempts,'content_kind':content_kind,'content_label':content_label,'package_filename':base_fn,'publish_filename':publish_filename,'package_local_path':str(saved_path),'path':str(saved_path),'sha256':sha,'uploaded_hash':uploaded_hash,'keywords':keywords,'package_validation':validation,'create_mission':create,'upload_content':upload,'associate_content':assoc,'create_mission_nonfatal':create_nonfatal,'message':'','error':''}
        if ok:
            msg=f'Published {content_label or base_fn} to Data Sync Mission {mission}.'
            if create_nonfatal:
                msg += ' Mission create returned non-2xx, but upload and content association succeeded.'
            msg += ' Package saved on server: ' + str(saved_path)
            out['message']=msg
        else:
            parts=[]
            for label,obj in (('create mission',create),('upload content',upload),('associate content',assoc)):
                if not obj.get('ok'):
                    parts.append(_v331_status_line(label,obj))
            out['error']='; '.join(parts) or 'Mission publish failed.'
        diag=_write_send_diag('mission-datasync-publish', out, None)
        if isinstance(diag, dict):
            out['diag_paths']=diag
        return out

    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features=_selected_local_data_features(ids)
        if not features:
            return {'ok':False,'error':'No selected Local Data items were found.'}
        k=str(kind or '').strip().lower() or 'items'
        singular={'points':'Point','routes':'Route','shapes':'Shape','point':'Point','route':'Route','shape':'Shape'}.get(k,'Local Data')
        plural=singular if len(features)==1 else singular + 's'
        label=f'TAK Map Local {plural}'
        stamp=datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        pkg=_v331_build_local_data_tak_package(features, label, stamp)
        if not pkg.get('ok'):
            return pkg
        res=tak_map_publish_package_to_mission(Path(pkg['path']), pkg.get('package_name') or 'TAK Map Local Data.zip', pkg.get('sha256') or '', mission_name, label, 'local-data', server_host, _v331_tak_client_username('takmap'))
        res['package']=pkg
        return res

    def _v331_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v331_versions(_html)
        runtime=r"""
<script id="v331MissionPublishPatch">
(function(){
  'use strict';
  const V='v331';
  function boot(){try{document.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,200)},{once:true});else setTimeout(boot,200);
  [900,2200,4200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
"""
        if 'id="v331MissionPublishPatch"' not in _html and "id='v331MissionPublishPatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v331_versions(_html)

    try:
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
    except Exception:
        pass
    TAK_MAP_HTML=_v331_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v331_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v331_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v331_exc:
    try: print('v331 Mission/Data Sync publish patch failed:', _v331_exc)
    except Exception: pass
# --- end TAK Map v331 Mission/Data Sync TAK package publish fixes ---

# --- TAK Map v332 Mission publish UX refinements ---
try:
    import re as _v332_re

    def _v332_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v332_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v332'", _html)
        _html = _v332_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v332', _html)
        _html = _v332_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v332', _html)
        _html = _v332_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v332\2', _html, flags=_v332_re.I)
        _html = _v332_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v332\2', _html, flags=_v332_re.I)
        _html = _v332_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v332\2', _html, flags=_v332_re.I)
        return _html

    _v332_old_publish_package_to_mission = globals().get('tak_map_publish_package_to_mission')
    if callable(_v332_old_publish_package_to_mission):
        def tak_map_publish_package_to_mission(zip_path, package_filename, sha256_hash, mission_name='', content_label='', content_kind='package', server_host='', preferred_creator_uid=''):
            # v332: keep v331 Mission API/package behavior, but return a clear user-facing success message.
            res = _v332_old_publish_package_to_mission(zip_path, package_filename, sha256_hash, mission_name, content_label, content_kind, server_host, preferred_creator_uid)
            try:
                if isinstance(res, dict) and res.get('ok'):
                    mission = str(res.get('mission') or mission_name or '').strip() or 'selected mission'
                    label = str(content_label or res.get('content_label') or res.get('package_filename') or 'item').strip()
                    short = f'Published to Data Sync Mission: {mission}.'
                    res['message_verbose'] = res.get('message') or ''
                    res['message'] = short
                    res['user_message'] = short
                    res['publish_succeeded'] = True
                    res['disable_publish_after_success'] = True
                    res['close_publish_modal_after_success'] = True
                    res['data_sync_refresh_recommended'] = True
                    if res.get('create_mission_nonfatal'):
                        res['nonfatal_note'] = 'Mission already existed or create returned non-2xx, but upload and content association succeeded.'
                    if label:
                        res['published_label'] = label
            except Exception:
                pass
            return res

    def _v332_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v332_versions(_html)
        runtime = r'''
<script id="v332MissionPublishUxPatch">
(function(){
  'use strict';
  const V='v332';
  const $=id=>document.getElementById(id);
  function esc2(v){try{return (typeof esc==='function')?esc(v):String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}catch(_){return String(v==null?'':v)}}
  function isMissionPublishMode(){try{return ['local-data-publish','live-basemap','offline'].includes(String(activeSendMode||''));}catch(_){return false}}
  function resetPublishControls(){try{const b=$('sendConfirmBtn');if(b){b.disabled=false;b.dataset.v332Published='0';b.classList.remove('tak-publish-done');if(isMissionPublishMode())b.textContent='Publish';}const s=$('sendStatus');if(s&&isMissionPublishMode())s.classList.remove('tak-publish-success','danger');}catch(_){}}
  function markPublishing(){const b=$('sendConfirmBtn');if(b){b.disabled=true;b.dataset.v332Published='0';b.textContent='Publishing...';}}
  function markSuccess(msg){try{const b=$('sendConfirmBtn');if(b){b.disabled=true;b.dataset.v332Published='1';b.classList.add('tak-publish-done');b.textContent='Published';}const s=$('sendStatus');if(s){s.classList.remove('danger');s.classList.add('tak-publish-success');s.innerHTML='<span class="tak-success-line">✓ '+esc2(msg||'Published to Data Sync Mission.')+'</span>';}}catch(_){}}
  function markFailure(msg){try{const b=$('sendConfirmBtn');if(b){b.disabled=false;b.dataset.v332Published='0';b.classList.remove('tak-publish-done');b.textContent='Publish';}const s=$('sendStatus');if(s){s.classList.remove('tak-publish-success');s.innerHTML='<span class="danger">'+esc2(msg||'Publish failed.')+'</span>';}}catch(_){}}
  async function publishRequest(mode, mission){
    if(mode==='local-data-publish'){
      return fetch('/api/tak-map/local-data-mission-publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:activeLocalSendIds,kind:activeLocalSendKind,missionName:mission,serverHost:location.hostname})});
    }
    if(mode==='live-basemap'){
      return fetch('/api/tak-map/live-basemap-source-mission-publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({basemap_id:activeSendBasemapId,missionName:mission,dashboardOrigin:dashboardHttpsOrigin(),serverHost:location.hostname})});
    }
    return fetch('/api/tak-map/offline-mission-publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:activeSendMapId,missionName:mission,serverHost:location.hostname})});
  }
  const oldConfirm=window.confirmSendOfflineMap;
  window.confirmSendOfflineMap=async function(){
    try{
      if(!isMissionPublishMode())return oldConfirm?oldConfirm.apply(this,arguments):undefined;
      const b=$('sendConfirmBtn');
      if(b&&b.dataset.v332Published==='1')return false;
      const mission=(typeof selectedMissionName==='function'?selectedMissionName():'')||'';
      if(!mission){markFailure('Select a Data Sync Mission.');return false;}
      const mode=String(activeSendMode||'');
      const s=$('sendStatus');
      if(s){s.classList.remove('danger','tak-publish-success');s.textContent='Publishing to Data Sync Mission...';}
      markPublishing();
      const r=await publishRequest(mode, mission);
      const j=await apiJsonResponseAllowFalse(r);
      if(j&&j.ok){
        const msg=j.user_message||j.message||('Published to Data Sync Mission: '+mission+'.');
        markSuccess(msg);
        try{forceDataSyncSync(mode==='local-data-publish'?'mission-publish-local-data':(mode==='live-basemap'?'mission-publish-basemap':'mission-publish-offline'))}catch(_){ }
        try{if(mode==='offline'){offlineMaps=j.maps||offlineMaps;applyOfflineBasemaps();renderOfflineMapRows();renderBasemaps();}}catch(_){ }
        setTimeout(function(){try{const modal=$('sendModal');const btn=$('sendConfirmBtn');if(modal&&modal.classList.contains('active')&&btn&&btn.dataset.v332Published==='1')closeSendModal();}catch(_){ }},1800);
        return false;
      }
      markFailure((j&&j.error)||'Publish failed.');
      return false;
    }catch(e){markFailure('Publish failed: '+(e&&e.message?e.message:e));return false;}
  };
  function wrapOpen(name){try{const old=window[name];if(!old||old.__v332Wrapped)return;const wrapped=function(){const r=old.apply(this,arguments);setTimeout(resetPublishControls,60);return r};wrapped.__v332Wrapped=true;window[name]=wrapped;}catch(_){}}
  function boot(){try{document.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}});wrapOpen('openLocalDataPublish');wrapOpen('openSendOfflineMap');wrapOpen('openSendLiveBasemapSource');if(!$('v332MissionPublishUxStyle')){const st=document.createElement('style');st.id='v332MissionPublishUxStyle';st.textContent='#sendConfirmBtn.tak-publish-done,#sendConfirmBtn:disabled{opacity:.72;cursor:default}.tak-publish-success{color:var(--good)!important;font-weight:900}.tak-success-line{display:inline-block;padding-top:3px}';document.head.appendChild(st);}}catch(_){}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,160)},{once:true});else setTimeout(boot,160);
  [700,1600,3200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
'''
        if 'id="v332MissionPublishUxPatch"' not in _html and "id='v332MissionPublishUxPatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v332_versions(_html)

    TAK_MAP_HTML = _v332_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML = _v332_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = _v332_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML = TAK_MAP_HTML
except Exception as _v332_exc:
    try: print('v332 Mission publish UX patch failed:', _v332_exc)
    except Exception: pass
# --- end TAK Map v332 Mission publish UX refinements ---


# --- TAK Map v333 ATAK import package cleanup ---
try:
    import re as _v333_re

    def _v333_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v333_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v333'", _html)
        _html = _v333_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v333', _html)
        _html = _v333_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v333', _html)
        _html = _v333_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v333\2', _html, flags=_v333_re.I)
        _html = _v333_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v333\2', _html, flags=_v333_re.I)
        _html = _v333_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v333\2', _html, flags=_v333_re.I)
        return _html

    def _v331_package_validation(zip_path):
        out={'has_manifest':False,'cot_files':0,'kml_files':0,'geojson_files':0,'entries':[]}
        try:
            with zipfile.ZipFile(zip_path, 'r') as zf:
                names=zf.namelist()
            out['entries']=names[:120]
            out['has_manifest']='MANIFEST/manifest.xml' in names
            out['cot_files']=sum(1 for n in names if n.lower().endswith(('.cot','.cot.xml','.xml')) and ('/cot/' in ('/'+n.lower()) or n.lower().startswith('cot/')))
            out['kml_files']=sum(1 for n in names if n.lower().endswith('.kml'))
            out['geojson_files']=sum(1 for n in names if n.lower().endswith(('.geojson','.json')))
        except Exception as e:
            out['error']=str(e)
        out['tak_importable_hint']=bool(out.get('has_manifest') and out.get('cot_files'))
        out['package_mode']='v333-cot-only-local-data'
        return out

    def _v333_build_local_data_tak_package(features, label, stamp):
        """Build a minimal ATAK-friendly CoT-only Mission Package.

        v331 included KML/GeoJSON fallback files and duplicate root-level copies.
        ATAK could display the point but showed a confusing "failed to extract"
        notification while processing those extra native-data entries. v333 keeps
        Mission/Data Sync compatibility but only lists/imports CoT event files.
        """
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
        package_uid=str(uuid.uuid4())
        safe_label=_safe_filename_label(label, 'zip')[:-4]
        zip_name=f'{safe_label}-{stamp}.zip'
        zip_id=_safe_offline_id('tak-dp-local-' + hashlib.sha256((package_uid+stamp).encode()).hexdigest()[:12])
        zip_path=TAK_MAP_SEND_PACKAGE_DIR/(zip_id + '.zip')
        cot_entries=[]
        for idx,f in enumerate(features or []):
            uid,cot=_v331_cot_event_for_feature(f, idx, package_uid, _v331_tak_client_username('takmap'))
            if uid and cot:
                cot_base=_safe_filename_label(_v331_name_from_feature(f, 'Local Point') + '-' + str(idx+1), 'cot')
                cot_entries.append({'uid':uid,'entry':'cot/' + cot_base,'name':_v331_name_from_feature(f, 'Local Point'),'bytes':cot})
        root=ET.Element('MissionPackageManifest', {'version':'2'})
        cfg=ET.SubElement(root, 'Configuration')
        ET.SubElement(cfg, 'Parameter', {'name':'uid', 'value':package_uid})
        ET.SubElement(cfg, 'Parameter', {'name':'name', 'value':label})
        ET.SubElement(cfg, 'Parameter', {'name':'onReceiveImport', 'value':'true'})
        ET.SubElement(cfg, 'Parameter', {'name':'onReceiveDelete', 'value':'true'})
        ET.SubElement(cfg, 'Parameter', {'name':'remarks', 'value':'TAK Map CoT-only Local Data package'})
        contents=ET.SubElement(root, 'Contents')
        for ce in cot_entries:
            c=ET.SubElement(contents, 'Content', {'ignore':'false', 'zipEntry':ce['entry']})
            ET.SubElement(c, 'Parameter', {'name':'name', 'value':ce['name']})
            ET.SubElement(c, 'Parameter', {'name':'contentType', 'value':'CoT Events'})
            ET.SubElement(c, 'Parameter', {'name':'uid', 'value':ce['uid']})
            ET.SubElement(c, 'Parameter', {'name':'visible', 'value':'true'})
        manifest_text='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
        with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
            def write_stable(name, data):
                info=zipfile.ZipInfo(name)
                info.date_time=(2024,1,1,0,0,0)
                info.compress_type=zipfile.ZIP_DEFLATED
                zf.writestr(info, data)
            write_stable('MANIFEST/manifest.xml', manifest_text.encode('utf-8'))
            for ce in cot_entries:
                write_stable(ce['entry'], ce['bytes'])
        return {'ok':True,'path':str(zip_path),'package_name':zip_name,'package_uid':package_uid,'sha256':hashlib.sha256(zip_path.read_bytes()).hexdigest(),'size_bytes':zip_path.stat().st_size,'feature_count':len(features or []),'cot_count':len(cot_entries),'kml_name':'','geojson_name':'','manifest_path':'MANIFEST/manifest.xml','package_mode':'v333-cot-only-local-data','validation':_v331_package_validation(zip_path)}

    _v333_old_cot_event_for_feature = globals().get('_v331_cot_event_for_feature')
    if callable(_v333_old_cot_event_for_feature):
        def _v331_cot_event_for_feature(f, idx, package_uid, sender_callsign='takmap'):
            uid, data = _v333_old_cot_event_for_feature(f, idx, package_uid, sender_callsign)
            try:
                if data:
                    txt=data.decode('utf-8','ignore').replace("version='v331'", "version='v333'").replace('version="v331"', 'version="v333"')
                    return uid, txt.encode('utf-8')
            except Exception:
                pass
            return uid, data

    # Rebind the v331 builder name used by tak_map_local_data_mission_publish.
    _v331_build_local_data_tak_package = _v333_build_local_data_tak_package

    def _v333_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v333_versions(_html)
        runtime="""
<script id="v333AtakImportPackagePatch">
(function(){
  'use strict';
  const V='v333';
  function boot(){try{document.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,180)},{once:true});else setTimeout(boot,180);
  [900,2200,4200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
"""
        if 'id="v333AtakImportPackagePatch"' not in _html and "id='v333AtakImportPackagePatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v333_versions(_html)

    TAK_MAP_HTML=_v333_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v333_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v333_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v333_exc:
    try: print('v333 ATAK import package cleanup patch failed:', _v333_exc)
    except Exception: pass
# --- end TAK Map v333 ATAK import package cleanup ---



# --- TAK Map v334 Mission package unique identity / ATAK overwrite prompt reduction ---
try:
    import re as _v334_re

    def _v334_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v334_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v334'", _html)
        _html = _v334_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v334', _html)
        _html = _v334_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v334', _html)
        _html = _v334_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v334\2', _html, flags=_v334_re.I)
        _html = _v334_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v334\2', _html, flags=_v334_re.I)
        _html = _v334_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v334\2', _html, flags=_v334_re.I)
        return _html

    def _v334_clean_package_title(value, fallback='Local Data'):
        try:
            v=str(value or '').strip()
        except Exception:
            v=''
        v=_v334_re.sub(r'\s+', ' ', v).strip(' ._-')
        if not v:
            v=fallback
        # Keep titles readable in ATAK package prompts and file names.
        if len(v) > 72:
            v=v[:72].rstrip(' ._-')
        return v or fallback

    def _v334_display_title_from_features(features, singular='Local Data'):
        feats=list(features or [])
        if len(feats) == 1:
            try:
                name=_v331_name_from_feature(feats[0], singular or 'Local Data')
            except Exception:
                name=singular or 'Local Data'
            return _v334_clean_package_title(name, singular or 'Local Data')
        return _v334_clean_package_title(f'{len(feats)} TAK Map Local Items', 'TAK Map Local Items')

    def _v334_fingerprint_features(features):
        try:
            bits=[]
            for idx,f in enumerate(features or []):
                props=f.get('properties') if isinstance(f, dict) and isinstance(f.get('properties'), dict) else {}
                uid=str((f or {}).get('uid') or props.get('uid') or props.get('id') or props.get('cot_uid') or '').strip()
                name=str(props.get('name') or props.get('title') or (f or {}).get('name') or '').strip()
                pts=[]
                try:
                    pts=_local_data_feature_points(f)[:3]
                except Exception:
                    pts=[]
                bits.append({'i':idx,'uid':uid,'name':name,'pts':[(round(float(a),7),round(float(b),7)) for a,b in pts]})
            return hashlib.sha256(json.dumps(bits, sort_keys=True).encode('utf-8','ignore')).hexdigest()[:12]
        except Exception:
            return hashlib.sha256(str(uuid.uuid4()).encode()).hexdigest()[:12]

    def _v334_package_validation(zip_path):
        out={'has_manifest':False,'cot_files':0,'kml_files':0,'geojson_files':0,'entries':[],'manifest_uid':'','manifest_name':'','package_mode':'v334-cot-only-unique-identity'}
        try:
            with zipfile.ZipFile(zip_path, 'r') as zf:
                names=zf.namelist()
                out['entries']=names[:120]
                out['has_manifest']='MANIFEST/manifest.xml' in names
                out['cot_files']=sum(1 for n in names if n.lower().startswith('cot/') and n.lower().endswith(('.cot','.cot.xml','.xml')))
                out['kml_files']=sum(1 for n in names if n.lower().endswith('.kml'))
                out['geojson_files']=sum(1 for n in names if n.lower().endswith(('.geojson','.json')))
                if 'MANIFEST/manifest.xml' in names:
                    mt=zf.read('MANIFEST/manifest.xml').decode('utf-8','ignore')
                    try:
                        root=ET.fromstring(mt)
                        cfg = root.find('Configuration')
                        params = cfg.findall('Parameter') if cfg is not None else []
                        for p in params:
                            if p.attrib.get('name') == 'uid':
                                out['manifest_uid']=p.attrib.get('value','')
                            if p.attrib.get('name') == 'name':
                                out['manifest_name']=p.attrib.get('value','')
                    except Exception as e:
                        out['manifest_parse_error']=str(e)
        except Exception as e:
            out['error']=str(e)
        out['tak_importable_hint']=bool(out.get('has_manifest') and out.get('cot_files'))
        return out

    def _v334_build_local_data_tak_package(features, label, stamp):
        """Build a CoT-only TAK Data Package with a unique internal identity.

        v333 fixed ATAK's extraction error by removing KML/GeoJSON fallback
        entries. v334 additionally avoids generic internal package names such as
        "TAK Map Local Point" so ATAK is less likely to present an automatic
        Mission/Data Sync receive as an overwrite of a previous TAK Map package.
        """
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
        feats=list(features or [])
        feature_hint='Local Data'
        try:
            if len(feats) == 1:
                k=_local_data_feature_kind(feats[0])
                feature_hint={'point':'Point','route':'Route','shape':'Shape'}.get(k, 'Local Data')
        except Exception:
            pass
        title=_v334_display_title_from_features(feats, feature_hint)
        fp=_v334_fingerprint_features(feats)
        package_uid='takmap-package-' + stamp + '-' + fp + '-' + hashlib.sha1(str(uuid.uuid4()).encode()).hexdigest()[:8]
        package_title=f'{title} - TAK Map - {stamp}'
        safe_title=_safe_filename_label(package_title, 'zip')[:-4]
        zip_name=f'{safe_title}.zip'
        zip_id=_safe_offline_id('tak-dp-local-' + hashlib.sha256((package_uid+zip_name).encode()).hexdigest()[:16])
        zip_path=TAK_MAP_SEND_PACKAGE_DIR/(zip_id + '.zip')
        cot_entries=[]
        sender=_v331_tak_client_username('takmap')
        for idx,f in enumerate(feats):
            uid,cot=_v331_cot_event_for_feature(f, idx, package_uid, sender)
            if uid and cot:
                try:
                    cot_txt=cot.decode('utf-8','ignore').replace("version='v333'", "version='v334'").replace('version="v333"', 'version="v334"').replace("version='v331'", "version='v334'").replace('version="v331"', 'version="v334"')
                    cot=cot_txt.encode('utf-8')
                except Exception:
                    pass
                name=_v331_name_from_feature(f, feature_hint or 'Local Data')
                cot_base=_safe_filename_label(str(uid)[:80] or (_v334_clean_package_title(name, 'Local Data') + '-' + str(idx+1)), 'cot')
                cot_entries.append({'uid':uid,'entry':'cot/' + cot_base,'name':_v334_clean_package_title(name, feature_hint or 'Local Data'),'bytes':cot})
        root=ET.Element('MissionPackageManifest', {'version':'2'})
        cfg=ET.SubElement(root, 'Configuration')
        ET.SubElement(cfg, 'Parameter', {'name':'uid', 'value':package_uid})
        ET.SubElement(cfg, 'Parameter', {'name':'name', 'value':package_title})
        ET.SubElement(cfg, 'Parameter', {'name':'onReceiveImport', 'value':'true'})
        ET.SubElement(cfg, 'Parameter', {'name':'onReceiveDelete', 'value':'true'})
        ET.SubElement(cfg, 'Parameter', {'name':'remarks', 'value':'TAK Map CoT-only Local Data package; unique package identity'})
        ET.SubElement(cfg, 'Parameter', {'name':'tool', 'value':'tak-map'})
        ET.SubElement(cfg, 'Parameter', {'name':'creatorUid', 'value':sender})
        contents=ET.SubElement(root, 'Contents')
        for ce in cot_entries:
            c=ET.SubElement(contents, 'Content', {'ignore':'false', 'zipEntry':ce['entry']})
            ET.SubElement(c, 'Parameter', {'name':'name', 'value':ce['name']})
            ET.SubElement(c, 'Parameter', {'name':'contentType', 'value':'CoT Events'})
            ET.SubElement(c, 'Parameter', {'name':'uid', 'value':ce['uid']})
            ET.SubElement(c, 'Parameter', {'name':'visible', 'value':'true'})
        manifest_text='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
        with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
            def write_stable(name, data):
                info=zipfile.ZipInfo(name)
                info.date_time=(2024,1,1,0,0,0)
                info.compress_type=zipfile.ZIP_DEFLATED
                zf.writestr(info, data)
            write_stable('MANIFEST/manifest.xml', manifest_text.encode('utf-8'))
            for ce in cot_entries:
                write_stable(ce['entry'], ce['bytes'])
        return {'ok':True,'path':str(zip_path),'package_name':zip_name,'package_display_name':package_title,'package_uid':package_uid,'sha256':hashlib.sha256(zip_path.read_bytes()).hexdigest(),'size_bytes':zip_path.stat().st_size,'feature_count':len(feats),'cot_count':len(cot_entries),'kml_name':'','geojson_name':'','manifest_path':'MANIFEST/manifest.xml','package_mode':'v334-cot-only-unique-identity','validation':_v334_package_validation(zip_path)}

    # Rebind names consumed by tak_map_local_data_mission_publish and diagnostics.
    _v331_build_local_data_tak_package = _v334_build_local_data_tak_package
    _v331_package_validation = _v334_package_validation

    _v334_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    if callable(_v334_old_local_publish):
        def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
            features=_selected_local_data_features(ids)
            if not features:
                return {'ok':False,'error':'No selected Local Data items were found.'}
            k=str(kind or '').strip().lower() or 'items'
            singular={'points':'Point','routes':'Route','shapes':'Shape','point':'Point','route':'Route','shape':'Shape'}.get(k,'Local Data')
            stamp=datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
            title=_v334_display_title_from_features(features, singular)
            label=f'{title} - TAK Map'
            pkg=_v334_build_local_data_tak_package(features, label, stamp)
            if not pkg.get('ok'):
                return pkg
            content_label=pkg.get('package_display_name') or label
            res=tak_map_publish_package_to_mission(Path(pkg['path']), pkg.get('package_name') or 'TAK Map Local Data.zip', pkg.get('sha256') or '', mission_name, content_label, 'local-data', server_host, _v331_tak_client_username('takmap'))
            res['package']=pkg
            # Keep the user-facing success concise from v332, but include richer details in diagnostics.
            if res.get('ok'):
                res['user_message']='Published to Data Sync Mission: ' + str(res.get('mission') or mission_name or '').strip() + '.'
                res['message']=res['user_message']
            return res

    def _v334_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v334_versions(_html)
        runtime="""
<script id="v334MissionPackageIdentityPatch">
(function(){
  'use strict';
  const V='v334';
  function boot(){try{document.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,180)},{once:true});else setTimeout(boot,180);
  [900,2200,4200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
"""
        if 'id="v334MissionPackageIdentityPatch"' not in _html and "id='v334MissionPackageIdentityPatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v334_versions(_html)

    TAK_MAP_HTML=_v334_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v334_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v334_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v334_exc:
    try: print('v334 Mission package identity patch failed:', _v334_exc)
    except Exception: pass
# --- end TAK Map v334 Mission package unique identity / ATAK overwrite prompt reduction ---



# --- TAK Map v335 OTS-style passive Mission package manifest ---
try:
    import re as _v335_re

    def _v335_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v335_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v335'", _html)
        _html = _v335_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v335', _html)
        _html = _v335_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v335', _html)
        _html = _v335_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v335\2', _html, flags=_v335_re.I)
        _html = _v335_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v335\2', _html, flags=_v335_re.I)
        _html = _v335_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v335\2', _html, flags=_v335_re.I)
        return _html

    def _v335_safe_zip_component(value, fallback='item'):
        try:
            v=str(value or '').strip()
        except Exception:
            v=''
        if not v:
            v=fallback
        # OTS packages use <uid>/<uid>.cot. Keep readable UIDs intact where possible,
        # but guard against path separators/control characters.
        v=_v335_re.sub(r'[\\/\x00-\x1f\x7f]+', '_', v)
        v=_v335_re.sub(r'[^A-Za-z0-9._:@+-]+', '_', v).strip('._-')
        if not v:
            v=fallback
        return v[:96]

    def _v335_package_validation(zip_path):
        out={'has_manifest':False,'cot_files':0,'kml_files':0,'geojson_files':0,'entries':[],'manifest_uid':'','manifest_name':'','on_receive_flags':[],'ots_style_cot_paths':0,'package_mode':'v335-ots-style-passive-cot'}
        try:
            with zipfile.ZipFile(zip_path, 'r') as zf:
                names=zf.namelist()
                out['entries']=names[:120]
                out['has_manifest']='MANIFEST/manifest.xml' in names
                out['cot_files']=sum(1 for n in names if n.lower().endswith(('.cot','.cot.xml')) and n != 'MANIFEST/manifest.xml')
                out['ots_style_cot_paths']=sum(1 for n in names if len(n.split('/'))==2 and n.lower().endswith(('.cot','.cot.xml')) and n.split('/')[0] and n.split('/')[1])
                out['kml_files']=sum(1 for n in names if n.lower().endswith('.kml'))
                out['geojson_files']=sum(1 for n in names if n.lower().endswith(('.geojson','.json')))
                if 'MANIFEST/manifest.xml' in names:
                    mt=zf.read('MANIFEST/manifest.xml').decode('utf-8','ignore')
                    try:
                        root=ET.fromstring(mt)
                        cfg=root.find('Configuration')
                        params=cfg.findall('Parameter') if cfg is not None else []
                        for p in params:
                            name=p.attrib.get('name','')
                            if name == 'uid':
                                out['manifest_uid']=p.attrib.get('value','')
                            elif name == 'name':
                                out['manifest_name']=p.attrib.get('value','')
                            elif name in ('onReceiveImport','onReceiveDelete'):
                                out['on_receive_flags'].append(name)
                    except Exception as e:
                        out['manifest_parse_error']=str(e)
        except Exception as e:
            out['error']=str(e)
        out['tak_importable_hint']=bool(out.get('has_manifest') and out.get('cot_files'))
        out['passive_receive_hint']=not bool(out.get('on_receive_flags'))
        return out

    def _v335_build_local_data_tak_package(features, label, stamp):
        """Build an OTS-style passive CoT-only TAK Data Package.

        v334 made package identities unique, but ATAK still auto-prompted with an
        overwrite dialog when mission content arrived. The known-good OTS package
        format is more passive: only uid/name in Configuration, no onReceiveImport
        or onReceiveDelete flags, and CoT entries stored as <uid>/<uid>.cot. v335
        mirrors that layout while preserving TAK Map's concise publish UI.
        """
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
        feats=list(features or [])
        feature_hint='Local Data'
        try:
            if len(feats) == 1:
                k=_local_data_feature_kind(feats[0])
                feature_hint={'point':'Point','route':'Route','shape':'Shape'}.get(k, 'Local Data')
        except Exception:
            pass
        title=_v334_display_title_from_features(feats, feature_hint) if callable(globals().get('_v334_display_title_from_features')) else str(label or 'TAK Map Local Data').replace(' - TAK Map','')
        title=_v334_clean_package_title(title, feature_hint) if callable(globals().get('_v334_clean_package_title')) else str(title or feature_hint).strip()
        package_uid=str(uuid.uuid4())
        package_title=f'{title} - TAK Map - {stamp}'
        safe_title=_safe_filename_label(package_title, 'zip')[:-4]
        zip_name=f'{safe_title}.zip'
        zip_id=_safe_offline_id('tak-dp-local-' + hashlib.sha256((package_uid+zip_name).encode()).hexdigest()[:16])
        zip_path=TAK_MAP_SEND_PACKAGE_DIR/(zip_id + '.zip')
        sender=_v331_tak_client_username('takmap')
        cot_entries=[]
        for idx,f in enumerate(feats):
            uid,cot=_v331_cot_event_for_feature(f, idx, package_uid, sender)
            if uid and cot:
                try:
                    cot_txt=cot.decode('utf-8','ignore')
                    cot_txt=cot_txt.replace("version='v334'", "version='v335'").replace('version="v334"', 'version="v335"')
                    cot_txt=cot_txt.replace("version='v333'", "version='v335'").replace('version="v333"', 'version="v335"')
                    cot_txt=cot_txt.replace("version='v331'", "version='v335'").replace('version="v331"', 'version="v335"')
                    cot=cot_txt.encode('utf-8')
                except Exception:
                    pass
                file_uid=_v335_safe_zip_component(uid, 'cot-' + str(idx+1))
                entry=f'{file_uid}/{file_uid}.cot'
                cot_entries.append({'uid':uid,'entry':entry,'bytes':cot})
        root=ET.Element('MissionPackageManifest', {'version':'2'})
        cfg=ET.SubElement(root, 'Configuration')
        # Match the known-good OTS/ATAK package shape: no onReceiveImport / onReceiveDelete.
        ET.SubElement(cfg, 'Parameter', {'name':'uid', 'value':package_uid})
        ET.SubElement(cfg, 'Parameter', {'name':'name', 'value':package_title})
        contents=ET.SubElement(root, 'Contents')
        for ce in cot_entries:
            c=ET.SubElement(contents, 'Content', {'ignore':'false', 'zipEntry':ce['entry']})
            ET.SubElement(c, 'Parameter', {'name':'uid', 'value':ce['uid']})
        manifest_text='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
        with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
            def write_stable(name, data):
                info=zipfile.ZipInfo(name)
                info.date_time=(2024,1,1,0,0,0)
                info.compress_type=zipfile.ZIP_DEFLATED
                zf.writestr(info, data)
            write_stable('MANIFEST/manifest.xml', manifest_text.encode('utf-8'))
            for ce in cot_entries:
                write_stable(ce['entry'], ce['bytes'])
        return {'ok':True,'path':str(zip_path),'package_name':zip_name,'package_display_name':package_title,'package_uid':package_uid,'sha256':hashlib.sha256(zip_path.read_bytes()).hexdigest(),'size_bytes':zip_path.stat().st_size,'feature_count':len(feats),'cot_count':len(cot_entries),'kml_name':'','geojson_name':'','manifest_path':'MANIFEST/manifest.xml','package_mode':'v335-ots-style-passive-cot','validation':_v335_package_validation(zip_path)}

    # Rebind names consumed by tak_map_local_data_mission_publish and diagnostics.
    _v331_build_local_data_tak_package = _v335_build_local_data_tak_package
    _v331_package_validation = _v335_package_validation

    _v335_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    if callable(_v335_old_local_publish):
        def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
            features=_selected_local_data_features(ids)
            if not features:
                return {'ok':False,'error':'No selected Local Data items were found.'}
            k=str(kind or '').strip().lower() or 'items'
            singular={'points':'Point','routes':'Route','shapes':'Shape','point':'Point','route':'Route','shape':'Shape'}.get(k,'Local Data')
            stamp=datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
            title=_v334_display_title_from_features(features, singular) if callable(globals().get('_v334_display_title_from_features')) else singular
            label=f'{title} - TAK Map'
            pkg=_v335_build_local_data_tak_package(features, label, stamp)
            if not pkg.get('ok'):
                return pkg
            content_label=pkg.get('package_display_name') or label
            res=tak_map_publish_package_to_mission(Path(pkg['path']), pkg.get('package_name') or 'TAK Map Local Data.zip', pkg.get('sha256') or '', mission_name, content_label, 'local-data', server_host, _v331_tak_client_username('takmap'))
            res['package']=pkg
            if res.get('ok'):
                res['user_message']='Published to Data Sync Mission: ' + str(res.get('mission') or mission_name or '').strip() + '.'
                res['message']=res['user_message']
            return res

    def _v335_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v335_versions(_html)
        runtime="""
<script id="v335PassiveMissionPackagePatch">
(function(){
  'use strict';
  const V='v335';
  function boot(){try{document.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,180)},{once:true});else setTimeout(boot,180);
  [900,2200,4200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
"""
        if 'id="v335PassiveMissionPackagePatch"' not in _html and "id='v335PassiveMissionPackagePatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v335_versions(_html)

    TAK_MAP_HTML=_v335_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v335_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v335_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v335_exc:
    try: print('v335 passive Mission package patch failed:', _v335_exc)
    except Exception: pass
# --- end TAK Map v335 OTS-style passive Mission package manifest ---


# --- TAK Map v336 Mission CoT publish for Local Data points ---
try:
    import re as _v336_re

    def _v336_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v336_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v336'", _html)
        _html = _v336_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v336', _html)
        _html = _v336_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v336', _html)
        _html = _v336_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v336\2', _html, flags=_v336_re.I)
        _html = _v336_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v336\2', _html, flags=_v336_re.I)
        _html = _v336_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v336\2', _html, flags=_v336_re.I)
        return _html

    def _v336_single_point_feature(features, kind=''):
        feats=list(features or [])
        if len(feats) != 1:
            return None
        k=str(kind or '').strip().lower()
        if k in ('routes','route','shapes','shape'):
            return None
        try:
            if _local_data_feature_kind(feats[0]) != 'point':
                return None
        except Exception:
            return None
        pts=_local_data_feature_points(feats[0])
        if not pts or len(pts) != 1:
            return None
        return feats[0]

    def _v336_mission_api_candidate_creators(preferred_uid=''):
        seen=set(); out=[]
        try:
            primary=_mission_publish_creator_uid(preferred_uid)
            if primary.get('uid'):
                u=str(primary.get('uid')).strip()
                out.append({'uid':u,'source':primary.get('source') or 'primary','primary':primary})
                seen.add(u)
            for c in (primary.get('candidates') or []):
                u=str(c.get('uid') or '').strip()
                if u and u not in seen:
                    out.append({'uid':u,'source':c.get('source') or 'candidate'})
                    seen.add(u)
        except Exception:
            pass
        try:
            euds=tak_map_euds().get('euds') or []
            def age(e):
                try: return float(e.get('location_age_seconds'))
                except Exception: return 999999.0
            for e in sorted(euds, key=age):
                u=str(e.get('uid') or '').strip()
                if u and u not in seen:
                    out.append({'uid':u,'source':'tak_map_euds'})
                    seen.add(u)
        except Exception:
            pass
        if not out:
            u=str(preferred_uid or _v331_tak_client_username('takmap')).strip() if callable(globals().get('_v331_tak_client_username')) else str(preferred_uid or 'takmap').strip()
            if u:
                out.append({'uid':u,'source':'fallback'})
        return out

    def _v336_cot_xml_for_feature(f, mission_name='', creator_uid=''):
        package_uid='takmap-mission-cot-' + hashlib.sha1((str(uuid.uuid4())+str(time.time())).encode()).hexdigest()[:18]
        sender=str(creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')).strip() or 'takmap'
        uid,cot=_v331_cot_event_for_feature(f, 0, package_uid, sender)
        if not uid or not cot:
            return '', b''
        try:
            txt=cot.decode('utf-8','ignore')
            txt=txt.replace("version='v331'", "version='v336'").replace('version="v331"', 'version="v336"')
            txt=txt.replace("version='v333'", "version='v336'").replace('version="v333"', 'version="v336"')
            txt=txt.replace("version='v334'", "version='v336'").replace('version="v334"', 'version="v336"')
            txt=txt.replace("version='v335'", "version='v336'").replace('version="v335"', 'version="v336"')
            try:
                root=ET.fromstring(txt.encode('utf-8'))
                detail=root.find('detail')
                if detail is None:
                    detail=ET.SubElement(root, 'detail')
                ET.SubElement(detail, 'link', {'uid':str(mission_name or ''), 'type':'b-f-t-r', 'relation':'p-m'})
                txt='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            except Exception:
                pass
            cot=txt.encode('utf-8')
        except Exception:
            pass
        return uid,cot

    def _v336_mission_cot_attempts(mission, creator_uid, cot_bytes, server_host=''):
        mission_q=quote(str(mission or ''), safe='')
        creator_q=quote(str(creator_uid or ''), safe='')
        endpoints=[]
        for method in ('POST','PUT'):
            endpoints.append((method, f'/Marti/api/missions/{mission_q}/cot?creatorUid={creator_q}'))
            endpoints.append((method, f'/Marti/api/missions/{mission_q}/cot?creatorUid={creator_q}&tool=public'))
        results=[]
        for method,path in endpoints:
            r=_ots_mission_api_request(path, method=method, body=cot_bytes, headers={'Content-Type':'application/xml; charset=UTF-8','Content-Length':str(len(cot_bytes))}, public_host=server_host, timeout=25)
            rr=dict(r or {})
            rr['method']=method
            rr['path']=path
            results.append(rr)
            if rr.get('ok'):
                return rr, results
        return (results[-1] if results else {'ok':False,'error':'No Mission CoT endpoint attempts were made.'}), results

    def tak_map_publish_cot_to_mission(feature, mission_name='', server_host='', preferred_creator_uid=''):
        mission=str(mission_name or '').strip() or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME','TAK Dashboard Mission').strip() or 'TAK Dashboard Mission'
        creators=_v336_mission_api_candidate_creators(preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap'))
        overall_attempts=[]
        chosen=None; create={}; cot={}; cot_attempts=[]; event_uid=''; cot_xml=''
        for c in creators:
            creator_uid=str(c.get('uid') or '').strip()
            if not creator_uid:
                continue
            q='creatorUid='+quote(creator_uid, safe='')+'&tool=public&defaultRole=MISSION_SUBSCRIBER'
            create_path='/Marti/api/missions/'+quote(mission, safe='')+'?'+q
            ccreate=_ots_mission_api_request(create_path, method='PUT', body=b'', headers={'Content-Length':'0'}, public_host=server_host, timeout=20)
            uid,cot_bytes=_v336_cot_xml_for_feature(feature, mission, creator_uid)
            if not cot_bytes:
                ccot={'ok':False,'error':'Could not build CoT XML for selected point.'}; attempts=[]
            else:
                ccot,attempts=_v336_mission_cot_attempts(mission, creator_uid, cot_bytes, server_host)
            overall_attempts.append({'creator_uid':creator_uid,'source':c.get('source'),'create_mission':ccreate,'cot_publish':ccot,'cot_attempts':attempts})
            if ccot.get('ok'):
                chosen={'uid':creator_uid,'source':c.get('source')}
                create=ccreate; cot=ccot; cot_attempts=attempts; event_uid=uid
                try: cot_xml=cot_bytes.decode('utf-8','ignore')
                except Exception: cot_xml=''
                break
        ok=bool(chosen and cot.get('ok'))
        create_nonfatal=bool(ok and create and not create.get('ok'))
        label=_v331_name_from_feature(feature, 'Local Point') if callable(globals().get('_v331_name_from_feature')) else 'Local Point'
        out={'ok':ok,'mission':mission,'publish_mode':'mission-cot','content_kind':'local-data-point-cot','content_label':label,'event_uid':event_uid,'creator_uid':(chosen or {}).get('uid',''),'creator':chosen or {},'creator_attempts':overall_attempts,'create_mission':create,'cot_publish':cot,'cot_attempts':cot_attempts,'create_mission_nonfatal':create_nonfatal,'message':'','error':''}
        if ok:
            out['message']='Published to Data Sync Mission: ' + mission + '.'
            out['user_message']=out['message']
            out['publish_succeeded']=True
            out['disable_publish_after_success']=True
            out['close_publish_modal_after_success']=True
            out['data_sync_refresh_recommended']=True
            if create_nonfatal:
                out['nonfatal_note']='Mission already existed or create returned non-2xx, but CoT publish succeeded.'
        else:
            last={}
            try:
                last=(overall_attempts[-1].get('cot_publish') or {}) if overall_attempts else {}
            except Exception:
                last={}
            out['error']='Mission CoT publish failed: ' + str(last.get('error') or last.get('status') or 'all endpoint attempts failed')
        diag=_write_send_diag('mission-cot-publish', out, cot_xml or None)
        if isinstance(diag, dict):
            out['diag_paths']=diag
        return out

    _v336_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    if callable(_v336_old_local_publish):
        def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
            features=_selected_local_data_features(ids)
            if not features:
                return {'ok':False,'error':'No selected Local Data items were found.'}
            point=_v336_single_point_feature(features, kind)
            if point is not None:
                return tak_map_publish_cot_to_mission(point, mission_name, server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
            res=_v336_old_local_publish(ids, kind, mission_name, server_host)
            try:
                if isinstance(res, dict):
                    res.setdefault('fallback_reason','Only single Local Data points use Mission CoT publish in v336; routes/shapes/multi-item sends still use Mission Package ZIPs.')
            except Exception:
                pass
            return res

    def _v336_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v336_versions(_html)
        runtime="""
<script id="v336MissionCotPointPublishPatch">
(function(){
  'use strict';
  const V='v336';
  function boot(){try{document.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,180)},{once:true});else setTimeout(boot,180);
  [900,2200,4200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
"""
        if 'id="v336MissionCotPointPublishPatch"' not in _html and "id='v336MissionCotPointPublishPatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v336_versions(_html)

    TAK_MAP_HTML=_v336_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v336_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v336_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v336_exc:
    try: print('v336 Mission CoT point publish patch failed:', _v336_exc)
    except Exception: pass
# --- end TAK Map v336 Mission CoT publish for Local Data points ---


# --- TAK Map v337 native missionpackage association test for Local Data publishes ---
try:
    import re as _v337_re

    def _v337_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v337_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v337'", _html)
        _html = _v337_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v337', _html)
        _html = _v337_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v337', _html)
        _html = _v337_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v337\2', _html, flags=_v337_re.I)
        _html = _v337_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v337\2', _html, flags=_v337_re.I)
        _html = _v337_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v337\2', _html, flags=_v337_re.I)
        return _html

    def _v337_status_line(label, obj):
        try:
            attempts=obj.get('attempts') or [] if isinstance(obj, dict) else []
            a=attempts[-1] if attempts else (obj if isinstance(obj, dict) else {})
            status=a.get('status') or (obj.get('status') if isinstance(obj, dict) else '') or ''
            url=a.get('url') or (obj.get('url') if isinstance(obj, dict) else '') or ''
            err=a.get('error') or (obj.get('error') if isinstance(obj, dict) else '') or ''
            return f'{label}: status={status or "n/a"} ok={bool(obj.get("ok")) if isinstance(obj, dict) else False} {err} {url}'.strip()
        except Exception:
            return label + ': unavailable'

    def _v337_candidate_creators(preferred_uid=''):
        seen=set(); out=[]
        def add(uid, source, meta=None, front=False):
            u=str(uid or '').strip()
            if not u or u in seen:
                return
            rec={'uid':u,'source':source or 'candidate'}
            if isinstance(meta, dict):
                rec.update({k:v for k,v in meta.items() if k not in rec})
            if front:
                out.insert(0, rec)
            else:
                out.append(rec)
            seen.add(u)
        # Prefer real ATAK/EUD UIDs for Mission API writes. Diagnostics showed
        # creatorUid=takmap can be rejected while ANDROID-* mission users work.
        try:
            euds=tak_map_euds().get('euds') or []
            def age(e):
                try: return float(e.get('location_age_seconds'))
                except Exception: return 999999.0
            for e in sorted(euds, key=age):
                add(e.get('uid'), 'tak_map_euds', {'callsign':e.get('callsign') or e.get('name') or ''})
        except Exception:
            pass
        try:
            if callable(globals().get('_v336_mission_api_candidate_creators')):
                for c in _v336_mission_api_candidate_creators(preferred_uid):
                    add(c.get('uid'), c.get('source') or 'v336-candidate', c)
        except Exception:
            pass
        try:
            primary=_mission_publish_creator_uid(preferred_uid)
            add(primary.get('uid'), primary.get('source') or 'mission_publish_creator', primary)
            for c in (primary.get('candidates') or []):
                add(c.get('uid'), c.get('source') or 'mission_publish_candidate', c)
        except Exception:
            pass
        # Last resort only: dashboard TAK client username.
        try:
            add(preferred_uid or _v331_tak_client_username('takmap'), 'fallback-dashboard-uid')
        except Exception:
            add(preferred_uid or 'takmap', 'fallback-dashboard-uid')
        return out

    def _v337_create_or_get_mission(mission, creator_uid, server_host=''):
        q='creatorUid='+quote(str(creator_uid or ''), safe='')+'&tool=public&defaultRole=MISSION_SUBSCRIBER'
        create_path='/Marti/api/missions/'+quote(str(mission or ''), safe='')+'?'+q
        return _ots_mission_api_request(create_path, method='PUT', body=b'', headers={'Content-Length':'0'}, public_host=server_host, timeout=25)

    def _v337_sync_upload(saved_path, publish_filename, sha, creator_uid, keywords, server_host=''):
        zp=Path(str(saved_path))
        file_bytes=zp.read_bytes()
        upload_q='name='+quote(str(publish_filename or zp.name), safe='')+'&creatorUid='+quote(str(creator_uid or ''), safe='')+'&tool=public'
        for kw in (keywords or []):
            upload_q += '&keywords=' + quote(str(kw), safe='')
        r=_ots_mission_api_request('/Marti/sync/upload?'+upload_q, method='POST', body=file_bytes, headers={'Content-Type':'application/zip','Content-Length':str(len(file_bytes))}, public_host=server_host, timeout=45)
        uploaded_hash=str(((r.get('json') or {}).get('Hash') or (r.get('json') or {}).get('hash') or (r.get('json') or {}).get('uid') or sha)).strip()
        return {'ok':bool(r.get('ok')),'mode':'sync-upload','request':r,'uploaded_hash':uploaded_hash or sha,'upload_filename':publish_filename}

    def _v337_missionupload(saved_path, publish_filename, sha, creator_uid, server_host=''):
        # Native OTS missionupload is the ATAK-like registration path. It returns
        # metadata/tool URL data, but mission content association still keys on hash.
        try:
            r=_ots_missionupload_and_register_tool(Path(str(saved_path)), str(publish_filename or Path(str(saved_path)).name), str(sha or ''), str(creator_uid or ''), server_host)
        except Exception as e:
            r={'ok':False,'error':str(e)}
        return {'ok':bool(r.get('ok')),'mode':'missionupload','request':r,'uploaded_hash':str(sha or '').strip(),'upload_filename':r.get('upload_filename') or publish_filename}

    def _v337_associate_missionpackage(mission, creator_uid, uploaded_hash, token='', server_host=''):
        mission_q=quote(str(mission or ''), safe='')
        creator_q=quote(str(creator_uid or ''), safe='')
        h=str(uploaded_hash or '').strip()
        attempts=[]
        # Prefer the explicit Mission Package endpoint suggested by TAK/OTS usage.
        # Do not fall back to generic /contents in v337 local-data tests; generic
        # /contents is the path that already caused ATAK to prompt on ZIPs.
        endpoint_specs=[
            ('PUT', f'/Marti/api/missions/{mission_q}/contents/missionpackage?creatorUid={creator_q}'),
            ('PUT', f'/Marti/api/missions/{mission_q}/contents/missionpackage?creatorUid={creator_q}&tool=public'),
            ('PUT', f'/Marti/api/missions/{mission_q}/contents/missionpackage?creatorUid={creator_q}&hash={quote(h, safe="")}'),
            ('PUT', f'/Marti/api/missions/{mission_q}/contents/missionpackage?creatorUid={creator_q}&tool=public&hash={quote(h, safe="")}'),
            ('POST', f'/Marti/api/missions/{mission_q}/contents/missionpackage?creatorUid={creator_q}'),
            ('POST', f'/Marti/api/missions/{mission_q}/contents/missionpackage?creatorUid={creator_q}&tool=public'),
        ]
        body_variants=[
            ('hashes-json', json.dumps({'hashes':[h]}).encode('utf-8'), 'application/json'),
            ('hash-json', json.dumps({'hash':h}).encode('utf-8'), 'application/json'),
            ('array-json', json.dumps([h]).encode('utf-8'), 'application/json'),
            ('text-hash', h.encode('utf-8'), 'text/plain'),
        ]
        for method,path in endpoint_specs:
            # Query hash variants may expect an empty body; try that first.
            variants=list(body_variants)
            if '&hash=' in path:
                variants=[('empty', b'', 'application/octet-stream')] + variants
            for variant, body, ctype in variants:
                headers={'Content-Length':str(len(body))}
                if body or ctype != 'application/octet-stream':
                    headers['Content-Type']=ctype
                r=_ots_mission_api_request(path, method=method, body=body, headers=headers, token=token, public_host=server_host, timeout=25)
                rr=dict(r or {})
                rr['association_endpoint']='contents/missionpackage'
                rr['method']=method
                rr['path']=path
                rr['body_variant']=variant
                attempts.append(rr)
                if rr.get('ok'):
                    out=dict(rr)
                    out['ok']=True
                    out['attempts']=attempts
                    out['selected_body_variant']=variant
                    return out
                # Avoid hammering unsupported methods/paths with every body shape.
                status=str(rr.get('status') or '')
                if status in ('404','405') and variant in ('hashes-json','empty'):
                    break
        return {'ok':False,'error':'All explicit Mission Package association attempts failed. Generic /contents fallback intentionally not used in v337 test.','attempts':attempts}

    def tak_map_publish_package_to_mission_v337(zip_path, package_filename, sha256_hash, mission_name='', content_label='', content_kind='local-data', server_host='', preferred_creator_uid=''):
        mission=str(mission_name or '').strip() or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME','TAK Map Mission').strip() or 'TAK Map Mission'
        zp=Path(str(zip_path))
        if not zp.exists():
            return {'ok':False,'error':'Package ZIP does not exist.','path':str(zp),'mission':mission}
        sha=str(sha256_hash or '').strip() or hashlib.sha256(zp.read_bytes()).hexdigest()
        base_fn=str(package_filename or zp.name or 'TAK-Map-Package.zip').strip() or 'TAK-Map-Package.zip'
        stem,ext=os.path.splitext(base_fn)
        if not ext:
            ext='.zip'
        # Keep a unique OTS inventory filename but don't duplicate if already hash-suffixed.
        publish_filename=base_fn if sha[:12] in stem else f'{stem}-{sha[:12]}{ext}'
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
        saved_name=_safe_filename_label(publish_filename, 'zip')
        saved_path=TAK_MAP_SEND_PACKAGE_DIR / saved_name
        try:
            if zp.resolve() != saved_path.resolve():
                saved_path.write_bytes(zp.read_bytes())
        except Exception:
            try: _v331_shutil.copyfile(str(zp), str(saved_path))
            except Exception: saved_path=zp
        validation=_v331_package_validation(saved_path) if callable(globals().get('_v331_package_validation')) else {}
        keywords=['missionpackage','tak-map',str(content_kind or 'local-data')]
        if 'local-data' not in keywords:
            keywords.append('local-data')
        creators=_v337_candidate_creators(preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap'))
        creator_attempts=[]
        selected={'ok':False}
        for cand in creators:
            cuid=str(cand.get('uid') or '').strip()
            if not cuid:
                continue
            create=_v337_create_or_get_mission(mission, cuid, server_host)
            token=_extract_mission_token(create.get('json') or {})
            upload_results=[]
            assoc_results=[]
            # First try native ATAK-like missionupload; if explicit association fails,
            # try generic sync upload but still associate only via contents/missionpackage.
            for uploader in ('missionupload','sync-upload'):
                if uploader == 'missionupload':
                    up=_v337_missionupload(saved_path, publish_filename, sha, cuid, server_host)
                else:
                    up=_v337_sync_upload(saved_path, publish_filename, sha, cuid, keywords, server_host)
                upload_results.append(up)
                if not up.get('ok'):
                    continue
                assoc=_v337_associate_missionpackage(mission, cuid, up.get('uploaded_hash') or sha, token, server_host)
                assoc_results.append({'upload_mode':uploader,'assoc':assoc})
                if assoc.get('ok'):
                    selected={'ok':True,'creator_uid':cuid,'creator':cand,'create_mission':create,'upload_content':up,'associate_content':assoc,'uploaded_hash':up.get('uploaded_hash') or sha,'upload_mode':uploader}
                    break
            creator_attempts.append({'uid':cuid,'source':cand.get('source'),'create_mission':create,'upload_results':upload_results,'association_results':assoc_results,'ok':bool(selected.get('ok') and selected.get('creator_uid')==cuid)})
            if selected.get('ok'):
                break
        ok=bool(selected.get('ok'))
        create=selected.get('create_mission') or {}
        upload=selected.get('upload_content') or {}
        assoc=selected.get('associate_content') or {}
        out={'ok':ok,'mission':mission,'publish_mode':'missionpackage-explicit-v337','creator_uid':selected.get('creator_uid') or '','creator':selected.get('creator') or {},'creator_attempts':creator_attempts,'content_kind':content_kind,'content_label':content_label,'package_filename':base_fn,'publish_filename':publish_filename,'package_local_path':str(saved_path),'path':str(saved_path),'sha256':sha,'uploaded_hash':selected.get('uploaded_hash') or sha,'keywords':keywords,'package_validation':validation,'create_mission':create,'upload_content':upload,'associate_content':assoc,'generic_contents_fallback_used':False,'create_mission_nonfatal':bool(ok and create and not create.get('ok')),'message':'','error':''}
        if ok:
            out['message']='Published to Data Sync Mission: ' + mission + '.'
            out['user_message']=out['message']
            out['publish_succeeded']=True
            out['disable_publish_after_success']=True
            out['close_publish_modal_after_success']=True
            out['data_sync_refresh_recommended']=True
        else:
            last={}
            try:
                last_assoc=(creator_attempts[-1].get('association_results') or [])[-1]
                last=last_assoc.get('assoc') or {}
            except Exception:
                pass
            parts=[]
            if not last:
                try: last=(creator_attempts[-1].get('upload_results') or [])[-1].get('request') or {}
                except Exception: last={}
            for label,obj in (('create mission',create),('upload content',upload.get('request') if isinstance(upload, dict) else upload),('associate missionpackage',last)):
                if isinstance(obj, dict) and not obj.get('ok'):
                    parts.append(_v337_status_line(label,obj))
            out['error']='; '.join(parts) or 'Mission Package publish failed.'
        diag=_write_send_diag('missionpackage-explicit-publish', out, None)
        if isinstance(diag, dict):
            out['diag_paths']=diag
        return out

    _v337_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features=_selected_local_data_features(ids)
        if not features:
            return {'ok':False,'error':'No selected Local Data items were found.'}
        k=str(kind or '').strip().lower() or 'items'
        singular={'points':'Point','routes':'Route','shapes':'Shape','point':'Point','route':'Route','shape':'Shape'}.get(k,'Local Data')
        stamp=datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        title=_v334_display_title_from_features(features, singular) if callable(globals().get('_v334_display_title_from_features')) else singular
        label=f'{title} - TAK Map'
        pkg=_v335_build_local_data_tak_package(features, label, stamp) if callable(globals().get('_v335_build_local_data_tak_package')) else _v331_build_local_data_tak_package(features, label, stamp)
        if not pkg.get('ok'):
            return pkg
        content_label=pkg.get('package_display_name') or label
        res=tak_map_publish_package_to_mission_v337(Path(pkg['path']), pkg.get('package_name') or 'TAK Map Local Data.zip', pkg.get('sha256') or '', mission_name, content_label, 'local-data', server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        res['package']=pkg
        return res

    def _v337_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v337_versions(_html)
        runtime="""
<script id="v337ExplicitMissionPackagePatch">
(function(){
  'use strict';
  const V='v337';
  function boot(){try{document.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,180)},{once:true});else setTimeout(boot,180);
  [900,2200,4200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
"""
        if 'id="v337ExplicitMissionPackagePatch"' not in _html and "id='v337ExplicitMissionPackagePatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v337_versions(_html)

    TAK_MAP_HTML=_v337_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v337_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v337_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v337_exc:
    try: print('v337 explicit Mission Package association patch failed:', _v337_exc)
    except Exception: pass
# --- end TAK Map v337 native missionpackage association test for Local Data publishes ---

# --- TAK Map v338 upload-only Data Sync storage test for Local Data publishes ---
try:
    import re as _v338_re

    def _v338_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v338_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v338'", _html)
        _html = _v338_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v338', _html)
        _html = _v338_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v338', _html)
        _html = _html.replace('v337ExplicitMissionPackagePatch', 'v338LegacyExplicitMissionPackagePatch')
        _html = _html.replace('v336MissionCotPointPublishPatch', 'v338LegacyMissionCotPointPublishPatch')
        _html = _v338_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v338\2', _html, flags=_v338_re.I)
        _html = _v338_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v338\2', _html, flags=_v338_re.I)
        _html = _v338_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v338\2', _html, flags=_v338_re.I)
        return _html

    def _v338_upload_only_creator(preferred_uid=''):
        # For this isolation test, mimic the older working ZIP upload metadata as
        # closely as possible: upload to sync storage with the dashboard TAK client
        # identity, but do not create/update a mission and do not add mission content.
        try:
            u = str(preferred_uid or _v331_tak_client_username('takmap') or 'takmap').strip()
        except Exception:
            u = str(preferred_uid or 'takmap').strip()
        return u or 'takmap'

    def tak_map_upload_package_to_sync_storage_v338(zip_path, package_filename, sha256_hash, mission_name='', content_label='', content_kind='local-data', server_host='', preferred_creator_uid=''):
        mission = str(mission_name or '').strip() or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME','TAK Map Mission').strip() or 'TAK Map Mission'
        zp = Path(str(zip_path))
        if not zp.exists():
            return {'ok':False,'error':'Package ZIP does not exist.','path':str(zp),'mission':mission,'publish_mode':'upload-only-v338'}
        sha = str(sha256_hash or '').strip() or hashlib.sha256(zp.read_bytes()).hexdigest()
        base_fn = str(package_filename or zp.name or 'TAK-Map-Package.zip').strip() or 'TAK-Map-Package.zip'
        stem, ext = os.path.splitext(base_fn)
        if not ext:
            ext = '.zip'
        publish_filename = base_fn if sha[:12] in stem else f'{stem}-{sha[:12]}{ext}'
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
        saved_name = _safe_filename_label(publish_filename, 'zip')
        saved_path = TAK_MAP_SEND_PACKAGE_DIR / saved_name
        try:
            if zp.resolve() != saved_path.resolve():
                saved_path.write_bytes(zp.read_bytes())
        except Exception:
            try:
                _v331_shutil.copyfile(str(zp), str(saved_path))
            except Exception:
                saved_path = zp
        validation = _v331_package_validation(saved_path) if callable(globals().get('_v331_package_validation')) else {}
        keywords = ['missionpackage','tak-map',str(content_kind or 'local-data')]
        if 'local-data' not in keywords:
            keywords.append('local-data')
        creator_uid = _v338_upload_only_creator(preferred_creator_uid)
        upload = _v337_sync_upload(saved_path, publish_filename, sha, creator_uid, keywords, server_host) if callable(globals().get('_v337_sync_upload')) else {'ok':False,'error':'v337 sync upload helper unavailable.'}
        ok = bool(upload.get('ok'))
        out = {
            'ok': ok,
            'mission': mission,
            'publish_mode': 'upload-only-v338',
            'creator_uid': creator_uid,
            'content_kind': content_kind,
            'content_label': content_label,
            'package_filename': base_fn,
            'publish_filename': publish_filename,
            'package_local_path': str(saved_path),
            'path': str(saved_path),
            'sha256': sha,
            'uploaded_hash': upload.get('uploaded_hash') or sha,
            'keywords': keywords,
            'package_validation': validation,
            'create_mission': {'ok': False, 'skipped': True, 'reason': 'v338 upload-only test: mission create/update intentionally skipped.'},
            'upload_content': upload,
            'associate_content': {'ok': False, 'skipped': True, 'reason': 'v338 upload-only test: mission contents association intentionally skipped.'},
            'association_skipped': True,
            'generic_contents_fallback_used': False,
            'data_sync_refresh_recommended': False,
            'message': '',
            'error': ''
        }
        if ok:
            out['message'] = 'Uploaded to Data Sync storage only. Mission association skipped for overwrite test.'
            out['user_message'] = out['message']
            out['publish_succeeded'] = True
            out['disable_publish_after_success'] = True
            out['close_publish_modal_after_success'] = True
            out['upload_only_test'] = True
        else:
            req = upload.get('request') if isinstance(upload, dict) else {}
            err = upload.get('error') or (req.get('error') if isinstance(req, dict) else '') or 'Sync storage upload failed.'
            out['error'] = 'Upload-only test failed: ' + str(err)
        diag = _write_send_diag('mission-upload-only-test', out, None)
        if isinstance(diag, dict):
            out['diag_paths'] = diag
        return out

    _v338_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features = _selected_local_data_features(ids)
        if not features:
            return {'ok':False,'error':'No selected Local Data items were found.'}
        k = str(kind or '').strip().lower() or 'items'
        singular = {'points':'Point','routes':'Route','shapes':'Shape','point':'Point','route':'Route','shape':'Shape'}.get(k,'Local Data')
        stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        title = _v334_display_title_from_features(features, singular) if callable(globals().get('_v334_display_title_from_features')) else singular
        label = f'{title} - TAK Map'
        pkg = _v335_build_local_data_tak_package(features, label, stamp) if callable(globals().get('_v335_build_local_data_tak_package')) else _v331_build_local_data_tak_package(features, label, stamp)
        if not pkg.get('ok'):
            return pkg
        content_label = pkg.get('package_display_name') or label
        res = tak_map_upload_package_to_sync_storage_v338(Path(pkg['path']), pkg.get('package_name') or 'TAK Map Local Data.zip', pkg.get('sha256') or '', mission_name, content_label, 'local-data', server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        res['package'] = pkg
        return res

    def _v338_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v338_versions(_html)
        runtime = r'''
<script id="v338UploadOnlyPublishPatch">
(function(){
  'use strict';
  const V='v338';
  const $=id=>document.getElementById(id);
  function esc2(v){try{const s=String(v==null?'':v);return s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}catch(_){return String(v==null?'':v)}}
  function isMissionPublishMode(){try{return ['local-data-publish','live-basemap','offline'].includes(String(activeSendMode||''));}catch(_){return false}}
  function resetPublishControls(){try{const b=$('sendConfirmBtn');if(b){b.disabled=false;b.dataset.v332Published='0';b.classList.remove('tak-publish-done');if(isMissionPublishMode())b.textContent='Publish';}const s=$('sendStatus');if(s&&isMissionPublishMode())s.classList.remove('tak-publish-success','danger');}catch(_){} }
  function markPublishing(){const b=$('sendConfirmBtn');if(b){b.disabled=true;b.dataset.v332Published='0';b.textContent='Publishing...';}}
  function markSuccess(msg){try{const b=$('sendConfirmBtn');if(b){b.disabled=true;b.dataset.v332Published='1';b.classList.add('tak-publish-done');b.textContent='Uploaded';}const s=$('sendStatus');if(s){s.classList.remove('danger');s.classList.add('tak-publish-success');s.innerHTML='<span class="tak-success-line">✓ '+esc2(msg||'Uploaded to Data Sync storage.')+'</span>';}}catch(_){} }
  function markFailure(msg){try{const b=$('sendConfirmBtn');if(b){b.disabled=false;b.dataset.v332Published='0';b.classList.remove('tak-publish-done');b.textContent='Publish';}const s=$('sendStatus');if(s){s.classList.remove('tak-publish-success');s.innerHTML='<span class="danger">'+esc2(msg||'Publish failed.')+'</span>';}}catch(_){} }
  async function publishRequest(mode, mission){
    if(mode==='local-data-publish')return fetch('/api/tak-map/local-data-mission-publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:activeLocalSendIds,kind:activeLocalSendKind,missionName:mission,serverHost:location.hostname})});
    if(mode==='live-basemap')return fetch('/api/tak-map/live-basemap-source-mission-publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({basemap_id:activeSendBasemapId,missionName:mission,dashboardOrigin:dashboardHttpsOrigin(),serverHost:location.hostname})});
    return fetch('/api/tak-map/offline-mission-publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:activeSendMapId,missionName:mission,serverHost:location.hostname})});
  }
  const oldConfirm=window.confirmSendOfflineMap;
  window.confirmSendOfflineMap=async function(){
    try{
      if(!isMissionPublishMode())return oldConfirm?oldConfirm.apply(this,arguments):undefined;
      const b=$('sendConfirmBtn'); if(b&&b.dataset.v332Published==='1')return false;
      const mission=(typeof selectedMissionName==='function'?selectedMissionName():'')||'';
      if(!mission){markFailure('Select a Data Sync Mission.');return false;}
      const mode=String(activeSendMode||''); const s=$('sendStatus');
      if(s){s.classList.remove('danger','tak-publish-success');s.textContent=(mode==='local-data-publish'?'Uploading to Data Sync storage only...':'Publishing to Data Sync Mission...');}
      markPublishing();
      const r=await publishRequest(mode, mission); const j=await apiJsonResponseAllowFalse(r);
      if(j&&j.ok){
        const msg=j.user_message||j.message||((j.upload_only_test||j.publish_mode==='upload-only-v338')?'Uploaded to Data Sync storage.':'Published to Data Sync Mission: '+mission+'.');
        markSuccess(msg);
        if(j.data_sync_refresh_recommended!==false && !(j.upload_only_test||j.publish_mode==='upload-only-v338')){try{forceDataSyncSync(mode==='local-data-publish'?'mission-publish-local-data':(mode==='live-basemap'?'mission-publish-basemap':'mission-publish-offline'))}catch(_){ }}
        try{if(mode==='offline'){offlineMaps=j.maps||offlineMaps;applyOfflineBasemaps();renderOfflineMapRows();renderBasemaps();}}catch(_){ }
        setTimeout(function(){try{const modal=$('sendModal');const btn=$('sendConfirmBtn');if(modal&&modal.classList.contains('active')&&btn&&btn.dataset.v332Published==='1')closeSendModal();}catch(_){ }},2200);
        return false;
      }
      markFailure((j&&j.error)||'Publish failed.'); return false;
    }catch(e){markFailure('Publish failed: '+(e&&e.message?e.message:e));return false;}
  };
  function wrapOpen(name){try{const old=window[name];if(!old||old.__v338Wrapped)return;const wrapped=function(){const r=old.apply(this,arguments);setTimeout(resetPublishControls,80);return r};wrapped.__v338Wrapped=true;window[name]=wrapped;}catch(_){} }
  function boot(){try{document.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}});wrapOpen('openLocalDataPublish');wrapOpen('openSendOfflineMap');wrapOpen('openSendLiveBasemapSource');}catch(_){} }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,220)},{once:true});else setTimeout(boot,220);
  [900,2200,4200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
'''
        if 'id="v338UploadOnlyPublishPatch"' not in _html and "id='v338UploadOnlyPublishPatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v338_versions(_html)

    TAK_MAP_HTML = _v338_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML = _v338_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = _v338_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML = TAK_MAP_HTML
except Exception as _v338_exc:
    try: print('v338 upload-only publish patch failed:', _v338_exc)
    except Exception: pass
# --- end TAK Map v338 upload-only Data Sync storage test for Local Data publishes ---


# --- TAK Map v339 Mission UID spatial publish test + point-drop preview ---
try:
    import re as _v339_re

    def _v339_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v339_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v339'", _html)
        _html = _v339_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v339', _html)
        _html = _v339_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v339', _html)
        _html = _html.replace('v338UploadOnlyPublishPatch', 'v339LegacyUploadOnlyPublishPatch')
        _html = _html.replace('v337ExplicitMissionPackagePatch', 'v339LegacyExplicitMissionPackagePatch')
        _html = _html.replace('v336MissionCotPointPublishPatch', 'v339LegacyMissionCotPointPublishPatch')
        _html = _v339_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v339\2', _html, flags=_v339_re.I)
        _html = _v339_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v339\2', _html, flags=_v339_re.I)
        _html = _v339_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v339\2', _html, flags=_v339_re.I)
        return _html

    def _v339_single_point_feature(features, kind=''):
        try:
            fl=list(features or [])
            if len(fl) != 1:
                return None
            if str(kind or '').strip().lower() not in ('', 'point', 'points'):
                return None
            if _local_data_feature_kind(fl[0]) != 'point':
                return None
            pts=_local_data_feature_points(fl[0])
            if len(pts) != 1:
                return None
            return fl[0]
        except Exception:
            return None

    def _v339_associate_uid_to_mission(mission, creator_uid, event_uid, token='', server_host=''):
        mission_q=quote(str(mission or ''), safe='')
        creator_q=quote(str(creator_uid or ''), safe='')
        uid=str(event_uid or '').strip()
        attempts=[]
        endpoint_specs=[
            ('PUT', f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}'),
            ('PUT', f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}&tool=public'),
            ('POST', f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}'),
            ('POST', f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}&tool=public'),
        ]
        body_variants=[
            ('uids-json', json.dumps({'uids':[uid]}).encode('utf-8'), 'application/json'),
            ('uids-json-with-after', json.dumps({'uids':[uid], 'after':''}).encode('utf-8'), 'application/json'),
            ('uids-and-paths-json', json.dumps({'uids':[uid], 'paths':{}}).encode('utf-8'), 'application/json'),
            ('uid-json', json.dumps({'uid':uid}).encode('utf-8'), 'application/json'),
            ('array-json', json.dumps([uid]).encode('utf-8'), 'application/json'),
        ]
        for method,path in endpoint_specs:
            for variant, body, ctype in body_variants:
                headers={'Content-Type':ctype,'Content-Length':str(len(body))}
                r=_ots_mission_api_request(path, method=method, body=body, headers=headers, token=token, public_host=server_host, timeout=25)
                rr=dict(r or {})
                rr['association_endpoint']='contents-uids'
                rr['method']=method
                rr['path']=path
                rr['body_variant']=variant
                rr['event_uid']=uid
                attempts.append(rr)
                if rr.get('ok'):
                    out=dict(rr)
                    out['ok']=True
                    out['attempts']=attempts
                    out['selected_body_variant']=variant
                    return out
                status=str(rr.get('status') or '')
                if status in ('404','405') and variant == 'uids-json':
                    break
        return {'ok':False,'error':'All Mission UID association attempts failed.','attempts':attempts,'event_uid':uid}

    def tak_map_publish_point_uid_to_mission_v339(feature, mission_name='', server_host='', preferred_creator_uid=''):
        mission=str(mission_name or '').strip() or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME','TAK Dashboard Mission').strip() or 'TAK Dashboard Mission'
        label=_v331_name_from_feature(feature, 'Local Point') if callable(globals().get('_v331_name_from_feature')) else 'Local Point'
        creators=_v337_candidate_creators(preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')) if callable(globals().get('_v337_candidate_creators')) else _v336_mission_api_candidate_creators(preferred_creator_uid or 'takmap')
        overall=[]
        selected={}
        cot_xml=''
        for cand in creators:
            creator_uid=str(cand.get('uid') or '').strip()
            if not creator_uid:
                continue
            create=_v337_create_or_get_mission(mission, creator_uid, server_host) if callable(globals().get('_v337_create_or_get_mission')) else _ots_mission_api_request('/Marti/api/missions/'+quote(mission, safe='')+'?creatorUid='+quote(creator_uid, safe='')+'&tool=public&defaultRole=MISSION_SUBSCRIBER', method='PUT', body=b'', headers={'Content-Length':'0'}, public_host=server_host, timeout=20)
            token=_extract_mission_token(create.get('json') or {})
            event_uid,cot_bytes=_v336_cot_xml_for_feature(feature, mission, creator_uid) if callable(globals().get('_v336_cot_xml_for_feature')) else ('', b'')
            send={'ok':False,'error':'No CoT XML generated.'}
            db_lookup={}
            assoc={'ok':False,'error':'association not attempted'}
            if cot_bytes and event_uid:
                try:
                    cot_xml=cot_bytes.decode('utf-8','ignore')
                except Exception:
                    cot_xml=str(cot_bytes)
                send=_send_cot_to_ots(cot_xml) if callable(globals().get('_send_cot_to_ots')) else {'ok':False,'error':'CoT send helper unavailable.'}
                try:
                    db_lookup=_cot_db_lookup(event_uid, '', '', '', timeout=5) if callable(globals().get('_cot_db_lookup')) else {}
                except Exception as e:
                    db_lookup={'ok':False,'error':str(e)}
                assoc=_v339_associate_uid_to_mission(mission, creator_uid, event_uid, token, server_host)
            rec={'creator_uid':creator_uid,'source':cand.get('source'),'create_mission':create,'event_uid':event_uid,'cot_send':send,'db_lookup':db_lookup,'associate_uid':assoc,'ok':bool(assoc.get('ok'))}
            overall.append(rec)
            if assoc.get('ok'):
                selected=rec
                break
        ok=bool(selected.get('ok'))
        out={'ok':ok,'mission':mission,'publish_mode':'mission-uid-spatial-v339','content_kind':'local-data-point-uid','content_label':label,'event_uid':selected.get('event_uid') or (overall[-1].get('event_uid') if overall else ''),'creator_uid':selected.get('creator_uid') or '','creator_attempts':overall,'create_mission':selected.get('create_mission') or {},'cot_send':selected.get('cot_send') or {},'associate_content':selected.get('associate_uid') or {},'zip_package_created':False,'zip_upload_skipped':True,'message':'','error':''}
        if ok:
            out['message']='Published to Data Sync Mission: ' + mission + '.'
            out['user_message']=out['message']
            out['publish_succeeded']=True
            out['disable_publish_after_success']=True
            out['close_publish_modal_after_success']=True
            out['data_sync_refresh_recommended']=True
            out['non_package_publish']=True
        else:
            last=overall[-1] if overall else {}
            parts=[]
            for name,obj in (('create mission', last.get('create_mission') or {}), ('CoT send', last.get('cot_send') or {}), ('associate UID', last.get('associate_uid') or {})):
                if isinstance(obj, dict) and not obj.get('ok'):
                    a=(obj.get('attempts') or [{}])[-1] if isinstance(obj.get('attempts'), list) else {}
                    parts.append(f"{name}: status={a.get('status') or obj.get('status') or 'n/a'} {obj.get('error') or a.get('error') or ''}".strip())
            out['error']='Mission UID publish failed: ' + ('; '.join(parts) or 'all attempts failed')
        diag=_write_send_diag('mission-uid-spatial-publish', out, cot_xml or None)
        if isinstance(diag, dict):
            out['diag_paths']=diag
        return out

    _v339_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features=_selected_local_data_features(ids)
        if not features:
            return {'ok':False,'error':'No selected Local Data items were found.'}
        point=_v339_single_point_feature(features, kind)
        if point is not None:
            return tak_map_publish_point_uid_to_mission_v339(point, mission_name, server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        if callable(_v339_old_local_publish):
            res=_v339_old_local_publish(ids, kind, mission_name, server_host)
            try:
                if isinstance(res, dict):
                    res.setdefault('fallback_reason','v339 Mission UID spatial publish only handles exactly one Local Data point. Other Local Data publishes use the previous test path.')
            except Exception:
                pass
            return res
        return {'ok':False,'error':'v339 local publish fallback unavailable for this Local Data selection.'}

    def _v339_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v339_versions(_html)
        runtime = r"""
<script id="v339MissionUidPointPublishAndDropPreview">
(function(){
  'use strict';
  const V='v339';
  const d=document;
  function $(id){return d.getElementById(id)}
  function esc(v){try{return String(v==null?'':v).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}catch(_){return String(v==null?'':v)}}
  function setVersion(){try{d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  function isMissionPublishMode(){try{return ['local-data-publish','live-basemap','offline'].includes(String(activeSendMode||''));}catch(_){return false}}
  function resetPublishControls(){try{const b=$('sendConfirmBtn');if(b){b.disabled=false;b.dataset.v332Published='0';b.classList.remove('tak-publish-done');if(isMissionPublishMode())b.textContent='Publish';}const s=$('sendStatus');if(s&&isMissionPublishMode())s.classList.remove('tak-publish-success','danger');}catch(_){} }
  function markPublishing(){const b=$('sendConfirmBtn');if(b){b.disabled=true;b.dataset.v332Published='0';b.textContent='Publishing...';}}
  function markSuccess(msg){try{const b=$('sendConfirmBtn');if(b){b.disabled=true;b.dataset.v332Published='1';b.classList.add('tak-publish-done');b.textContent='Published';}const s=$('sendStatus');if(s){s.classList.remove('danger');s.classList.add('tak-publish-success');s.innerHTML='<span class="tak-success-line">✓ '+esc(msg||'Published.')+'</span>';}}catch(_){} }
  function markFailure(msg){try{const b=$('sendConfirmBtn');if(b){b.disabled=false;b.dataset.v332Published='0';b.classList.remove('tak-publish-done');b.textContent='Publish';}const s=$('sendStatus');if(s){s.classList.remove('tak-publish-success');s.innerHTML='<span class="danger">'+esc(msg||'Publish failed.')+'</span>';}}catch(_){} }
  async function publishRequest(mode, mission){
    if(mode==='local-data-publish')return fetch('/api/tak-map/local-data-mission-publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:activeLocalSendIds,kind:activeLocalSendKind,missionName:mission,serverHost:location.hostname})});
    if(mode==='live-basemap')return fetch('/api/tak-map/live-basemap-source-mission-publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({basemap_id:activeSendBasemapId,missionName:mission,dashboardOrigin:dashboardHttpsOrigin(),serverHost:location.hostname})});
    return fetch('/api/tak-map/offline-mission-publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:activeSendMapId,missionName:mission,serverHost:location.hostname})});
  }
  const oldConfirm=window.confirmSendOfflineMap;
  window.confirmSendOfflineMap=async function(){
    try{
      if(!isMissionPublishMode())return oldConfirm?oldConfirm.apply(this,arguments):undefined;
      const b=$('sendConfirmBtn'); if(b&&b.dataset.v332Published==='1')return false;
      const mission=(typeof selectedMissionName==='function'?selectedMissionName():'')||'';
      if(!mission){markFailure('Select a Data Sync Mission.');return false;}
      const mode=String(activeSendMode||''); const s=$('sendStatus');
      if(s){s.classList.remove('danger','tak-publish-success');s.textContent=(mode==='local-data-publish'?'Publishing point to mission spatial feed...':'Publishing to Data Sync Mission...');}
      markPublishing();
      const r=await publishRequest(mode, mission); const j=await apiJsonResponseAllowFalse(r);
      if(j&&j.ok){
        const msg=j.user_message||j.message||('Published to Data Sync Mission: '+mission+'.');
        markSuccess(msg);
        if(j.data_sync_refresh_recommended!==false){try{forceDataSyncSync(mode==='local-data-publish'?'mission-publish-local-data':(mode==='live-basemap'?'mission-publish-basemap':'mission-publish-offline'))}catch(_){ }}
        try{if(mode==='offline'){offlineMaps=j.maps||offlineMaps;applyOfflineBasemaps();renderOfflineMapRows();renderBasemaps();}}catch(_){ }
        setTimeout(function(){try{const modal=$('sendModal');const btn=$('sendConfirmBtn');if(modal&&modal.classList.contains('active')&&btn&&btn.dataset.v332Published==='1')closeSendModal();}catch(_){ }},1800);
        return false;
      }
      markFailure((j&&j.error)||'Publish failed.'); return false;
    }catch(e){markFailure('Publish failed: '+(e&&e.message?e.message:e));return false;}
  };
  function wrapOpen(name){try{const old=window[name];if(!old||old.__v339Wrapped)return;const wrapped=function(){const r=old.apply(this,arguments);setTimeout(resetPublishControls,80);return r};wrapped.__v339Wrapped=true;window[name]=wrapped;}catch(_){} }
  function previewHtml(){return '<div class="tak-v339-point-preview"><svg width="36" height="45" viewBox="0 0 36 45"><path d="M18 42s12-12.2 12-24A12 12 0 0 0 6 18c0 11.8 12 24 12 24Z" fill="rgba(255,111,46,.20)" stroke="#ff6f2e" stroke-width="2.8"/><circle cx="18" cy="18" r="4" fill="#fff"/><circle cx="18" cy="42" r="3" fill="#ff6f2e"/></svg></div>';}
  function removePreview(){try{if(window.v339PointPreviewMarker&&window.map){map.removeLayer(window.v339PointPreviewMarker)} }catch(_){} window.v339PointPreviewMarker=null;}
  function showPreview(ll){try{if(!window.L||!window.map||!ll)return; if(window.v339PointPreviewMarker){window.v339PointPreviewMarker.setLatLng(ll);return;} const icon=L.divIcon({className:'',html:previewHtml(),iconSize:[36,45],iconAnchor:[18,42]}); window.v339PointPreviewMarker=L.marker(ll,{icon:icon,interactive:false,zIndexOffset:1200}).addTo(map);}catch(e){try{console.warn('v339 point preview failed',e)}catch(_){}}}
  function installPointPreview(){try{
    if($('v339PointPreviewStyle')==null){const st=d.createElement('style');st.id='v339PointPreviewStyle';st.textContent='.tak-v339-point-preview{filter:drop-shadow(0 8px 14px rgba(0,0,0,.45)) drop-shadow(0 0 10px rgba(255,111,46,.36));animation:takV339PointPop .16s ease-out}.tak-v339-point-preview svg{display:block}@keyframes takV339PointPop{from{transform:scale(.65);opacity:.2}to{transform:scale(1);opacity:1}}';d.head.appendChild(st)}
    if(window.map&&!window.__v339PointPreviewMapClick){window.__v339PointPreviewMapClick=true;map.on('click',function(e){try{if(String(window.activeMapTool||activeMapTool||'')==='pointdropper'&&e&&e.latlng){showPreview(e.latlng)}}catch(_){}})}
    const oldSave=window.v233SavePoint;if(oldSave&&!oldSave.__v339Wrapped){const wrapped=async function(){try{return await oldSave.apply(this,arguments)}finally{setTimeout(removePreview,900)}};wrapped.__v339Wrapped=true;window.v233SavePoint=wrapped;}
    const oldSet=window.setActiveMapTool;if(oldSet&&!oldSet.__v339Wrapped){const wrapped=function(tool){const r=oldSet.apply(this,arguments);try{if(String(tool||'')!=='pointdropper')setTimeout(removePreview,120)}catch(_){}return r};wrapped.__v339Wrapped=true;window.setActiveMapTool=wrapped;}
  }catch(e){try{console.warn('v339 point preview install failed',e)}catch(_){}} }
  function boot(){setVersion();wrapOpen('openLocalDataPublish');wrapOpen('openSendOfflineMap');wrapOpen('openSendLiveBasemapSource');installPointPreview();}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,250)},{once:true});else setTimeout(boot,250);
  [900,2200,4200,7000].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
"""
        if 'id="v339MissionUidPointPublishAndDropPreview"' not in _html and "id='v339MissionUidPointPublishAndDropPreview'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v339_versions(_html)

    TAK_MAP_HTML=_v339_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v339_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v339_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v339_exc:
    try: print('v339 Mission UID spatial publish / point preview patch failed:', _v339_exc)
    except Exception: pass
# --- end TAK Map v339 Mission UID spatial publish test + point-drop preview ---

# --- TAK Map v340 batch point mission spatial publish + drag-zoom + Data Sync scroll preserve ---
try:
    import re as _v340_re

    def _v340_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v340_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v340'", _html)
        _html = _v340_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v340', _html)
        _html = _v340_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v340', _html)
        _html = _v340_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v340\2', _html, flags=_v340_re.I)
        _html = _v340_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v340\2', _html, flags=_v340_re.I)
        _html = _v340_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v340\2', _html, flags=_v340_re.I)
        _html = _html.replace('Publishing point to mission spatial feed...', 'Publishing point(s) to mission spatial feed...')
        return _html

    def _v340_all_point_features(features, kind=''):
        try:
            fl=list(features or [])
            if not fl:
                return None
            if str(kind or '').strip().lower() not in ('', 'point', 'points'):
                return None
            out=[]
            for f in fl:
                if _local_data_feature_kind(f) != 'point':
                    return None
                pts=_local_data_feature_points(f)
                if len(pts) != 1:
                    return None
                out.append(f)
            return out
        except Exception:
            return None

    def _v340_associate_uids_to_mission(mission, creator_uid, event_uids, token='', server_host=''):
        mission_q=quote(str(mission or ''), safe='')
        creator_q=quote(str(creator_uid or ''), safe='')
        uids=[]
        seen=set()
        for u in event_uids or []:
            uu=str(u or '').strip()
            if uu and uu not in seen:
                uids.append(uu); seen.add(uu)
        attempts=[]
        if not uids:
            return {'ok':False,'error':'No CoT UIDs were available for mission association.','attempts':attempts,'event_uids':uids}
        endpoint_specs=[
            ('PUT', f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}'),
            ('PUT', f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}&tool=public'),
            ('POST', f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}'),
            ('POST', f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}&tool=public'),
        ]
        body_variants=[
            ('uids-json', json.dumps({'uids':uids}).encode('utf-8'), 'application/json'),
            ('uids-json-with-after', json.dumps({'uids':uids, 'after':''}).encode('utf-8'), 'application/json'),
            ('uids-and-paths-json', json.dumps({'uids':uids, 'paths':{}}).encode('utf-8'), 'application/json'),
            ('array-json', json.dumps(uids).encode('utf-8'), 'application/json'),
        ]
        for method,path in endpoint_specs:
            for variant, body, ctype in body_variants:
                headers={'Content-Type':ctype,'Content-Length':str(len(body))}
                r=_ots_mission_api_request(path, method=method, body=body, headers=headers, token=token, public_host=server_host, timeout=25)
                rr=dict(r or {})
                rr['association_endpoint']='contents-uids-batch'
                rr['method']=method
                rr['path']=path
                rr['body_variant']=variant
                rr['event_uids']=uids
                rr['event_uid_count']=len(uids)
                attempts.append(rr)
                if rr.get('ok'):
                    out=dict(rr)
                    out['ok']=True
                    out['attempts']=attempts
                    out['selected_body_variant']=variant
                    out['mode']='batch'
                    out['associated_uids']=uids
                    out['associated_count']=len(uids)
                    return out
                status=str(rr.get('status') or '')
                if status in ('404','405') and variant == 'uids-json':
                    break
        individual=[]
        ok_uids=[]
        for uid in uids:
            try:
                assoc=_v339_associate_uid_to_mission(mission, creator_uid, uid, token, server_host) if callable(globals().get('_v339_associate_uid_to_mission')) else {'ok':False,'error':'single UID helper unavailable','event_uid':uid}
            except Exception as e:
                assoc={'ok':False,'error':str(e),'event_uid':uid}
            individual.append({'event_uid':uid,'associate_uid':assoc,'ok':bool(assoc.get('ok'))})
            if assoc.get('ok'):
                ok_uids.append(uid)
        if len(ok_uids) == len(uids):
            return {'ok':True,'mode':'single-fallback','attempts':attempts,'individual':individual,'associated_uids':ok_uids,'associated_count':len(ok_uids),'event_uids':uids}
        return {'ok':False,'error':'Mission UID association failed for one or more points.','mode':'single-fallback-partial','attempts':attempts,'individual':individual,'associated_uids':ok_uids,'associated_count':len(ok_uids),'event_uids':uids,'failed_uids':[u for u in uids if u not in set(ok_uids)]}

    def tak_map_publish_point_uids_to_mission_v340(features, mission_name='', server_host='', preferred_creator_uid=''):
        mission=str(mission_name or '').strip() or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME','TAK Dashboard Mission').strip() or 'TAK Dashboard Mission'
        point_features=_v340_all_point_features(features, 'points') or []
        label='Local Points' if len(point_features) != 1 else (_v331_name_from_feature(point_features[0], 'Local Point') if callable(globals().get('_v331_name_from_feature')) else 'Local Point')
        if not point_features:
            return {'ok':False,'error':'No publishable Local Data points were selected.'}
        creators=_v337_candidate_creators(preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')) if callable(globals().get('_v337_candidate_creators')) else _v336_mission_api_candidate_creators(preferred_creator_uid or 'takmap')
        overall=[]
        selected={}
        diag_cot=[]
        for cand in creators:
            creator_uid=str(cand.get('uid') or '').strip()
            if not creator_uid:
                continue
            try:
                create=_v337_create_or_get_mission(mission, creator_uid, server_host) if callable(globals().get('_v337_create_or_get_mission')) else _ots_mission_api_request('/Marti/api/missions/'+quote(mission, safe='')+'?creatorUid='+quote(creator_uid, safe='')+'&tool=public&defaultRole=MISSION_SUBSCRIBER', method='PUT', body=b'', headers={'Content-Length':'0'}, public_host=server_host, timeout=20)
            except Exception as e:
                create={'ok':False,'error':str(e),'attempts':[]}
            token=''
            try:
                token=_extract_mission_token(create.get('json') or {})
            except Exception:
                token=''
            point_records=[]
            event_uids=[]
            for idx,feature in enumerate(point_features):
                name=_v331_name_from_feature(feature, f'Local Point {idx+1}') if callable(globals().get('_v331_name_from_feature')) else f'Local Point {idx+1}'
                event_uid=''; cot_bytes=b''; cot_xml=''
                try:
                    event_uid,cot_bytes=_v336_cot_xml_for_feature(feature, mission, creator_uid) if callable(globals().get('_v336_cot_xml_for_feature')) else ('', b'')
                except Exception as e:
                    point_records.append({'index':idx,'name':name,'ok':False,'event_uid':'','cot_send':{'ok':False,'error':'CoT build failed: '+str(e)},'db_lookup':{}})
                    continue
                send={'ok':False,'error':'No CoT XML generated.'}
                db_lookup={}
                if cot_bytes and event_uid:
                    try:
                        cot_xml=cot_bytes.decode('utf-8','ignore')
                    except Exception:
                        cot_xml=str(cot_bytes)
                    diag_cot.append(cot_xml)
                    try:
                        send=_send_cot_to_ots(cot_xml) if callable(globals().get('_send_cot_to_ots')) else {'ok':False,'error':'CoT send helper unavailable.'}
                    except Exception as e:
                        send={'ok':False,'error':str(e)}
                    try:
                        db_lookup=_cot_db_lookup(event_uid, '', '', '', timeout=5) if callable(globals().get('_cot_db_lookup')) else {}
                    except Exception as e:
                        db_lookup={'ok':False,'error':str(e)}
                    if send.get('ok'):
                        event_uids.append(event_uid)
                point_records.append({'index':idx,'name':name,'ok':bool(send.get('ok') and event_uid),'event_uid':event_uid,'cot_send':send,'db_lookup':db_lookup})
            assoc={'ok':False,'error':'No point CoT sends succeeded; mission UID association not attempted.','event_uids':event_uids}
            if event_uids:
                assoc=_v340_associate_uids_to_mission(mission, creator_uid, event_uids, token, server_host)
            expected=len(point_features)
            associated=int(assoc.get('associated_count') or (len(event_uids) if assoc.get('ok') else 0))
            rec={'creator_uid':creator_uid,'source':cand.get('source'),'create_mission':create,'points':point_records,'sent_uids':event_uids,'associate_uids':assoc,'expected_count':expected,'sent_count':len(event_uids),'associated_count':associated,'ok':bool(assoc.get('ok') and associated == expected)}
            overall.append(rec)
            if rec.get('ok'):
                selected=rec
                break
        ok=bool(selected.get('ok'))
        last=selected or (overall[-1] if overall else {})
        associated_count=int((last.get('associated_count') or 0) if isinstance(last, dict) else 0)
        expected_count=len(point_features)
        out={'ok':ok,'mission':mission,'publish_mode':'mission-uid-spatial-batch-v340','content_kind':'local-data-point-uids','content_label':label,'point_count':expected_count,'associated_count':associated_count,'creator_uid':last.get('creator_uid') or '','creator_attempts':overall,'create_mission':last.get('create_mission') or {},'points':last.get('points') or [],'associate_content':last.get('associate_uids') or {},'event_uids':last.get('sent_uids') or [],'zip_package_created':False,'zip_upload_skipped':True,'message':'','error':''}
        if ok:
            out['message']='Published to Data Sync Mission: ' + mission + '.'
            if expected_count > 1:
                out['message']='Published ' + str(expected_count) + ' points to Data Sync Mission: ' + mission + '.'
            out['user_message']=out['message']
            out['publish_succeeded']=True
            out['disable_publish_after_success']=True
            out['close_publish_modal_after_success']=True
            out['data_sync_refresh_recommended']=True
            out['non_package_publish']=True
        else:
            assoc=(last.get('associate_uids') or {}) if isinstance(last, dict) else {}
            send_failures=[]
            try:
                for pr in last.get('points') or []:
                    if not pr.get('ok'):
                        send_failures.append(str(pr.get('name') or pr.get('index') or 'point'))
            except Exception:
                pass
            parts=[]
            if associated_count:
                parts.append('associated ' + str(associated_count) + ' of ' + str(expected_count) + ' points')
            if send_failures:
                parts.append('failed CoT send/build for ' + ', '.join(send_failures[:4]))
            if isinstance(assoc, dict) and assoc.get('error'):
                parts.append(str(assoc.get('error')))
            out['error']='Mission UID batch publish failed: ' + ('; '.join(parts) or 'all attempts failed')
        try:
            diag=_write_send_diag('mission-uid-spatial-batch-publish', out, ('\n\n'.join(diag_cot) if diag_cot else None))
            if isinstance(diag, dict):
                out['diag_paths']=diag
        except Exception:
            pass
        return out

    _v340_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features=_selected_local_data_features(ids)
        if not features:
            return {'ok':False,'error':'No selected Local Data items were found.'}
        point_features=_v340_all_point_features(features, kind)
        if point_features is not None:
            return tak_map_publish_point_uids_to_mission_v340(point_features, mission_name, server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        if callable(_v340_old_local_publish):
            res=_v340_old_local_publish(ids, kind, mission_name, server_host)
            try:
                if isinstance(res, dict):
                    res.setdefault('fallback_reason','v340 non-ZIP mission spatial publishing handles Local Data points. Routes/shapes still use the previous test path.')
            except Exception:
                pass
            return res
        return {'ok':False,'error':'v340 local publish fallback unavailable for this Local Data selection.'}

    def _v340_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v340_versions(_html)
        runtime = r'''
<script id="v340DragZoomAndDataSyncScrollPatch">
(function(){
  'use strict';
  const V='v340';
  const d=document;
  function $(id){return d.getElementById(id)}
  function setVersion(){try{d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  function addCss(){try{if($('v340DragZoomStyle'))return;const st=d.createElement('style');st.id='v340DragZoomStyle';st.textContent=`
.leaflet-control.tak-area-zoom-control{border:0;box-shadow:0 2px 8px rgba(0,0,0,.45)}
.tak-area-zoom-btn{display:flex!important;align-items:center;justify-content:center;width:34px!important;height:34px!important;line-height:34px!important;background:linear-gradient(180deg,rgba(20,31,42,.96),rgba(6,10,14,.97))!important;border:1px solid rgba(255,111,46,.38)!important;border-radius:7px!important;color:#e9f0f5!important;text-decoration:none!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 0 14px rgba(0,0,0,.28)!important;}
.tak-area-zoom-btn:hover,.tak-area-zoom-btn.active{background:linear-gradient(180deg,rgba(255,111,46,.20),rgba(10,14,20,.98))!important;border-color:rgba(255,111,46,.72)!important;box-shadow:0 0 16px rgba(255,111,46,.25)!important;}
.tak-area-zoom-btn svg{width:23px;height:23px;display:block;overflow:visible}.tak-area-zoom-btn .amber{stroke:#ff9d55;fill:none;filter:drop-shadow(0 0 3px rgba(255,111,46,.6))}.tak-area-zoom-btn .white{stroke:#e9f0f5;fill:none}.tak-area-zoom-btn .fillamber{fill:#ff9d55;filter:drop-shadow(0 0 4px rgba(255,111,46,.75))}
.tak-area-zoom-active .leaflet-container,.tak-area-zoom-active{cursor:crosshair!important}.tak-area-zoom-box{position:absolute;z-index:950;pointer-events:none;border:2px dashed #ff9d55;background:rgba(255,111,46,.12);box-shadow:0 0 0 1px rgba(255,255,255,.12),0 0 20px rgba(255,111,46,.22);border-radius:2px}.tak-area-zoom-hint{position:absolute;z-index:951;pointer-events:none;padding:5px 8px;border:1px solid rgba(255,111,46,.45);border-radius:999px;background:rgba(6,10,14,.86);color:#ffd0b0;font-size:11px;font-weight:900;letter-spacing:.03em;box-shadow:0 8px 22px rgba(0,0,0,.35)}
`;d.head.appendChild(st)}catch(e){try{console.warn('v340 CSS failed',e)}catch(_){}}}
  function zoomIcon(){return `<svg viewBox="0 0 32 32" aria-hidden="true"><rect x="4.5" y="5.5" width="17" height="15" rx="1.5" class="white" stroke-width="2" stroke-dasharray="4 2"/><circle cx="21.5" cy="21.5" r="6" class="white" stroke-width="2.2"/><path d="M26 26l4 4" class="white" stroke-width="2.8" stroke-linecap="round"/><path d="M21.5 18.5v6M18.5 21.5h6" class="amber" stroke-width="2.2" stroke-linecap="round"/><path d="M8 10h6M8 14h3" class="amber" stroke-width="1.6" stroke-linecap="round"/></svg>`}
  function installDragZoom(){try{if(!window.L||!window.map||window.__v340DragZoomInstalled)return;window.__v340DragZoomInstalled=true;let active=false,dragging=false,start=null,box=null,hint=null,button=null,dragWasEnabled=true;const map=window.map;const container=map.getContainer();function cp(ev){const r=container.getBoundingClientRect();return L.point(ev.clientX-r.left,ev.clientY-r.top)}function removeBox(){try{if(box&&box.parentNode)box.parentNode.removeChild(box);if(hint&&hint.parentNode)hint.parentNode.removeChild(hint)}catch(_){}box=null;hint=null}function setActive(on){active=!!on;if(button)button.classList.toggle('active',active);container.classList.toggle('tak-area-zoom-active',active);if(!active){removeBox();try{if(dragWasEnabled&&map.dragging)map.dragging.enable()}catch(_){}dragging=false;start=null}}function updateBox(p){if(!box){box=d.createElement('div');box.className='tak-area-zoom-box';container.appendChild(box);hint=d.createElement('div');hint.className='tak-area-zoom-hint';hint.textContent='DRAG ZOOM';container.appendChild(hint)}const x=Math.min(start.x,p.x),y=Math.min(start.y,p.y),w=Math.abs(p.x-start.x),h=Math.abs(p.y-start.y);box.style.left=x+'px';box.style.top=y+'px';box.style.width=w+'px';box.style.height=h+'px';if(hint){hint.style.left=(x+Math.max(0,w-84))+'px';hint.style.top=(Math.max(0,y-31))+'px'}}function finish(ev){if(!dragging)return;const p=cp(ev);const w=Math.abs(p.x-start.x),h=Math.abs(p.y-start.y);try{d.removeEventListener('mousemove',move,true);d.removeEventListener('mouseup',finish,true)}catch(_){}if(w>10&&h>10){const a=map.containerPointToLatLng(start),b=map.containerPointToLatLng(p);map.fitBounds(L.latLngBounds(a,b),{padding:[12,12],animate:true})}setActive(false)}function move(ev){if(!dragging)return;ev.preventDefault();updateBox(cp(ev))}map.on('mousedown',function(e){try{if(!active||!e||!e.originalEvent||e.originalEvent.button!==0)return;L.DomEvent.stop(e.originalEvent);dragging=true;start=map.mouseEventToContainerPoint(e.originalEvent);dragWasEnabled=!!(map.dragging&&map.dragging.enabled&&map.dragging.enabled());try{if(map.dragging)map.dragging.disable()}catch(_){}updateBox(start);d.addEventListener('mousemove',move,true);d.addEventListener('mouseup',finish,true)}catch(err){try{console.warn('v340 drag zoom start failed',err)}catch(_){}}});d.addEventListener('keydown',function(ev){if(ev.key==='Escape'&&active)setActive(false)},true);const ctrl=L.control({position:'topleft'});ctrl.onAdd=function(){const div=L.DomUtil.create('div','leaflet-control tak-area-zoom-control');button=L.DomUtil.create('a','tak-area-zoom-btn',div);button.href='#';button.title='Drag to zoom area';button.setAttribute('role','button');button.setAttribute('aria-label','Drag to zoom area');button.innerHTML=zoomIcon();L.DomEvent.disableClickPropagation(div);L.DomEvent.disableScrollPropagation(div);L.DomEvent.on(button,'click',function(ev){L.DomEvent.stop(ev);setActive(!active)});return div};ctrl.addTo(map)}catch(e){try{console.warn('v340 drag zoom install failed',e)}catch(_){}}}
  function syncScrollables(){try{return Array.from(d.querySelectorAll('.sync-list,#syncList,#dataSyncList,#dataSyncPanel .panel-body,#dataSyncPanel,[id*="dataSync" i],[id*="datasync" i]')).filter(function(el,i,arr){return el&&arr.indexOf(el)===i&&el.scrollHeight>el.clientHeight+4})}catch(_){return []}}
  let lastSnap=[];
  function snap(){try{lastSnap=syncScrollables().map(function(el,idx){return {el:el,idx:idx,id:el.id||'',cls:el.className||'',top:el.scrollTop,left:el.scrollLeft}});return lastSnap}catch(_){return []}}
  function locate(s){try{if(s.el&&d.contains(s.el))return s.el;if(s.id){const e=$(s.id);if(e)return e}const arr=syncScrollables();return arr[s.idx]||null}catch(_){return null}}
  function restore(ss){try{(ss||lastSnap||[]).forEach(function(s){const el=locate(s);if(el){el.scrollTop=s.top||0;el.scrollLeft=s.left||0}})}catch(_){}}
  function scheduleRestore(ss){[0,30,90,180,360,700].forEach(function(ms){setTimeout(function(){restore(ss)},ms)})}
  function isDataSyncClick(t){try{return !!(t&&t.closest&&t.closest('.sync-list,#syncList,#dataSyncList,#dataSyncPanel,[id*="dataSync" i],[id*="datasync" i]'))}catch(_){return false}}
  function installScrollPreserve(){try{if(window.__v340DataSyncScrollPreserve)return;window.__v340DataSyncScrollPreserve=true;d.addEventListener('mousedown',function(e){if(isDataSyncClick(e.target))snap()},true);d.addEventListener('click',function(e){if(isDataSyncClick(e.target)){const ss=snap();scheduleRestore(ss)}},true);d.addEventListener('change',function(e){if(isDataSyncClick(e.target)){const ss=snap();scheduleRestore(ss)}},true);['renderDataSync','renderDataSyncObjects','renderDataSyncRows','drawDataSyncObjects','selectDataSyncObject','focusDataSyncObject'].forEach(function(name){try{const old=window[name];if(old&&!old.__v340ScrollWrapped){const wrapped=function(){const ss=snap();const r=old.apply(this,arguments);scheduleRestore(ss);return r};wrapped.__v340ScrollWrapped=true;window[name]=wrapped}}catch(_){}})}catch(e){try{console.warn('v340 Data Sync scroll preserve failed',e)}catch(_){}}}
  function boot(){setVersion();addCss();installDragZoom();installScrollPreserve()}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,250)},{once:true});else setTimeout(boot,250);
  [800,1800,3600,6500].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
'''
        if 'id="v340DragZoomAndDataSyncScrollPatch"' not in _html and "id='v340DragZoomAndDataSyncScrollPatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v340_versions(_html)

    TAK_MAP_HTML=_v340_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v340_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v340_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v340_exc:
    try: print('v340 batch point publish / drag zoom / scroll patch failed:', _v340_exc)
    except Exception: pass
# --- end TAK Map v340 batch point mission spatial publish + drag-zoom + Data Sync scroll preserve ---

# v342: main() call moved to final end after all late TAK Map patches are registered.

# --- TAK Map v341 route Mission UID publish + route naming + stronger Data Sync scroll ---
try:
    import re as _v341_re

    def _v341_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v341_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v341'", _html)
        _html = _v341_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v341', _html)
        _html = _v341_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v341', _html)
        _html = _v341_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v341\2', _html, flags=_v341_re.I)
        _html = _v341_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v341\2', _html, flags=_v341_re.I)
        _html = _v341_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v341\2', _html, flags=_v341_re.I)
        return _html

    def _v341_feature_is_route(f):
        try:
            if _local_data_feature_kind(f) == 'route' and len(_local_data_feature_points(f) or []) >= 2:
                return True
        except Exception:
            pass
        blob = (str((f or {}).get('kind') or '') + ' ' + str((f or {}).get('geometry') or '') + ' ' + str((f or {}).get('geometry_type') or '') + ' ' + str((f or {}).get('type') or '')).lower()
        return bool(any(x in blob for x in ('route','track','linestring','line string','path')) and len(_local_data_feature_points(f) or []) >= 2)

    def _v341_route_features(features, kind=''):
        feats=list(features or [])
        if not feats:
            return []
        k=str(kind or '').strip().lower()
        if k and k not in ('routes','route'):
            return []
        out=[]
        for f in feats:
            if _v341_feature_is_route(f):
                out.append(f)
        return out if len(out) == len(feats) else []

    def _v341_argb_from_feature(f, default='#ff6f2e'):
        try:
            props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
            raw=str((f or {}).get('color') or (f or {}).get('route_color') or props.get('color') or props.get('route_color') or default or '#ff6f2e').strip()
            if raw.startswith('#'):
                hx=raw[1:]
                if len(hx)==3:
                    hx=''.join(ch*2 for ch in hx)
                if len(hx)==6:
                    val=(0xff << 24) | int(hx,16)
                elif len(hx)==8:
                    val=int(hx,16)
                else:
                    val=0xffff6f2e
            else:
                try:
                    return str(int(float(raw)))
                except Exception:
                    val=0xffff6f2e
            if val >= 0x80000000:
                val -= 0x100000000
            return str(val)
        except Exception:
            return str(-37074)  # opaque #ff6f2e signed ARGB

    def _v341_route_style_from_feature(f):
        try:
            props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
            return str((f or {}).get('line_style') or (f or {}).get('lineStyle') or (f or {}).get('style') or props.get('line_style') or props.get('lineStyle') or props.get('style') or 'solid').strip().lower() or 'solid'
        except Exception:
            return 'solid'

    def _v341_route_weight_from_feature(f):
        try:
            props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
            w=_coerce_float((f or {}).get('weight') or (f or {}).get('strokeWeight') or props.get('weight') or props.get('strokeWeight') or props.get('line_width') or 3)
            if w is None:
                w=3
            return str(max(1.0, min(12.0, float(w))))
        except Exception:
            return '3.0'

    def _v341_route_cot_events_for_feature(f, route_idx=0, mission_name='', creator_uid=''):
        pts=_local_data_feature_points(f)
        if len(pts) < 2:
            return {'ok':False,'error':'Route needs at least two points.','events':[],'route_uid':''}
        package_uid='takmap-route-v341-' + hashlib.sha1((json.dumps(json_safe(f), sort_keys=True)[:4096] + str(route_idx)).encode('utf-8','ignore')).hexdigest()[:16]
        try:
            route_uid=_v331_feature_uid(f, route_idx, package_uid)
        except Exception:
            route_uid='TAKMAP-ROUTE-' + hashlib.sha1((str(uuid.uuid4())+str(time.time())).encode()).hexdigest()[:24]
        route_uid=str(route_uid or '').strip()[:150]
        if not route_uid:
            route_uid='TAKMAP-ROUTE-' + uuid.uuid4().hex[:20]
        name=_v331_name_from_feature(f, 'Route') if callable(globals().get('_v331_name_from_feature')) else 'Route'
        props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
        prefix=str(props.get('checkpoint_prefix') or props.get('prefix') or 'CP').strip() or 'CP'
        method=str(props.get('route_method') or props.get('method') or 'Driving').strip() or 'Driving'
        direction=str(props.get('route_direction') or props.get('direction') or 'Infil').strip() or 'Infil'
        route_type=str(props.get('route_type') or props.get('routetype') or 'Primary').strip() or 'Primary'
        order=str(props.get('checkpoint_order') or props.get('order') or 'Ascending Check Points').strip() or 'Ascending Check Points'
        color_argb=_v341_argb_from_feature(f)
        weight=_v341_route_weight_from_feature(f)
        style=_v341_route_style_from_feature(f)
        now=datetime.now(timezone.utc)
        stale=now + timedelta(days=3650)
        events=[]
        waypoint_uids=[]
        remarks=_v331_remarks_from_feature(f) if callable(globals().get('_v331_remarks_from_feature')) else ''
        # Send route checkpoints first.  They are linked as children of the route but only
        # the route UID is mission-associated in this first route test.
        for i,p in enumerate(pts):
            lat=float(p[0]); lon=float(p[1])
            wp_uid=(route_uid + '.' + prefix + str(i+1))[:155]
            waypoint_uids.append(wp_uid)
            event=ET.Element('event', {'version':'2.0','uid':wp_uid,'type':'b-m-p-c','how':'h-g-i-g-o','time':_cot_time(now),'start':_cot_time(now),'stale':_cot_time(stale)})
            ET.SubElement(event, 'point', {'lat':f'{lat:.7f}','lon':f'{lon:.7f}','hae':'0','ce':'9999999.0','le':'9999999.0'})
            detail=ET.SubElement(event, 'detail')
            ET.SubElement(detail, 'contact', {'callsign':f'{prefix}{i+1}'})
            ET.SubElement(detail, 'remarks').text=(remarks or f'{name} - Point {i+1}')[:1200]
            ET.SubElement(detail, 'link', {'uid':route_uid, 'type':'b-m-r', 'relation':'c'})
            ET.SubElement(detail, 'color', {'argb':color_argb})
            ET.SubElement(detail, 'takv', {'device':'TAK Map', 'platform':'TAK Map', 'version':'v341', 'os':'web'})
            events.append({'uid':wp_uid,'kind':'route-checkpoint','xml':'<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)})
        # Main TAK route object with embedded route point links.
        first=pts[0]
        event=ET.Element('event', {'version':'2.0','uid':route_uid,'type':'b-m-r','how':'h-g-i-g-o','time':_cot_time(now),'start':_cot_time(now),'stale':_cot_time(stale)})
        ET.SubElement(event, 'point', {'lat':f'{float(first[0]):.7f}','lon':f'{float(first[1]):.7f}','hae':'0','ce':'9999999.0','le':'9999999.0'})
        detail=ET.SubElement(event, 'detail')
        ET.SubElement(detail, 'contact', {'callsign':name})
        rmk='\n'.join([x for x in [remarks, f'Method: {method}', f'Direction: {direction}', f'Route Type: {route_type}', f'Order: {order}', f'Line Style: {style}', 'Created by TAK Map'] if x])[:3000]
        if rmk:
            ET.SubElement(detail, 'remarks').text=rmk
        # ATAK-compatible route styling and route metadata.
        ET.SubElement(detail, 'strokeColor', {'value':color_argb})
        ET.SubElement(detail, 'strokeWeight', {'value':weight})
        if style == 'dashed':
            ET.SubElement(detail, 'strokeStyle', {'value':'dashed'})
        routeinfo=ET.SubElement(detail, '__routeinfo', {'type':'Ground','method':method,'direction':direction,'routetype':route_type,'order':order,'prefix':prefix})
        # Some TAK builds also look for camel-case routeInfo.
        ET.SubElement(detail, 'routeInfo', {'type':'Ground','method':method,'direction':direction,'routeType':route_type,'order':order,'prefix':prefix})
        for i,(wp_uid,p) in enumerate(zip(waypoint_uids, pts)):
            ET.SubElement(detail, 'link', {'uid':wp_uid,'callsign':f'{prefix}{i+1}','type':'b-m-p-c','point':f'{float(p[0]):.7f},{float(p[1]):.7f},0.0','relation':'c'})
        if mission_name:
            ET.SubElement(detail, 'link', {'uid':str(mission_name), 'type':'b-f-t-r', 'relation':'p-m'})
        ET.SubElement(detail, 'archive')
        ET.SubElement(detail, 'labels_on', {'value':'true'})
        ET.SubElement(detail, 'takv', {'device':'TAK Map', 'platform':'TAK Map', 'version':'v341', 'os':'web'})
        events.append({'uid':route_uid,'kind':'route','xml':'<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)})
        return {'ok':True,'name':name,'route_uid':route_uid,'waypoint_uids':waypoint_uids,'events':events,'associate_uids':[route_uid],'point_count':len(pts),'color_argb':color_argb,'route_style':style}

    def tak_map_publish_route_uids_to_mission_v341(features, mission_name='', server_host='', preferred_creator_uid=''):
        mission=str(mission_name or '').strip() or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME','TAK Dashboard Mission').strip() or 'TAK Dashboard Mission'
        route_features=_v341_route_features(features, 'routes') or []
        if not route_features:
            return {'ok':False,'error':'No publishable Local Data route was selected.'}
        label='Local Routes' if len(route_features) != 1 else (_v331_name_from_feature(route_features[0], 'Route') if callable(globals().get('_v331_name_from_feature')) else 'Route')
        creators=_v337_candidate_creators(preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')) if callable(globals().get('_v337_candidate_creators')) else _v336_mission_api_candidate_creators(preferred_creator_uid or 'takmap')
        overall=[]; selected={}; diag_cot=[]
        for cand in creators:
            creator_uid=str(cand.get('uid') or '').strip()
            if not creator_uid:
                continue
            try:
                create=_v337_create_or_get_mission(mission, creator_uid, server_host) if callable(globals().get('_v337_create_or_get_mission')) else _ots_mission_api_request('/Marti/api/missions/'+quote(mission, safe='')+'?creatorUid='+quote(creator_uid, safe='')+'&tool=public&defaultRole=MISSION_SUBSCRIBER', method='PUT', body=b'', headers={'Content-Length':'0'}, public_host=server_host, timeout=20)
            except Exception as e:
                create={'ok':False,'error':str(e),'attempts':[]}
            token=''
            try:
                token=_extract_mission_token(create.get('json') or {})
            except Exception:
                token=''
            route_records=[]; route_uids=[]; all_sent=[]
            for idx,feature in enumerate(route_features):
                built=_v341_route_cot_events_for_feature(feature, idx, mission, creator_uid)
                rec={'index':idx,'name':built.get('name') or 'Route','ok':False,'route_uid':built.get('route_uid') or '', 'event_sends':[], 'point_count':built.get('point_count') or 0}
                if not built.get('ok'):
                    rec['error']=built.get('error') or 'Route CoT build failed.'
                    route_records.append(rec)
                    continue
                send_ok=True
                for ev in built.get('events') or []:
                    xml=ev.get('xml') or ''
                    diag_cot.append(xml)
                    try:
                        send=_send_cot_to_ots(xml) if callable(globals().get('_send_cot_to_ots')) else {'ok':False,'error':'CoT send helper unavailable.'}
                    except Exception as e:
                        send={'ok':False,'error':str(e)}
                    try:
                        db_lookup=_cot_db_lookup(ev.get('uid') or '', '', '', '', timeout=4) if callable(globals().get('_cot_db_lookup')) else {}
                    except Exception as e:
                        db_lookup={'ok':False,'error':str(e)}
                    rec['event_sends'].append({'uid':ev.get('uid') or '', 'kind':ev.get('kind') or '', 'ok':bool(send.get('ok')), 'cot_send':send, 'db_lookup':db_lookup})
                    if not send.get('ok'):
                        send_ok=False
                    else:
                        all_sent.append(ev.get('uid') or '')
                if send_ok and built.get('route_uid'):
                    route_uids.extend(built.get('associate_uids') or [built.get('route_uid')])
                    rec['ok']=True
                route_records.append(rec)
            assoc={'ok':False,'error':'No route CoT sends succeeded; mission UID association not attempted.','event_uids':route_uids}
            if route_uids:
                assoc=_v340_associate_uids_to_mission(mission, creator_uid, route_uids, token, server_host) if callable(globals().get('_v340_associate_uids_to_mission')) else {'ok':False,'error':'UID association helper unavailable','event_uids':route_uids}
            associated=int(assoc.get('associated_count') or (len(route_uids) if assoc.get('ok') else 0)) if isinstance(assoc, dict) else 0
            rec={'creator_uid':creator_uid,'source':cand.get('source'),'create_mission':create,'routes':route_records,'sent_event_uids':all_sent,'associate_uids':assoc,'expected_count':len(route_features),'associated_count':associated,'ok':bool(assoc.get('ok') and associated == len(route_uids) and len(route_uids)==len(route_features))}
            overall.append(rec)
            if rec.get('ok'):
                selected=rec
                break
        ok=bool(selected.get('ok'))
        last=selected or (overall[-1] if overall else {})
        out={'ok':ok,'mission':mission,'publish_mode':'mission-uid-spatial-route-v341','content_kind':'local-data-route-uids','content_label':label,'route_count':len(route_features),'associated_count':int(last.get('associated_count') or 0) if isinstance(last, dict) else 0,'creator_uid':last.get('creator_uid') or '' if isinstance(last, dict) else '','creator_attempts':overall,'create_mission':last.get('create_mission') or {} if isinstance(last, dict) else {},'routes':last.get('routes') or [] if isinstance(last, dict) else [],'associate_content':last.get('associate_uids') or {} if isinstance(last, dict) else {},'event_uids':last.get('sent_event_uids') or [] if isinstance(last, dict) else [],'zip_package_created':False,'zip_upload_skipped':True,'message':'','error':''}
        if ok:
            out['message']='Published to Data Sync Mission: ' + mission + '.' if len(route_features)==1 else 'Published ' + str(len(route_features)) + ' routes to Data Sync Mission: ' + mission + '.'
            out['user_message']=out['message']
            out['publish_succeeded']=True
            out['disable_publish_after_success']=True
            out['close_publish_modal_after_success']=True
            out['data_sync_refresh_recommended']=True
            out['non_package_publish']=True
        else:
            assoc=(last.get('associate_uids') or {}) if isinstance(last, dict) else {}
            parts=[]
            if assoc.get('error'):
                parts.append(str(assoc.get('error')))
            try:
                failed=[r.get('name') or ('route '+str(r.get('index'))) for r in (last.get('routes') or []) if not r.get('ok')]
                if failed:
                    parts.append('failed CoT send/build for ' + ', '.join(failed[:3]))
            except Exception:
                pass
            out['error']='Route Mission UID publish failed: ' + ('; '.join(parts) if parts else 'all route attempts failed')
        try:
            diag=_write_send_diag('mission-uid-route-publish', out, ('\n\n'.join(diag_cot) if diag_cot else None))
            if isinstance(diag, dict):
                out['diag_paths']=diag
        except Exception:
            pass
        return out

    _v341_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features=_selected_local_data_features(ids)
        if not features:
            return {'ok':False,'error':'No selected Local Data items were found.'}
        route_features=_v341_route_features(features, kind)
        if route_features:
            return tak_map_publish_route_uids_to_mission_v341(route_features, mission_name, server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        if callable(_v341_old_local_publish):
            return _v341_old_local_publish(ids, kind, mission_name, server_host)
        return {'ok':False,'error':'v341 local publish fallback unavailable for this Local Data selection.'}

    def _v341_patch_html(_html):
