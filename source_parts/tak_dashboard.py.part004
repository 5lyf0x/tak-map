    except Exception: pass
# --- end TAK Map v346 ATAK-native shape package/publish + shape center suppression ---


# --- TAK Map v347 shape center cleanup + colors + compact draw submenus + publish reset ---
try:
    import re as _v347_re

    def _v347_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v347_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v347'", _html)
        _html = _v347_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v347', _html)
        _html = _v347_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v347', _html)
        _html = _v347_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v347\2', _html, flags=_v347_re.I)
        _html = _v347_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v347\2', _html, flags=_v347_re.I)
        _html = _v347_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v347\2', _html, flags=_v347_re.I)
        _html = _html.replace('version="v346"', 'version="v347"').replace("version='v346'", "version='v347'")
        return _html

    def _v347_bool(v, default=True):
        try:
            if v is None or v == '': return default
            return str(v).strip().lower() not in ('0','false','no','off','none','null')
        except Exception:
            return default

    def _v347_hex_color(v, default='#ff6f2e'):
        try:
            s=str(v or '').strip()
            if not s:
                return default
            if s.startswith('#'):
                if len(s)==4 and all(c in '0123456789abcdefABCDEF' for c in s[1:]):
                    return '#' + ''.join(c*2 for c in s[1:]).lower()
                if len(s)>=7 and all(c in '0123456789abcdefABCDEF' for c in s[1:7]):
                    return '#' + s[1:7].lower()
            m=_v347_re.search(r'rgba?\s*\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})', s, _v347_re.I)
            if m:
                nums=[max(0,min(255,int(x))) for x in m.groups()]
                return '#%02x%02x%02x' % tuple(nums)
        except Exception:
            pass
        return default

    def _v347_shape_style(f):
        props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
        def first(*keys, default=''):
            for k in keys:
                try:
                    v=(f or {}).get(k)
                    if v not in (None,''):
                        return v
                except Exception:
                    pass
                try:
                    v=props.get(k)
                    if v not in (None,''):
                        return v
                except Exception:
                    pass
            return default
        stroke=_v347_hex_color(first('stroke_color','strokeColor','perimeter_color','perimeterColor','line_color','lineColor','color', default='#ff6f2e'), '#ff6f2e')
        fill_color=_v347_hex_color(first('fill_color','fillColor','fill_colour','fillColour','fill', default=stroke), stroke)
        try:
            weight=max(1.0,min(18.0,float(first('weight','line_weight','lineWeight','strokeWeight','stroke_width','strokeWidth','line_width','lineWidth', default=3) or 3)))
        except Exception:
            weight=3.0
        try:
            fill_op=max(0.0,min(1.0,float(first('fill_opacity','fillOpacity','opacity','fill_alpha','fillAlpha', default=.20) or .20)))
            if fill_op > 1.0:
                fill_op = max(0.0, min(1.0, fill_op/100.0))
        except Exception:
            fill_op=.20
        filled=_v347_bool(first('filled','is_filled','fill_enabled','fillEnabled','fill', default=True), True)
        try:
            fv=first('fill', default='')
            if isinstance(fv, str) and fv.strip().startswith('#'):
                filled=True
        except Exception:
            pass
        line_style=str(first('line_style','lineStyle','style','strokeStyle', default='solid') or 'solid').strip().lower() or 'solid'
        if line_style not in ('solid','dashed','dash','dotted'):
            line_style='solid'
        return {
            'color':stroke,
            'fill_color':fill_color,
            'weight':str(weight),
            'fill_opacity':fill_op,
            'fill':filled,
            'line_style':('dashed' if line_style in ('dashed','dash','dotted') else 'solid'),
            'stroke_argb':_v345_argb_from_color(stroke, '#ff6f2e', 255) if callable(globals().get('_v345_argb_from_color')) else str(-37074),
            'fill_argb':_v345_argb_from_color(fill_color, stroke, int(round((fill_op if filled else 0)*255))) if callable(globals().get('_v345_argb_from_color')) else str(1090518784),
        }

    _v345_shape_style = _v347_shape_style

    def _v347_row_text(row=None, xml=''):
        try:
            if callable(globals().get('_v343_row_xml_text')):
                return _v343_row_xml_text(row, xml)
        except Exception:
            pass
        parts=[]
        try:
            if isinstance(row, dict):
                for k in ('xml','event','detail','details','cot','body','raw','json','payload','uid','sender_uid','callsign','sender_callsign','type','cot_type','event_type','source','kind','geometry'):
                    v=row.get(k)
                    if v not in (None,''):
                        parts.append(str(v))
        except Exception:
            pass
        if xml:
            parts.append(str(xml))
        return ' '.join(parts)

    def _v347_is_shape_center(uid='', callsign='', cot_type='', xml='', row=None):
        try:
            txt=_v347_row_text(row, xml).lower()
            uid=str(uid or '').strip().lower()
            callsign=str(callsign or '').strip().lower()
            cot_type=str(cot_type or '').strip().lower()
            blob=' '.join([uid,callsign,cot_type,txt[:30000]])
            shape_type = cot_type in ('u-d-f','u-d-r','u-d-c','u-d-c-c','u-d-s') or any(('type="'+t+'"') in blob or ("type='"+t+"'") in blob for t in ('u-d-f','u-d-r','u-d-c','u-d-c-c','u-d-s'))
            shape_detail = any(x in blob for x in ('<__shapeextras','__shapeextras','<link point=','link point=', '<__shape', '<shape', '<takmap_shape', 'tak map drawing tools'))
            takmap_shape_uid = uid.startswith('takmap-local-') or uid.startswith('takmap-shape-') or uid.startswith('tak-shape-')
            named_shape = any(x in callsign for x in ('shape','polygon','rectangle','circle','ellipse','freehand','area'))
            if shape_type and (shape_detail or takmap_shape_uid or named_shape):
                return True
            if takmap_shape_uid and (shape_detail or named_shape):
                return True
        except Exception:
            pass
        return False

    _v347_old_normalize_tak_marker = globals().get('_normalize_tak_marker')
    if callable(_v347_old_normalize_tak_marker):
        def _normalize_tak_marker(row, source_table='cot', default_kind='cot'):
            try:
                parsed=_parse_cot_text_fields(row) if callable(globals().get('_parse_cot_text_fields')) else {}
                uid=str(_row_ci_get(row or {}, ('uid','sender_uid','cot_uid','clientuid','clientUid','client_uid','device_uid','id'), '') or parsed.get('uid') or '').strip()
                callsign=str(_row_ci_get(row or {}, ('callsign','sender_callsign','call_sign','name','title','username'), '') or parsed.get('callsign') or '').strip()
                typ=str(_row_ci_get(row or {}, ('type','cot_type','event_type','category'), '') or parsed.get('type') or '').strip()
                if _v347_is_shape_center(uid, callsign, typ, row=row):
                    return None
            except Exception:
                pass
            m=_v347_old_normalize_tak_marker(row, source_table, default_kind)
            try:
                if m and _v347_is_shape_center(m.get('uid') or m.get('id') or '', m.get('callsign') or m.get('name') or '', m.get('type') or m.get('cot_type') or '', row=row):
                    return None
            except Exception:
                pass
            return m

    _v347_old_is_real_eud_candidate = globals().get('_is_real_eud_candidate')
    if callable(_v347_old_is_real_eud_candidate):
        def _is_real_eud_candidate(e, xml=''):
            try:
                if _v347_is_shape_center((e or {}).get('uid') or '', (e or {}).get('callsign') or (e or {}).get('name') or '', (e or {}).get('type') or (e or {}).get('cot_type') or '', xml=xml):
                    return False
            except Exception:
                pass
            return _v347_old_is_real_eud_candidate(e, xml)

    _v347_old_tak_map_euds = globals().get('tak_map_euds')
    if callable(_v347_old_tak_map_euds):
        def tak_map_euds():
            data=_v347_old_tak_map_euds() or {'ok':True,'euds':[]}
            try:
                if isinstance(data, dict) and isinstance(data.get('euds'), list):
                    data['euds']=[e for e in data.get('euds') or [] if not _v347_is_shape_center((e or {}).get('uid') or '', (e or {}).get('callsign') or (e or {}).get('name') or '', (e or {}).get('type') or (e or {}).get('cot_type') or '')]
            except Exception:
                pass
            return data

