try:
    import re as _v346_re

    def _v346_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v346_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v346'", _html)
        _html = _v346_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v346', _html)
        _html = _v346_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v346', _html)
        _html = _v346_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v346\2', _html, flags=_v346_re.I)
        _html = _v346_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v346\2', _html, flags=_v346_re.I)
        _html = _v346_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v346\2', _html, flags=_v346_re.I)
        return _html

    def _v346_shape_type_for_feature(f):
        try:
            props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
            blob=' '.join(str(x or '') for x in [props.get('shape_type'), props.get('type'), (f or {}).get('shape_type'), (f or {}).get('geometry'), (f or {}).get('name')]).lower()
            if 'rect' in blob:
                return 'rectangle', 'u-d-r'
            # ATAK's exported freehand/polygon shape uses u-d-f with link point vertices.
            # Circles are exported by TAK Map as a locked 1:1 polygon ring, so keep u-d-f
            # until we capture a native ATAK circle package format.
            if 'circle' in blob:
                return 'circle', 'u-d-f'
            if 'ellipse' in blob:
                return 'ellipse', 'u-d-f'
        except Exception:
            pass
        return 'polygon', 'u-d-f'

    def _v346_clean_shape_ring(f):
        pts=_local_data_feature_points(f) or []
        ring=[]
        for pnt in pts:
            try:
                lat=float(pnt[0]); lon=float(pnt[1])
                if not (math.isfinite(lat) and math.isfinite(lon)):
                    continue
                if not ring or abs(ring[-1][0]-lat)>1e-10 or abs(ring[-1][1]-lon)>1e-10:
                    ring.append([lat,lon])
            except Exception:
                pass
        if len(ring) >= 3 and (abs(ring[0][0]-ring[-1][0])>1e-10 or abs(ring[0][1]-ring[-1][1])>1e-10):
            ring.append(list(ring[0]))
        return ring

    def _v346_center_for_ring(ring, f=None):
        try:
            lat=_coerce_float((f or {}).get('lat')) if callable(globals().get('_coerce_float')) else None
            lon=_coerce_float((f or {}).get('lon')) if callable(globals().get('_coerce_float')) else None
            if lat is not None and lon is not None and math.isfinite(float(lat)) and math.isfinite(float(lon)):
                return float(lat), float(lon)
        except Exception:
            pass
        pts=ring[:-1] if len(ring)>1 and abs(ring[0][0]-ring[-1][0])<1e-10 and abs(ring[0][1]-ring[-1][1])<1e-10 else ring
        if not pts:
            return 0.0, 0.0
        return sum(p[0] for p in pts)/len(pts), sum(p[1] for p in pts)/len(pts)

    def _v346_feature_uid(f, idx, package_uid):
        try:
            u=_v331_feature_uid(f, idx, package_uid) if callable(globals().get('_v331_feature_uid')) else ''
        except Exception:
            u=''
        u=str(u or '').strip()
        if u:
            return u[:150]
        return 'TAKMAP-LOCAL-' + hashlib.sha1((json.dumps(json_safe(f), sort_keys=True)[:4096]+str(idx)+str(package_uid)).encode('utf-8','ignore')).hexdigest()[:24]

    def _v346_shape_cot_event_for_feature(f, idx=0, package_uid='', creator_uid='', creator_callsign='takmap'):
        ring=_v346_clean_shape_ring(f)
        if len(ring) < 4:
            return {'ok':False,'error':'Shape needs at least three points.','events':[],'shape_uid':''}
        if not package_uid:
            package_uid='takmap-shape-v346-' + hashlib.sha1((json.dumps(json_safe(f), sort_keys=True)[:4096] + str(idx)).encode('utf-8','ignore')).hexdigest()[:16]
        shape_uid=_v346_feature_uid(f, idx, package_uid)
        name=_v331_name_from_feature(f, 'Shape') if callable(globals().get('_v331_name_from_feature')) else 'Shape'
        shape_type, cot_type=_v346_shape_type_for_feature(f)
        style=_v345_shape_style(f) if callable(globals().get('_v345_shape_style')) else {'stroke_argb':str(-37074),'fill_argb':str(1090518784),'weight':'3.0','line_style':'solid'}
        lat,lon=_v346_center_for_ring(ring, f)
        now=datetime.now(timezone.utc)
        stale=now + timedelta(days=1)
        event=ET.Element('event', {
            'version':'2.0',
            'uid':shape_uid,
            'type':cot_type,
            'time':_cot_time(now),
            'start':_cot_time(now),
            'stale':_cot_time(stale),
            'how':'h-e',
            'access':'Undefined'
        })
        ET.SubElement(event, 'point', {'lat':f'{float(lat):.7f}','lon':f'{float(lon):.7f}','hae':'0','ce':'9999999.0','le':'9999999.0'})
        detail=ET.SubElement(event, 'detail')
        # Native ATAK shape data packages store vertices as repeated <link point="lat,lon,hae"/>
        # under detail, not under __shape/polyline/vertex.  This is the critical v346 change.
        for p in ring:
            ET.SubElement(detail, 'link', {'point':f'{float(p[0]):.7f},{float(p[1]):.7f},0.0'})
        ET.SubElement(detail, '__shapeExtras', {'cpvis':'true','editable':'true'})
        ET.SubElement(detail, 'labels_on', {'value':'false'})
        ET.SubElement(detail, 'archive')
        ET.SubElement(detail, 'contact', {'callsign':name})
        ET.SubElement(detail, 'precisionlocation', {'altsrc':'TAK Map'})
        remarks=_v331_remarks_from_feature(f) if callable(globals().get('_v331_remarks_from_feature')) else ''
        ET.SubElement(detail, 'remarks').text=str(remarks or '')[:3000]
        ET.SubElement(detail, 'strokeColor', {'value':str(style.get('stroke_argb') or -37074)})
        ET.SubElement(detail, 'strokeWeight', {'value':str(style.get('weight') or '3.0')})
        ET.SubElement(detail, 'strokeStyle', {'value':'dashed' if str(style.get('line_style') or '').lower()=='dashed' else 'solid'})
        ET.SubElement(detail, 'fillColor', {'value':str(style.get('fill_argb') or 1090518784)})
        ET.SubElement(detail, 'color', {'value':str(style.get('stroke_argb') or -37074)})
        if creator_uid:
            ET.SubElement(detail, 'creator', {'uid':str(creator_uid), 'callsign':str(creator_callsign or 'takmap'), 'time':_cot_time(now), 'type':'a-f-G-U-C-R-V-G'})
        xml='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)
        return {'ok':True,'name':name,'shape_uid':shape_uid,'events':[{'uid':shape_uid,'kind':'shape','xml':xml}],'associate_uids':[shape_uid],'point_count':len(ring)-1,'shape_type':shape_type,'cot_type':cot_type,'style':style}

    def _v346_build_shape_tak_package(features, label, stamp, creator_uid='', creator_callsign='takmap'):
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
        feats=list(features or [])
        title=_v334_display_title_from_features(feats, 'Shape') if callable(globals().get('_v334_display_title_from_features')) else str(label or 'TAK Map Shape')
        try:
            title=_v334_clean_package_title(title, 'Shape') if callable(globals().get('_v334_clean_package_title')) else str(title).strip()
        except Exception:
            title=str(title or 'TAK Map Shape').strip()
        package_uid=str(uuid.uuid4())
        package_title=f'{title} - TAK Map - {stamp}'
        safe_title=_safe_filename_label(package_title, 'zip')[:-4]
        zip_name=f'{safe_title}.zip'
        zip_id=_safe_offline_id('tak-shape-dp-' + hashlib.sha256((package_uid+zip_name).encode()).hexdigest()[:16])
        zip_path=TAK_MAP_SEND_PACKAGE_DIR/(zip_id + '.zip')
        cot_entries=[]; xmls=[]
        for idx,f in enumerate(feats):
            built=_v346_shape_cot_event_for_feature(f, idx, package_uid, creator_uid, creator_callsign)
            if built.get('ok'):
                uid=built.get('shape_uid') or str(uuid.uuid4())
                file_uid=_v335_safe_zip_component(uid, 'shape-' + str(idx+1)) if callable(globals().get('_v335_safe_zip_component')) else re.sub(r'[^A-Za-z0-9_.-]+','_',uid)[:80]
                entry=f'{file_uid}/{file_uid}.cot'
                data=(built.get('events') or [{}])[0].get('xml','').encode('utf-8')
                cot_entries.append({'uid':uid,'entry':entry,'bytes':data,'name':built.get('name') or 'Shape','shape_type':built.get('shape_type'),'cot_type':built.get('cot_type')})
                xmls.append(data.decode('utf-8','ignore'))
        root=ET.Element('MissionPackageManifest', {'version':'2'})
        cfg=ET.SubElement(root, 'Configuration')
        ET.SubElement(cfg, 'Parameter', {'name':'uid', 'value':package_uid})
        ET.SubElement(cfg, 'Parameter', {'name':'name', 'value':package_title})
        contents=ET.SubElement(root, 'Contents')
        for ce in cot_entries:
            c=ET.SubElement(contents, 'Content', {'ignore':'false', 'zipEntry':ce['entry']})
            ET.SubElement(c, 'Parameter', {'name':'uid', 'value':ce['uid']})
        manifest_text='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
        with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
            def write_stable(name, data):
                info=zipfile.ZipInfo(name)
                info.date_time=(2024,1,1,0,0,0)
                info.compress_type=zipfile.ZIP_DEFLATED
                zf.writestr(info, data)
            write_stable('MANIFEST/manifest.xml', manifest_text.encode('utf-8'))
            for ce in cot_entries:
                write_stable(ce['entry'], ce['bytes'])
        return {'ok':bool(cot_entries),'path':str(zip_path),'package_name':zip_name,'package_display_name':package_title,'package_uid':package_uid,'sha256':hashlib.sha256(zip_path.read_bytes()).hexdigest() if zip_path.exists() else '','size_bytes':zip_path.stat().st_size if zip_path.exists() else 0,'feature_count':len(feats),'cot_count':len(cot_entries),'cot_entries':[{'uid':ce['uid'],'entry':ce['entry'],'name':ce['name'],'shape_type':ce.get('shape_type'),'cot_type':ce.get('cot_type')} for ce in cot_entries],'manifest_path':'MANIFEST/manifest.xml','package_mode':'v346-atak-native-shape-cot-package','validation':_v335_package_validation(zip_path) if callable(globals().get('_v335_package_validation')) else {},'xml_preview':'\n\n'.join(xmls)[:12000]}

    def _v346_is_takmap_shape_center(uid='', callsign='', cot_type='', xml='', row=None):
        try:
            uid=str(uid or '').strip().lower(); callsign=str(callsign or '').strip().lower(); cot_type=str(cot_type or '').strip().lower()
            txt=''
            try:
                txt=_v343_row_xml_text(row, xml).lower() if callable(globals().get('_v343_row_xml_text')) else str(xml or '').lower()
            except Exception:
                txt=str(xml or '').lower()
            blob=' '.join([uid,callsign,cot_type,txt[:10000]])
            if cot_type in ('u-d-f','u-d-r','u-d-c','u-d-c-c','u-d-s'):
                if uid.startswith('takmap-local-') or 'tak map drawing tools' in blob or 'takmap_shape' in blob or '<__shape' in blob or '<__shapeextras' in blob or '<link point=' in blob:
                    return True
            if uid.startswith('takmap-local-') and any(x in callsign for x in ('shape','polygon','rectangle','circle')):
                return True
        except Exception:
            pass
        return False

    _v346_old_normalize_tak_marker=globals().get('_normalize_tak_marker')
    if callable(_v346_old_normalize_tak_marker):
        def _normalize_tak_marker(row, source_table='cot', default_kind='cot'):
            try:
                parsed=_parse_cot_text_fields(row) if callable(globals().get('_parse_cot_text_fields')) else {}
                uid=str(_row_ci_get(row or {}, ('uid','cot_uid','clientuid','clientUid','client_uid','device_uid','id'), '') or parsed.get('uid') or '').strip()
                callsign=str(_row_ci_get(row or {}, ('callsign','call_sign','sender_callsign','name','title','username'), '') or parsed.get('callsign') or '').strip()
                typ=str(_row_ci_get(row or {}, ('type','cot_type','event_type','category'), '') or parsed.get('type') or '').strip()
                if _v346_is_takmap_shape_center(uid, callsign, typ, row=row):
                    return None
            except Exception:
                pass
            m=_v346_old_normalize_tak_marker(row, source_table, default_kind)
            try:
                if m and _v346_is_takmap_shape_center(m.get('uid') or m.get('id') or '', m.get('callsign') or m.get('name') or '', m.get('type') or m.get('cot_type') or '', row=row):
                    return None
            except Exception:
                pass
            return m

    _v346_old_is_real_eud_candidate=globals().get('_is_real_eud_candidate')
    if callable(_v346_old_is_real_eud_candidate):
        def _is_real_eud_candidate(e, xml=''):
            try:
                if _v346_is_takmap_shape_center((e or {}).get('uid') or '', (e or {}).get('callsign') or (e or {}).get('name') or '', (e or {}).get('type') or '', xml=xml):
                    return False
            except Exception:
                pass
            return _v346_old_is_real_eud_candidate(e, xml)

    _v346_old_tak_map_euds=globals().get('tak_map_euds')
    if callable(_v346_old_tak_map_euds):
        def tak_map_euds():
            data=_v346_old_tak_map_euds() or {'ok':True,'euds':[]}
            try:
                if isinstance(data, dict) and isinstance(data.get('euds'), list):
                    data['euds']=[e for e in data.get('euds') or [] if not _v346_is_takmap_shape_center((e or {}).get('uid') or '', (e or {}).get('callsign') or (e or {}).get('name') or '', (e or {}).get('type') or (e or {}).get('cot_type') or '')]
            except Exception:
                pass
            return data

    def tak_map_publish_shape_uids_to_mission_v346(features, mission_name='', server_host='', preferred_creator_uid=''):
        mission=str(mission_name or '').strip() or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME','TAK Dashboard Mission').strip() or 'TAK Dashboard Mission'
        shape_features=_v345_shape_features(features, 'shapes') if callable(globals().get('_v345_shape_features')) else []
        if not shape_features:
            return {'ok':False,'error':'No publishable Local Data shape was selected.'}
        label='Local Shapes' if len(shape_features)!=1 else (_v331_name_from_feature(shape_features[0], 'Shape') if callable(globals().get('_v331_name_from_feature')) else 'Shape')
        creators=_v337_candidate_creators(preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')) if callable(globals().get('_v337_candidate_creators')) else _v336_mission_api_candidate_creators(preferred_creator_uid or 'takmap')
        overall=[]; selected={}; diag_cot=[]; package={}; package_upload={}
        for cand in creators:
            creator_uid=str(cand.get('uid') or '').strip()
            if not creator_uid:
                continue
            creator_callsign=str(cand.get('callsign') or cand.get('username') or _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
            try:
                create=_v337_create_or_get_mission(mission, creator_uid, server_host) if callable(globals().get('_v337_create_or_get_mission')) else _ots_mission_api_request('/Marti/api/missions/'+quote(mission, safe='')+'?creatorUid='+quote(creator_uid, safe='')+'&tool=public&defaultRole=MISSION_SUBSCRIBER', method='PUT', body=b'', headers={'Content-Length':'0'}, public_host=server_host, timeout=20)
            except Exception as e:
                create={'ok':False,'error':str(e),'attempts':[]}
            try:
                token=_extract_mission_token(create.get('json') or {})
            except Exception:
                token=''
            records=[]; shape_uids=[]; sent=[]
            package_uid='takmap-shape-v346-' + hashlib.sha1((json.dumps(json_safe(shape_features), sort_keys=True)[:8192] + str(time.time())).encode('utf-8','ignore')).hexdigest()[:16]
            for idx,feature in enumerate(shape_features):
                built=_v346_shape_cot_event_for_feature(feature, idx, package_uid, creator_uid, creator_callsign)
                rec={'index':idx,'name':built.get('name') or 'Shape','ok':False,'shape_uid':built.get('shape_uid') or '', 'event_sends':[], 'point_count':built.get('point_count') or 0, 'shape_type':built.get('shape_type') or '', 'cot_type':built.get('cot_type') or ''}
                if not built.get('ok'):
                    rec['error']=built.get('error') or 'Shape CoT build failed.'; records.append(rec); continue
                send_ok=True
                for ev in built.get('events') or []:
                    xml=ev.get('xml') or ''; diag_cot.append(xml)
                    try:
                        send=_send_cot_to_ots(xml) if callable(globals().get('_send_cot_to_ots')) else {'ok':False,'error':'CoT send helper unavailable.'}
                    except Exception as e:
                        send={'ok':False,'error':str(e)}
                    try:
                        db_lookup=_cot_db_lookup(ev.get('uid') or '', '', '', '', timeout=4) if callable(globals().get('_cot_db_lookup')) else {}
                    except Exception as e:
                        db_lookup={'ok':False,'error':str(e)}
                    rec['event_sends'].append({'uid':ev.get('uid') or '', 'kind':ev.get('kind') or '', 'ok':bool(send.get('ok')), 'cot_send':send, 'db_lookup':db_lookup, 'format':'atak-native-link-point-shape'})
                    if send.get('ok'):
                        sent.append(ev.get('uid') or '')
                    else:
                        send_ok=False
                if send_ok and built.get('shape_uid'):
                    shape_uids.extend(built.get('associate_uids') or [built.get('shape_uid')]); rec['ok']=True
                records.append(rec)
            assoc={'ok':False,'error':'No shape CoT sends succeeded; mission UID association not attempted.','event_uids':shape_uids}
            if shape_uids:
                assoc=_v340_associate_uids_to_mission(mission, creator_uid, shape_uids, token, server_host) if callable(globals().get('_v340_associate_uids_to_mission')) else {'ok':False,'error':'UID association helper unavailable','event_uids':shape_uids}
            associated=int(assoc.get('associated_count') or (len(shape_uids) if assoc.get('ok') else 0)) if isinstance(assoc, dict) else 0
            rec={'creator_uid':creator_uid,'creator_callsign':creator_callsign,'source':cand.get('source'),'create_mission':create,'shapes':records,'sent_event_uids':sent,'associate_uids':assoc,'expected_count':len(shape_features),'associated_count':associated,'ok':bool(assoc.get('ok') and associated==len(shape_uids) and len(shape_uids)==len(shape_features))}
            overall.append(rec)
            if rec.get('ok'):
                selected=rec
                break
        ok=bool(selected.get('ok')); last=selected or (overall[-1] if overall else {})
        # Build and upload a native ATAK shape Data Package in every shape publish attempt.
        try:
            stamp=datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
            creator_uid=str(last.get('creator_uid') or preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap'))
            creator_callsign=str(last.get('creator_callsign') or creator_uid or 'takmap')
            package=_v346_build_shape_tak_package(shape_features, str(label)+' - TAK Map Shape', stamp, creator_uid, creator_callsign)
            if package.get('ok') and callable(globals().get('tak_map_upload_package_to_sync_storage_v338')):
                package_upload=tak_map_upload_package_to_sync_storage_v338(Path(package['path']), package.get('package_name') or 'TAK Map Shape.zip', package.get('sha256') or '', mission, package.get('package_display_name') or label, 'local-data-shape-v346-atak-native', server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        except Exception as e:
            package={'ok':False,'error':str(e)}; package_upload={'ok':False,'error':str(e)}
        upload_ok=bool(package_upload.get('ok'))
        final_ok=bool(ok or upload_ok)
        out={'ok':final_ok,'mission':mission,'publish_mode':'mission-uid-spatial-shape-v346-atak-native-link-points','content_kind':'local-data-shape-uids-and-atak-package','content_label':label,'shape_count':len(shape_features),'associated_count':int(last.get('associated_count') or 0) if isinstance(last, dict) else 0,'creator_uid':last.get('creator_uid') or '' if isinstance(last, dict) else '','creator_attempts':overall,'create_mission':last.get('create_mission') or {} if isinstance(last, dict) else {},'shapes':last.get('shapes') or [] if isinstance(last, dict) else [],'associate_content':last.get('associate_uids') or {} if isinstance(last, dict) else {},'event_uids':last.get('sent_event_uids') or [] if isinstance(last, dict) else [],'zip_package_created':bool(package.get('ok')),'shape_package':package,'shape_package_upload':package_upload,'zip_upload_skipped':False,'message':'','error':'','atak_native_reference':'DP-darktek-shapetest01.zip used repeated <link point="lat,lon,hae"/> plus __shapeExtras; v346 mirrors that format.'}
        if final_ok:
            msg_parts=[]
            if ok:
                msg_parts.append('published as ATAK-native shape CoT and associated to Data Sync Mission')
            if upload_ok:
                msg_parts.append('uploaded ATAK-native shape Data Package')
            out['message']='Shape ' + ' and '.join(msg_parts) + ': ' + mission + '.'
            out['user_message']=out['message']
            out['publish_succeeded']=True
            out['disable_publish_after_success']=True
            out['close_publish_modal_after_success']=True
            out['data_sync_refresh_recommended']=True
            out['non_package_publish']=bool(ok)
        else:
            parts=[]
            assoc=(last.get('associate_uids') or {}) if isinstance(last, dict) else {}
            if assoc.get('error'): parts.append(str(assoc.get('error')))
            if package_upload.get('error'): parts.append('package upload: '+str(package_upload.get('error')))
            out['error']='Shape publish failed: '+('; '.join(parts) if parts else 'CoT send/UID association and package upload failed')
        try:
            diag=_write_send_diag('mission-uid-shape-publish-v346', out, ('\n\n'.join(diag_cot) if diag_cot else None))
            if isinstance(diag, dict): out['diag_paths']=diag
        except Exception:
            pass
        return out

    _v346_old_local_publish=globals().get('tak_map_local_data_mission_publish')
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features=_selected_local_data_features(ids)
        if not features:
            return {'ok':False,'error':'No selected Local Data items were found.'}
        shape_features=_v345_shape_features(features, kind) if callable(globals().get('_v345_shape_features')) else []
        if shape_features:
            return tak_map_publish_shape_uids_to_mission_v346(shape_features, mission_name, server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        if callable(_v346_old_local_publish):
            return _v346_old_local_publish(ids, kind, mission_name, server_host)
        return {'ok':False,'error':'v346 local publish fallback unavailable for this Local Data selection.'}

    def _v346_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v346_versions(_html)
        runtime="""
<script id=\"v346ShapeCenterSuppressor\">
(function(){
  'use strict';
  const V='v346', d=document, w=window;
  function qa(s,r){try{return Array.from((r||d).querySelectorAll(s))}catch(_){return []}}
