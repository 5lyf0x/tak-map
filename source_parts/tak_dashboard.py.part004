    #drawOptionsPanel label{display:flex!important;flex-direction:column!important;gap:5px!important;min-width:0!important;font-size:.64rem!important;letter-spacing:.06em!important;text-transform:uppercase!important;color:#9fb0bd!important;}
    #drawOptionsPanel label.wide{grid-column:1 / -1!important;}
    #drawOptionsPanel input,#drawOptionsPanel select,#drawOptionsPanel textarea{box-sizing:border-box!important;width:100%!important;min-width:0!important;height:34px!important;padding:7px 9px!important;border-radius:9px!important;background:#071018!important;border:1px solid #2f4452!important;color:#edf5f7!important;font-size:.78rem!important;}
    #drawOptionsPanel input[type=color]{padding:4px!important;min-height:34px!important;}
    #drawOptionsPanel .tak-floating-actions,#drawOptionsPanel .draw-actions{display:flex!important;justify-content:flex-end!important;align-items:center!important;gap:9px!important;margin-top:12px!important;}
    #drawOptionsPanel button{width:auto!important;min-width:74px!important;height:34px!important;min-height:34px!important;padding:7px 11px!important;border-radius:10px!important;box-sizing:border-box!important;}
    #drawOptionsPanel .primary,#drawOptionsPanel button.primary{border-color:rgba(255,111,46,.55)!important;background:rgba(255,111,46,.18)!important;color:#ffd9c8!important;}
    #drawOptionsPanel .draw-status{grid-column:1 / -1!important;font-size:.68rem!important;color:#9fb0bd!important;min-height:1.1em!important;margin-top:2px!important;}
    #drawOptionsPanel.active,#drawOptionsPanel.open{display:block!important;}
    #drawSaveBackdrop{position:fixed!important;z-index:11300!important;background:rgba(0,0,0,.24)!important;display:none!important;align-items:center!important;justify-content:center!important;padding:12px!important;box-sizing:border-box!important;}
    #drawSaveBackdrop.active{display:flex!important;}
    #drawSaveBackdrop .draw-save-card{box-sizing:border-box!important;width:min(430px,calc(100vw - 30px))!important;max-height:min(620px,calc(100vh - 34px))!important;overflow:auto!important;border:1px solid rgba(255,255,255,.14)!important;border-radius:16px!important;background:linear-gradient(180deg,rgba(10,24,31,.98),rgba(5,12,17,.98))!important;box-shadow:0 20px 58px rgba(0,0,0,.62)!important;}
    #drawSaveBackdrop .draw-save-head{display:flex!important;justify-content:space-between!important;align-items:center!important;gap:8px!important;padding:11px 13px!important;border-bottom:1px solid rgba(255,255,255,.09)!important;}
    #drawSaveBackdrop .draw-save-head h2{margin:0!important;font-size:.95rem!important;letter-spacing:.06em!important;text-transform:uppercase!important;}
    #drawSaveBackdrop .draw-save-body{display:grid!important;grid-template-columns:1fr 1fr!important;gap:10px 12px!important;padding:12px 13px!important;}
    #drawSaveBackdrop .draw-save-body label{display:flex!important;flex-direction:column!important;gap:5px!important;min-width:0!important;font-size:.64rem!important;text-transform:uppercase!important;letter-spacing:.06em!important;color:#9fb0bd!important;}
    #drawSaveBackdrop .draw-save-body label.wide{grid-column:1 / -1!important;}
    #drawSaveBackdrop input,#drawSaveBackdrop select,#drawSaveBackdrop textarea{box-sizing:border-box!important;width:100%!important;min-width:0!important;background:#071018!important;border:1px solid #2f4452!important;border-radius:9px!important;color:#edf5f7!important;padding:7px 9px!important;font-size:.78rem!important;}
    #drawSaveBackdrop textarea{min-height:72px!important;resize:vertical!important;}
    #drawSaveBackdrop .draw-save-note{grid-column:1/-1!important;color:#9fb0bd!important;font-size:.68rem!important;}
    #drawSaveBackdrop .draw-save-actions{display:flex!important;justify-content:flex-end!important;gap:9px!important;padding:11px 13px 13px!important;border-top:1px solid rgba(255,255,255,.08)!important;}
    #drawSaveBackdrop button{min-width:76px!important;height:34px!important;border-radius:10px!important;}
    #drawSaveBackdrop .primary{border-color:rgba(255,111,46,.55)!important;background:rgba(255,111,46,.18)!important;color:#ffd9c8!important;}
    @media (max-width:620px){#drawOptionsPanel.tak-floating-panel,#drawOptionsPanel{width:calc(100vw - 28px)!important;min-width:0!important;}#drawSaveBackdrop .draw-save-body{grid-template-columns:1fr!important;}}
  `;const st=d.createElement('style');st.id='v344ShapeWorkflowStyle';st.textContent=css;d.head.appendChild(st)}catch(e){console.warn('v344 css failed',e)}}
  function visibleMapRect(){try{const mapEl=$('map')||d.querySelector('.map,.leaflet-container');const mr=mapEl?mapEl.getBoundingClientRect():{left:0,top:0,right:innerWidth,bottom:innerHeight,width:innerWidth,height:innerHeight};let left=mr.left,top=mr.top,right=mr.right,bottom=mr.bottom;d.querySelectorAll('#sidebar,#leftPanel,#leftMenu,.sidebar,.left-panel,.left-menu,.panel-stack').forEach(function(el){try{const cs=getComputedStyle(el);if(cs.display==='none'||cs.visibility==='hidden')return;const r=el.getBoundingClientRect();if(r.width>80&&r.left<innerWidth*0.65&&r.right>left&&r.right<right)left=Math.max(left,r.right)}catch(_){}});left=Math.max(0,Math.min(left,innerWidth-40));top=Math.max(0,Math.min(top,innerHeight-40));return {left:left,top:top,right:Math.max(left+40,right),bottom:Math.max(top+40,bottom)}}catch(_){return {left:0,top:0,right:innerWidth,bottom:innerHeight}}}
