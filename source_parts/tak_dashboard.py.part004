  function filterCotJson(j){try{if(Array.isArray(j))return j.filter(function(x){return !isShapeCenter(x)});if(j&&typeof j==='object'){['markers','objects','items','cot','events','euds'].forEach(function(k){if(Array.isArray(j[k]))j[k]=j[k].filter(function(x){return !isShapeCenter(x)})})}return j}catch(_){return j}}
  function patchFetch(){try{if(w.__v346ShapeCenterFetchFilter)return;w.__v346ShapeCenterFetchFilter=true;const old=w.fetch;w.fetch=function(input,init){const url=String((input&&input.url)||input||'');const p=old.apply(this,arguments);if(url.indexOf('/api/tak-map/cot')<0&&url.indexOf('/api/tak-map/euds')<0)return p;return p.then(function(resp){try{const clone=resp.clone();return clone.json().then(function(j){return new Response(JSON.stringify(filterCotJson(j)),{status:resp.status,statusText:resp.statusText,headers:resp.headers})}).catch(function(){return resp})}catch(_){return resp}})}}catch(e){try{console.warn('v346 shape center fetch filter failed',e)}catch(_){}}}
  function patchDrawers(){try{['drawCotMarkers','drawTakObjects','renderCotMarkers','drawEuds','renderEuds'].forEach(function(name){try{const old=w[name];if(old&&!old.__v346ShapeCenterFilter){const fn=function(list){try{if(Array.isArray(list))arguments[0]=list.filter(function(x){return !isShapeCenter(x)})}catch(_){}return old.apply(this,arguments)};fn.__v346ShapeCenterFilter=true;w[name]=fn;try{eval(name+'=window[name]')}catch(_){}}}catch(_){}})}catch(e){try{console.warn('v346 shape drawer filter failed',e)}catch(_){}}}
  function boot(){setVersion();patchFetch();patchDrawers();}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,140)},{once:true});else setTimeout(boot,140);
  [500,1200,2400,5000,9000].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
"""
        if 'id="v346ShapeCenterSuppressor"' not in _html and "id='v346ShapeCenterSuppressor'" not in _html:
            _html=_html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v346_versions(_html)

    TAK_MAP_HTML=_v346_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v346_versions(TAK_MAP_LOGIN_HTML)
