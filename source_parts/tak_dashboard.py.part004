  function dsRoot(){return $('dataSyncRows')||$('dataSyncPanel')||d.querySelector('#dataSyncRows,[id*="dataSync" i],[id*="datasync" i]')}
  function dsScrollables(root){const out=[];function add(el){try{if(el&&out.indexOf(el)<0&&el.scrollHeight>el.clientHeight+2)out.push(el)}catch(_){}}try{root=root||dsRoot();add(root);if(root)root.querySelectorAll('.datasync-section-list,.sync-list,.layer-list,.object-list,.collapse-body,[data-sync-section],[id*="dataSync" i],[id*="datasync" i]').forEach(add)}catch(_){}return out}
  let dsSnap=null;
  function dsCapture(){try{const root=dsRoot();dsSnap={when:Date.now(),items:dsScrollables(root).map(function(el,i){return {el:el,id:el.id||'',i:i,top:el.scrollTop,left:el.scrollLeft}})};return dsSnap}catch(_){return null}}
  function dsRestore(ss){try{ss=ss||dsSnap;if(!ss)return;(ss.items||[]).forEach(function(s){let el=s.el;if(!(el&&d.contains(el))&&s.id)el=$(s.id);if(!(el&&d.contains(el)))el=dsScrollables()[s.i];if(el){el.scrollTop=s.top||0;el.scrollLeft=s.left||0}})}catch(_){}}
  function dsSchedule(ss){[0,16,40,90,180,360,720,1200,2000,3500].forEach(function(ms){setTimeout(function(){dsRestore(ss)},ms)})}
