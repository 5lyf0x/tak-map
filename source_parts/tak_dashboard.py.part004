# --- TAK Map v345 shape publish + circle lock + shape dialog cleanup + Data Sync selection scroll ---
try:
    import re as _v345_re

    def _v345_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v345_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v345'", _html)
        _html=_v345_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v345', _html)
        _html=_v345_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v345', _html)
        _html=_v345_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v345\2', _html, flags=_v345_re.I)
        _html=_v345_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v345\2', _html, flags=_v345_re.I)
        _html=_v345_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v345\2', _html, flags=_v345_re.I)
        _html=_html.replace('version":"v344"','version":"v345"').replace("version':'v344'","version':'v345'")
        return _html

    def _v345_shape_blob(f):
        try:
            props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
            return ' '.join(str(x or '') for x in [(f or {}).get('kind'),(f or {}).get('geometry'),(f or {}).get('geometry_type'),(f or {}).get('type'),props.get('kind'),props.get('shape_type'),props.get('geometry'),props.get('type'),props.get('created_by')]).lower()
        except Exception:
            return ''

    def _v345_feature_is_shape(f):
        try: pts=_local_data_feature_points(f) or []
        except Exception: pts=[]
        if len(pts) < 3: return False
        try:
            if _local_data_feature_kind(f) == 'shape': return True
        except Exception: pass
        blob=_v345_shape_blob(f)
        return bool(any(x in blob for x in ('shape','polygon','area','rectangle','square','circle','ellipse','freehand')))

    def _v345_shape_features(features, kind=''):
        feats=list(features or [])
        if not feats: return []
        out=[f for f in feats if _v345_feature_is_shape(f)]
        return out if len(out)==len(feats) else []

    def _v345_argb_from_color(raw, default='#ff6f2e', alpha=255):
        try:
            raw=str(raw or default or '#ff6f2e').strip()
            if raw.startswith('#'):
                hx=raw[1:]
                if len(hx)==3: hx=''.join(ch*2 for ch in hx)
                if len(hx)==6: val=((int(alpha)&255)<<24) | int(hx,16)
                elif len(hx)==8: val=int(hx,16)
                else: val=0xffff6f2e
            else:
                return str(int(float(raw)))
            if val >= 0x80000000: val -= 0x100000000
            return str(val)
        except Exception:
            return str(-37074)

    def _v345_shape_style(f):
        props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
        def first(*keys, default=''):
            for k in keys:
                try:
                    v=(f or {}).get(k)
                    if v not in (None,''): return v
                except Exception: pass
                try:
                    v=props.get(k)
                    if v not in (None,''): return v
                except Exception: pass
            return default
        color=str(first('color','stroke_color','strokeColor','line_color', default='#ff6f2e') or '#ff6f2e')
        fill_color=str(first('fill_color','fillColor', default=color) or color)
        try: weight=max(1.0,min(18.0,float(first('weight','line_weight','strokeWeight','line_width', default=3) or 3)))
        except Exception: weight=3.0
        try: fill_op=max(0.0,min(1.0,float(first('fill_opacity','fillOpacity','opacity', default=.20) or .20)))
        except Exception: fill_op=.20
        fill_val=first('fill','filled', default=True)
        fill = not (str(fill_val).lower() in ('0','false','no','off','none'))
        line_style=str(first('line_style','lineStyle','style', default='solid') or 'solid').lower()
        return {'color':color,'fill_color':fill_color,'weight':str(weight),'fill_opacity':fill_op,'fill':fill,'line_style':line_style,'stroke_argb':_v345_argb_from_color(color, '#ff6f2e', 255),'fill_argb':_v345_argb_from_color(fill_color, color, int(round((fill_op if fill else 0)*255)))}

    def _v345_shape_cot_event_for_feature(f, idx=0, mission_name='', creator_uid=''):
        pts=_local_data_feature_points(f) or []
        if len(pts) < 3: return {'ok':False,'error':'Shape needs at least three points.','events':[],'shape_uid':''}
        ring=[]
        for pnt in pts:
            if not ring or abs(ring[-1][0]-pnt[0])>1e-10 or abs(ring[-1][1]-pnt[1])>1e-10:
                ring.append([float(pnt[0]), float(pnt[1])])
        if len(ring) < 3: return {'ok':False,'error':'Shape needs at least three unique points.','events':[],'shape_uid':''}
        if abs(ring[0][0]-ring[-1][0])>1e-10 or abs(ring[0][1]-ring[-1][1])>1e-10: ring.append(list(ring[0]))
        package_uid='takmap-shape-v345-' + hashlib.sha1((json.dumps(json_safe(f), sort_keys=True)[:4096] + str(idx)).encode('utf-8','ignore')).hexdigest()[:16]
        try: shape_uid=_v331_feature_uid(f, idx, package_uid)
        except Exception: shape_uid='TAKMAP-SHAPE-' + hashlib.sha1((str(uuid.uuid4())+str(time.time())).encode()).hexdigest()[:24]
        shape_uid=str(shape_uid or '').strip()[:150] or ('TAKMAP-SHAPE-' + uuid.uuid4().hex[:20])
        name=_v331_name_from_feature(f, 'Shape') if callable(globals().get('_v331_name_from_feature')) else 'Shape'
        props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
        shape_type=str(props.get('shape_type') or props.get('type') or (f or {}).get('shape_type') or 'polygon').strip().lower() or 'polygon'
        style=_v345_shape_style(f)
        lat=sum(p[0] for p in ring[:-1])/max(1,len(ring)-1); lon=sum(p[1] for p in ring[:-1])/max(1,len(ring)-1)
        now=datetime.now(timezone.utc); stale=now + timedelta(days=3650)
        remarks=_v331_remarks_from_feature(f) if callable(globals().get('_v331_remarks_from_feature')) else ''
        event=ET.Element('event', {'version':'2.0','uid':shape_uid,'type':'u-d-f','how':'h-g-i-g-o','time':_cot_time(now),'start':_cot_time(now),'stale':_cot_time(stale)})
        ET.SubElement(event, 'point', {'lat':f'{float(lat):.7f}','lon':f'{float(lon):.7f}','hae':'0','ce':'9999999.0','le':'9999999.0'})
        detail=ET.SubElement(event, 'detail')
        ET.SubElement(detail, 'contact', {'callsign':name})
        if remarks: ET.SubElement(detail, 'remarks').text=remarks[:3000]
        ET.SubElement(detail, 'strokeColor', {'value':style['stroke_argb']}); ET.SubElement(detail, 'strokeWeight', {'value':style['weight']}); ET.SubElement(detail, 'fillColor', {'value':style['fill_argb']})
        if style['line_style']=='dashed': ET.SubElement(detail, 'strokeStyle', {'value':'dashed'})
        for tag in ('__shape','shape'):
            sh=ET.SubElement(detail, tag, {'type':shape_type, 'closed':'true'}); poly=ET.SubElement(sh, 'polyline', {'closed':'true'})
            for p in ring: ET.SubElement(poly, 'vertex', {'lat':f'{float(p[0]):.7f}','lon':f'{float(p[1]):.7f}','hae':'0'})
        gj={'type':'Feature','geometry':{'type':'Polygon','coordinates':[[[float(p[1]),float(p[0])] for p in ring]]},'properties':{'name':name,'kind':'shape','shape_type':shape_type,'source':'TAK Map'}}
        ET.SubElement(detail, 'takmap_shape', {'type':shape_type,'format':'geojson'}).text=json.dumps(gj,separators=(',',':'))[:12000]
        if mission_name: ET.SubElement(detail, 'link', {'uid':str(mission_name), 'type':'b-f-t-r', 'relation':'p-m'})
        ET.SubElement(detail, 'archive'); ET.SubElement(detail, 'labels_on', {'value':'true'}); ET.SubElement(detail, 'precisionlocation', {'geopointsrc':'TAK Map', 'altsrc':'TAK Map'}); ET.SubElement(detail, 'takv', {'device':'TAK Map', 'platform':'TAK Map', 'version':'v345', 'os':'web'})
        xml='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)
        return {'ok':True,'name':name,'shape_uid':shape_uid,'events':[{'uid':shape_uid,'kind':'shape','xml':xml}],'associate_uids':[shape_uid],'point_count':len(ring)-1,'shape_type':shape_type,'style':style}

    def tak_map_publish_shape_uids_to_mission_v345(features, mission_name='', server_host='', preferred_creator_uid=''):
        mission=str(mission_name or '').strip() or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME','TAK Dashboard Mission').strip() or 'TAK Dashboard Mission'
        shape_features=_v345_shape_features(features, 'shapes') or []
        if not shape_features: return {'ok':False,'error':'No publishable Local Data shape was selected.'}
        label='Local Shapes' if len(shape_features)!=1 else (_v331_name_from_feature(shape_features[0], 'Shape') if callable(globals().get('_v331_name_from_feature')) else 'Shape')
        creators=_v337_candidate_creators(preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')) if callable(globals().get('_v337_candidate_creators')) else _v336_mission_api_candidate_creators(preferred_creator_uid or 'takmap')
        overall=[]; selected={}; diag_cot=[]
        for cand in creators:
            creator_uid=str(cand.get('uid') or '').strip()
            if not creator_uid: continue
            try: create=_v337_create_or_get_mission(mission, creator_uid, server_host) if callable(globals().get('_v337_create_or_get_mission')) else _ots_mission_api_request('/Marti/api/missions/'+quote(mission, safe='')+'?creatorUid='+quote(creator_uid, safe='')+'&tool=public&defaultRole=MISSION_SUBSCRIBER', method='PUT', body=b'', headers={'Content-Length':'0'}, public_host=server_host, timeout=20)
            except Exception as e: create={'ok':False,'error':str(e),'attempts':[]}
            try: token=_extract_mission_token(create.get('json') or {})
            except Exception: token=''
            records=[]; shape_uids=[]; sent=[]
            for idx,feature in enumerate(shape_features):
                built=_v345_shape_cot_event_for_feature(feature, idx, mission, creator_uid)
                rec={'index':idx,'name':built.get('name') or 'Shape','ok':False,'shape_uid':built.get('shape_uid') or '', 'event_sends':[], 'point_count':built.get('point_count') or 0, 'shape_type':built.get('shape_type') or ''}
                if not built.get('ok'):
                    rec['error']=built.get('error') or 'Shape CoT build failed.'; records.append(rec); continue
                send_ok=True
                for ev in built.get('events') or []:
                    xml=ev.get('xml') or ''; diag_cot.append(xml)
                    try: send=_send_cot_to_ots(xml) if callable(globals().get('_send_cot_to_ots')) else {'ok':False,'error':'CoT send helper unavailable.'}
                    except Exception as e: send={'ok':False,'error':str(e)}
                    try: db_lookup=_cot_db_lookup(ev.get('uid') or '', '', '', '', timeout=4) if callable(globals().get('_cot_db_lookup')) else {}
                    except Exception as e: db_lookup={'ok':False,'error':str(e)}
                    rec['event_sends'].append({'uid':ev.get('uid') or '', 'kind':ev.get('kind') or '', 'ok':bool(send.get('ok')), 'cot_send':send, 'db_lookup':db_lookup})
                    if send.get('ok'): sent.append(ev.get('uid') or '')
                    else: send_ok=False
                if send_ok and built.get('shape_uid'):
                    shape_uids.extend(built.get('associate_uids') or [built.get('shape_uid')]); rec['ok']=True
                records.append(rec)
            assoc={'ok':False,'error':'No shape CoT sends succeeded; mission UID association not attempted.','event_uids':shape_uids}
            if shape_uids: assoc=_v340_associate_uids_to_mission(mission, creator_uid, shape_uids, token, server_host) if callable(globals().get('_v340_associate_uids_to_mission')) else {'ok':False,'error':'UID association helper unavailable','event_uids':shape_uids}
            associated=int(assoc.get('associated_count') or (len(shape_uids) if assoc.get('ok') else 0)) if isinstance(assoc, dict) else 0
            rec={'creator_uid':creator_uid,'source':cand.get('source'),'create_mission':create,'shapes':records,'sent_event_uids':sent,'associate_uids':assoc,'expected_count':len(shape_features),'associated_count':associated,'ok':bool(assoc.get('ok') and associated==len(shape_uids) and len(shape_uids)==len(shape_features))}
            overall.append(rec)
            if rec.get('ok'): selected=rec; break
        ok=bool(selected.get('ok')); last=selected or (overall[-1] if overall else {})
        out={'ok':ok,'mission':mission,'publish_mode':'mission-uid-spatial-shape-v345','content_kind':'local-data-shape-uids','content_label':label,'shape_count':len(shape_features),'associated_count':int(last.get('associated_count') or 0) if isinstance(last, dict) else 0,'creator_uid':last.get('creator_uid') or '' if isinstance(last, dict) else '','creator_attempts':overall,'create_mission':last.get('create_mission') or {} if isinstance(last, dict) else {},'shapes':last.get('shapes') or [] if isinstance(last, dict) else [],'associate_content':last.get('associate_uids') or {} if isinstance(last, dict) else {},'event_uids':last.get('sent_event_uids') or [] if isinstance(last, dict) else [],'zip_package_created':False,'zip_upload_skipped':True,'message':'','error':''}
        if ok:
            out.update({'message':('Published to Data Sync Mission: '+mission+'.' if len(shape_features)==1 else 'Published '+str(len(shape_features))+' shapes to Data Sync Mission: '+mission+'.'),'publish_succeeded':True,'disable_publish_after_success':True,'close_publish_modal_after_success':True,'data_sync_refresh_recommended':True,'non_package_publish':True})
            out['user_message']=out['message']
        else:
            assoc=(last.get('associate_uids') or {}) if isinstance(last, dict) else {}; parts=[]
            if assoc.get('error'): parts.append(str(assoc.get('error')))
            try:
                failed=[r.get('name') or ('shape '+str(r.get('index'))) for r in (last.get('shapes') or []) if not r.get('ok')]
                if failed: parts.append('failed CoT send/build for '+', '.join(failed[:3]))
            except Exception: pass
            out['error']='Shape Mission UID publish failed: '+('; '.join(parts) if parts else 'all shape attempts failed')
            try:
                stamp=datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
                pkg=(_v335_build_local_data_tak_package(shape_features, str(label)+' - TAK Map Shape Fallback', stamp) if callable(globals().get('_v335_build_local_data_tak_package')) else None)
                if pkg and pkg.get('ok') and callable(globals().get('tak_map_upload_package_to_sync_storage_v338')):
                    upload=tak_map_upload_package_to_sync_storage_v338(Path(pkg['path']), pkg.get('package_name') or 'TAK Map Shape.zip', pkg.get('sha256') or '', mission, pkg.get('package_display_name') or label, 'local-data-shape-fallback', server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
                    out['fallback_data_package_upload']=upload; out['fallback_package']=pkg
            except Exception as e: out['fallback_data_package_error']=str(e)
        try:
            diag=_write_send_diag('mission-uid-shape-publish', out, ('\n\n'.join(diag_cot) if diag_cot else None))
            if isinstance(diag, dict): out['diag_paths']=diag
        except Exception: pass
        return out

    _v345_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features=_selected_local_data_features(ids)
        if not features: return {'ok':False,'error':'No selected Local Data items were found.'}
        shape_features=_v345_shape_features(features, kind)
        if shape_features:
            return tak_map_publish_shape_uids_to_mission_v345(shape_features, mission_name, server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        if callable(_v345_old_local_publish): return _v345_old_local_publish(ids, kind, mission_name, server_host)
        return {'ok':False,'error':'v345 local publish fallback unavailable for this Local Data selection.'}

