# --- TAK Map v327 TAK Client private key help ---
try:
    import re as _v327_re

    def _v327_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v327_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v327'", _html)
        _html = _v327_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v327', _html)
        _html = _v327_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v327', _html)
        _html = _v327_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v327\2', _html, flags=_v327_re.I)
        _html = _v327_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v327\2', _html, flags=_v327_re.I)
        _html = _v327_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v327\2', _html, flags=_v327_re.I)
