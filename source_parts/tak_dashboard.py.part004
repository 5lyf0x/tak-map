try:
    import re as _v352_re

    def _v352_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v352_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v352'", _html)
        _html = _v352_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v352', _html)
        _html = _v352_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v352', _html)
        _html = _v352_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v352\2', _html, flags=_v352_re.I)
        _html = _v352_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v352\2', _html, flags=_v352_re.I)
        _html = _v352_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v352\2', _html, flags=_v352_re.I)
        _html = _v352_re.sub(r'version=(["\'])v\d+\1', lambda m: 'version=' + m.group(1) + 'v352' + m.group(1), _html)
        return _html

    def _v352_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html = _html.replace(
            "function normalizeLocalElevationDialog(){\n    try{\n      setVersion();",
            "function normalizeLocalElevationDialog(){\n    try{\n      setVersion();\n      if(w.__takLocalElevImportActive){return true;}"
        )
        _html = _html.replace(
            "const schedule=function(){if(pending)return;pending=true;setTimeout(function(){pending=false;normalizeLocalElevationDialog()},0)};",
