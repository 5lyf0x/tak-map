  function fixPopupEdit(root){try{qa('details.popup-edit,.tak-v322-edit,.tak-v321-edit,.tak-v320-edit',root||d).forEach(function(el){el.style.background='transparent';el.style.border='0';el.style.boxShadow='none';el.style.padding='0';el.style.width='auto';el.style.maxWidth='max-content';});qa('details.popup-edit>summary,.tak-v322-edit>summary,.tak-v321-edit>summary,.tak-v320-edit>summary,summary.popup-edit-summary',root||d).forEach(function(el){el.style.width='auto';el.style.maxWidth='max-content';el.style.display='inline-flex';});}catch(_){}}
