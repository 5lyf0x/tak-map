  async function importGeoTiffFileV353(file,base,span){try{return await importGeoTiffFileWorker(file,base,span)}catch(e){console.warn('v353 GeoTIFF worker import failed; falling back to main-thread importer',e);if(baseGeo){setStageProgress(5,10,'Worker unavailable; falling back to main-thread GeoTIFF import: '+file.name,base,span);const old=w._takLocalElevSetProgress;try{w._takLocalElevSetProgress=function(pct,label,active){setProgress((Number(base)||0)+(Number(span)||100)*(Math.max(0,Math.min(100,Number(pct)||0))/100),esc(label||'Importing GeoTIFF'),active)}}catch(_){}try{return await baseGeo(file)}finally{w._takLocalElevSetProgress=old}}throw e}}
