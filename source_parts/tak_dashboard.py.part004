        _dropdown = """function openAdsbDropdown(ev){try{const box=byId('statusDropdown');if(!box)return;const rows=ADSB.lastList.slice().sort(function(a,b){return titleOf(a).localeCompare(titleOf(b))});box.innerHTML='<div class="status-dropdown-title">ADS-B Aircraft</div><div class="status-adsb-head v319"><b>Aircraft</b><b>Class</b><b>Type</b><b>Alt</b><b>mi→Center</b></div>'+rows.map(function(a){const id=esc(idOf(a));const st=stableState(a);return '<button type="button" class="status-adsb-row v319" data-adsb-focus="'+id+'"><span>'+esc(titleOf(a,id))+'</span><span>'+esc(classLabel(st.classKey))+'</span><span>'+esc(st.shape==='helo'?'Heli':'Fixed')+'</span><span>'+esc(altText(a))+'</span><span>'+esc(rangeText(a))+'</span></button>'}).join('');box.classList.add('active');box.style.display='block';box.style.visibility='visible';const anchor=(ev&&ev.target&&ev.target.closest&&ev.target.closest('#bannerAdsbItem'))||byId('bannerAdsbItem')||null;if(anchor&&anchor.getBoundingClientRect){const r=anchor.getBoundingClientRect();const w=Math.min(560,Math.max(360,box.offsetWidth||360),(window.innerWidth||900)-16);box.style.minWidth=Math.min(500,w)+'px';box.style.maxWidth=w+'px';box.style.left=Math.max(8,Math.min((window.innerWidth||900)-w-8,r.left))+'px';box.style.top=Math.max(54,r.bottom+8)+'px'}box.dataset.v319AdsbOpen='1';box.dataset.v318AdsbOpen='1'}catch(e){console.warn('v319 ADS-B dropdown open failed',e)}}"""
        _focus_viewshed = """function focusAircraft(id){try{id=decodeURIComponent(String(id||'')).toLowerCase();const a=ADSB.data.get(id);const mk=ADSB.markers.get(id);const m=mapObj();if(a&&m)m.setView([a.lat,a.lon],Math.max(m.getZoom(),13),{animate:true});if(mk)setTimeout(function(){try{mk.openPopup();syncButtons()}catch(_){}},150)}catch(_){} }
  function openViewshed(ev){try{if(ev){ev.preventDefault();ev.stopPropagation();try{ev.stopImmediatePropagation()}catch(_){}} if(typeof window.toggleViewshedModule==='function'){try{window.toggleViewshedModule(true)}catch(_){}}let panel=byId('viewshedModule')||byId('viewshedPanel')||q('.viewshed-module,.viewshed-panel,#viewshedControl,.viewshed-control');if(!panel){const candidates=qa('div,section,aside').filter(function(el){return /viewshed/i.test(String(el.id+' '+el.className+' '+(el.getAttribute('aria-label')||'')))});panel=candidates[0]||null}if(panel){panel.style.display='block';panel.style.visibility='visible';panel.style.opacity='1';panel.classList.add('active','open');panel.classList.remove('collapsed','minimized','hidden');const bar=byId('floatingToolbar')||q('.floating-toolbar');const bw=panel.offsetWidth||360,bh=panel.offsetHeight||420;let left=(window.innerWidth-bw-18),top=90;if(bar){const r=bar.getBoundingClientRect();left=r.left-bw-12;top=Math.max(72,r.top)}left=Math.max(8,Math.min(left,window.innerWidth-bw-8));top=Math.max(64,Math.min(top,window.innerHeight-bh-8));panel.style.position='fixed';panel.style.left=left+'px';panel.style.top=top+'px';panel.style.right='auto';panel.style.bottom='auto';panel.style.zIndex='4200'}}catch(e){console.warn('v319 Viewshed open failed',e)}}"""
