  function currentLocalIds(){const out={points:new Set(),routes:new Set(),shapes:new Set(),all:new Set()};try{if(typeof window.localDataSets==='function'){const sets=window.localDataSets()||{};['points','routes','shapes'].forEach(function(k){(sets[k]||[]).forEach(function(it){const id=String((it&&it.id)||'');if(id){out[k].add(id);out.all.add(id)}})})}}catch(_){}return out}
  function pruneLocalSelection(){try{if(!window.state||!state.local)return;const ids=currentLocalIds();['points','routes','shapes'].forEach(function(k){state.local[k]=state.local[k]||{};Object.keys(state.local[k]).forEach(function(id){if(!ids[k].has(id))delete state.local[k][id]})});state.local.hidden=state.local.hidden||{};Object.keys(state.local.hidden).forEach(function(id){if(!ids.all.has(id))delete state.local.hidden[id]})}catch(_){}}
  function wrapLocalFunctions(){try{if(window.__v324LocalWrap)return;window.__v324LocalWrap=true;['renderLocalDataRows','drawImportedObjects','refreshLocalData','renderLocalActions'].forEach(function(name){const old=window[name];if(typeof old!=='function')return;window[name]=function(){pruneLocalSelection();const r=old.apply(this,arguments);setTimeout(pruneLocalSelection,0);return r};try{window.eval(name+'=window["'+name+'"]')}catch(_){}})}catch(_){}}
  function installFetchAliasDiagnostics(){try{if(window.__v324FetchAliasHook)return;const old=window.fetch;if(typeof old!=='function')return;window.fetch=function(input,init){let url=String((typeof input==='string'?input:(input&&input.url))||'');let method=String((init&&init.method)||'GET').toUpperCase();return old.apply(this,arguments).then(function(resp){try{if(method==='GET'&&/\/api\/tak-map\/import(\?|$)/.test(url)&&resp.status===401){console.warn('TAK Map local data import GET returned 401; v324 server aliases GET /api/tak-map/import to /api/tak-map/imported after install.');}}catch(_){}return resp})};window.__v324FetchAliasHook=true}catch(_){}}
  function boot(){setVersion();installCss();wrapLocalFunctions();pruneLocalSelection();installFetchAliasDiagnostics()}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,80)},{once:true});else setTimeout(boot,80);
  [350,900,1800,3500,6500].forEach(function(ms){setTimeout(boot,ms)});setInterval(function(){setVersion();pruneLocalSelection()},700);
  try{const mo=new MutationObserver(function(){setTimeout(setVersion,0)});mo.observe(d.body||d.documentElement,{childList:true,subtree:true})}catch(_){}
})();
</script>
'''
        if 'id="v324PopupLocalDataIterationFix"' not in _html:
            _html = _html.replace('</body>', _runtime + '</body>', 1) if '</body>' in _html else _html + _runtime
        return _v324_versions(_html)

    TAK_MAP_HTML = _v324_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML = _v324_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = _v324_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE', 'map')).strip().lower() == 'map':
        INDEX_HTML = TAK_MAP_HTML
except Exception as _v324_exc:
    try: print('v324 popup/local-data/iteration patch failed:', _v324_exc)
    except Exception: pass
# --- end TAK Map v324 iteration hardening + popup spacing/edit/local-data state fixes ---

# --- TAK Map v325 TAK Client Identity setup ---
try:
    import re as _v325_re

    TAK_MAP_CLIENT_IDENTITY_FILE = Path(os.environ.get('TAK_MAP_CLIENT_IDENTITY_FILE', str(DATA_DIR / 'tak_client_identity.json')))

    def _tak_client_identity_defaults():
        return {
            'username': '',
            'password': '',
            'client_cert_path': '',
            'client_key_path': '',
            'ca_cert_path': '',
            'updated_at': '',
        }

    def _tak_client_identity_load(include_secret=False):
        cfg = _tak_client_identity_defaults()
        try:
            if TAK_MAP_CLIENT_IDENTITY_FILE.exists():
                raw=json.loads(TAK_MAP_CLIENT_IDENTITY_FILE.read_text() or '{}')
                if isinstance(raw, dict):
                    for k in cfg.keys():
                        if k in raw and raw.get(k) is not None:
                            cfg[k]=str(raw.get(k) or '')
        except Exception:
            pass
        if not include_secret:
            cfg.pop('password', None)
        return cfg

    def _tak_client_path_status(path_text):
        text=str(path_text or '').strip()
        if not text:
            return {'path':'','exists':False,'readable':False,'is_file':False}
        try:
            fp=Path(text).expanduser()
            return {'path':str(fp),'exists':fp.exists(),'readable':os.access(str(fp), os.R_OK),'is_file':fp.is_file()}
        except Exception as e:
            return {'path':text,'exists':False,'readable':False,'is_file':False,'error':str(e)}

    def tak_map_tak_client_status():
        cfg=_tak_client_identity_load(include_secret=True)
        cert=_tak_client_path_status(cfg.get('client_cert_path'))
        key=_tak_client_path_status(cfg.get('client_key_path'))
        ca=_tak_client_path_status(cfg.get('ca_cert_path'))
        has_username=bool(str(cfg.get('username') or '').strip())
        has_password=bool(str(cfg.get('password') or ''))
        complete=bool(has_username and has_password and cert.get('readable') and key.get('readable'))
        safe={k:v for k,v in cfg.items() if k!='password'}
        return {
            'ok': True,
            'configured': complete,
            'complete': complete,
            'identity': safe,
            'username': safe.get('username',''),
            'has_username': has_username,
            'has_password': has_password,
            'paths': {'client_cert': cert, 'client_key': key, 'ca_cert': ca},
            'needs': {
                'username': not has_username,
                'password': not has_password,
                'client_cert': not bool(cert.get('readable')),
                'client_key': not bool(key.get('readable')),
                'ca_cert': bool(str(cfg.get('ca_cert_path') or '').strip()) and not bool(ca.get('readable')),
            },
            'config_file': str(TAK_MAP_CLIENT_IDENTITY_FILE),
            'message': 'TAK Client identity is configured.' if complete else 'TAK Client identity setup is incomplete.'
        }

    def tak_map_tak_client_save(payload):
        payload=payload if isinstance(payload,dict) else {}
        old=_tak_client_identity_load(include_secret=True)
        def clean(k, limit=600):
            return str(payload.get(k) or '').strip()[:limit]
        username=clean('username',128)
        password=str(payload.get('password') or '')
        if not password and not payload.get('clear_password'):
            password=old.get('password','')
        if payload.get('clear_password'):
            password=''
        data={
            'username': username,
            'password': password,
            'client_cert_path': clean('client_cert_path'),
            'client_key_path': clean('client_key_path'),
            'ca_cert_path': clean('ca_cert_path'),
            'updated_at': datetime.now(timezone.utc).isoformat(),
        }
        try:
            TAK_MAP_CLIENT_IDENTITY_FILE.parent.mkdir(parents=True, exist_ok=True)
            tmp=TAK_MAP_CLIENT_IDENTITY_FILE.with_suffix('.tmp')
            tmp.write_text(json.dumps(data, indent=2))
            try: os.chmod(str(tmp), 0o600)
            except Exception: pass
            tmp.replace(TAK_MAP_CLIENT_IDENTITY_FILE)
            try: os.chmod(str(TAK_MAP_CLIENT_IDENTITY_FILE), 0o600)
            except Exception: pass
        except Exception as e:
            return {'ok':False,'error':'Could not save TAK Client identity setup: '+str(e),'config_file':str(TAK_MAP_CLIENT_IDENTITY_FILE)}
        st=tak_map_tak_client_status()
        st['saved']=True
        return st

    try:
        _v325_orig_ots_cert_candidates = _ots_cert_candidates
        def _ots_cert_candidates():
            pairs=[]
            try:
                cfg=_tak_client_identity_load(include_secret=True)
                cert=str(cfg.get('client_cert_path') or '').strip()
                key=str(cfg.get('client_key_path') or '').strip()
                if cert and key:
                    cp=Path(cert).expanduser(); kp=Path(key).expanduser()
                    if cp.exists() and kp.exists() and os.access(str(cp), os.R_OK) and os.access(str(kp), os.R_OK):
                        pairs.append((cp,kp))
            except Exception:
                pass
            try:
                for pair in _v325_orig_ots_cert_candidates() or []:
                    if pair not in pairs:
                        pairs.append(pair)
            except Exception:
                pass
            return pairs
    except Exception:
        pass

    try:
        _v325_orig_cot_socket_auth_xml = _cot_socket_auth_xml
        def _cot_socket_auth_xml(xml):
            try:
                if (os.environ.get('TAK_DASH_OTS_SOCKET_AUTH_USER','').strip()
                    or os.environ.get('TAK_DASH_OTS_CLIENT_NAME','').strip()
                    or os.environ.get('TAK_DASH_FILESHARE_SENDER_CALLSIGN','').strip()
                    or os.environ.get('TAK_DASH_OTS_SOCKET_AUTH_PASSWORD','').strip()
                    or os.environ.get('TAK_DASH_OTS_CLIENT_PASSWORD','').strip()
                    or os.environ.get('TAK_DASH_OTS_PASSWORD','').strip()):
                    return _v325_orig_cot_socket_auth_xml(xml)
                cfg=_tak_client_identity_load(include_secret=True)
                username=str(cfg.get('username') or '').strip()
                password=str(cfg.get('password') or '')
                if username and password:
                    uid=''
                    try:
                        m=_v325_re.search(r'\bsenderUid=["\']([^"\']+)["\']', str(xml or ''), _v325_re.I)
                        if m: uid=m.group(1).strip()
                    except Exception:
                        pass
                    uid=uid or username
                    root=ET.Element('auth')
                    ET.SubElement(root, 'cot', {'username': username, 'password': password, 'uid': uid})
                    return ET.tostring(root, encoding='unicode', short_empty_elements=True), {'auth_enabled': True, 'auth_sent': True, 'auth_username': username, 'auth_uid': uid, 'auth_source':'tak-client-identity'}
            except Exception:
                pass
            return _v325_orig_cot_socket_auth_xml(xml)
    except Exception:
        pass

    _v325_old_get = Handler.do_GET
    _v325_old_post = Handler.do_POST

    def _v325_do_GET(self):
        parsed=urlparse(self.path)
        try:
            if parsed.path=='/api/tak-map/tak-client/status':
                if not self._tak_map_auth_ok():
                    return self._require_tak_map_login()
                return self._send_json(tak_map_tak_client_status())
        except Exception as e:
            return self._send_json({'ok':False,'error':'TAK Client status failed: '+str(e)},500)
        return _v325_old_get(self)

    def _v325_do_POST(self):
        parsed=urlparse(self.path)
        try:
            if parsed.path=='/api/tak-map/tak-client/save':
                if not self._tak_map_auth_ok():
                    return self._require_tak_map_login()
                payload=_read_json_body(self)
                return self._send_json(tak_map_tak_client_save(payload))
        except Exception as e:
            return self._send_json({'ok':False,'error':'TAK Client save failed: '+str(e),'traceback':traceback.format_exc()},500)
        return _v325_old_post(self)

    Handler.do_GET = _v325_do_GET
    Handler.do_POST = _v325_do_POST

    def _v325_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v325_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v325'", _html)
        _html = _v325_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v325', _html)
        _html = _v325_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v325', _html)
        _html = _v325_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v325\2', _html, flags=_v325_re.I)
        _html = _v325_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v325\2', _html, flags=_v325_re.I)
        _html = _v325_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v325\2', _html, flags=_v325_re.I)
        return _html

    def _v325_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v325_versions(_html)
        runtime=r'''
<script id="v325TakClientIdentitySetup">
(function(){
  'use strict';
  const V='v325';
  const d=document;
  const DISMISS_KEY='takMapTakClientSetupDismissed';
  function byId(id){try{return d.getElementById(id)}catch(_){return null}}
  function q(sel,root){try{return (root||d).querySelector(sel)}catch(_){return null}}
  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}
  function esc(s){return String(s??'').replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c})}
  async function getStatus(){const r=await fetch('/api/tak-map/tak-client/status',{cache:'no-store',credentials:'same-origin'});const j=await r.json().catch(function(){return {ok:false,error:'Bad TAK Client status response'}});if(!r.ok||!j.ok)throw new Error(j.error||('HTTP '+r.status));return j}
  function field(id){return byId('takClient'+id)}
  function setOut(text,bad){const el=byId('takClientOutput');if(el){el.textContent=String(text||'');el.classList.toggle('bad',!!bad)}}
  function pathLine(label,p){p=p||{};let cls=p.readable?'ok':(p.path?'bad':'warn');let msg=p.path?(p.readable?'Readable':(p.exists?'Not readable':'Not found')):'Not set';return '<div class="tak-client-path"><b>'+esc(label)+'</b><span class="'+cls+'">'+esc(msg)+'</span><small>'+esc(p.path||'')+'</small></div>'}
  function renderStatus(j){try{const chip=byId('takClientStatusChip');if(chip){chip.textContent=j.complete?'Configured':'Incomplete';chip.className='tak-client-chip '+(j.complete?'ok':'warn')}const box=byId('takClientStatusBox');if(box){box.innerHTML='<div class="tak-client-status-row"><b>Username</b><span>'+esc(j.username||'Not set')+'</span></div><div class="tak-client-status-row"><b>Password</b><span>'+esc(j.has_password?'Saved':'Not saved')+'</span></div>'+pathLine('Client certificate',j.paths&&j.paths.client_cert)+pathLine('Private key',j.paths&&j.paths.client_key)+pathLine('CA certificate',j.paths&&j.paths.ca_cert);}}catch(_){}}
  function ensureUi(){try{
    installCss();
    const top=q('.top-actions');
    if(top&&!byId('takClientSetupBtn')){
      const b=d.createElement('button');b.id='takClientSetupBtn';b.className='map-cert-btn tak-client-btn';b.type='button';b.textContent='TAK Client';b.onclick=function(ev){try{ev&&ev.preventDefault&&ev.preventDefault()}catch(_){}openTakClientSetup();return false};
      const cert=byId('mapCertSetupBtn')||qa('button',top).find(function(x){return /^\s*Cert Setup\s*$/i.test(x.textContent||'')});
      const logout=qa('button',top).find(function(x){return /logout/i.test(x.textContent||'')});
      top.insertBefore(b, cert||logout||top.firstChild);
    }
    if(!byId('takClientModal')){
      d.body.insertAdjacentHTML('beforeend',`<div id="takClientModal" class="tak-client-modal-backdrop" aria-hidden="true"><div class="tak-client-modal" role="dialog" aria-modal="true" aria-labelledby="takClientTitle"><div class="tak-client-head"><div><h2 id="takClientTitle">TAK Client Setup</h2><div class="muted">Configure the OpenTAKServer client identity TAK Map uses for publish/send features.</div></div><button type="button" onclick="closeTakClientSetup()">Close</button></div><div class="tak-client-grid"><div class="tak-client-card"><div class="tak-client-row"><label>TAK client username<input id="takClientUsername" autocomplete="off" placeholder="Example: takmap"></label><label>Password<input id="takClientPassword" type="password" autocomplete="new-password" placeholder="Leave blank to keep saved password"></label></div><label>Client certificate path<input id="takClientCertPath" autocomplete="off" placeholder="/path/to/client.pem"></label><label>Private key path<input id="takClientKeyPath" autocomplete="off" placeholder="/path/to/client.key"></label><label>CA certificate path<input id="takClientCaPath" autocomplete="off" placeholder="/path/to/ca.pem"></label><div class="tak-client-actions"><button type="button" class="layer-button tak-client-primary" onclick="saveTakClientSetup()">Save TAK Client Setup</button><button type="button" class="layer-button" onclick="refreshTakClientSetup()">Refresh</button></div><pre id="takClientOutput" class="tak-client-output muted">Enter the TAK client account and certificate paths, then Save.</pre></div><div class="tak-client-card"><div class="tak-client-status-title">Status <span id="takClientStatusChip" class="tak-client-chip warn">Checking</span></div><div id="takClientStatusBox" class="tak-client-status-box muted">Loading...</div><div class="tak-client-note">TAK Map can display map data, ADS-B, and Data Sync without this setup. Publishing or sending data to TAK clients requires a TAK client account and certificate configuration.</div></div></div></div></div>`);
      const modal=byId('takClientModal');modal&&modal.addEventListener('click',function(ev){if(ev.target===modal)closeTakClientSetup()});
    }
    if(!byId('takClientReminder')){
      d.body.insertAdjacentHTML('beforeend',`<div id="takClientReminder" class="tak-client-reminder" aria-hidden="true"><div class="tak-client-reminder-box"><h3>TAK Client setup is incomplete</h3><p>TAK Map can display map data, ADS-B, and Data Sync without this setup, but publishing or sending data to TAK clients requires TAK Client setup.</p><label class="tak-client-check"><input id="takClientDontShow" type="checkbox"> Do not show this again</label><div class="tak-client-actions"><button type="button" class="layer-button tak-client-primary" onclick="openTakClientSetup();closeTakClientReminder(true)">Open TAK Client Setup</button><button type="button" class="layer-button" onclick="closeTakClientReminder(true)">Remind Me Later</button></div></div></div>`);
    }
  }catch(e){try{console.warn('TAK Client UI failed',e)}catch(_){}}}
  function installCss(){try{if(byId('takClientStyle'))return;const st=d.createElement('style');st.id='takClientStyle';st.textContent=`
#takClientSetupBtn{border-color:rgba(66,211,255,.34)!important}.tak-client-modal-backdrop,.tak-client-reminder{position:fixed;inset:0;background:rgba(0,0,0,.60);z-index:5200;display:none;align-items:center;justify-content:center;padding:18px}.tak-client-modal-backdrop.active,.tak-client-reminder.active{display:flex}.tak-client-modal{width:min(760px,calc(100vw - 28px));max-height:calc(100vh - 42px);overflow:auto;border:1px solid rgba(66,211,255,.25);border-radius:18px;background:linear-gradient(180deg,rgba(16,25,35,.98),rgba(6,10,14,.98));box-shadow:0 22px 70px rgba(0,0,0,.58);padding:16px}.tak-client-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;border-bottom:1px solid rgba(255,255,255,.10);padding-bottom:12px;margin-bottom:12px}.tak-client-head h2{margin:0;text-transform:uppercase;letter-spacing:.08em;font-size:1rem}.tak-client-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr);gap:12px}.tak-client-card{border:1px solid rgba(255,255,255,.10);border-radius:14px;background:rgba(255,255,255,.035);padding:12px}.tak-client-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.tak-client-card label{display:block;color:#9fb1b9;font-size:.78rem;font-weight:800;margin:0 0 9px}.tak-client-card input{width:100%;margin-top:4px;background:#081018;color:#e9f0f5;border:1px solid #314253;border-radius:10px;padding:8px 9px;font-size:.86rem}.tak-client-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px}.tak-client-primary{border-color:rgba(66,211,255,.45)!important;background:rgba(66,211,255,.10)!important}.tak-client-output{min-height:74px;white-space:pre-wrap;border:1px solid rgba(255,255,255,.10);border-radius:10px;background:#080d12;padding:10px;margin:10px 0 0}.tak-client-output.bad{color:#ffb4ae;border-color:rgba(255,95,87,.45)}.tak-client-status-title{display:flex;align-items:center;justify-content:space-between;font-weight:900;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px}.tak-client-chip{display:inline-flex;border-radius:999px;padding:3px 8px;font-size:.68rem;border:1px solid rgba(255,255,255,.16)}.tak-client-chip.ok{color:#9ff3c4;border-color:rgba(57,217,138,.42);background:rgba(57,217,138,.10)}.tak-client-chip.warn{color:#ffdca0;border-color:rgba(255,204,102,.42);background:rgba(255,204,102,.10)}.tak-client-status-row,.tak-client-path{display:grid;grid-template-columns:120px 1fr;gap:6px;border-top:1px solid rgba(255,255,255,.08);padding:7px 0;font-size:.78rem}.tak-client-path small{grid-column:1/-1;color:#8da0ad;word-break:break-all}.tak-client-path .ok{color:#9ff3c4}.tak-client-path .warn{color:#ffdca0}.tak-client-path .bad{color:#ffb4ae}.tak-client-note{margin-top:10px;color:#9fb1b9;font-size:.78rem;line-height:1.35}.tak-client-reminder-box{width:min(520px,calc(100vw - 30px));border:1px solid rgba(66,211,255,.25);border-radius:18px;background:linear-gradient(180deg,rgba(16,25,35,.98),rgba(6,10,14,.98));box-shadow:0 22px 70px rgba(0,0,0,.58);padding:16px}.tak-client-reminder-box h3{margin:0 0 8px;text-transform:uppercase;letter-spacing:.08em}.tak-client-reminder-box p{color:#c8d2da;line-height:1.4}.tak-client-check{display:flex;align-items:center;gap:8px;color:#c8d2da;font-size:.84rem;margin:10px 0}.tak-client-check input{width:auto}@media(max-width:720px){.tak-client-grid,.tak-client-row{grid-template-columns:1fr}.tak-client-modal{padding:12px}}
`;d.head.appendChild(st)}catch(e){try{console.warn('TAK Client CSS failed',e)}catch(_){}}}
  window.openTakClientSetup=function(){ensureUi();const m=byId('takClientModal');if(m){m.classList.add('active');m.setAttribute('aria-hidden','false')}refreshTakClientSetup();};
  window.closeTakClientSetup=function(){const m=byId('takClientModal');if(m){m.classList.remove('active');m.setAttribute('aria-hidden','true')}};
  window.closeTakClientReminder=function(apply){try{if(apply&&byId('takClientDontShow')&&byId('takClientDontShow').checked)localStorage.setItem(DISMISS_KEY,'1')}catch(_){}const m=byId('takClientReminder');if(m){m.classList.remove('active');m.setAttribute('aria-hidden','true')}};
  window.refreshTakClientSetup=async function(){ensureUi();try{const j=await getStatus();renderStatus(j);const id=j.identity||{};if(field('Username'))field('Username').value=id.username||'';if(field('CertPath'))field('CertPath').value=id.client_cert_path||'';if(field('KeyPath'))field('KeyPath').value=id.client_key_path||'';if(field('CaPath'))field('CaPath').value=id.ca_cert_path||'';if(field('Password'))field('Password').value='';setOut(j.message||'Status refreshed.',!j.complete);return j}catch(e){setOut('TAK Client status failed: '+e,true);return {ok:false,error:String(e)}}};
  window.saveTakClientSetup=async function(){ensureUi();try{setOut('Saving TAK Client setup...');const payload={username:(field('Username')||{}).value||'',password:(field('Password')||{}).value||'',client_cert_path:(field('CertPath')||{}).value||'',client_key_path:(field('KeyPath')||{}).value||'',ca_cert_path:(field('CaPath')||{}).value||''};const r=await fetch('/api/tak-map/tak-client/save',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const j=await r.json().catch(function(){return {ok:false,error:'Bad save response'}});if(!r.ok||!j.ok)throw new Error(j.error||('HTTP '+r.status));renderStatus(j);if(field('Password'))field('Password').value='';setOut((j.complete?'Saved. TAK Client identity is configured.':'Saved, but setup is still incomplete. Check the status panel.'),!j.complete);return j}catch(e){setOut('TAK Client save failed: '+e,true);return {ok:false,error:String(e)}}};
  async function maybeReminder(){try{ensureUi();if(localStorage.getItem(DISMISS_KEY)==='1')return;const j=await getStatus();renderStatus(j);if(!j.complete){const m=byId('takClientReminder');if(m){m.classList.add('active');m.setAttribute('aria-hidden','false')}}}catch(e){try{console.warn('TAK Client reminder failed',e)}catch(_){}}}
  function boot(){ensureUi();qa('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}});setTimeout(maybeReminder,900)}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,120)},{once:true});else setTimeout(boot,120);
  [800,1800,3600].forEach(function(ms){setTimeout(ensureUi,ms)});
})();
</script>
