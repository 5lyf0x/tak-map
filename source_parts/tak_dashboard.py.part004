        _html = _v327_versions(_html)
        runtime = """
<script id="v327TakClientPrivateKeyHelp">
(function(){
  'use strict';
  const V='v327';
  const d=document;
  function byId(id){try{return d.getElementById(id)}catch(_){return null}}
  function q(sel,root){try{return (root||d).querySelector(sel)}catch(_){return null}}
  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}
  function esc(s){return String(s??'').replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c})}
  function installCss(){try{if(byId('takClientKeyHelpStyle'))return;const st=d.createElement('style');st.id='takClientKeyHelpStyle';st.textContent=`
.tak-client-help-slot{margin-top:24px;display:flex;justify-content:center;align-items:center}.tak-client-help-btn{min-width:156px;border:1px solid rgba(66,211,255,.38)!important;background:rgba(66,211,255,.08)!important;color:#e9f0f5!important}.tak-client-help-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.66);z-index:5350;display:none;align-items:center;justify-content:center;padding:18px}.tak-client-help-backdrop.active{display:flex}.tak-client-help-modal{width:min(720px,calc(100vw - 28px));max-height:calc(100vh - 42px);overflow:auto;border:1px solid rgba(66,211,255,.28);border-radius:18px;background:linear-gradient(180deg,rgba(16,25,35,.985),rgba(6,10,14,.985));box-shadow:0 22px 74px rgba(0,0,0,.62);padding:16px}.tak-client-help-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;border-bottom:1px solid rgba(255,255,255,.10);padding-bottom:10px;margin-bottom:10px}.tak-client-help-head h3{margin:0;text-transform:uppercase;letter-spacing:.08em;font-size:1rem}.tak-client-help-modal p{color:#c8d2da;line-height:1.35;margin:8px 0}.tak-client-help-step{border:1px solid rgba(255,255,255,.10);border-radius:12px;background:rgba(255,255,255,.035);padding:10px;margin:8px 0}.tak-client-help-step b{display:block;color:#e9f0f5;margin-bottom:6px}.tak-client-help-code-wrap{position:relative}.tak-client-help-code{display:block;white-space:pre-wrap;word-break:break-word;color:#e9f0f5;background:#071019;border:1px solid rgba(255,255,255,.10);border-radius:10px;padding:9px 68px 9px 10px;margin:0;font-size:.78rem;line-height:1.35}.tak-client-help-copy{position:absolute;top:6px;right:6px;border:1px solid rgba(66,211,255,.34);border-radius:8px;background:rgba(66,211,255,.10);color:#e9f0f5;font-size:.68rem;padding:4px 7px}.tak-client-help-note{font-size:.82rem;color:#9fb1b9}.tak-client-help-close{border:1px solid rgba(255,255,255,.18);border-radius:8px;background:rgba(255,255,255,.08);color:#e9f0f5;padding:5px 9px}@media(max-width:720px){.tak-client-help-modal{padding:12px}.tak-client-help-code{padding-right:10px}.tak-client-help-copy{position:static;margin:6px 0 0 0}}
`;d.head.appendChild(st)}catch(e){try{console.warn('TAK Client key help CSS failed',e)}catch(_){}}}
  function codeBlock(txt){return '<div class="tak-client-help-code-wrap"><pre class="tak-client-help-code">'+esc(txt)+'</pre><button type="button" class="tak-client-help-copy" onclick="copyTakClientKeyHelp(this)">Copy</button></div>'}
  function ensureHelpModal(){try{installCss();if(byId('takClientKeyHelpModal'))return;const html=`<div id="takClientKeyHelpModal" class="tak-client-help-backdrop" aria-hidden="true"><div class="tak-client-help-modal" role="dialog" aria-modal="true" aria-labelledby="takClientKeyHelpTitle"><div class="tak-client-help-head"><div><h3 id="takClientKeyHelpTitle">Private Key Help</h3><div class="muted">Use these commands on the OpenTAKServer host to locate or extract the TAK client private key.</div></div><button type="button" class="tak-client-help-close" onclick="closeTakClientKeyHelp()">Close</button></div><p class="tak-client-help-note">TAK Map needs the TAK client certificate, private key, and CA certificate for publish/send features.</p><div class="tak-client-help-step"><b>1. Find OpenTAKServer cert/key files</b><p class="tak-client-help-note">Most OpenTAKServer installs keep client certs under <b>~/ots/ca</b> and subfolders. Replace <b>takmap</b> with your TAK client username if needed.</p>${codeBlock('sudo find ~/ots/ca -type f \\\\( -name "*takmap*" -o -name "*.key" -o -name "*.p12" -o -name "*.pfx" -o -name "*.pem" \\\\) 2>/dev/null | sort')}</div><div class="tak-client-help-step"><b>2. Extract cert/key from a .p12 or .pfx</b><p class="tak-client-help-note">Use this only if you found a <b>.p12</b> or <b>.pfx</b> file instead of a separate <b>.key</b>.</p>${codeBlock('mkdir -p ~/tak-client-cert\\nsudo openssl pkcs12 -in /path/to/client.p12 -clcerts -nokeys -out ~/tak-client-cert/client.pem\\nsudo openssl pkcs12 -in /path/to/client.p12 -nocerts -nodes -out ~/tak-client-cert/client.key\\nsudo cp ~/ots/ca/ca.pem ~/tak-client-cert/ca.pem\\nchmod 600 ~/tak-client-cert/client.key')}<p class="tak-client-help-note">Use these paths in TAK Client Setup:</p>${codeBlock('Client certificate path: ~/tak-client-cert/client.pem\\nPrivate key path:        ~/tak-client-cert/client.key\\nCA certificate path:     ~/tak-client-cert/ca.pem')}</div><div class="tak-client-help-step"><b>3. Verify the cert and key match</b>${codeBlock('openssl x509 -noout -modulus -in ~/tak-client-cert/client.pem | openssl md5\\nopenssl rsa  -noout -modulus -in ~/tak-client-cert/client.key | openssl md5\\n# The two MD5 values should match.')}</div></div></div>`;d.body.insertAdjacentHTML('beforeend',html);const m=byId('takClientKeyHelpModal');m&&m.addEventListener('click',function(ev){if(ev.target===m)closeTakClientKeyHelp()})}catch(e){try{console.warn('TAK Client key help modal failed',e)}catch(_){}}}
  function addHelpButton(){try{installCss();ensureHelpModal();const statusBox=byId('takClientStatusBox');if(!statusBox)return false;const card=statusBox.closest&&statusBox.closest('.tak-client-card');if(!card)return false;let slot=byId('takClientKeyHelpSlot');if(!slot){slot=d.createElement('div');slot.id='takClientKeyHelpSlot';slot.className='tak-client-help-slot';slot.innerHTML='<button type="button" class="layer-button tak-client-help-btn" onclick="openTakClientKeyHelp()">Private Key Help</button>';const note=q('.tak-client-note',card);if(note&&note.parentNode)note.insertAdjacentElement('afterend',slot);else card.appendChild(slot)}return true}catch(e){try{console.warn('TAK Client key help button failed',e)}catch(_){}return false}}
  window.openTakClientKeyHelp=function(){ensureHelpModal();const m=byId('takClientKeyHelpModal');if(m){m.classList.add('active');m.setAttribute('aria-hidden','false')}};
  window.closeTakClientKeyHelp=function(){const m=byId('takClientKeyHelpModal');if(m){m.classList.remove('active');m.setAttribute('aria-hidden','true')}};
  window.copyTakClientKeyHelp=function(btn){try{const pre=btn&&btn.parentNode&&btn.parentNode.querySelector('.tak-client-help-code');const text=pre?pre.textContent:'';if(navigator.clipboard&&text){navigator.clipboard.writeText(text).then(function(){btn.textContent='Copied';setTimeout(function(){btn.textContent='Copy'},1200)},function(){btn.textContent='Copy'})}}catch(_){}};
  const prevOpen=window.openTakClientSetup;
  if(typeof prevOpen==='function'&&!prevOpen.__v327KeyHelpWrapped){const wrapped=function(){const r=prevOpen.apply(this,arguments);[80,300,800].forEach(function(ms){setTimeout(addHelpButton,ms)});return r};wrapped.__v327KeyHelpWrapped=true;window.openTakClientSetup=wrapped}
  function boot(){installCss();ensureHelpModal();addHelpButton();qa('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,180)},{once:true});else setTimeout(boot,180);
  [700,1600,3200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>
"""
        if 'id="v327TakClientPrivateKeyHelp"' not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v327_versions(_html)

    TAK_MAP_HTML = _v327_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML = _v327_versions(TAK_MAP_LOGIN_HTML)
