  `;d.head.appendChild(st)}catch(e){try{console.warn('v347 css failed',e)}catch(_){}}}
  function normHex(v,def){try{let s=String(v||'').trim();if(/^#[0-9a-fA-F]{6}$/.test(s))return s.toLowerCase();if(/^#[0-9a-fA-F]{3}$/.test(s))return '#'+s.slice(1).split('').map(c=>c+c).join('').toLowerCase();}catch(_){}return def||'#ff6f2e'}
  function selectedColors(){const stroke=normHex(($('drawSaveColor')&&$('drawSaveColor').value)||($('drawColorInput')&&$('drawColorInput').value)||'', '#ff6f2e');const fill=normHex(($('drawSaveFillColor')&&$('drawSaveFillColor').value)||($('drawFillColorInput')&&$('drawFillColorInput').value)||stroke, stroke);return {stroke,fill}}
