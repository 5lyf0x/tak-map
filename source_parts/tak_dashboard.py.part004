# --- TAK Map v308 ADS-B targeted tracking/no-flicker patch ---
try:
    import re as _v308_re
    _V308 = 'v308'

    def _v308_remove_script(_html, _sid):
        return _v308_re.sub(r'<script[^>]*id=["\']' + _v308_re.escape(_sid) + r'["\'][^>]*>.*?</script>\s*', '', _html, flags=_v308_re.S|_v308_re.I)

    def _v308_versions(_html):
        _html = _v308_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/' + _V308, _html)
        _html = _v308_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 ' + _V308, _html)
        _html = _v308_re.sub(r'<span class="iteration-chip">v\d+</span>', '<span class="iteration-chip">' + _V308 + '</span>', _html)
        _html = _v308_re.sub(r'<div class="iteration-marker">v\d+</div>', '<div class="iteration-marker">' + _V308 + '</div>', _html)
        _html = _v308_re.sub(r'const\s+V\s*=\s*["\']v\d+["\']\s*;', "const V='" + _V308 + "';", _html)
        _html = _v308_re.sub(r'>v\d+<', '>' + _V308 + '<', _html)
        _html = _html.replace('v307AdsbBaseStyles', 'v308AdsbBaseStyles')
        _html = _html.replace('v307AdsbTrackStyle', 'v308AdsbTrackStyle')
        _html = _html.replace('v307ViewshedOpenPatch', 'v308ViewshedOpenPatch')
        _html = _html.replace('v307ViewshedPatchStyle', 'v308ViewshedPatchStyle')
        return _html

    def _v308_patch_adsb(_html):
        # v307's pointer/click handler was starting tracking on pointerdown, then older source-level
        # click code immediately toggled it off. Remove the wrapper and fix the owning source path.
        _html = _v308_remove_script(_html, 'v307AdsbTrackReliabilityPatch')

        # Remove the old capture click handler embedded in the source-level ADS-B refactor; tracking
        # is now invoked directly from the Track button onclick in the popup.
        _html = _v308_re.sub(
            r"\s*window\.addEventListener\('click',function\(ev\)\{const btn=ev\.target&&ev\.target\.closest&&ev\.target\.closest\('\.adsb-track-btn'\);if\(!btn\)return;ev\.preventDefault\(\);ev\.stopPropagation\(\);try\{ev\.stopImmediatePropagation\(\)\}catch\(_\)\{\}toggleAdsbTrack\(btn\.dataset\.adsbTrackId\|\|btn\.getAttribute\('data-adsb-track-id'\)\|\|''\);return false;\},true\);",
            '',
            _html,
            count=1
        )

        # Make popup Track button call the single source-level tracking function directly.
        _html = _html.replace(
            '<button type="button" class="layer-button adsb-track-btn" data-adsb-track-id="${esc(id)}"><span class="adsb-track-light"></span><span class="adsb-track-text">Track</span></button>',
            '<button type="button" class="layer-button adsb-track-btn" data-adsb-track-id="${esc(id)}" onclick="event.preventDefault();event.stopPropagation();return window.toggleAdsbTrack&&window.toggleAdsbTrack(this.dataset.adsbTrackId)"><span class="adsb-track-light"></span><span class="adsb-track-text">Track</span></button>'
        )

        # Replace the source-level drawAircraft function with an in-place renderer. The old version
        # called setIcon on every refresh and removed absent markers immediately, which caused blinking
        # on short/tiny refreshes and while interacting with popups.
        _new_draw = r'''function drawAircraft(list){
    const layer=ensureLayer();if(!layer)return;
    let shown=filtered(Array.isArray(list)?list:[]).filter(a=>Number.isFinite(Number(a&&a.lat))&&Number.isFinite(Number(a&&a.lon))&&!!adsbId(a));
    const prev=Array.isArray(window.__v308StableAdsbList)?window.__v308StableAdsbList:[];
    const now=Date.now();
    if(shown.length===0&&prev.length>0){shown=prev;}
    else if(shown.length>0){window.__v308StableAdsbList=shown;window.__v308StableAdsbAt=now;}
    window.lastAircraft=shown;window.__v308LastAircraft=shown;
    const seen=new Set();
    for(const a of shown){
      const id=adsbId(a);if(!id)continue;seen.add(id);stableAdsbState(a);
      const lat=Number(a.lat),lon=Number(a.lon);if(!Number.isFinite(lat)||!Number.isFinite(lon))continue;
      const ll=[lat,lon],url=iconFor(a),rot=Number(a.track_deg)||0,label=esc(a.callsign||a.registration||a.hex||'ADS-B');
      let m=markers.get(id);
      const html=`<div class="adsb-hitbox" data-adsb-id="${esc(id)}"><div class="aircraft-wrap"><img src="${esc(url)}" style="transform:rotate(${rot}deg)"><span class="aircraft-label">${label}</span></div></div>`;
      if(!m){
        const icon=L.divIcon({className:'adsb-v308-marker',iconSize:[96,60],iconAnchor:[48,24],html});
        m=L.marker(ll,{icon,zIndexOffset:900,interactive:true}).addTo(layer);
        m.bindPopup(popupHtml(a),{className:'adsb-v280-popup adsb-object-popup',autoPan:false,closeButton:false});
        m.on('mouseover',()=>{if(!pinnedAdsb)try{m.openPopup();setTimeout(syncAdsbTrackButtons,20)}catch(_){}});
        m.on('mouseout',()=>{if(!pinnedAdsb)try{m.closePopup()}catch(_){}});
        m.on('click',ev=>{try{L.DomEvent.stop(ev);pinnedAdsb=id;m.openPopup();setTimeout(syncAdsbTrackButtons,20)}catch(_){}});
        markers.set(id,m);
      }else{
        m.setLatLng(ll);
        const el=m.getElement&&m.getElement();
        const img=el&&el.querySelector&&el.querySelector('img');
        const lab=el&&el.querySelector&&el.querySelector('.aircraft-label');
        if(img){try{if(!String(img.getAttribute('src')||img.src||'').endsWith(url))img.src=url;img.style.transform=`rotate(${rot}deg)`;}catch(_){}}
        else{try{m.setIcon(L.divIcon({className:'adsb-v308-marker',iconSize:[96,60],iconAnchor:[48,24],html}))}catch(_){}}
        if(lab)lab.textContent=label;
        if(!m.isPopupOpen()||pinnedAdsb!==id){try{m.setPopupContent(popupHtml(a))}catch(_){}}
      }
      m._v308LastSeen=now;m._v308Data=a;m._adsbData=a;
      if(adsbTrackState.id===id)addAdsbTrackPoint(a);
    }
    for(const [id,m] of markers){
      if(seen.has(id))continue;
      const age=now-Number(m&&m._v308LastSeen||0);
      if(age>45000){try{layer.removeLayer(m)}catch(_){ } markers.delete(id); if(pinnedAdsb===id)pinnedAdsb=null;}
    }
    try{if($('adsbStatus'))$('adsbStatus').textContent=shown.length+' active'; if($('bannerAdsb'))$('bannerAdsb').textContent=shown.length+' Aircraft'}catch(_){ }
    syncAdsbTrackButtons();
  }
  '''
        _html, _count = _v308_re.subn(
            r"function drawAircraft\(list\)\{const layer=ensureLayer\(\);if\(!layer\)return;.*?\}\s*function bindMap\(\)",
            _new_draw + 'function bindMap()',
            _html,
            count=1,
            flags=_v308_re.S
        )
        if _count != 1:
            raise RuntimeError('v308 drawAircraft replacement count=' + str(_count))
        return _html

    TAK_MAP_HTML = _v308_patch_adsb(TAK_MAP_HTML)
    TAK_MAP_HTML = _v308_versions(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML = _v308_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = _v308_versions(LOGIN_HTML)
except Exception as _v308_exc:
    try: print('v308 ADS-B targeted patch failed:', _v308_exc)
    except Exception: pass
# --- end TAK Map v308 ADS-B targeted tracking/no-flicker patch ---


# --- TAK Map v309 ADS-B ownership reset + Viewshed targeted patch ---
try:
    import re as _v309_re
    def _v309_remove_script_block(_html, _sid):
        return _v309_re.sub(r'<script[^>]*id=["\']'+_v309_re.escape(_sid)+r'["\'][^>]*>.*?</script>\s*', '', _html, count=0, flags=_v309_re.S)
    def _v309_strip_adsb_owners(_html):
        for _sid in (
            'v282Preflight',
            'v284AdsbPopupCloseClassPatch',
            'v288AdsbStatusSortGovtPatch',
            'v294TerrainLocalCoverageAdsbStabilityPatch',
            'v296AdsbStableLocalTerrainPatch',
            'v308ViewshedOpenPatch',
        ):
            _html = _v309_remove_script_block(_html, _sid)
        _html = _v309_re.sub(r'/\*\s*v282 stability cleanup: single ADS-B module, event-driven popups, no recurring repair loops\s*\*/\s*\(function\(\)\{.*?\}\)\(\);\s*(?=</script>)',
                             '/* v282 ADS-B owner removed by v309: ADS-B is owned by v309AdsbOwnerPatch. */\n',
                             _html, count=1, flags=_v309_re.S)
        _html = _v309_re.sub(r'function\s+wrapAdsbDraw\s*\(\)\s*\{.*?\}\s*(?=\s*function\s+restyleDrawingTools\s*\()',
                             'function wrapAdsbDraw(){try{window._v309RemovedLegacyAdsbDrawWrap=true}catch(_){}}\n',
                             _html, count=1, flags=_v309_re.S)
        # Older source-level ADS-B draw assignments remain in historical blocks. Rename their globals so v309 is
        # the only runtime owner of drawAircraft/refreshAdsb, while leaving surrounding non-ADS-B code intact.
        _html = _html.replace('drawAircraft=window.drawAircraft=function', 'window.v309RemovedLegacyDrawAircraft=function')
        _html = _html.replace('window.drawAircraft=function', 'window.v309RemovedLegacyDrawAircraft=function')
        _html = _html.replace('window.refreshAdsb=function(){return Promise.resolve([])}', 'window.v309RemovedLegacyRefreshAdsb=function(){return Promise.resolve([])}')
        return _html
    def _v309_versions(_html):
        _html = _v309_re.sub(r'<span class="iteration-chip">v\d+</span>', '<span class="iteration-chip">v309</span>', _html)
        _html = _v309_re.sub(r'<div class="iteration-marker">v\d+</div>', '<div class="iteration-marker">v309</div>', _html)
        _html = _v309_re.sub(r'const\s+V\s*=\s*["\']v\d+["\']', "const V='v309'", _html)
        _html = _v309_re.sub(r'>v\d+<', '>v309<', _html)
        _html = _html.replace('TAK Server Dashboard</div><div class="version-row">', 'TAK Map</div><div class="version-row">')
        _html = _html.replace('v308AdsbBaseStyles', 'v309AdsbBaseStyles')
        return _html
    _v309_script = r"""<script id="v309AdsbOwnerPatch">
(function(){
  'use strict';
  const V='v309';
  const CTL=window.TakMapControllers=window.TakMapControllers||{};
  function q(sel,root){try{return (root||document).querySelector(sel)}catch(_){return null}}
  function qa(sel,root){try{return Array.from((root||document).querySelectorAll(sel))}catch(_){return []}}
  function byId(id){try{return document.getElementById(id)}catch(_){return null}}
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
  function n(v){v=Number(v);return Number.isFinite(v)?v:null}
  function mapObj(){try{if(typeof map!=='undefined'&&map&&map.addLayer){window.map=map;window.takLeafletMap=map;return map}}catch(_){}try{if(window.takLeafletMap&&window.takLeafletMap.addLayer)return window.takLeafletMap}catch(_){}try{if(window.map&&window.map.addLayer){window.takLeafletMap=window.map;return window.map}}catch(_){}return null}
  function idOf(a){return String((a&&(a.id||a.hex||a.icao||a.uid||a.registration||a.callsign||a.flight))||'').trim().toLowerCase()}
  function titleOf(a,id){return String((a&&(a.callsign||a.flight||a.registration||a.hex||a.icao||a.id))||id||'ADS-B Aircraft').trim()||'ADS-B Aircraft'}
