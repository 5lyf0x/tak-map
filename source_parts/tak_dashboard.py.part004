        _html = _v353_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v353', _html)
        _html = _v353_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v353', _html)
        _html = _v353_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v353\2', _html, flags=_v353_re.I)
