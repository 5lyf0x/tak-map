    TAK_MAP_HTML = _v303_neutralize_legacy_adsb_track(TAK_MAP_HTML)
    _v303_controller = '<script id="v303StabilizedModuleControllers">\n(function(){\n  \'use strict\';\n  const V=\'v303\';\n  const RELEASE=\'1.2.0\';\n  const CTL=window.TakMapControllers=window.TakMapControllers||{};\n  function q(sel,root){try{return (root||document).querySelector(sel)}catch(_){return null}}\n  function qa(sel,root){try{return Array.from((root||document).querySelectorAll(sel))}catch(_){return []}}\n  function byId(id){try{return document.getElementById(id)}catch(_){return null}}\n  function esc(s){return String(s==null?\'\':s).replace(/[&<>"\']/g,function(c){return {\'&\':\'&amp;\',\'<\':\'&lt;\',\'>\':\'&gt;\',\'"\':\'&quot;\',"\'":\'&#39;\'}[c]})}\n  function num(v){v=Number(v);return Number.isFinite(v)?v:null}\n  function version(){try{qa(\'.iteration-chip,.iteration-marker\').forEach(function(el){el.textContent=V});qa(\'.version-product,.sidebar-version-title\').forEach(function(el){if(/dashboard/i.test(el.textContent||\'\'))el.textContent=\'TAK Map\'});document.documentElement.dataset.takMapIteration=V}catch(_){}}\n  function leafletMap(){try{if(window.takLeafletMap&&window.takLeafletMap.addLayer)return window.takLeafletMap}catch(_){}try{if(typeof map!==\'undefined\'&&map&&map.addLayer){window.takLeafletMap=map;return map}}catch(_){}try{if(window.map&&window.map.addLayer)return window.map}catch(_){}return null}\n  function distanceMeters(points){let m=0;try{for(let i=1;i<(points||[]).length;i++){const a=points[i-1],b=points[i];if(window.L&&L.latLng)m+=L.latLng(a.lat,a.lon).distanceTo(L.latLng(b.lat,b.lon));else{const R=6371000,rad=Math.PI/180;const p1=a.lat*rad,p2=b.lat*rad,dp=(b.lat-a.lat)*rad,dl=(b.lon-a.lon)*rad;const h=Math.sin(dp/2)**2+Math.cos(p1)*Math.cos(p2)*Math.sin(dl/2)**2;m+=2*R*Math.atan2(Math.sqrt(h),Math.sqrt(1-h))}}}catch(_){}return m}\n  function distText(m){return (m/1609.344).toFixed(1)+\'mi/\'+(m/1000).toFixed(1)+\'km\'}\n  function idOf(a){return String((a&&(a.id||a.hex||a.icao||a.uid||a.registration||a.callsign||a.flight))||\'\').trim().toLowerCase()}\n  function titleOf(a){return String((a&&(a.callsign||a.flight||a.registration||a.hex||a.icao||a.id))||\'ADS-B\').trim()||\'ADS-B\'}\n  function altText(a){let v=a&&(a.altitude_ft??a.alt_baro??a.alt_geom??a.alt);if(String(v).toLowerCase()===\'ground\')return \'Ground\';v=num(v);return v==null?\'—\':Math.round(v).toLocaleString()+\' ft\'}\n  function spdText(a){let v=a&&(a.speed_kt??a.gs??a.ground_speed??a.speed);v=num(v);return v==null?\'—\':Math.round(v)+\' kt\'}\n  function classKey(a){let s=String((a&&(a.classification||a.category||a.owner_category||a.affiliation))||\'\').toLowerCase();if(/mil/.test(s))return \'mil\';if(/gov/.test(s))return \'gov\';if(/civil/.test(s))return \'civ\';const blob=String(Object.values(a||{}).join(\' \'));if(/\\b(law enforcement|police|sheriff|fire dept|fire department|public safety|ems|rescue|chp|cal fire|usfs|medical|hospital|response)\\b/i.test(blob))return \'gov\';return \'civ\'}\n  function classTextFromKey(k){return k===\'mil\'?\'Military\':k===\'gov\'?\'Govt\':k===\'unk\'?\'Unknown\':\'Civil\'}\n  const shapeById=new Map();\n  function rotorEvidence(a){const blob=[a&&a.is_helo,a&&a.is_rotor,a&&a.rotorcraft,a&&a.type,a&&a.aircraft_type,a&&a.description,a&&a.emitter_category,a&&a.category,a&&a.t].filter(Boolean).join(\' \');return /\\b(helicopter|heli|helo|rotor|rotorcraft|rotary|h60|uh-60|ch-47|bell|ec-?145|as350|aw139|r44)\\b/i.test(blob)}\n  function fixedEvidence(a){const blob=[a&&a.type,a&&a.aircraft_type,a&&a.description,a&&a.emitter_category].filter(Boolean).join(\' \');return /\\b(fixed[- ]?wing|airplane|aeroplane|jet|turboprop|glider|ultralight)\\b/i.test(blob)}\n  function shapeKey(a){const id=idOf(a);let prev=id&&shapeById.get(id);if(rotorEvidence(a)){prev=\'helo\'}else if(!prev){prev=fixedEvidence(a)?\'fixed\':\'fixed\'}else if(prev===\'helo\'&&!fixedEvidence(a)){prev=\'helo\'}else if(prev!==\'helo\'){prev=\'fixed\'}if(id)shapeById.set(id,prev);return prev||\'fixed\'}\n  function iconPath(a){const c=classKey(a),s=shapeKey(a);return \'/assets/adsb/adsb_\'+(c===\'mil\'?\'mil\':c===\'gov\'?\'gov\':c===\'unk\'?\'unk\':\'civ\')+\'_\'+(s===\'helo\'?\'helo\':\'fixed\')+\'.png\'}\n  const ADSB=CTL.adsb=CTL.adsb||{};\n  ADSB.markers=ADSB.markers||new Map();ADSB.data=ADSB.data||new Map();ADSB.tracking=ADSB.tracking||{id:null,meta:null,points:[],layer:null,label:null};\n  function aircraftList(input){let rows=Array.isArray(input)?input:(Array.isArray(window.lastAircraft)?window.lastAircraft:(Array.isArray(window._v296StableAdsb)?window._v296StableAdsb:[]));return rows.map(function(a){a=Object.assign({},a||{});a.lat=num(a.lat);a.lon=num(a.lon);return a}).filter(function(a){return idOf(a)&&a.lat!=null&&a.lon!=null})}\n  function popupHtml(a){const id=esc(idOf(a));const title=esc(titleOf(a));return \'<div class="adsb-popup"><h3>\'+title+\'</h3><div class="popup-grid"><div>Class</div><div>\'+esc(classTextFromKey(classKey(a)))+\'</div><div>Type</div><div>\'+esc(shapeKey(a)===\'helo\'?\'Helicopter\':\'Airplane\')+\'</div><div>Alt</div><div>\'+esc(altText(a))+\'</div><div>Speed</div><div>\'+esc(spdText(a))+\'</div></div><div class="adsb-track-row"><button type="button" class="layer-button adsb-track-btn" data-adsb-track-id="\'+id+\'" aria-pressed="false"><span class="adsb-track-light"></span><span>Track</span></button></div></div>\'}\n  function iconFor(a){if(!window.L)return null;return L.divIcon({className:\'adsb-marker-hitbox\',iconSize:[42,42],iconAnchor:[21,21],popupAnchor:[0,-18],html:\'<div class="adsb-hitbox"><img draggable="false" src="\'+esc(iconPath(a))+\'" alt=""/></div>\'})}\n  function ensureLayer(){const m=leafletMap();if(!m||!window.L)return null;if(!ADSB.layer){ADSB.layer=L.layerGroup();ADSB.layer.addTo(m)}return ADSB.layer}\n  function patchMarkerGlobals(){try{const obj={};ADSB.markers.forEach(function(v,k){obj[k]=v});window.v303AircraftLayersById=obj;window.v298AircraftLayersById=obj;window.v240AircraftLayersById=obj;window.v238AircraftLayersById=obj;window.v236AircraftLayersById=obj}catch(_){}}\n  function renderAircraft(input){const layer=ensureLayer();const rows=aircraftList(input);const seen=new Set();if(!layer)return rows;rows.forEach(function(a){const id=idOf(a);seen.add(id);ADSB.data.set(id,a);let mk=ADSB.markers.get(id);const latlng=[a.lat,a.lon];if(!mk){mk=L.marker(latlng,{icon:iconFor(a),zIndexOffset:650,interactive:true,riseOnHover:true});mk.addTo(layer);ADSB.markers.set(id,mk)}else{try{mk.setLatLng(latlng);mk.setIcon(iconFor(a))}catch(_){}}try{mk._takAdsbAircraft=a;mk._takAdsbId=id;mk.bindPopup(popupHtml(a),{autoPan:true,maxWidth:320});}catch(_){} });Array.from(ADSB.markers.keys()).forEach(function(id){if(!seen.has(id)){try{layer.removeLayer(ADSB.markers.get(id))}catch(_){}ADSB.markers.delete(id);ADSB.data.delete(id)}});patchMarkerGlobals();syncTrackButtons();updateTrackFromRows(rows);return rows}\n  function findAircraft(id){id=String(id||\'\').toLowerCase();return ADSB.data.get(id)||aircraftList().find(function(a){return idOf(a)===id})||null}\n  function focusAircraft(id){try{id=decodeURIComponent(String(id||\'\')).toLowerCase();const a=findAircraft(id);const m=leafletMap();if(a&&m){m.setView([a.lat,a.lon],Math.max(m.getZoom(),13),{animate:true});const mk=ADSB.markers.get(id);if(mk)mk.openPopup()}}catch(_){}}\n  function ensureTrackLayer(){const m=leafletMap();if(!m||!window.L)return false;const t=ADSB.tracking;if(!t.layer){t.layer=L.polyline([],{color:\'#ff4b2b\',weight:4,opacity:.92,interactive:false}).addTo(m)}if(!t.label){t.label=L.marker([0,0],{interactive:false,icon:L.divIcon({className:\'adsb-track-distance-label\',html:\'0.0mi/0.0km\',iconSize:null,iconAnchor:[-10,10]})}).addTo(m)}return true}\n  function addTrackPoint(a){const t=ADSB.tracking;if(!t.id||!a||num(a.lat)==null||num(a.lon)==null)return;const last=t.points[t.points.length-1];if(last&&Math.abs(last.lat-a.lat)<1e-7&&Math.abs(last.lon-a.lon)<1e-7)return;t.points.push({lat:a.lat,lon:a.lon,alt:num(a.altitude_ft??a.alt_baro??a.alt_geom??a.alt)||0,t:Date.now()});drawTrack()}\n  function drawTrack(){const t=ADSB.tracking;if(!t.id||!ensureTrackLayer())return;const pts=t.points.map(function(p){return [p.lat,p.lon]});try{t.layer.setLatLngs(pts);const m=distanceMeters(t.points);if(t.label&&pts.length){t.label.setLatLng(pts[pts.length-1]);t.label.setIcon(L.divIcon({className:\'adsb-track-distance-label\',html:distText(m),iconSize:null,iconAnchor:[-10,10]}))}}catch(_){} }\n  function updateTrackFromRows(rows){const t=ADSB.tracking;if(!t.id)return;const a=(rows||aircraftList()).find(function(x){return idOf(x)===t.id});if(a)addTrackPoint(a)}\n  function syncTrackButtons(){try{qa(\'.adsb-track-btn\').forEach(function(btn){const id=String(btn.dataset.adsbTrackId||\'\').toLowerCase();const on=!!(ADSB.tracking.id&&id===ADSB.tracking.id);btn.classList.toggle(\'active\',on);btn.classList.toggle(\'tracking\',on);btn.style.background=on?\'linear-gradient(180deg,rgba(180,28,24,.96),rgba(100,12,8,.96))\':\'\';btn.style.borderColor=on?\'rgba(255,90,70,.95)\':\'\';btn.setAttribute(\'aria-pressed\',on?\'true\':\'false\');const light=q(\'.adsb-track-light\',btn);if(light){light.classList.toggle(\'active\',on);light.style.background=on?\'#ff3b28\':\'\'}})}catch(_){}}\n  function cleanName(s){return String(s||\'ADS-B Track\').replace(/[\\\\/:*?"<>|]+/g,\'-\').replace(/\\s+/g,\' \').trim().slice(0,96)||\'ADS-B Track\'}\n  function saveDialog(id,meta,pts){try{const old=byId(\'adsbTrackSaveDialog\');if(old)old.remove();const m=distanceMeters(pts);const title=titleOf(meta||{id:id});const stamp=new Date().toISOString().slice(0,19).replace(/[T:]/g,\'-\');const def=cleanName(title+\' ADS-B Track \'+stamp);const can=(pts||[]).length>=2;const div=document.createElement(\'div\');div.id=\'adsbTrackSaveDialog\';div.className=\'adsb-track-save-overlay\';div.innerHTML=\'<div class="adsb-track-save-card" role="dialog" aria-modal="true"><button type="button" class="adsb-track-save-x" data-act="discard" aria-label="Close">×</button><div class="adsb-track-save-title">Save ADS-B Track</div><div class="adsb-track-save-sub">\'+esc(title)+\' · \'+esc(distText(m))+\' · \'+esc(String((pts||[]).length))+\' pts</div><input id="adsbTrackRouteName" class="adsb-track-save-input" value="\'+esc(def)+\'" \'+(can?\'\':\'disabled\')+\' />\'+(can?\'\':\'<div class="adsb-track-save-error">At least 2 track points are required to save a route.</div>\')+\'<div id="adsbTrackSaveMsg" class="adsb-track-save-msg"></div><div class="adsb-track-save-actions"><button type="button" class="layer-button" data-act="discard">Discard</button><button type="button" class="layer-button primary" data-act="save" \'+(can?\'\':\'disabled\')+\'>Save</button></div></div>\';document.body.appendChild(div);async function save(){if(!can)return;const msg=byId(\'adsbTrackSaveMsg\');try{if(msg)msg.textContent=\'Saving…\';const name=cleanName((byId(\'adsbTrackRouteName\')||{}).value||def);const geo={type:\'FeatureCollection\',features:[{type:\'Feature\',geometry:{type:\'LineString\',coordinates:pts.map(function(p){return [p.lon,p.lat,p.alt||0]})},properties:{name:name,source:\'TAK Map ADS-B\',kind:\'route\',geometry:\'route\',route_type:\'adsb_aircraft_track\',point_count:pts.length,distance_miles:Number((m/1609.344).toFixed(3)),distance_km:Number((m/1000).toFixed(3)),distance_text:distText(m)}}]};const blob=new Blob([JSON.stringify(geo,null,2)],{type:\'application/geo+json\'});const file=new File([blob],name+\'.geojson\',{type:\'application/geo+json\'});const fd=new FormData();fd.append(\'files\',file,file.name);const r=await fetch(\'/api/tak-map/import\',{method:\'POST\',body:fd});if(!r.ok)throw new Error(\'HTTP \'+r.status);if(msg)msg.textContent=\'Saved\';try{if(typeof window.refreshLocalData===\'function\')await window.refreshLocalData();if(typeof window.drawImportedObjects===\'function\')window.drawImportedObjects()}catch(_){}setTimeout(function(){div.remove()},400)}catch(e){if(msg){msg.textContent=\'Save failed: \'+String(e&&e.message||e);msg.classList.add(\'bad\')}}}div.addEventListener(\'click\',function(ev){const a=ev.target&&ev.target.getAttribute&&ev.target.getAttribute(\'data-act\');if(a===\'discard\'||ev.target===div){ev.preventDefault();div.remove()}else if(a===\'save\'){ev.preventDefault();save()}},true)}catch(e){console.warn(\'v303 save dialog failed\',e)}}\n  function startTrack(id){const a=findAircraft(id);if(!a)return false;const t=ADSB.tracking;t.id=String(id).toLowerCase();t.meta=a;t.points=[];try{if(t.layer)t.layer.setLatLngs([]);if(t.label){const m=leafletMap();if(m)m.removeLayer(t.label);t.label=null}}catch(_){}addTrackPoint(a);syncTrackButtons();return true}\n  function stopTrack(){const t=ADSB.tracking;const id=t.id,meta=t.meta,pts=t.points.slice();t.id=null;t.meta=null;t.points=[];syncTrackButtons();saveDialog(id,meta,pts);return false}\n  function toggleTrack(id){id=String(id||\'\').toLowerCase();if(!id)return false;if(ADSB.tracking.id===id)return stopTrack();if(ADSB.tracking.id)stopTrack();return startTrack(id)}\n  function buttonAircraftId(btn){let id=String((btn&&btn.dataset&&btn.dataset.adsbTrackId)||\'\').toLowerCase();if(id)return id;const pop=btn&&btn.closest&&btn.closest(\'.leaflet-popup\');const title=(q(\'.adsb-popup h3,.feature-popup h3\',pop)||{}).textContent||\'\';const row=aircraftList().find(function(a){return titleOf(a).toLowerCase()===String(title).trim().toLowerCase()});return idOf(row)}\n  function patchOpenPopups(){try{qa(\'.leaflet-popup\').forEach(function(pop){let btn=q(\'.adsb-track-btn\',pop);if(!btn){const title=(q(\'.adsb-popup h3,.feature-popup h3\',pop)||{}).textContent||\'\';const row=aircraftList().find(function(a){return titleOf(a).toLowerCase()===String(title).trim().toLowerCase()});const id=idOf(row);if(id){const content=q(\'.leaflet-popup-content\',pop)||pop;content.insertAdjacentHTML(\'beforeend\',\'<div class="adsb-track-row"><button type="button" class="layer-button adsb-track-btn" data-adsb-track-id="\'+esc(id)+\'"><span class="adsb-track