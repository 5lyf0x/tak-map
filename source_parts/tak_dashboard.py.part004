  function ensureOptionsPanel(){let p=$('drawOptionsPanel');if(!p){p=d.createElement('div');p.id='drawOptionsPanel';p.className='tak-floating-panel';d.body.appendChild(p)}p.innerHTML='<h3>Shape Options</h3><div class="draw-grid"><label class="wide">Name<input id="drawNameInput" placeholder="Shape name"></label><label>Color<input id="drawColorInput" type="color" value="#ff6f2e"></label><label>Line<input id="drawWeightInput" type="number" min="1" max="18" step="1" value="3"></label><label>Style<select id="drawLineStyleInput"><option value="solid">Solid</option><option value="dashed">Dashed</option></select></label><label>Fill<select id="drawFillInput"><option value="1">Filled</option><option value="0">Unfilled</option></select></label><label>Fill %<input id="drawFillOpacityInput" type="number" min="0" max="100" step="5" value="20"></label><div id="drawV344Status" class="draw-status"></div></div><div class="draw-actions tak-floating-actions"><button type="button" onclick="v236CloseDrawOptions()">Close</button><button type="button" class="primary" onclick="v236ApplyDrawOptions()">Apply</button></div>';['drawNameInput','drawColorInput','drawWeightInput','drawLineStyleInput','drawFillInput','drawFillOpacityInput'].forEach(function(id){const el=$(id);if(el&&!el.__v344ShapeBound){el.__v344ShapeBound=true;el.addEventListener('input',function(){readOptions();redraw()});el.addEventListener('change',function(){readOptions();redraw()})}});return p}
