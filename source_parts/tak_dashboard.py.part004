button><button id="localElevWorkerTest" type="button">Test GeoTIFF Worker</button><button id="localElevClearSelection" type="button">Clear Selection</button></div><div id="localElevWorkerChip" class="local-elev-worker-chip">GeoTIFF worker: idle</div><div id="localElevStatus" class="local-elev-status">Ready. Select one GeoTIFF and click Import GeoTIFF Metadata. No worker starts until you click Import or Test.</div><div class="local-elev-list-title">Selected files</div><div id="localElevSelected" class="local-elev-selected">No selected files.</div><div class="local-elev-list-title">Imported local GeoTIFF metadata</div><div id="localElevList" class="local-elev-list">No local elevation GeoTIFF metadata imported in this browser session yet.</div><div class="local-elev-close-note">v371 imports metadata only. Files over 250 MB require confirmation; over 1 GB are rejected for now.</div></div></div></div>\');\n    dlg=$(\'localElevationDialog\');bindDialogControls(dlg);renderSelected();renderIndexed();if(wasActive)showDialog(dlg);return dlg}catch(e){console.warn(\'v371 ensure local elevation dialog failed\',e);return null}}\n  function openDialog(ev){stop(ev);try{const dlg=ensureDialog();if(dlg){showDialog(dlg);chip(\'GeoTIFF worker: idle\',\'idle\');status(\'Ready. No worker or DEM decode starts until you click Import or Test.\',\'ok\')}return false}catch(e){console.warn(\'v371 open local elevation failed\',e);return false}}\n  function closeDialog(ev){stop(ev);try{const dlg=$(\'localElevationDialog\');if(dlg){dlg.classList.remove(\'active\');try{dlg.dataset.v371Open=\'0\'}catch(_){}dlg.style.display=\'none\';dlg.style.visibility=\'hidden\';dlg.style.opacity=\'0\';dlg.style.pointerEvents=\'none\'}}catch(e){console.warn(\'v371 close local elevation failed\',e)}return false}\n  function asset(path){return new URL(path,w.location.origin).href}\n  function workerSource(){return `\n    self.onmessage=async function(ev){\n      const m=ev.data||{};\n      if(m.cmd===\'test\')retu