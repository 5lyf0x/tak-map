    }catch(e){try{console.warn('v347 shape center draw patch failed',e)}catch(_){}}}
  function resetPublishControls(){try{const b=$('sendConfirmBtn');if(b){b.disabled=false;b.dataset.v332Published='0';b.classList.remove('tak-publish-done');b.removeAttribute('aria-disabled');b.textContent='Publish';}const s=$('sendStatus');if(s){s.classList.remove('tak-publish-success','danger');s.textContent='';}qa('.send-progress,.publish-progress,.tak-publish-spinner').forEach(function(el){try{el.remove()}catch(_){}})}catch(_){}}
  function patchPublishReset(){try{if(w.__v347PublishReset)return;w.__v347PublishReset=true;['openLocalDataPublish','openSendOfflineMap','openSendLiveBasemapSource'].forEach(function(name){try{const old=w[name];if(old&&!old.__v347PublishReset){const fn=function(){resetPublishControls();const r=old.apply(this,arguments);setTimeout(resetPublishControls,80);setTimeout(resetPublishControls,250);return r};fn.__v347PublishReset=true;w[name]=fn;try{eval(name+'=window[name]')}catch(_){}}}catch(_){}});const oldClose=w.closeSendModal;if(typeof oldClose==='function'&&!oldClose.__v347PublishReset){const fn=function(){const r=oldClose.apply(this,arguments);setTimeout(resetPublishControls,60);setTimeout(resetPublishControls,250);return r};fn.__v347PublishReset=true;w.closeSendModal=fn;try{closeSendModal=fn}catch(_){}}const m=$('sendModal');if(m&&!m.__v347PublishObserver){m.__v347PublishObserver=true;new MutationObserver(function(){try{if(!m.classList.contains('active'))setTimeout(resetPublishControls,80)}catch(_){}}).observe(m,{attributes:true,attributeFilter:['class','style']});}}catch(e){try{console.warn('v347 publish reset patch failed',e)}catch(_){}}}
