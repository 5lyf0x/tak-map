    except Exception: pass
# --- end TAK Map v342 route detection activation + route UI cleanup + Data Sync scroll lock ---


# --- TAK Map v343 route-only publish cleanup + sidebar scroll fix + route child filtering ---
try:
    import re as _v343_re

    def _v343_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v343_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v343'", _html)
        _html = _v343_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v343', _html)
        _html = _v343_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v343', _html)
        _html = _v343_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v343\2', _html, flags=_v343_re.I)
        _html = _v343_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v343\2', _html, flags=_v343_re.I)
        _html = _v343_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v343\2', _html, flags=_v343_re.I)
        return _html

    def _v343_row_xml_text(row=None, xml=''):
        try:
            if xml:
                return str(xml or '')
            vals=[]
            for v in (row or {}).values():
                if isinstance(v, (dict, list)):
                    try: vals.append(json.dumps(v, default=str)[:40000])
                    except Exception: pass
                else:
                    t=str(v or '')
                    if t: vals.append(t[:40000])
            return '\n'.join(vals)
        except Exception:
            return str(xml or '')

    def _v343_is_route_child_uid(uid='', callsign='', cot_type='', xml='', row=None):
        """True for route checkpoint/vector child points that must not render as EUDs."""
        try:
            uid=str(uid or '').strip()
            callsign=str(callsign or '').strip()
            cot_type=str(cot_type or '').strip()
            txt=_v343_row_xml_text(row, xml).lower()
            blob=' '.join([uid, callsign, cot_type, txt[:5000]]).lower()
            if 'b-m-r' in txt and '<link' in txt and (cot_type == 'b-m-p-c' or 'type="b-m-p-c"' in txt or "type='b-m-p-c'" in txt):
                return True
            if _v343_re.search(r'\.cp\d+\b', uid.lower()) and ('takmap-route' in uid.lower() or 'b-m-r' in blob or 'route' in blob):
                return True
            if cot_type == 'b-m-p-c' and _v343_re.match(r'^(cp|rp|wp)\s*\d+$', callsign.lower()) and ('b-m-r' in blob or 'route' in blob):
                return True
            if 'route-checkpoint' in blob or 'route control point' in blob or 'takmap route checkpoint' in blob:
                return True
        except Exception:
            pass
        return False

    # Hide previously-published v342 route child/checkpoint events from TAK Map live/EUD rendering.
    _v343_old_normalize_tak_marker = globals().get('_normalize_tak_marker')
    if callable(_v343_old_normalize_tak_marker):
        def _normalize_tak_marker(row, source_table='cot', default_kind='cot'):
            parsed={}
            try:
                parsed=_parse_cot_text_fields(row) if callable(globals().get('_parse_cot_text_fields')) else {}
                uid=str(_row_ci_get(row or {}, ('uid','cot_uid','clientuid','clientUid','client_uid','device_uid','id'), '') or parsed.get('uid') or '').strip()
                callsign=str(_row_ci_get(row or {}, ('callsign','call_sign','sender_callsign','name','title','username'), '') or parsed.get('callsign') or '').strip()
                typ=str(_row_ci_get(row or {}, ('type','cot_type','event_type','category'), '') or parsed.get('type') or '').strip()
                if _v343_is_route_child_uid(uid, callsign, typ, row=row):
                    return None
            except Exception:
                pass
            m=_v343_old_normalize_tak_marker(row, source_table, default_kind)
            try:
                if m and _v343_is_route_child_uid(m.get('uid') or m.get('id') or '', m.get('callsign') or '', m.get('type') or '', row=row):
                    return None
            except Exception:
                pass
            return m

    _v343_old_is_real_eud_candidate = globals().get('_is_real_eud_candidate')
    if callable(_v343_old_is_real_eud_candidate):
        def _is_real_eud_candidate(e, xml=''):
            try:
                if _v343_is_route_child_uid((e or {}).get('uid') or '', (e or {}).get('callsign') or '', (e or {}).get('type') or '', xml=xml):
                    return False
            except Exception:
                pass
            return _v343_old_is_real_eud_candidate(e, xml)

    _v343_old_tak_map_euds = globals().get('tak_map_euds')
    if callable(_v343_old_tak_map_euds):
        def tak_map_euds():
            data=_v343_old_tak_map_euds() or {'ok':True,'euds':[]}
            try:
                if isinstance(data, dict) and isinstance(data.get('euds'), list):
                    data['euds']=[e for e in data.get('euds') or [] if not _v343_is_route_child_uid((e or {}).get('uid') or '', (e or {}).get('callsign') or '', (e or {}).get('type') or '')]
            except Exception:
                pass
            return data

    def _v343_route_cot_events_for_feature(f, route_idx=0, mission_name='', creator_uid=''):
        """Route-only CoT publish.  Do not send standalone checkpoint points."""
        pts=_local_data_feature_points(f)
        if len(pts) < 2:
            return {'ok':False,'error':'Route needs at least two points.','events':[],'route_uid':''}
        package_uid='takmap-route-v343-' + hashlib.sha1((json.dumps(json_safe(f), sort_keys=True)[:4096] + str(route_idx)).encode('utf-8','ignore')).hexdigest()[:16]
        try:
            route_uid=_v331_feature_uid(f, route_idx, package_uid)
        except Exception:
            route_uid='TAKMAP-ROUTE-' + hashlib.sha1((str(uuid.uuid4())+str(time.time())).encode()).hexdigest()[:24]
        route_uid=str(route_uid or '').strip()[:150]
        if not route_uid:
            route_uid='TAKMAP-ROUTE-' + uuid.uuid4().hex[:20]
        name=_v331_name_from_feature(f, 'Route') if callable(globals().get('_v331_name_from_feature')) else 'Route'
        props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
        prefix=str(props.get('checkpoint_prefix') or props.get('prefix') or 'CP').strip() or 'CP'
        method=str(props.get('route_method') or props.get('method') or 'Driving').strip() or 'Driving'
        direction=str(props.get('route_direction') or props.get('direction') or 'Infil').strip() or 'Infil'
        route_type=str(props.get('route_type') or props.get('routetype') or 'Primary').strip() or 'Primary'
        order=str(props.get('checkpoint_order') or props.get('order') or 'Ascending Check Points').strip() or 'Ascending Check Points'
        color_argb=_v341_argb_from_feature(f) if callable(globals().get('_v341_argb_from_feature')) else str(-37074)
        weight=_v341_route_weight_from_feature(f) if callable(globals().get('_v341_route_weight_from_feature')) else '3.0'
        style=_v341_route_style_from_feature(f) if callable(globals().get('_v341_route_style_from_feature')) else 'solid'
        now=datetime.now(timezone.utc)
        stale=now + timedelta(days=3650)
        remarks=_v331_remarks_from_feature(f) if callable(globals().get('_v331_remarks_from_feature')) else ''
        first=pts[0]
        event=ET.Element('event', {'version':'2.0','uid':route_uid,'type':'b-m-r','how':'h-g-i-g-o','time':_cot_time(now),'start':_cot_time(now),'stale':_cot_time(stale)})
        ET.SubElement(event, 'point', {'lat':f'{float(first[0]):.7f}','lon':f'{float(first[1]):.7f}','hae':'0','ce':'9999999.0','le':'9999999.0'})
        detail=ET.SubElement(event, 'detail')
        ET.SubElement(detail, 'contact', {'callsign':name})
        rmk='\n'.join([x for x in [remarks, f'Method: {method}', f'Direction: {direction}', f'Route Type: {route_type}', f'Order: {order}', f'Line Style: {style}', 'Created by TAK Map', 'v343 route-only publish: standalone checkpoint CoT suppressed'] if x])[:3000]
        if rmk:
            ET.SubElement(detail, 'remarks').text=rmk
        ET.SubElement(detail, 'strokeColor', {'value':color_argb})
        ET.SubElement(detail, 'strokeWeight', {'value':weight})
        if str(style).lower() == 'dashed':
            ET.SubElement(detail, 'strokeStyle', {'value':'dashed'})
        ET.SubElement(detail, '__routeinfo', {'type':'Ground','method':method,'direction':direction,'routetype':route_type,'order':order,'prefix':prefix})
        ET.SubElement(detail, 'routeInfo', {'type':'Ground','method':method,'direction':direction,'routeType':route_type,'order':order,'prefix':prefix})
        link_uids=[]
        for i,p in enumerate(pts):
            wp_uid=(route_uid + '.' + prefix + str(i+1))[:155]
            link_uids.append(wp_uid)
            # The point attribute provides route geometry to ATAK.  We intentionally do
            # not send a separate b-m-p-c event for this UID to avoid standalone markers.
            ET.SubElement(detail, 'link', {'uid':wp_uid,'callsign':f'{prefix}{i+1}','type':'b-m-p-c','point':f'{float(p[0]):.7f},{float(p[1]):.7f},0.0','relation':'c'})
        if mission_name:
            ET.SubElement(detail, 'link', {'uid':str(mission_name), 'type':'b-f-t-r', 'relation':'p-m'})
        ET.SubElement(detail, 'archive')
        ET.SubElement(detail, 'labels_on', {'value':'true'})
        ET.SubElement(detail, 'takv', {'device':'TAK Map', 'platform':'TAK Map', 'version':'v343', 'os':'web'})
        route_xml='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)
        return {'ok':True,'name':name,'route_uid':route_uid,'waypoint_uids':link_uids,'events':[{'uid':route_uid,'kind':'route','xml':route_xml}],'associate_uids':[route_uid],'point_count':len(pts),'color_argb':color_argb,'route_style':style,'standalone_checkpoint_events_suppressed':True,'embedded_link_count':len(link_uids)}

    # The v341 publisher calls this global by name, so replace it in-place.
    _v341_route_cot_events_for_feature=_v343_route_cot_events_for_feature

    _v343_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features=_selected_local_data_features(ids)
        if not features:
            return {'ok':False,'error':'No selected Local Data items were found.'}
        try:
            route_features=_v342_route_features(features, kind) if callable(globals().get('_v342_route_features')) else (_v341_route_features(features, kind) if callable(globals().get('_v341_route_features')) else [])
        except Exception:
            route_features=[]
        if route_features and callable(globals().get('tak_map_publish_route_uids_to_mission_v341')):
            res=tak_map_publish_route_uids_to_mission_v341(route_features, mission_name, server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
            try:
                if isinstance(res, dict):
                    res['publish_mode']='mission-uid-spatial-route-v343-route-only'
                    res['route_detection']='v343-flexible-route-detection'
                    res['fallback_zip_used']=False
                    res['standalone_checkpoint_events_suppressed']=True
                    # Keep compatibility with old UI code that keys on route-v342.
                    res['route_publish_cleanup']='v343-suppressed-standalone-checkpoints'
            except Exception:
                pass
            return res
        if callable(_v343_old_local_publish):
            return _v343_old_local_publish(ids, kind, mission_name, server_host)
        return {'ok':False,'error':'v343 local publish fallback unavailable for this Local Data selection.'}

    def _v343_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v343_versions(_html)
        runtime=r"""
<script id="v343RouteOnlyAndScrollFixPatch">
(function(){
  'use strict';
  const V='v343'; const d=document;
  // Disable the broad v341/v342 scroll lock installers before their delayed boot runs.
  // They captured the entire sidebar and could snap the left menu back to ADS-B.
  window.__v341DataSyncScrollFix=true;
  window.__v342DataSyncScrollLock=true;
  function $(id){return d.getElementById(id)}
  function setVersion(){try{d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){}}
  function killBroadScrollLock(){try{d.body.classList.remove('v342-scroll-locking')}catch(_){}}
  function isScrollable(el){try{return !!(el&&el.nodeType===1&&(el.scrollHeight>el.clientHeight+3||el.scrollWidth>el.clientWidth+3))}catch(_){return false}}
  function dataSyncRoot(){return $('dataSyncRows')||$('dataSyncPanel')||d.querySelector('[id*="dataSync" i],[id*="datasync" i]')}
  function scopedTargets(root){const out=[];function add(el){if(el&&out.indexOf(el)<0&&isScrollable(el))out.push(el)}try{if(!root)return out;add(root);root.querySelectorAll('.datasync-section-list,.sync-list,.data-sync-list,.collapse-body,.layer-list,.object-list,[data-sync-section],[id*="dataSync" i],[id*="datasync" i]').forEach(add)}catch(_){}return out}
  let snap=null;
  function capture(t){try{const root=(t&&t.closest&&t.closest('#dataSyncRows,#dataSyncPanel,[id*="dataSync" i],[id*="datasync" i]'))||dataSyncRoot();const items=scopedTargets(root).map(function(el,i){return {el:el,id:el.id||'',idx:i,top:el.scrollTop,left:el.scrollLeft}});snap={time:Date.now(),root:root,items:items};return snap}catch(_){return null}}
  function locate(s,root){try{if(s.el&&d.contains(s.el))return s.el;if(s.id){const e=$(s.id);if(e)return e}const arr=scopedTargets(root||dataSyncRoot());return arr[s.idx]||null}catch(_){return null}}
  function restore(ss){try{killBroadScrollLock();ss=ss||snap;if(!ss)return;(ss.items||[]).forEach(function(s){const el=locate(s,ss.root);if(el){el.scrollTop=s.top||0;el.scrollLeft=s.left||0}})}catch(_){}}
  function schedule(ss){[0,16,50,120,260,520,900,1500].forEach(function(ms){setTimeout(function(){restore(ss)},ms)})}
  function inDataSync(t){try{return !!(t&&t.closest&&t.closest('#dataSyncRows,#dataSyncPanel,[id*="dataSync" i],[id*="datasync" i]'))}catch(_){return false}}
  function installScopedScroll(){try{if(window.__v343ScopedDataSyncScroll)return;window.__v343ScopedDataSyncScroll=true;['pointerdown','mousedown','touchstart'].forEach(function(ev){d.addEventListener(ev,function(e){if(inDataSync(e.target))capture(e.target)},true)});['click','change'].forEach(function(ev){d.addEventListener(ev,function(e){if(inDataSync(e.target)){const ss=capture(e.target);schedule(ss)}},true)});['centerDataSyncIndex','selectDataSyncObject','focusDataSyncObject','toggleDataSyncObject','toggleDataSyncObjects','toggleDataSyncSection'].forEach(function(name){try{const old=window[name];if(old&&!old.__v343ScopedScroll){const w=function(){const ss=capture(d.activeElement||dataSyncRoot());const r=old.apply(this,arguments);schedule(ss);return r};w.__v343ScopedScroll=true;window[name]=w;try{eval(name+'=window[name]')}catch(_){}}}catch(_){}})}catch(e){try{console.warn('v343 scoped Data Sync scroll failed',e)}catch(_){}}}
  function installRouteChildSuppressor(){try{if(window.__v343RouteChildSuppressor)return;window.__v343RouteChildSuppressor=true;const isRouteChild=function(o){try{const uid=String((o&&(o.uid||o.id))||'').toLowerCase();const cs=String((o&&(o.callsign||o.name||o.title))||'').toLowerCase();const typ=String((o&&(o.type||o.cot_type||o.event_type))||'').toLowerCase();const src=String((o&&(o.source||o.kind||o.category))||'').toLowerCase();return ((typ==='b-m-p-c'||uid.match(/\.cp\d+$/)||cs.match(/^(cp|rp|wp)\s*\d+$/))&&(src.indexOf('route')>=0||uid.indexOf('takmap-route')>=0||typ==='b-m-p-c'));}catch(_){return false}};const oldCat=window.dataSyncCategory||((typeof dataSyncCategory==='function')?dataSyncCategory:null);window.dataSyncCategory=function(o){try{if(isRouteChild(o))return 'Route Control Points'}catch(_){}return oldCat?oldCat(o):'Other / Unknown'};try{dataSyncCategory=window.dataSyncCategory}catch(_){};['drawCotMarkers','drawTakObjects','renderCotMarkers','drawEuds','renderEuds'].forEach(function(name){try{const old=window[name];if(old&&!old.__v343RouteChildFilter){const w=function(list){try{if(Array.isArray(list))arguments[0]=list.filter(function(x){return !isRouteChild(x)})}catch(_){}return old.apply(this,arguments)};w.__v343RouteChildFilter=true;window[name]=w;try{eval(name+'=window[name]')}catch(_){}}}catch(_){}})}catch(e){try{console.warn('v343 route child suppressor failed',e)}catch(_){}}}
  function boot(){setVersion();killBroadScrollLock();installScopedScroll();installRouteChildSuppressor()}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,80)},{once:true});else setTimeout(boot,80);
  [200,500,1000,2000,4000,8000,12000].forEach(function(ms){setTimeout(boot,ms)});
  setInterval(function(){killBroadScrollLock();},1000);
})();
</script>
"""
        if 'id="v343RouteOnlyAndScrollFixPatch"' not in _html and "id='v343RouteOnlyAndScrollFixPatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v343_versions(_html)

    TAK_MAP_HTML=_v343_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML=_v343_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=_v343_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower()=='map':
        INDEX_HTML=TAK_MAP_HTML
except Exception as _v343_exc:
    try: print('v343 route-only publish / sidebar scroll / route child filter patch failed:', _v343_exc)
    except Exception: pass
# --- end TAK Map v343 route-only publish cleanup + sidebar scroll fix + route child filtering ---


# --- TAK Map v344 shape workflow repair + scoped Data Sync scroll + route marker cleanup ---
try:
    import re as _v344_re
    def _v344_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v344_re.sub(r"const V='v\d+'", "const V='v344'", _html)
        _html=_v344_re.sub(r"const V=\"v\d+\"", 'const V="v344"', _html)
        _html=_v344_re.sub(r">v\d+<", ">v344<", _html)
        _html=_v344_re.sub(r"TAK Map v\d+", "TAK Map v344", _html)
        _html=_html.replace('version":"v343"','version":"v344"').replace("version':'v343'","version':'v344'")
        _html=_html.replace('version":"v342"','version":"v344"').replace("version':'v342'","version':'v344'")
        return _html

    def _v344_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v344_versions(_html)
        runtime = r'''
<script id="v344ShapeWorkflowScrollAndRouteMarkerPatch">
(function(){
  'use strict';
  const V='v344';
  const d=document;
  const w=window;
  function $(id){return d.getElementById(id)}
  function setVersion(){try{d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){}}
  function addCss(){try{if($('v344ShapeWorkflowStyle'))return;const css=`
    #drawOptionsPanel.tak-floating-panel,#drawOptionsPanel{box-sizing:border-box!important;width:360px!important;min-width:320px!important;max-width:min(390px,calc(100vw - 28px))!important;padding:12px!important;gap:10px!important;overflow:visible!important;z-index:11250!important;}
    #drawOptionsPanel h3{margin:0 0 8px!important;font-size:.9rem!important;line-height:1.1!important;letter-spacing:.06em!important;}
