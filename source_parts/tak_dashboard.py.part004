    if callable(_v347_old_tak_map_cot_markers):
        def tak_map_cot_markers():
            data=_v347_old_tak_map_cot_markers() or {'ok':True,'markers':[]}
            try:
                if isinstance(data, dict) and isinstance(data.get('markers'), list):
                    data['markers']=[m for m in data.get('markers') or [] if not _v347_is_shape_center((m or {}).get('uid') or (m or {}).get('id') or '', (m or {}).get('callsign') or (m or {}).get('name') or '', (m or {}).get('type') or (m or {}).get('cot_type') or '', row=m)]
            except Exception:
                pass
            return data

    def _v347_patch_html(_html):
