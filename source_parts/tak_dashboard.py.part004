# --- TAK Map v348 submenu offsets + polygon/ellipse/freehand center cleanup + draw dialog polish ---
try:
    import re as _v348_re

    def _v348_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v348_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v348'", _html)
        _html = _v348_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v348', _html)
        _html = _v348_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v348', _html)
        _html = _v348_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v348\2', _html, flags=_v348_re.I)
        _html = _v348_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v348\2', _html, flags=_v348_re.I)
        _html = _v348_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v348\2', _html, flags=_v348_re.I)
        _html = _html.replace('version="v347"', 'version="v348"').replace("version='v347'", "version='v348'")
        return _html

    def _v348_text(row=None, xml=''):
        try:
            if callable(globals().get('_v347_row_text')):
                return _v347_row_text(row, xml)
        except Exception:
            pass
        try:
            if callable(globals().get('_v343_row_xml_text')):
                return _v343_row_xml_text(row, xml)
        except Exception:
            pass
        parts=[]
        try:
            if isinstance(row, dict):
                for k,v in row.items():
                    if v not in (None,''):
                        parts.append(str(v))
        except Exception:
            pass
        if xml:
            parts.append(str(xml))
        return ' '.join(parts)

    def _v348_is_shape_center(uid='', callsign='', cot_type='', xml='', row=None):
        try:
            txt=_v348_text(row, xml).lower()
            uid=str(uid or '').strip().lower()
            callsign=str(callsign or '').strip().lower()
            cot_type=str(cot_type or '').strip().lower()
            blob=' '.join([uid,callsign,cot_type,txt[:50000]])
            type_like = cot_type in ('u-d-f','u-d-r','u-d-c','u-d-c-c','u-d-s') or any(t in blob for t in ('u-d-f','u-d-r','u-d-c','u-d-c-c','u-d-s'))
            uid_like = uid.startswith('takmap-local-') or uid.startswith('takmap-shape-') or uid.startswith('tak-shape-') or 'takmap-local-' in blob or 'takmap-shape-' in blob
            detail_like = any(x in blob for x in ('__shapeextras','<link point=','link point','<__shape','<shape','takmap_shape','shape_type','tak map drawing tools'))
            shape_word = bool(_v348_re.search(r'\b(shape|area|polygon|ellipse|freehand|lasso|circle|rectangle|square)\b', blob))
            if type_like and (uid_like or detail_like or shape_word):
                return True
            if uid_like and (detail_like or shape_word):
                return True
            if detail_like and shape_word:
                return True
        except Exception:
            pass
        try:
            return bool(globals().get('_v347_is_shape_center') and _v347_is_shape_center(uid, callsign, cot_type, xml, row))
        except Exception:
            return False

    _v348_prev_normalize_tak_marker = globals().get('_normalize_tak_marker')
    if callable(_v348_prev_normalize_tak_marker):
        def _normalize_tak_marker(row, source_table='cot', default_kind='cot'):
            try:
                parsed=_parse_cot_text_fields(row) if callable(globals().get('_parse_cot_text_fields')) else {}
                uid=str(_row_ci_get(row or {}, ('uid','sender_uid','cot_uid','clientuid','clientUid','client_uid','device_uid','id','data','contentUid'), '') or parsed.get('uid') or '').strip()
                callsign=str(_row_ci_get(row or {}, ('callsign','sender_callsign','call_sign','name','title','username'), '') or parsed.get('callsign') or '').strip()
                typ=str(_row_ci_get(row or {}, ('type','cot_type','event_type','category'), '') or parsed.get('type') or '').strip()
                if _v348_is_shape_center(uid, callsign, typ, row=row):
                    return None
            except Exception:
                pass
            m=_v348_prev_normalize_tak_marker(row, source_table, default_kind)
            try:
                if m and _v348_is_shape_center(m.get('uid') or m.get('id') or m.get('data') or '', m.get('callsign') or m.get('name') or m.get('title') or '', m.get('type') or m.get('cot_type') or m.get('event_type') or '', row=row):
                    return None
            except Exception:
                pass
            return m

    _v348_prev_is_real_eud_candidate = globals().get('_is_real_eud_candidate')
    if callable(_v348_prev_is_real_eud_candidate):
        def _is_real_eud_candidate(e, xml=''):
            try:
                if _v348_is_shape_center((e or {}).get('uid') or (e or {}).get('id') or (e or {}).get('data') or '', (e or {}).get('callsign') or (e or {}).get('name') or (e or {}).get('title') or '', (e or {}).get('type') or (e or {}).get('cot_type') or (e or {}).get('event_type') or '', xml=xml, row=e):
                    return False
            except Exception:
                pass
            return _v348_prev_is_real_eud_candidate(e, xml)

    _v348_prev_tak_map_euds = globals().get('tak_map_euds')
    if callable(_v348_prev_tak_map_euds):
        def tak_map_euds():
            data=_v348_prev_tak_map_euds() or {'ok':True,'euds':[]}
            try:
                if isinstance(data, dict) and isinstance(data.get('euds'), list):
                    data['euds']=[e for e in data.get('euds') or [] if not _v348_is_shape_center((e or {}).get('uid') or (e or {}).get('id') or (e or {}).get('data') or '', (e or {}).get('callsign') or (e or {}).get('name') or (e or {}).get('title') or '', (e or {}).get('type') or (e or {}).get('cot_type') or (e or {}).get('event_type') or '', row=e)]
            except Exception:
                pass
            return data

    _v348_prev_tak_map_cot_markers = globals().get('tak_map_cot_markers')
    if callable(_v348_prev_tak_map_cot_markers):
        def tak_map_cot_markers():
            data=_v348_prev_tak_map_cot_markers() or {'ok':True,'markers':[]}
            try:
                if isinstance(data, dict) and isinstance(data.get('markers'), list):
                    data['markers']=[m for m in data.get('markers') or [] if not _v348_is_shape_center((m or {}).get('uid') or (m or {}).get('id') or (m or {}).get('data') or '', (m or {}).get('callsign') or (m or {}).get('name') or (m or {}).get('title') or '', (m or {}).get('type') or (m or {}).get('cot_type') or (m or {}).get('event_type') or '', row=m)]
            except Exception:
                pass
            return data

    def _v348_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html=_v348_versions(_html)
        runtime=r'''
