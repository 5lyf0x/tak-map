        runtime = r'''
<script id="v353PopupElevationWorkerPatch">
(function(){
  'use strict';
  const V='v353', d=document, w=window;
  const MB=1024*1024, WARN_MB=250, CONFIRM_MB=500, HARD_MB=1024;
  function $(id){try{return d.getElementById(id)}catch(_){return null}}
  function q(sel,root){try{return (root||d).querySelector(sel)}catch(_){return null}}
  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
  function setVersion(){try{qa('.iteration-chip,.iteration-marker').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  function bytes(n){n=Number(n)||0;if(n>=1024*1024*1024)return (n/1024/1024/1024).toFixed(1)+' GB';if(n>=1024*1024)return Math.round(n/1024/1024)+' MB';if(n>=1024)return Math.round(n/1024)+' KB';return n+' B'}
  function yieldUi(){return new Promise(function(r){setTimeout(r,0)})}
  function state(){w.takLocalElevation=w.takLocalElevation||{loaded:false,loading:null,tiles:new Map(),meta:[]};if(!(w.takLocalElevation.tiles instanceof Map))w.takLocalElevation.tiles=new Map();return w.takLocalElevation}
  function uniqueTiles(){try{return Array.from((state().tiles||new Map()).values()).filter(function(v,i,a){return v&&v.id&&a.findIndex(function(x){return x&&x.id===v.id})===i})}catch(_){return []}}
  function localElevTileId(lat0,lon0){return 'geo|'+Math.floor(Number(lat0))+'|'+Math.floor(Number(lon0))}
  function addTileToState(tile){try{const st=state();if(!tile||!tile.id)return;st.tiles.set(tile.id,tile);if(Number.isFinite(Number(tile.lat0))&&Number.isFinite(Number(tile.lon0)))st.tiles.set(localElevTileId(tile.lat0,tile.lon0),tile);st.meta=uniqueTiles().map(function(t){return {id:t.id,name:t.name,type:t.type||t.sourceType||'Elevation',sourceType:t.sourceType||'',lat0:t.lat0,lon0:t.lon0,lat1:t.lat1,lon1:t.lon1,width:t.width||t.size,height:t.height||t.size,size:t.size||Math.max(Number(t.width)||0,Number(t.height)||0),bytes:t.bytes||0,imported:t.imported||0}});st.loaded=true;st.loading=null}catch(e){console.warn('v353 add elevation tile failed',e)}}
  function addCss(){try{if($('v353PopupElevationCss'))return;const st=d.createElement('style');st.id='v353PopupElevationCss';st.textContent=`
    #localElevationDialog .local-elev-progress-label{color:#dfe9ee!important;font-weight:850!important;}
    #localElevationDialog .local-elev-progress-label b{color:#ffb366!important;font-weight:950!important;}
    #localElevationDialog .local-elev-progress-label .step{color:#ff6f2e!important;font-weight:950!important;}
    #localElevationDialog .local-elev-progress-bar{transition:width .22s ease!important;}
  `;d.head.appendChild(st)}catch(e){console.warn('v353 css failed',e)}}
  function ensureCloseNote(){try{const body=q('#localElevationDialog .local-elev-body');if(!body)return;let note=$('localElevCloseImportNote');if(!note){note=d.createElement('div');note.id='localElevCloseImportNote';note.className='local-elev-close-note';body.appendChild(note)}note.textContent='You may close this window while elevation data continues importing. Keep this browser tab open until the import finishes.'}catch(_){}}
  function ensureProgress(){try{const body=q('#localElevationDialog .local-elev-body');if(!body)return null;let box=$('localElevProgress');if(!box){const status=$('localElevStatus');const html='<div id="localElevProgress" class="local-elev-progress"><div class="local-elev-progress-track"><div id="localElevProgressBar" class="local-elev-progress-bar"></div></div><div id="localElevProgressLabel" class="local-elev-progress-label">Ready.</div></div>';if(status)status.insertAdjacentHTML('beforebegin',html);else body.insertAdjacentHTML('beforeend',html);box=$('localElevProgress')}return box}catch(e){console.warn('v353 progress ensure failed',e);return null}}
  function setProgress(pct,label,active){try{const box=ensureProgress(),bar=$('localElevProgressBar'),lab=$('localElevProgressLabel');const p=Math.max(0,Math.min(100,Number(pct)||0));if(box)box.classList.toggle('active',active!==false);if(bar)bar.style.width=p+'%';if(lab)lab.innerHTML=label||''}catch(_){}}
  function setStageProgress(step,total,label,base,span){step=Math.max(0,Math.min(Number(total)||1,Number(step)||0));total=Math.max(1,Number(total)||1);base=Number(base)||0;span=Number(span)||100;const pct=base+span*(step/total);const shown=Math.round(Math.max(0,Math.min(100,pct)));setProgress(pct,'<span class="step">Step '+step+' of '+total+' · '+shown+'%</span><br><b>'+esc(label||'Working')+'</b>',true)}
  function setStatus(msg,isError){try{const el=$('localElevStatus');if(!el)return;el.textContent=msg||'';el.classList.toggle('error',!!isError);el.classList.toggle('ok',!isError&&!!msg)}catch(_){}}
  function setStatusHtml(html,isError){try{const el=$('localElevStatus');if(!el)return;el.innerHTML=html||'';el.classList.toggle('error',!!isError);el.classList.toggle('ok',!isError&&!!html)}catch(_){}}
  function setImportActive(on){try{w.__takLocalElevImportActive=!!on;d.body&&d.body.classList.toggle('tak-local-elev-importing',!!on);const imp=$('localElevImport');if(imp){imp.disabled=!!on;imp.textContent=on?'Importing…':'Import'}const choose=$('localElevChoose');if(choose)choose.disabled=!!on;ensureCloseNote()}catch(_){} }
  w._takLocalElevSetProgress=setProgress;
  async function openDb(){if(typeof w.openLocalElevDb==='function')return w.openLocalElevDb();return new Promise(function(resolve,reject){try{const req=indexedDB.open('takmapLocalElevationV1',1);req.onupgradeneeded=function(e){const db=e.target.result;if(!db.objectStoreNames.contains('tiles'))db.createObjectStore('tiles',{keyPath:'id'})};req.onsuccess=function(){resolve(req.result)};req.onerror=function(){reject(req.error||new Error('IndexedDB open failed'))}}catch(e){reject(e)}})}
  async function dbPutTile(tile){if(typeof w.localElevDbPut==='function')return w.localElevDbPut(tile);const db=await openDb();return new Promise(function(resolve,reject){try{const tx=db.transaction(['tiles'],'readwrite');tx.objectStore('tiles').put(tile);tx.oncomplete=function(){try{db.close()}catch(_){};resolve(true)};tx.onerror=function(){reject(tx.error||new Error('IndexedDB put failed'))}}catch(e){reject(e)}})}
  function fileSupported(name){return /\.(hgt|dt0|dt1|dt2|tif|tiff)$/i.test(String(name||''))}
  let baseHgt=null, baseDted=null, baseGeo=null;
  function rememberBaseImporters(){try{if(!baseHgt&&typeof w.importHgtFile==='function')baseHgt=w.importHgtFile;if(!baseDted&&typeof w.importDtedFile==='function')baseDted=w.importDtedFile;if(!baseGeo&&typeof w.importGeoTiffFile==='function'&&!w.importGeoTiffFile.__v353GeoTiffWorker)baseGeo=w.importGeoTiffFile}catch(_){}}
  function workerSource(){return `
self.onmessage=function(ev){const data=ev.data||{};if(data.cmd!=='import')return;importGeoTiff(data.file,data.name,data.size).catch(function(e){self.postMessage({type:'error',error:String(e&&e.message||e)})})};
function progress(step,label){self.postMessage({type:'progress',step:step,label:label})}
function tick(){return new Promise(function(r){setTimeout(r,0)})}
function noDataFromImage(image){try{const fd=image.fileDirectory||{};const raw=fd.GDAL_NODATA;const n=raw!=null?Number(String(raw).trim()):NaN;return Number.isFinite(n)?n:-999999}catch(_){return -999999}}
function hasSkewOrRotation(image){try{const m=image.fileDirectory&&image.fileDirectory.ModelTransformation;if(m&&m.length>=16){return Math.abs(Number(m[1])||0)>1e-12||Math.abs(Number(m[4])||0)>1e-12}}catch(_){}return false}
function isGeographicGeoTiff(image,geoKeys,bbox){try{const mt=geoKeys.ModelTypeGeoKey;const xok=bbox&&bbox[0]>=-180.5&&bbox[2]<=180.5;const yok=bbox&&bbox[1]>=-90.5&&bbox[3]<=90.5;if(mt===2||mt==='ModelTypeGeographic')return true;const g=geoKeys.GeographicTypeGeoKey||geoKeys.GeodeticCRSGeoKey;const unit=geoKeys.GeogAngularUnitsGeoKey;if((g||unit)&&xok&&yok)return true;return xok&&yok&&!(geoKeys.ProjectedCSTypeGeoKey||geoKeys.ProjectedCRSGeoKey)}catch(_){return false}}
function geoKeysToProjString(geoKeys){try{if(self.geokeysToProj4&&typeof self.geokeysToProj4.toProj4==='function'){const obj=self.geokeysToProj4.toProj4(geoKeys||{});if(obj&&obj.errors&&Object.keys(obj.errors).some(function(k){return obj.errors[k]}))throw new Error('unsupported GeoTIFF CRS geokeys');if(obj&&obj.shouldConvertCoordinates)throw new Error('GeoTIFF CRS coordinate-unit conversion is not supported offline yet');if(obj&&obj.proj4)return obj.proj4}}catch(e){throw e}return ''}
function bbox4326FromSource(tile){if(tile.crsMode==='geographic')return [Number(tile.yMin),Number(tile.xMin),Number(tile.yMax),Number(tile.xMax)];if(tile.crsMode==='projected'&&tile.proj4String&&self.proj4){const p=self.proj4(tile.proj4String,'EPSG:4326');const corners=[[tile.xMin,tile.yMin],[tile.xMin,tile.yMax],[tile.xMax,tile.yMin],[tile.xMax,tile.yMax]].map(function(c){return p.forward(c)});const lons=corners.map(function(c){return Number(c[0])}).filter(Number.isFinite),lats=corners.map(function(c){return Number(c[1])}).filter(Number.isFinite);if(lats.length===4&&lons.length===4)return [Math.min.apply(Math,lats),Math.min.apply(Math,lons),Math.max.apply(Math,lats),Math.max.apply(Math,lons)]}throw new Error('could not derive WGS84 bounds from GeoTIFF CRS')}
async function loadLibs(){progress(2,'Loading GeoTIFF worker libraries');try{if(!self.GeoTIFF)importScripts('/assets/vendor/geotiff.js');if(!self.proj4)importScripts('/assets/vendor/proj4.js');try{if(!self.geokeysToProj4)importScripts('/assets/vendor/geotiff-geokeys-to-proj4.js')}catch(_){}}catch(e){throw new Error('Could not load GeoTIFF worker libraries: '+(e&&e.message||e))}if(!self.GeoTIFF)throw new Error('GeoTIFF library unavailable in worker');if(!self.proj4)throw new Error('proj4 library unavailable in worker')}
async function importGeoTiff(file,name,size){progress(1,'Preparing GeoTIFF/COG');await loadLibs();progress(3,'Opening GeoTIFF/COG: '+name);await tick();let tiff;if(self.GeoTIFF.fromBlob&&file){tiff=await self.GeoTIFF.fromBlob(file)}else{const buf=await file.arrayBuffer();tiff=await self.GeoTIFF.fromArrayBuffer(buf)}progress(4,'Reading GeoTIFF metadata: '+name);await tick();const image=await tiff.getImage();const width=image.getWidth(),height=image.getHeight();if(!(width>1&&height>1))throw new Error('GeoTIFF has invalid raster dimensions');if(image.getSamplesPerPixel&&image.getSamplesPerPixel()>1)throw new Error('multi-band GeoTIFF appears to be imagery; use DEM/elevation GeoTIFF only');if(hasSkewOrRotation(image))throw new Error('rotated/skewed GeoTIFF transforms are not supported');const geoKeys=image.getGeoKeys?image.getGeoKeys():{};let bbox=image.getBoundingBox?image.getBoundingBox():null;if(!bbox||bbox.length<4||!bbox.every(function(v){return Number.isFinite(Number(v))}))throw new Error('GeoTIFF is missing readable georeferenced bounds');bbox=bbox.map(Number);let crsMode='geographic',proj4String='';if(isGeographicGeoTiff(image,geoKeys,bbox)){crsMode='geographic'}else{proj4String=geoKeysToProjString(geoKeys);if(!proj4String)throw new Error('unsupported GeoTIFF CRS/projection. Use USGS 3DEP DEM GeoTIFFs with readable geographic/projected CRS metadata.');crsMode='projected'}const noData=noDataFromImage(image);progress(5,'Reading elevation raster band: '+width+'×'+height+' cells');await tick();const ras=await image.readRasters({samples:[0],interleave:true});const src=Array.isArray(ras)?ras[0]:ras;if(!src||!src.length)throw new Error('GeoTIFF elevation band could not be read');progress(6,'Converting elevation cells: '+Number(src.length).toLocaleString()+' samples');await tick();let vals;if(src instanceof Float32Array&&src.byteOffset===0&&src.byteLength===src.buffer.byteLength){vals=src}else{vals=new Float32Array(src.length);for(let i=0;i<src.length;i++){vals[i]=Number(src[i]);if(i&&i%2500000===0)await tick()}}progress(7,'Validating elevation cells');for(let i=0;i<vals.length;i++){if(!Number.isFinite(vals[i]))vals[i]=NaN;if(i&&i%3000000===0)await tick()}progress(8,'Deriving WGS84 coverage bounds');const tile={id:'geotiff|'+String(name||'').toLowerCase()+'|'+width+'x'+height+'|'+Date.now(),type:'USGS 3DEP GeoTIFF/COG DEM',sourceType:'geotiff',name:name,width:width,height:height,size:Math.max(width,height),buffer:vals.buffer,noData:noData,bytes:size||0,imported:Date.now(),crsMode:crsMode,proj4String:proj4String,xMin:bbox[0],yMin:bbox[1],xMax:bbox[2],yMax:bbox[3]};const b4326=bbox4326FromSource(tile);tile.lat0=b4326[0];tile.lon0=b4326[1];tile.lat1=b4326[2];tile.lon1=b4326[3];if(!(tile.lat0>=-90.5&&tile.lat1<=90.5&&tile.lon0>=-180.5&&tile.lon1<=180.5))throw new Error('GeoTIFF bounds are outside valid WGS84 coordinates');self.postMessage({type:'done',tile:tile},[tile.buffer])}
`;}
  function newWorker(){const blob=new Blob([workerSource()],{type:'text/javascript'});return new Worker(URL.createObjectURL(blob))}
  async function importGeoTiffFileWorker(file,base,span){
    if(file.size>HARD_MB*MB)throw new Error('file is over 1 GB; browser-side GeoTIFF import rejected');
    if(file.size>CONFIRM_MB*MB){setStageProgress(1,10,'Waiting for large-file confirmation: '+file.name+' ('+bytes(file.size)+')',base,span);if(!confirm(file.name+' is '+Math.round(file.size/MB)+' MB. Importing large DEMs can be slow. Continue?'))throw new Error('user canceled large GeoTIFF import')}
    else if(file.size>WARN_MB*MB){setStageProgress(1,10,'Large file warning: '+file.name+' is '+bytes(file.size)+'. Import may take time.',base,span);await yieldUi()}
    return new Promise(function(resolve,reject){let worker,done=false;try{worker=newWorker()}catch(e){reject(e);return}
      const cleanup=function(){try{worker&&worker.terminate()}catch(_){}};
      const timer=setTimeout(function(){if(!done){done=true;cleanup();reject(new Error('GeoTIFF worker timed out'))}},45*60*1000);
      worker.onmessage=function(ev){const m=ev.data||{};try{if(m.type==='progress'){setStageProgress(m.step||1,10,m.label||'Importing GeoTIFF',base,span)}else if(m.type==='done'){done=true;clearTimeout(timer);cleanup();const tile=m.tile;if(!tile||!tile.buffer)throw new Error('GeoTIFF worker returned no elevation buffer');setStageProgress(9,10,'Saving elevation index to local browser storage: '+file.name,base,span);dbPutTile(tile).then(function(){addTileToState(tile);setStageProgress(10,10,'Finalizing local elevation index: '+file.name,base,span);resolve(tile)},reject)}else if(m.type==='error'){done=true;clearTimeout(timer);cleanup();reject(new Error(m.error||'GeoTIFF worker failed'))}}catch(e){done=true;clearTimeout(timer);cleanup();reject(e)}};
      worker.onerror=function(e){if(done)return;done=true;clearTimeout(timer);cleanup();reject(new Error((e&&e.message)||'GeoTIFF worker error'))};
      try{worker.postMessage({cmd:'import',file:file,name:file.name,size:file.size})}catch(e){done=true;clearTimeout(timer);cleanup();reject(e)}
