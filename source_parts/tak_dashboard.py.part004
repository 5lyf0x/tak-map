        _html = _v350_versions(_html)
        runtime = r'''
<script id="v350ViewshedThemeRepairPatch">
(function(){
  'use strict';
  const V='v350', d=document, w=window;
  function $(id){try{return d.getElementById(id)}catch(_){return null}}
  function q(s,r){try{return (r||d).querySelector(s)}catch(_){return null}}
  function qa(s,r){try{return Array.from((r||d).querySelectorAll(s))}catch(_){return []}}
  function setVersion(){try{qa('.iteration-chip,.iteration-marker').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  function addCss(){try{if($('v350ViewshedThemeRepairCss'))return;const st=d.createElement('style');st.id='v350ViewshedThemeRepairCss';st.textContent=`
    #viewshedModule.viewshed-module,#viewshedModule.viewshed-panel,#viewshedModule{
      width:318px!important;max-width:calc(100vw - 24px)!important;min-width:286px!important;
      box-sizing:border-box!important;overflow:hidden!important;color:#e9f0f5!important;
      border:1px solid rgba(255,111,46,.28)!important;border-radius:16px!important;
      background:linear-gradient(180deg,rgba(15,25,34,.97),rgba(7,12,17,.97))!important;
      box-shadow:0 20px 54px rgba(0,0,0,.58),inset 0 1px 0 rgba(255,255,255,.07),0 0 0 1px rgba(255,111,46,.08)!important;
      backdrop-filter:blur(16px)!important;-webkit-backdrop-filter:blur(16px)!important;
      font:700 12px/1.22 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important;
    }
    #viewshedModule.active,#viewshedModule.open{display:block!important;visibility:visible!important;opacity:1!important;}
    #viewshedModule *,#viewshedModule *::before,#viewshedModule *::after{box-sizing:border-box!important;}
    #viewshedModule .viewshed-head{
      display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important;
      min-height:43px!important;padding:8px 10px!important;border-bottom:1px solid rgba(255,111,46,.18)!important;
      background:linear-gradient(180deg,rgba(255,111,46,.12),rgba(255,255,255,.035) 55%,rgba(0,0,0,0))!important;
      cursor:grab!important;user-select:none!important;
    }
    #viewshedModule .viewshed-head.dragging{cursor:grabbing!important;}
    #viewshedModule .viewshed-title,#viewshedModule h2.viewshed-title{
      display:flex!important;align-items:center!important;gap:8px!important;min-width:0!important;margin:0!important;padding:0!important;
      color:#fff!important;font-size:13px!important;line-height:1!important;font-weight:950!important;letter-spacing:.08em!important;text-transform:uppercase!important;
      text-shadow:0 0 10px rgba(255,111,46,.20)!important;
    }
    #viewshedModule .viewshed-glyph{
      width:26px!important;height:26px!important;min-width:26px!important;max-width:26px!important;min-height:26px!important;max-height:26px!important;
      display:grid!important;place-items:center!important;overflow:hidden!important;border:1px solid rgba(255,111,46,.42)!important;border-radius:9px!important;
      color:#ffd6ca!important;background:linear-gradient(180deg,rgba(255,111,46,.23),rgba(255,111,46,.08))!important;
      box-shadow:inset 0 1px 0 rgba(255,255,255,.09),0 0 14px rgba(255,111,46,.14)!important;
    }
    #viewshedModule .viewshed-glyph svg,#viewshedModule .viewshed-option-c-icon{
      width:18px!important;height:18px!important;max-width:18px!important;max-height:18px!important;display:block!important;flex:0 0 18px!important;
      fill:none!important;stroke:currentColor!important;overflow:visible!important;
    }
    #viewshedModule .viewshed-option-c-icon path{fill:none!important;stroke:currentColor!important;stroke-width:1.8!important;stroke-linecap:round!important;stroke-linejoin:round!important;}
    #viewshedModule .viewshed-option-c-icon path:nth-child(n+3){stroke:#ffb29d!important;}
    #viewshedModule .viewshed-head-actions{display:flex!important;align-items:center!important;gap:6px!important;}
    #viewshedModule .viewshed-ghost,#viewshedModule button.viewshed-ghost{
      width:25px!important;height:25px!important;min-width:25px!important;min-height:25px!important;padding:0!important;border-radius:9px!important;
      display:grid!important;place-items:center!important;border:1px solid rgba(160,185,198,.24)!important;
      background:linear-gradient(180deg,rgba(42,58,70,.92),rgba(20,31,41,.92))!important;color:#cbd8df!important;
      font-size:13px!important;font-weight:950!important;line-height:1!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.07)!important;
    }
    #viewshedModule .viewshed-ghost:hover{border-color:rgba(255,111,46,.62)!important;color:#fff!important;background:linear-gradient(180deg,rgba(255,111,46,.28),rgba(34,44,52,.96))!important;}
    #viewshedModule .viewshed-body{
      padding:9px 10px 10px!important;max-height:calc(100vh - 118px)!important;overflow-y:auto!important;overflow-x:hidden!important;
      scrollbar-width:thin!important;scrollbar-color:rgba(255,111,46,.62) rgba(255,255,255,.04)!important;
    }
    #viewshedModule .viewshed-tabs{display:flex!important;align-items:center!important;gap:6px!important;margin:0 0 8px!important;overflow:hidden!important;}
    #viewshedModule .viewshed-tab{
      display:flex!important;align-items:center!important;justify-content:center!important;min-height:26px!important;max-width:92px!important;min-width:0!important;
      padding:5px 8px!important;border:1px solid rgba(160,185,198,.19)!important;border-radius:10px!important;
      background:rgba(255,255,255,.045)!important;color:#cbd9dd!important;font-size:11px!important;font-weight:900!important;line-height:1!important;
      white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;cursor:pointer!important;
    }
    #viewshedModule .viewshed-tab.active{border-color:rgba(255,111,46,.55)!important;background:rgba(255,111,46,.16)!important;color:#fff!important;box-shadow:0 0 12px rgba(255,111,46,.12)!important;}
    #viewshedModule .viewshed-tab.add{flex:0 0 28px!important;font-size:16px!important;padding:0!important;}
    #viewshedModule .viewshed-tab input{width:70px!important;height:20px!important;min-height:20px!important;border:0!important;background:transparent!important;color:#fff!important;padding:0!important;margin:0!important;font-size:11px!important;font-weight:900!important;outline:none!important;}
    #viewshedModule .viewshed-section{
      display:block!important;margin:0 0 8px!important;padding:8px!important;border-radius:13px!important;
      border:1px solid rgba(160,185,198,.14)!important;background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.020))!important;
      box-shadow:inset 0 1px 0 rgba(255,255,255,.035)!important;
    }
    #viewshedModule .viewshed-section-title{
      display:block!important;margin:0 0 7px!important;color:#ffb29d!important;font-size:10px!important;line-height:1!important;
      font-weight:950!important;text-transform:uppercase!important;letter-spacing:.09em!important;
    }
    #viewshedModule .viewshed-row{display:flex!important;align-items:center!important;gap:6px!important;width:100%!important;min-width:0!important;margin:0 0 7px!important;padding:0!important;border:0!important;}
    #viewshedModule .viewshed-row:last-child{margin-bottom:0!important;}
    #viewshedModule .viewshed-row label{flex:0 0 50px!important;min-width:50px!important;max-width:50px!important;margin:0!important;color:#b9cbd1!important;font-size:12px!important;font-weight:850!important;line-height:1.1!important;}
    #viewshedModule .viewshed-elevation-source-row label,#viewshedModule .viewshed-acceleration-row label{flex-basis:42px!important;min-width:42px!important;max-width:42px!important;}
    #viewshedModule .viewshed-input,#viewshedModule .viewshed-select,#viewshedModule input.viewshed-input,#viewshedModule select.viewshed-select{
      height:31px!important;min-height:31px!important;max-height:31px!important;min-width:0!important;margin:0!important;padding:5px 8px!important;
      border:1px solid rgba(160,185,198,.24)!important;border-radius:10px!important;background:#091018!important;color:#e7f0f3!important;
      font-size:12px!important;font-weight:780!important;line-height:1!important;outline:none!important;box-shadow:inset 0 1px 2px rgba(0,0,0,.32)!important;
    }
    #viewshedModule .viewshed-input:focus,#viewshedModule .viewshed-select:focus{border-color:rgba(255,111,46,.62)!important;box-shadow:0 0 0 2px rgba(255,111,46,.14),inset 0 1px 2px rgba(0,0,0,.32)!important;}
    #viewshedModule .viewshed-input{flex:1 1 auto!important;}
    #viewshedModule .viewshed-input.short{width:100%!important;flex:1 1 auto!important;}
    #viewshedModule .viewshed-select{flex:0 0 56px!important;width:56px!important;}
    #viewshedModule .viewshed-select.quality,#viewshedModule .viewshed-select.source{flex:1 1 auto!important;width:auto!important;}
    #viewshedModule input[type=number]::-webkit-inner-spin-button,#viewshedModule input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none!important;margin:0!important;}
    #viewshedModule input[type=number]{appearance:textfield!important;-moz-appearance:textfield!important;}
    #viewshedModule .viewshed-btn-row{display:flex!important;align-items:center!important;gap:7px!important;margin:8px 0 0!important;}
    #viewshedModule .viewshed-btn-row .viewshed-btn{flex:1 1 0!important;}
    #viewshedModule .viewshed-btn,#viewshedModule button.viewshed-btn{
      height:27px!important;min-height:27px!important;width:auto!important;padding:0 9px!important;border-radius:999px!important;
      border:1px solid rgba(255,111,46,.42)!important;background:linear-gradient(180deg,rgba(255,111,46,.25),rgba(255,111,46,.10))!important;
      color:#fff!important;font-size:11px!important;font-weight:950!important;letter-spacing:.01em!important;line-height:1!important;white-space:nowrap!important;
      box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 0 10px rgba(255,111,46,.10)!important;cursor:pointer!important;
    }
    #viewshedModule .viewshed-btn.alt,#viewshedModule button.viewshed-btn.alt,#viewshedClearAll{
      border-color:rgba(160,185,198,.24)!important;background:linear-gradient(180deg,rgba(42,58,70,.88),rgba(20,31,41,.88))!important;color:#dce8ee!important;
    }
    #viewshedModule .viewshed-btn:hover,#viewshedModule button.viewshed-btn:hover,#viewshedClearAll:hover{border-color:rgba(255,111,46,.74)!important;color:#fff!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.09),0 0 14px rgba(255,111,46,.18)!important;}
    #viewshedClearAll{display:block!important;width:100%!important;margin:7px 0 0!important;}
    #viewshedModule .viewshed-color{
      flex:0 0 36px!important;width:36px!important;height:27px!important;min-width:36px!important;min-height:27px!important;padding:2px!important;border-radius:9px!important;
      border:1px solid rgba(160,185,198,.28)!important;background:#091018!important;box-shadow:inset 0 0 0 1px rgba(0,0,0,.18)!important;
    }
    #viewshedModule .viewshed-range{appearance:none!important;-webkit-appearance:none!important;flex:1 1 auto!important;height:5px!important;min-height:5px!important;border:0!important;border-radius:999px!important;padding:0!important;background:linear-gradient(90deg,rgba(255,255,255,.20),var(--accent,#ff6f2e))!important;}
    #viewshedModule .viewshed-range.visible{background:linear-gradient(90deg,rgba(255,255,255,.16),rgba(70,209,108,.95))!important;}
    #viewshedModule .viewshed-range.blocked{background:linear-gradient(90deg,rgba(255,255,255,.16),rgba(239,81,77,.95))!important;}
    #viewshedModule .viewshed-range::-webkit-slider-thumb{appearance:none!important;-webkit-appearance:none!important;width:15px!important;height:15px!important;border-radius:50%!important;border:2px solid #091018!important;background:#ff6f2e!important;box-shadow:0 0 0 1px rgba(255,255,255,.82),0 0 12px rgba(255,111,46,.42)!important;}
    #viewshedModule .viewshed-cache-row{display:flex!important;align-items:center!important;gap:7px!important;margin:8px 0 0!important;color:#b8c8cf!important;font-size:11px!important;font-weight:800!important;line-height:1.25!important;}
    #viewshedModule .viewshed-cache-row input{width:14px!important;height:14px!important;min-height:14px!important;accent-color:#ff6f2e!important;margin:0!important;}
    #viewshedModule .viewshed-status,#viewshedStatus{margin:8px 0 0!important;min-height:16px!important;color:#7f949d!important;font-size:11px!important;font-weight:750!important;line-height:1.35!important;overflow-wrap:anywhere!important;}
    #viewshedModule .viewshed-stepper{display:grid!important;grid-template-columns:minmax(0,1fr) 26px!important;align-items:stretch!important;flex:1 1 auto!important;min-width:86px!important;height:31px!important;border-radius:10px!important;overflow:hidden!important;background:#091018!important;border:1px solid rgba(160,185,198,.24)!important;box-shadow:inset 0 1px 2px rgba(0,0,0,.32)!important;}
    #viewshedModule .viewshed-stepper input.viewshed-input{grid-column:1!important;width:100%!important;height:31px!important;min-height:31px!important;border:0!important;border-radius:10px 0 0 10px!important;background:transparent!important;box-shadow:none!important;padding:5px 7px!important;}
    #viewshedModule .viewshed-stepper .adsb-stepper-buttons{grid-column:2!important;display:grid!important;grid-template-rows:1fr 1fr!important;width:26px!important;height:31px!important;border-left:1px solid rgba(255,111,46,.28)!important;background:linear-gradient(180deg,rgba(255,111,46,.10),rgba(255,111,46,.035))!important;}
    #viewshedModule .viewshed-stepper .adsb-stepper-buttons button,#viewshedModule .viewshed-stepper button.tak-stepper-btn{
      width:26px!important;height:15.5px!important;min-width:26px!important;min-height:0!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;
      display:grid!important;place-items:center!important;background:transparent!important;color:#ffb29d!important;font-size:8px!important;font-weight:1000!important;line-height:1!important;
      text-shadow:0 0 7px rgba(255,111,46,.45)!important;box-shadow:none!important;cursor:pointer!important;
    }
    #viewshedModule .viewshed-stepper .adsb-stepper-buttons button + button{border-top:1px solid rgba(255,111,46,.20)!important;}
    #viewshedModule .viewshed-stepper .adsb-stepper-buttons button:hover,#viewshedModule .viewshed-stepper button.tak-stepper-btn:hover{background:rgba(255,111,46,.22)!important;color:#fff!important;}
    #viewshedModule .viewshed-stepper:focus-within{border-color:rgba(255,111,46,.62)!important;box-shadow:0 0 0 2px rgba(255,111,46,.14),inset 0 1px 2px rgba(0,0,0,.32)!important;}
    #viewshedModule .viewshed-stepper + .viewshed-select{flex:0 0 56px!important;}
    #viewshedMinimized.viewshed-minimized{border:1px solid rgba(255,111,46,.30)!important;background:linear-gradient(180deg,rgba(15,25,34,.96),rgba(7,12,17,.96))!important;color:#fff!important;box-shadow:0 14px 36px rgba(0,0,0,.45),0 0 18px rgba(255,111,46,.14)!important;}
    #toolViewshed.active,#toolViewshed.open,#toolViewshed[aria-pressed="true"]{border-color:rgba(255,111,46,.96)!important;background:linear-gradient(180deg,rgba(255,111,46,.38),rgba(255,111,46,.16))!important;color:#fff!important;box-shadow:0 0 0 1px rgba(255,111,46,.32),0 0 18px rgba(255,111,46,.44)!important;text-shadow:0 0 8px rgba(255,111,46,.42)!important;}
    @media(max-width:760px){#viewshedModule{width:min(318px,calc(100vw - 24px))!important;min-width:0!important;}#viewshedModule .viewshed-body{max-height:calc(100vh - 96px)!important;}#viewshedModule .viewshed-row label{flex-basis:48px!important;min-width:48px!important;max-width:48px!important;}}
  `;d.head.appendChild(st)}catch(e){try{console.warn('v350 viewshed CSS failed',e)}catch(_){}}}
  function ensureStepper(id){try{const input=$(id);if(!input)return false;let wrap=input.closest('.viewshed-stepper');if(!wrap){wrap=d.createElement('span');wrap.className='adsb-stepper unified-stepper viewshed-stepper';input.parentNode.insertBefore(wrap,input);wrap.appendChild(input);}wrap.classList.add('adsb-stepper','unified-stepper','viewshed-stepper');let buttons=q('.adsb-stepper-buttons',wrap);if(!buttons){buttons=d.createElement('span');buttons.className='adsb-stepper-buttons';wrap.appendChild(buttons);}if(buttons.children.length<2||!q('[data-step-delta="1"]',buttons)||!q('[data-step-delta="-1"]',buttons)){buttons.innerHTML='<button type="button" class="tak-stepper-btn tak-stepper-up" data-step-field="'+id+'" data-step-delta="1" aria-label="Increase">▲</button><button type="button" class="tak-stepper-btn tak-stepper-down" data-step-field="'+id+'" data-step-delta="-1" aria-label="Decrease">▼</button>';}
    qa('button',buttons).forEach(function(btn){btn.classList.add('tak-stepper-btn');btn.type='button';if(!btn.dataset.stepField)btn.dataset.stepField=id;if(!btn.dataset.v350Bound){btn.dataset.v350Bound='1';btn.addEventListener('click',function(ev){try{ev.preventDefault();ev.stopPropagation();try{ev.stopImmediatePropagation()}catch(__){}const field=$(btn.dataset.stepField||id);if(!field)return;const delta=Number(btn.dataset.stepDelta||'0')||0;const step=Number(field.step||((field.id==='viewshedRadius')?'0.1':'1'))||1;const min=field.min!==''?Number(field.min):null;const max=field.max!==''?Number(field.max):null;let val=Number(field.value);if(!Number.isFinite(val))val=Number(field.getAttribute('value')||0)||0;val=val+(delta*step);if(min!=null&&Number.isFinite(min))val=Math.max(min,val);if(max!=null&&Number.isFinite(max))val=Math.min(max,val);const decimals=(String(step).split('.')[1]||'').length;field.value=decimals?val.toFixed(decimals):String(Math.round(val));field.dispatchEvent(new Event('input',{bubbles:true}));field.dispatchEvent(new Event('change',{bubbles:true}));}catch(e){try{console.warn('v350 viewshed stepper failed',e)}catch(_){}}},true);}});return true;}catch(e){try{console.warn('v350 ensure stepper failed',e)}catch(_){}return false}}
  function themeViewshed(){try{addCss();setVersion();ensureStepper('viewshedHeight');ensureStepper('viewshedRadius');const m=$('viewshedModule');if(m){m.classList.add('v350-themed');const body=q('.viewshed-body',m);if(body){const head=q('.viewshed-head',m);const headH=head?Math.ceil(head.getBoundingClientRect().height||43):43;body.style.maxHeight=Math.max(180,(w.innerHeight||720)-headH-24)+'px';body.style.overflowY='auto';}qa('button',m).forEach(function(b){if(b.closest('.adsb-stepper-buttons'))return;if(b.id==='viewshedHideBtn'||b.id==='viewshedCloseBtn')b.classList.add('viewshed-ghost');else b.classList.add('viewshed-btn');});qa('select',m).forEach(function(s){s.classList.add('viewshed-select')});qa('input',m).forEach(function(inp){if(inp.type==='color')inp.classList.add('viewshed-color');else if(inp.type==='range')inp.classList.add('viewshed-range');else if(inp.type!=='checkbox')inp.classList.add('viewshed-input')});}}
    catch(e){try{console.warn('v350 viewshed theme failed',e)}catch(_){}}}
  function wrapOpen(){try{const old=w.toggleViewshedModule;if(typeof old==='function'&&!old.__v350ViewshedTheme){const fn=function(){const r=old.apply(this,arguments);setTimeout(themeViewshed,0);setTimeout(themeViewshed,120);setTimeout(themeViewshed,360);return r};fn.__v350ViewshedTheme=true;w.toggleViewshedModule=fn;}const oldOpen=w.openTakMapViewshed;if(typeof oldOpen==='function'&&!oldOpen.__v350ViewshedTheme){const ofn=function(){const r=oldOpen.apply(this,arguments);setTimeout(themeViewshed,0);setTimeout(themeViewshed,120);setTimeout(themeViewshed,360);return r};ofn.__v350ViewshedTheme=true;w.openTakMapViewshed=ofn;}}
