    .adsb-track-distance-label{background:rgba(7,11,16,.94)!important;border:1px solid rgba(255,111,46,.82)!important;border-radius:999px!important;color:#ffe4d4!important;box-shadow:0 6px 18px rgba(0,0,0,.38),0 0 14px rgba(255,111,46,.22)!important;font-size:11px!important;font-weight:900!important;letter-spacing:.02em!important;line-height:1!important;padding:3px 7px!important;white-space:nowrap!important;}
    .adsb-track-save-overlay{position:fixed;inset:0;z-index:3800;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.38);backdrop-filter:blur(3px)}
    .adsb-track-save-card{position:relative;width:min(420px,calc(100vw - 28px));border:1px solid rgba(255,122,26,.42);border-radius:14px;background:linear-gradient(180deg,rgba(18,27,35,.98),rgba(8,12,18,.98));box-shadow:0 18px 50px rgba(0,0,0,.60),0 0 22px rgba(255,122,26,.13);padding:13px 14px 12px;color:#eef5f7}.adsb-track-save-x{position:absolute;right:8px;top:7px;width:28px;height:28px;border-radius:9px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);color:#c9d7de;font-size:18px;font-weight:900}.adsb-track-save-title{font-size:.92rem;font-weight:950;letter-spacing:.08em;text-transform:uppercase;color:#fff;padding-right:34px}.adsb-track-save-sub{margin-top:4px;color:#9fb0ba;font-size:.78rem;font-weight:750}.adsb-track-save-input{width:100%;box-sizing:border-box;margin:10px 0 7px;padding:8px 9px;border-radius:9px;border:1px solid rgba(255,255,255,.14);background:rgba(0,0,0,.28);color:#eef5f7;font-weight:750}.adsb-track-save-error,.adsb-track-save-msg.bad{color:#ff9b8a;font-size:.76rem;font-weight:850}.adsb-track-save-msg{min-height:16px;color:#8ff0b6;font-size:.76rem;font-weight:850}.adsb-track-save-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
  `;document.head.appendChild(st)}
  function syncButtons(){try{const id=String(S.id||'').toLowerCase();qa('.adsb-track-btn').forEach(b=>{const bid=String((b.dataset&&b.dataset.adsbTrackId)||b.getAttribute('data-adsb-track-id')||'').toLowerCase();const on=!!id&&bid===id;b.classList.toggle('v307-active',on);b.classList.toggle('active',on);b.classList.toggle('tracking',on);b.dataset.adsbTracking=on?'1':'0';const dot=q('.adsb-track-light',b);if(dot)dot.classList.toggle('active',on);const txt=q('.adsb-track-text',b);if(txt)txt.textContent=on?'Untrack':'Track';})}catch(_){}}
  function redraw(){const layers=ensureLayers();if(!layers)return;try{layers.track.clearLayers();layers.label.clearLayers()}catch(_){}const pts=S.points||[];const ll=pts.map(p=>[p.lat,p.lon]);if(ll.length>=2){try{S.line=L.polyline(ll,{color:'#ff3b30',weight:4,opacity:.98,lineCap:'round',lineJoin:'round',interactive:false}).addTo(layers.track);S.line.bringToFront&&S.line.bringToFront()}catch(e){console.warn('v307 ADS-B track line failed',e)}}if(ll.length>=1){try{const txt=distText(distMeters(pts));S.label=L.marker(ll[ll.length-1],{interactive:false,zIndexOffset:1900,icon:L.divIcon({className:'adsb-track-distance-label-wrap',html:'<div class="adsb-track-distance-label">'+esc(txt)+'</div>',iconAnchor:[0,0]})}).addTo(layers.label)}catch(e){console.warn('v307 ADS-B track label failed',e)}}syncButtons()}
  function addPoint(a){if(!a||!S.id||idOf(a)!==S.id)return false;const lat=Number(a.lat),lon=Number(a.lon);if(!Number.isFinite(lat)||!Number.isFinite(lon))return false;const pts=S.points||(S.points=[]);const last=pts[pts.length-1],now=Date.now();if(last){let d=999;try{d=L.latLng(last.lat,last.lon).distanceTo(L.latLng(lat,lon))}catch(_){}if(d<2&&(now-(last.t||0))<2500){S.meta=a;redraw();return true}}pts.push({lat,lon,alt:Number(a.altitude_ft||a.alt_baro||a.alt_geom)||0,t:now});if(pts.length>3000)pts.splice(0,pts.length-3000);S.meta=a;redraw();return true}
  function updateFrom(items){try{const arr=Array.isArray(items)?items:(window.lastAircraft||[]);if(Array.isArray(arr))window.__v307LastAircraft=arr;if(!S.id)return;const a=findAircraft(S.id)||(Array.isArray(arr)?arr.find(x=>idOf(x)===S.id):null);if(a)addPoint(a);else syncButtons()}catch(e){console.warn('v307 ADS-B track update failed',e)}}
  function clearVisual(){try{if(S.trackLayer)S.trackLayer.clearLayers();if(S.labelLayer)S.labelLayer.clearLayers()}catch(_){}S.line=null;S.label=null}
  function dialog(id,meta,pts){try{const old=q('#adsbTrackSaveDialog');if(old)old.remove();pts=(pts||[]).slice();const title=titleOf(meta,id);const meters=distMeters(pts);const stamp=new Date().toISOString().slice(0,19).replace(/[T:]/g,'-');const def=(title+' ADS-B Track '+stamp).replace(/[^A-Za-z0-9_. -]+/g,'_').trim();const can=pts.length>=2;const div=document.createElement('div');div.id='adsbTrackSaveDialog';div.className='adsb-track-save-overlay';div.innerHTML='<div class="adsb-track-save-card" role="dialog" aria-modal="true"><button type="button" class="adsb-track-save-x" data-act="discard">×</button><div class="adsb-track-save-title">Save ADS-B Track</div><div class="adsb-track-save-sub">'+esc(title)+' · '+esc(distText(meters))+' · '+esc(String(pts.length))+' pts</div><input id="adsbTrackRouteName" class="adsb-track-save-input" value="'+esc(def)+'" '+(can?'':'disabled')+'>'+(can?'':'<div class="adsb-track-save-error">At least 2 track points are required to save a route.</div>')+'<div id="adsbTrackSaveMsg" class="adsb-track-save-msg"></div><div class="adsb-track-save-actions"><button type="button" class="layer-button" data-act="discard">Discard</button><button type="button" class="layer-button primary" data-act="save" '+(can?'':'disabled')+'>Save</button></div></div>';document.body.appendChild(div);const msg=q('#adsbTrackSaveMsg');div.addEventListener('click',async function(ev){const act=ev.target&&ev.target.getAttribute&&ev.target.getAttribute('data-act');if(act==='discard'||ev.target===div){ev.preventDefault();div.remove();clearVisual();return}if(act==='save'&&can){ev.preventDefault();try{if(msg)msg.textContent='Saving…';const name=String((q('#adsbTrackRouteName')||{}).value||def).replace(/[^A-Za-z0-9_. -]+/g,'_').trim()||def;const fc={type:'FeatureCollection',features:[{type:'Feature',geometry:{type:'LineString',coordinates:pts.map(p=>[p.lon,p.lat,p.alt||0])},properties:{name,kind:'route',geometry:'route',source:'TAK Map ADS-B',route_type:'adsb_aircraft_track',point_count:pts.length,distance_miles:Number((meters/1609.344).toFixed(3)),distance_km:Number((meters/1000).toFixed(3)),distance_text:distText(meters)}}]};const file=new File([new Blob([JSON.stringify(fc,null,2)],{type:'application/geo+json'})],name+'.geojson',{type:'application/geo+json'});const fd=new FormData();fd.append('files',file,file.name);const r=await fetch('/api/tak-map/import',{method:'POST',body:fd,cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);try{if(typeof refreshLocalData==='function')await refreshLocalData()}catch(_){}try{if(typeof drawImportedObjects==='function')drawImportedObjects()}catch(_){}if(msg)msg.textContent='Saved to Local Data → Routes';setTimeout(()=>{div.remove();clearVisual()},500)}catch(e){if(msg){msg.textContent='Save failed: '+String(e&&e.message||e);msg.classList.add('bad')}}}});setTimeout(()=>{try{(q('#adsbTrackRouteName')||q('[data-act="discard"]',div)).focus()}catch(_){}},30)}catch(e){console.warn('v307 ADS-B save dialog failed',e);clearVisual()}}
  function start(id){id=String(id||'').trim().toLowerCase();if(!id)return false;if(S.id&&S.id!==id)stop(false);S.id=id;S.points=[];S.meta=null;clearVisual();addPoint(findAircraft(id));syncButtons();return true}
  function stop(show=true){const id=S.id,meta=S.meta||findAircraft(id),pts=(S.points||[]).slice();S.id=null;S.meta=null;S.points=[];syncButtons();if(show)dialog(id,meta,pts);else clearVisual();return false}
  function toggle(id){id=String(id||'').trim().toLowerCase();if(!id)return false;return S.id===id?stop(true):start(id)}
  function handleButton(ev,btn,source){const now=Date.now();let id=resolveId(btn);if(!id)return false;if(source!=='click'){if(S.lastPointerId===id&&now-S.lastPointerAt<450){try{ev.preventDefault();ev.stopPropagation();ev.stopImmediatePropagation()}catch(_){}return false}S.lastPointerAt=now;S.lastPointerId=id;}else if(S.lastPointerId===id&&now-S.lastPointerAt<650){try{ev.preventDefault();ev.stopPropagation();ev.stopImmediatePropagation()}catch(_){}return false}try{ev.preventDefault();ev.stopPropagation();ev.stopImmediatePropagation()}catch(_){}toggle(id);setTimeout(syncButtons,0);setTimeout(syncButtons,80);return false}
  function bindButtonEvents(){if(window._v307AdsbTrackEvents)return;window._v307AdsbTrackEvents=true;const cap=true;const h=(kind)=>function(ev){const btn=ev.target&&ev.target.closest&&ev.target.closest('.adsb-track-btn');if(!btn)return;return handleButton(ev,btn,kind)};if(window.PointerEvent)window.addEventListener('pointerdown',h('pointer'),cap);else window.addEventListener('mousedown',h('mouse'),cap);window.addEventListener('touchstart',h('touch'),cap);window.addEventListener('click',h('click'),cap)}
  function wrapDraw(){try{if(window._v307AdsbDrawWrapped)return;const old=window.drawAircraft;if(typeof old!=='function')return;window._v307AdsbDrawWrapped=true;window.drawAircraft=function(items){let r;try{r=old.apply(this,arguments)}finally{updateFrom(items);setTimeout(syncButtons,10)}return r}}catch(e){console.warn('v307 ADS-B draw wrap failed',e)}}
  function own(){css();version();mapObj();bindButtonEvents();wrapDraw();window.toggleAdsbTrack=toggle;window.updateAdsbTrackPoint=addPoint;window.syncAdsbTrackButtons=syncButtons;window.updateAdsbTrackFromStable=function(items){updateFrom(items)};try{updateFrom(window.lastAircraft||window.__v307LastAircraft||[])}catch(_){}syncButtons()}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(own,80),{once:true});else setTimeout(own,80);
  [250,800,1600,3200,6400].forEach(ms=>setTimeout(own,ms));setInterval(own,2000);
})();
</script>
'''
        if '</body></html>' in _html:
