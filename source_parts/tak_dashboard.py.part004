  function patchCircleLock(){try{if(w.__v345CircleLock)return;w.__v345CircleLock=true;function syncCircleState(){try{const s=w.v233DrawState||{};if(String(s.mode||'').toLowerCase()==='circle'&&s.points&&s.points.length&&s.liveEnd&&w.map&&w.L){const c=s.points[0],e=s.liveEnd;const cp=w.map.latLngToContainerPoint(c),ep=w.map.latLngToContainerPoint(e);const dx=ep.x-cp.x,dy=ep.y-cp.y;const r=Math.max(2,Math.sqrt(dx*dx+dy*dy));const ang=Math.atan2(dy,dx||0);const locked=w.L.point(cp.x+Math.cos(ang)*r,cp.y+Math.sin(ang)*r);s.liveEnd=w.map.containerPointToLatLng(locked);s.shape_locked_ratio='1:1';}}catch(_){} }['input','change','keyup'].forEach(function(ev){d.addEventListener(ev,function(e){try{if(e.target&&e.target.closest&&e.target.closest('#drawSaveBackdrop,#drawOptionsPanel'))syncCircleState()}catch(_){}},true)});const oldRedraw=w.v236RedrawDrawTemp;if(oldRedraw&&!oldRedraw.__v345CircleLock){const fn=function(){syncCircleState();return oldRedraw.apply(this,arguments)};fn.__v345CircleLock=true;w.v236RedrawDrawTemp=fn;try{v236RedrawDrawTemp=fn}catch(_){}}}catch(e){try{console.warn('v345 circle lock failed',e)}catch(_){}}}
  function dsCapture(){try{const side=$('sidebar')||q('.sidebar');const root=$('dataSyncRows')||$('dataSyncPanel');const out=[];function add(el,key){if(el&&out.map(x=>x.el).indexOf(el)<0)out.push({el:el,key:key||el.id||'',top:el.scrollTop,left:el.scrollLeft})}add(side,'sidebar');add(root,'dataSyncRoot');qa('.datasync-section-list,.sync-list,#dataSyncRows,#dataSyncPanel').forEach(function(el){if(el.scrollHeight>el.clientHeight+2)add(el,el.id||el.className||'')});return out}catch(_){return []}}
  function dsRestore(snap){try{(snap||[]).forEach(function(s){if(s.el&&d.contains(s.el)){s.el.scrollTop=s.top||0;s.el.scrollLeft=s.left||0}})}catch(_){} }
