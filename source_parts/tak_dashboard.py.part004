# --- TAK Map v305 ADS-B source-level refactor (no runtime stacked controller patch) ---
try:
    import re as _v305_re
    _V305 = 'v305'

    def _v305_remove_script_id(_html, _sid):
        return _v305_re.sub(r'<script[^>]*id=["\']' + _v305_re.escape(_sid) + r'["\'][^>]*>.*?</script>\s*', '', _html, flags=_v305_re.S|_v305_re.I)

    def _v305_versions(_html):
        _html = _v305_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/' + _V305, _html)
        _html = _v305_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 ' + _V305, _html)
        _html = _v305_re.sub(r'<span class="iteration-chip">v\d+</span>', '<span class="iteration-chip">' + _V305 + '</span>', _html)
        _html = _v305_re.sub(r'<div class="iteration-marker">v\d+</div>', '<div class="iteration-marker">' + _V305 + '</div>', _html)
        _html = _v305_re.sub(r'const\s+V\s*=\s*["\']v\d+["\']', "const V='" + _V305 + "'", _html)
        _html = _v305_re.sub(r'>v\d+<', '>' + _V305 + '<', _html)
        return _html

    def _v305_refactor_adsb_base(_html):
        # Remove runtime controller/patch scripts that competed for ADS-B marker and track ownership.
        for _sid in (
            'v285AdsbClassTypeTrackPatch', 'v286AdsbAuthoritativePopupStatusPatch',
            'v287AdsbStatusTrackSavePatch', 'v297AdsbTrackRoutePatch',
