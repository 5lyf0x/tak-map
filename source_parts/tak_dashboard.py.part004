  function rectPoly(a,b,square){let x1=a.lng,y1=a.lat,x2=b.lng,y2=b.lat;if(square){const d=Math.max(Math.abs(x2-x1),Math.abs(y2-y1));x2=x1+(x2>=x1?d:-d);y2=y1+(y2>=y1?d:-d)}return [[x1,y1],[x2,y1],[x2,y2],[x1,y2],[x1,y1]]}
