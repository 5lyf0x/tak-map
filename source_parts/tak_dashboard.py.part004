# --- TAK Map v351 Local Elevation import status stability patch ---
try:
    import re as _v351_re

    def _v351_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v351_re.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v351'", _html)
        _html = _v351_re.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v351', _html)
        _html = _v351_re.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v351', _html)
        _html = _v351_re.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v351\2', _html, flags=_v351_re.I)
        _html = _v351_re.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v351\2', _html, flags=_v351_re.I)
        _html = _v351_re.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v351\2', _html, flags=_v351_re.I)
        _html = _v351_re.sub(r'version=(["\'])v\d+\1', lambda m: 'version=' + m.group(1) + 'v351' + m.group(1), _html)
        return _html

    def _v351_patch_html(_html):
        if not isinstance(_html, str):
            return _html
        _html = _html.replace('GeoTIFF DEM (.tif/.tiff) · Pending', 'USGS 3DEP GeoTIFF/COG DEM (.tif/.tiff) · Ready')
        _html = _html.replace('GeoTIFF (.tif/.tiff) · Pending', 'USGS 3DEP GeoTIFF/COG DEM (.tif/.tiff) · Ready')
        _html = _html.replace('USGS 3DEP GeoTIFF/COG DEM · ready', 'DEM GeoTIFF ready')
        _html = _html.replace('Use local elevation data as a Viewshed source. Terrain Mode local terrain rendering is pending.', 'Use local elevation data as a Viewshed source. SRTM HGT, DTED, and DEM GeoTIFF files are supported for local elevation sampling.')
        _html = _v351_versions(_html)
        runtime = r'''
<script id="v351LocalElevationStatusStabilityPatch">
(function(){
  'use strict';
  const V='v351', d=document, w=window;
  const LABELS=[
    'SRTM HGT (.hgt) · Ready',
    'DTED (.dt0/.dt1/.dt2) · Ready',
    'USGS 3DEP GeoTIFF/COG DEM (.tif/.tiff) · Ready',
    'ZIP packages · Not supported'
  ];
  function $(id){try{return d.getElementById(id)}catch(_){return null}}
  function q(s,r){try{return (r||d).querySelector(s)}catch(_){return null}}
  function qa(s,r){try{return Array.from((r||d).querySelectorAll(s))}catch(_){return []}}
  function setVersion(){try{qa('.iteration-chip,.iteration-marker').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  function setText(el,txt){try{if(el&&el.textContent!==txt)el.textContent=txt}catch(_){}}
  function normalizeLocalElevationDialog(){
    try{
      setVersion();
      const dlg=$('localElevationDialog');
      if(!dlg)return false;
      const title=q('.local-elev-head h2',dlg); if(title)setText(title,'Add Elevation Data');
      const note=q('.local-elev-note',dlg);
      if(note){
        const wanted='<b>Local elevation files stay on this device.</b> SRTM HGT, DTED, and DEM GeoTIFF are ready for Viewshed.';
        if(note.innerHTML!==wanted)note.innerHTML=wanted;
      }
      const compat=$('localElevCompatText');
      if(compat){
        const wanted='<b>Compatible: SRTM HGT, DTED DT0/DT1/DT2, USGS National Map / 3DEP DEM GeoTIFF/COG (.tif/.tiff)</b><br><span>GeoTIFF support is for DEM/elevation GeoTIFFs, not imagery or topo-map GeoTIFFs.</span><br><span>Direct files only. ZIP packages are not supported in this version.</span>';
        if(compat.innerHTML!==wanted)compat.innerHTML=wanted;
      }
      qa('.local-elev-format-list span',dlg).forEach(function(el,i){
        if(LABELS[i]){setText(el,LABELS[i]);try{el.dataset.v351StableLabel=LABELS[i]}catch(_){}}
      });
      const input=$('localElevFileInput');
      if(input)input.accept='.hgt,.dt0,.dt1,.dt2,.tif,.tiff';
      const choose=$('localElevChoose'); if(choose)setText(choose,'Choose Files');
      const imp=$('localElevImport'); if(imp && !/Importing/i.test(imp.textContent||''))setText(imp,'Import');
      const clear=$('localElevClear'); if(clear)setText(clear,'Clear');
      return true;
    }catch(e){try{console.warn('v351 local elevation dialog normalize failed',e)}catch(_){}return false}
  }
  function patchOpenAndUi(){
    try{
      const names=['ensureLocalElevationDialog','openLocalElevationDialog','updateLocalElevationUi','renderLocalElevationSelected'];
      names.forEach(function(name){
        const old=w[name];
        if(typeof old==='function'&&!old.__v351LocalElevationStable){
          const fn=function(){
            let r;
            try{r=old.apply(this,arguments)}catch(e){throw e}
            finally{setTimeout(normalizeLocalElevationDialog,0);setTimeout(normalizeLocalElevationDialog,80);setTimeout(normalizeLocalElevationDialog,220)}
            return r;
          };
          fn.__v351LocalElevationStable=true;
          w[name]=fn;
        }
      });
    }catch(e){try{console.warn('v351 local elevation function patch failed',e)}catch(_){}}
  }
  function observe(){
    try{
      if(w.__v351LocalElevationObserver)return;
      w.__v351LocalElevationObserver=true;
      let pending=false;
      const schedule=function(){if(pending)return;pending=true;setTimeout(function(){pending=false;normalizeLocalElevationDialog()},0)};
      new MutationObserver(function(ms){
        try{
          for(const m of ms){
            const t=m.target;
            if(t&&((t.id==='localElevationDialog')||(t.closest&&t.closest('#localElevationDialog')))){schedule();return;}
            const added=Array.from(m.addedNodes||[]);
            if(added.some(function(n){return n&&n.nodeType===1&&((n.id==='localElevationDialog')||(n.querySelector&&n.querySelector('#localElevationDialog')))})){schedule();return;}
          }
        }catch(_){ }
      }).observe(d.body||d.documentElement,{childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:['class','style']});
    }catch(_){ }
  }
  function boot(){patchOpenAndUi();normalizeLocalElevationDialog();observe();}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,80)},{once:true});else setTimeout(boot,80);
  [180,420,900,1600,3200,5200,8200].forEach(function(ms){setTimeout(boot,ms)});
  setInterval(function(){try{patchOpenAndUi();normalizeLocalElevationDialog()}catch(_){}},900);
})();
</script>
'''
        if 'id="v351LocalElevationStatusStabilityPatch"' not in _html and "id='v351LocalElevationStatusStabilityPatch'" not in _html:
            _html = _html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v351_versions(_html)

    TAK_MAP_HTML = _v351_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML = _v351_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = _v351_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE','map')).strip().lower() == 'map':
        INDEX_HTML = TAK_MAP_HTML
except Exception as _v351_exc:
    try: print('v351 local elevation status stability patch failed:', _v351_exc)
    except Exception: pass
# --- end TAK Map v351 Local Elevation import status stability patch ---


