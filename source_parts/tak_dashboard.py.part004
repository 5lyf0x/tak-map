  function isRouteLiveMarker(o){try{if(!o)return false;const uid=String(o.uid||o.id||'').toLowerCase();const typ=String(o.type||o.cot_type||o.event_type||o.cotType||'').toLowerCase();const callsign=String(o.callsign||o.name||o.title||'').toLowerCase();const source=String(o.source||o.kind||o.category||'').toLowerCase();if(typ==='b-m-r'||typ==='b-m-p-c')return true;if(uid.indexOf('takmap-route')>=0)return true;if(/\.cp\d+$/.test(uid))return true;if((callsign==='route'||callsign.indexOf('route ')===0)&&source.indexOf('eud')>=0)return true;return false}catch(_){return false}}
