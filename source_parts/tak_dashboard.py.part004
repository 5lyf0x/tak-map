        if 'id="v347ShapeUiColorPublishPatch"' not in _html and "id='v347ShapeUiColorPublishPatch'" not in _html:
            _html=_html.replace('</body>', runtime + '</body>', 1) if '</body>' in _html else _html + runtime
        return _v347_versions(_html)

