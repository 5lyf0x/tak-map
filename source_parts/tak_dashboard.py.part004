      .adsb-pop-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 9px;margin-top:2px;}
      .adsb-pop-grid>div{min-width:0;padding:5px 7px;border:1px solid rgba(255,255,255,.075);border-radius:9px;background:rgba(255,255,255,.035);}
      .adsb-pop-grid b{display:block;margin-bottom:2px;color:#ffcfb8;font-size:9px;line-height:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:950;}
      .adsb-pop-grid span{display:block;min-width:0;color:#f2f7f9;font-size:12px;line-height:14px;font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
      .adsb-pop-grid .adsb-pop-wide{grid-column:1/-1;}
      .adsb-track-row{display:flex;justify-content:flex-end;margin-top:10px;}
      .adsb-track-row .layer-button,.adsb-track-row .adsb-track-btn{min-width:86px;justify-content:center;padding:7px 12px!important;border-radius:999px!important;font-size:12px!important;line-height:1!important;}
      .adsb-track-light{width:8px!important;height:8px!important;margin-right:7px!important;}
    `;
    document.head.appendChild(st);
  }
  function boot(){try{addCss();document.querySelectorAll('.iteration-chip,.iteration-marker').forEach(el=>el.textContent=V)}catch(e){console.warn('v318 ADS-B popup/label style failed',e)}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
  setTimeout(boot,500);setTimeout(boot,1800);setInterval(boot,5000);
})();
</script>
"""
        _html = _html.replace('</body>', _style + '</body>', 1) if '</body>' in _html else _html + _style
        return _v318_versions(_html)

    TAK_MAP_HTML = _v318_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML = _v318_versions(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = _v318_versions(LOGIN_HTML)
    if str(globals().get('APP_ROLE', 'map')).strip().lower() == 'map':
        INDEX_HTML = TAK_MAP_HTML

    _v318_prev_get = Handler.do_GET
    def _v318_route_get(self):
        parsed = urlparse(self.path)
        if str(globals().get('APP_ROLE', 'map')).strip().lower() == 'map':
            if parsed.path in ('/', '/index.html', '/tak-map', '/tak-map/'):
                if not self._tak_map_auth_ok():
                    return self._redirect('/tak-map/login')
                return self._send_html(TAK_MAP_HTML)
            if parsed.path in ('/login', '/tak-map/login'):
                if self._tak_map_auth_ok():
                    return self._redirect('/tak-map')
                return self._send_html(TAK_MAP_LOGIN_HTML)
        return _v318_prev_get(self)
    Handler.do_GET = _v318_route_get
except Exception as _v318_exc:
    try: print('v318 ADS-B popup/label polish failed:', _v318_exc)
    except Exception: pass
