  function patchColorInputs(){try{if(w.__v347ShapeColorInputs)return;w.__v347ShapeColorInputs=true;['input','change','keyup'].forEach(function(ev){d.addEventListener(ev,function(e){try{if(e.target&&e.target.closest&&e.target.closest('#drawSaveBackdrop,#drawOptionsPanel'))syncDrawState()}catch(_){}},true)});}catch(_){}}
  function patchGeoJsonColors(obj){try{const c=selectedColors();function patchFeature(f){try{if(!f||typeof f!=='object')return;const p=f.properties=f.properties||{};const kind=String(p.kind||f.kind||'').toLowerCase();const geom=String((f.geometry&&f.geometry.type)||f.geometry||'').toLowerCase();if(kind==='shape'||geom.indexOf('polygon')>=0||/circle|polygon|rectangle|ellipse|freehand|shape/.test(String(p.shape_type||p.type||'').toLowerCase())){p.color=c.stroke;p.stroke_color=c.stroke;p.strokeColor=c.stroke;p.perimeter_color=c.stroke;p.fill_color=c.fill;p.fillColor=c.fill;if(p.fill==null||String(p.fill).startsWith('#'))p.fill=true;if(p.filled==null)p.filled=true;if(p.fill_opacity==null&&p.fillOpacity==null)p.fill_opacity=0.20;}}catch(_){} }
      if(obj&&obj.type==='FeatureCollection'&&Array.isArray(obj.features))obj.features.forEach(patchFeature);else if(obj&&obj.type==='Feature')patchFeature(obj);return obj;}catch(_){return obj}}
  function patchImportFetch(){try{if(w.__v347ImportColorFetch)return;w.__v347ImportColorFetch=true;const old=w.fetch;w.fetch=function(input,init){try{const url=String((input&&input.url)||input||'');const body=init&&init.body;if(url.indexOf('/api/tak-map/import')>=0&&body&&typeof FormData!=='undefined'&&body instanceof FormData){return (async function(){const nf=new FormData();for(const pair of body.entries()){const key=pair[0],val=pair[1];if(val&&typeof File!=='undefined'&&val instanceof File&&/\.geojson$|\.json$/i.test(val.name||'')){try{const txt=await val.text();const patched=patchGeoJsonColors(JSON.parse(txt));nf.append(key,new File([JSON.stringify(patched,null,2)],val.name,{type:val.type||'application/geo+json'}));continue;}catch(e){try{console.warn('v347 GeoJSON color patch skipped',e)}catch(_){}}}nf.append(key,val);}const ni=Object.assign({},init,{body:nf});return old.call(this,input,ni);})();}}catch(e){try{console.warn('v347 import fetch patch failed',e)}catch(_){}}return old.apply(this,arguments)}}catch(e){try{console.warn('v347 patchImportFetch failed',e)}catch(_){}}}
  function isShapeCenter(o){try{if(!o)return false;const uid=String(o.uid||o.id||o.data||o.missionGuid||'').toLowerCase();const typ=String(o.type||o.cot_type||o.event_type||o.cotType||'').toLowerCase();const cs=String(o.callsign||o.name||o.title||'').toLowerCase();const src=String(o.source||o.kind||o.category||o.geometry||'').toLowerCase();const blob=JSON.stringify(o).toLowerCase();const shapeType=['u-d-f','u-d-r','u-d-c','u-d-c-c','u-d-s'].indexOf(typ)>=0||blob.indexOf('u-d-f')>=0||blob.indexOf('u-d-r')>=0;const shapeHint=uid.indexOf('takmap-local-')===0||uid.indexOf('takmap-shape-')===0||src.indexOf('shape')>=0||src.indexOf('drawing')>=0||/shape|polygon|rectangle|circle|ellipse|freehand|area/.test(cs)||blob.indexOf('__shapeextras')>=0||blob.indexOf('<link point=')>=0||blob.indexOf('link point')>=0;return !!(shapeType&&shapeHint);}catch(_){return false}}
  function hasShapeCoords(o){try{const c=o&&o.coords;if(!Array.isArray(c))return false;let n=0;(function walk(x){if(Array.isArray(x)){if(x.length>=2&&Number.isFinite(Number(x[0]))&&Number.isFinite(Number(x[1]))){n++;return}x.forEach(walk)}})(c);return n>=3;}catch(_){return false}}
  function patchShapeCenterDraw(){try{if(w.__v347ShapeCenterDrawPatch)return;w.__v347ShapeCenterDrawPatch=true;const oldCat=w.dataSyncCategory;if(typeof oldCat==='function'){const fn=function(o){try{if(isShapeCenter(o))return 'Shapes / Areas'}catch(_){}return oldCat.apply(this,arguments)};fn.__v347ShapeCenter=true;w.dataSyncCategory=fn;try{dataSyncCategory=fn}catch(_){}}
      const oldAdd=w.addObjectLayer;if(typeof oldAdd==='function'){const fn=function(group,o,sourceKey){try{if(isShapeCenter(o)&&!hasShapeCoords(o))return null;}catch(_){}return oldAdd.apply(this,arguments)};fn.__v347ShapeCenter=true;w.addObjectLayer=fn;try{addObjectLayer=fn}catch(_){}}
      const oldDraw=w.drawDataSyncObjects;if(typeof oldDraw==='function'){const fn=function(items){try{if(Array.isArray(items))arguments[0]=items.filter(function(o){return !(isShapeCenter(o)&&!hasShapeCoords(o))})}catch(_){}return oldDraw.apply(this,arguments)};fn.__v347ShapeCenter=true;w.drawDataSyncObjects=fn;try{drawDataSyncObjects=fn}catch(_){}}
