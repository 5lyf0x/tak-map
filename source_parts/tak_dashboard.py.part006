try:
    _I520_ACCOUNT_HTML = '''<div class="top-actions"><div id="takAccountV511" class="tak-account-v511"><button id="takMapAccountBtnV511" class="tak-account-button-v511" type="button">ACCOUNT &#9662;</button><div id="takMapAccountMenuV511" class="tak-account-menu-v511" role="menu"></div></div></div>'''

