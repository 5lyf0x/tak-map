    def _i552_strip_current_iteration(row):
        if not isinstance(row, dict):
            return row
        clean = dict(row)
        for key in _I552_CURRENT_KEYS:
            clean.pop(key, None)
        props = clean.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            for key in _I552_CURRENT_KEYS:
                props.pop(key, None)
            clean['properties'] = props
        return clean

    _i552_merge_before = _i545_merge_event
    def _i545_merge_event(row, event):
        # Remove the previous response-only i552 projection before a newer
        # Mission event is merged, otherwise stale i552 raw fields could outrank
        # the new event's i549/i550 raw values during normalization.
        merged, applied, reason = _i552_merge_before(_i552_strip_current_iteration(row), event)
        if applied and isinstance(merged, dict):
            return _i552_normalize_visible_row(merged), True, 'merged-reviewed-atak-alias-i552'
        return merged, applied, reason
    globals()['_i545_merge_event'] = _i545_merge_event

    _i552_augment_before = _i512_augment_data_sync
    def _i512_augment_data_sync(base, cfg, sess):
        out = _i552_augment_before(base, cfg, sess)
        if not isinstance(out, dict):
            return out
        rows = []
        normalized_count = 0
        reviewed_count = 0
        changed_from_older = 0
        for row in list(out.get('objects') or []):
            if not isinstance(row, dict):
                rows.append(row); continue
            older_file = _i552_text(row.get('mil2525_file') or (row.get('properties') or {}).get('mil2525_file') if isinstance(row.get('properties'), dict) else row.get('mil2525_file'))
            normalized = _i552_normalize_visible_row(row)
            rows.append(normalized)
            decision = normalized.get('data_sync_symbol_decision_i552') if isinstance(normalized, dict) else None
            if isinstance(decision, dict):
                normalized_count += 1
                reviewed_count += int(bool(decision.get('reviewed_alias_selected')))
                new_file = _i552_text(normalized.get('mil2525_file'))
                changed_from_older += int(bool(older_file and new_file and older_file != new_file))
        out['objects'] = rows
        out['version'] = 'i552'
        diag = dict(out.get('mission_cot_symbol_enrichment_i551') or out.get('mission_cot_symbol_enrichment_i550') or {})
        diag.update({
            'version': 'i552',
            'final_visible_response_normalization': True,
            'unchanged_older_events_reprocessed': True,
            'older_i550_i551_decisions_upgraded': True,
            'objects_upgrade_normalized_i552': normalized_count,
            'objects_using_reviewed_alias_i552': reviewed_count,
            'objects_visual_file_changed_during_upgrade_i552': changed_from_older,
            'reviewed_sidc_alias_count': len(_I552_ALIAS_BY_SIDC),
            'reviewed_cot_type_alias_count': len(_I552_ALIAS_BY_COT),
            'construction_alias_file': _i552_text((_I552_ALIAS_BY_COT.get('a-f-g-u-c-e-n') or {}).get('file')),
            'howitzer_alias_file': _i552_text((_I552_ALIAS_BY_COT.get('a-f-g-e-w-h') or {}).get('file')),
        })
        out['mission_cot_symbol_enrichment_i552'] = diag
        tombstones = out.get('data_sync_deleted_uid_tombstones_i551') or out.get('data_sync_deleted_uid_tombstones_i550')
        if isinstance(tombstones, dict):
            current_tombstones = dict(tombstones); current_tombstones['version'] = 'i552'
            out['data_sync_deleted_uid_tombstones_i552'] = current_tombstones
        if 'data_sync_forced_duplicate_rows_removed_i551' in out:
            out['data_sync_forced_duplicate_rows_removed_i552'] = out.get('data_sync_forced_duplicate_rows_removed_i551')
        elif 'data_sync_forced_duplicate_rows_removed_i550' in out:
            out['data_sync_forced_duplicate_rows_removed_i552'] = out.get('data_sync_forced_duplicate_rows_removed_i550')
        elif 'data_sync_forced_duplicate_rows_removed_i549' in out:
            out['data_sync_forced_duplicate_rows_removed_i552'] = out.get('data_sync_forced_duplicate_rows_removed_i549')
        elif 'data_sync_forced_duplicate_rows_removed_i547' in out:
            out['data_sync_forced_duplicate_rows_removed_i552'] = out.get('data_sync_forced_duplicate_rows_removed_i547')
        return out
