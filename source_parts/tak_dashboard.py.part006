    def _i551_text(value):
        return _i550_text(value) if '_i550_text' in globals() else str(value if value is not None else '').strip()

    def _i551_normalize_cot(value):
        return '-'.join(part for part in re.split(r'-+', _i551_text(value).casefold()) if part)

    def _i551_alias_result(record, source, input_sidc='', input_cot_type=''):
        if not isinstance(record, dict):
            return None
        name = _i537_clean_icon_name(record.get('name')) if '_i537_clean_icon_name' in globals() else _i551_text(record.get('name'))
        if not name:
            return None
        source_sidc = _i537_normalize_sidc(input_sidc) if input_sidc and '_i537_normalize_sidc' in globals() else ''
        source_cot = _i551_normalize_cot(input_cot_type)
        derived_sidc = _i537_cot_type_to_sidc(source_cot) if source_cot and '_i537_cot_type_to_sidc' in globals() else ''
        catalog_sidc = _i537_normalize_sidc(record.get('catalog_sidc')) if '_i537_normalize_sidc' in globals() else _i551_text(record.get('catalog_sidc'))
        return {
            'ok': True,
            'source': source + '-reviewed-alias-i551',
            'sidc': source_sidc or derived_sidc or catalog_sidc,
            'catalog_sidc': catalog_sidc,
            'input_sidc': source_sidc,
            'input_cot_type': source_cot,
            'name': name,
            'file': name + '.svg',
            'label': _i551_text(record.get('label')),
            'reviewed_alias': True,
            'alias_kinds': list(record.get('alias_kinds') or []),
            'equivalent_files': list(record.get('equivalent_files') or []),
            'reviewed_concepts': list(record.get('concepts') or []),
        }

    def _i551_resolve_sidc(raw_sidc):
        sidc = _i537_normalize_sidc(raw_sidc) if '_i537_normalize_sidc' in globals() else _i551_text(raw_sidc)
        if not sidc:
            return None
        alias = _i551_alias_result(_I551_ALIAS_BY_SIDC.get(sidc), 'sidc', input_sidc=sidc)
        if alias:
            return alias
        return _i537_resolve_symbol({'sidc': sidc}) if '_i537_resolve_symbol' in globals() else None

    def _i551_resolve_type(raw_type):
        cot_type = _i551_normalize_cot(raw_type)
        if not cot_type:
            return None
        alias = _i551_alias_result(_I551_ALIAS_BY_COT.get(cot_type), 'cot-type', input_cot_type=cot_type)
        if alias:
            return alias
        return _i537_resolve_symbol({'cot_type': raw_type, 'type': raw_type}) if '_i537_resolve_symbol' in globals() else None

    def _i551_resolve_iconset(raw_path):
        if not raw_path:
            return None
        if '_i537_iconset_candidates' in globals():
            names, sidcs, cot_types = _i537_iconset_candidates(raw_path)
            for sidc in sidcs:
                alias = _i551_alias_result(_I551_ALIAS_BY_SIDC.get(_i537_normalize_sidc(sidc)), 'iconset-sidc', input_sidc=sidc)
                if alias:
                    return alias
            for cot_type in cot_types:
                normalized = _i551_normalize_cot(cot_type)
                alias = _i551_alias_result(_I551_ALIAS_BY_COT.get(normalized), 'iconset-cot-type', input_cot_type=normalized)
                if alias:
                    return alias
            for name in names:
                icon = _I537_MIL_BY_NAME.get(_i537_clean_icon_name(name).lower()) if '_I537_MIL_BY_NAME' in globals() else None
                if icon:
                    return _i537_symbol_result(icon, 'iconset-name')
        return _i537_resolve_symbol({'iconsetPath': raw_path, 'usericon_path': raw_path}) if '_i537_resolve_symbol' in globals() else None

