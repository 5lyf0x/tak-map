            'empty_api_preserves_direct_roles': True,
        })
        cfg['data_sync_control'] = control
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _I540_REFRESH_RUNTIME = (
        "let lastDataSync=null,dataSyncRequestPromise=null,dataSyncEventTimer=null;"
        "async function refreshDataSync(force,reason){"
        "if(dataSyncRequestPromise)return dataSyncRequestPromise;"
        "dataSyncRequestPromise=(async()=>{try{"
        "const qs=(force?('?force=1&reason='+encodeURIComponent(reason||'manual')+'&_='+Date.now()):('?_='+Date.now()));"
        "try{const ms=document.getElementById('mapStatus');if(ms&&force)ms.textContent='Refreshing Data Sync...'}catch(e){}"
        "const r=await fetch('/api/tak-map/data-sync'+qs,{cache:'no-store',credentials:'same-origin'});"
        "const j=await apiJsonResponse(r);lastDataSync=j;lastDataSyncSuccessMs=Date.now();lastDataSyncSuccessReason=reason||(force?'force':'interval');"
        "const objs=j.objects||[];const mc=document.getElementById('missionCount');if(mc)mc.textContent=(j.missions||[]).length+' missions';"
        "const oc=document.getElementById('dataSyncObjectCount');if(oc)oc.textContent=objs.length+' objects';renderDataSyncRows();drawDataSyncObjects(objs);return j"
        "}catch(e){const box=document.getElementById('dataSyncRows');if(box)box.innerHTML='<div class=\"danger\">Could not load Data Sync: '+esc(e)+'</div>';return {ok:false,error:String(e)}}"
        "finally{dataSyncRequestPromise=null}})();return dataSyncRequestPromise}"
        "function refreshDataSyncInterval(){return refreshDataSync(false,'interval')}"
        "async function forceDataSyncSync(reason){return refreshDataSync(true,reason||'force')}"
    )

    _I540_INIT_RUNTIME = (
        "async function init(){try{"
        "const r=await fetch('/api/tak-map/config',{cache:'no-store'});if(r.status===401){location.href='/tak-map/login';return}config=await r.json();"
        "applyCustomBasemaps();map=L.map('map',{zoomControl:true}).setView([34.3,-118.6],9);L.control.scale({metric:true,imperial:true,position:'bottomright'}).addTo(map);"
        "map.on('zoomend moveend',()=>{updateZoomIndicator();updateTopBannerCached()});takMarkerLayer.addTo(map);dataSyncLayer.addTo(map);importedLayer.addTo(map);measureLayer=L.layerGroup().addTo(map);"
        "initFloatingToolbar();if(state.live.adsb_aircraft){aircraftLayer.addTo(map)}initOfflineAreaDrawing();makeMenuCollapsible();renderLayerMenu();updateZoomIndicator();"
        "const initialBasemap=savedBasemap()||config.default_basemap||'esri_topo';setBasemap(initialBasemap,{skipSave:true,source:'server-initial'});"
        "setTimeout(()=>enforceServerBasemap('post-render-1'),350);setTimeout(()=>enforceServerBasemap('post-render-2'),1500);setTimeout(()=>enforceServerBasemap('post-render-3'),4000);"
        "renderOfflineMapRows();const ms=document.getElementById('mapStatus');if(ms)ms.textContent='Ready';scheduleDataSyncAutoRefresh();"
        "const bg=fn=>{try{const p=fn();if(p&&typeof p.catch==='function')p.catch(()=>{})}catch(e){}};"
        "setTimeout(()=>bg(()=>refreshDataSync(false,'startup')),0);setTimeout(()=>bg(()=>refreshOfflineMaps(false)),0);setTimeout(()=>bg(()=>refreshImports()),0);setTimeout(()=>bg(()=>refreshLocalData()),0);"
        "setTimeout(()=>bg(()=>refreshCot()),0);setTimeout(()=>bg(()=>updateTopBanner()),0);if(state.live.adsb_aircraft)setTimeout(()=>bg(()=>refreshAdsb()),0);"
        "setInterval(refreshDataSyncInterval,300000);setInterval(()=>{if(state.live.adsb_aircraft)refreshAdsb()},30000);setInterval(refreshCot,30000);"
        "setInterval(()=>refreshTerrain3DObjects(false,'interval'),10000);setInterval(updateTopBanner,30000);"
        "}catch(e){const ms=document.getElementById('mapStatus');if(ms)ms.textContent='Map failed to initialize: '+e}}"
        "function scheduleDataSyncAutoRefresh(){"
        "const request=reason=>{try{clearTimeout(dataSyncEventTimer);dataSyncEventTimer=setTimeout(()=>refreshDataSync(false,reason),500)}catch(e){}};"
        "try{window.addEventListener('focus',()=>request('focus'));document.addEventListener('visibilitychange',()=>{if(!document.hidden)request('visible')});"
        "window.addEventListener('pageshow',()=>request('pageshow'));window.addEventListener('online',()=>request('online'));"
        "document.addEventListener('change',e=>{try{if(e&&e.target&&e.target.id==='basemapSelect')setBasemap(e.target.value)}catch(_){}})}catch(e){}}"
    )

    def _i540_patch_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i539', '1.3.0-i540').replace('TAKDashboard/i539', 'TAKDashboard/i540').replace('TAK-Map/1.3.0 i539', 'TAK-Map/1.3.0 i540')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i540\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i540\2', html)
        html, refresh_count = re.subn(
            r"let lastDataSync=null;async function refreshDataSync\(force,reason\)\{[\s\S]*?\}function rowLabel",
            _I540_REFRESH_RUNTIME + 'function rowLabel', html, count=1,
        )
        html, init_count = re.subn(
            r"async function init\(\)\{try\{const r=await fetch\('/api/tak-map/config'[\s\S]*?\}function basemapMaxZoom",
            _I540_INIT_RUNTIME + 'function basemapMaxZoom', html, count=1,
        )
        if refresh_count != 1 or init_count != 1:
            raise RuntimeError('i540 browser startup patch did not match the authoritative runtime (refresh=%s init=%s)' % (refresh_count, init_count))
        return html

    TAK_MAP_HTML = _i540_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i540_patch_html(TAK_MAP_LOGIN_HTML) if "async function init(){try{const r=await fetch('/api/tak-map/config'" in TAK_MAP_LOGIN_HTML else TAK_MAP_LOGIN_HTML.replace('1.3.0-i539', '1.3.0-i540')
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i540'
except Exception as _i540_exc:
    try:
        print('TAK Map i540 non-blocking startup/Data Sync scope patch failed:', _i540_exc)
    except Exception:
        pass
# --- end TAK Map i540 non-blocking startup + role-backed Data Sync scope ---

# --- TAK Map i541 shell-first startup architecture and performance budgets ---
try:
    _I541_ROOT = Path(__file__).resolve().parent
    _I541_RUNTIME_FILES = {
        '/assets/runtime/tak-map-core-i541.js': (_I541_ROOT / 'assets' / 'tak-map-core-i541.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-startup-i541.js': (_I541_ROOT / 'assets' / 'tak-map-startup-i541.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-deferred-i541.json': (_I541_ROOT / 'assets' / 'tak-map-deferred-i541.json', 'application/json; charset=utf-8'),
    }
    _I541_VENDOR_ROOT = (_I541_ROOT / 'assets' / 'vendor').resolve()

    def _i541_send_file(handler, path, content_type, module):
        if not path.exists() or not path.is_file():
            handler.send_response(404)
            handler.send_header('Cache-Control', 'no-store')
            handler.end_headers()
            return
        body = path.read_bytes()
        handler.send_response(200)
        handler.send_header('Content-Type', content_type)
        handler.send_header('Cache-Control', 'public, max-age=31536000, immutable')
        handler.send_header('X-Content-Type-Options', 'nosniff')
        handler.send_header('X-TAK-Map-Module', module)
        handler.send_header('Content-Length', str(len(body)))
        handler.end_headers()
        if getattr(handler, 'command', 'GET') != 'HEAD':
            handler.wfile.write(body)

    _i541_get_before = Handler.do_GET
    def _i541_do_get(self):
        parsed = urlparse(self.path)
        runtime = _I541_RUNTIME_FILES.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i541-startup')
        vendor_prefix = '/assets/vendor/'
        if parsed.path.startswith(vendor_prefix):
            relative = parsed.path[len(vendor_prefix):].lstrip('/')
            candidate = (_I541_VENDOR_ROOT / relative).resolve()
            try:
                candidate.relative_to(_I541_VENDOR_ROOT)
            except Exception:
                self.send_response(403)
                self.send_header('Cache-Control', 'no-store')
                self.end_headers()
                return
            suffix = candidate.suffix.lower()
            content_type = {
                '.css': 'text/css; charset=utf-8',
                '.js': 'application/javascript; charset=utf-8',
                '.json': 'application/json; charset=utf-8',
                '.png': 'image/png',
                '.svg': 'image/svg+xml',
                '.woff': 'font/woff',
                '.woff2': 'font/woff2',
            }.get(suffix, 'application/octet-stream')
            return _i541_send_file(self, candidate, content_type, 'i541-vendor')
        return _i541_get_before(self)
    Handler.do_GET = _i541_do_get

    _i541_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i541_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(str(built.get('wire_xml') or built.get('xml') or '').strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None:
                    takv.set('version', '1.3.0-i541')
                meta = detail.find('takmap_user_presence')
                if meta is not None:
                    meta.set('version', 'i541')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i541'
        except Exception as exc:
            built['i541_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i541_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = _i541_presence_public_before(token, state)
        if isinstance(out, dict):
            out = dict(out)
            out['version'] = 'i541'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i541_config_before = tak_map_config
    def tak_map_config():
        cfg = _i541_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i541'
        cfg['version'] = '1.3.0-i541'
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version': 'i541',
            'startup_refresh_owner': 'core-optional-data',
            'startup_refresh_count': 1,
            'module_boot_refresh': False,
            'automatic_poll_seconds': 300,
            'main_interface_waits_for_data_sync': False,
        })
        cfg['data_sync_control'] = control
        cfg['startup_architecture_i541'] = {
            'version': 'i541',
            'shell_first': True,
            'inline_runtime_bytes': 0,
            'core_externalized': True,
            'legacy_runtime_deferred': True,
            'deferred_scripts_budgeted': True,
            'broad_mutation_observers_coalesced': True,
            'duplicate_startup_gets_coalesced': True,
            'startup_request_coalescing_seconds': 15,
            'milstd_picker_lazy': True,
            'milstd_svg_requests_before_picker_open': 0,
            'optional_data_sequential': True,
            'optional_data_blocks_shell': False,
            'leaflet_parser_blocking': False,
            'leaflet_css_local': True,
            'startup_diagnostics_global': 'TakMapStartupDiagnosticsI541',
            'shell_ready_event': 'takmap:shell-ready-i541',
            'runtime_ready_event': 'takmap:runtime-ready-i541',
            'performance_contract': {
                'main_html_max_bytes': 200000,
                'startup_data_sync_requests': 1,
                'automatic_data_sync_poll_seconds': 300,
            },
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _I541_SCRIPT_RE = re.compile(r'<script\b([^>]*)>([\s\S]*?)</script>', re.I)
    def _i541_patch_main_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i540', '1.3.0-i541').replace('TAKDashboard/i540', 'TAKDashboard/i541').replace('TAK-Map/1.3.0 i540', 'TAK-Map/1.3.0 i541')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i541\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i541\2', html)
        html = html.replace(
            '<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">',
            '<link rel="stylesheet" href="/assets/vendor/leaflet-1.9.4/leaflet.css?v=1.9.4">',
        )
        scripts = list(_I541_SCRIPT_RE.finditer(html))
        if len(scripts) < 2:
            raise RuntimeError('i541 startup patch could not find the authoritative script stack')
        core_index = -1
        for index, match in enumerate(scripts):
            body = match.group(2) or ''
            if len(body) > 400000 and 'async function init()' in body:
                core_index = index
                break
        if core_index < 0:
            raise RuntimeError('i541 startup patch could not identify the authoritative core runtime')
        # All historical JavaScript is now represented by the local core asset and
        # ordered deferred manifest. Removing it from HTML makes first paint
        # independent of the 1.5+ MB patch stack.
        pieces = []
        cursor = 0
        for match in scripts:
            pieces.append(html[cursor:match.start()])
            cursor = match.end()
        pieces.append(html[cursor:])
        html = ''.join(pieces)
        loader = '<script id="takMapStartupLoaderI541" defer src="/assets/runtime/tak-map-startup-i541.js?v=1.3.0-i541"></script>'
        if '</body>' in html:
            html = html.replace('</body>', loader + '\n</body>', 1)
        else:
            html += loader
        return html

    def _i541_patch_login_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i540', '1.3.0-i541').replace('TAKDashboard/i540', 'TAKDashboard/i541').replace('TAK-Map/1.3.0 i540', 'TAK-Map/1.3.0 i541')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i541\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i541\2', html)
        return html

    TAK_MAP_HTML = _i541_patch_main_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i541_patch_login_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i541'
except Exception as _i541_exc:
    try:
        print('TAK Map i541 shell-first startup patch failed:', _i541_exc)
    except Exception:
        pass
# --- end TAK Map i541 shell-first startup architecture and performance budgets ---


