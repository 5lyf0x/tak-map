# --- TAK Map i550 change-aware Mission CoT symbol authority ---
try:
    _I550_ROOT = Path(__file__).resolve().parent
    _I550_RUNTIME_FILES = {
        '/assets/runtime/tak-map-core-i550.js': (_I550_ROOT / 'assets' / 'tak-map-core-i550.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-data-sync-i550.js': (_I550_ROOT / 'assets' / 'tak-map-data-sync-i550.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-startup-i550.js': (_I550_ROOT / 'assets' / 'tak-map-startup-i550.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-deferred-i550.json': (_I550_ROOT / 'assets' / 'tak-map-deferred-i550.json', 'application/json; charset=utf-8'),
        '/assets/runtime/tak-map-milstd2525c-i550.js': (_I550_ROOT / 'assets' / 'tak-map-milstd2525c-i550.js', 'application/javascript; charset=utf-8'),
    }

    def _i550_text(value):
        return _i549_text(value) if '_i549_text' in globals() else str(value if value is not None else '').strip()

    def _i550_nested_sources(value):
        out, stack, seen = [], [value], set()
        while stack and len(out) < 80:
            current = stack.pop()
            if not isinstance(current, dict) or id(current) in seen:
                continue
            seen.add(id(current)); out.append(current)
            for nested in current.values():
                if isinstance(nested, dict):
                    stack.append(nested)
        return out

    def _i550_first(value, keys):
        for source in _i550_nested_sources(value if isinstance(value, dict) else {}):
            for key in keys:
                text_value = _i550_text(source.get(key))
                if text_value:
                    return text_value
        return ''

    def _i550_prior_symbol_values(row):
        row = row if isinstance(row, dict) else {}
        return {
            'sidc': _i550_first(row, ('mission_cot_raw_sidc_i550', 'mission_cot_raw_sidc_i549', 'data_sync_current_sidc_i550', 'data_sync_current_sidc_i549')),
            'cot_type': _i550_first(row, ('mission_cot_raw_type_i550', 'mission_cot_raw_type_i549', 'data_sync_current_cot_type_i550', 'cot_type', 'atak_cot_type', 'event_type', 'type')),
            'iconset_path': _i550_first(row, ('mission_cot_raw_iconset_path_i550', 'mission_cot_raw_iconset_path_i549', 'data_sync_current_iconset_path_i550', 'data_sync_current_iconset_path_i549', 'iconsetPath', 'iconsetpath', 'iconset_path', 'usericon_path')),
        }

    def _i550_current_symbol_values(event):
        event = event if isinstance(event, dict) else {}
        current = _i549_current_symbol_values(event) if '_i549_current_symbol_values' in globals() else {}
        return {
            'sidc': _i550_text(event.get('mission_cot_raw_sidc_i549') or current.get('sidc')),
            'cot_type': _i550_text(event.get('mission_cot_raw_type_i549') or current.get('cot_type')),
            'iconset_path': _i550_text(event.get('mission_cot_raw_iconset_path_i549') or current.get('iconset_path')),
        }

    def _i550_resolve_sidc(raw_sidc):
        if not raw_sidc or '_i537_resolve_symbol' not in globals():
            return None
        return _i537_resolve_symbol({'sidc': raw_sidc})

    def _i550_resolve_type(raw_type):
        if not raw_type or '_i537_resolve_symbol' not in globals():
            return None
        return _i537_resolve_symbol({'cot_type': raw_type, 'type': raw_type})

    def _i550_resolve_iconset(raw_path):
        if not raw_path or '_i537_resolve_symbol' not in globals():
            return None
        return _i537_resolve_symbol({'iconsetPath': raw_path, 'usericon_path': raw_path})

    def _i550_resolution_identity(result):
        if not isinstance(result, dict) or not result.get('ok'):
            return ''
        return _i550_text(result.get('sidc') or result.get('file') or result.get('name')).upper()

    def _i550_type_specific(raw_type, result=None):
        sidc = _i550_text((result or {}).get('sidc')) if isinstance(result, dict) else ''
        if not sidc and raw_type and '_i537_cot_type_to_sidc' in globals():
            sidc = _i537_cot_type_to_sidc(raw_type)
        sidc = _i537_normalize_sidc(sidc) if sidc and '_i537_normalize_sidc' in globals() else sidc
        return bool(sidc and len(sidc[4:10].rstrip('-')) >= 3)

    def _i550_semantic_changed(current_raw, prior_raw, resolver):
        current_raw = _i550_text(current_raw); prior_raw = _i550_text(prior_raw)
        if not current_raw or not prior_raw:
            return False
        current = resolver(current_raw); prior = resolver(prior_raw)
        current_id = _i550_resolution_identity(current); prior_id = _i550_resolution_identity(prior)
        if current_id and prior_id:
            return current_id != prior_id
        return current_raw.casefold() != prior_raw.casefold()

    def _i550_choose_symbol(prior, current):
        raw_sidc = _i550_text(current.get('sidc'))
        raw_type = _i550_text(current.get('cot_type'))
        raw_iconset = _i550_text(current.get('iconset_path'))
        sidc_result = _i550_resolve_sidc(raw_sidc)
        type_result = _i550_resolve_type(raw_type)
        icon_result = _i550_resolve_iconset(raw_iconset)
        type_id = _i550_resolution_identity(type_result)
        icon_id = _i550_resolution_identity(icon_result)
        type_changed = _i550_semantic_changed(raw_type, prior.get('cot_type'), _i550_resolve_type)
        icon_changed = _i550_semantic_changed(raw_iconset, prior.get('iconset_path'), _i550_resolve_iconset)
        type_specific = _i550_type_specific(raw_type, type_result)
        conflict = bool(type_id and icon_id and type_id != icon_id)

        authority, reason, selected = '', '', None
        if isinstance(sidc_result, dict) and sidc_result.get('ok'):
            authority, reason, selected = 'explicit-sidc', 'explicit-current-sidc', sidc_result
        elif conflict:
            if icon_changed and not type_changed:
                authority, reason, selected = 'usericon-iconsetpath', 'iconset-changed-type-unchanged', icon_result
            elif type_specific:
                authority = 'event-type'
                reason = 'specific-type-changed-iconset-unchanged' if type_changed and not icon_changed else ('specific-type-and-iconset-conflict' if type_changed and icon_changed else 'specific-current-type-conflict-default')
                selected = type_result
            elif isinstance(icon_result, dict) and icon_result.get('ok'):
                authority, reason, selected = 'usericon-iconsetpath', 'generic-type-conflicts-with-specific-iconset', icon_result
            else:
                authority, reason, selected = 'event-type', 'event-type-only-resolvable', type_result
        elif isinstance(type_result, dict) and type_result.get('ok') and isinstance(icon_result, dict) and icon_result.get('ok'):
            if icon_changed and not type_changed:
                authority, reason, selected = 'usericon-iconsetpath', 'matching-symbol-iconset-changed', icon_result
            else:
                authority, reason, selected = 'event-type', 'matching-symbol-definitions', type_result
        elif isinstance(icon_result, dict) and icon_result.get('ok'):
            authority, reason, selected = 'usericon-iconsetpath', 'iconset-only-resolvable', icon_result
        elif isinstance(type_result, dict) and type_result.get('ok'):
            authority, reason, selected = 'event-type', 'event-type-only-resolvable', type_result
        elif raw_iconset:
            authority, reason, selected = 'usericon-iconsetpath', 'custom-iconset-fallback', None
        elif raw_type:
            authority, reason, selected = 'event-type', 'unresolved-event-type', None
        else:
            authority, reason, selected = 'none', 'no-current-symbol-identity', None

        decision = {
            'version': 'i550',
            'authority': authority,
            'reason': reason,
            'conflict': conflict,
            'type_changed': type_changed,
            'iconset_changed': icon_changed,
            'type_specific': type_specific,
            'raw_sidc': raw_sidc,
            'raw_cot_type': raw_type,
            'raw_iconset_path': raw_iconset,
            'previous_cot_type': _i550_text(prior.get('cot_type')),
            'previous_iconset_path': _i550_text(prior.get('iconset_path')),
            'type_candidate_sidc': _i550_text((type_result or {}).get('sidc')) if isinstance(type_result, dict) else '',
            'type_candidate_file': _i550_text((type_result or {}).get('file')) if isinstance(type_result, dict) else '',
            'iconset_candidate_sidc': _i550_text((icon_result or {}).get('sidc')) if isinstance(icon_result, dict) else '',
            'iconset_candidate_file': _i550_text((icon_result or {}).get('file')) if isinstance(icon_result, dict) else '',
            'selected_sidc': _i550_text((selected or {}).get('sidc')) if isinstance(selected, dict) else '',
            'selected_file': _i550_text((selected or {}).get('file')) if isinstance(selected, dict) else '',
            'selected_cot_type': raw_type if authority == 'event-type' else '',
            'selected_iconset_path': raw_iconset if authority == 'usericon-iconsetpath' else '',
            'custom_usericon_fallback': bool(authority == 'usericon-iconsetpath' and raw_iconset and not selected),
        }
        return decision, selected

    def _i550_apply_change_aware_symbol(obj, event, prior):
        if not isinstance(obj, dict):
            return obj
        current = _i550_current_symbol_values(event)
        decision, selected = _i550_choose_symbol(prior or {}, current)
        _i549_clear_derived_symbol(obj)
        if isinstance(selected, dict) and selected.get('ok'):
            _i549_apply_resolved_symbol(obj, selected)
            resolution = dict(obj.get('symbol_resolution_i549') or {})
            resolution.update({
                'version': 'i550',
                'source': 'change-aware-' + _i550_text(decision.get('authority')),
                'decision_reason': _i550_text(decision.get('reason')),
                'conflict': bool(decision.get('conflict')),
            })
            obj['symbol_resolution_i550'] = resolution
        else:
            obj.pop('symbol_resolution_i550', None)

        raw_sidc = _i550_text(current.get('sidc'))
        raw_type = _i550_text(current.get('cot_type'))
        raw_iconset = _i550_text(current.get('iconset_path'))
        if raw_sidc:
            obj['mission_cot_raw_sidc_i550'] = raw_sidc
            obj['data_sync_current_sidc_i550'] = raw_sidc
        if raw_type:
            obj['mission_cot_raw_type_i550'] = raw_type
            obj['data_sync_current_cot_type_i550'] = raw_type
            for key in ('type', 'cot_type', 'atak_cot_type', 'event_type'):
                obj[key] = raw_type
        if raw_iconset:
            obj['mission_cot_raw_iconset_path_i550'] = raw_iconset
            obj['data_sync_current_iconset_path_i550'] = raw_iconset
            obj['current_iconset_path_i550'] = raw_iconset
            for key in ('iconsetPath', 'iconsetpath', 'usericon_path'):
                obj[key] = raw_iconset
        obj['data_sync_symbol_decision_i550'] = dict(decision)
        obj['data_sync_icon_authority_i550'] = dict(decision)

        props = obj.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            for key in ('sidc', 'SIDC', 'mil2525_name', 'milstd2525_name', 'mil2525_file', 'mil2525_svg', 'mil2525_label', 'symbol_resolution_i549', 'symbol_resolution_i550'):
                props.pop(key, None)
            for key in ('sidc', 'SIDC', 'mil2525_name', 'mil2525_file', 'mil2525_label', 'symbol_resolution_i550'):
                if obj.get(key) not in (None, ''):
                    props[key] = obj.get(key)
            if raw_sidc:
                props['mission_cot_raw_sidc_i550'] = raw_sidc; props['data_sync_current_sidc_i550'] = raw_sidc
            if raw_type:
                props['mission_cot_raw_type_i550'] = raw_type; props['data_sync_current_cot_type_i550'] = raw_type
                for key in ('type', 'cot_type', 'atak_cot_type', 'event_type'):
                    props[key] = raw_type
            if raw_iconset:
                props['mission_cot_raw_iconset_path_i550'] = raw_iconset; props['data_sync_current_iconset_path_i550'] = raw_iconset; props['current_iconset_path_i550'] = raw_iconset
                for key in ('iconsetPath', 'iconsetpath', 'usericon_path'):
                    props[key] = raw_iconset
            props['data_sync_symbol_decision_i550'] = dict(decision)
