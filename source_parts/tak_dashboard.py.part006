# --- TAK Map i546 canonical Mission CoT identity, callsign, and symbol enrichment ---
try:
    _I546_ROOT = Path(__file__).resolve().parent
    _I546_RUNTIME_FILES = {
        '/assets/runtime/tak-map-core-i546.js': (_I546_ROOT / 'assets' / 'tak-map-core-i546.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-data-sync-i546.js': (_I546_ROOT / 'assets' / 'tak-map-data-sync-i546.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-startup-i546.js': (_I546_ROOT / 'assets' / 'tak-map-startup-i546.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-deferred-i546.json': (_I546_ROOT / 'assets' / 'tak-map-deferred-i546.json', 'application/json; charset=utf-8'),
        '/assets/runtime/tak-map-milstd2525c-i546.js': (_I546_ROOT / 'assets' / 'tak-map-milstd2525c-i546.js', 'application/javascript; charset=utf-8'),
    }

    _i546_get_before = Handler.do_GET
    def _i546_do_get(self):
        parsed = urlparse(self.path)
        runtime = _I546_RUNTIME_FILES.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i546-canonical-mission-cot-identity')
        return _i546_get_before(self)
    Handler.do_GET = _i546_do_get

    def _i546_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i546_key(value):
        return _i546_text(value).replace('-', '').replace('_', '').replace('@', '').casefold()

    def _i546_nested_dicts(value, max_depth=5, max_items=160):
        if not isinstance(value, dict):
            return []
        out = []
        seen = set()
        queue = [(value, 0)]
        while queue and len(out) < max_items:
            current, depth = queue.pop(0)
            if not isinstance(current, dict) or id(current) in seen:
                continue
            seen.add(id(current)); out.append(current)
            if depth >= max_depth:
                continue
            for nested in current.values():
                if isinstance(nested, dict):
                    queue.append((nested, depth + 1))
        return out

    def _i546_ci_value(source, names):
        if not isinstance(source, dict):
            return ''
        wanted = {_i546_key(name) for name in names}
        for key, value in source.items():
            if _i546_key(key) in wanted:
                text = _i546_text(value)
                if text and not isinstance(value, (dict, list, tuple)):
                    return text
        return ''

    def _i546_xml_values(value):
        values = []
        for source in _i546_nested_dicts(value):
            for item in source.values():
                if isinstance(item, str) and '<' in item and 'event' in item.casefold():
                    values.append(item)
                    if len(values) >= 32:
                        return values
        return values

    def _i546_xml_event_uids(value):
        out = []
        for xml in _i546_xml_values(value):
            for match in re.finditer(r'<(?:[A-Za-z0-9_.-]+:)?event\b[^>]*\buid=["\']([^"\']+)["\']', xml, re.I):
                uid = _i546_text(match.group(1))
                if uid and uid.casefold() not in {row.casefold() for row in out}:
                    out.append(uid)
        return out

    def _i546_nested_event_uids(value):
        out = []
        if not isinstance(value, dict):
            return out
        seen = set(); queue = [(value, 0)]
        while queue and len(seen) < 240:
            current, depth = queue.pop(0)
            if not isinstance(current, dict) or id(current) in seen:
                continue
            seen.add(id(current))
            for key, nested in current.items():
                folded = _i546_key(key)
                if folded in ('event', 'cotevent', 'missioncotevent') and isinstance(nested, dict):
                    uid = _i546_ci_value(nested, ('cot_uid','cotUid','event_uid','eventUid','uid','@uid'))
                    if uid and uid.casefold() not in {row.casefold() for row in out}:
                        out.append(uid)
                if depth < 5 and isinstance(nested, dict):
                    queue.append((nested, depth + 1))
        return out

    def _i546_canonical_uid_text(value):
        if not isinstance(value, dict):
            return ''
        sources = _i546_nested_dicts(value)
        # Explicit CoT/event identifiers always outrank generic Mission content IDs.
        for source in sources:
            uid = _i546_ci_value(source, ('cot_uid','cotUid','event_uid','eventUid','eventuid','cotuid'))
            if uid:
                return uid
        nested = _i546_nested_event_uids(value)
        if nested:
            return nested[0]
        xml_uids = _i546_xml_event_uids(value)
        if xml_uids:
            return xml_uids[0]
        # Generic UID/ID values are fallback-only and are intentionally checked last.
        for names in (('uid','@uid'), ('id','guid')):
            for source in sources:
                uid = _i546_ci_value(source, names)
                if uid:
                    return uid
        return ''

    def _i546_uid_aliases(value):
        if not isinstance(value, dict):
            return []
        aliases = []
        def add(raw):
            text = _i546_text(raw)
            folded = text.casefold()
            if text and folded not in {row.casefold() for row in aliases}:
                aliases.append(text)
        add(_i546_canonical_uid_text(value))
        for source in _i546_nested_dicts(value):
            for names in (
                ('cot_uid','cotUid','event_uid','eventUid','eventuid','cotuid'),
                ('uid','@uid'), ('id','guid'),
                ('mission_content_uid','missionContentUid','content_uid','contentUid'),
            ):
                add(_i546_ci_value(source, names))
        for uid in _i546_nested_event_uids(value): add(uid)
        for uid in _i546_xml_event_uids(value): add(uid)
        return aliases[:48]

    def _i537_object_uid(value):
        return _i546_canonical_uid_text(value).casefold()
    globals()['_i537_object_uid'] = _i537_object_uid

    def _i546_uuidish(value):
        text = _i546_text(value)
        return bool(re.fullmatch(r'[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}', text))

    def _i546_normalize_row_identity(row):
        if not isinstance(row, dict):
            return row
        obj = dict(row)
        original_uid = _i546_text(obj.get('uid'))
        original_id = _i546_text(obj.get('id'))
        canonical = _i546_canonical_uid_text(obj)
        aliases = _i546_uid_aliases(obj)
        if canonical:
            if original_uid and original_uid.casefold() != canonical.casefold():
                obj.setdefault('mission_content_uid', original_uid)
                obj.setdefault('content_uid', original_uid)
            if original_id and original_id.casefold() != canonical.casefold():
                obj.setdefault('mission_content_id', original_id)
            obj['uid'] = canonical
            obj['cot_uid'] = canonical
            obj['event_uid'] = canonical
            props = obj.get('properties')
            if isinstance(props, dict):
                props = dict(props)
                props['uid'] = canonical
                props['cot_uid'] = canonical
                props['event_uid'] = canonical
                obj['properties'] = props
            obj['canonical_cot_uid_i546'] = canonical
        if aliases:
            obj['data_sync_uid_aliases_i546'] = aliases
        return obj

    def _i546_event_callsign(event):
        if not isinstance(event, dict):
            return ''
        for source in _i546_nested_dicts(event):
            direct = _i546_ci_value(source, ('callsign','contact_callsign','contactCallsign'))
            if direct:
                return direct
            for key, nested in source.items():
                if _i546_key(key) == 'contact' and isinstance(nested, dict):
                    direct = _i546_ci_value(nested, ('callsign','name'))
                    if direct:
                        return direct
        for xml in _i546_xml_values(event):
            match = re.search(r'<(?:[A-Za-z0-9_.-]+:)?contact\b[^>]*\bcallsign=["\']([^"\']+)["\']', xml, re.I)
            if match:
                return _i546_text(match.group(1))
        return ''

    def _i546_apply_callsign(row, callsign):
        if not isinstance(row, dict) or not _i546_text(callsign):
            return row
        obj = dict(row); callsign = _i546_text(callsign)
        aliases = {value.casefold() for value in _i546_uid_aliases(obj)}
        prior_name = _i546_text(obj.get('name'))
        if prior_name and prior_name.casefold() != callsign.casefold():
            obj.setdefault('mission_content_name', prior_name)
        obj['callsign'] = callsign
        obj['contact_callsign'] = callsign
        obj['name'] = callsign
        obj['display_name'] = callsign
        obj['label'] = callsign
        title = _i546_text(obj.get('title'))
        if not title or title.casefold() in aliases or _i546_uuidish(title):
            obj['title'] = callsign
        props = obj.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            props['callsign'] = callsign
            props['name'] = callsign
            props['display_name'] = callsign
            obj['properties'] = props
        obj['data_sync_display_name_source_i546'] = 'mission-cot-contact-callsign'
        return obj

    _i546_merge_event_before = _i545_merge_event
    def _i545_merge_event(row, event):
        normalized = _i546_normalize_row_identity(row)
        merged, applied, reason = _i546_merge_event_before(normalized, event)
        callsign = _i546_event_callsign(event)
        if not applied and reason == 'event-has-no-symbol-identity' and callsign:
            merged = dict(normalized); applied = True; reason = 'merged-callsign-only'
        if applied:
            merged = _i546_normalize_row_identity(merged)
            if callsign:
                merged = _i546_apply_callsign(merged, callsign)
            if '_i537_apply_symbol' in globals():
                _i537_apply_symbol(merged, event, event.get('mission_cot_xml'))
            merged['data_sync_symbol_fingerprint_i546'] = _i545_symbol_fingerprint(merged)
            merged['data_sync_symbol_changed_i546'] = bool(merged.get('data_sync_symbol_changed_i545'))
            merged['data_sync_symbol_enrichment_i546'] = {
                'version': 'i546',
                'source': 'GET /Marti/api/missions/{mission}/cot',
                'canonical_cot_uid': _i546_canonical_uid_text(merged),
                'exact_alias_join': True,
                'callsign_merged': bool(callsign),
                'metadata_preserved_even_when_svg_missing': True,
            }
        return merged, applied, reason
    globals()['_i545_merge_event'] = _i545_merge_event

    def _i546_best_event_for_aliases(events, aliases):
        matches = []
        seen = set()
        for alias in aliases:
            event = events.get(_i546_text(alias).casefold())
            if isinstance(event, dict) and id(event) not in seen:
                seen.add(id(event)); matches.append(event)
        if not matches:
            return None
        def rank(event):
            epoch = event.get('mission_cot_event_epoch')
            if epoch is None:
                epoch = _i545_row_epoch(event)
            return (float(epoch) if epoch is not None else float('-inf'), _i545_event_detail_score(event))
        return max(matches, key=rank)

    def _i545_apply_cached_enrichment(out, cfg, sess, missions):
        if not isinstance(out, dict):
            return out
        cached = _i545_cached_enrichment(cfg, sess, missions)
        events = {str(key).casefold(): value for key, value in dict(cached.get('events') or {}).items()}
        before_rows = list(out.get('objects') or [])
        rows = []
        matched = changed = stale_skipped = alias_matches = 0
        for row in before_rows:
            if not isinstance(row, dict):
                continue
            normalized = _i546_normalize_row_identity(row)
            aliases = _i546_uid_aliases(normalized)
            event = _i546_best_event_for_aliases(events, aliases)
            if not event:
                normalized['data_sync_symbol_fingerprint_i545'] = _i545_symbol_fingerprint(normalized)
                normalized['data_sync_symbol_fingerprint_i546'] = normalized['data_sync_symbol_fingerprint_i545']
                rows.append(normalized)
                continue
            canonical = _i546_canonical_uid_text(normalized).casefold()
            if canonical and events.get(canonical) is not event:
                alias_matches += 1
            merged, applied, reason = _i545_merge_event(normalized, event)
            if applied:
                matched += 1
                if merged.get('data_sync_symbol_changed_i545') or merged.get('data_sync_symbol_changed_i546'):
                    changed += 1
            elif reason == 'mission-cot-event-older-than-database-row':
                stale_skipped += 1
            rows.append(merged)
        out = dict(out); out['objects'] = rows
        record = cached.get('record') or {}
        diag = {
            'version': 'i546',
            'mode': 'asynchronous-exact-canonical-uid-alias-newest-event',
            'cache_present': bool(cached.get('present')),
            'cache_fresh': bool(cached.get('fresh')),
            'cache_age_seconds': cached.get('age_seconds'),
            'requested_missions': list(missions),
            'cached_event_count': len(events),
            'objects_matched': matched,
            'exact_alias_matches': alias_matches,
            'symbol_fingerprints_changed': changed,
            'older_events_skipped': stale_skipped,
            'request_blocks_data_sync': False,
            'poll_applies_updates_within_seconds': 10,
            'metadata_preserved_even_when_svg_missing': True,
            'callsign_merge_enabled': True,
            'generic_content_uuid_never_outranks_event_uid': True,
            'cache_ok': bool(record.get('ok')),
            'cache_error': _i546_text(record.get('error')),
            'mission_results': list(record.get('missions') or []),
        }
        out['mission_cot_symbol_enrichment_i546'] = dict(diag)
        out['mission_cot_symbol_enrichment_i545'] = dict(diag)
        if '_i537_update_mission_uid_cache' in globals():
            _i537_update_mission_uid_cache(out)
        return out
    globals()['_i545_apply_cached_enrichment'] = _i545_apply_cached_enrichment

    def _i546_row_detail_score(row):
        if not isinstance(row, dict):
            return 0
        score = 0
        callsign = _i546_text(row.get('callsign'))
        if callsign and not _i546_uuidish(callsign): score += 12
        if _i546_text(row.get('mil2525_file')): score += 10
        if _i546_text(row.get('sidc') or row.get('SIDC')): score += 8
        if _i546_text(row.get('cot_type') or row.get('type')): score += 6
        if row.get('lat') is not None and row.get('lon') is not None: score += 4
        if _i546_text(row.get('mission_cot_xml')): score += 4
        if _i546_text(row.get('mission_name') or row.get('mission')): score += 2
        return score

    def _i546_dedupe_rows(rows):
        out = []
        by_uid = {}
        removed = []
        for raw in rows or []:
            if not isinstance(raw, dict):
                continue
            row = _i546_normalize_row_identity(raw)
            uid = _i546_canonical_uid_text(row).casefold()
            point_like = _i537_point_like(row) if '_i537_point_like' in globals() else bool(row.get('lat') is not None and row.get('lon') is not None)
            if not uid or not point_like:
                out.append(row); continue
            if uid not in by_uid:
                by_uid[uid] = len(out); out.append(row); continue
            index = by_uid[uid]; current = out[index]
            current_epoch = _i545_row_epoch(current); row_epoch = _i545_row_epoch(row)
            current_rank = (float(current_epoch) if current_epoch is not None else float('-inf'), _i546_row_detail_score(current))
            row_rank = (float(row_epoch) if row_epoch is not None else float('-inf'), _i546_row_detail_score(row))
            winner, loser = (row, current) if row_rank > current_rank else (current, row)
            merged = dict(winner)
            for key, value in loser.items():
                if key not in merged or merged.get(key) in (None, '', [], {}):
                    merged[key] = value
            aliases = []
            for item in _i546_uid_aliases(current) + _i546_uid_aliases(row):
                if item.casefold() not in {x.casefold() for x in aliases}: aliases.append(item)
            if aliases: merged['data_sync_uid_aliases_i546'] = aliases
            out[index] = merged
            if len(removed) < 80:
                removed.append({'canonical_uid': uid, 'removed_source': _i546_text(loser.get('source') or loser.get('source_table'))})
        return out, removed

    _i546_augment_before = _i512_augment_data_sync
    def _i512_augment_data_sync(base, cfg, sess):
        out = _i546_augment_before(base, cfg, sess)
        out = dict(out or {})
        normalized = [_i546_normalize_row_identity(row) for row in list(out.get('objects') or []) if isinstance(row, dict)]
        normalized, duplicates = _i546_dedupe_rows(normalized)
        out['objects'] = normalized
        # Recalculate canonical Data Sync object IDs and Mission API deletion targets
        # after the authoritative event UID has replaced any content-record UUID.
        if '_tak_enrich_data_sync_result' in globals():
            out = _tak_enrich_data_sync_result(out)
        for row in list(out.get('objects') or []):
            if isinstance(row, dict):
                canonical = _i546_canonical_uid_text(row)
                if canonical:
                    row['uid'] = canonical; row['cot_uid'] = canonical; row['event_uid'] = canonical
        legacy_tombstones = out.get('data_sync_deleted_uid_tombstones_i545') or out.get('data_sync_deleted_uid_tombstones_i543')
        if isinstance(legacy_tombstones, dict):
            current = dict(legacy_tombstones); current['version'] = 'i546'
            out['data_sync_deleted_uid_tombstones_i546'] = current
        diag = dict(out.get('mission_cot_symbol_enrichment_i546') or out.get('mission_cot_symbol_enrichment_i545') or {})
        old_diag = dict(out.get('mission_cot_symbol_enrichment_i545') or {})
        for key in ('background_refresh_scheduled','background_refresh_reason'):
            if key in old_diag: diag[key] = old_diag[key]
        diag.update({
            'version': 'i546',
            'canonical_uid_priority': ['cot_uid','event_uid','nested-event-uid','xml-event-uid','uid','id'],
            'mission_content_uuid_preserved_separately': True,
            'duplicate_canonical_point_rows_removed': len(duplicates),
            'duplicate_removal_sample': duplicates,
            'display_name_source': 'contact-callsign',
        })
        out['mission_cot_symbol_enrichment_i546'] = diag
        out['version'] = 'i546'
        return out
    globals()['_i512_augment_data_sync'] = _i512_augment_data_sync

    _i546_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i546_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(str(built.get('wire_xml') or built.get('xml') or '').strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None: takv.set('version', '1.3.0-i546')
                meta = detail.find('takmap_user_presence')
                if meta is not None: meta.set('version', 'i546')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i546'
        except Exception as exc:
            built['i546_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i546_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = _i546_presence_public_before(token, state)
        if isinstance(out, dict):
            out = dict(out); out['version'] = 'i546'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i546_config_before = tak_map_config
