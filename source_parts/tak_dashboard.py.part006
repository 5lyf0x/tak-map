        cfg['tak_map_iteration'] = 'i546'
        cfg['version'] = '1.3.0-i546'
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version': 'i546',
            'automatic_poll_seconds': 10,
            'canonical_cot_uid_priority': True,
            'content_uuid_separated_from_event_uid': True,
            'mission_cot_exact_alias_join': True,
            'mission_cot_callsign_merge': True,
            'mission_cot_display_name_from_contact': True,
            'canonical_point_deduplication': True,
            'same_uid_symbol_updates': True,
            'deleted_uid_tombstones': True,
        })
        cfg['data_sync_control'] = control
        mil = dict(cfg.get('milstd2525c') or {})
        mil.update({
