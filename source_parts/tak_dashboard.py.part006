    def _i563_delete_xml(uid, name='', lat=None, lon=None, reason='delete'):
        now = datetime.now(timezone.utc); stale = now + timedelta(seconds=12)
        lat = _i555_float(lat); lon = _i555_float(lon)
        if lat is None: lat = 0.0
        if lon is None: lon = 0.0
        root = ET.Element('event', {'version':'2.0','uid':_i555_text(uid),'type':'t-x-d-d','how':'h-e',
            'time':_cot_time(now),'start':_cot_time(now),'stale':_cot_time(stale),'access':'Undefined'})
        ET.SubElement(root,'point',{'lat':f'{lat:.7f}','lon':f'{lon:.7f}','hae':'0.0','ce':'9999999.0','le':'9999999.0'})
        detail = ET.SubElement(root,'detail')
        ET.SubElement(detail,'contact',{'callsign':(_i555_text(name) or _i555_text(uid))[:120]})
        ET.SubElement(detail,'remarks').text = ('TAK Map i563 ' + _i555_text(reason))[:3000]
        ET.SubElement(detail,'takmap_delete',{'version':'i563','reason':_i555_text(reason)[:120]})
        return '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)

    def _i563_send_terminal(uid, name='', lat=None, lon=None, reason='delete'):
