    _I542_DB_SCOPE_TTL_SECONDS = 45.0

    def _i542_scope_username(sess):
        sess = dict(sess or {})
        profile = dict(sess.get('profile') or {})
        return _i539_text(
            sess.get('username') or profile.get('username') or
            sess.get('certificate_cn') or profile.get('certificate_cn')
        )

    def _i542_database_mission_scope(cfg, sess):
        """Resolve mission visibility through independent OTS account queries.

        MissionRole.clientUid is device-specific. A mission subscribed from ATAK can
        belong to the same OTS account without matching TAK Map's own EUD UID. Resolve
        the account's EUDs through both euds.user_id and certificates.eud_uid, then
        query direct roles, group-visible missions, and owned missions independently.
        A schema difference in one optional relationship cannot erase results from the
        other proven relationships.
        """
        username = _i542_scope_username(sess)
        if not username:
            return {'ok': False, 'missions': [], 'direct': [], 'groups': [], 'owned': [], 'error': 'missing-user-identity', 'errors': [], 'cached': False}
        key = username.casefold()
        now = time.time()
        with _I542_DB_SCOPE_LOCK:
            cached = dict(_I542_DB_SCOPE_CACHE.get(key) or {})
        if cached and now - float(cached.get('time') or 0.0) <= _I542_DB_SCOPE_TTL_SECONDS:
            cached['cached'] = True
            return cached

        uris, _errors = _candidate_ots_pg_uris()
        if not uris:
            return {'ok': False, 'missions': [], 'direct': [], 'groups': [], 'owned': [], 'error': 'ots-postgresql-unavailable', 'errors': [], 'cached': False}
        uri = uris[0]
        user_sql = _pg_sql_literal(username)
        _usernames, session_uid_set = _i540_session_identities(sess)
        owned_uids = {value for value in session_uid_set if value}
        errors = []
        successful_queries = 0

        def rows_for(label, sql):
            nonlocal successful_queries
            rows, err = _pg_rows_json(uri, sql)
            if err:
                errors.append({'query': label, 'error': _i539_text(err) or 'query-failed'})
                return []
            successful_queries += 1
            return [row for row in rows if isinstance(row, dict)]

        # EUDs directly linked to the authenticated OTS user.
        rows = rows_for('euds-user', f"""
select row_to_json(q) from (
  select distinct e.uid
    from public.euds e
    join public."user" u on u.id=e.user_id
   where lower(u.username)=lower({user_sql}) and coalesce(e.uid,'')<>''
) q
""")
        for row in rows:
            value = _i539_text(row.get('uid')).casefold()
            if value:
                owned_uids.add(value)

        # Certificate enrollment is a second authoritative account-to-EUD link.
        rows = rows_for('certificates-user', f"""
select row_to_json(q) from (
  select distinct c.eud_uid as uid
    from public.certificates c
   where c.eud_uid is not null
     and (lower(coalesce(c.username,''))=lower({user_sql})
       or lower(coalesce(c.common_name,''))=lower({user_sql}))
) q
""")
        for row in rows:
            value = _i539_text(row.get('uid')).casefold()
            if value:
                owned_uids.add(value)

        uid_sql = ','.join(_pg_sql_literal(value) for value in sorted(owned_uids)) or "''"
        direct = []
        rows = rows_for('mission-roles', f"""
select row_to_json(q) from (
  select distinct mr.mission_name
    from public.mission_roles mr
   where coalesce(mr.mission_name,'')<>''
     and (lower(coalesce(mr.username,''))=lower({user_sql})
       or lower(coalesce(mr."clientUid",'')) in ({uid_sql}))
) q
""")
        for row in rows:
            value = _i539_text(row.get('mission_name'))
            if value:
                direct.append(value)

        groups = []
        rows = rows_for('group-missions', f"""
select row_to_json(q) from (
  select distinct gm.mission_name
    from public.groups_missions gm
    join public.groups_users gu on gu.group_id=gm.group_id
    join public."user" u on u.id=gu.user_id
   where lower(u.username)=lower({user_sql})
     and coalesce(gu.enabled,true)=true
     and upper(coalesce(gu.direction,'IN')) in ('IN','BOTH')
     and coalesce(gm.mission_name,'')<>''
) q
""")
        for row in rows:
            value = _i539_text(row.get('mission_name'))
            if value:
                groups.append(value)

        owned = []
        rows = rows_for('owned-missions', f"""
select row_to_json(q) from (
  select distinct m.name as mission_name
    from public.missions m
   where lower(coalesce(m.creator_uid,'')) in ({uid_sql})
     and coalesce(m.name,'')<>''
) q
""")
        for row in rows:
            value = _i539_text(row.get('mission_name'))
            if value:
                owned.append(value)

        missions = []
        seen = set()
        for value in direct + groups + owned:
            folded = value.casefold()
            if folded and folded not in seen:
                seen.add(folded)
                missions.append(value)
        # The mission_roles query is the minimum authoritative scope source. Other
        # relationship failures are reported as partial but do not erase direct roles.
        direct_query_ok = not any(row.get('query') == 'mission-roles' for row in errors)
        record = {
            'ok': bool(direct_query_ok),
            'partial': bool(errors),
            'missions': missions,
            'direct': sorted(set(direct), key=str.casefold),
            'groups': sorted(set(groups), key=str.casefold),
            'owned': sorted(set(owned), key=str.casefold),
            'owned_eud_uids': sorted(owned_uids),
            'successful_queries': successful_queries,
            'errors': errors,
            'error': '' if direct_query_ok else 'ots-database-mission-role-scope-failed',
            'cached': False,
            'time': time.time(),
        }
        with _I542_DB_SCOPE_LOCK:
            _I542_DB_SCOPE_CACHE[key] = dict(record)
        return record

    def _i512_augment_data_sync(base, cfg, sess):
        out = dict(base or {})
        cfg = dict(cfg or {})
        sess = dict(sess or {})
        admin = _i540_is_admin(sess)
        raw_direct = _i540_direct_role_missions(out, sess)
        database_scope = _i542_database_mission_scope(cfg, sess)
        cached_api = _i540_cached_scope(cfg, sess)
        api_names = list(cached_api.get('missions') or [])

        allowed=[]; seen=set()
        sources = (
            list(raw_direct) +
            list(database_scope.get('missions') or []) +
            api_names
        )
        for name in sources:
            value=_i539_text(name)
            folded=value.casefold()
            if value and folded not in seen:
                seen.add(folded); allowed.append(value)

        if admin:
            allowed=[]
            for row in list(out.get('missions') or []):
                if not isinstance(row, dict):
                    continue
                value=_i539_text(_tak_row_value(row, ('name','mission_name','missionName','title'), ''))
                if value and value.casefold() not in {x.casefold() for x in allowed}:
                    allowed.append(value)

        # Database scope is authoritative when the account query succeeds. The
        # remote Marti list may add group-visible missions but an empty response
        # can never remove database-proven direct/group/owner access.
        scope_authoritative = bool(admin or database_scope.get('ok') or raw_direct or cached_api.get('ok'))
        out = _i539_filter_deleted_orphans(out, allowed if scope_authoritative else None)
        scheduled = _i540_schedule_scope_refresh(cfg, sess)
        api_record = cached_api.get('record') or {}
        out['mission_api_user_scope_i512'] = {
            'version': 'i542',
            'state': 'database-account-scope' if database_scope.get('ok') else ('raw-role' if raw_direct else ('cached-api' if cached_api.get('ok') else 'refreshing')),
            'mission_count': len(allowed),
            'objects_added': 0,
            'identity': _i542_scope_username(sess),
            'identity_mode': _i539_text(api_record.get('identity_mode') or 'per-user-enrolled-marti-certificate'),
            'certificate_cn': _i539_text(api_record.get('certificate_cn')),
            'client_uid': _i539_text(api_record.get('client_uid') or sess.get('tak_uid') or (sess.get('profile') or {}).get('tak_uid')),
            'cached': bool(cached_api.get('present')),
            'cached_scope_ok': bool(cached_api.get('ok')),
            'cached_scope_age_seconds': cached_api.get('age_seconds'),
            'probe_duration_ms': 0,
            'probe_blocked_request': False,
            'background_refresh_scheduled': bool(scheduled.get('scheduled')),
            'background_refresh_reason': scheduled.get('reason'),
            'raw_direct_role_missions': raw_direct,
            'database_scope_ok': bool(database_scope.get('ok')),
            'database_scope_cached': bool(database_scope.get('cached')),
            'database_direct_role_missions': list(database_scope.get('direct') or []),
            'database_group_missions': list(database_scope.get('groups') or []),
            'database_owned_missions': list(database_scope.get('owned') or []),
            'database_scope_error': _i539_text(database_scope.get('error')),
            'cached_group_missions': api_names,
            'effective_missions': allowed,
            'empty_api_preserves_database_scope': True,
            'device_uid_resolved_through_eud_user': True,
            'certificate_eud_scope_supported': True,
            'database_object_read': True,
            'invalid_contents_get_removed': True,
            'shared_service_probe_removed': True,
            'scope_fallback': '' if scope_authoritative else 'database-unscoped-until-account-scope-known',
            'endpoints': [{
                'endpoint': 'per-user-marti-background',
                'path': '/Marti/api/missions',
                'status': int(api_record.get('status') or 0),
                'ok': bool(api_record.get('ok')),
                'error': _i539_text(api_record.get('error')),
            }],
        }
        return out
    globals()['_i512_augment_data_sync'] = _i512_augment_data_sync

    _i542_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i542_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(str(built.get('wire_xml') or built.get('xml') or '').strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None:
                    takv.set('version', '1.3.0-i542')
                meta = detail.find('takmap_user_presence')
                if meta is not None:
                    meta.set('version', 'i542')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i542'
        except Exception as exc:
            built['i542_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i542_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = _i542_presence_public_before(token, state)
        if isinstance(out, dict):
            out = dict(out); out['version'] = 'i542'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i542_config_before = tak_map_config
    def tak_map_config():
        cfg = _i542_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration']='i542'
        cfg['version']='1.3.0-i542'
        control=dict(cfg.get('data_sync_control') or {})
        control.update({
            'version':'i542',
            'startup_refresh_owner':'post-shell-core',
            'startup_refresh_count':1,
            'startup_render_verified':True,
            'mission_role_device_uid_account_resolution':True,
            'mission_group_database_scope':True,
            'automatic_poll_seconds':300,
            'main_interface_waits_for_data_sync':False,
        })
        cfg['data_sync_control']=control
        startup=dict(cfg.get('startup_architecture_i541') or {})
        startup.update({
            'version':'i542',
            'broad_mutation_observers_parked_until_initial_data':True,
            'mutation_records_startup_budget':50000,
            'mutation_callbacks_startup_budget':1000,
            'maximum_long_task_ms':200,
            'data_sync_render_result_required':True,
            'draw_patch_waits_for_map':True,
            'startup_diagnostics_global':'TakMapStartupDiagnosticsI542',
            'shell_ready_event':'takmap:shell-ready-i542',
            'runtime_ready_event':'takmap:runtime-ready-i542',
        })
        cfg['startup_architecture_i542']=startup
        return cfg
    globals()['tak_map_config']=tak_map_config

    def _i542_patch_main_html(html):
        if not isinstance(html, str):
            return html
        html=html.replace('1.3.0-i541','1.3.0-i542').replace('TAKDashboard/i541','TAKDashboard/i542').replace('TAK-Map/1.3.0 i541','TAK-Map/1.3.0 i542')
        html=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i542\2',html)
        html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i542\2',html)
        html=html.replace('/assets/runtime/tak-map-startup-i541.js?v=1.3.0-i542','/assets/runtime/tak-map-startup-i542.js?v=1.3.0-i542').replace('/assets/runtime/tak-map-startup-i541.js?v=1.3.0-i541','/assets/runtime/tak-map-startup-i542.js?v=1.3.0-i542')
        return html

    TAK_MAP_HTML=_i542_patch_main_html(TAK_MAP_HTML)
    INDEX_HTML=TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML=_i542_patch_main_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION='i542'
except Exception as _i542_exc:
    try:
        print('TAK Map i542 account-aware Data Sync/startup gate patch failed:', _i542_exc)
    except Exception:
        pass
# --- end TAK Map i542 account-aware Data Sync + bounded startup observer gate ---


# --- TAK Map i543 10-second Data Sync polling + exact-UID deletion tombstones ---
try:
    _I543_ROOT = Path(__file__).resolve().parent
    _I543_RUNTIME_FILES = {
        '/assets/runtime/tak-map-core-i543.js': (_I543_ROOT / 'assets' / 'tak-map-core-i543.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-data-sync-i543.js': (_I543_ROOT / 'assets' / 'tak-map-data-sync-i543.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-startup-i543.js': (_I543_ROOT / 'assets' / 'tak-map-startup-i543.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-deferred-i543.json': (_I543_ROOT / 'assets' / 'tak-map-deferred-i543.json', 'application/json; charset=utf-8'),
        '/assets/runtime/tak-map-milstd2525c-i543.js': (_I543_ROOT / 'assets' / 'tak-map-milstd2525c-i543.js', 'application/javascript; charset=utf-8'),
    }

    _i543_get_before = Handler.do_GET
    def _i543_do_get(self):
        parsed = urlparse(self.path)
        runtime = _I543_RUNTIME_FILES.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i543-data-sync')
        return _i543_get_before(self)
    Handler.do_GET = _i543_do_get

    _I543_TOMBSTONE_LOCK = threading.RLock()
    _I543_TOMBSTONES = {}
    _I543_TOMBSTONE_LIMIT = 5000
    _I543_NEW_EVENT_SKEW_SECONDS = 1.0

    def _i543_identity_key():
        return _i537_text(_i537_identity_key()).casefold() if '_i537_identity_key' in globals() else ''

    def _i543_event_epoch(row):
        if not isinstance(row, dict):
            return None
        values = []
        for key in ('updated','timestamp','time','start','event_time','eventTime','stale','submission_time','created_at'):
            value = row.get(key)
            if value not in (None, ''):
                values.append(value)
        props = row.get('properties')
        if isinstance(props, dict):
            for key in ('updated','timestamp','time','start','event_time','eventTime','stale'):
                value = props.get(key)
                if value not in (None, ''):
                    values.append(value)
        try:
            parsed = _parse_cot_text_fields(row)
        except Exception:
            parsed = {}
        if isinstance(parsed, dict):
            for key in ('updated','timestamp','time','start','event_time','eventTime','stale'):
                value = parsed.get(key)
                if value not in (None, ''):
                    values.append(value)
        for value in values:
            try:
                if isinstance(value, (int, float)) and math.isfinite(float(value)):
                    number = float(value)
                    return number / 1000.0 if number > 100000000000.0 else number
            except Exception:
                pass
            try:
                parsed_epoch = _parse_ts_epoch(value)
                if parsed_epoch is not None:
                    return float(parsed_epoch)
            except Exception:
                pass
        return None

    def _i543_orphan_rows(payload, allowed_missions=None):
        if not isinstance(payload, dict):
            return []
        candidate = dict(payload)
        if allowed_missions is not None:
            candidate = _i539_scope_raw_rows(candidate, allowed_missions)
        candidate = _tak_enrich_data_sync_result(candidate)
        uid_missions, _, _ = _tak_data_sync_ownership(candidate)
        normalized = {
            _i539_text(uid).casefold(): {_i539_text(name).casefold() for name in names if _i539_text(name)}
            for uid, names in uid_missions.items()
        }
        rows = []
        for row in list(candidate.get('objects') or []):
            if not isinstance(row, dict):
                continue
            uid = _i537_object_uid(row) if '_i537_object_uid' in globals() else _i539_text(row.get('uid')).casefold()
            if not uid:
                continue
            source = _i539_text(row.get('source') or row.get('source_table')).casefold()
            point_like = _i537_point_like(row) if '_i537_point_like' in globals() else bool(row.get('lat') is not None and row.get('lon') is not None)
            explicit = _i539_text(row.get('mission_name') or row.get('mission')).casefold()
            if point_like and ('mission_uids' in source or 'mission uid' in source or _i539_text(row.get('source_table')).casefold() == 'mission_uids') and not normalized.get(uid) and not explicit:
                rows.append(row)
        return rows

    def _i543_active_point_uids(payload):
        result = set()
        if not isinstance(payload, dict):
            return result
        for row in list(payload.get('objects') or []):
            if not isinstance(row, dict):
                continue
            if '_i537_point_like' in globals() and not _i537_point_like(row):
                continue
            uid = _i537_object_uid(row) if '_i537_object_uid' in globals() else _i539_text(row.get('uid')).casefold()
            if uid:
                result.add(uid)
        return result

    def _i543_update_tombstones(source_payload, filtered_payload, allowed_missions=None):
        key = _i543_identity_key()
        if not key or not isinstance(filtered_payload, dict):
            return []
        now = time.time()
        orphan_rows = _i543_orphan_rows(source_payload, allowed_missions)
        active = _i543_active_point_uids(filtered_payload)
        with _I543_TOMBSTONE_LOCK:
            bucket = dict(_I543_TOMBSTONES.get(key) or {})
            for uid in active:
                bucket.pop(uid, None)
            for row in orphan_rows:
                uid = _i537_object_uid(row) if '_i537_object_uid' in globals() else _i539_text(row.get('uid')).casefold()
                if not uid or uid in active:
                    continue
                event_epoch = _i543_event_epoch(row)
                old = dict(bucket.get(uid) or {})
                observed = float(old.get('observed_at_epoch') or now)
                cutoff = float(event_epoch if event_epoch is not None else old.get('cutoff_epoch') or observed)
                bucket[uid] = {
                    'uid': uid,
                    'name': _i539_text(row.get('callsign') or row.get('name') or row.get('title')),
                    'observed_at_epoch': observed,
                    'cutoff_epoch': cutoff,
                    'source_event_epoch': float(event_epoch) if event_epoch is not None else None,
                    'reason': 'Mission association removed; suppress retained Live TAK/EUD copies until a newer CoT event is observed.',
                }
            if len(bucket) > _I543_TOMBSTONE_LIMIT:
                ordered = sorted(bucket.items(), key=lambda item: float((item[1] or {}).get('observed_at_epoch') or 0), reverse=True)
                bucket = dict(ordered[:_I543_TOMBSTONE_LIMIT])
            _I543_TOMBSTONES[key] = bucket
            return [dict(row) for row in bucket.values()]

    def _i543_tombstones(identity_key=''):
        key = _i537_text(identity_key or _i543_identity_key()).casefold()
        if not key:
            return []
        with _I543_TOMBSTONE_LOCK:
            return [dict(row) for row in (_I543_TOMBSTONES.get(key) or {}).values()]

    _i543_orphan_filter_before = _i539_filter_deleted_orphans
    def _i539_filter_deleted_orphans(payload, allowed_missions=None):
        out = _i543_orphan_filter_before(payload, allowed_missions)
        if isinstance(out, dict):
            tombstones = _i543_update_tombstones(payload, out, allowed_missions)
            out['data_sync_deleted_uid_tombstones_i543'] = {
                'version': 'i543',
                'mode': 'exact-uid-event-cutoff',
                'count': len(tombstones),
                'uids': [row.get('uid') for row in tombstones],
                'tombstones': tombstones,
                'survives_browser_reload': True,
                'newer_cot_releases_tombstone': True,
            }
        return out
    globals()['_i539_filter_deleted_orphans'] = _i539_filter_deleted_orphans

    def _i543_filter_live_payload(out, key_name):
        if not isinstance(out, dict):
            return out
        rows = list(out.get(key_name) or [])
        tombstones = {row.get('uid'): row for row in _i543_tombstones() if row.get('uid')}
        if not tombstones:
            out['data_sync_deleted_uid_live_filter_i543'] = {'version':'i543','removed_count':0,'released_count':0,'active_tombstones':0}
            return out
        kept, removed, released = [], [], []
        identity = _i543_identity_key()
        for row in rows:
            uid = _i537_object_uid(row) if '_i537_object_uid' in globals() else _i539_text((row or {}).get('uid')).casefold()
            tombstone = tombstones.get(uid)
            if not uid or not tombstone:
                kept.append(row)
                continue
            event_epoch = _i543_event_epoch(row)
            cutoff = float(tombstone.get('cutoff_epoch') or tombstone.get('observed_at_epoch') or 0)
            if event_epoch is not None and float(event_epoch) > cutoff + _I543_NEW_EVENT_SKEW_SECONDS:
                kept.append(row)
                released.append(uid)
                with _I543_TOMBSTONE_LOCK:
                    bucket = _I543_TOMBSTONES.get(identity) or {}
                    bucket.pop(uid, None)
                continue
            removed.append(uid)
        out[key_name] = kept
        out['data_sync_deleted_uid_live_filter_i543'] = {
            'version':'i543',
            'mode':'exact-uid-event-cutoff',
            'rows_before':len(rows),
            'rows_after':len(kept),
            'removed_count':len(removed),
            'removed_uids':removed[:80],
            'released_count':len(released),
            'released_uids':released[:80],
            'active_tombstones':len(tombstones),
        }
        return out

    _i543_cot_before = tak_map_cot_markers
    def tak_map_cot_markers():
        return _i543_filter_live_payload(_i543_cot_before(), 'markers')
    globals()['tak_map_cot_markers'] = tak_map_cot_markers

    _i543_euds_before = tak_map_euds
    def tak_map_euds():
        return _i543_filter_live_payload(_i543_euds_before(), 'euds')
    globals()['tak_map_euds'] = tak_map_euds

    _i543_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i543_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(str(built.get('wire_xml') or built.get('xml') or '').strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None:
                    takv.set('version', '1.3.0-i543')
                meta = detail.find('takmap_user_presence')
                if meta is not None:
                    meta.set('version', 'i543')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i543'
        except Exception as exc:
            built['i543_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i543_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = _i543_presence_public_before(token, state)
        if isinstance(out, dict):
            out = dict(out); out['version'] = 'i543'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i543_config_before = tak_map_config
    def tak_map_config():
        cfg = _i543_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i543'
        cfg['version'] = '1.3.0-i543'
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version':'i543',
            'automatic_poll_seconds':10,
            'startup_refresh_owner':'post-shell-core',
            'startup_refresh_count':1,
            'single_flight':True,
            'deleted_uid_tombstones':True,
            'deleted_uid_tombstone_mode':'exact-uid-event-cutoff',
            'newer_cot_releases_tombstone':True,
            'main_interface_waits_for_data_sync':False,
        })
        cfg['data_sync_control'] = control
        startup = dict(cfg.get('startup_architecture_i542') or cfg.get('startup_architecture_i541') or {})
        startup.update({'version':'i543','data_sync_poll_seconds':10,'startup_diagnostics_global':'TakMapStartupDiagnosticsI543','shell_ready_event':'takmap:shell-ready-i543','runtime_ready_event':'takmap:runtime-ready-i543'})
        cfg['startup_architecture_i543'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i543_patch_main_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i542','1.3.0-i543').replace('TAKDashboard/i542','TAKDashboard/i543').replace('TAK-Map/1.3.0 i542','TAK-Map/1.3.0 i543')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i543\2',html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i543\2',html)
        html = html.replace('/assets/runtime/tak-map-startup-i542.js?v=1.3.0-i543','/assets/runtime/tak-map-startup-i543.js?v=1.3.0-i543').replace('/assets/runtime/tak-map-startup-i542.js?v=1.3.0-i542','/assets/runtime/tak-map-startup-i543.js?v=1.3.0-i543')
        return html

    TAK_MAP_HTML = _i543_patch_main_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i543_patch_main_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i543'
except Exception as _i543_exc:
    try:
        print('TAK Map i543 Data Sync polling/tombstone patch failed:', _i543_exc)
    except Exception:
        pass
# --- end TAK Map i543 10-second Data Sync polling + exact-UID deletion tombstones ---


# --- TAK Map i545 asynchronous Mission GET /cot symbol enrichment ---
try:
    _I545_ROOT = Path(__file__).resolve().parent
    _I545_RUNTIME_FILES = {
        '/assets/runtime/tak-map-core-i545.js': (_I545_ROOT / 'assets' / 'tak-map-core-i545.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-data-sync-i545.js': (_I545_ROOT / 'assets' / 'tak-map-data-sync-i545.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-startup-i545.js': (_I545_ROOT / 'assets' / 'tak-map-startup-i545.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-deferred-i545.json': (_I545_ROOT / 'assets' / 'tak-map-deferred-i545.json', 'application/json; charset=utf-8'),
        '/assets/runtime/tak-map-milstd2525c-i545.js': (_I545_ROOT / 'assets' / 'tak-map-milstd2525c-i545.js', 'application/javascript; charset=utf-8'),
    }

    _i545_get_before = Handler.do_GET
    def _i545_do_get(self):
        parsed = urlparse(self.path)
        runtime = _I545_RUNTIME_FILES.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i545-mission-cot-enrichment')
        return _i545_get_before(self)
    Handler.do_GET = _i545_do_get

    _I545_ENRICH_LOCK = threading.RLock()
    _I545_ENRICH_CACHE = {}
    _I545_ENRICH_INFLIGHT = set()
    _I545_ENRICH_SUCCESS_SECONDS = 8.0
    _I545_ENRICH_FAILURE_SECONDS = 60.0
    _I545_MAX_MISSIONS = 64
    _I545_EVENT_SKEW_SECONDS = 1.0

    def _i545_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i545_local_name(tag):
        return _i545_text(tag).rsplit('}', 1)[-1].lower()

    def _i545_parse_epoch(value):
        if value in (None, ''):
            return None
        try:
            if isinstance(value, (int, float)) and math.isfinite(float(value)):
                number = float(value)
                return number / 1000.0 if number > 100000000000.0 else number
        except Exception:
            pass
        try:
            parsed = _parse_ts_epoch(value)
            return float(parsed) if parsed is not None else None
        except Exception:
            return None

    def _i545_row_epoch(row):
        if not isinstance(row, dict):
            return None
        for source in ([row] + ([row.get('properties')] if isinstance(row.get('properties'), dict) else [])):
            if not isinstance(source, dict):
                continue
            for key in ('updated','timestamp','time','start','event_time','eventTime','created_at','submission_time'):
                epoch = _i545_parse_epoch(source.get(key))
                if epoch is not None:
                    return epoch
        try:
            parsed = _parse_cot_text_fields(row)
        except Exception:
            parsed = {}
        if isinstance(parsed, dict):
            for key in ('updated','timestamp','time','start','event_time','eventTime'):
                epoch = _i545_parse_epoch(parsed.get(key))
                if epoch is not None:
                    return epoch
        return None

    def _i545_symbol_identity(event):
        if not isinstance(event, dict):
            return False
        for key in (
            'sidc','SIDC','symbol_id','symbolId','mil2525_sidc','milstd2525_sidc',
            'iconsetPath','iconsetpath','iconset_path','@iconsetpath','usericon_path',
            'cot_type','atak_cot_type','event_type','type','mil2525_name','mil2525_file'
        ):
            if _i545_text(event.get(key)):
                return True
        xml = _i545_text(event.get('mission_cot_xml') or event.get('xml') or event.get('cot_xml'))
        return bool(re.search(r'<(?:event|usericon|__mil2525)\b', xml, re.I))

    def _i545_event_detail_score(event):
        if not isinstance(event, dict):
            return 0
        score = 0
        if _i545_text(event.get('sidc') or event.get('SIDC')):
            score += 8
        if _i545_text(event.get('iconsetPath') or event.get('iconsetpath') or event.get('usericon_path')):
            score += 8
        if _i545_text(event.get('cot_type') or event.get('atak_cot_type') or event.get('event_type') or event.get('type')):
            score += 4
        if _i545_text(event.get('mission_cot_xml')):
            score += 4
        if isinstance(event.get('mission_cot_payload'), dict):
            score += 2
        if _i545_text(event.get('mil2525_file') or event.get('mil2525_name')):
            score += 2
        return score

    def _i545_event_from_element(element):
        if element is None or _i545_local_name(element.tag) != 'event':
            return None
        event = {
            'uid': _i545_text(element.attrib.get('uid')),
            'type': _i545_text(element.attrib.get('type')),
            'cot_type': _i545_text(element.attrib.get('type')),
            'atak_cot_type': _i545_text(element.attrib.get('type')),
            'event_type': _i545_text(element.attrib.get('type')),
            'time': _i545_text(element.attrib.get('time')),
            'start': _i545_text(element.attrib.get('start')),
            'stale': _i545_text(element.attrib.get('stale')),
            'how': _i545_text(element.attrib.get('how')),
            'source': 'OpenTAKServer Mission GET /cot enrichment',
            'mission_cot_enriched': True,
        }
        if not event['uid']:
            return None
        for node in element.iter():
            name = _i545_local_name(node.tag)
            attrs = {str(k).rsplit('}', 1)[-1].lower(): _i545_text(v) for k, v in (node.attrib or {}).items()}
            if name == 'point':
                for key in ('lat','lon','hae','ce','le'):
                    if attrs.get(key):
                        try:
                            event[key] = float(attrs[key])
                        except Exception:
                            event[key] = attrs[key]
            elif name == 'contact' and attrs.get('callsign'):
                event['callsign'] = attrs['callsign']
            if name == 'usericon':
                iconset = attrs.get('iconsetpath') or attrs.get('iconset_path') or attrs.get('path')
                if iconset:
                    event['iconsetPath'] = iconset
                    event['iconsetpath'] = iconset
                    event['usericon_path'] = iconset
            for key, value in attrs.items():
                folded = key.replace('-', '').replace('_', '').lower()
                if folded in ('sidc','symbolid','mil2525sidc','milstd2525sidc') and value:
                    event['sidc'] = value
                    event['SIDC'] = value
                elif folded in ('iconsetpath','usericonpath') and value:
                    event['iconsetPath'] = value
                    event['iconsetpath'] = value
                    event['usericon_path'] = value
            text = _i545_text(node.text)
            if text and name in ('sidc','symbolid','mil2525sidc','milstd2525sidc'):
                event['sidc'] = text
                event['SIDC'] = text
        xml = ET.tostring(element, encoding='unicode', short_empty_elements=True)
        event['mission_cot_xml'] = xml
        event['mission_cot_event_epoch'] = _i545_row_epoch(event)
        if '_i537_apply_symbol' in globals():
            _i537_apply_symbol(event, xml)
        return event

    def _i545_xml_events(text):
        text = _i545_text(text)
        if '<event' not in text.lower():
            return []
        roots = []
        for candidate in (text, '<takMapMissionCotRoot>' + text + '</takMapMissionCotRoot>'):
            try:
                roots.append(ET.fromstring(candidate.encode('utf-8')))
                break
            except Exception:
                continue
        if not roots:
            return []
        root = roots[0]
        nodes = [root] if _i545_local_name(root.tag) == 'event' else [node for node in root.iter() if _i545_local_name(node.tag) == 'event']
        return [event for event in (_i545_event_from_element(node) for node in nodes) if event]

    def _i545_json_event(value):
        if not isinstance(value, dict):
            return None
        uid = _i545_text(value.get('uid') or value.get('cot_uid') or value.get('cotUid') or value.get('event_uid'))
        if not uid:
            return None
        event = dict(value)
        event['uid'] = uid
        cot_type = _i545_text(value.get('cot_type') or value.get('atak_cot_type') or value.get('event_type') or value.get('type'))
        if cot_type:
            event['type'] = cot_type
            event['cot_type'] = cot_type
            event['atak_cot_type'] = cot_type
            event['event_type'] = cot_type
        point = value.get('point')
        if isinstance(point, dict):
            for key in ('lat','lon','hae','ce','le'):
                if point.get(key) not in (None, ''):
                    event[key] = point.get(key)
        event['source'] = 'OpenTAKServer Mission GET /cot enrichment'
        event['mission_cot_enriched'] = True
        event['mission_cot_payload'] = value
        event['mission_cot_event_epoch'] = _i545_row_epoch(event)
        if '_i537_apply_symbol' in globals():
            _i537_apply_symbol(event, value)
        return event

    def _i545_extract_events(payload, body=''):
        events = []
        seen_objects = set()
        stack = [payload, body]
        scanned = 0
        while stack and scanned < 20000:
            value = stack.pop()
            scanned += 1
            if value is None:
                continue
            if isinstance(value, str):
                events.extend(_i545_xml_events(value))
                continue
            if isinstance(value, dict):
                ident = id(value)
                if ident in seen_objects:
                    continue
                seen_objects.add(ident)
                event = _i545_json_event(value)
                if event:
                    events.append(event)
                for nested in value.values():
                    if isinstance(nested, (dict, list, tuple, str)):
                        stack.append(nested)
                continue
            if isinstance(value, (list, tuple)):
                stack.extend(value)
        latest = {}
        order = 0
        for event in events:
            uid = _i545_text(event.get('uid')).casefold()
            if not uid:
                continue
            order += 1
            epoch = event.get('mission_cot_event_epoch')
            if epoch is None:
                epoch = _i545_row_epoch(event)
                event['mission_cot_event_epoch'] = epoch
            current = latest.get(uid)
            current_epoch = current.get('mission_cot_event_epoch') if isinstance(current, dict) else None
            current_order = current.get('_i545_order', -1) if isinstance(current, dict) else -1
            event['_i545_order'] = order
            replace = current is None
            if not replace and epoch is not None:
                if current_epoch is None or float(epoch) > float(current_epoch):
                    replace = True
                elif float(epoch) == float(current_epoch):
                    replace = _i545_event_detail_score(event) > _i545_event_detail_score(current) or (
                        _i545_event_detail_score(event) == _i545_event_detail_score(current) and order > current_order
                    )
            elif not replace and epoch is None and current_epoch is None:
                replace = _i545_event_detail_score(event) > _i545_event_detail_score(current) or (
                    _i545_event_detail_score(event) == _i545_event_detail_score(current) and order > current_order
                )
            if replace:
                latest[uid] = event
        for event in latest.values():
            event.pop('_i545_order', None)
        return latest

    def _i545_cache_key(cfg, sess):
        return _i539_identity_key(sess or {}, cfg or {})

    def _i545_mission_names(out):
        names = []
        seen = set()
        scope = out.get('mission_api_user_scope_i512') if isinstance(out, dict) else {}
        for value in list((scope or {}).get('effective_missions') or []):
            text = _i545_text(value)
            if text and text.casefold() not in seen:
                seen.add(text.casefold()); names.append(text)
        for row in list((out or {}).get('missions') or []):
            if not isinstance(row, dict):
                continue
            text = _i545_text(_tak_row_value(row, ('name','mission_name','missionName','title'), ''))
            if text and text.casefold() not in seen:
                seen.add(text.casefold()); names.append(text)
        return names[:_I545_MAX_MISSIONS]

    def _i545_cached_enrichment(cfg, sess, missions):
        key = _i545_cache_key(cfg, sess)
        requested = tuple(sorted({_i545_text(name).casefold() for name in missions if _i545_text(name)}))
        with _I545_ENRICH_LOCK:
            record = dict(_I545_ENRICH_CACHE.get(key) or {})
        if not record:
            return {'present': False, 'fresh': False, 'events': {}, 'record': {}, 'age_seconds': None, 'requested': requested}
        age = max(0.0, time.time() - float(record.get('time') or 0.0))
        ttl = _I545_ENRICH_SUCCESS_SECONDS if record.get('ok') else _I545_ENRICH_FAILURE_SECONDS
        fresh = bool(tuple(record.get('requested') or ()) == requested and age <= ttl)
        return {'present': True, 'fresh': fresh, 'events': dict(record.get('events') or {}), 'record': record, 'age_seconds': age, 'requested': requested}

    def _i545_fetch_mission_events(mission):
        mission_q = quote(_i545_text(mission), safe='')
        credential = _i529_current_user_credential() if '_i529_current_user_credential' in globals() else {}
        creator_uid = _i545_text((credential or {}).get('client_uid'))
        path = '/Marti/api/missions/' + mission_q + '/cot'
        if creator_uid:
            path += '?creatorUid=' + quote(creator_uid, safe='')
        result = _ots_mission_api_request(path, method='GET', timeout=8)
        events = _i545_extract_events(result.get('json') if isinstance(result, dict) else None, result.get('body') if isinstance(result, dict) else '')
        return {
            'mission': _i545_text(mission),
            'path': path,
            'ok': bool(isinstance(result, dict) and result.get('ok')),
            'status': int((result or {}).get('status') or 0) if isinstance(result, dict) else 0,
            'error': _i545_text((result or {}).get('error')) if isinstance(result, dict) else 'request-failed',
            'events': events,
            'event_count': len(events),
        }

    def _i545_schedule_enrichment(cfg, sess, missions):
        missions = [_i545_text(name) for name in missions if _i545_text(name)][:_I545_MAX_MISSIONS]
        if not missions or not _i545_text((sess or {}).get('auth_mode')).startswith('ots-'):
            return {'scheduled': False, 'reason': 'not-applicable-or-no-missions'}
        cached = _i545_cached_enrichment(cfg, sess, missions)
        if cached.get('fresh'):
            return {'scheduled': False, 'reason': 'fresh-cache'}
        key = _i545_cache_key(cfg, sess)
        with _I545_ENRICH_LOCK:
            if key in _I545_ENRICH_INFLIGHT:
                return {'scheduled': False, 'reason': 'already-running'}
            _I545_ENRICH_INFLIGHT.add(key)
        session_token = _i545_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', '')) if '_I529_REQUEST_CONTEXT' in globals() else ''
        auth_mode = _i545_text(getattr(_I529_REQUEST_CONTEXT, 'auth_mode', '')) if '_I529_REQUEST_CONTEXT' in globals() else _i545_text((sess or {}).get('auth_mode'))
        identity = {'username': _i542_scope_username(sess) if '_i542_scope_username' in globals() else _i545_text((sess or {}).get('username'))}
        requested = tuple(sorted({name.casefold() for name in missions}))

        def worker():
            rows = []
            combined = {}
            try:
                if '_I529_REQUEST_CONTEXT' in globals():
                    _I529_REQUEST_CONTEXT.session_token = session_token
                    _I529_REQUEST_CONTEXT.auth_mode = auth_mode
                if '_I512_REQUEST_CONTEXT' in globals():
                    _I512_REQUEST_CONTEXT.identity = dict(identity)
                for mission in missions:
                    row = _i545_fetch_mission_events(mission)
                    rows.append({k: v for k, v in row.items() if k != 'events'})
                    for uid, event in dict(row.get('events') or {}).items():
                        event = dict(event)
                        event['mission_name'] = mission
                        current = combined.get(uid)
                        event_epoch = event.get('mission_cot_event_epoch')
                        current_epoch = current.get('mission_cot_event_epoch') if isinstance(current, dict) else None
                        replace = current is None
                        if not replace and event_epoch is not None:
                            if current_epoch is None or float(event_epoch) > float(current_epoch):
                                replace = True
                            elif float(event_epoch) == float(current_epoch):
                                replace = _i545_event_detail_score(event) > _i545_event_detail_score(current)
                        elif not replace and event_epoch is None and current_epoch is None:
                            replace = _i545_event_detail_score(event) > _i545_event_detail_score(current)
                        if replace:
                            combined[uid] = event
                ok = any(row.get('ok') for row in rows)
                record = {
                    'ok': ok,
                    'time': time.time(),
                    'requested': requested,
                    'events': combined,
                    'missions': rows,
                    'event_count': len(combined),
                    'error': '' if ok else '; '.join(filter(None, (_i545_text(row.get('error')) for row in rows)))[:1000],
                }
                with _I545_ENRICH_LOCK:
                    _I545_ENRICH_CACHE[key] = record
            except Exception as exc:
                with _I545_ENRICH_LOCK:
                    _I545_ENRICH_CACHE[key] = {'ok': False, 'time': time.time(), 'requested': requested, 'events': {}, 'missions': rows, 'event_count': 0, 'error': str(exc)}
            finally:
                try:
                    if '_I529_REQUEST_CONTEXT' in globals():
                        _I529_REQUEST_CONTEXT.session_token = ''
                        _I529_REQUEST_CONTEXT.auth_mode = ''
                    if '_I512_REQUEST_CONTEXT' in globals():
                        _I512_REQUEST_CONTEXT.identity = {}
                except Exception:
                    pass
                with _I545_ENRICH_LOCK:
                    _I545_ENRICH_INFLIGHT.discard(key)

        threading.Thread(target=worker, name='tak-map-i545-mission-cot', daemon=True).start()
        return {'scheduled': True, 'reason': 'cache-missing-or-stale'}

    def _i545_symbol_fingerprint(row):
        if not isinstance(row, dict):
            return ''
        values = [
            _i545_text(row.get('sidc') or row.get('SIDC')),
            _i545_text(row.get('cot_type') or row.get('atak_cot_type') or row.get('event_type') or row.get('type')),
            _i545_text(row.get('iconsetPath') or row.get('iconsetpath') or row.get('iconset_path') or row.get('usericon_path')),
            _i545_text(row.get('mil2525_file') or row.get('mil2525_name')),
        ]
        return hashlib.sha256('\x1f'.join(values).encode('utf-8')).hexdigest()[:20]

    def _i545_merge_event(row, event):
        merged = dict(row or {})
        event = dict(event or {})
        if not event or not _i545_symbol_identity(event):
            return merged, False, 'event-has-no-symbol-identity'
        row_epoch = _i545_row_epoch(merged)
        event_epoch = event.get('mission_cot_event_epoch')
        if event_epoch is None:
            event_epoch = _i545_row_epoch(event)
        if row_epoch is not None and event_epoch is not None and float(event_epoch) + _I545_EVENT_SKEW_SECONDS < float(row_epoch):
            return merged, False, 'mission-cot-event-older-than-database-row'
        before = _i545_symbol_fingerprint(merged)
        event_sidc = _i545_text(event.get('sidc') or event.get('SIDC'))
        event_type = _i545_text(event.get('cot_type') or event.get('atak_cot_type') or event.get('event_type') or event.get('type'))
        event_iconset = _i545_text(event.get('iconsetPath') or event.get('iconsetpath') or event.get('iconset_path') or event.get('usericon_path'))
        # Remove prior derived symbol fields before resolving the newest mission CoT
        # identity. This prevents an old SIDC from outranking a newer ATAK type or
        # usericon update for the same UID.
        if event_sidc or event_type or event_iconset:
            for key in ('sidc','SIDC','mil2525_name','mil2525_file','mil2525_label','symbol_resolution_i537'):
                merged.pop(key, None)
            props = merged.get('properties')
            if isinstance(props, dict):
                props = dict(props)
                for key in ('sidc','SIDC','mil2525_name','mil2525_file','mil2525_label'):
                    props.pop(key, None)
                merged['properties'] = props
        if event_type:
            for key in ('type','cot_type','atak_cot_type','event_type'):
                merged[key] = event_type
        if event_sidc:
            merged['sidc'] = event_sidc
            merged['SIDC'] = event_sidc
        if event_iconset:
            merged['iconsetPath'] = event_iconset
            merged['iconsetpath'] = event_iconset
            merged['usericon_path'] = event_iconset
        for key in ('mission_cot_xml','mission_cot_payload','mission_cot_event_epoch','mission_name'):
            if event.get(key) not in (None, ''):
                merged[key] = event.get(key)
        merged['data_sync_symbol_enrichment_i545'] = {
            'version': 'i545',
            'source': 'GET /Marti/api/missions/{mission}/cot',
            'exact_uid': _i545_text(merged.get('uid') or merged.get('cot_uid')),
            'database_event_epoch': row_epoch,
            'mission_cot_event_epoch': event_epoch,
            'metadata_preserved_even_when_svg_missing': True,
        }
        if '_i537_apply_symbol' in globals():
            _i537_apply_symbol(merged, event, event.get('mission_cot_xml'))
        after = _i545_symbol_fingerprint(merged)
        merged['data_sync_symbol_fingerprint_i545'] = after
        merged['data_sync_symbol_changed_i545'] = bool(before and after and before != after)
        return merged, True, 'merged'

    def _i545_apply_cached_enrichment(out, cfg, sess, missions):
        if not isinstance(out, dict):
            return out
        cached = _i545_cached_enrichment(cfg, sess, missions)
        events = dict(cached.get('events') or {})
        before_rows = list(out.get('objects') or [])
        rows = []
        matched = changed = stale_skipped = 0
        for row in before_rows:
            if not isinstance(row, dict):
                continue
            uid = _i537_object_uid(row) if '_i537_object_uid' in globals() else _i545_text(row.get('uid')).casefold()
            event = events.get(uid)
            if not event:
                row = dict(row)
                row['data_sync_symbol_fingerprint_i545'] = _i545_symbol_fingerprint(row)
                rows.append(row)
                continue
            merged, applied, reason = _i545_merge_event(row, event)
            if applied:
                matched += 1
                if merged.get('data_sync_symbol_changed_i545'):
                    changed += 1
            elif reason == 'mission-cot-event-older-than-database-row':
                stale_skipped += 1
            rows.append(merged)
        out['objects'] = rows
        record = cached.get('record') or {}
        out['mission_cot_symbol_enrichment_i545'] = {
            'version': 'i545',
            'mode': 'asynchronous-exact-uid-newest-event',
            'cache_present': bool(cached.get('present')),
            'cache_fresh': bool(cached.get('fresh')),
            'cache_age_seconds': cached.get('age_seconds'),
            'requested_missions': list(missions),
            'cached_event_count': len(events),
            'objects_matched': matched,
            'symbol_fingerprints_changed': changed,
            'older_events_skipped': stale_skipped,
            'request_blocks_data_sync': False,
            'poll_applies_updates_within_seconds': 10,
            'metadata_preserved_even_when_svg_missing': True,
            'cache_ok': bool(record.get('ok')),
            'cache_error': _i545_text(record.get('error')),
            'mission_results': list(record.get('missions') or []),
        }
        if '_i537_update_mission_uid_cache' in globals():
            _i537_update_mission_uid_cache(out)
        return out

    _i545_augment_before = _i512_augment_data_sync
    def _i512_augment_data_sync(base, cfg, sess):
