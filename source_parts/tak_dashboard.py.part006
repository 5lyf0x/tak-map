                    continue
            out.append(row)
        return out

    def _i563_filter_payload(payload, learn=False):
        if not isinstance(payload, dict): return payload
        out = dict(payload); active = _i563_active_mission_uids(out)
        # Learn all genuine delete events before filtering any normal rows so a
        # stale representation in the same response cannot flash on screen.
        if learn:
            for key in ('objects','markers','euds','items','features'):
                for row in out.get(key) or []:
                    if not isinstance(row, dict) or not _i563_delete_event(row): continue
                    uid = _i555_object_uid(row); mission = _i555_object_mission(row)
                    refresh = _i563_delete_reason(row) == 'symbol-refresh'
                    if uid and not refresh and uid.casefold() not in _I563_UPDATE_UIDS:
                        _i563_add_fence(uid, mission, 'cot-delete-event', _i563_event_time(row))
        for key in ('objects','markers','euds','items','features'):
            if isinstance(out.get(key), list): out[key] = _i563_filter_rows(out[key], active, learn)
        current_fences = _i563_fence_rows()
        out['data_sync_integrity_i563'] = {
            'version':'i563', 'delete_events_rendered':False,
            'persistent_fence_count':len(current_fences),
            'resurrection_blocked':True,
