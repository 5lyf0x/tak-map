        _i567_augment_base = _i512_augment_data_sync

    def _i567_clone_json_value(value, _seen=None, _depth=0):
        """Clone JSON response data without preserving cycles or shared mutation."""
        if _seen is None:
            _seen = set()
        if _depth > 80:
            return None
        if value is None or isinstance(value, (str, int, float, bool)):
            return value
        ident = id(value)
        if ident in _seen:
            return None
        if isinstance(value, dict):
            _seen.add(ident)
            out = {}
            for key, item in value.items():
                cloned = _i567_clone_json_value(item, _seen, _depth + 1)
                if cloned is not None or item is None:
                    out[str(key)] = cloned
            _seen.remove(ident)
            return out
        if isinstance(value, (list, tuple)):
            _seen.add(ident)
            out = [_i567_clone_json_value(item, _seen, _depth + 1) for item in value]
            _seen.remove(ident)
            return out
        return str(value)

    def _i567_flatten_properties(row):
        if not isinstance(row, dict):
            return row
        props = row.get('properties')
        if not isinstance(props, dict):
            return row
        props = dict(props)
        # Defensively flatten only the accidental recursive properties wrappers.
        # Preserve outer/current values and fill missing keys from nested wrappers.
        scanned = 0
        while isinstance(props.get('properties'), dict) and scanned < 16:
            nested = dict(props.pop('properties'))
            for key, value in nested.items():
                if key != 'properties' and key not in props:
                    props[key] = value
            scanned += 1
        row['properties'] = props
        return row

    def _i567_apply_custom_path(row, custom):
        if not isinstance(row, dict) or _i565_delete_event(row):
            return row
        custom = _i565_canonical_iconset_path(custom)
        if not custom or custom.upper().startswith('COT_MAPPING_2525'):
            return row
        _i567_flatten_properties(row)
        for key in ('iconsetPath','iconsetpath','iconset_path','usericon_path','user_icon_path'):
            row[key] = custom
        row['data_sync_current_iconset_path_i567'] = custom
        row['current_iconset_path_i567'] = custom
        row['mission_cot_raw_iconset_path_i567'] = custom
        row['custom_icon'] = True
        _i566_clear_mil_fallback(row)
        props = row.get('properties') if isinstance(row.get('properties'), dict) else {}
        props = dict(props)
        props.pop('properties', None)
        for key in ('iconsetPath','iconsetpath','iconset_path','usericon_path','user_icon_path'):
            props[key] = custom
        props['data_sync_current_iconset_path_i567'] = custom
        props['custom_icon'] = True
        _i566_clear_mil_fallback(props)
        row['properties'] = props
        details = row.get('details')
        if isinstance(details, dict):
            details = dict(details)
            details['iconsetPath'] = custom
            _i566_clear_mil_fallback(details)
            row['details'] = details
        decision = {
            'version':'i567','authority':'usericon-iconsetpath',
            'reason':'single-final-data-sync-custom-icon-authority',
            'custom_usericon':True,'canonical_path':custom,
            'generic_mil_fallback_suppressed':True,
        }
        row['data_sync_icon_authority_i567'] = dict(decision)
        row['data_sync_symbol_decision_i567'] = dict(decision)
        props['data_sync_icon_authority_i567'] = dict(decision)
        props['data_sync_symbol_decision_i567'] = dict(decision)
        return row

    def _i567_apply_sof_alias(row):
        if not isinstance(row, dict) or _i565_delete_event(row):
            return row
        details = row.get('details') if isinstance(row.get('details'), dict) else {}
        cot = _i566_text(row.get('cot_type') or row.get('type') or details.get('type')).casefold()
        if cot != 'a-f-f-n-s':
            return row
        mapping = {
            'name':'friendly-ground-unit-special-forces',
            'label':'SOF','sidc':'SFGPUCCIS------',
            'file':'friendly-ground-unit-special-forces.svg',
        }
        row['mil2525_name'] = mapping['name']; row['mil2525_label'] = mapping['label']
        row['mil2525_file'] = mapping['file']; row['milstd2525c_file'] = mapping['file']
        row['sidc'] = mapping['sidc']; row['milstd2525c_sidc'] = mapping['sidc']
        props = row.get('properties') if isinstance(row.get('properties'), dict) else {}
        props = dict(props); props.pop('properties', None)
        props.update({
            'mil2525_name':mapping['name'],'mil2525_label':mapping['label'],
            'mil2525_file':mapping['file'],'milstd2525c_file':mapping['file'],
            'sidc':mapping['sidc'],'milstd2525c_sidc':mapping['sidc'],
        })
        decision = {
            'version':'i567','authority':'reviewed-cot-type-alias',
            'reason':'atak-sof-f-n-s-compatibility','selected_cot_type':'a-f-F-N-S',
            'selected_sidc':mapping['sidc'],'selected_file':mapping['file'],
        }
        row['properties'] = props
        row['data_sync_symbol_decision_i567'] = dict(decision)
        props['data_sync_symbol_decision_i567'] = dict(decision)
        return row

    def _i567_finalize_payload(payload):
        """Apply icon authority once to cloned visible objects only."""
        if not isinstance(payload, dict):
            return payload
        out = dict(payload)
        raw_rows = payload.get('mission_uids')
        raw_by_uid = {}
        if isinstance(raw_rows, list):
            for raw in raw_rows:
                if not isinstance(raw, dict):
                    continue
                custom = _i566_authoritative_custom_path(raw)
                uid = _i566_object_uid(raw)
                if custom and uid:
                    raw_by_uid[uid] = custom
        original_rows = payload.get('objects')
        recovered = 0
        finalized = []
        if isinstance(original_rows, list):
            for original in original_rows:
                if not isinstance(original, dict):
                    finalized.append(_i567_clone_json_value(original))
                    continue
                row = _i567_clone_json_value(original)
                if not isinstance(row, dict):
                    row = dict(original)
                _i567_flatten_properties(row)
                if not _i565_delete_event(row):
                    xml_path, complete_xml = _i566_xml_icon_authority(row)
                    custom = xml_path if complete_xml else _i566_authoritative_custom_path(row)
                    if not custom and not complete_xml:
                        custom = raw_by_uid.get(_i566_object_uid(row), '')
                        recovered += int(bool(custom))
                    if custom:
                        _i567_apply_custom_path(row, custom)
                    else:
                        _i567_apply_sof_alias(row)
                finalized.append(row)
            out['objects'] = finalized
        out['custom_icon_resolution_i567'] = {
            'version':'i567','single_final_response_pass':True,
            'pre_augmentation_mutation':False,'raw_mission_uids_read_only':True,
            'visible_rows_cloned':True,'object_count_preserved':len(finalized) == len(original_rows or []),
            'raw_mission_uid_join':True,'objects_recovered_from_raw_uid':recovered,
            'generic_mil_fallback_suppressed':True,
        }
        return out

    def _i512_augment_data_sync(base, cfg, sess):
        # Legacy normalization mutates dictionaries in place. Isolate it from the
        # acquisition/cache payload and restore pristine raw MissionUID rows before
        # the single final response pass.
        working = _i567_clone_json_value(base) if isinstance(base, dict) else base
        pristine_raw = _i567_clone_json_value(base.get('mission_uids')) if isinstance(base, dict) else None
        augmented = _i567_augment_base(working, cfg, sess)
        if isinstance(augmented, dict) and isinstance(pristine_raw, list):
            augmented = dict(augmented)
            augmented['mission_uids'] = pristine_raw
        return _i567_finalize_payload(augmented)
    globals()['_i512_augment_data_sync'] = _i512_augment_data_sync

    _i567_get_before = Handler.do_GET
    def _i567_do_get(self):
