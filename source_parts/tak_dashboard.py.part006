        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i545\2',html)
        html = html.replace('/assets/runtime/tak-map-startup-i543.js?v=1.3.0-i545','/assets/runtime/tak-map-startup-i545.js?v=1.3.0-i545').replace('/assets/runtime/tak-map-startup-i543.js?v=1.3.0-i543','/assets/runtime/tak-map-startup-i545.js?v=1.3.0-i545')
        return html

