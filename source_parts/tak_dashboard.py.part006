# --- TAK Map i562 ATAK point-symbol publication/read-back correction ---
try:
    def _i562_mil_usericon_path(cot_type):
        value = _i555_text(cot_type).strip()
        if not re.match(r'^a-[fhnu]-[A-Za-z](?:-[A-Za-z0-9]+)*$', value, re.I):
            return ''
        parts = value.split('-')
        return 'COT_MAPPING_2525C/' + '-'.join(parts[:2]).lower() + '/' + value

    _i562_point_xml_before = _i526_point_xml
    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i562_point_xml_before(feature, mission_name, creator_uid)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        mode = _i555_text(_i526_value(feature, 'icon_mode', 'symbol_mode')).lower()
        sidc = _i555_text(_i526_value(feature, 'sidc', 'mil2525_sidc', 'symbol_id', 'symbolId'))
        explicit_custom = _i555_text(_i526_value(feature, 'iconsetpath', 'iconset_path', 'usericon_path', 'user_icon_path', 'icon_path'))
        is_mil = mode in ('milstd2525c', 'milstd', '2525c') or (bool(sidc) and not explicit_custom)
        if not is_mil:
            return built
        try:
            root = ET.fromstring(_i555_text(built.get('xml')).encode('utf-8'))
            cot_type = _i555_text(root.attrib.get('type') or built.get('cot_type'))
            usericon_path = _i562_mil_usericon_path(cot_type)
            if not usericon_path:
                built['i562_symbol_warning'] = 'Could not derive an ATAK MIL-STD-2525C usericon path from the selected CoT type.'
                return built
            detail = root.find('detail')
            if detail is None:
                detail = ET.SubElement(root, 'detail')
            for child in list(detail):
                if _i555_xml_local_name(child.tag) == 'usericon':
                    detail.remove(child)
            usericon = ET.Element('usericon', {'iconsetpath': usericon_path})
            contact = detail.find('contact')
            if contact is not None:
                detail.insert(list(detail).index(contact) + 1, usericon)
            else:
                detail.insert(0, usericon)
            meta = detail.find('takmap_point')
            if meta is None:
                meta = ET.SubElement(detail, 'takmap_point')
            meta.set('version', 'i562')
            meta.set('symbolMode', 'milstd2525c')
            meta.set('iconsetPath', usericon_path)
            meta.set('atakSymbolLinkage', 'event-type-plus-usericon')
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            built['version'] = 'i562'
            built['iconset_path'] = usericon_path
            built['atak_usericon_path'] = usericon_path
            built['atak_symbol_linkage'] = 'event-type-plus-usericon'
        except Exception as exc:
            built['i562_symbol_warning'] = str(exc)
        return built
    globals()['_i526_point_xml'] = _i526_point_xml

    def _i562_expected_point_symbol(payload):
        payload = payload if isinstance(payload, dict) else {}
        symbol = payload.get('symbol') if isinstance(payload.get('symbol'), dict) else {}
        mode = _i555_text(symbol.get('kind') or symbol.get('mode')).lower()
        if mode == 'custom':
            return {
                'mode': 'custom',
                'iconsetpath': _i555_text(symbol.get('iconsetpath')),
                'cot_type': '',
            }
        if mode in ('unregistered', 'unregistered-custom'):
            return {'mode': 'unregistered', 'iconsetpath': _i555_text(symbol.get('iconsetpath')), 'cot_type': ''}
        cot_type = _i555_text(symbol.get('cot_type'))
        return {
            'mode': 'milstd2525c',
            'cot_type': cot_type,
            'iconsetpath': _i562_mil_usericon_path(cot_type),
        }

    def _i562_point_update_match(row, payload):
        if not isinstance(row, dict):
            return False, {'reason': 'missing-row'}
        public = _i555_point_public(row)
        expected = _i562_expected_point_symbol(payload)
        mismatches = {}
        expected_name = _i555_text(payload.get('name'))[:120]
        if expected_name and _i555_text(public.get('name')) != expected_name:
            mismatches['name'] = {'expected': expected_name, 'actual': _i555_text(public.get('name'))}
        expected_lat = _i555_float(payload.get('lat')); expected_lon = _i555_float(payload.get('lon'))
        actual_lat = _i555_float(public.get('lat')); actual_lon = _i555_float(public.get('lon'))
        if expected_lat is not None and (actual_lat is None or abs(actual_lat - expected_lat) > 0.0000015):
            mismatches['lat'] = {'expected': expected_lat, 'actual': actual_lat}
        if expected_lon is not None and (actual_lon is None or abs(actual_lon - expected_lon) > 0.0000015):
            mismatches['lon'] = {'expected': expected_lon, 'actual': actual_lon}
        actual_cot = _i555_text(public.get('cot_type'))
        actual_path = _i555_text(public.get('iconsetpath'))
        if expected.get('mode') == 'milstd2525c':
            if expected.get('cot_type') and actual_cot.casefold() != expected['cot_type'].casefold():
                mismatches['cot_type'] = {'expected': expected['cot_type'], 'actual': actual_cot}
            if expected.get('iconsetpath') and actual_path.casefold() != expected['iconsetpath'].casefold():
                mismatches['iconsetpath'] = {'expected': expected['iconsetpath'], 'actual': actual_path}
        elif expected.get('mode') in ('custom', 'unregistered'):
            if expected.get('iconsetpath') and actual_path != expected['iconsetpath']:
                mismatches['iconsetpath'] = {'expected': expected['iconsetpath'], 'actual': actual_path}
        return not bool(mismatches), {'expected': expected, 'actual': {'cot_type': actual_cot, 'iconsetpath': actual_path, 'name': public.get('name'), 'lat': public.get('lat'), 'lon': public.get('lon')}, 'mismatches': mismatches, 'point': public}

    _i562_save_point_before = _i555_save_point
    def _i555_save_point(payload):
        reply, status = _i562_save_point_before(payload)
        if status != 200 or not isinstance(reply, dict) or not reply.get('ok'):
            return reply, status
        uid = _i555_text((payload or {}).get('uid'))
        mission = _i555_text((payload or {}).get('mission_name') or (payload or {}).get('mission'))
        if not uid or not mission:
            return reply, status
        history = []
        confirmed = None
        for attempt in range(1, 13):
            row = _i555_find_point(uid, mission, True)
            matched, detail = _i562_point_update_match(row, payload)
            history.append({'attempt': attempt, 'matched': matched, 'detail': detail})
            if matched:
                confirmed = detail.get('point')
                break
            if attempt < 12:
                time.sleep(0.5)
        if not confirmed:
            last = history[-1]['detail'] if history else {}
            return {
                'ok': False,
                'version': 'i562',
                'error': 'OpenTAKServer returned the point UID, but did not confirm the requested point symbol and fields. ATAK may still have the previous icon.',
                'symbol_readback_confirmed': False,
                'redraw_allowed': False,
                'requested_symbol': _i562_expected_point_symbol(payload),
                'readback': last,
                'readback_attempts': history,
                'publish': reply.get('publish'),
            }, 502
        out = dict(reply)
        out['version'] = 'i562'
        out['point'] = confirmed
        out['symbol_readback_confirmed'] = True
        out['readback_attempts'] = history
        out['message'] = 'Data Sync point saved; OpenTAKServer confirmed the updated ATAK symbol and point fields.'
        return out, 200
    globals()['_i555_save_point'] = _i555_save_point

    _i562_config_before = tak_map_config
    def tak_map_config():
        cfg = _i562_config_before()
        if not isinstance(cfg, dict):
            cfg = {}
        cfg = dict(cfg)
        linkage = dict(cfg.get('data_sync_point_symbol_update') or {})
        linkage.update({
            'version': 'i562',
            'atak_event_type_and_usericon_emitted': True,
            'milstd2525c_usericon_format': 'COT_MAPPING_2525C/a-f/a-f-G-...',
            'semantic_readback_required': True,
            'uid_only_readback_is_not_success': True,
        })
        cfg['data_sync_point_symbol_update'] = linkage
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i562_exc:
    try:
        print('TAK Map i562 ATAK point-symbol linkage patch failed:', _i562_exc)
    except Exception:
        pass
# --- end TAK Map i562 ATAK point-symbol publication/read-back correction ---


# --- TAK Map i562 package/runtime promotion ---
try:
    _I562_PACKAGE_ROOT = Path(__file__).resolve().parent
    _I562_PACKAGE_RUNTIME_FILES = {
        '/assets/runtime/tak-map-icon-registry-i562.js': (_I562_PACKAGE_ROOT / 'assets' / 'tak-map-icon-registry-i562.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-popup-localdata-i562.js': (_I562_PACKAGE_ROOT / 'assets' / 'tak-map-popup-localdata-i562.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-context-sidebar-i562.js': (_I562_PACKAGE_ROOT / 'assets' / 'tak-map-context-sidebar-i562.js', 'application/javascript; charset=utf-8'),
    }

    _i562_package_get_before = Handler.do_GET
    def _i562_package_do_get(self):
        parsed = urlparse(self.path)
        runtime = _I562_PACKAGE_RUNTIME_FILES.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i562-active-runtime')
        return _i562_package_get_before(self)
    Handler.do_GET = _i562_package_do_get

    _i562_package_config_before = tak_map_config
    def tak_map_config():
        cfg = _i562_package_config_before()
        if not isinstance(cfg, dict):
