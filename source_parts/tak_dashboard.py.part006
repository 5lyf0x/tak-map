    _I566_XML_KEYS = ('mission_cot_xml','cot_xml','event_xml','raw_xml','xml')
    _I566_DERIVED_MIL_KEYS = (
        'sidc','SIDC','mil2525_sidc','milstd2525_sidc','mil2525_file','mil2525_name','mil2525_label',
        'generated_mil2525_file','symbol_resolution_i537','symbol_resolution_i549','symbol_resolution_i550',
        'symbol_resolution_i551','symbol_resolution_i552',
    )

    def _i566_text(value):
        try: return str(value if value is not None else '').strip()
        except Exception: return ''

    def _i566_xml_icon_authority(row):
        """Return (path, complete_xml_seen). A complete current CoT event with no
        usericon is authoritative and blocks fallback to an older summary path."""
        if not isinstance(row, dict): return '', False
        candidates=[]
        for key in _I566_XML_KEYS:
            value=row.get(key)
            if isinstance(value,str) and '<event' in value.lower(): candidates.append(value)
        props=row.get('properties')
        if isinstance(props,dict):
            for key in _I566_XML_KEYS:
                value=props.get(key)
                if isinstance(value,str) and '<event' in value.lower(): candidates.append(value)
        for xml in candidates:
            match=re.search(r'<usericon\b[^>]*\biconsetpath=["\']([^"\']+)["\']',xml,re.I)
            if match:
                return _i565_canonical_iconset_path(match.group(1)), True
            return '', True
        return '', False

    def _i566_direct_icon_path(row):
        if not isinstance(row,dict): return ''
        for source in (row, row.get('properties'), row.get('details')):
            if not isinstance(source,dict): continue
            for key in _I566_CUSTOM_DIRECT_KEYS:
                value=_i566_text(source.get(key))
                if value: return _i565_canonical_iconset_path(value)
        # OpenTAKServer MissionUID rows normally expose details.iconsetPath, but
        # retain a bounded recursive fallback for alternate wrappers.
        stack=[row]; seen=set(); scanned=0
        while stack and scanned < 2000:
            current=stack.pop(); scanned+=1
            if not isinstance(current,dict) or id(current) in seen: continue
            seen.add(id(current))
            folded={str(k).casefold():v for k,v in current.items()}
            for key in ('iconsetpath','iconset_path','usericon_path','user_icon_path','icon_path'):
                value=_i566_text(folded.get(key))
                if value: return _i565_canonical_iconset_path(value)
            for child in current.values():
                if isinstance(child,dict): stack.append(child)
                elif isinstance(child,list): stack.extend(x for x in child if isinstance(x,dict))
        return ''

    def _i566_authoritative_custom_path(row):
        xml_path, complete_xml = _i566_xml_icon_authority(row)
        if complete_xml:
            path=xml_path
        else:
            path=_i566_direct_icon_path(row)
        path=_i565_canonical_iconset_path(path)
        return path if path and not path.upper().startswith('COT_MAPPING_2525') else ''

    def _i566_clear_mil_fallback(source, recursive=True):
        if not isinstance(source,dict): return
        for key in _I566_DERIVED_MIL_KEYS: source.pop(key,None)
        # Remove older response-only decisions that explicitly selected the
        # generic CoT-type frame; publish one final current decision below.
        for key in tuple(source):
            folded=str(key).casefold()
            if (folded.startswith('data_sync_symbol_decision_i')
                    or folded.startswith('data_sync_icon_authority_i')
                    or folded.startswith('data_sync_live_event_i')):
                source.pop(key,None)
        if recursive:
            stack=[value for value in source.values() if isinstance(value,(dict,list))]
            seen=set(); scanned=0
            while stack and scanned < 2000:
                current=stack.pop(); scanned+=1
                if isinstance(current,dict):
                    if id(current) in seen: continue
                    seen.add(id(current))
                    _i566_clear_mil_fallback(current, False)
                    stack.extend(value for value in current.values() if isinstance(value,(dict,list)))
                elif isinstance(current,list):
                    stack.extend(value for value in current if isinstance(value,(dict,list)))

    def _i566_apply_custom_path(row, custom):
        if not isinstance(row,dict): return row
        if _i565_delete_event(row): return row
        custom=_i565_canonical_iconset_path(custom)
        if not custom or custom.upper().startswith('COT_MAPPING_2525'): return row
        for key in ('iconsetPath','iconsetpath','iconset_path','usericon_path','user_icon_path'):
            row[key]=custom
        row['data_sync_current_iconset_path_i566']=custom
        row['current_iconset_path_i566']=custom
        row['mission_cot_raw_iconset_path_i566']=custom
        row['custom_icon']=True
        _i566_clear_mil_fallback(row)
        props=row.get('properties')
        if not isinstance(props,dict): props={}
        for key in ('iconsetPath','iconsetpath','iconset_path','usericon_path','user_icon_path'):
            props[key]=custom
        props['data_sync_current_iconset_path_i566']=custom
        props['custom_icon']=True
        _i566_clear_mil_fallback(props)
        row['properties']=props
        details=row.get('details')
        if isinstance(details,dict):
            details=dict(details)
            details['iconsetPath']=custom
            _i566_clear_mil_fallback(details)
            row['details']=details
        decision={
            'version':'i566','authority':'usericon-iconsetpath','reason':'final-data-sync-custom-icon-authority',
            'custom_usericon':True,'canonical_path':custom,'generic_mil_fallback_suppressed':True,
        }
        row['data_sync_icon_authority_i566']=dict(decision)
        row['data_sync_symbol_decision_i566']=dict(decision)
        props['data_sync_icon_authority_i566']=dict(decision)
        props['data_sync_symbol_decision_i566']=dict(decision)
        return row

    def _i566_apply_custom_authority(row):
        if not isinstance(row,dict): return row
        return _i566_apply_custom_path(row, _i566_authoritative_custom_path(row))

    def _i566_object_uid(row):
        if not isinstance(row,dict): return ''
        for source in (row,row.get('properties'),row.get('details')):
            if not isinstance(source,dict): continue
            for key in ('event_uid','cot_uid','uid','data','source_id','id'):
                value=_i566_text(source.get(key))
                if value: return value.casefold()
        return ''

    def _i566_finalize_payload(out):
        if not isinstance(out,dict): return out
        raw_by_uid={}
        raw_rows=out.get('mission_uids')
        if isinstance(raw_rows,list):
            for row in raw_rows:
                if not isinstance(row,dict): continue
                custom=_i566_authoritative_custom_path(row)
                uid=_i566_object_uid(row)
