        '/assets/runtime/tak-map-data-sync-i542.js': (_I542_ROOT / 'assets' / 'tak-map-data-sync-i542.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-startup-i542.js': (_I542_ROOT / 'assets' / 'tak-map-startup-i542.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-deferred-i542.json': (_I542_ROOT / 'assets' / 'tak-map-deferred-i542.json', 'application/json; charset=utf-8'),
    }

    _i542_get_before = Handler.do_GET
    def _i542_do_get(self):
        parsed = urlparse(self.path)
        runtime = _I542_RUNTIME_FILES.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i542-startup')
        return _i542_get_before(self)
    Handler.do_GET = _i542_do_get

    _I542_DB_SCOPE_LOCK = threading.RLock()
