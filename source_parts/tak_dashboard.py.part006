        # Preserve custom ATAK icon packages as deterministic browser fallbacks.
        # Reviewed/standard COT_MAPPING_2525C paths continue through the exact
        # alias-aware type/icon conflict resolver above.
        if raw_iconset and not raw_iconset.upper().startswith('COT_MAPPING_2525C/') and not raw_sidc and _i552_text(previous_decision.get('authority')) == 'usericon-iconsetpath':
            decision.update({
                'authority': 'usericon-iconsetpath',
                'reason': 'upgrade-normalized-custom-iconset-fallback',
                'selected_sidc': '',
                'selected_file': '',
                'selected_cot_type': '',
                'selected_iconset_path': raw_iconset,
                'custom_usericon_fallback': True,
            })
            selected = None

        decision.update({
            'version': 'i552',
            'upgrade_normalized': True,
            'upgrade_normalization_stage': 'final-visible-data-sync-response',
            'previous_decision_version': _i552_text(previous_decision.get('version')),
            'previous_decision_authority': _i552_text(previous_decision.get('authority')),
            'reviewed_alias_catalog': True,
        })

        obj = _i552_clear_derived_symbol(dict(row))
        if isinstance(selected, dict) and selected.get('ok'):
            _i549_apply_resolved_symbol(obj, selected)
            # Remove compatibility resolution records generated by the older
            # helper and publish one authoritative current record.
            obj.pop('symbol_resolution_i549', None)
            props = obj.get('properties')
            if isinstance(props, dict):
                props = dict(props); props.pop('symbol_resolution_i549', None); obj['properties'] = props
            resolution = {
                'version': 'i552',
                'source': 'upgrade-normalized-' + _i552_text(selected.get('source') or decision.get('authority')),
                'authority': _i552_text(decision.get('authority')),
                'decision_reason': _i552_text(decision.get('reason')),
                'conflict': bool(decision.get('conflict')),
                'reviewed_alias_catalog': True,
                'reviewed_alias_selected': bool(selected.get('reviewed_alias')),
                'input_sidc': _i552_text(selected.get('input_sidc')),
                'catalog_sidc': _i552_text(selected.get('catalog_sidc') or selected.get('sidc')),
            }
            obj['symbol_resolution_i552'] = dict(resolution)
        else:
            resolution = {}

        if raw_sidc:
            obj['mission_cot_raw_sidc_i552'] = raw_sidc
            obj['data_sync_current_sidc_i552'] = raw_sidc
        if raw_type:
            obj['mission_cot_raw_type_i552'] = raw_type
            obj['data_sync_current_cot_type_i552'] = raw_type
            for key in ('type', 'cot_type', 'atak_cot_type', 'event_type'):
                obj[key] = raw_type
        if raw_iconset:
            obj['mission_cot_raw_iconset_path_i552'] = raw_iconset
            obj['data_sync_current_iconset_path_i552'] = raw_iconset
            obj['current_iconset_path_i552'] = raw_iconset
            for key in ('iconsetPath', 'iconsetpath', 'usericon_path'):
