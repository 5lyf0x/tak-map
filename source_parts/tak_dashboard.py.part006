            sources.append(props)
        return sources

    def _i552_first(row, keys):
        for source in _i552_row_sources(row):
            for key in keys:
                value = _i552_text(source.get(key))
                if value:
                    return value
        return ''

    def _i552_current_symbol_values(row):
