# --- TAK Map i563 Data Sync deletion integrity, ATAK symbol refresh, and clean Create Point sessions ---
try:
    _I563_ROOT = Path(__file__).resolve().parent
    _I563_FENCE_FILE = DATA_DIR / 'data_sync_deleted_uid_fences_i563.json'
    _I563_FENCE_LOCK = threading.RLock()
    _I563_UID_LOCK_GUARD = threading.RLock()
    _I563_UID_LOCKS = {}
    _I563_PUBLISH_CONTEXT = threading.local()
    _I563_UPDATE_UIDS = set()

    def _i563_uid_lock(uid):
        key = _i555_text(uid).casefold()
        with _I563_UID_LOCK_GUARD:
            lock = _I563_UID_LOCKS.get(key)
            if lock is None:
                lock = threading.RLock()
                _I563_UID_LOCKS[key] = lock
            return lock

    def _i563_identity_key():
        identity = {}
        try:
            identity = dict(getattr(_I512_REQUEST_CONTEXT, 'identity', {}) or {})
        except Exception:
            identity = {}
        value = _i555_text(identity.get('username') or identity.get('tak_uid') or identity.get('callsign'))
        return value.casefold() or 'authenticated-user'

    def _i563_fence_key(uid, mission=''):
        return '|'.join((_i563_identity_key(), _i555_text(mission).casefold(), _i555_text(uid).casefold()))

    def _i563_load_fences():
        with _I563_FENCE_LOCK:
            raw = load_json_file(_I563_FENCE_FILE, {'version':'i563','fences':{}})
            if not isinstance(raw, dict): raw = {'version':'i563','fences':{}}
            fences = raw.get('fences') if isinstance(raw.get('fences'), dict) else {}
            return {'version':'i563','fences':dict(fences)}

    def _i563_save_fences(data):
        with _I563_FENCE_LOCK:
            _I563_FENCE_FILE.parent.mkdir(parents=True, exist_ok=True)
            atomic_write_json(_I563_FENCE_FILE, {'version':'i563','fences':dict((data or {}).get('fences') or {})})

    def _i563_add_fence(uid, mission='', reason='deleted', event_time=''):
        uid = _i555_text(uid); mission = _i555_text(mission)
        if not uid: return None
        data = _i563_load_fences(); key = _i563_fence_key(uid, mission)
        previous = dict(data['fences'].get(key) or {})
        clean_reason = _i555_text(reason) or 'deleted'; clean_time = _i555_text(event_time)
        # Repeated polling of the same terminal event must not rewrite the
        # fence file or advance its generation indefinitely.
        if previous and _i555_text(previous.get('reason')) == clean_reason and _i555_text(previous.get('event_time')) == clean_time:
            return previous
        generation = int(previous.get('generation') or 0) + 1
        row = {
            'uid':uid, 'mission':mission, 'identity':_i563_identity_key(),
            'reason':clean_reason, 'event_time':clean_time,
            'created':datetime.now(timezone.utc).isoformat(), 'generation':generation,
        }
        data['fences'][key] = row; _i563_save_fences(data); return row

    def _i563_remove_fence(uid, mission=''):
        uid = _i555_text(uid); mission = _i555_text(mission); identity = _i563_identity_key()
        data = _i563_load_fences(); changed = False
        for key, row in list(data['fences'].items()):
            if _i555_text((row or {}).get('identity')).casefold() != identity: continue
            if _i555_text((row or {}).get('uid')).casefold() != uid.casefold(): continue
            row_mission = _i555_text((row or {}).get('mission'))
            if mission and row_mission and row_mission.casefold() != mission.casefold(): continue
            data['fences'].pop(key, None); changed = True
        if changed: _i563_save_fences(data)
        return changed

    def _i563_fence_rows(uid='', mission=''):
        uid = _i555_text(uid); mission = _i555_text(mission); identity = _i563_identity_key()
        rows = []
        for row in _i563_load_fences()['fences'].values():
            if _i555_text((row or {}).get('identity')).casefold() != identity: continue
            if uid and _i555_text((row or {}).get('uid')).casefold() != uid.casefold(): continue
            row_mission = _i555_text((row or {}).get('mission'))
            if mission and row_mission and row_mission.casefold() != mission.casefold(): continue
            rows.append(dict(row or {}))
        return rows

    def _i563_fenced(uid, mission=''):
        return bool(_i563_fence_rows(uid, mission))

    def _i563_cot_type(row):
        value = _i555_object_cot_type(row) if isinstance(row, dict) else ''
        if value: return _i555_text(value)
        if isinstance(row, str):
            try: return _i555_text(ET.fromstring(row.encode('utf-8')).attrib.get('type'))
            except Exception: return ''
        return ''

    def _i563_delete_event(row):
        value = _i563_cot_type(row).casefold()
        return value == 't-x-d-d' or value.startswith('t-x-d-d-')

    def _i563_delete_reason(row):
        if not isinstance(row, dict): return ''
        direct = _i555_text(_i555_ci_value(row, ('takmap_delete_reason','delete_reason','reason'))).casefold()
        if direct: return direct
        xml = _i555_object_xml(row)
        if not xml: return ''
        try:
            root = ET.fromstring(xml.encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                for child in list(detail):
                    local = _i555_xml_local_name(child.tag)
                    if local == 'takmap_delete':
                        return _i555_text(child.attrib.get('reason')).casefold()
                    if local == 'remarks' and 'symbol-refresh' in _i555_text(child.text).casefold():
                        return 'symbol-refresh'
        except Exception:
            pass
        return ''

    def _i563_event_time(row):
        return _i555_text(_i555_ci_value(row, ('time','event_time','start','updated'))) if isinstance(row, dict) else ''

    def _i563_time_value(value):
        text = _i555_text(value)
        if not text: return None
        try:
            parsed = datetime.fromisoformat(text.replace('Z','+00:00'))
            return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
        except Exception:
            return None

    def _i563_active_mission_uids(payload):
        # Only explicit current Mission association rows are authoritative.
        # A retained object that merely carries a mission_name is not proof of
        # membership and must never release a deletion fence.
        active = set()
        if not isinstance(payload, dict): return active
        for row in payload.get('mission_uids') or []:
            if isinstance(row, dict):
                uid = _i555_text(_i555_ci_value(row, ('event_uid','cot_uid','uid','data_uid')))
                if uid: active.add(uid.casefold())
        return active

    def _i563_release_if_recreated(row, active_uids):
        uid = _i555_object_uid(row); mission = _i555_object_mission(row)
        if not uid or uid.casefold() not in (active_uids or set()): return False
        event_time = _i563_time_value(_i563_event_time(row))
        if event_time is None: return False
        fences = _i563_fence_rows(uid, mission)
        if not fences: return True
        for fence in fences:
            boundary = _i563_time_value(fence.get('event_time')) or _i563_time_value(fence.get('created'))
            if boundary is None or event_time <= boundary:
                return False
        return _i563_remove_fence(uid, mission)

    def _i563_filter_rows(rows, active_uids=None, learn=False):
        out=[]; active_uids = active_uids or set()
        for row in rows or []:
            if not isinstance(row, dict):
                out.append(row); continue
            uid = _i555_object_uid(row)
            mission = _i555_object_mission(row)
            if _i563_delete_event(row):
                # Our own symbol-refresh terminal is not a user deletion. It is
                # followed immediately by a replacement same-UID event.
                refresh = _i563_delete_reason(row) == 'symbol-refresh'
                if learn and uid and not refresh and uid.casefold() not in _I563_UPDATE_UIDS:
                    _i563_add_fence(uid, mission, 'cot-delete-event', _i563_event_time(row))
                continue
            if uid and _i563_fenced(uid, mission):
