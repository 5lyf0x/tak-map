        return cfg
    globals()['tak_map_config']=tak_map_config

    def _i566_patch_html(html):
        if not isinstance(html,str): return html
        html=re.sub(r'1\.3\.0-i565','1.3.0-i566',html)
        html=re.sub(r'TAKDashboard/i565','TAKDashboard/i566',html)
        html=re.sub(r'TAK-Map/1\.3\.0 i565','TAK-Map/1.3.0 i566',html)
