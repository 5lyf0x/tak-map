    _I519_ITERATION_UI = r'''<script id="takMapIterationGuardV519">
(function(d){'use strict';const V='i519';let busy=false;function apply(){if(busy)return;busy=true;try{if(d.documentElement.dataset.takMapIteration!==V)d.documentElement.dataset.takMapIteration=V;d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){if(el.textContent!==V)el.textContent=V;if(el.getAttribute('data-iteration')!==V)el.setAttribute('data-iteration',V)})}catch(_){}finally{busy=false}}if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',apply,{once:true});else apply();[0,350,1100,2600,5200].forEach(function(ms){setTimeout(apply,ms)});try{new MutationObserver(apply).observe(d.documentElement,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['data-iteration']})}catch(_){}
})(document);
</script>'''

