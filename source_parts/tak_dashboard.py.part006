                    'attempts':[],'user_agent_family':'ATAK','user_agent':_I564_ATAK_USER_AGENT,
                    'data_sync_client_profile':'ATAK','mission_token_used':False,'mission_token_source':'subscription-failed',
                    'shared_service_fallback':False,
