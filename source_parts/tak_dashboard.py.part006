# --- TAK Map i626 checkpoint-based Replay state-at-time correction ---
try:
    _I626_VERSION = 'i626'
    _I626_PACKAGE_VERSION = '1.4.0-i626'
    _I626_PUBLIC_VERSION = '1.4.0'

    def _i626_replay_script():
        script = str(globals().get('_v415_script') or '')
        if not script:
            raise RuntimeError('authoritative Replay integration source is unavailable')
        script = script.replace("const V='i442',RELEASE='1.3.0'", "const V='i626',RELEASE='1.4.0'", 1)
        script = script.replace("packageFile:'tak-map-v442.zip'", "packageFile:'tak-map-v1.4.0-i626.zip'", 1)
        return script

    _I626_REPLAY_SCRIPT = _i626_replay_script()

    def _i626_identity_guard_script():
        guard = str(globals().get('_I625_IDENTITY_GUARD') or globals().get('_I624_IDENTITY_GUARD') or '')
        if not guard:
            return ''
        guard = guard.replace('id="takMapIdentityGuardI625"', 'id="takMapIdentityGuardI626"', 1)
        guard = guard.replace('id="takMapIdentityGuardI624"', 'id="takMapIdentityGuardI626"', 1)
        guard = guard.replace("ITERATION='i625',PACKAGE='1.4.0-i625'", "ITERATION='i626',PACKAGE='1.4.0-i626'", 1)
        guard = guard.replace("ITERATION='i624',PACKAGE='1.4.0-i624'", "ITERATION='i626',PACKAGE='1.4.0-i626'", 1)
        return guard

    _I626_IDENTITY_GUARD = _i626_identity_guard_script()

    def _i626_patch_main_html(html):
        html = str(html or '').replace('1.4.0-i625', _I626_PACKAGE_VERSION)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i626\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i626\2', html)
        html = re.sub(r'<script[^>]*id=["\']v415ReplayModeIntegrationPatch["\'][\s\S]*?</script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapIdentityGuardI(?:620|622|623|624|625|626)["\'][\s\S]*?</script>\s*', '', html, flags=re.I)
        if _I626_IDENTITY_GUARD:
            html = html.replace('</head>', _I626_IDENTITY_GUARD + '</head>', 1) if '</head>' in html else _I626_IDENTITY_GUARD + html
        html = html.replace('</body>', _I626_REPLAY_SCRIPT + '\n</body>', 1) if '</body>' in html else html + _I626_REPLAY_SCRIPT
        return html

    def _i626_patch_login_html(html):
        html = str(html or '').replace('1.4.0-i625', _I626_PACKAGE_VERSION)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i626\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i626\2', html)
        return html

    TAK_MAP_HTML = _i626_patch_main_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i626_patch_login_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML

    _i626_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i626_config_before() or {})
        cfg['replay_state_i626'] = {
            'version': _I626_VERSION,
            'package_version': _I626_PACKAGE_VERSION,
            'gateway_required_iteration': 'i195',
            'gateway_state_at_time': True,
            'persistent_gateway_checkpoints': True,
            'checkpoint_interval_seconds': 900,
            'transport_locked_while_seeking': True,
            'bounded_long_distance_seek': True,
            'multi_day_period_labels_show_both_dates': True,
            'preserve_previous_state_on_seek_error': True,
            'live_map_unchanged': True,
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i626_exc:
    try:
        print('TAK Map i626 Replay state-at-time correction failed:', _i626_exc)
    except Exception:
        pass
# --- end TAK Map i626 checkpoint-based Replay state-at-time correction ---

