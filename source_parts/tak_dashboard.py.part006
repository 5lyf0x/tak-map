function setup(){return {input:[{bands:["SCL","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let p=[[0,0,0],[1,0,0],[0.18,0.18,0.18],[0.35,0.22,0.15],[0.10,0.55,0.12],[0.70,0.45,0.22],[0.05,0.25,0.85],[0.65,0.65,0.65],[0.80,0.80,0.80],[1,1,1],[0.55,0.75,0.95],[0.85,0.95,1]][Math.max(0,Math.min(11,Math.round(s.SCL)))];return[p[0],p[1],p[2],s.dataMask];}''',
        'cloud_mask': r'''//VERSION=3
function setup(){return {input:[{bands:["SCL","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let k=Math.round(s.SCL);if(k===3)return[0.25,0.05,0.35,s.dataMask];if(k===8)return[0.72,0.72,0.72,s.dataMask];if(k===9)return[1,1,1,s.dataMask];if(k===10)return[0.55,0.82,1,s.dataMask];return[0,0,0,0];}''',
        'cloud_probability': r'''//VERSION=3
function setup(){return {input:[{bands:["CLD","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let v=Math.max(0,Math.min(1,s.CLD/100));return[0.15+0.85*v,0.28+0.72*v,0.55+0.45*v,s.dataMask];}''',
    }

    def _i535_user_ref(sess):
        sess = sess if isinstance(sess, dict) else {}
        profile = dict(sess.get('profile') or {})
        key = _i529_text(profile.get('identity_key'))
        if key:
            return 'identity:' + key
        return '%s:%s' % (_i529_text(sess.get('auth_mode') or 'user'), _i529_text(sess.get('username')).casefold())

    def _i535_user_hash(sess_or_ref):
        ref = sess_or_ref if isinstance(sess_or_ref, str) else _i535_user_ref(sess_or_ref)
        return hashlib.sha256(_i529_text(ref).encode('utf-8')).hexdigest()[:48]

    def _i535_user_paths(sess):
        root = _I535_SENTINEL_ROOT / _i535_user_hash(sess)
        return {'root': root, 'credential': root / 'credentials.json', 'cache': _I535_SENTINEL_CACHE_ROOT / _i535_user_hash(sess)}

    def _i535_secret_keys(user_ref):
        seed = hmac.new(_i529_master_secret(), ('tak-map-i535-sentinel:' + _i529_text(user_ref)).encode('utf-8'), hashlib.sha256).digest()
        return (
            hmac.new(seed, b'encryption', hashlib.sha256).digest(),
            hmac.new(seed, b'authentication', hashlib.sha256).digest(),
        )

    def _i535_stream(key, nonce, length):
        out = bytearray()
        counter = 0
        while len(out) < length:
            out.extend(hmac.new(key, nonce + counter.to_bytes(8, 'big'), hashlib.sha256).digest())
            counter += 1
        return bytes(out[:length])

    def _i535_encrypt(user_ref, value):
        plain = _i529_text(value).encode('utf-8')
        enc_key, mac_key = _i535_secret_keys(user_ref)
        nonce = secrets.token_bytes(16)
        stream = _i535_stream(enc_key, nonce, len(plain))
        ciphertext = bytes(a ^ b for a, b in zip(plain, stream))
        body = b'TSH1' + nonce + ciphertext
        tag = hmac.new(mac_key, body, hashlib.sha256).digest()
        return base64.urlsafe_b64encode(body + tag).decode('ascii')

    def _i535_decrypt(user_ref, value):
        try:
            raw = base64.urlsafe_b64decode(_i529_text(value).encode('ascii'))
        except Exception as exc:
            raise ValueError('Stored Sentinel Hub credential is not valid base64.') from exc
        if len(raw) < 4 + 16 + 32 or raw[:4] != b'TSH1':
            raise ValueError('Stored Sentinel Hub credential format is invalid.')
        body, tag = raw[:-32], raw[-32:]
        enc_key, mac_key = _i535_secret_keys(user_ref)
        expected = hmac.new(mac_key, body, hashlib.sha256).digest()
        if not hmac.compare_digest(tag, expected):
            raise ValueError('Stored Sentinel Hub credential authentication failed.')
        nonce, ciphertext = body[4:20], body[20:]
        stream = _i535_stream(enc_key, nonce, len(ciphertext))
        return bytes(a ^ b for a, b in zip(ciphertext, stream)).decode('utf-8')

    def _i535_load_record(sess):
        path = _i535_user_paths(sess)['credential']
        try:
            value = json.loads(path.read_text(encoding='utf-8'))
            return value if isinstance(value, dict) else {}
        except Exception:
            return {}

    def _i535_load_credentials(sess):
        record = _i535_load_record(sess)
        if not record:
            return {'ok': False, 'configured': False, 'error': 'Sentinel Hub is not configured for this user.'}
        user_ref = _i535_user_ref(sess)
        try:
            client_id = _i535_decrypt(user_ref, record.get('client_id_encrypted'))
            client_secret = _i535_decrypt(user_ref, record.get('client_secret_encrypted'))
        except Exception as exc:
            return {'ok': False, 'configured': True, 'error': 'Could not decrypt this user’s Sentinel Hub credentials: ' + str(exc)}
        if not client_id or not client_secret:
            return {'ok': False, 'configured': True, 'error': 'Stored Sentinel Hub credentials are incomplete.'}
        return {
            'ok': True, 'configured': True, 'client_id': client_id, 'client_secret': client_secret,
            'configured_at': _i529_text(record.get('configured_at')),
            'verified_at': _i529_text(record.get('verified_at')),
            'last_tested_at': _i529_text(record.get('last_tested_at')),
        }

    def _i535_mask(value):
        value = _i529_text(value)
        if len(value) <= 8:
            return ('•' * max(0, len(value) - 2)) + value[-2:]
        return value[:4] + '…' + value[-4:]

    def _i535_public_status(sess):
        loaded = _i535_load_credentials(sess)
        return {
            'ok': True,
            'credential_valid': bool(loaded.get('ok')),
            'version': 'i535',
            'configured': bool(loaded.get('configured')),
            'verified': bool(loaded.get('ok') and loaded.get('verified_at')),
            'client_id_hint': _i535_mask(loaded.get('client_id')) if loaded.get('ok') else '',
            'configured_at': _i529_text(loaded.get('configured_at')),
            'verified_at': _i529_text(loaded.get('verified_at')),
            'last_tested_at': _i529_text(loaded.get('last_tested_at')),
            'error': '' if loaded.get('ok') else _i529_text(loaded.get('error')),
            'credential_scope': 'current-authenticated-user-only',
            'credential_storage': 'authenticated-encryption-server-side',
            'shared_credential_fallback': False,
            'secret_returned_to_browser': False,
        }

    def _i535_http_error(exc, label):
        status = getattr(exc, 'code', 0) or 0
        body = ''
        try:
            body = exc.read(4000).decode('utf-8', errors='replace')
        except Exception:
            body = str(exc)
        try:
            parsed = json.loads(body)
            detail = parsed.get('error_description') or parsed.get('message') or parsed.get('error') or body
        except Exception:
            detail = re.sub(r'<[^>]+>', ' ', body)
            detail = re.sub(r'\s+', ' ', detail).strip()
        return RuntimeError('%s failed%s: %s' % (label, (' with HTTP ' + str(status)) if status else '', detail[:900] or str(exc)))

    def _i535_request_token(client_id, client_secret, cache_key='', force=False):
        client_id = _i529_text(client_id)
        client_secret = _i529_text(client_secret)
        if not client_id or not client_secret:
            raise ValueError('Client ID and Client Secret are required.')
        fingerprint = hashlib.sha256((client_id + '\0' + client_secret).encode('utf-8')).hexdigest()
        if cache_key and not force:
            with _I535_TOKEN_LOCK:
                cached = dict(_I535_TOKEN_CACHE.get(cache_key) or {})
            if cached.get('fingerprint') == fingerprint and float(cached.get('expires_at') or 0) > time.time() + 60:
                return cached['access_token']
        body = urlencode({'grant_type': 'client_credentials', 'client_id': client_id, 'client_secret': client_secret}).encode('utf-8')
        request = Request(_I535_TOKEN_ENDPOINT, data=body, method='POST', headers={
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json',
            'User-Agent': 'TAK-Map/1.3.0-i535 Sentinel-Hub',
        })
        try:
            with urlopen(request, timeout=25, context=ssl.create_default_context()) as response:
                payload = json.loads(response.read().decode('utf-8'))
        except HTTPError as exc:
            raise _i535_http_error(exc, 'Sentinel Hub OAuth token request')
        except Exception as exc:
            raise RuntimeError('Sentinel Hub OAuth token request failed: ' + str(exc))
        token = _i529_text(payload.get('access_token'))
        if not token:
            raise RuntimeError('Sentinel Hub did not return an access token.')
        expires_in = max(120, int(payload.get('expires_in') or 600))
        if cache_key:
            with _I535_TOKEN_LOCK:
                _I535_TOKEN_CACHE[cache_key] = {
                    'access_token': token, 'expires_at': time.time() + expires_in,
                    'fingerprint': fingerprint,
                }
        return token

    def _i535_api_request(url, token, method='GET', payload=None, accept='application/json'):
        data = None
        headers = {
            'Authorization': 'Bearer ' + _i529_text(token),
            'Accept': accept,
            'User-Agent': 'TAK-Map/1.3.0-i535 Sentinel-Hub',
        }
        if payload is not None:
            data = json.dumps(payload, separators=(',', ':')).encode('utf-8')
            headers['Content-Type'] = 'application/json'
        request = Request(url, data=data, method=method, headers=headers)
        try:
            with urlopen(request, timeout=35, context=ssl.create_default_context()) as response:
                return response.status, response.headers, response.read()
        except HTTPError:
            raise

    def _i535_test_credentials(client_id, client_secret, cache_key=''):
        token = _i535_request_token(client_id, client_secret, cache_key=cache_key, force=True)
        try:
            status, headers, body = _i535_api_request(_I535_CATALOG_BASE + '/collections/sentinel-2-l2a', token)
        except HTTPError as exc:
            raise _i535_http_error(exc, 'Sentinel Hub Sentinel-2 L2A catalogue test')
        if status < 200 or status >= 300:
            raise RuntimeError('Sentinel Hub catalogue test returned HTTP ' + str(status) + '.')
        try:
            payload = json.loads(body.decode('utf-8'))
        except Exception as exc:
            raise RuntimeError('Sentinel Hub catalogue test returned invalid JSON: ' + str(exc))
        collection_id = _i529_text(payload.get('id'))
        if collection_id and collection_id != 'sentinel-2-l2a':
            raise RuntimeError('Sentinel Hub returned an unexpected collection: ' + collection_id)
        return {'ok': True, 'collection': collection_id or 'sentinel-2-l2a', 'title': _i529_text(payload.get('title'))}

    def _i535_save_credentials(sess, client_id, client_secret):
        client_id = _i529_text(client_id)
        client_secret = _i529_text(client_secret)
        if len(client_id) < 8 or len(client_id) > 300:
            raise ValueError('Enter a valid Sentinel Hub Client ID.')
        if len(client_secret) < 12 or len(client_secret) > 1000:
            raise ValueError('Enter a valid Sentinel Hub Client Secret.')
        key = _i535_user_hash(sess)
        tested = _i535_test_credentials(client_id, client_secret, cache_key=key)
        now = datetime.now(timezone.utc).isoformat()
        record = {
            'version': 'i535',
            'client_id_encrypted': _i535_encrypt(_i535_user_ref(sess), client_id),
            'client_secret_encrypted': _i535_encrypt(_i535_user_ref(sess), client_secret),
            'configured_at': now,
            'verified_at': now,
            'last_tested_at': now,
            'identity_hash': key,
        }
        paths = _i535_user_paths(sess)
        with _I535_SENTINEL_LOCK:
            _i529_atomic_write(paths['credential'], json.dumps(record, indent=2, sort_keys=True) + '\n', 0o600, False)
        _i512_audit('sentinel-hub-user-config', _i529_text(sess.get('username')), True, 'configured and verified per-user OAuth client')
        status = _i535_public_status(sess)
        status.update({'ok': True, 'message': 'Sentinel Hub credentials saved and verified.', 'test': tested})
        return status

    def _i535_remove_credentials(sess):
        paths = _i535_user_paths(sess)
        with _I535_SENTINEL_LOCK:
            try:
                paths['credential'].unlink()
            except FileNotFoundError:
                pass
            try:
                if paths['root'].is_dir() and not any(paths['root'].iterdir()):
                    paths['root'].rmdir()
            except Exception:
                pass
        key = _i535_user_hash(sess)
        with _I535_TOKEN_LOCK:
            _I535_TOKEN_CACHE.pop(key, None)
        try:
            shutil.rmtree(paths['cache'])
        except FileNotFoundError:
            pass
        except Exception:
            pass
        _i512_audit('sentinel-hub-user-config', _i529_text(sess.get('username')), True, 'removed per-user OAuth client')
        return {'ok': True, 'version': 'i535', 'configured': False, 'verified': False, 'message': 'Sentinel Hub credentials removed.', 'shared_credential_fallback': False}

    def _i535_credentials_for_request(sess):
        loaded = _i535_load_credentials(sess)
        if not loaded.get('ok'):
            raise RuntimeError(_i529_text(loaded.get('error') or 'Sentinel Hub is not configured for this user.'))
        return loaded

    def _i535_user_token(sess, force=False):
        credentials = _i535_credentials_for_request(sess)
        return _i535_request_token(credentials['client_id'], credentials['client_secret'], cache_key=_i535_user_hash(sess), force=force)

    def _i535_json_with_refresh(sess, url, method='GET', payload=None):
        token = _i535_user_token(sess, False)
        try:
            status, headers, body = _i535_api_request(url, token, method, payload)
        except HTTPError as exc:
            if exc.code != 401:
                raise _i535_http_error(exc, 'Sentinel Hub API request')
            token = _i535_user_token(sess, True)
            try:
                status, headers, body = _i535_api_request(url, token, method, payload)
            except HTTPError as retry_exc:
                raise _i535_http_error(retry_exc, 'Sentinel Hub API request')
        try:
            value = json.loads(body.decode('utf-8'))
        except Exception as exc:
            raise RuntimeError('Sentinel Hub API returned invalid JSON: ' + str(exc))
        return value

    def _i535_search_bbox(value):
        if not isinstance(value, (list, tuple)) or len(value) != 4:
            raise ValueError('A four-value map bounding box is required.')
        west, south, east, north = [float(x) for x in value]
        if not all(math.isfinite(x) for x in (west, south, east, north)):
            raise ValueError('Map bounding box must contain finite coordinates.')
        south = max(-85.0, min(85.0, south))
        north = max(-85.0, min(85.0, north))
        west = max(-180.0, min(180.0, west))
        east = max(-180.0, min(180.0, east))
        if south >= north:
            raise ValueError('Map bounding box latitude range is invalid.')
        if west == east:
            raise ValueError('Map bounding box longitude range is empty.')
        if west < east:
            return [[west, south, east, north]]
        return [[west, south, 180.0, north], [-180.0, south, east, north]]

    def _i535_catalog_features(sess, bbox, start_iso, end_iso, max_cloud):
        base = {
            'bbox': bbox,
            'datetime': start_iso + '/' + end_iso,
            'collections': ['sentinel-2-l2a'],
            'limit': 100,
            'filter': 'eo:cloud_cover <= ' + str(int(max_cloud)),
        }
        features = []
        next_token = None
        for _ in range(4):
            request = dict(base)
            if next_token not in (None, ''):
                request['next'] = next_token
            payload = _i535_json_with_refresh(sess, _I535_CATALOG_BASE + '/search', 'POST', request)
            features.extend(list(payload.get('features') or []))
            context = payload.get('context') if isinstance(payload.get('context'), dict) else {}
            next_token = context.get('next')
            if next_token in (None, ''):
                break
        return features

    def _i535_search_scenes(sess, payload):
        payload = payload if isinstance(payload, dict) else {}
        bboxes = _i535_search_bbox(payload.get('bbox'))
        days = max(1, min(1825, int(payload.get('days') or 180)))
        max_cloud = max(0, min(100, int(payload.get('max_cloud') if payload.get('max_cloud') is not None else 35)))
        now = datetime.now(timezone.utc)
        start = now - timedelta(days=days)
        start_iso = start.strftime('%Y-%m-%dT00:00:00Z')
        end_iso = now.strftime('%Y-%m-%dT23:59:59Z')
        cache_key = hashlib.sha256(json.dumps({'u': _i535_user_hash(sess), 'b': bboxes, 'd': days, 'c': max_cloud}, sort_keys=True).encode('utf-8')).hexdigest()
        with _I535_SEARCH_LOCK:
            cached = dict(_I535_SEARCH_CACHE.get(cache_key) or {})
        if cached and float(cached.get('expires_at') or 0) > time.time():
            result = dict(cached.get('result') or {})
            result['cached'] = True
            return result
        grouped = {}
        seen_ids = set()
        for bbox in bboxes:
            for feature in _i535_catalog_features(sess, bbox, start_iso, end_iso, max_cloud):
                feature = feature if isinstance(feature, dict) else {}
                fid = _i529_text(feature.get('id'))
                if fid and fid in seen_ids:
                    continue
                if fid:
                    seen_ids.add(fid)
                props = feature.get('properties') if isinstance(feature.get('properties'), dict) else {}
                dt_text = _i529_text(props.get('datetime') or props.get('start_datetime'))
                try:
                    dt = datetime.fromisoformat(dt_text.replace('Z', '+00:00'))
                except Exception:
                    continue
                date_key = dt.astimezone(timezone.utc).strftime('%Y-%m-%d')
                cloud = props.get('eo:cloud_cover')
                try:
                    cloud = float(cloud)
                except Exception:
                    cloud = None
                row = grouped.setdefault(date_key, {
                    'date': date_key, 'latest_acquisition': dt.astimezone(timezone.utc).isoformat(),
                    'cloud_values': [], 'scene_ids': set(), 'platforms': set(),
                })
                try:
                    current_latest = datetime.fromisoformat(_i529_text(row.get('latest_acquisition')).replace('Z', '+00:00'))
                except Exception:
                    current_latest = datetime.min.replace(tzinfo=timezone.utc)
                if dt.astimezone(timezone.utc) > current_latest.astimezone(timezone.utc):
                    row['latest_acquisition'] = dt.astimezone(timezone.utc).isoformat()
                if cloud is not None and math.isfinite(cloud):
                    row['cloud_values'].append(cloud)
                if fid:
                    row['scene_ids'].add(fid)
                platform = _i529_text(props.get('platform') or props.get('constellation'))
                if platform:
                    row['platforms'].add(platform)
        scenes = []
        for date_key, row in grouped.items():
            clouds = row['cloud_values']
            scenes.append({
                'date': date_key,
                'latest_acquisition': row['latest_acquisition'],
                'cloud_cover': min(clouds) if clouds else None,
                'scene_count': max(1, len(row['scene_ids'])),
                'platforms': sorted(row['platforms']),
            })
        scenes.sort(key=lambda row: row['date'], reverse=True)
        scenes = scenes[:80]
        result = {
            'ok': True, 'version': 'i535', 'source': 'Copernicus Sentinel Hub Catalog API',
            'collection': 'sentinel-2-l2a', 'scenes': scenes,
            'lookback_days': days, 'max_cloud': max_cloud, 'bbox_parts': len(bboxes),
            'credential_scope': 'current-authenticated-user-only', 'shared_credential_fallback': False,
            'cached': False,
        }
        with _I535_SEARCH_LOCK:
            _I535_SEARCH_CACHE[cache_key] = {'expires_at': time.time() + _I535_SEARCH_CACHE_SECONDS, 'result': dict(result)}
        return result

    def _i535_tile_bbox(z, x, y):
        n = 1 << z
        if x < 0 or y < 0 or x >= n or y >= n:
            raise ValueError('Tile coordinates are outside the requested zoom level.')
        origin = 20037508.342789244
        span = (origin * 2.0) / n
        minx = -origin + x * span
        maxx = minx + span
        maxy = origin - y * span
        miny = maxy - span
        return [minx, miny, maxx, maxy]

    def _i535_tile_lock(key):
        with _I535_TILE_LOCK_GUARD:
            lock = _I535_TILE_LOCKS.get(key)
            if lock is None:
                lock = threading.Lock()
                _I535_TILE_LOCKS[key] = lock
            return lock

    def _i535_user_semaphore(sess):
        key = _i535_user_hash(sess)
        with _I535_TILE_LOCK_GUARD:
            sem = _I535_USER_SEMAPHORES.get(key)
            if sem is None:
                sem = threading.BoundedSemaphore(4)
                _I535_USER_SEMAPHORES[key] = sem
            return sem

    def _i535_process_tile(sess, z, x, y, date_text, product, max_cloud):
        if product not in _I535_SENTINEL_PRODUCTS or product not in _I535_EVALSCRIPTS:
            raise ValueError('Unsupported Sentinel-2 product.')
        if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', date_text or ''):
            raise ValueError('Sentinel-2 tile date must use YYYY-MM-DD.')
        try:
            selected = datetime.strptime(date_text, '%Y-%m-%d').replace(tzinfo=timezone.utc)
        except Exception:
            raise ValueError('Sentinel-2 tile date is invalid.')
        if selected < datetime(2015, 6, 1, tzinfo=timezone.utc) or selected > datetime.now(timezone.utc) + timedelta(days=2):
            raise ValueError('Sentinel-2 tile date is outside the supported acquisition range.')
        z, x, y = int(z), int(x), int(y)
        if z < 0 or z > 16:
            raise ValueError('Sentinel-2 native tile zoom must be between 0 and 16.')
        max_cloud = max(0, min(100, int(max_cloud)))
        paths = _i535_user_paths(sess)
        cache_path = paths['cache'] / date_text / product / ('cc-' + str(max_cloud)) / str(z) / str(x) / (str(y) + '.png')
        try:
            if cache_path.is_file() and time.time() - cache_path.stat().st_mtime <= _I535_TILE_CACHE_SECONDS:
                body = cache_path.read_bytes()
                if body.startswith(b'\x89PNG\r\n\x1a\n'):
                    return body, True
        except Exception:
            pass
        lock_key = str(cache_path)
        with _i535_tile_lock(lock_key):
            try:
                if cache_path.is_file() and time.time() - cache_path.stat().st_mtime <= _I535_TILE_CACHE_SECONDS:
                    body = cache_path.read_bytes()
                    if body.startswith(b'\x89PNG\r\n\x1a\n'):
                        return body, True
            except Exception:
                pass
            bbox = _i535_tile_bbox(z, x, y)
            request_payload = {
                'input': {
                    'bounds': {'bbox': bbox, 'properties': {'crs': 'http://www.opengis.net/def/crs/EPSG/0/3857'}},
                    'data': [{
                        'type': 'sentinel-2-l2a',
                        'dataFilter': {
                            'timeRange': {'from': date_text + 'T00:00:00Z', 'to': date_text + 'T23:59:59Z'},
                            'maxCloudCoverage': max_cloud,
                            'mosaickingOrder': 'leastCC',
                        },
                        'processing': {'upsampling': 'BILINEAR', 'downsampling': 'BILINEAR'},
                    }],
                },
                'output': {
                    'width': 256, 'height': 256,
                    'responses': [{'identifier': 'default', 'format': {'type': 'image/png'}}],
                },
                'evalscript': _I535_EVALSCRIPTS[product],
            }
            sem = _i535_user_semaphore(sess)
            acquired = sem.acquire(timeout=30)
            if not acquired:
                raise RuntimeError('Sentinel Hub tile queue is busy. Try again shortly.')
            try:
                token = _i535_user_token(sess, False)
                try:
                    status, headers, body = _i535_api_request(_I535_PROCESS_ENDPOINT, token, 'POST', request_payload, 'image/png')
                except HTTPError as exc:
                    if exc.code != 401:
                        raise _i535_http_error(exc, 'Sentinel Hub Process API tile request')
                    token = _i535_user_token(sess, True)
                    try:
                        status, headers, body = _i535_api_request(_I535_PROCESS_ENDPOINT, token, 'POST', request_payload, 'image/png')
                    except HTTPError as retry_exc:
                        raise _i535_http_error(retry_exc, 'Sentinel Hub Process API tile request')
            finally:
                sem.release()
            if status < 200 or status >= 300:
                raise RuntimeError('Sentinel Hub Process API returned HTTP ' + str(status) + '.')
            if not body.startswith(b'\x89PNG\r\n\x1a\n'):
                preview = body[:500].decode('utf-8', errors='replace')
                raise RuntimeError('Sentinel Hub Process API did not return a PNG tile: ' + preview)
            _i529_atomic_write(cache_path, body, 0o600, True)
            return body, False

    _i535_get_before = Handler.do_GET
    def _i535_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == _I535_SENTINEL_ASSET_PATH:
            fp = Path(__file__).resolve().parent / 'assets' / _I535_SENTINEL_ASSET_NAME
            if not fp.is_file():
                self.send_response(404); self.send_header('Cache-Control', 'no-store'); self.end_headers(); return
            body = fp.read_bytes()
            self.send_response(200)
            self.send_header('Content-Type', 'application/javascript; charset=utf-8')
            self.send_header('Cache-Control', 'no-store, max-age=0')
            self.send_header('X-TAK-Map-Module', 'i535-sentinel-hub')
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            if getattr(self, 'command', 'GET') != 'HEAD': self.wfile.write(body)
            return
        if parsed.path == '/api/tak-map/account/sentinel-hub':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            sess = self._tak_map_session()
            if _i512_forced_change(sess): return self._send_json({'ok': False, 'password_change_required': True, 'error': 'Change the default local administrator password first.'}, 428)
            status = _i535_public_status(sess)
            return self._send_json(status, 200)
        tile_match = re.fullmatch(r'/api/tak-map/sentinel-hub/tile/(\d+)/(\d+)/(\d+)\.png', parsed.path)
        if tile_match:
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            sess = self._tak_map_session()
            query = parse_qs(parsed.query)
            try:
                body, cached = _i535_process_tile(
                    sess, int(tile_match.group(1)), int(tile_match.group(2)), int(tile_match.group(3)),
                    _i529_text((query.get('date') or [''])[0]),
                    _i529_text((query.get('product') or ['true_color'])[0]),
                    int((query.get('maxcc') or ['35'])[0]),
                )
                self.send_response(200)
                self.send_header('Content-Type', 'image/png')
                self.send_header('Cache-Control', 'private, max-age=3600')
                self.send_header('X-TAK-Map-Sentinel-Cache', 'HIT' if cached else 'MISS')
                self.send_header('X-Content-Type-Options', 'nosniff')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers()
                if getattr(self, 'command', 'GET') != 'HEAD': self.wfile.write(body)
                return
            except Exception as exc:
                message = str(exc)
                body = message.encode('utf-8', errors='replace')[:3000]
                self.send_response(428 if 'not configured' in message.lower() else 502)
                self.send_header('Content-Type', 'text/plain; charset=utf-8')
                self.send_header('Cache-Control', 'no-store')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers()
                if getattr(self, 'command', 'GET') != 'HEAD': self.wfile.write(body)
                return
        return _i535_get_before(self)
    Handler.do_GET = _i535_do_get

    _i535_post_before = Handler.do_POST
    def _i535_do_post(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/account/sentinel-hub':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            sess = self._tak_map_session()
            if _i512_forced_change(sess): return self._send_json({'ok': False, 'password_change_required': True, 'error': 'Change the default local administrator password first.'}, 428)
            payload = _read_json_body(self)
            action = _i529_text(payload.get('action') or 'test').lower()
            try:
                if action in ('save', 'replace'):
                    return self._send_json(_i535_save_credentials(sess, payload.get('client_id'), payload.get('client_secret')))
                if action == 'remove':
                    return self._send_json(_i535_remove_credentials(sess))
                if action == 'test':
                    client_id = _i529_text(payload.get('client_id'))
                    client_secret = _i529_text(payload.get('client_secret'))
                    if not client_id and not client_secret:
                        loaded = _i535_credentials_for_request(sess)
                        client_id, client_secret = loaded['client_id'], loaded['client_secret']
                    elif not client_id or not client_secret:
                        raise ValueError('Enter both Client ID and Client Secret, or leave both blank to test the saved credentials.')
                    tested = _i535_test_credentials(client_id, client_secret, cache_key=_i535_user_hash(sess))
                    now = datetime.now(timezone.utc).isoformat()
                    # Testing stored credentials refreshes the verification timestamp without returning either secret.
                    stored = _i535_load_credentials(sess)
                    if stored.get('ok') and stored.get('client_id') == client_id and stored.get('client_secret') == client_secret:
                        record = _i535_load_record(sess)
                        record['verified_at'] = now
                        record['last_tested_at'] = now
                        _i529_atomic_write(_i535_user_paths(sess)['credential'], json.dumps(record, indent=2, sort_keys=True) + '\n', 0o600, False)
                    status = _i535_public_status(sess)
                    status.update({'ok': True, 'verified': True, 'verified_at': now, 'last_tested_at': now, 'message': 'Sentinel Hub connection verified.', 'test': tested})
                    return self._send_json(status)
                raise ValueError('Unsupported Sentinel Hub action.')
            except Exception as exc:
                return self._send_json({'ok': False, 'version': 'i535', 'error': str(exc), 'shared_credential_fallback': False}, 400)
        if parsed.path == '/api/tak-map/sentinel-hub/search':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            sess = self._tak_map_session()
            if _i512_forced_change(sess): return self._send_json({'ok': False, 'password_change_required': True, 'error': 'Change the default local administrator password first.'}, 428)
            try:
                return self._send_json(_i535_search_scenes(sess, _read_json_body(self)))
            except Exception as exc:
                status = 428 if 'not configured' in str(exc).lower() else 502
                return self._send_json({'ok': False, 'version': 'i535', 'error': str(exc), 'shared_credential_fallback': False}, status)
        return _i535_post_before(self)
    Handler.do_POST = _i535_do_post

    _I535_RUNTIME = r'''<script id="takMapSentinelHubI535">
(function(w,d){'use strict';
const V='i535',by=id=>d.getElementById(id),esc=s=>String(s==null?'':s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));let status=null,observer=null;
function api(url,opt){return fetch(url,Object.assign({cache:'no-store',credentials:'same-origin'},opt||{})).then(async r=>{const j=await r.json().catch(()=>({ok:false,error:'HTTP '+r.status}));if(!r.ok||!j.ok)throw Error(j.error||('HTTP '+r.status));return j})}
function css(){if(by('takSentinelHubStyleI535'))return;const s=d.createElement('style');s.id='takSentinelHubStyleI535';s.textContent=`.topbar{z-index:30000!important;overflow:visible!important}.top-actions,.tak-account-v511{position:relative!important;z-index:30010!important}.tak-account-menu-v511{z-index:30020!important}.tak-sentinel-account-i535{margin:8px 0;padding:9px;border:1px solid rgba(118,181,210,.24);border-radius:9px;background:rgba(118,181,210,.045);display:grid;gap:7px;font-size:.72rem}.tak-sentinel-account-head-i535{display:flex;align-items:center;justify-content:space-between;gap:8px}.tak-sentinel-account-head-i535 b{letter-spacing:.06em;text-transform:uppercase}.tak-sentinel-state-i535{color:#9fb0ba}.tak-sentinel-state-i535.ok{color:#7ee787}.tak-sentinel-modal-i535{position:fixed;inset:0;z-index:50000;display:none;align-items:flex-start;justify-content:center;padding:72px 14px 24px;background:rgba(0,0,0,.70);overflow:auto}.tak-sentinel-modal-i535.open{display:flex}.tak-sentinel-card-i535{width:min(540px,100%);border:1px solid rgba(118,181,210,.45);border-radius:15px;background:linear-gradient(180deg,#111d27,#070c11);box-shadow:0 28px 80px rgba(0,0,0,.72);padding:14px;color:#edf4f7}.tak-sentinel-title-i535{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.tak-sentinel-title-i535 h3{margin:0;font-size:.94rem;letter-spacing:.06em;text-transform:uppercase}.tak-sentinel-close-i535{width:31px;height:31px;border-radius:8px}.tak-sentinel-form-i535{display:grid;gap:9px}.tak-sentinel-form-i535 label{display:grid;gap:4px;color:#9fb0ba;font-size:.72rem;font-weight:850}.tak-sentinel-form-i535 input{width:100%;box-sizing:border-box;min-height:36px;border:1px solid rgba(255,255,255,.16);border-radius:8px;background:#081018;color:#fff;padding:7px 9px}.tak-sentinel-help-i535{color:#9fb0ba;font-size:.72rem;line-height:1.45}.tak-sentinel-status-i535{min-height:38px;padding:8px;border:1px solid rgba(255,255,255,.10);border-radius:8px;background:rgba(0,0,0,.15);font-size:.72rem;line-height:1.45;color:#9fb0ba}.tak-sentinel-status-i535.ok{color:#7ee787;border-color:rgba(126,231,135,.30)}.tak-sentinel-status-i535.bad{color:#ff958e;border-color:rgba(255,149,142,.30)}.tak-sentinel-actions-i535{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.tak-sentinel-danger-i535{border-color:rgba(255,95,87,.55)!important;color:#ff958e!important}`;d.head.appendChild(s)}
function statusText(j){if(!j||!j.configured)return 'Not configured';if(j.verified)return 'Configured · Connection verified';return 'Configured · Test required'}
function ensureAccount(){const menu=by('takMapAccountMenuV511');if(!menu)return;let box=by('takSentinelAccountI535');if(box){renderAccount();return}box=d.createElement('section');box.id='takSentinelAccountI535';box.className='tak-sentinel-account-i535';box.innerHTML='<div class="tak-sentinel-account-head-i535"><b>Sentinel Hub</b><span id="takSentinelStateI535" class="tak-sentinel-state-i535">Checking…</span></div><button id="configureSentinelHubI535" type="button">Configure Sentinel Hub</button>';const actions=menu.querySelector('.tak-account-actions-v511');menu.insertBefore(box,actions||null);by('configureSentinelHubI535').addEventListener('click',openModal);renderAccount()}
function renderAccount(){const el=by('takSentinelStateI535');if(!el)return;el.textContent=statusText(status);el.classList.toggle('ok',!!(status&&status.verified))}
function ensureModal(){if(by('takSentinelModalI535'))return;const modal=d.createElement('div');modal.id='takSentinelModalI535';modal.className='tak-sentinel-modal-i535';modal.innerHTML='<section class="tak-sentinel-card-i535" role="dialog" aria-modal="true" aria-labelledby="takSentinelTitleI535"><div class="tak-sentinel-title-i535"><h3 id="takSentinelTitleI535">Copernicus Sentinel Hub</h3><button id="takSentinelCloseI535" class="tak-sentinel-close-i535" type="button" aria-label="Close">×</button></div><div class="tak-sentinel-form-i535"><div id="takSentinelSummaryI535" class="tak-sentinel-help-i535"></div><label>OAuth Client ID<input id="takSentinelClientIdI535" autocomplete="off" spellcheck="false" placeholder="Enter your Sentinel Hub Client ID"></label><label>OAuth Client Secret<input id="takSentinelClientSecretI535" type="password" autocomplete="new-password" placeholder="Enter your Client Secret"></label><div class="tak-sentinel-help-i535">Credentials are stored only on the TAK Map server for your signed-in account. A saved secret is never returned to the browser.</div><div id="takSentinelModalStatusI535" class="tak-sentinel-status-i535" aria-live="polite">Enter both values to test or save. Leave both fields blank to test already-saved credentials.</div><div class="tak-sentinel-actions-i535"><button id="takSentinelRemoveI535" class="tak-sentinel-danger-i535" type="button">Remove Credentials</button><button id="takSentinelTestI535" type="button">Test Connection</button><button id="takSentinelSaveI535" type="button">Save Credentials</button><button id="takSentinelDoneI535" type="button">Close</button></div></div></section>';d.body.appendChild(modal);by('takSentinelCloseI535').addEventListener('click',closeModal);by('takSentinelDoneI535').addEventListener('click',closeModal);by('takSentinelTestI535').addEventListener('click',testConnection);by('takSentinelSaveI535').addEventListener('click',saveCredentials);by('takSentinelRemoveI535').addEventListener('click',removeCredentials);modal.addEventListener('mousedown',e=>{if(e.target===modal)closeModal()});d.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))closeModal()})}
function setModalStatus(text,kind){const el=by('takSentinelModalStatusI535');if(!el)return;el.textContent=text;el.classList.remove('ok','bad');if(kind)el.classList.add(kind)}
function renderModal(){ensureModal();const summary=by('takSentinelSummaryI535'),remove=by('takSentinelRemoveI535'),save=by('takSentinelSaveI535'),id=by('takSentinelClientIdI535');if(summary)summary.textContent=status&&status.configured?'Saved Client ID: '+(status.client_id_hint||'configured')+' · '+statusText(status):'No Sentinel Hub credentials are saved for this user.';if(remove)remove.disabled=!(status&&status.configured);if(save)save.textContent=status&&status.configured?'Replace Credentials':'Save Credentials';if(id)id.placeholder=status&&status.configured?'Enter a Client ID to replace the saved credentials':'Enter your Sentinel Hub Client ID';if(status&&status.error)setModalStatus(status.error,'bad')}
async function loadStatus(){try{status=await api('/api/tak-map/account/sentinel-hub');ensureAccount();renderModal();return status}catch(e){status={ok:false,configured:false,error:e.message||String(e)};ensureAccount();renderModal();return status}}
async function openModal(){ensureModal();const menu=by('takMapAccountMenuV511');if(menu)menu.classList.remove('open');by('takSentinelModalI535').classList.add('open');await loadStatus();setModalStatus(statusText(status),status&&status.verified?'ok':'')}
function closeModal(){const m=by('takSentinelModalI535');if(m)m.classList.remove('open')}
function values(){return {client_id:String(by('takSentinelClientIdI535')?.value||'').trim(),client_secret:String(by('takSentinelClientSecretI535')?.value||'')}}
function busy(on){['takSentinelTestI535','takSentinelSaveI535','takSentinelRemoveI535'].forEach(id=>{const e=by(id);if(e)e.disabled=!!on||(id==='takSentinelRemoveI535'&&!(status&&status.configured))})}
async function testConnection(){busy(true);setModalStatus('Testing Sentinel Hub OAuth and Sentinel-2 L2A access…','');try{const v=values(),j=await api('/api/tak-map/account/sentinel-hub',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'test',client_id:v.client_id,client_secret:v.client_secret})});status=Object.assign({},status||{},j,{configured:(status&&status.configured)||j.configured});setModalStatus('Connection verified. Sentinel-2 L2A is available.','ok');renderAccount();renderModal()}catch(e){setModalStatus(e.message||String(e),'bad')}finally{busy(false)}}
async function saveCredentials(){const v=values();if(!v.client_id||!v.client_secret){setModalStatus('Enter both Client ID and Client Secret to save or replace credentials.','bad');return}busy(true);setModalStatus('Testing and saving credentials for your account…','');try{status=await api('/api/tak-map/account/sentinel-hub',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'save',client_id:v.client_id,client_secret:v.client_secret})});by('takSentinelClientSecretI535').value='';by('takSentinelClientIdI535').value='';setModalStatus('Credentials saved and connection verified.','ok');renderAccount();renderModal();w.dispatchEvent(new CustomEvent('takmap:sentinel-hub-changed',{detail:{configured:true,verified:true}}))}catch(e){setModalStatus(e.message||String(e),'bad')}finally{busy(false)}}
async function removeCredentials(){if(!(status&&status.configured))return;if(!confirm('Remove your saved Sentinel Hub credentials? Sentinel-2 imagery will become unavailable for this TAK Map account.'))return;busy(true);try{status=await api('/api/tak-map/account/sentinel-hub',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'remove'})});by('takSentinelClientSecretI535').value='';by('takSentinelClientIdI535').value='';setModalStatus('Credentials removed.','ok');renderAccount();renderModal();w.dispatchEvent(new CustomEvent('takmap:sentinel-hub-changed',{detail:{configured:false,verified:false}}))}catch(e){setModalStatus(e.message||String(e),'bad')}finally{busy(false)}}
function ensure(){ensureModal();if(by('takMapAccountMenuV511')&&!by('takSentinelAccountI535'))ensureAccount()}
function boot(){css();ensureModal();loadStatus();observer=new MutationObserver(()=>{if(by('takMapAccountMenuV511')&&!by('takSentinelAccountI535'))ensureAccount()});observer.observe(d.body,{childList:true,subtree:true});[200,800,1800].forEach(ms=>setTimeout(ensure,ms))}
if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapSentinelHubI535=Object.freeze({version:V,open:openModal,status:loadStatus,diagnostics:()=>status});
})(window,document);
</script>'''

    def _i535_version_html(html):
        if not isinstance(html, str): return html
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i535', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i535', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i535', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i535\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i535\2', html)
        return html

    def _i535_patch_html(html):
        html = _i535_version_html(html)
        if not isinstance(html, str): return html
        html = re.sub(r'<script[^>]*id=["\']takMapNrtSatelliteLoaderI525["\'][^>]*></script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapNrtSatelliteLoaderI535["\'][^>]*></script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapSentinelHubI535["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        payload = _I535_SENTINEL_LOADER + '\n' + _I535_RUNTIME
        return html.replace('</body>', payload + '\n</body>', 1) if '</body>' in html else html + payload

    TAK_MAP_HTML = _i535_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i535_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i535'

    _i535_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i535_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'): return built
        built = dict(built)
        try:
            root = ET.fromstring(_i529_text(built.get('wire_xml') or built.get('xml')).strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None: takv.set('version', '1.3.0-i535')
                meta = detail.find('takmap_user_presence')
                if meta is not None: meta.set('version', 'i535')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i535'
        except Exception as exc:
            built['i535_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i535_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = dict(_i535_presence_public_before(token, state) or {})
        out['version'] = 'i535'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i535_config_before = tak_map_config
    def tak_map_config():
        cfg = _i535_config_before()
        if not isinstance(cfg, dict): return cfg
        cfg = dict(cfg); cfg['tak_map_iteration'] = 'i535'; cfg['version'] = '1.3.0-i535'
        nrt = dict(cfg.get('nrt_satellite_imagery') or {})
        nrt.update({
            'version': 'i535', 'sentinel_2_l2a': True, 'sentinel_hub_process_api': True,
            'sentinel_hub_catalog_api': True, 'per_user_oauth_credentials': True,
            'shared_credential_fallback': False, 'server_side_secret_only': True,
            'credential_configuration': 'account-menu-button-modal',
            'sentinel_products': [dict({'id': key}, **value) for key, value in _I535_SENTINEL_PRODUCTS.items()],
            'current_map_area_search': True, 'cloud_filter': True, 'date_comparison': True,
            'tile_cache_hours': int(_I535_TILE_CACHE_SECONDS / 3600),
        })
        sources = list(nrt.get('sources') or [])
        if 'sentinel2_cdse' not in sources: sources.insert(0, 'sentinel2_cdse')
        nrt['sources'] = sources
        cfg['nrt_satellite_imagery'] = nrt
        account = dict(cfg.get('account_menu') or {})
        account.update({'version': 'i535', 'renders_above_toolbar': True, 'sentinel_hub_button': True, 'sentinel_hub_modal': True})
        cfg['account_menu'] = account
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _i535_point_xml_before = _i526_point_xml
    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i535_point_xml_before(feature, mission_name, creator_uid)
        if isinstance(built, dict):
            built = dict(built); built['version'] = 'i535'
        return built
    globals()['_i526_point_xml'] = _i526_point_xml

    _i535_native_before = tak_map_publish_native_points_to_mission_i526
    def tak_map_publish_native_points_to_mission_i526(points, mission_name='', server_host='', creator_uid=''):
        out = _i535_native_before(points, mission_name, server_host, creator_uid)
        if isinstance(out, dict):
            out = dict(out); out['version'] = 'i535'
        return out
    globals()['tak_map_publish_native_points_to_mission_i526'] = tak_map_publish_native_points_to_mission_i526

    _i535_data_sync_before = tak_map_data_sync
    def tak_map_data_sync():
        out = _i535_data_sync_before()
        if isinstance(out, dict):
            out = dict(out); out['version'] = 'i535'
        return out
    globals()['tak_map_data_sync'] = tak_map_data_sync
except Exception as _i535_exc:
    try: print('TAK Map i535 Sentinel Hub/account-layer patch failed:', _i535_exc)
    except Exception: pass
# --- end TAK Map i535 per-user Sentinel Hub + account-menu top layer ---


# --- TAK Map i536 Sentinel Hub Catalog response negotiation ---
try:
    _I536_CATALOG_ACCEPTS = (
        'application/geo+json, application/json',
        'application/geo+json',
        '*/*',
    )
    _I536_CATALOG_DIAGNOSTICS = threading.local()

    def _i536_catalog_error(exc, url, method, accepts, payload):
        status = int(getattr(exc, 'code', 0) or 0)
        body = ''
        try:
            body = exc.read(4000).decode('utf-8', errors='replace')
        except Exception:
            body = str(exc)
        try:
            parsed = json.loads(body)
            detail = parsed.get('description') or parsed.get('error_description') or parsed.get('message') or parsed.get('error') or body
        except Exception:
            detail = re.sub(r'<[^>]+>', ' ', body)
            detail = re.sub(r'\s+', ' ', detail).strip()
        request_type = 'application/json' if payload is not None else 'none'
        accepted = ' | '.join(accepts)
        return RuntimeError(
            'Sentinel Hub Catalog API request failed%s: %s '
            '[endpoint=%s; method=%s; request_content_type=%s; response_accept_attempts=%s]'
            % (
                (' with HTTP ' + str(status)) if status else '',
                _i529_text(detail)[:900] or str(exc),
                url,
                method,
                request_type,
                accepted,
            )
        )

    _i536_json_with_refresh_before = _i535_json_with_refresh
    def _i535_json_with_refresh(sess, url, method='GET', payload=None):
        is_catalog_search = (
            _i529_text(url).rstrip('/') == (_I535_CATALOG_BASE + '/search').rstrip('/')
            and _i529_text(method).upper() == 'POST'
        )
        if not is_catalog_search:
            return _i536_json_with_refresh_before(sess, url, method, payload)

        accepts = _I536_CATALOG_ACCEPTS

        def request_with_token(token):
            last_error = None
            for index, accept in enumerate(accepts):
                try:
                    status, headers, body = _i535_api_request(
                        url, token, method, payload, accept
                    )
                    _I536_CATALOG_DIAGNOSTICS.last = {
                        'endpoint': url,
                        'method': _i529_text(method).upper(),
                        'request_content_type': 'application/json',
                        'response_accept': accept,
                        'accept_attempt': index + 1,
                        'http_status': int(status),
                    }
                    return status, headers, body
                except HTTPError as exc:
                    last_error = exc
                    if int(getattr(exc, 'code', 0) or 0) == 406 and index + 1 < len(accepts):
                        try:
                            exc.close()
                        except Exception:
                            pass
                        continue
                    raise
            if last_error is not None:
                raise last_error
            raise RuntimeError('Sentinel Hub Catalog API request did not execute.')

        token = _i535_user_token(sess, False)
        try:
            status, headers, body = request_with_token(token)
        except HTTPError as exc:
            if int(getattr(exc, 'code', 0) or 0) == 401:
                token = _i535_user_token(sess, True)
                try:
                    status, headers, body = request_with_token(token)
                except HTTPError as retry_exc:
                    raise _i536_catalog_error(retry_exc, url, method, accepts, payload)
            else:
                raise _i536_catalog_error(exc, url, method, accepts, payload)
        try:
            value = json.loads(body.decode('utf-8'))
        except Exception as exc:
            diag = getattr(_I536_CATALOG_DIAGNOSTICS, 'last', {}) or {}
            raise RuntimeError(
                'Sentinel Hub Catalog API returned invalid JSON '
                '[endpoint=%s; method=%s; response_accept=%s; http_status=%s]: %s'
                % (
                    url,
                    _i529_text(method).upper(),
                    _i529_text(diag.get('response_accept')),
                    diag.get('http_status', ''),
                    exc,
                )
            )
        return value
    globals()['_i535_json_with_refresh'] = _i535_json_with_refresh

    _i536_search_before = _i535_search_scenes
    def _i535_search_scenes(sess, payload):
        result = _i536_search_before(sess, payload)
        if isinstance(result, dict):
            result = dict(result)
            result['version'] = 'i536'
            diag = dict(getattr(_I536_CATALOG_DIAGNOSTICS, 'last', {}) or {})
            if diag:
                result['catalog_negotiation'] = diag
            result['catalog_response_types'] = list(_I536_CATALOG_ACCEPTS)
        return result
    globals()['_i535_search_scenes'] = _i535_search_scenes

    _i536_public_status_before = _i535_public_status
    def _i535_public_status(sess):
        result = dict(_i536_public_status_before(sess) or {})
        result['version'] = 'i536'
        return result
    globals()['_i535_public_status'] = _i535_public_status

    _i536_version_html_replacements = (
        ('1.3.0-i535', '1.3.0-i536'),
        ('TAKDashboard/i535', 'TAKDashboard/i536'),
        ('TAK-Map/1.3.0 i535', 'TAK-Map/1.3.0 i536'),
    )
    def _i536_version_html(html):
        if not isinstance(html, str):
            return html
        for old, new in _i536_version_html_replacements:
            html = html.replace(old, new)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i536\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i536\2', html)
        return html

    TAK_MAP_HTML = _i536_version_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i536_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i536'

    _i536_config_before = tak_map_config
    def tak_map_config():
        cfg = _i536_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i536'
        cfg['version'] = '1.3.0-i536'
        nrt = dict(cfg.get('nrt_satellite_imagery') or {})
        nrt['version'] = 'i536'
        nrt['sentinel_catalog_response_negotiation'] = list(_I536_CATALOG_ACCEPTS)
        nrt['sentinel_catalog_request_content_type'] = 'application/json'
        cfg['nrt_satellite_imagery'] = nrt
        account = dict(cfg.get('account_menu') or {})
        account['version'] = 'i536'
        cfg['account_menu'] = account
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _i536_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i536_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(_i529_text(built.get('wire_xml') or built.get('xml')).strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None:
                    takv.set('version', '1.3.0-i536')
                meta = detail.find('takmap_user_presence')
                if meta is not None:
                    meta.set('version', 'i536')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i536'
        except Exception as exc:
            built['i536_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i536_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = dict(_i536_presence_public_before(token, state) or {})
        out['version'] = 'i536'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public
except Exception as _i536_exc:
    try:
        print('TAK Map i536 Sentinel Hub Catalog negotiation patch failed:', _i536_exc)
    except Exception:
        pass
# --- end TAK Map i536 Sentinel Hub Catalog response negotiation ---

# --- TAK Map i537 authoritative MIL-STD-2525C normalization and exact mission UID ownership ---
try:
    _I537_MIL_ROOT_CANDIDATES = (
        Path(os.environ.get('TAK_MAP_MIL_ROOT', '/usr/share/tak-server-dash/mil2525')),
    )
    _I537_RUNTIME_ASSET = Path(__file__).resolve().parent / 'assets' / 'tak-map-milstd2525c-i537.js'
    _I537_SYMBOL_LOCK = threading.RLock()
    _I537_REQUEST_CONTEXT = threading.local()
    _I537_MISSION_UID_CACHE = {}
    _I537_MISSION_UID_CACHE_SECONDS = 15.0

    def _i537_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i537_mil_root():
        for candidate in _I537_MIL_ROOT_CANDIDATES:
            try:
                if (candidate / 'icons.json').is_file() and (candidate / 'svg').is_dir():
                    return candidate
            except Exception:
                pass
        return _I537_MIL_ROOT_CANDIDATES[0]

    def _i537_normalize_sidc(value):
        raw = re.sub(r'[^A-Z0-9-]', '', _i537_text(value).upper().replace('*', '-'))
        if len(raw) < 4 or not raw.startswith('S'):
            return ''
        return (raw + '---------------')[:15]

    def _i537_sidc_core(value):
        sidc = _i537_normalize_sidc(value)
        return (sidc[:4] + sidc[4:10]) if sidc else ''

    def _i537_function_prefix(value):
        sidc = _i537_normalize_sidc(value)
        return sidc[4:10].rstrip('-') if sidc else ''

    def _i537_clean_icon_name(value):
        name = _i537_text(value).rsplit('/', 1)[-1].rsplit('\\', 1)[-1]
        name = re.sub(r'\.svg$', '', name, flags=re.I)
        return re.sub(r'[^A-Za-z0-9._-]', '', name)

    _I537_MIL_ICONS = []
    _I537_MIL_BY_NAME = {}
    _I537_MIL_BY_SIDC = {}
    _I537_MIL_BY_CORE = {}
    try:
        _i537_catalog_path = _i537_mil_root() / 'icons.json'
        _i537_catalog = json.loads(_i537_catalog_path.read_text(encoding='utf-8'))
        for _i537_raw_icon in _i537_catalog if isinstance(_i537_catalog, list) else []:
            if not isinstance(_i537_raw_icon, dict):
                continue
            _i537_name = _i537_clean_icon_name(_i537_raw_icon.get('name'))
            _i537_sidc = _i537_normalize_sidc(_i537_raw_icon.get('sidc'))
            if not _i537_name or not _i537_sidc:
                continue
            _i537_icon = dict(_i537_raw_icon)
            _i537_icon.update({'name': _i537_name, 'sidc': _i537_sidc})
            _I537_MIL_ICONS.append(_i537_icon)
            _I537_MIL_BY_NAME[_i537_name.lower()] = _i537_icon
            _I537_MIL_BY_SIDC.setdefault(_i537_sidc, _i537_icon)
            _I537_MIL_BY_CORE.setdefault(_i537_sidc_core(_i537_sidc), []).append(_i537_icon)
    except Exception as _i537_catalog_exc:
        print('TAK Map i537 MIL-STD catalog load failed:', _i537_catalog_exc)

    def _i537_cot_type_to_sidc(value):
        parts = [x for x in re.split(r'-+', _i537_text(value).lower()) if x]
        if len(parts) < 3 or parts[0] != 'a':
            return ''
        affiliation = {'f': 'F', 'h': 'H', 'n': 'N', 'u': 'U'}.get(parts[1])
        dimension = {'g': 'G', 'a': 'A', 's': 'S', 'u': 'U', 'p': 'P', 'e': 'E'}.get(parts[2])
        if not affiliation or not dimension:
            return ''
        function_id = re.sub(r'[^A-Z0-9]', '', ''.join(parts[3:]).upper())[:6]
        return ('S' + affiliation + dimension + 'P' + function_id + '---------------')[:15]

    def _i537_icon_for_sidc(value):
        sidc = _i537_normalize_sidc(value)
        if not sidc:
            return None
        exact = _I537_MIL_BY_SIDC.get(sidc)
        if exact:
            return exact
        same_core = _I537_MIL_BY_CORE.get(_i537_sidc_core(sidc)) or []
        distinct_core_sidcs = {_i537_normalize_sidc(row.get('sidc')) for row in same_core if isinstance(row, dict)}
        distinct_core_sidcs.discard('')
        if len(distinct_core_sidcs) == 1 and same_core:
            return same_core[0]
        requested = _i537_function_prefix(sidc)
        best = None
        best_length = -1
        for candidate_sidc, icon in _I537_MIL_BY_SIDC.items():
            if candidate_sidc[:4] != sidc[:4]:
                continue
            function_id = _i537_function_prefix(candidate_sidc)
            if function_id and requested.startswith(function_id) and len(function_id) < len(requested) and len(function_id) > best_length:
                best = icon
                best_length = len(function_id)
        return best

    def _i537_nested_dicts(value):
        if not isinstance(value, dict):
            return []
        out = []
        seen = set()
        stack = [(value, 0)]
        while stack and len(out) < 96:
            current, depth = stack.pop()
            if not isinstance(current, dict) or id(current) in seen:
                continue
            seen.add(id(current))
            out.append(current)
            if depth >= 4:
                continue
            for nested in current.values():
                if isinstance(nested, dict):
                    stack.append((nested, depth + 1))
        return out

    def _i537_values(objects, keys):
        out = []
        for obj in objects:
            for source in _i537_nested_dicts(obj):
                for key in keys:
                    value = source.get(key)
                    if value not in (None, '') and _i537_text(value):
                        out.append(value)
        return out

    def _i537_xml_strings(objects):
        values = []
        for obj in objects:
            for source in _i537_nested_dicts(obj):
                for value in source.values():
                    if isinstance(value, str) and '<' in value:
                        values.append(value)
        return values[:24]

    def _i537_xml_metadata(objects):
        out = {'name': '', 'sidc': '', 'cot_type': '', 'iconset_path': ''}
        for xml in _i537_xml_strings(objects):
            match = re.search(r'<takmap_point\b[^>]*\bmil2525Name=["\']([^"\']+)["\']', xml, re.I)
            if match and not out['name']:
                out['name'] = match.group(1)
            match = re.search(r'<takmap_point\b[^>]*\bsidc=["\']([^"\']+)["\']', xml, re.I)
            if match and not out['sidc']:
                out['sidc'] = match.group(1)
            match = re.search(r'<event\b[^>]*\btype=["\']([^"\']+)["\']', xml, re.I)
            if match and not out['cot_type']:
                out['cot_type'] = match.group(1)
            match = re.search(r'<usericon\b[^>]*\biconsetpath=["\']([^"\']+)["\']', xml, re.I)
            if match and not out['iconset_path']:
                out['iconset_path'] = match.group(1)
        return out

    def _i537_iconset_candidates(value):
        raw = _i537_text(value)
        names, sidcs, cot_types = [], [], []
        if not raw:
            return names, sidcs, cot_types
        for token in re.split(r'[\\/|;,\s]+', raw):
            if not token:
                continue
            name = _i537_clean_icon_name(token)
            if name:
                names.append(name)
            sidc = _i537_normalize_sidc(token)
            if sidc:
                sidcs.append(sidc)
            if re.match(r'^a-[fhnu]-[gasupe](?:-|$)', token, re.I):
                cot_types.append(token)
        sidcs.extend(re.findall(r'S[FHNU][GASUPE][A-Z0-9-]{12}', raw.upper()))
        cot_types.extend(re.findall(r'a-[fhnu]-[gasupe](?:-[a-z0-9]+){0,6}', raw, re.I))
        return names, sidcs, cot_types

    def _i537_symbol_result(icon, source, input_sidc=''):
        if not icon:
            return None
        return {
            'ok': True,
            'source': source,
            # Preserve the source SIDC when a catalog parent is used only as a
            # visual fallback. The catalog SIDC is diagnostic metadata.
            'sidc': _i537_normalize_sidc(input_sidc) or _i537_normalize_sidc(icon.get('sidc')),
            'catalog_sidc': _i537_normalize_sidc(icon.get('sidc')),
            'input_sidc': _i537_normalize_sidc(input_sidc),
            'name': _i537_clean_icon_name(icon.get('name')),
            'file': _i537_clean_icon_name(icon.get('name')) + '.svg',
            'label': _i537_text(icon.get('label')),
        }

    def _i537_resolve_symbol(*values):
        objects = [value for value in values if isinstance(value, dict)]
        if not objects:
            return None
        xml = _i537_xml_metadata(objects)

        sidcs = _i537_values(objects, (
            'sidc', 'SIDC', 'sidc2525', 'sidc_2525c', 'mil2525_sidc', 'milstd2525_sidc',
            'symbol_id', 'symbolId', 'symbolID', 'symbol_code', 'symbolCode'
        ))
        if xml.get('sidc'):
            sidcs.append(xml['sidc'])
        for raw in sidcs:
            sidc = _i537_normalize_sidc(raw)
            icon = _i537_icon_for_sidc(sidc)
            if icon:
                return _i537_symbol_result(icon, 'sidc', sidc)

        names = _i537_values(objects, (
            'mil2525_name', 'milstd2525_name', 'mil2525_file', 'mil2525_svg',
            'symbol_name', 'symbolName', 'icon_name', 'iconName'
        ))
        if xml.get('name'):
            names.append(xml['name'])
        for raw in names:
            name = _i537_clean_icon_name(raw).lower()
            icon = _I537_MIL_BY_NAME.get(name)
            if icon:
                return _i537_symbol_result(icon, 'exact-name')

        iconsets = _i537_values(objects, (
            'iconsetPath', 'iconsetpath', 'iconset_path', '@iconsetpath', '@iconsetPath',
            'usericon_path', 'user_icon_path', 'icon_path', 'iconPath', 'icon'
        ))
        if xml.get('iconset_path'):
            iconsets.append(xml['iconset_path'])
        for raw in iconsets:
            candidate_names, candidate_sidcs, candidate_types = _i537_iconset_candidates(raw)
            for sidc in candidate_sidcs:
                icon = _i537_icon_for_sidc(sidc)
                if icon:
                    return _i537_symbol_result(icon, 'iconset-sidc', sidc)
            for name in candidate_names:
                icon = _I537_MIL_BY_NAME.get(name.lower())
                if icon:
                    return _i537_symbol_result(icon, 'iconset-name')
            for cot_type in candidate_types:
                sidc = _i537_cot_type_to_sidc(cot_type)
                icon = _i537_icon_for_sidc(sidc)
                if icon:
                    return _i537_symbol_result(icon, 'iconset-cot-type', sidc)

        cot_types = _i537_values(objects, ('atak_cot_type', 'cot_type', 'event_type', 'eventType', 'type'))
        if xml.get('cot_type'):
            cot_types.append(xml['cot_type'])
        for cot_type in cot_types:
            direct_sidc = _i537_normalize_sidc(cot_type)
            if direct_sidc:
                icon = _i537_icon_for_sidc(direct_sidc)
                if icon:
                    return _i537_symbol_result(icon, 'type-sidc', direct_sidc)
            sidc = _i537_cot_type_to_sidc(cot_type)
            icon = _i537_icon_for_sidc(sidc)
            if icon:
                return _i537_symbol_result(icon, 'cot-type', sidc)
        return None

    def _i537_apply_symbol(obj, *raw_values):
        if not isinstance(obj, dict):
            return obj
        result = _i537_resolve_symbol(obj, *raw_values)
        if not result:
            return obj
        obj['sidc'] = result['sidc']
        obj['SIDC'] = result['sidc']
        obj['mil2525_name'] = result['name']
        obj['mil2525_file'] = result['file']
        if result.get('label') and not obj.get('mil2525_label'):
            obj['mil2525_label'] = result['label']
        obj['symbol_resolution_i537'] = {
            'version': 'i537',
            'source': result.get('source'),
            'input_sidc': result.get('input_sidc') or '',
            'catalog_sidc': result.get('catalog_sidc') or result.get('sidc') or '',
        }
        props = obj.get('properties')
        if isinstance(props, dict):
            props.setdefault('sidc', result['sidc'])
            props.setdefault('SIDC', result['sidc'])
            props.setdefault('mil2525_name', result['name'])
            props.setdefault('mil2525_file', result['file'])
            if result.get('label'):
                props.setdefault('mil2525_label', result['label'])
        return obj

    def _i537_walk_symbol_objects(value, limit=5000):
        count = 0
        stack = [value]
        while stack and count < limit:
            current = stack.pop()
            if isinstance(current, dict):
                keys = set(current)
                if keys.intersection({'sidc', 'SIDC', 'mil2525_sidc', 'mil2525_name', 'milstd2525_name', 'cot_type', 'atak_cot_type', 'event_type', 'type', 'iconsetPath', 'iconsetpath', 'properties'}):
                    _i537_apply_symbol(current)
                    count += 1
                for nested in current.values():
                    if isinstance(nested, (dict, list)):
                        stack.append(nested)
            elif isinstance(current, list):
                stack.extend(current)
        return count

    def _i537_identity_key():
        explicit = _i537_text(getattr(_I537_REQUEST_CONTEXT, 'identity_key', ''))
        if explicit:
            return explicit.casefold()
        try:
            identity = getattr(_I512_REQUEST_CONTEXT, 'identity', {}) or {}
            username = _i537_text(identity.get('username')) if isinstance(identity, dict) else ''
            if username:
                return username.casefold()
        except Exception:
            pass
        return ''

    def _i537_object_uid(value):
        if not isinstance(value, dict):
            return ''
        for source in _i537_nested_dicts(value):
            for key in ('uid', 'cot_uid', 'event_uid', 'id'):
                uid = _i537_text(source.get(key))
                if uid:
                    return uid.casefold()
        for xml in _i537_xml_strings([value]):
            match = re.search(r'<event\b[^>]*\buid=["\']([^"\']+)["\']', xml, re.I)
            if match:
                return _i537_text(match.group(1)).casefold()
        return ''

    def _i537_point_like(value):
        if not isinstance(value, dict):
            return False
        geometry = value.get('geometry')
        if isinstance(geometry, dict):
            return _i537_text(geometry.get('type')).lower() == 'point'
        if _i537_text(geometry).lower() == 'point' or _i537_text(value.get('kind')).lower() in ('point', 'datasync', 'cot', 'eud'):
            return True
        try:
            return math.isfinite(float(value.get('lat'))) and math.isfinite(float(value.get('lon')))
        except Exception:
            return bool(_i537_xml_strings([value]))

    def _i537_update_mission_uid_cache(payload, identity_key=''):
        key = _i537_text(identity_key or _i537_identity_key()).casefold()
        if not key or not isinstance(payload, dict):
            return set()
        uids = set()
        for row in list(payload.get('objects') or []):
            if isinstance(row, dict) and _i537_point_like(row):
                uid = _i537_object_uid(row)
                if uid:
                    uids.add(uid)
        with _I537_SYMBOL_LOCK:
            _I537_MISSION_UID_CACHE[key] = {'time': time.time(), 'uids': set(uids)}
        return uids

    def _i537_cached_mission_uids(identity_key='', refresh=False):
        key = _i537_text(identity_key or _i537_identity_key()).casefold()
        if not key:
            return set()
        with _I537_SYMBOL_LOCK:
            cached = dict(_I537_MISSION_UID_CACHE.get(key) or {})
        if not refresh and cached and time.time() - float(cached.get('time') or 0) <= _I537_MISSION_UID_CACHE_SECONDS:
            return set(cached.get('uids') or set())
        try:
            payload = tak_map_data_sync()
            return _i537_update_mission_uid_cache(payload, key)
        except Exception:
            return set(cached.get('uids') or set())

    def _i537_is_exact_mission_uid(row, xml=''):
        key = _i537_identity_key()
        if not key:
            return False
        uid = _i537_object_uid(row if isinstance(row, dict) else {'xml': xml})
        if not uid and xml:
            uid = _i537_object_uid({'xml': xml})
        return bool(uid and uid in _i537_cached_mission_uids(key))

    # Replace the i528 prefix/name heuristic at its runtime call site. Exact UID
    # ownership is source-safe and applies to ATAK, TAK Map, and other TAK clients.
    if '_i528_is_mission_point_live_row' in globals():
        def _i528_is_mission_point_live_row(row, xml=''):
            return _i537_is_exact_mission_uid(row, xml)
        globals()['_i528_is_mission_point_live_row'] = _i528_is_mission_point_live_row

    _i537_normalize_before = _normalize_tak_marker
    def _normalize_tak_marker(row, source_table='cot', default_kind='cot'):
        marker = _i537_normalize_before(row, source_table, default_kind)
        return _i537_apply_symbol(marker, row) if isinstance(marker, dict) else marker
    globals()['_normalize_tak_marker'] = _normalize_tak_marker

    _i537_data_sync_before = tak_map_data_sync
    def tak_map_data_sync():
        out = _i537_data_sync_before()
        if isinstance(out, dict):
            _i537_walk_symbol_objects(out)
            uids = _i537_update_mission_uid_cache(out)
            out['milstd2525c_i537'] = {
                'version': 'i537',
                'catalog_icons': len(_I537_MIL_ICONS),
                'source_normalization': ['sidc', 'exact-name', 'usericon', 'cot-type'],
                'battle_dimensions': ['ground', 'air', 'sea-surface', 'subsurface', 'space', 'emergency'],
                'mission_point_uid_count': len(uids),
                'mission_live_ownership': 'exact-uid-only',
            }
        return out
    globals()['tak_map_data_sync'] = tak_map_data_sync

    if '_i512_augment_data_sync' in globals():
        _i537_augment_before = _i512_augment_data_sync
        def _i512_augment_data_sync(base, cfg, sess):
            out = _i537_augment_before(base, cfg, sess)
            if isinstance(out, dict):
                _i537_walk_symbol_objects(out)
                username = _i537_text((sess or {}).get('username') or ((sess or {}).get('profile') or {}).get('username'))
                _i537_update_mission_uid_cache(out, username)
            return out
        globals()['_i512_augment_data_sync'] = _i512_augment_data_sync

    _i537_cot_before = tak_map_cot_markers
    def tak_map_cot_markers():
        out = _i537_cot_before()
        if isinstance(out, dict):
            markers = []
            removed = []
            for row in list(out.get('markers') or []):
                _i537_apply_symbol(row)
                if _i537_is_exact_mission_uid(row):
                    if len(removed) < 40:
                        removed.append(_i537_object_uid(row))
                    continue
                markers.append(row)
            out['markers'] = markers
            out['mission_uid_ownership_i537'] = {'version': 'i537', 'mode': 'exact-uid-only', 'removed_count': len(removed), 'removed_uids': removed}
        return out
    globals()['tak_map_cot_markers'] = tak_map_cot_markers

    _i537_euds_before = tak_map_euds
    def tak_map_euds():
        out = _i537_euds_before()
        if isinstance(out, dict):
            euds = []
            removed = []
            for row in list(out.get('euds') or []):
                _i537_apply_symbol(row)
                if _i537_is_exact_mission_uid(row):
                    if len(removed) < 40:
                        removed.append(_i537_object_uid(row))
                    continue
                euds.append(row)
            out['euds'] = euds
            out['mission_uid_ownership_i537'] = {'version': 'i537', 'mode': 'exact-uid-only', 'removed_count': len(removed), 'removed_uids': removed}
        return out
    globals()['tak_map_euds'] = tak_map_euds

    _i537_imported_before = tak_map_imported
    def tak_map_imported():
        out = _i537_imported_before()
        if isinstance(out, dict):
            _i537_walk_symbol_objects(out)
            out['milstd2525c_i537'] = {'version': 'i537', 'catalog_icons': len(_I537_MIL_ICONS), 'source_normalized': True}
        return out
    globals()['tak_map_imported'] = tak_map_imported

    def _i537_send_static(handler, path, content_type, cache_control):
        try:
            body = path.read_bytes()
        except FileNotFoundError:
            return False
        handler.send_response(200)
        handler.send_header('Content-Type', content_type)
        handler.send_header('Cache-Control', cache_control)
        handler.send_header('X-Content-Type-Options', 'nosniff')
        handler.send_header('X-TAK-Map-Module', 'i537-milstd2525c')
        handler.send_header('Content-Length', str(len(body)))
        handler.end_headers()
        if getattr(handler, 'command', 'GET') != 'HEAD':
            try:
                handler.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass
        return True

    _i537_get_before = Handler.do_GET
    def _i537_do_get(self):
        parsed = urlparse(self.path)
        path = parsed.path or ''
        if path == '/assets/runtime/tak-map-milstd2525c-i537.js':
            if _i537_send_static(self, _I537_RUNTIME_ASSET, 'application/javascript; charset=utf-8', 'no-store, max-age=0'):
                return
        if path in ('/mil2525/icons.json', '/assets/mil2525/icons.json'):
            if _i537_send_static(self, _i537_mil_root() / 'icons.json', 'application/json; charset=utf-8', 'public, max-age=3600'):
                return
        if path.startswith('/mil2525/svg/') or path.startswith('/assets/mil2525/svg/'):
            try:
                name = unquote(path.split('/svg/', 1)[1])
            except Exception:
                name = ''
            if name and '/' not in name and '\\' not in name and '..' not in name and name.lower().endswith('.svg'):
                if _i537_send_static(self, _i537_mil_root() / 'svg' / name, 'image/svg+xml; charset=utf-8', 'public, max-age=604800, immutable'):
                    return
        if path in ('/api/tak-map/cot', '/api/tak-map/euds'):
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session() or {}
            _I537_REQUEST_CONTEXT.identity_key = _i537_text(sess.get('username') or (sess.get('profile') or {}).get('username'))
            try:
                if path == '/api/tak-map/cot':
                    return self._send_json(tak_map_cot_markers())
                query = parse_qs(parsed.query or '')
                online_only = _i537_text((query.get('online') or query.get('send') or query.get('fresh') or ['0'])[0]).lower() in ('1', 'true', 'yes', 'on')
                data = tak_map_euds()
                if online_only:
                    data['euds'] = [e for e in (data.get('euds') or []) if _is_online_send_eud(e)]
                    data['online_only'] = True
                return self._send_json(data)
            finally:
                _I537_REQUEST_CONTEXT.identity_key = ''
        return _i537_get_before(self)
    Handler.do_GET = _i537_do_get

    _I537_LOADER = '<script id="takMapMilStd2525CLoaderI537" src="/assets/runtime/tak-map-milstd2525c-i537.js?v=1.3.0-i537"></script>'
    def _i537_patch_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'<script[^>]*id=["\']takMapMilStd2525CLoaderI537["\'][^>]*></script>\s*', '', html, flags=re.I)
        if '</body>' in html:
            html = html.replace('</body>', _I537_LOADER + '\n</body>', 1)
        else:
            html += _I537_LOADER
        html = html.replace('1.3.0-i536', '1.3.0-i537').replace('TAKDashboard/i536', 'TAKDashboard/i537').replace('TAK-Map/1.3.0 i536', 'TAK-Map/1.3.0 i537')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i537\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i537\2', html)
        return html

    TAK_MAP_HTML = _i537_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i537_patch_html(TAK_MAP_LOGIN_HTML).replace(_I537_LOADER, '')
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i537'

    # Keep the persistent per-user EUD identity and OTS diagnostics aligned
    # with the active TAK Map build.  The i536 layer intentionally stamped
    # its own release into the outgoing CoT; wrap the final builder rather
    # than changing older historical layers.
    _i537_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i537_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(_i537_text(built.get('wire_xml') or built.get('xml')).strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None:
                    takv.set('version', '1.3.0-i537')
                meta = detail.find('takmap_user_presence')
                if meta is not None:
                    meta.set('version', 'i537')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i537'
        except Exception as exc:
            built['i537_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i537_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = _i537_presence_public_before(token, state)
        if isinstance(out, dict):
            out = dict(out)
            out['version'] = 'i537'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i537_config_before = tak_map_config
    def tak_map_config():
        cfg = _i537_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i537'
        cfg['version'] = '1.3.0-i537'
        cfg['milstd2525c'] = {
            'version': 'i537',
            'standard': 'MIL-STD-2525C',
            'catalog_icons': len(_I537_MIL_ICONS),
            'catalog_complete': len(_I537_MIL_ICONS) == 1448,
            'supported_affiliations': ['friendly', 'hostile', 'neutral', 'unknown'],
            'supported_battle_dimensions': ['ground', 'air', 'sea-surface', 'subsurface', 'space', 'emergency'],
            'source_precedence': ['SIDC', 'exact TAK Map icon name', 'ATAK usericon', 'CoT type'],
            'data_sources': ['Local Data', 'Data Sync', 'Live TAK CoT', 'EUDs', 'imports', 'Replay', 'Gateway Data when MIL metadata is supplied'],
            'mission_duplicate_ownership': 'exact UID only',
            'static_delivery': 'nginx direct with Python fallback',
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i537_exc:
    try:
        print('TAK Map i537 MIL-STD-2525C patch failed:', _i537_exc)
    except Exception:
        pass
# --- end TAK Map i537 authoritative MIL-STD-2525C normalization and exact mission UID ownership ---


# --- TAK Map i538 startup-safe MIL-STD/Data Sync hotfix ---
try:
    _I538_RUNTIME_ASSET = Path(__file__).resolve().parent / 'assets' / 'tak-map-milstd2525c-i538.js'
    _I538_SIDC_ICON_CACHE = {}

    # i537's controlled parent fallback scanned the complete catalog for every
    # generic CoT type. Cache the result by normalized SIDC so repeated live
    # markers remain O(1) after the first lookup.
    _i538_icon_for_sidc_before = _i537_icon_for_sidc
    def _i537_icon_for_sidc(value):
        sidc = _i537_normalize_sidc(value)
        if not sidc:
            return None
        with _I537_SYMBOL_LOCK:
            if sidc in _I538_SIDC_ICON_CACHE:
                return _I538_SIDC_ICON_CACHE[sidc]
        resolved = _i538_icon_for_sidc_before(sidc)
        with _I537_SYMBOL_LOCK:
            _I538_SIDC_ICON_CACHE[sidc] = resolved
        return resolved
    globals()['_i537_icon_for_sidc'] = _i537_icon_for_sidc

    # Normalized rows are encountered a second time by the final COT/EUD
    # ownership pass. Do not repeat deep metadata traversal and symbol lookup.
    _i538_apply_symbol_before = _i537_apply_symbol
    def _i537_apply_symbol(obj, *raw_values):
        if isinstance(obj, dict) and obj.get('mil2525_file') and isinstance(obj.get('symbol_resolution_i537'), dict):
            return obj
        return _i538_apply_symbol_before(obj, *raw_values)
    globals()['_i537_apply_symbol'] = _i537_apply_symbol

    # Never execute a full Data Sync/database refresh from inside /cot or /euds.
    # The normal Data Sync request populates this per-user cache, and the i538
    # browser response filter provides the same exact-UID ownership guarantee.
    def _i537_cached_mission_uids(identity_key='', refresh=False):
        key = _i537_text(identity_key or _i537_identity_key()).casefold()
        if not key:
            return set()
        with _I537_SYMBOL_LOCK:
            cached = dict(_I537_MISSION_UID_CACHE.get(key) or {})
        return set(cached.get('uids') or set())
    globals()['_i537_cached_mission_uids'] = _i537_cached_mission_uids

    _i538_get_before = Handler.do_GET
    def _i538_do_get(self):
        path = urlparse(self.path).path or ''
        if path == '/assets/runtime/tak-map-milstd2525c-i538.js':
            if _i537_send_static(self, _I538_RUNTIME_ASSET, 'application/javascript; charset=utf-8', 'no-store, max-age=0'):
                return
        return _i538_get_before(self)
    Handler.do_GET = _i538_do_get

    _I538_LOADER = '<script id="takMapMilStd2525CLoaderI538" src="/assets/runtime/tak-map-milstd2525c-i538.js?v=1.3.0-i538"></script>'
    def _i538_patch_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'<script[^>]*id=["\']takMapMilStd2525CLoaderI537["\'][^>]*></script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapMilStd2525CLoaderI538["\'][^>]*></script>\s*', '', html, flags=re.I)
        if '</body>' in html:
            html = html.replace('</body>', _I538_LOADER + '\n</body>', 1)
        else:
            html += _I538_LOADER
        html = html.replace('1.3.0-i537', '1.3.0-i538').replace('TAKDashboard/i537', 'TAKDashboard/i538').replace('TAK-Map/1.3.0 i537', 'TAK-Map/1.3.0 i538')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i538\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i538\2', html)
        return html

    TAK_MAP_HTML = _i538_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i538_patch_html(TAK_MAP_LOGIN_HTML).replace(_I538_LOADER, '')
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i538'

    _i538_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i538_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(_i537_text(built.get('wire_xml') or built.get('xml')).strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None:
                    takv.set('version', '1.3.0-i538')
                meta = detail.find('takmap_user_presence')
                if meta is not None:
                    meta.set('version', 'i538')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i538'
        except Exception as exc:
            built['i538_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i538_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = _i538_presence_public_before(token, state)
        if isinstance(out, dict):
            out = dict(out)
            out['version'] = 'i538'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i538_config_before = tak_map_config
    def tak_map_config():
        cfg = _i538_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i538'
        cfg['version'] = '1.3.0-i538'
        mil = dict(cfg.get('milstd2525c') or {})
        mil.update({
            'version': 'i538',
            'startup_safe': True,
            'global_dom_observer': False,
            'sidc_resolution_cache': True,
            'cot_eud_sync_refresh_on_cache_miss': False,
        })
        cfg['milstd2525c'] = mil
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i538_exc:
    try:
        print('TAK Map i538 startup-safe MIL-STD/Data Sync hotfix failed:', _i538_exc)
    except Exception:
        pass
# --- end TAK Map i538 startup-safe MIL-STD/Data Sync hotfix ---


# --- TAK Map i539 Data Sync deletion reconciliation + non-blocking user scope ---
try:
    _I539_SCOPE_LOCK = threading.RLock()
    _I539_SCOPE_CACHE = {}
    _I539_SCOPE_SUCCESS_SECONDS = 45.0
    _I539_SCOPE_FAILURE_SECONDS = 300.0

    def _i539_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i539_identity_key(sess=None, cfg=None):
        sess = sess or {}
        cfg = cfg or {}
        profile = dict(sess.get('profile') or {})
        username = _i539_text(sess.get('username') or profile.get('username')).casefold()
        origin = _i539_text(cfg.get('marti_url') or cfg.get('base_url')).rstrip('/').casefold()
        return username + '|' + origin

    def _i539_status_from_result(result):
        try:
            status = int(result.get('status') or 0)
        except Exception:
            status = 0
        if status:
            return status
        for attempt in reversed(list(result.get('attempts') or [])):
            try:
                status = int((attempt or {}).get('status') or 0)
            except Exception:
                status = 0
            if status:
                return status
        return 0

    def _i539_user_mission_scope(cfg, sess):
        if not _i539_text((sess or {}).get('auth_mode')).startswith('ots-'):
            return {
                'ok': False,
                'state': 'not-applicable',
                'missions': [],
                'cached': False,
                'status': 0,
                'error': 'Local Login session',
                'duration_ms': 0,
            }
        key = _i539_identity_key(sess, cfg)
        now = time.time()
        with _I539_SCOPE_LOCK:
            cached = dict(_I539_SCOPE_CACHE.get(key) or {})
        ttl = _I539_SCOPE_SUCCESS_SECONDS if cached.get('ok') else _I539_SCOPE_FAILURE_SECONDS
        if cached and now - float(cached.get('time') or 0.0) <= ttl:
            cached['cached'] = True
            return cached

        started = time.monotonic()
        result = _ots_mission_api_request(
            '/Marti/api/missions',
            method='GET',
            public_host='',
            timeout=4,
        )
        body = result.get('json')
        if not isinstance(body, (dict, list)):
            try:
                body = json.loads(_i539_text(result.get('body')) or '{}')
            except Exception:
                body = {}
        names = _i512_mission_names(body) if result.get('ok') else []
        status = _i539_status_from_result(result)
        record = {
            'ok': bool(result.get('ok')),
            'state': 'ok' if result.get('ok') else 'unavailable',
            'missions': list(dict.fromkeys(_i539_text(name) for name in names if _i539_text(name))),
            'cached': False,
            'status': status,
            'error': '' if result.get('ok') else _i539_text(result.get('error') or 'Per-user Marti mission list request failed.'),
            'duration_ms': int((time.monotonic() - started) * 1000),
            'identity_mode': _i539_text(result.get('identity_mode') or 'per-user-enrolled-marti-certificate'),
            'certificate_cn': _i539_text(result.get('certificate_cn')),
            'client_uid': _i539_text(result.get('client_uid')),
            'time': time.time(),
        }
        with _I539_SCOPE_LOCK:
            _I539_SCOPE_CACHE[key] = dict(record)
        return record

    def _i539_membership_mission(row, mission_by_id):
        if not isinstance(row, dict):
            return ''
        # In mission_uids and mission_content, `name` identifies the object,
        # callsign, or filename—not the mission. Resolve mission ownership only
        # from explicit mission fields or the mission foreign key.
        name = _i539_text(_tak_row_value(row, ('mission_name', 'missionName', 'mission'), ''))
        if name:
            return name
        ident = _i539_text(_tak_row_value(row, ('mission_id', 'missionId', 'missionid'), ''))
        return _i539_text(mission_by_id.get(ident, ''))

    def _tak_data_sync_ownership(data):
        mission_by_id, _ = _tak_mission_name_maps(data)
        uid_missions = {}
        content_missions = {}
        content_alias = {}
        for row in data.get('mission_uids') or []:
            if not isinstance(row, dict):
                continue
            uid = _i539_text(_tak_row_value(row, ('uid', 'cot_uid', 'cotUid', 'data_uid'), ''))
            mission = _i539_membership_mission(row, mission_by_id)
            if uid and mission:
                uid_missions.setdefault(uid, set()).add(mission)
        for row in data.get('mission_content') or []:
            if not isinstance(row, dict):
                continue
            content_id = _i539_text(_tak_row_value(row, ('id', 'content_id', 'contentId'), ''))
            hash_value = _i539_text(_tak_row_value(row, ('hash', 'sha256', 'content_hash', 'contentHash'), ''))
            aliases = []
            for key in ('name', 'filename', 'uid', 'guid', 'id'):
                value = _i539_text(_tak_row_value(row, (key,), ''))
                if value:
                    aliases.append(value)
            if content_id and hash_value:
                content_alias[content_id] = hash_value
            for alias in aliases:
                if hash_value:
                    content_alias[alias] = hash_value
            mission = _i539_membership_mission(row, mission_by_id)
            if mission and hash_value:
                content_missions.setdefault(hash_value, set()).add(mission)
        for row in data.get('mission_content_mission') or []:
            if not isinstance(row, dict):
                continue
            mission = _i539_membership_mission(row, mission_by_id)
            reference = _i539_text(_tak_row_value(row, ('hash', 'content_hash', 'contentHash', 'content_id', 'contentId', 'mission_content_id', 'missionContentId'), ''))
            hash_value = content_alias.get(reference, reference)
            if mission and hash_value:
                content_missions.setdefault(hash_value, set()).add(mission)
        return uid_missions, content_missions, content_alias
    globals()['_tak_data_sync_ownership'] = _tak_data_sync_ownership

    def _i539_row_mission(row, mission_by_id):
        try:
            return _i539_membership_mission(row, mission_by_id)
        except Exception:
            return ''

    def _i539_scope_raw_rows(out, allowed_names):
        allowed = {_i539_text(name).casefold() for name in (allowed_names or []) if _i539_text(name)}
        if not allowed:
            # A successful empty mission list means the user is not subscribed to
            # any missions; return an empty scoped Data Sync view.
            out = dict(out or {})
            for key in ('missions', 'mission_content', 'mission_logs', 'mission_roles', 'mission_uids', 'mission_content_mission', 'packages'):
                if isinstance(out.get(key), list):
                    out[key] = []
            out['objects'] = []
            return out
        out = dict(out or {})
        mission_by_id, _ = _tak_mission_name_maps(out)
        kept_missions = []
        kept_ids = set()
        for row in list(out.get('missions') or []):
            if not isinstance(row, dict):
                continue
            name = _i539_text(_tak_row_value(row, ('name', 'mission_name', 'missionName', 'title'), ''))
            if name.casefold() not in allowed:
                continue
            kept_missions.append(row)
            ident = _i539_text(_tak_row_value(row, ('id', 'mission_id', 'missionId', 'guid'), ''))
            if ident:
                kept_ids.add(ident)
        out['missions'] = kept_missions

        for key in ('mission_content', 'mission_logs', 'mission_roles', 'mission_uids', 'mission_content_mission'):
            rows = []
            for row in list(out.get(key) or []):
                if not isinstance(row, dict):
                    continue
                mission = _i539_row_mission(row, mission_by_id)
                ident = _i539_text(_tak_row_value(row, ('mission_id', 'missionId', 'missionid'), ''))
                if (mission and mission.casefold() in allowed) or (ident and ident in kept_ids):
                    rows.append(row)
            out[key] = rows
        # Packages can be global rows in OTS. Preserve rows that do not expose a
        # mission field; filter only rows that explicitly identify another mission.
        packages = []
        for row in list(out.get('packages') or []):
            if not isinstance(row, dict):
                continue
            mission = _i539_row_mission(row, mission_by_id)
            if not mission or mission.casefold() in allowed:
                packages.append(row)
        out['packages'] = packages
        return out

    def _i539_filter_deleted_orphans(payload, allowed_missions=None):
        if not isinstance(payload, dict):
            return payload
        out = dict(payload)
        if allowed_missions is not None:
            out = _i539_scope_raw_rows(out, allowed_missions)

        # Recompute source-owned deletion metadata from the current mission
        # membership rows. OTS may retain a historical mission_uids/CoT row after
        # ATAK removes the UID association; that row is not a current mission item.
        out = _tak_enrich_data_sync_result(out)
        uid_missions, _, _ = _tak_data_sync_ownership(out)
        normalized_membership = {
            _i539_text(uid).casefold(): {_i539_text(name).casefold() for name in names if _i539_text(name)}
            for uid, names in uid_missions.items()
        }
        before = list(out.get('objects') or [])
        kept = []
        removed = []
        for row in before:
            if not isinstance(row, dict):
                continue
            uid = _i537_object_uid(row) if '_i537_object_uid' in globals() else _i539_text(row.get('uid')).casefold()
            source = _i539_text(row.get('source') or row.get('source_table')).casefold()
            point_like = _i537_point_like(row) if '_i537_point_like' in globals() else bool(row.get('lat') is not None and row.get('lon') is not None)
            active_missions = normalized_membership.get(uid, set()) if uid else set()
            explicit = _i539_text(row.get('mission_name') or row.get('mission')).casefold()
            orphaned_uid_row = bool(
                uid
                and point_like
                and ('mission_uids' in source or 'mission uid' in source or _i539_text(row.get('source_table')).casefold() == 'mission_uids')
                and not active_missions
                and not explicit
            )
            if orphaned_uid_row:
                if len(removed) < 100:
                    removed.append({
                        'uid': uid,
                        'name': _i539_text(row.get('callsign') or row.get('name') or row.get('title')),
                        'source': _i539_text(row.get('source') or row.get('source_table')),
                        'reason': 'UID is no longer associated with an active mission; retained OTS history row suppressed.',
                    })
                continue
            kept.append(row)
        out['objects'] = kept
        out['data_sync_deleted_orphan_filter_i539'] = {
            'version': 'i539',
            'mode': 'current-mission-membership-authoritative',
            'objects_before': len(before),
            'objects_after': len(kept),
            'removed_count': len(before) - len(kept),
            'removed_sample': removed,
            'delete_unavailable_rows_rendered': False,
        }
        if '_i537_walk_symbol_objects' in globals():
            _i537_walk_symbol_objects(out)
        if '_i537_update_mission_uid_cache' in globals():
            _i537_update_mission_uid_cache(out)
        return out

    _i539_data_sync_before = tak_map_data_sync
    def tak_map_data_sync():
        return _i539_filter_deleted_orphans(_i539_data_sync_before())
    globals()['tak_map_data_sync'] = tak_map_data_sync

    # Replace the legacy i512 augmentation. It performed two shared-credential
    # mission-list probes and then probed an invalid GET /contents path on every
    # refresh. Use one per-user certificate Marti list request, cache its result,
    # and keep PostgreSQL as the object transport/read path.
    if '_i512_augment_data_sync' in globals():
        def _i512_augment_data_sync(base, cfg, sess):
            out = dict(base or {})
            scope = _i539_user_mission_scope(cfg or {}, sess or {})
            allowed = scope.get('missions') if scope.get('ok') else None
            out = _i539_filter_deleted_orphans(out, allowed)
            out['mission_api_user_scope_i512'] = {
                'version': 'i539',
                'state': scope.get('state'),
                'mission_count': len(scope.get('missions') or []),
                'objects_added': 0,
                'identity': _i539_text((sess or {}).get('username') or ((sess or {}).get('profile') or {}).get('username')),
                'identity_mode': scope.get('identity_mode'),
                'certificate_cn': scope.get('certificate_cn'),
                'client_uid': scope.get('client_uid'),
                'cached': bool(scope.get('cached')),
                'probe_duration_ms': int(scope.get('duration_ms') or 0),
                'endpoints': [{
                    'endpoint': 'per-user-marti',
                    'path': '/Marti/api/missions',
                    'status': int(scope.get('status') or 0),
                    'ok': bool(scope.get('ok')),
                    'error': _i539_text(scope.get('error')),
                }],
                'database_object_read': True,
                'invalid_contents_get_removed': True,
                'shared_service_probe_removed': True,
                'scope_fallback': 'database-unscoped' if not scope.get('ok') else '',
            }
            return out
        globals()['_i512_augment_data_sync'] = _i512_augment_data_sync

    _i539_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i539_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(_i539_text(built.get('wire_xml') or built.get('xml')).strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None:
                    takv.set('version', '1.3.0-i539')
                meta = detail.find('takmap_user_presence')
                if meta is not None:
                    meta.set('version', 'i539')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i539'
        except Exception as exc:
            built['i539_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i539_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = _i539_presence_public_before(token, state)
        if isinstance(out, dict):
            out = dict(out)
            out['version'] = 'i539'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i539_config_before = tak_map_config
    def tak_map_config():
        cfg = _i539_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i539'
        cfg['version'] = '1.3.0-i539'
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version': 'i539',
            'deleted_uid_association_removal': True,
            'historical_mission_uid_rows_rendered': False,
            'per_user_marti_scope_probe': True,
            'shared_credential_scope_probe': False,
            'invalid_contents_get_probe': False,
            'scope_probe_cache_seconds': int(_I539_SCOPE_SUCCESS_SECONDS),
            'scope_failure_cooldown_seconds': int(_I539_SCOPE_FAILURE_SECONDS),
        })
        cfg['data_sync_control'] = control
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i539_patch_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i538', '1.3.0-i539').replace('TAKDashboard/i538', 'TAKDashboard/i539').replace('TAK-Map/1.3.0 i538', 'TAK-Map/1.3.0 i539')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i539\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i539\2', html)
        return html

    TAK_MAP_HTML = _i539_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i539_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i539'
except Exception as _i539_exc:
    try:
        print('TAK Map i539 Data Sync deletion reconciliation patch failed:', _i539_exc)
    except Exception:
        pass
# --- end TAK Map i539 Data Sync deletion reconciliation + non-blocking user scope ---

# --- TAK Map i540 non-blocking startup + role-backed Data Sync scope ---
try:
    _I540_SCOPE_INFLIGHT = set()
    _I540_SCOPE_INFLIGHT_LOCK = threading.RLock()

    def _i540_is_admin(sess):
        sess = sess or {}
        profile = dict(sess.get('profile') or {})
        return bool(
            sess.get('is_admin') or sess.get('admin') or
            profile.get('is_admin') or profile.get('admin')
        )

    def _i540_session_identities(sess):
        sess = sess or {}
        profile = dict(sess.get('profile') or {})
        usernames = {
            _i539_text(sess.get('username')).casefold(),
            _i539_text(profile.get('username')).casefold(),
        }
        client_uids = {
            _i539_text(sess.get('tak_uid')).casefold(),
            _i539_text(sess.get('client_uid')).casefold(),
            _i539_text(profile.get('tak_uid')).casefold(),
            _i539_text(profile.get('client_uid')).casefold(),
        }
        return ({x for x in usernames if x}, {x for x in client_uids if x})

    def _i540_direct_role_missions(base, sess):
        """Return missions explicitly assigned to this OTS username/client UID."""
        if not isinstance(base, dict):
            return []
        usernames, client_uids = _i540_session_identities(sess)
        mission_by_id, _ = _tak_mission_name_maps(base)
        names = []
        seen = set()
        for row in list(base.get('mission_roles') or []):
            if not isinstance(row, dict):
                continue
            row_user = _i539_text(_tak_row_value(row, (
                'username', 'user_name', 'userName', 'account_username', 'accountUsername'
            ), '')).casefold()
            row_uid = _i539_text(_tak_row_value(row, (
                'client_uid', 'clientUid', 'clientuid', 'tak_uid', 'takUid',
                'creator_uid', 'creatorUid'
            ), '')).casefold()
            matched = bool((row_user and row_user in usernames) or (row_uid and row_uid in client_uids))
            if not matched:
                continue
            mission = _i539_membership_mission(row, mission_by_id)
            key = mission.casefold()
            if mission and key not in seen:
                seen.add(key)
                names.append(mission)
        return names

    def _i540_cached_scope(cfg, sess):
        key = _i539_identity_key(sess, cfg)
        with _I539_SCOPE_LOCK:
            record = dict(_I539_SCOPE_CACHE.get(key) or {})
        if not record:
            return {'present': False, 'ok': False, 'missions': [], 'age_seconds': None, 'record': {}}
        age = max(0.0, time.time() - float(record.get('time') or 0.0))
        return {
            'present': True,
            'ok': bool(record.get('ok')),
            'missions': list(record.get('missions') or []) if record.get('ok') else [],
            'age_seconds': age,
            'record': record,
        }

    def _i540_schedule_scope_refresh(cfg, sess):
        """Refresh the per-user Marti scope in a daemon thread, never inline."""
        if not _i539_text((sess or {}).get('auth_mode')).startswith('ots-'):
            return {'scheduled': False, 'reason': 'not-applicable'}
        cached = _i540_cached_scope(cfg, sess)
        ttl = _I539_SCOPE_SUCCESS_SECONDS if cached.get('ok') else _I539_SCOPE_FAILURE_SECONDS
        if cached.get('present') and float(cached.get('age_seconds') or 0.0) <= ttl:
            return {'scheduled': False, 'reason': 'fresh-cache'}
        key = _i539_identity_key(sess, cfg)
        with _I540_SCOPE_INFLIGHT_LOCK:
            if key in _I540_SCOPE_INFLIGHT:
                return {'scheduled': False, 'reason': 'already-running'}
            _I540_SCOPE_INFLIGHT.add(key)

        session_token = _i539_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', '')) if '_I529_REQUEST_CONTEXT' in globals() else ''
        auth_mode = _i539_text(getattr(_I529_REQUEST_CONTEXT, 'auth_mode', '')) if '_I529_REQUEST_CONTEXT' in globals() else _i539_text((sess or {}).get('auth_mode'))

        def worker():
            try:
                if '_I529_REQUEST_CONTEXT' in globals():
                    _I529_REQUEST_CONTEXT.session_token = session_token
                    _I529_REQUEST_CONTEXT.auth_mode = auth_mode
                _i539_user_mission_scope(dict(cfg or {}), dict(sess or {}))
            except Exception:
                pass
            finally:
                try:
                    if '_I529_REQUEST_CONTEXT' in globals():
                        _I529_REQUEST_CONTEXT.session_token = ''
                        _I529_REQUEST_CONTEXT.auth_mode = ''
                except Exception:
                    pass
                with _I540_SCOPE_INFLIGHT_LOCK:
                    _I540_SCOPE_INFLIGHT.discard(key)

        thread = threading.Thread(target=worker, name='tak-map-i540-mission-scope', daemon=True)
        thread.start()
        return {'scheduled': True, 'reason': 'cache-missing-or-stale'}

    # Data Sync must return immediately from PostgreSQL. Direct mission roles are
    # available in that same response; the remote Marti mission-list request only
    # refreshes a cache in the background and is never awaited by this endpoint.
    def _i512_augment_data_sync(base, cfg, sess):
        out = dict(base or {})
        cfg = dict(cfg or {})
        sess = dict(sess or {})
        direct = _i540_direct_role_missions(out, sess)
        cached = _i540_cached_scope(cfg, sess)
        cached_names = list(cached.get('missions') or [])
        allowed = []
        seen = set()
        for name in direct + cached_names:
            text = _i539_text(name)
            key = text.casefold()
            if text and key not in seen:
                seen.add(key)
                allowed.append(text)

        admin = _i540_is_admin(sess)
        # A successful empty API result is authoritative only when there is no
        # direct role. It can never erase a mission proven by mission_roles.
        scope_authoritative = bool(admin or direct or cached.get('ok'))
        if admin:
            allowed = [
                _i539_text(_tak_row_value(row, ('name', 'mission_name', 'missionName', 'title'), ''))
                for row in list(out.get('missions') or []) if isinstance(row, dict)
            ]
            allowed = [name for name in allowed if name]
        out = _i539_filter_deleted_orphans(out, allowed if scope_authoritative else None)
        scheduled = _i540_schedule_scope_refresh(cfg, sess)
        record = cached.get('record') or {}
        out['mission_api_user_scope_i512'] = {
            'version': 'i540',
            'state': 'role-backed' if direct else ('cached' if cached.get('ok') else 'refreshing'),
            'mission_count': len(allowed),
            'objects_added': 0,
            'identity': _i539_text(sess.get('username') or (sess.get('profile') or {}).get('username')),
            'identity_mode': _i539_text(record.get('identity_mode') or 'per-user-enrolled-marti-certificate'),
            'certificate_cn': _i539_text(record.get('certificate_cn')),
            'client_uid': _i539_text(record.get('client_uid') or sess.get('tak_uid') or (sess.get('profile') or {}).get('tak_uid')),
            'cached': bool(cached.get('present')),
            'cached_scope_ok': bool(cached.get('ok')),
            'cached_scope_age_seconds': cached.get('age_seconds'),
            'probe_duration_ms': 0,
            'probe_blocked_request': False,
            'background_refresh_scheduled': bool(scheduled.get('scheduled')),
            'background_refresh_reason': scheduled.get('reason'),
            'direct_role_missions': direct,
            'cached_group_missions': cached_names,
            'effective_missions': allowed,
            'empty_api_preserves_direct_roles': True,
            'database_object_read': True,
            'invalid_contents_get_removed': True,
            'shared_service_probe_removed': True,
            'scope_fallback': '' if scope_authoritative else 'database-unscoped-until-scope-known',
            'endpoints': [{
                'endpoint': 'per-user-marti-background',
                'path': '/Marti/api/missions',
                'status': int(record.get('status') or 0),
                'ok': bool(record.get('ok')),
                'error': _i539_text(record.get('error')),
            }],
        }
        return out
    globals()['_i512_augment_data_sync'] = _i512_augment_data_sync

    _i540_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i540_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(_i539_text(built.get('wire_xml') or built.get('xml')).strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None:
                    takv.set('version', '1.3.0-i540')
                meta = detail.find('takmap_user_presence')
                if meta is not None:
                    meta.set('version', 'i540')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i540'
        except Exception as exc:
            built['i540_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i540_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = _i540_presence_public_before(token, state)
        if isinstance(out, dict):
            out = dict(out)
            out['version'] = 'i540'
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i540_config_before = tak_map_config
    def tak_map_config():
        cfg = _i540_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i540'
        cfg['version'] = '1.3.0-i540'
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version': 'i540',
            'startup_blocks_main_interface': False,
            'startup_background_refreshes': 1,
            'automatic_poll_seconds': 300,
            'browser_single_flight': True,
            'forced_followup_refreshes': 0,
