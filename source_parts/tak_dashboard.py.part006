                'http_status':status,'error':f'OpenTAKServer Mission subscription failed'+(f' (HTTP {status})' if status else '')+': '+_i555_text(token_result.get('error')),
                'version':'i564','mission_auth':'ATAK-style subscription token','user_agent_family':'ATAK'}
        query = 'creatorUid=' + quote(creator_uid, safe='') + '&' + target + '=' + quote(value, safe='')
        path = '/Marti/api/missions/' + quote(mission, safe='') + '/contents?' + query

        def run_delete(token):
