    def _i563_patch_html(html):
        if not isinstance(html, str): return html
        html = re.sub(r'1\.3\.0-i562','1.3.0-i563',html)
        html = re.sub(r'TAKDashboard/i562','TAKDashboard/i563',html)
        html = re.sub(r'TAK-Map/1\.3\.0 i562','TAK-Map/1.3.0 i563',html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i563\2',html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i563\2',html)
        html = re.sub(r'<script[^>]+(?:tak-map-icon-registry-i\d+\.js|tak-map-popup-localdata-i\d+\.js|tak-map-context-sidebar-i\d+\.js)[^>]*></script>\s*','',html,flags=re.I)
        if 'takMapStartupLoaderI541' not in html and '/assets/runtime/tak-map-startup-i553.js' not in html: return html
        scripts='\n'.join([
            '<script id="takMapIconRegistryI563" defer src="/assets/runtime/tak-map-icon-registry-i563.js?v=1.3.0-i563"></script>',
            '<script id="takMapPopupLocalDataI563" defer src="/assets/runtime/tak-map-popup-localdata-i563.js?v=1.3.0-i563"></script>',
            '<script id="takMapContextSidebarI563" defer src="/assets/runtime/tak-map-context-sidebar-i563.js?v=1.3.0-i563"></script>',
        ])
        return html.replace('</body>',scripts+'\n</body>',1) if '</body>' in html else html+scripts

