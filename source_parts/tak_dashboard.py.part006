# --- TAK Map i561 MIL-STD registry recovery and point source identity refinement ---
try:
    _I561_ROOT = Path(__file__).resolve().parent
    _I561_OTS_HOST_CACHE = {}
    _I561_OTS_HOST_CACHE_LOCK = threading.RLock()

    def _i561_safe_host(value):
        value = str(value or '').strip().rstrip('.')
        if not value or len(value) > 253:
            return ''
        if not re.fullmatch(r'[A-Za-z0-9._:-]+', value):
            return ''
        return value

    def _i561_ots_auth_headers(sess):
        sess = sess or {}
        headers = {'Accept':'application/json','User-Agent':'TAK-Map/i561 OTS Source Identity'}
        token = str(sess.get('ots_token') or '')
        if token:
            header = str(sess.get('ots_token_header') or 'Authorization')
            headers[header] = str(sess.get('ots_token_prefix') or '') + token
        cookies = str(sess.get('ots_cookies') or '')
        if cookies:
            headers['Cookie'] = cookies
        csrf = str(sess.get('ots_csrf_token') or '')
        if csrf:
            headers['X-XSRF-TOKEN'] = csrf
        return headers

    def _i561_remote_ots_hostname(cfg, sess):
        base = str(cfg.get('api_url') or cfg.get('base_url') or '').rstrip('/')
        if not base:
            return ''
        key = base.lower()
        now = time.time()
        with _I561_OTS_HOST_CACHE_LOCK:
            cached = dict(_I561_OTS_HOST_CACHE.get(key) or {})
        if float(cached.get('expires') or 0) > now:
            return _i561_safe_host(cached.get('hostname'))
        hostname = ''
        try:
            req = Request(base + '/api/status', headers=_i561_ots_auth_headers(sess), method='GET')
            with urlopen(req, timeout=5, context=_i509_ssl_context(cfg)) as response:
                body = response.read(262144).decode('utf-8', 'replace')
            payload = json.loads(body or '{}')
            uname = payload.get('uname') if isinstance(payload, dict) else {}
            if not isinstance(uname, dict):
                uname = {}
            hostname = _i561_safe_host(uname.get('node') or payload.get('hostname') or payload.get('server_name'))
        except Exception:
            hostname = ''
        if not hostname:
            configured = _i561_safe_host(urlparse(base).hostname)
            if configured in ('localhost','127.0.0.1','::1'):
                hostname = _i561_safe_host(socket.gethostname())
        with _I561_OTS_HOST_CACHE_LOCK:
            _I561_OTS_HOST_CACHE[key] = {'hostname':hostname, 'expires':now + (300 if hostname else 60)}
        return hostname

    def _i561_ots_source_identity(handler):
        cfg = _i509_load_ots_config()
        raw_base = str(cfg.get('base_url') or cfg.get('api_url') or '')
        url_hostname = _i561_safe_host(urlparse(raw_base).hostname if raw_base else cfg.get('cot_host'))
        server_hostname = _i561_remote_ots_hostname(cfg, handler._tak_map_session()) if url_hostname else ''
        display = 'Data Sync: OpenTAKServer'
        if url_hostname:
            display += ' · ' + url_hostname
            if server_hostname:
                display += '/' + server_hostname
        return {
            'ok': True,
            'version': 'i561',
            'source': 'Data Sync',
            'provider': 'OpenTAKServer',
            'url_hostname': url_hostname,
            'server_hostname': server_hostname,
            'display': display,
        }

    _i561_get_before = Handler.do_GET
    def _i561_do_get(self):
        parsed = urlparse(self.path)
        assets = {
            '/assets/runtime/tak-map-icon-registry-i561.js': ('tak-map-icon-registry-i561.js', 'i561-icon-registry'),
            '/assets/runtime/tak-map-popup-localdata-i561.js': ('tak-map-popup-localdata-i561.js', 'i561-localdata'),
            '/assets/runtime/tak-map-context-sidebar-i561.js': ('tak-map-context-sidebar-i561.js', 'i561-context-sidebar'),
        }
        item = assets.get(parsed.path)
        if item:
            return _i541_send_file(self, _I561_ROOT / 'assets' / item[0], 'application/javascript; charset=utf-8', item[1])
        if parsed.path == '/api/tak-map/ots/source-identity':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            return self._send_json(_i561_ots_source_identity(self))
        return _i561_get_before(self)
    Handler.do_GET = _i561_do_get

    _i561_config_before = tak_map_config
    def tak_map_config():
        cfg = _i561_config_before()
        if not isinstance(cfg, dict):
            cfg = {}
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i561'
        cfg['version'] = '1.3.0-i561'
        registry = dict(cfg.get('icon_registry') or {})
        registry.update({
            'version': 'i561',
            'milstd2525c_catalog_records': 1448,
            'milstd2525c_catalog_deduplicated_loader': True,
            'milstd2525c_retry_ui': True,
            'retired_picker_interception_disabled': True,
            'point_info_uid_row': False,
            'point_info_source_ots_identity': True,
            'point_info_source_format': 'Data Sync: OpenTAKServer · url-hostname/server-hostname',
        })
        cfg['icon_registry'] = registry
        startup = dict(cfg.get('startup_architecture_i560') or cfg.get('startup_architecture_i557') or {})
        startup.update({
            'package_version': 'i561',
            'i553_shell_first_runtime_preserved': True,
            'icon_registry_runtime': '/assets/runtime/tak-map-icon-registry-i561.js',
            'popup_localdata_runtime': '/assets/runtime/tak-map-popup-localdata-i561.js',
            'context_sidebar_runtime': '/assets/runtime/tak-map-context-sidebar-i561.js',
            'failed_i558_popup_controller_excluded': True,
        })
        cfg['startup_architecture_i561'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i561_patch_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i560', '1.3.0-i561', html)
        html = re.sub(r'TAKDashboard/i560', 'TAKDashboard/i561', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i560', 'TAK-Map/1.3.0 i561', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i561\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i561\2', html)
        html = re.sub(r'<script[^>]*id=["\']takMapIconRegistryI56[01]["\'][^>]*></script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapPopupLocalDataI56[01]["\'][^>]*></script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapContextSidebarI56[01]["\'][^>]*></script>\s*', '', html, flags=re.I)
        if '/assets/runtime/tak-map-startup-i553.js' not in html:
            return html
        scripts = '\n'.join([
            '<script id="takMapIconRegistryI561" defer src="/assets/runtime/tak-map-icon-registry-i561.js?v=1.3.0-i561"></script>',
            '<script id="takMapPopupLocalDataI561" defer src="/assets/runtime/tak-map-popup-localdata-i561.js?v=1.3.0-i561"></script>',
            '<script id="takMapContextSidebarI561" defer src="/assets/runtime/tak-map-context-sidebar-i561.js?v=1.3.0-i561"></script>',
        ])
        return html.replace('</body>', scripts + '\n</body>', 1) if '</body>' in html else html + scripts

