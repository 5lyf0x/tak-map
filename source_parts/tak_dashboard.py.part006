        cfg = _i547_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i547'
        cfg['version'] = '1.3.0-i547'
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version': 'i547',
            'automatic_poll_seconds': 10,
            'mission_cot_primary_query_without_creator_uid': True,
            'mission_cot_creator_uid_fallback_only': True,
            'mission_cot_database_timestamp_gate_disabled': True,
            'forced_refresh_invalidates_and_refetches_mission_cot': True,
            'same_uid_name_updates': True,
            'same_uid_icon_updates': True,
            'current_mission_cot_mutable_fields_authoritative': True,
            'delete_lookup_uses_visible_canonical_pipeline': True,
            'delete_cache_invalidation_includes_mission_cot': True,
        })
        cfg['data_sync_control'] = control
        startup = dict(cfg.get('startup_architecture_i546') or cfg.get('startup_architecture_i545') or {})
        startup.update({
            'version': 'i547',
            'startup_diagnostics_global': 'TakMapStartupDiagnosticsI547',
            'shell_ready_event': 'takmap:shell-ready-i547',
            'runtime_ready_event': 'takmap:runtime-ready-i547',
            'data_sync_poll_seconds': 10,
            'mission_cot_enrichment_blocks_shell': False,
            'forced_data_sync_refresh_may_block_for_current_mission_cot': True,
        })
        cfg['startup_architecture_i547'] = startup
        mil = dict(cfg.get('milstd2525c') or {})
        mil.update({
            'version': 'i547',
            'same_uid_icon_replacement': True,
            'stale_usericon_path_cleared_when_current_event_uses_standard_type': True,
        })
        cfg['milstd2525c'] = mil
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i547_patch_main_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i546', '1.3.0-i547').replace('TAKDashboard/i546', 'TAKDashboard/i547').replace('TAK-Map/1.3.0 i546', 'TAK-Map/1.3.0 i547')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i547\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i547\2', html)
        html = html.replace('/assets/runtime/tak-map-startup-i546.js?v=1.3.0-i547', '/assets/runtime/tak-map-startup-i547.js?v=1.3.0-i547')
        html = html.replace('/assets/runtime/tak-map-startup-i546.js?v=1.3.0-i546', '/assets/runtime/tak-map-startup-i547.js?v=1.3.0-i547')
        return html

    TAK_MAP_HTML = _i547_patch_main_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i547_patch_main_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i547'
except Exception as _i547_exc:
    try:
        print('TAK Map i547 live Mission CoT refresh/deletion patch failed:', _i547_exc)
    except Exception:
        pass
# --- end TAK Map i547 live Mission CoT refresh + canonical Data Sync deletion ---

# --- TAK Map i549 authoritative ATAK usericon refresh ---
try:
    _I549_ROOT = Path(__file__).resolve().parent
    _I549_RUNTIME_FILES = {
        '/assets/runtime/tak-map-core-i549.js': (_I549_ROOT / 'assets' / 'tak-map-core-i549.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-data-sync-i549.js': (_I549_ROOT / 'assets' / 'tak-map-data-sync-i549.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-startup-i549.js': (_I549_ROOT / 'assets' / 'tak-map-startup-i549.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-deferred-i549.json': (_I549_ROOT / 'assets' / 'tak-map-deferred-i549.json', 'application/json; charset=utf-8'),
        '/assets/runtime/tak-map-milstd2525c-i549.js': (_I549_ROOT / 'assets' / 'tak-map-milstd2525c-i549.js', 'application/javascript; charset=utf-8'),
    }

    def _i549_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i549_raw_xml_symbol(element):
        out = {'sidc': '', 'iconset_path': '', 'cot_type': ''}
        if element is None:
            return out
        try:
            if _i545_local_name(element.tag) == 'event':
                out['cot_type'] = _i549_text((element.attrib or {}).get('type'))
            for node in element.iter():
                name = _i545_local_name(node.tag)
                attrs = {str(k).rsplit('}', 1)[-1].replace('-', '').replace('_', '').lower(): _i549_text(v) for k, v in (node.attrib or {}).items()}
                if name == 'usericon' and not out['iconset_path']:
                    out['iconset_path'] = attrs.get('iconsetpath') or attrs.get('path') or ''
                for key, value in attrs.items():
                    if not value:
                        continue
                    if key in ('sidc', 'symbolid', 'mil2525sidc', 'milstd2525sidc') and not out['sidc']:
                        out['sidc'] = value
                    elif key in ('iconsetpath', 'usericonpath') and not out['iconset_path']:
                        out['iconset_path'] = value
                node_text = _i549_text(node.text)
                if node_text and name in ('sidc', 'symbolid', 'mil2525sidc', 'milstd2525sidc') and not out['sidc']:
                    out['sidc'] = node_text
        except Exception:
            pass
        return out

    def _i549_raw_json_symbol(value):
        out = {'sidc': '', 'iconset_path': '', 'cot_type': ''}
        if not isinstance(value, dict):
            return out
        out['cot_type'] = _i549_text(value.get('cot_type') or value.get('atak_cot_type') or value.get('event_type') or value.get('type'))
        stack = [value]
        seen = set()
        scanned = 0
        while stack and scanned < 3000:
            current = stack.pop()
            scanned += 1
            if isinstance(current, dict):
                ident = id(current)
                if ident in seen:
                    continue
                seen.add(ident)
                for key, raw in current.items():
                    folded = str(key).replace('-', '').replace('_', '').replace('@', '').lower()
                    text_value = _i549_text(raw) if not isinstance(raw, (dict, list, tuple)) else ''
                    if text_value:
                        if folded in ('sidc', 'symbolid', 'mil2525sidc', 'milstd2525sidc') and not out['sidc']:
                            out['sidc'] = text_value
                        elif folded in ('iconsetpath', 'usericonpath') and not out['iconset_path']:
                            out['iconset_path'] = text_value
                    if isinstance(raw, (dict, list, tuple)):
                        stack.append(raw)
            elif isinstance(current, (list, tuple)):
                stack.extend(current)
        return out

    def _i549_attach_raw_symbol(event, raw):
        if not isinstance(event, dict):
            return event
        raw = raw if isinstance(raw, dict) else {}
        sidc = _i549_text(raw.get('sidc'))
        iconset = _i549_text(raw.get('iconset_path'))
        cot_type = _i549_text(raw.get('cot_type'))
        if sidc:
            event['mission_cot_raw_sidc_i549'] = sidc
        if iconset:
            event['mission_cot_raw_iconset_path_i549'] = iconset
        if cot_type:
            event['mission_cot_raw_type_i549'] = cot_type
        event['mission_cot_icon_authority_i549'] = 'explicit-sidc' if sidc else ('usericon-iconsetpath' if iconset else ('event-type' if cot_type else 'none'))
        return event

    _i549_event_element_before = _i545_event_from_element
    def _i545_event_from_element(element):
        raw = _i549_raw_xml_symbol(element)
        return _i549_attach_raw_symbol(_i549_event_element_before(element), raw)
    globals()['_i545_event_from_element'] = _i545_event_from_element

    _i549_json_event_before = _i545_json_event
    def _i545_json_event(value):
        raw = _i549_raw_json_symbol(value)
        return _i549_attach_raw_symbol(_i549_json_event_before(value), raw)
    globals()['_i545_json_event'] = _i545_json_event

    def _i549_current_symbol_values(event):
        event = event if isinstance(event, dict) else {}
        raw_sidc = _i549_text(event.get('mission_cot_raw_sidc_i549'))
        raw_iconset = _i549_text(event.get('mission_cot_raw_iconset_path_i549'))
        raw_type = _i549_text(event.get('mission_cot_raw_type_i549'))
        # A derived SIDC generated from a generic event type must never outrank
        # the current ATAK usericon path. Only an explicitly supplied raw SIDC does.
        return {
            'sidc': raw_sidc or ('' if raw_iconset else _i549_text(event.get('sidc') or event.get('SIDC'))),
            'iconset_path': raw_iconset or _i549_text(event.get('iconsetPath') or event.get('iconsetpath') or event.get('iconset_path') or event.get('usericon_path')),
            'cot_type': raw_type or _i549_text(event.get('cot_type') or event.get('atak_cot_type') or event.get('event_type') or event.get('type')),
            'authority': _i549_text(event.get('mission_cot_icon_authority_i549')),
        }

    # i547 helpers look this name up dynamically, so replace it with raw-current
    # event precedence before wrapping the final merge.
    globals()['_i547_event_symbol_values'] = _i549_current_symbol_values

    _I549_DERIVED_SYMBOL_KEYS = (
        'sidc', 'SIDC', 'mil2525_name', 'milstd2525_name', 'mil2525_file',
        'mil2525_svg', 'mil2525_label', 'symbol_resolution_i537',
        'symbol_resolution_i538', 'symbol_resolution_i547', 'symbol_resolution_i549',
    )

    def _i549_clear_derived_symbol(obj):
        if not isinstance(obj, dict):
            return obj
        for key in _I549_DERIVED_SYMBOL_KEYS:
            obj.pop(key, None)
        props = obj.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            for key in _I549_DERIVED_SYMBOL_KEYS:
                props.pop(key, None)
            obj['properties'] = props
        return obj

    def _i549_apply_resolved_symbol(obj, result):
        if not isinstance(obj, dict) or not isinstance(result, dict) or not result.get('ok'):
            return obj
        sidc = _i549_text(result.get('sidc'))
        name = _i549_text(result.get('name'))
        file_name = _i549_text(result.get('file')) or (name + '.svg' if name else '')
        label = _i549_text(result.get('label'))
        if sidc:
            obj['sidc'] = sidc; obj['SIDC'] = sidc
        if name:
            obj['mil2525_name'] = name
        if file_name:
            obj['mil2525_file'] = file_name
        if label:
            obj['mil2525_label'] = label
        resolution = {
            'version': 'i549',
            'source': _i549_text(result.get('source')),
            'input_sidc': _i549_text(result.get('input_sidc')),
            'catalog_sidc': _i549_text(result.get('catalog_sidc') or result.get('sidc')),
            'current_event_usericon_precedence': True,
        }
        obj['symbol_resolution_i549'] = resolution
        props = obj.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            if sidc:
                props['sidc'] = sidc; props['SIDC'] = sidc
            if name:
                props['mil2525_name'] = name
            if file_name:
                props['mil2525_file'] = file_name
            if label:
                props['mil2525_label'] = label
            props['symbol_resolution_i549'] = dict(resolution)
            obj['properties'] = props
        return obj

    def _i549_apply_current_usericon(obj, event):
        if not isinstance(obj, dict):
            return obj
        values = _i549_current_symbol_values(event)
        raw_sidc = _i549_text(values.get('sidc'))
        raw_iconset = _i549_text(values.get('iconset_path'))
        raw_type = _i549_text(values.get('cot_type'))
        if not (raw_sidc or raw_iconset or raw_type):
            return obj

        _i549_clear_derived_symbol(obj)
        source = {}
        if raw_sidc:
            source['sidc'] = raw_sidc
        if raw_iconset:
            source['iconsetPath'] = raw_iconset
        if raw_type:
            source['cot_type'] = raw_type
            source['type'] = raw_type

        result = _i537_resolve_symbol(source) if '_i537_resolve_symbol' in globals() else None
        if isinstance(result, dict) and result.get('ok'):
            _i549_apply_resolved_symbol(obj, result)

        # Preserve the current raw icon identity even when TAK Map does not have
        # the custom icon package. The i549 browser renderer then uses a distinct,
        # deterministic user-icon badge rather than retaining the old symbol.
        if raw_sidc:
            obj['mission_cot_raw_sidc_i549'] = raw_sidc
            obj['data_sync_current_sidc_i549'] = raw_sidc
        if raw_iconset:
            obj['mission_cot_raw_iconset_path_i549'] = raw_iconset
            obj['data_sync_current_iconset_path_i549'] = raw_iconset
            obj['current_iconset_path_i549'] = raw_iconset
            obj['iconsetPath'] = raw_iconset
            obj['iconsetpath'] = raw_iconset
            obj['usericon_path'] = raw_iconset
        if raw_type:
            obj['mission_cot_raw_type_i549'] = raw_type
            for key in ('type', 'cot_type', 'atak_cot_type', 'event_type'):
                obj[key] = raw_type

        props = obj.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            if raw_sidc:
                props['mission_cot_raw_sidc_i549'] = raw_sidc
                props['data_sync_current_sidc_i549'] = raw_sidc
            if raw_iconset:
                props['mission_cot_raw_iconset_path_i549'] = raw_iconset
                props['data_sync_current_iconset_path_i549'] = raw_iconset
                props['current_iconset_path_i549'] = raw_iconset
                props['iconsetPath'] = raw_iconset
                props['iconsetpath'] = raw_iconset
                props['usericon_path'] = raw_iconset
            if raw_type:
                props['mission_cot_raw_type_i549'] = raw_type
                for key in ('type', 'cot_type', 'atak_cot_type', 'event_type'):
                    props[key] = raw_type
            obj['properties'] = props

        obj['data_sync_icon_authority_i549'] = {
            'version': 'i549',
            'authority': 'explicit-sidc' if raw_sidc else ('usericon-iconsetpath' if raw_iconset else 'event-type'),
            'raw_sidc': raw_sidc,
            'raw_iconset_path': raw_iconset,
            'raw_cot_type': raw_type,
            'resolved_file': _i549_text(obj.get('mil2525_file')),
            'custom_usericon_fallback': bool(raw_iconset and not obj.get('mil2525_file')),
            'stale_derived_sidc_blocked': bool(raw_iconset and not raw_sidc),
        }
        return obj

    _i549_merge_before = _i545_merge_event
    def _i545_merge_event(row, event):
        before = _i545_symbol_fingerprint(row) if isinstance(row, dict) else ''
        merged, applied, reason = _i549_merge_before(row, event)
        if applied:
            merged = _i549_apply_current_usericon(dict(merged), event)
            after = _i545_symbol_fingerprint(merged)
            merged['data_sync_symbol_fingerprint_i549'] = after
            merged['data_sync_symbol_changed_i549'] = bool(before and after and before != after)
            live = dict(merged.get('data_sync_live_event_i547') or {})
            live.update({
                'version': 'i549',
                'raw_sidc': _i549_text(event.get('mission_cot_raw_sidc_i549')) if isinstance(event, dict) else '',
                'raw_iconset_path': _i549_text(event.get('mission_cot_raw_iconset_path_i549')) if isinstance(event, dict) else '',
                'raw_cot_type': _i549_text(event.get('mission_cot_raw_type_i549')) if isinstance(event, dict) else '',
                'current_usericon_precedence': True,
            })
            merged['data_sync_live_event_i549'] = live
            return _i546_normalize_row_identity(merged), True, 'merged-current-mission-cot-usericon-i549'
        return merged, applied, reason
    globals()['_i545_merge_event'] = _i545_merge_event

    _i549_get_before = Handler.do_GET
    def _i549_do_get(self):
        parsed = urlparse(self.path)
        runtime = _I549_RUNTIME_FILES.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i549-authoritative-atak-usericon')
        return _i549_get_before(self)
    Handler.do_GET = _i549_do_get

    _i549_config_before = tak_map_config
    def tak_map_config():
        cfg = _i549_config_before()
        if not isinstance(cfg, dict):
