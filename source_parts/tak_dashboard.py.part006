            'catalog_icons': len(_I537_MIL_ICONS) if '_I537_MIL_ICONS' in globals() else 0,
            'catalog_expansion_pending': False,
            'mission_cot_usericon_supported': True,
            'friendly_armored_vehicle_resolution': 'friendly-ground-equipment-armored-vehicle.svg',
        })
