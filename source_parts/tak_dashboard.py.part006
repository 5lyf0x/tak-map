                props['data_sync_current_iconset_path_i552'] = raw_iconset
                props['current_iconset_path_i552'] = raw_iconset
                for key in ('iconsetPath', 'iconsetpath', 'usericon_path'):
                    props[key] = raw_iconset
            props['data_sync_symbol_decision_i552'] = dict(decision)
