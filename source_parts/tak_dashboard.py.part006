    )

    def _i552_clear_derived_symbol(obj):
        if not isinstance(obj, dict):
            return obj
        for key in _I552_DERIVED_SYMBOL_KEYS:
            obj.pop(key, None)
        props = obj.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            for key in _I552_DERIVED_SYMBOL_KEYS:
                props.pop(key, None)
            obj['properties'] = props
        return obj

    def _i552_previous_decision(row):
        for source in _i552_row_sources(row):
            for key in ('data_sync_symbol_decision_i552', 'data_sync_symbol_decision_i551', 'data_sync_symbol_decision_i550'):
                value = source.get(key)
                if isinstance(value, dict):
                    return dict(value)
        return {}

    def _i552_normalize_visible_row(row):
        if not isinstance(row, dict):
            return row
        current = _i552_current_symbol_values(row)
        if not any(_i552_text(current.get(key)) for key in ('sidc', 'cot_type', 'iconset_path')):
            return row

        previous_decision = _i552_previous_decision(row)
        before_fingerprint = _i545_symbol_fingerprint(row) if '_i545_symbol_fingerprint' in globals() else ''
        # A genuine i551 decision was produced with the systematic alias
        # catalog already active. Preserve its change diagnostics while
        # re-resolving the selected identity through the current catalog. Older
        # i550 decisions are intentionally recomputed from the persisted raw CoT.
        if _i552_text(previous_decision.get('version')) == 'i551':
            decision = dict(previous_decision)
            authority = _i552_text(decision.get('authority'))
            if authority == 'explicit-sidc':
                selected = _i550_resolve_sidc(current.get('sidc'))
            elif authority == 'event-type':
                selected = _i550_resolve_type(decision.get('selected_cot_type') or current.get('cot_type'))
            elif authority == 'usericon-iconsetpath':
                selected = _i550_resolve_iconset(decision.get('selected_iconset_path') or current.get('iconset_path'))
            else:
                selected = None
        else:
            # For an upgrade-time recalculation the current persisted event is
            # both the prior and current input. This removes assumptions made by
            # an older resolver while preserving the current raw CoT data.
            decision, selected = _i550_choose_symbol(dict(current), dict(current))
            decision = dict(decision or {})
        if isinstance(selected, dict):
