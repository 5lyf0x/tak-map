        cfg['symbol_resolution_i572'] = {
            'version': 'i572', 'authoritative_registered_usericon_precedes_generic_cot_frame': True,
            'map_sidebar_editor_shared_resolver': True,
        }
        cfg['context_sidebar_i572'] = {'version': 'i572', 'z_index': 4700, 'above_map_toolbar': True, 'below_modals': True}
        startup = dict(cfg.get('startup_architecture_i571') or {})
        startup.update({
            'package_version': 'i572',
            'icon_registry_runtime': '/assets/runtime/tak-map-icon-registry-i572.js',
            'popup_localdata_runtime': '/assets/runtime/tak-map-popup-localdata-i572.js',
            'context_sidebar_runtime': '/assets/runtime/tak-map-context-sidebar-i572.js',
            'mission_unlock_runtime': '/assets/runtime/tak-map-data-sync-unlock-i572.js',
        })
        cfg['startup_architecture_i572'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i572_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i572', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i572', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i572', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i572\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i572\2', html)
        html = re.sub(r'<script[^>]+(?:tak-map-icon-registry-i\d+\.js|tak-map-popup-localdata-i\d+\.js|tak-map-context-sidebar-i\d+\.js|tak-map-data-sync-unlock-i\d+\.js)[^>]*></script>\s*', '', html, flags=re.I)
        scripts = '\n'.join([
            '<script id="takMapMissionUnlockI572" defer src="/assets/runtime/tak-map-data-sync-unlock-i572.js?v=1.3.0-i572"></script>',
            '<script id="takMapIconRegistryI572" defer src="/assets/runtime/tak-map-icon-registry-i572.js?v=1.3.0-i572"></script>',
            '<script id="takMapPopupLocalDataI572" defer src="/assets/runtime/tak-map-popup-localdata-i572.js?v=1.3.0-i572"></script>',
            '<script id="takMapContextSidebarI572" defer src="/assets/runtime/tak-map-context-sidebar-i572.js?v=1.3.0-i572"></script>',
        ])
        return html.replace('</body>', scripts + '\n</body>', 1) if '</body>' in html else html + scripts

    TAK_MAP_HTML = _i572_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i572_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i572'
except Exception as _i572_exc:
    try: print('TAK Map i572 protected Mission/custom icon/sidebar patch failed:', _i572_exc)
    except Exception: pass
# --- end TAK Map i572 protected Mission unlock and rendering correction ---



# --- TAK Map i573 explicit protected-Mission credential management ---
try:
    _I573_ROOT = Path(__file__).resolve().parent

    def _i573_public_status(mission):
        out = dict(_i572_public_status(mission) or {})
        protected = bool(out.get('protected'))
        unlocked = bool((not protected) or out.get('unlocked'))
        out.update({
            'ok': True,
            'version': 'i573',
            'mission': _i568_text(mission),
            'protected': protected,
            'password_protected': protected,
            'unlocked': unlocked,
            'locked': bool(protected and not unlocked),
            'credential_configured': bool(out.get('password_stored_server_side')),
            'management_mode': 'explicit-mission-row-edit-i573',
        })
        return out

    def _i573_access_action(payload):
        payload = dict(payload or {}) if isinstance(payload, dict) else {}
        action = _i568_text(payload.get('action') or 'unlock').lower()
        if action in ('clear', 'remove', 'delete'):
            payload['action'] = 'lock'
        reply, status = _i572_unlock_action(payload)
        reply = dict(reply or {}) if isinstance(reply, dict) else {'ok': False, 'error': 'Mission credential action failed.'}
        mission = _i568_text(payload.get('mission') or payload.get('mission_name'))
        if bool(reply.get('ok')):
            reply = _i573_public_status(mission)
            reply['message'] = 'Mission password saved securely.' if payload.get('action') != 'lock' else 'Stored Mission password cleared.'
        else:
            reply['version'] = 'i573'
            reply['mission'] = mission
            reply['management_mode'] = 'explicit-mission-row-edit-i573'
        return reply, status

    _i573_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i573_response_before(state)
        if not isinstance(payload, dict):
            return payload
        payload = _i568_clone(payload)
        access = []
        seen = set()
        for row in list(payload.get('missions') or []):
            if isinstance(row, str):
                mission = _i568_text(row)
            elif isinstance(row, dict):
                mission = _i568_text(row.get('name') or row.get('mission_name') or row.get('missionName') or row.get('uid'))
            else:
                mission = ''
            folded = mission.casefold()
            if not mission or folded in seen:
                continue
            seen.add(folded)
            access.append(_i573_public_status(mission))
        payload['version'] = 'i573'
        payload['mission_access_i573'] = access
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i573_save_before = _i555_save_point
    def _i555_save_point(payload):
        reply, status = _i573_save_before(payload)
        if isinstance(reply, dict):
            reply = dict(reply)
            reply['version'] = 'i573'
            if not reply.get('ok') and reply.get('mission_password_required'):
                mission = _i568_text(reply.get('mission') or (payload or {}).get('mission_name') or (payload or {}).get('mission'))
                reply['error'] = ('Mission is locked. Use Edit beside ' + mission +
                                  ' in the Data Sync Missions row to enter its password before saving.')
