            'startup_diagnostics_global': 'TakMapStartupDiagnosticsI546',
            'shell_ready_event': 'takmap:shell-ready-i546',
            'runtime_ready_event': 'takmap:runtime-ready-i546',
            'data_sync_poll_seconds': 10,
            'mission_cot_enrichment_blocks_shell': False,
        })
        cfg['startup_architecture_i546'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i546_patch_main_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i545','1.3.0-i546').replace('TAKDashboard/i545','TAKDashboard/i546').replace('TAK-Map/1.3.0 i545','TAK-Map/1.3.0 i546')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i546\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i546\2', html)
        html = html.replace('/assets/runtime/tak-map-startup-i545.js?v=1.3.0-i546','/assets/runtime/tak-map-startup-i546.js?v=1.3.0-i546')
        html = html.replace('/assets/runtime/tak-map-startup-i545.js?v=1.3.0-i545','/assets/runtime/tak-map-startup-i546.js?v=1.3.0-i546')
        return html

    TAK_MAP_HTML = _i546_patch_main_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i546_patch_main_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i546'
except Exception as _i546_exc:
    try:
        print('TAK Map i546 canonical Mission CoT identity patch failed:', _i546_exc)
    except Exception:
        pass
# --- end TAK Map i546 canonical Mission CoT identity, callsign, and symbol enrichment ---

# --- TAK Map i547 live Mission CoT refresh + canonical Data Sync deletion ---
try:
    _I547_ROOT = Path(__file__).resolve().parent
    _I547_RUNTIME_FILES = {
        '/assets/runtime/tak-map-core-i547.js': (_I547_ROOT / 'assets' / 'tak-map-core-i547.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-data-sync-i547.js': (_I547_ROOT / 'assets' / 'tak-map-data-sync-i547.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-startup-i547.js': (_I547_ROOT / 'assets' / 'tak-map-startup-i547.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-deferred-i547.json': (_I547_ROOT / 'assets' / 'tak-map-deferred-i547.json', 'application/json; charset=utf-8'),
        '/assets/runtime/tak-map-milstd2525c-i547.js': (_I547_ROOT / 'assets' / 'tak-map-milstd2525c-i547.js', 'application/javascript; charset=utf-8'),
    }
    _I547_REQUEST_CONTEXT = threading.local()
    _I547_REFRESH_LOCK = threading.RLock()

    def _i547_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i547_result_status(result):
        if not isinstance(result, dict):
            return 0
        try:
            direct = int(result.get('status') or 0)
            if direct:
                return direct
        except Exception:
            pass
        attempts = list(result.get('attempts') or [])
        for attempt in reversed(attempts):
            try:
                status = int((attempt or {}).get('status') or 0)
                if status:
                    return status
            except Exception:
                continue
        return 0

    def _i547_request_force():
        return bool(getattr(_I547_REQUEST_CONTEXT, 'force', False))

    def _i547_request_reason():
        return _i547_text(getattr(_I547_REQUEST_CONTEXT, 'reason', '')) or 'unspecified'

    _i547_get_before = Handler.do_GET
    def _i547_do_get(self):
        parsed = urlparse(self.path)
        runtime = _I547_RUNTIME_FILES.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i547-live-mission-cot-refresh')
        if parsed.path == '/api/tak-map/data-sync':
            query = parse_qs(parsed.query or '')
            force = _i547_text((query.get('force') or ['0'])[0]).casefold() in ('1', 'true', 'yes', 'on')
            reason = _i547_text((query.get('reason') or [''])[0])
            _I547_REQUEST_CONTEXT.force = force
            _I547_REQUEST_CONTEXT.reason = reason
            try:
                return _i547_get_before(self)
            finally:
                _I547_REQUEST_CONTEXT.force = False
                _I547_REQUEST_CONTEXT.reason = ''
        return _i547_get_before(self)
    Handler.do_GET = _i547_do_get

    # The authenticated per-user client certificate already scopes Mission API
    # access. Do not filter GET /cot by the TAK Map web identity UID because ATAK
    # may have created or edited the object with a different EUD UID. A creatorUid
    # query is retained only as a compatibility fallback when the unfiltered
    # endpoint is rejected by an older or customized server.
    def _i545_fetch_mission_events(mission):
        mission_name = _i547_text(mission)
        mission_q = quote(mission_name, safe='')
        base_path = '/Marti/api/missions/' + mission_q + '/cot'
        attempts = []

        primary = _ots_mission_api_request(base_path, method='GET', timeout=8)
        attempts.append({
            'strategy': 'authenticated-user-scope-no-creatorUid',
            'path': base_path,
            'ok': bool(isinstance(primary, dict) and primary.get('ok')),
            'status': _i547_result_status(primary),
            'error': _i547_text((primary or {}).get('error')) if isinstance(primary, dict) else 'request-failed',
        })
        selected = primary
        selected_path = base_path
        strategy = 'authenticated-user-scope-no-creatorUid'
        fallback_used = False

        if not (isinstance(primary, dict) and primary.get('ok')):
            credential = _i529_current_user_credential() if '_i529_current_user_credential' in globals() else {}
            creator_uid = _i547_text((credential or {}).get('client_uid'))
            if creator_uid:
                fallback_path = base_path + '?creatorUid=' + quote(creator_uid, safe='')
                fallback = _ots_mission_api_request(fallback_path, method='GET', timeout=8)
                attempts.append({
                    'strategy': 'compatibility-creatorUid-fallback',
                    'path': fallback_path,
                    'ok': bool(isinstance(fallback, dict) and fallback.get('ok')),
                    'status': _i547_result_status(fallback),
                    'error': _i547_text((fallback or {}).get('error')) if isinstance(fallback, dict) else 'request-failed',
                })
                if isinstance(fallback, dict) and fallback.get('ok'):
                    selected = fallback
                    selected_path = fallback_path
                    strategy = 'compatibility-creatorUid-fallback'
                    fallback_used = True

        events = _i545_extract_events(
            selected.get('json') if isinstance(selected, dict) else None,
            selected.get('body') if isinstance(selected, dict) else '',
        )
        return {
            'mission': mission_name,
            'path': selected_path,
            'ok': bool(isinstance(selected, dict) and selected.get('ok')),
            'status': _i547_result_status(selected),
            'error': _i547_text((selected or {}).get('error')) if isinstance(selected, dict) else 'request-failed',
            'events': events,
            'event_count': len(events),
            'query_strategy': strategy,
            'creator_uid_filter_primary': False,
            'creator_uid_fallback_used': fallback_used,
            'request_attempts_i547': attempts,
        }
    globals()['_i545_fetch_mission_events'] = _i545_fetch_mission_events

    _I547_ROW_TIME_KEYS = (
        'updated', 'timestamp', 'time', 'start', 'event_time', 'eventTime',
        'created_at', 'submission_time', 'added', 'uploaded',
    )
    _I547_XML_KEYS = (
        'xml', 'cot_xml', 'event_xml', 'raw_xml', 'mission_cot_xml', 'cot',
    )
    _I547_SYMBOL_KEYS = (
        'sidc', 'SIDC', 'symbol_id', 'symbolId', 'mil2525_sidc', 'milstd2525_sidc',
        'mil2525_name', 'milstd2525_name', 'mil2525_file', 'mil2525_svg',
        'mil2525_label', 'symbol_resolution_i537',
        'iconsetPath', 'iconsetpath', 'iconset_path', '@iconsetpath', '@iconsetPath',
        'usericon_path', 'user_icon_path', 'icon_path', 'iconPath',
        'cot_type', 'atak_cot_type', 'event_type', 'eventType', 'type',
    )

    def _i547_event_symbol_values(event):
        event = event if isinstance(event, dict) else {}
        return {
            'sidc': _i547_text(event.get('sidc') or event.get('SIDC')),
            'cot_type': _i547_text(event.get('cot_type') or event.get('atak_cot_type') or event.get('event_type') or event.get('type')),
            'iconset_path': _i547_text(event.get('iconsetPath') or event.get('iconsetpath') or event.get('iconset_path') or event.get('usericon_path')),
        }

    def _i547_scrub_stale_row_for_event(row, event):
        original = _i546_normalize_row_identity(row if isinstance(row, dict) else {})
        candidate = dict(original)
        for key in _I547_ROW_TIME_KEYS + _I547_XML_KEYS:
            candidate.pop(key, None)
        symbol = _i547_event_symbol_values(event)
        if symbol['sidc'] or symbol['cot_type'] or symbol['iconset_path']:
            for key in _I547_SYMBOL_KEYS:
                candidate.pop(key, None)
        props = candidate.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            for key in _I547_ROW_TIME_KEYS + _I547_XML_KEYS:
                props.pop(key, None)
            if symbol['sidc'] or symbol['cot_type'] or symbol['iconset_path']:
                for key in _I547_SYMBOL_KEYS:
                    props.pop(key, None)
            candidate['properties'] = props
        return original, candidate

    def _i547_apply_current_event_metadata(merged, event, original):
        obj = dict(merged or {})
        event = dict(event or {})
        symbol = _i547_event_symbol_values(event)
        callsign = _i546_event_callsign(event)
        event_xml = _i547_text(event.get('mission_cot_xml') or event.get('xml') or event.get('cot_xml'))

        if callsign:
            prior = _i547_text((original or {}).get('name') or (original or {}).get('callsign'))
            if prior and prior.casefold() != callsign.casefold():
                obj.setdefault('previous_data_sync_name_i547', prior)
            for key in ('callsign', 'contact_callsign', 'name', 'display_name', 'label', 'title'):
                obj[key] = callsign

        if symbol['cot_type']:
            for key in ('type', 'cot_type', 'atak_cot_type', 'event_type'):
                obj[key] = symbol['cot_type']
        if symbol['sidc']:
            obj['sidc'] = symbol['sidc']
            obj['SIDC'] = symbol['sidc']
        if symbol['iconset_path']:
            for key in ('iconsetPath', 'iconsetpath', 'usericon_path'):
                obj[key] = symbol['iconset_path']
        elif symbol['cot_type'] or symbol['sidc']:
            # A current standard CoT type without a usericon must not inherit the
            # previous ATAK usericon path and thereby keep rendering the old icon.
            for key in ('iconsetPath', 'iconsetpath', 'iconset_path', 'usericon_path', 'user_icon_path', 'icon_path', 'iconPath'):
                obj.pop(key, None)

        if event_xml:
            obj['mission_cot_xml'] = event_xml
            obj['xml'] = event_xml
            obj['cot_xml'] = event_xml
        event_epoch = event.get('mission_cot_event_epoch')
        if event_epoch is None:
            event_epoch = _i545_row_epoch(event)
        if event_epoch is not None:
            obj['mission_cot_event_epoch'] = event_epoch

        props = obj.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            if callsign:
                for key in ('callsign', 'contact_callsign', 'name', 'display_name', 'label', 'title'):
                    props[key] = callsign
            if symbol['cot_type']:
                for key in ('type', 'cot_type', 'atak_cot_type', 'event_type'):
                    props[key] = symbol['cot_type']
            if symbol['sidc']:
                props['sidc'] = symbol['sidc']; props['SIDC'] = symbol['sidc']
            if symbol['iconset_path']:
                props['iconsetPath'] = symbol['iconset_path']; props['iconsetpath'] = symbol['iconset_path']; props['usericon_path'] = symbol['iconset_path']
            elif symbol['cot_type'] or symbol['sidc']:
                for key in ('iconsetPath', 'iconsetpath', 'iconset_path', 'usericon_path', 'user_icon_path', 'icon_path', 'iconPath'):
                    props.pop(key, None)
            obj['properties'] = props

        # Resolve from the new event only. Remove all prior derived icon results so
        # the i538 fast path cannot short-circuit on the old icon.
        for key in ('mil2525_name', 'milstd2525_name', 'mil2525_file', 'mil2525_svg', 'mil2525_label', 'symbol_resolution_i537'):
            obj.pop(key, None)
        props = obj.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            for key in ('mil2525_name', 'milstd2525_name', 'mil2525_file', 'mil2525_svg', 'mil2525_label', 'symbol_resolution_i537'):
                props.pop(key, None)
            obj['properties'] = props
        if '_i537_apply_symbol' in globals():
            _i537_apply_symbol(obj, event, event_xml)
        return _i546_normalize_row_identity(obj)

    _i547_merge_event_before = _i545_merge_event
    def _i545_merge_event(row, event):
        original, candidate = _i547_scrub_stale_row_for_event(row, event)
        database_epoch = _i545_row_epoch(original)
        before_fingerprint = _i545_symbol_fingerprint(original)
        merged, applied, reason = _i547_merge_event_before(candidate, event)
        if applied:
            merged = _i547_apply_current_event_metadata(merged, event, original)
            # Preserve database bookkeeping only as diagnostics; it is not a CoT
            # version clock and therefore cannot reject the current Mission event.
            for key in ('updated', 'created_at', 'submission_time', 'added', 'uploaded'):
                if key not in merged and isinstance(original, dict) and original.get(key) not in (None, ''):
                    merged[key] = original.get(key)
            event_epoch = event.get('mission_cot_event_epoch') if isinstance(event, dict) else None
            if event_epoch is None:
                event_epoch = _i545_row_epoch(event)
            after_fingerprint = _i545_symbol_fingerprint(merged)
            merged['data_sync_symbol_fingerprint_i547'] = after_fingerprint
            merged['data_sync_symbol_changed_i547'] = bool(before_fingerprint and after_fingerprint and before_fingerprint != after_fingerprint)
            merged['data_sync_live_event_i547'] = {
                'version': 'i547',
                'selected_event_uid': _i546_canonical_uid_text(event if isinstance(event, dict) else {}),
                'selected_event_epoch': event_epoch,
                'database_row_epoch_diagnostic_only': database_epoch,
                'database_row_timestamp_gate_disabled': True,
                'callsign': _i546_event_callsign(event if isinstance(event, dict) else {}),
                'cot_type': _i547_event_symbol_values(event).get('cot_type'),
                'iconset_path': _i547_event_symbol_values(event).get('iconset_path'),
                'merge_reason': reason,
            }
            reason = 'merged-current-mission-cot-event'
        return merged, applied, reason
    globals()['_i545_merge_event'] = _i545_merge_event

    def _i547_event_rank(event):
        epoch = event.get('mission_cot_event_epoch') if isinstance(event, dict) else None
        if epoch is None:
            epoch = _i545_row_epoch(event)
        return (
            float(epoch) if epoch is not None else float('-inf'),
            _i545_event_detail_score(event),
        )

    def _i547_refresh_enrichment_now(cfg, sess, missions, reason='forced-data-sync-refresh'):
        names = [_i547_text(name) for name in missions if _i547_text(name)][:_I545_MAX_MISSIONS]
        if not names:
            return {'ok': True, 'refreshed': False, 'reason': 'no-missions', 'events': 0, 'missions': []}
        key = _i545_cache_key(cfg or {}, sess or {})
        requested = tuple(sorted({name.casefold() for name in names}))
        rows = []
        combined = {}
        started = time.time()
        with _I547_REFRESH_LOCK:
            for mission in names:
                row = _i545_fetch_mission_events(mission)
                rows.append({k: v for k, v in row.items() if k != 'events'})
                for uid, event in dict(row.get('events') or {}).items():
                    event = dict(event)
                    event['mission_name'] = mission
                    current = combined.get(uid)
                    if current is None or _i547_event_rank(event) > _i547_event_rank(current):
                        combined[uid] = event
            ok = any(row.get('ok') for row in rows)
            record = {
                'ok': ok,
                'time': time.time(),
                'requested': requested,
                'events': combined,
                'missions': rows,
                'event_count': len(combined),
                'error': '' if ok else '; '.join(filter(None, (_i547_text(row.get('error')) for row in rows)))[:1000],
                'refresh_mode_i547': 'synchronous-forced-refresh',
                'refresh_reason_i547': _i547_text(reason),
                'duration_seconds_i547': max(0.0, time.time() - started),
            }
            with _I545_ENRICH_LOCK:
                _I545_ENRICH_CACHE[key] = record
        return {
            'ok': ok,
            'refreshed': True,
            'reason': _i547_text(reason),
            'events': len(combined),
            'missions': rows,
            'duration_seconds': max(0.0, time.time() - started),
            'cache_key': key,
        }

    _i547_augment_before = _i512_augment_data_sync
    def _i512_augment_data_sync(base, cfg, sess):
        out = _i547_augment_before(base, cfg, sess)
        out = dict(out or {})
        missions = _i545_mission_names(out)
        forced = _i547_request_force()
        refresh = {'ok': True, 'refreshed': False, 'reason': 'not-forced', 'events': 0, 'missions': []}
        if forced and _i547_text((sess or {}).get('auth_mode')).startswith('ots-'):
            refresh = _i547_refresh_enrichment_now(cfg or {}, sess or {}, missions, _i547_request_reason())
            out = _i545_apply_cached_enrichment(out, cfg or {}, sess or {}, missions)
            normalized = [_i546_normalize_row_identity(row) for row in list(out.get('objects') or []) if isinstance(row, dict)]
            normalized, duplicates = _i546_dedupe_rows(normalized)
            out['objects'] = normalized
            if '_tak_enrich_data_sync_result' in globals():
                out = _tak_enrich_data_sync_result(out)
            for row in list(out.get('objects') or []):
                if not isinstance(row, dict):
                    continue
                canonical = _i546_canonical_uid_text(row)
                if canonical:
                    row['uid'] = canonical; row['cot_uid'] = canonical; row['event_uid'] = canonical
                live = row.get('data_sync_live_event_i547')
                if isinstance(live, dict):
                    live = dict(live)
                    live['forced_refresh_reason'] = _i547_request_reason()
                    row['data_sync_live_event_i547'] = live
            out['data_sync_forced_duplicate_rows_removed_i547'] = len(duplicates)

        cached = _i545_cached_enrichment(cfg or {}, sess or {}, missions)
        diag = dict(out.get('mission_cot_symbol_enrichment_i546') or out.get('mission_cot_symbol_enrichment_i545') or {})
        diag.update({
            'version': 'i547',
            'mode': 'authenticated-unfiltered-mission-cot-current-event',
            'force_requested': forced,
            'force_reason': _i547_request_reason() if forced else '',
            'forced_refresh_completed': bool(refresh.get('refreshed')),
            'forced_refresh_ok': bool(refresh.get('ok')),
            'forced_refresh_event_count': int(refresh.get('events') or 0),
            'forced_refresh_duration_seconds': refresh.get('duration_seconds'),
            'forced_refresh_mission_results': list(refresh.get('missions') or []),
            'cache_age_seconds_after_refresh': cached.get('age_seconds'),
            'creator_uid_filter_primary': False,
            'creator_uid_fallback_only': True,
            'database_row_timestamp_gate_disabled': True,
            'same_uid_name_updates': True,
            'same_uid_icon_updates': True,
            'current_event_mutable_fields_authoritative': ['callsign', 'name', 'title', 'cot_type', 'sidc', 'iconsetPath'],
        })
        out['mission_cot_symbol_enrichment_i547'] = dict(diag)
        out['mission_cot_symbol_enrichment_i546'] = dict(diag)
        tombstones = out.get('data_sync_deleted_uid_tombstones_i546') or out.get('data_sync_deleted_uid_tombstones_i545') or out.get('data_sync_deleted_uid_tombstones_i543')
        if isinstance(tombstones, dict):
            current_tombstones = dict(tombstones)
            current_tombstones['version'] = 'i547'
            out['data_sync_deleted_uid_tombstones_i547'] = current_tombstones
        out['version'] = 'i547'
        return out
    globals()['_i512_augment_data_sync'] = _i512_augment_data_sync

    # Deletion must rebuild exactly the same final, user-scoped, CoT-enriched
    # snapshot that generated the visible browser canonical IDs. The older helper
    # stopped before i545/i546 identity normalization and could therefore search
    # for a content-UUID-derived ID while the browser submitted an event-UID ID.
    def _tak_fresh_data_sync_result():
        sess = _i529_current_session() if '_i529_current_session' in globals() else {}
        cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
        result = _i512_augment_data_sync(tak_map_data_sync(), cfg or {}, sess or {})
        result = dict(result or {})
        result['data_sync_delete_snapshot_i547'] = {
            'version': 'i547',
            'pipeline': 'tak_map_data_sync + final _i512_augment_data_sync',
            'same_as_visible_data_sync_pipeline': True,
            'canonical_event_uid_after_mission_cot_enrichment': True,
            'object_count': len(result.get('objects') or []),
        }
        return result
    globals()['_tak_fresh_data_sync_result'] = _tak_fresh_data_sync_result

    _i547_invalidate_before = _tak_invalidate_data_sync_cache
    def _tak_invalidate_data_sync_cache():
        _i547_invalidate_before()
        try:
            sess = _i529_current_session() if '_i529_current_session' in globals() else {}
            cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
            key = _i545_cache_key(cfg or {}, sess or {})
            with _I545_ENRICH_LOCK:
                _I545_ENRICH_CACHE.pop(key, None)
        except Exception:
            pass
    globals()['_tak_invalidate_data_sync_cache'] = _tak_invalidate_data_sync_cache

    _i547_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i547_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(str(built.get('wire_xml') or built.get('xml') or '').strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                takv = detail.find('takv')
                if takv is not None: takv.set('version', '1.3.0-i547')
                meta = detail.find('takmap_user_presence')
                if meta is not None: meta.set('version', 'i547')
            wire = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built['wire_xml'] = wire
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + wire.rstrip('\n')
            built['version'] = 'i547'
        except Exception as exc:
            built['i547_presence_version_warning'] = str(exc)
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i547_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
