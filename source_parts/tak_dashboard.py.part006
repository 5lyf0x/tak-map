                if attempt < 8: time.sleep(0.4)
            result.update({'version':'i563','deletion_fence':fence,'terminal_cot':terminal,'mission_absence_confirmed':absent,
                'stale_marker_suppressed':True,'resurrection_blocked':True})
            if uid and (not terminal or not terminal.get('ok') or not absent):
                result['status'] = 'failed'
                result['error'] = 'Mission removal was accepted, but terminal CoT deletion and absence confirmation did not both complete. The persistent deletion fence remains active.'
