    def _i532_version_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i532', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i532', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i532', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i532\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i532\2', html)
        return html

    def _i532_patch_html(html):
        html = _i532_version_html(html)
        if not isinstance(html, str):
            return html
        for script_id in (
            'takMapPerUserDataSyncIdentityI529', 'takMapPerUserDataSyncIdentityI531', 'takMapPerUserDataSyncIdentityI532',
            'takMapMissionPointReconcileI528', 'takMapMissionPointReconcileI531', 'takMapMissionPointReconcileI532',
        ):
            html = re.sub(r'<script[^>]*id=["\']' + re.escape(script_id) + r'["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        return html.replace('</body>', _I532_RUNTIME + '\n</body>', 1) if '</body>' in html else html + _I532_RUNTIME

    TAK_MAP_HTML = _i532_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i532_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i532'

    _i532_session_public_before = _i509_session_public
    def _i509_session_public(sess):
        out = dict(_i532_session_public_before(sess))
        token = ''
        try:
            token = _i529_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', ''))
        except Exception:
            token = ''
        out['version'] = 'i532'
        out['user_eud_presence'] = _i532_presence_public(token) if token else {'ok': False, 'version': 'i532', 'state': 'pending', 'connected': False, 'persistent': True}
        return out
    globals()['_i509_session_public'] = _i509_session_public

    _i532_config_before = tak_map_config
    def tak_map_config():
        cfg = _i532_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i532'
        cfg['version'] = '1.3.0-i532'
        ots = dict(cfg.get('ots_integration') or {})
        ots.update({
            'version': 'i532',
            'persistent_per_user_eud_connection': True,
            'presence_heartbeat_seconds': int(_I532_HEARTBEAT_SECONDS),
            'callsign_priority': ['configured-tak-map-callsign', 'ots-callsign', 'ots-username'],
            'connection_closed_on_logout_or_session_expiry': True,
            'shared_service_certificate_fallback': False,
        })
        cfg['ots_integration'] = ots
        native = dict(cfg.get('data_sync_native_point_publish') or {})
        native.update({
            'version': 'i532',
            'publish_mode': 'persistent-per-user-cot-mission-uid-i532',
            'persistent_authenticated_user_eud': True,
            'mission_object_sent_on_persistent_user_session': True,
            'mission_object_uid_independent': True,
            'local_data_removed_after_exact_readback': True,
            'stable_source_id_reconciliation': True,
            'shared_service_certificate_fallback': False,
        })
        cfg['data_sync_native_point_publish'] = native
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _i532_data_sync_before = tak_map_data_sync
    def tak_map_data_sync():
        out = _i532_data_sync_before()
        if isinstance(out, dict):
            token = _i529_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', ''))
            out['persistent_user_eud_i532'] = _i532_presence_public(token)
            out['point_reconciliation_i532'] = {
                'version': 'i532',
                'exact_mission_readback_required': True,
                'stable_local_source_ids_used': True,
                'local_source_verified_absent_after_delete': True,
                'shared_service_fallback': False,
            }
        return out
    globals()['tak_map_data_sync'] = tak_map_data_sync
except Exception as _i532_exc:
    try:
        print('TAK Map i532 persistent per-user EUD/reconciliation patch failed:', _i532_exc)
    except Exception:
        pass
# --- end TAK Map i532 persistent per-user EUD session + confirmed Local Data reconciliation ---

# --- TAK Map i533 OTS-confirmed persistent per-user EUD presence ---
try:
    import select as _i533_select

    _I533_OTS_CONFIRM_TIMEOUT_SECONDS = 8.0
    _I533_OTS_CURRENT_MAX_AGE_SECONDS = 90.0
    _I533_FIRST_IDENTITY_DELAY_SECONDS = 0.35

    def _i533_utc_now():
        return datetime.now(timezone.utc)

    def _i533_cot_stamp(value=None):
        value = value or _i533_utc_now()
        if value.tzinfo is None:
            value = value.replace(tzinfo=timezone.utc)
        value = value.astimezone(timezone.utc)
        return value.strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3] + 'Z'

    def _i532_presence_xml(sess, credential):
        ident = _i532_session_identity(sess)
        client_uid = _i529_text(ident.get('uid') or credential.get('client_uid'))
        username = _i529_text(ident.get('username') or credential.get('username') or credential.get('certificate_cn'))
        callsign = _i529_text(ident.get('callsign') or username or credential.get('certificate_cn'))
        if not client_uid:
            return {'ok': False, 'error': 'The authenticated OTS user has no stable TAK UID for persistent EUD presence.'}
        if not callsign:
            return {'ok': False, 'error': 'The authenticated OTS user has no callsign or username for persistent EUD presence.'}

        now = _i533_utc_now()
        stale = now + timedelta(minutes=3)
        time_text = _i533_cot_stamp(now)
        stale_text = _i533_cot_stamp(stale)
        event = ET.Element('event', {
            'version': '2.0',
            'uid': client_uid,
            'type': 'a-f-G-U-C',
            'how': 'm-g',
            'time': time_text,
            'start': time_text,
            'stale': stale_text,
            'access': 'Undefined',
        })
        ET.SubElement(event, 'point', {
            'lat': '0.0000000',
            'lon': '0.0000000',
            'hae': '0',
            'ce': '9999999.0',
            'le': '9999999.0',
        })
        detail = ET.SubElement(event, 'detail')
        ET.SubElement(detail, 'contact', {'callsign': callsign, 'endpoint': '*:-1:stcp'})
        ET.SubElement(detail, 'uid', {'Droid': callsign})
        ET.SubElement(detail, 'takv', {
            'device': 'Web Browser',
            'platform': 'TAK Map',
            'os': 'Web',
            'version': '1.3.0-i533',
        })
        # OTS derives group routing from the authenticated user. The initial
        # identity deliberately omits __group so EUD registration cannot be
        # blocked by unrelated team/chatroom database reconciliation.
        ET.SubElement(detail, 'status', {'battery': '100'})
        ET.SubElement(detail, 'track', {'course': '0.0', 'speed': '0.0'})
        ET.SubElement(detail, 'takmap_user_presence', {
            'version': 'i533',
            'purpose': 'persistent-authenticated-web-session-eud',
            'username': username,
            'callsign': callsign,
            'missionObject': 'false',
            'serviceCredentialFallback': 'false',
            'timestamps': 'timezone-aware-utc',
        })
        bare_xml = ET.tostring(event, encoding='unicode', short_empty_elements=True)
        return {
            'ok': True,
            'xml': '<?xml version="1.0" encoding="UTF-8"?>\n' + bare_xml,
            # OTS's traditional stream handler splits on the closing event tag.
            # A bare event avoids a second XML declaration in a long-lived stream.
            'wire_xml': bare_xml + '\n',
            'uid': client_uid,
            'callsign': callsign,
            'username': username,
            'time': time_text,
            'start': time_text,
            'stale': stale_text,
            'emitted_at_epoch': now.timestamp(),
        }
    globals()['_i532_presence_xml'] = _i532_presence_xml

    def _i533_session_auth(sess):
        sess = sess if isinstance(sess, dict) else {}
        return {
            'token': _i529_text(sess.get('ots_token')),
            'token_header': _i529_text(sess.get('ots_token_header')),
            'token_prefix': _i529_text(sess.get('ots_token_prefix')),
            'cookies': _i529_text(sess.get('ots_cookies')),
            'csrf_token': _i529_text(sess.get('ots_csrf_token')),
            'auth_method': _i529_text(sess.get('ots_auth_method')),
        }

    def _i533_db_eud(uid):
        uris, uri_errors = _candidate_ots_pg_uris()
        last_error = '; '.join(str(x) for x in (uri_errors or []) if str(x).strip())
        sql = (
            "select row_to_json(q) from ("
            "select uid,coalesce(callsign,'') as callsign,coalesce(device,'') as device,"
            "coalesce(os,'') as os,coalesce(platform,'') as platform,coalesce(version,'') as version,"
            "coalesce(last_status,'') as last_status,last_event_time::text as last_event_time,"
            "extract(epoch from (now() - last_event_time))::double precision as age_seconds "
            "from public.euds where uid=" + _pg_sql_literal(uid) + " order by id desc limit 1) q"
        )
        for uri in uris:
            rows, err = _pg_rows_json(uri, sql)
            if err:
                last_error = err
                continue
            if rows and isinstance(rows[0], dict):
                row = dict(rows[0])
                row['confirmation_source'] = 'ots-postgresql-euds'
                return {'ok': True, 'row': row, 'source': row['confirmation_source']}
        return {'ok': False, 'error': last_error or 'The OpenTAKServer EUD database row was not available yet.'}

    def _i533_api_eud(sess, uid):
        try:
            cfg = _i509_load_ots_config()
            fetched = _i511_fetch_profile(cfg, _i533_session_auth(sess), _i529_text((sess or {}).get('username')))
            if not fetched.get('ok'):
                return {'ok': False, 'error': _i529_text(fetched.get('error'))}
            for item in (fetched.get('profile') or {}).get('euds') or []:
                if _i529_text(item.get('uid')) == uid:
                    row = dict(item)
                    row['confirmation_source'] = 'ots-api-me-euds'
                    age = None
                    stamp = _i511_parse_time(row.get('last_event_time'))
                    if stamp:
                        age = max(-60.0, time.time() - stamp)
                    row['age_seconds'] = age
                    return {'ok': True, 'row': row, 'source': row['confirmation_source']}
        except Exception as exc:
            return {'ok': False, 'error': str(exc)}
        return {'ok': False, 'error': 'The OTS user profile did not list the TAK Map EUD UID yet.'}

    def _i533_read_ots_eud(sess, uid):
        primary = _i533_db_eud(uid)
        if primary.get('ok'):
            return primary
        fallback = _i533_api_eud(sess, uid)
        if fallback.get('ok'):
            return fallback
        return {
            'ok': False,
            'error': _i529_text(primary.get('error') or fallback.get('error') or 'OTS EUD confirmation is unavailable.'),
            'database_error': _i529_text(primary.get('error')),
            'api_error': _i529_text(fallback.get('error')),
        }

    def _i533_eud_row_status(row, uid, callsign):
        row = row if isinstance(row, dict) else {}
        observed_uid = _i529_text(row.get('uid'))
        observed_callsign = _i529_text(row.get('callsign'))
        status = _i529_text(row.get('last_status') or row.get('status')).lower()
        try:
            age = float(row.get('age_seconds'))
        except Exception:
            age = 999999.0
        uid_ok = observed_uid == uid
        callsign_ok = bool(observed_callsign) and observed_callsign.lower() == callsign.lower()
        status_ok = status in ('connected', 'online', 'active', 'current')
        current_ok = -60.0 <= age <= _I533_OTS_CURRENT_MAX_AGE_SECONDS
        confirmed = bool(uid_ok and callsign_ok and status_ok and current_ok)
        return {
            'confirmed': confirmed,
            'uid_ok': uid_ok,
            'callsign_ok': callsign_ok,
            'status_ok': status_ok,
            'current_ok': current_ok,
            'age_seconds': round(age, 3) if abs(age) < 999998 else None,
            'observed_uid': observed_uid,
            'observed_callsign': observed_callsign,
            'observed_status': _i529_text(row.get('last_status') or row.get('status')),
            'observed_timestamp': _i529_text(row.get('last_event_time')),
            'observed_device': _i529_text(row.get('device')),
            'observed_os': _i529_text(row.get('os')),
            'observed_platform': _i529_text(row.get('platform')),
            'observed_version': _i529_text(row.get('version')),
            'confirmation_source': _i529_text(row.get('confirmation_source')),
        }

    def _i533_wait_for_ots_eud(sess, presence, timeout=None):
        timeout = float(timeout or _I533_OTS_CONFIRM_TIMEOUT_SECONDS)
        deadline = time.monotonic() + max(0.5, timeout)
        last = {'ok': False, 'error': 'OTS has not confirmed the EUD identity yet.'}
        while time.monotonic() < deadline:
            last = _i533_read_ots_eud(sess, presence['uid'])
            if last.get('ok'):
                verdict = _i533_eud_row_status(last.get('row'), presence['uid'], presence['callsign'])
                if verdict.get('confirmed'):
                    return {'ok': True, 'row': dict(last.get('row') or {}), 'verdict': verdict}
                last = {'ok': False, 'error': 'OTS EUD row exists but is not current, connected, and callsign-complete.', 'row': last.get('row'), 'verdict': verdict}
            time.sleep(0.25)
        return last

    def _i533_reader(state, tls, generation):
        try:
            while not state['stop'].is_set():
                if state.get('tls') is not tls or int(state.get('socket_generation') or 0) != generation:
                    return
                try:
                    ready, _, _ = _i533_select.select([tls], [], [], 1.0)
                except Exception:
                    ready = []
                if not ready:
                    continue
                try:
                    data = tls.recv(65536)
                except (ssl.SSLWantReadError, BlockingIOError):
                    continue
                except Exception as exc:
                    state['reader_error'] = str(exc)
                    data = b''
                if not data:
                    state['peer_closed_at'] = _i533_utc_now().isoformat()
                    state['last_error'] = state.get('reader_error') or 'OpenTAKServer closed the persistent EUD socket.'
                    state['wake'].set()
                    with state['io_lock']:
                        if state.get('tls') is tls:
                            _i532_close_locked(state, 'peer-closed')
                    return
                state['received_bytes'] = int(state.get('received_bytes') or 0) + len(data)
                state['last_receive_at'] = _i533_utc_now().isoformat()
        except Exception as exc:
            state['reader_error'] = str(exc)
            state['wake'].set()

    _i533_close_before = _i532_close_locked
    def _i532_close_locked(state, reason='disconnected'):
        state['socket_generation'] = int(state.get('socket_generation') or 0) + 1
        _i533_close_before(state, reason)
        state['socket_connected'] = False
        state['ots_eud_confirmed'] = False
        state['ots_confirmation_state'] = 'disconnected'
    globals()['_i532_close_locked'] = _i532_close_locked

    def _i533_record_presence(state, presence):
        state.update({
            'client_uid': presence.get('uid'),
            'callsign': presence.get('callsign'),
            'username': presence.get('username'),
            'last_emitted_time': presence.get('time'),
            'last_emitted_start': presence.get('start'),
            'last_emitted_stale': presence.get('stale'),
            'last_heartbeat_at': _i533_utc_now().isoformat(),
            'last_heartbeat_monotonic': time.monotonic(),
        })

    def _i533_apply_confirmation(state, confirmation):
        row = dict(confirmation.get('row') or {})
        verdict = dict(confirmation.get('verdict') or {})
        state.update({
            'connected': True,
            'socket_connected': True,
            'ots_eud_confirmed': True,
            'ots_confirmation_state': 'confirmed',
            'state': 'connected',
            'last_error': '',
            'ots_eud_row': row,
            'ots_eud_verdict': verdict,
            'ots_confirmed_at': _i533_utc_now().isoformat(),
        })

    def _i532_connect_locked(state, sess):
        credential = _i532_session_credential(sess)
        if not credential.get('ok'):
            raise RuntimeError('Per-user OTS certificate unavailable: ' + _i529_text(credential.get('error')))
        cfg = _i509_load_ots_config()
        host, port = _i531_cot_endpoint(cfg)
        presence = _i532_presence_xml(sess, credential)
        if not presence.get('ok'):
            raise RuntimeError(_i529_text(presence.get('error')))

        _i532_close_locked(state, 'reconnecting')
        ctx = _i529_strict_tls_context(cfg, credential.get('ca_chain_path'))
        ctx.load_cert_chain(
            credential['certificate_path'],
            credential['private_key_path'],
            password=credential['key_password'],
        )
        raw = socket.create_connection((host, int(port)), timeout=8)
        try:
            raw.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        except Exception:
            pass
        try:
            raw.settimeout(10)
            tls = ctx.wrap_socket(raw, server_hostname=host)
        except Exception:
            try:
                raw.close()
            except Exception:
                pass
            raise

        generation = int(state.get('socket_generation') or 0) + 1
        state.update({
            'tls': tls,
            'socket_generation': generation,
            'socket_connected': True,
            'connected': False,
            'ots_eud_confirmed': False,
            'ots_confirmation_state': 'awaiting-ots-eud-row',
            'state': 'awaiting-ots-confirmation',
            'host': host,
            'port': int(port),
            'certificate_cn': credential.get('certificate_cn'),
            'connected_at': _i533_utc_now().isoformat(),
            'last_error': '',
            'disconnect_reason': '',
            'received_bytes': 0,
            'last_receive_at': '',
            'reader_error': '',
        })
        reader = threading.Thread(
            target=_i533_reader,
            args=(state, tls, generation),
            name='tak-map-i533-eud-reader-' + hashlib.sha256(str(state.get('key') or generation).encode()).hexdigest()[:8],
            daemon=True,
        )
        state['reader_thread'] = reader
        reader.start()

        # Give OTS's certificate-authenticated handler time to complete its
        # setup before the first identity message becomes the socket identity.
        time.sleep(_I533_FIRST_IDENTITY_DELAY_SECONDS)
        tls.sendall(presence['wire_xml'].encode('utf-8'))
        _i533_record_presence(state, presence)

        confirmation = _i533_wait_for_ots_eud(sess, presence)
        if not confirmation.get('ok'):
            detail = _i529_text(confirmation.get('error') or 'OTS did not confirm the TAK Map EUD row.')
            verdict = confirmation.get('verdict') if isinstance(confirmation.get('verdict'), dict) else {}
            state['ots_eud_row'] = dict(confirmation.get('row') or {})
            state['ots_eud_verdict'] = dict(verdict or {})
            state['ots_confirmation_state'] = 'not-confirmed'
            state['last_error'] = detail
            _i532_close_locked(state, 'ots-eud-not-confirmed')
            raise RuntimeError(detail)
        _i533_apply_confirmation(state, confirmation)
        return presence
    globals()['_i532_connect_locked'] = _i532_connect_locked

    def _i532_send_presence_locked(state, sess, force=False):
        current = _i532_session_identity(sess)
        age = time.monotonic() - float(state.get('last_heartbeat_monotonic') or 0)
        changed = _i529_text(current.get('callsign')) != _i529_text(state.get('callsign'))
        if (
            not force
            and state.get('tls') is not None
            and state.get('ots_eud_confirmed')
            and age < _I532_HEARTBEAT_SECONDS
            and not changed
        ):
            return {'ok': True, 'uid': state.get('client_uid'), 'callsign': state.get('callsign'), 'ots_eud_confirmed': True}
        if state.get('tls') is None or not state.get('ots_eud_confirmed'):
            return _i532_connect_locked(state, sess)

        credential = _i532_session_credential(sess)
        presence = _i532_presence_xml(sess, credential)
        if not presence.get('ok'):
            raise RuntimeError(_i529_text(presence.get('error')))
        state['tls'].sendall(presence['wire_xml'].encode('utf-8'))
        _i533_record_presence(state, presence)
        state['ots_confirmation_state'] = 'checking-heartbeat'
        confirmation = _i533_wait_for_ots_eud(sess, presence, timeout=5.0)
        if not confirmation.get('ok'):
            state['connected'] = False
            state['ots_eud_confirmed'] = False
            state['state'] = 'reconnecting'
            state['last_error'] = _i529_text(confirmation.get('error') or 'OTS did not confirm the current EUD heartbeat.')
            state['ots_eud_row'] = dict(confirmation.get('row') or {})
            state['ots_eud_verdict'] = dict(confirmation.get('verdict') or {})
            raise RuntimeError(state['last_error'])
        _i533_apply_confirmation(state, confirmation)
        return presence
    globals()['_i532_send_presence_locked'] = _i532_send_presence_locked

    def _i532_presence_public(token='', state=None):
        token = _i529_text(token)
        if state is None:
            with _I532_PRESENCE_GUARD:
                key = _I532_TOKEN_KEYS.get(token, '')
                state = _I532_PRESENCE.get(key)
        if not isinstance(state, dict):
            return {
                'ok': False,
                'version': 'i533',
                'state': 'disconnected',
                'connected': False,
                'socket_connected': False,
                'ots_eud_confirmed': False,
                'persistent': True,
            }
        row = dict(state.get('ots_eud_row') or {})
        verdict = dict(state.get('ots_eud_verdict') or {})
        confirmed = bool(state.get('ots_eud_confirmed') and state.get('connected') and state.get('tls') is not None)
        return {
            'ok': confirmed,
            'version': 'i533',
            'state': _i529_text(state.get('state') or ('connected' if confirmed else 'starting')),
            'connected': confirmed,
            'socket_connected': bool(state.get('socket_connected') and state.get('tls') is not None),
            'ots_eud_confirmed': confirmed,
            'ots_confirmation_state': _i529_text(state.get('ots_confirmation_state')),
            'persistent': True,
            'username': _i529_text(state.get('username')),
            'callsign': _i529_text(state.get('callsign')),
            'client_uid': _i529_text(state.get('client_uid')),
            'certificate_cn': _i529_text(state.get('certificate_cn')),
            'connected_at': _i529_text(state.get('connected_at')),
            'last_heartbeat_at': _i529_text(state.get('last_heartbeat_at')),
            'last_emitted_time': _i529_text(state.get('last_emitted_time')),
            'last_emitted_start': _i529_text(state.get('last_emitted_start')),
            'last_emitted_stale': _i529_text(state.get('last_emitted_stale')),
            'ots_confirmed_at': _i529_text(state.get('ots_confirmed_at')),
            'ots_last_status': _i529_text(row.get('last_status') or row.get('status')),
            'ots_last_event_time': _i529_text(row.get('last_event_time')),
            'ots_callsign': _i529_text(row.get('callsign')),
            'ots_device': _i529_text(row.get('device')),
            'ots_os': _i529_text(row.get('os')),
            'ots_platform': _i529_text(row.get('platform')),
            'ots_version': _i529_text(row.get('version')),
            'ots_row_age_seconds': verdict.get('age_seconds'),
            'ots_confirmation_source': _i529_text(verdict.get('confirmation_source') or row.get('confirmation_source')),
            'received_bytes': int(state.get('received_bytes') or 0),
            'last_receive_at': _i529_text(state.get('last_receive_at')),
            'last_error': _i529_text(state.get('last_error')),
            'heartbeat_seconds': int(_I532_HEARTBEAT_SECONDS),
            'timezone_aware_utc': True,
            'shared_service_fallback': False,
        }
    globals()['_i532_presence_public'] = _i532_presence_public

    _i533_certificate_status_before = _i529_public_certificate_status
    def _i529_public_certificate_status(username, expected_uid=''):
        status = _i533_certificate_status_before(username, expected_uid)
        if isinstance(status, dict):
            status = dict(status)
            status['version'] = 'i533'
            status['shared_service_fallback'] = False
        return status
    globals()['_i529_public_certificate_status'] = _i529_public_certificate_status

    _i533_do_get_before = Handler.do_GET
    def _i533_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/ots/user-certificate':
            sess = self._tak_map_session() if self._tak_map_auth_ok() else None
            if not sess:
                return self._require_tak_map_login()
            if not _i529_text(sess.get('auth_mode')).startswith('ots-'):
                return self._send_json({'ok': False, 'error': 'Per-user Data Sync certificates apply only to OpenTAKServer sessions.', 'version': 'i533'}, 409)
            token = self._tak_map_token() if callable(getattr(self, '_tak_map_token', None)) else ''
            profile = dict(sess.get('profile') or {})
            status = dict(_i529_public_certificate_status(
                _i529_text(sess.get('username')),
                _i529_text(sess.get('tak_uid') or profile.get('tak_uid')),
            ) or {})
            safe = {key: value for key, value in status.items() if key not in ('key_password', 'private_key_path', 'certificate_path', 'ca_chain_path')}
            safe['version'] = 'i533'
            safe['user_presence'] = _i532_presence_public(token)
            return self._send_json(safe, 200 if status.get('ok') else 428)
        return _i533_do_get_before(self)
    Handler.do_GET = _i533_do_get

    _i533_point_xml_before = _i526_point_xml
    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i533_point_xml_before(feature, mission_name, creator_uid)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(_i529_text(built.get('xml')).encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                transport = detail.find('takmap')
                if transport is not None:
                    transport.set('version', 'i533')
                    transport.set('publicationFlow', 'ots-confirmed-persistent-user-eud-cot-then-mission-uid-association')
                    transport.set('persistentUserEud', 'true')
                    transport.set('otsEudConfirmed', 'true')
                point_meta = detail.find('takmap_point')
                if point_meta is not None:
                    point_meta.set('version', 'i533')
                    point_meta.set('publicationFlow', 'ots-confirmed-persistent-user-eud-cot-then-mission-uid-association')
                    point_meta.set('eudPresence', 'false')
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            built['version'] = 'i533'
            built['publication_flow'] = 'ots-confirmed-persistent-user-eud-cot-then-mission-uid-association'
            built['persistent_user_eud'] = True
            built['ots_eud_confirmation_required'] = True
            built['mission_object_uid_independent'] = True
        except Exception as exc:
            built['i533_publication_xml_warning'] = str(exc)
        return built
    globals()['_i526_point_xml'] = _i526_point_xml

    _i533_native_publish_before = tak_map_publish_native_points_to_mission_i526
    def tak_map_publish_native_points_to_mission_i526(points, mission_name='', server_host='', creator_uid=''):
        result = _i533_native_publish_before(points, mission_name, server_host, creator_uid)
        if isinstance(result, dict):
            result = dict(result)
            result['version'] = 'i533'
            result['publish_mode'] = 'ots-confirmed-persistent-per-user-cot-mission-uid-i533'
            result['persistent_authenticated_user_eud'] = True
            result['ots_eud_confirmation_required'] = True
            result['mission_object_uid_independent'] = True
            result['shared_service_fallback'] = False
        return result
    globals()['tak_map_publish_native_points_to_mission_i526'] = tak_map_publish_native_points_to_mission_i526

    _I533_RUNTIME = r'''<script id="takMapPerUserDataSyncIdentityI533">
(function(w,d){'use strict';const V='i533',by=id=>d.getElementById(id),esc=s=>String(s==null?'':s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));let state=null,lastMarkup='';
async function load(){try{const r=await fetch('/api/tak-map/ots/user-certificate',{cache:'no-store',credentials:'same-origin'}),j=await r.json();state=j;render();return j}catch(e){state={ok:false,error:String(e),user_presence:{connected:false,state:'unavailable'}};render();return state}}
async function refreshPresence(){try{const r=await fetch('/api/tak-map/ots/session',{cache:'no-store',credentials:'same-origin'}),j=await r.json();if(!state)state={ok:false};state.user_presence=j.user_eud_presence||state.user_presence;render();return state}catch(_){return state}}
function markup(){const p=state&&state.user_presence||{},ready=!!(state&&state.ok),confirmed=!!p.ots_eud_confirmed,socket=!!p.socket_connected;let presence=confirmed?'Connected · OTS confirmed':(socket?'Socket connected · awaiting OTS confirmation':(p.state||'Connecting'));return '<b>Data Sync identity</b><br><span style="color:'+(ready?'#7ee787':'#ffb86b')+'">'+(ready?'Ready':'Unavailable')+'</span><br><span>'+esc(state&&(state.certificate_cn||state.username)||'')+'</span><br><b>User EUD</b><br><span style="color:'+(confirmed?'#7ee787':'#ffb86b')+'">'+esc(presence)+'</span>'+(p.callsign?'<br><span>Callsign '+esc(p.callsign)+'</span>':'')+(p.client_uid?'<br><span title="'+esc(p.client_uid)+'">'+esc(p.client_uid)+'</span>':'')+(p.ots_last_status?'<br><span>OTS '+esc(p.ots_last_status)+'</span>':'')+(p.ots_last_event_time?'<br><span>OTS event '+esc(p.ots_last_event_time)+'</span>':'')+(state&&state.expires_at?'<br><span>Cert expires '+esc(state.expires_at)+'</span>':'')+(p.last_error?'<br><span title="'+esc(p.last_error)+'">'+esc(p.last_error)+'</span>':'')+(state&&state.error?'<br><span title="'+esc(state.error)+'">'+esc(state.error)+'</span>':'')}
function render(){try{const menu=by('takMapAccountMenuV511');if(!menu||!state)return;let box=by('takMapDataSyncIdentityI533');if(!box){box=d.createElement('div');box.id='takMapDataSyncIdentityI533';box.style.cssText='margin:8px 0;padding:8px;border:1px solid rgba(255,255,255,.1);border-radius:8px;font-size:.72rem;line-height:1.45';const actions=menu.querySelector('.tak-account-actions-v511');menu.insertBefore(box,actions||null);lastMarkup=''}const next=markup();if(next!==lastMarkup&&box.innerHTML!==next){box.innerHTML=next;lastMarkup=next}}catch(_){} }
function boot(){load();try{const mo=new MutationObserver(()=>{if(state&&by('takMapAccountMenuV511')&&!by('takMapDataSyncIdentityI533'))render()});mo.observe(d.body,{childList:true,subtree:true})}catch(_){}setInterval(refreshPresence,15000)}
if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapPerUserDataSyncIdentityI533=Object.freeze({version:V,load,refreshPresence,render,diagnostics:()=>state});
})(window,document);
</script>'''

    def _i533_version_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i533', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i533', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i533', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i533\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i533\2', html)
        return html

    def _i533_patch_html(html):
        html = _i533_version_html(html)
        if not isinstance(html, str):
            return html
        for script_id in (
            'takMapPerUserDataSyncIdentityI529', 'takMapPerUserDataSyncIdentityI531',
            'takMapPerUserDataSyncIdentityI532', 'takMapPerUserDataSyncIdentityI533',
        ):
            html = re.sub(r'<script[^>]*id=["\']' + re.escape(script_id) + r'["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        return html.replace('</body>', _I533_RUNTIME + '\n</body>', 1) if '</body>' in html else html + _I533_RUNTIME

    TAK_MAP_HTML = _i533_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i533_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i533'

    _i533_session_public_before = _i509_session_public
    def _i509_session_public(sess):
        out = dict(_i533_session_public_before(sess))
        token = ''
        try:
            token = _i529_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', ''))
        except Exception:
            token = ''
        out['version'] = 'i533'
        out['user_eud_presence'] = _i532_presence_public(token) if token else {
            'ok': False, 'version': 'i533', 'state': 'pending', 'connected': False,
            'socket_connected': False, 'ots_eud_confirmed': False, 'persistent': True,
        }
        return out
    globals()['_i509_session_public'] = _i509_session_public

    _i533_config_before = tak_map_config
    def tak_map_config():
        cfg = _i533_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i533'
        cfg['version'] = '1.3.0-i533'
        ots = dict(cfg.get('ots_integration') or {})
        ots.update({
            'version': 'i533',
            'persistent_per_user_eud_connection': True,
            'ots_eud_row_confirmation_required': True,
            'timezone_aware_utc_presence_timestamps': True,
            'socket_reader_enabled': True,
            'initial_identity_group_side_effects_removed': True,
            'presence_heartbeat_seconds': int(_I532_HEARTBEAT_SECONDS),
            'shared_service_certificate_fallback': False,
        })
        cfg['ots_integration'] = ots
        native = dict(cfg.get('data_sync_native_point_publish') or {})
        native.update({
            'version': 'i533',
            'publish_mode': 'ots-confirmed-persistent-per-user-cot-mission-uid-i533',
            'persistent_authenticated_user_eud': True,
            'ots_eud_confirmation_required': True,
            'mission_object_uid_independent': True,
            'local_data_removed_after_exact_readback': True,
            'shared_service_certificate_fallback': False,
        })
        cfg['data_sync_native_point_publish'] = native
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _i533_data_sync_before = tak_map_data_sync
