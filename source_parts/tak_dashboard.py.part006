                _i566_apply_custom_authority(row)
        rows=out.get('objects')
        recovered=0
        if isinstance(rows,list):
            for row in rows:
                if not isinstance(row,dict) or _i565_delete_event(row): continue
                xml_path, complete_xml=_i566_xml_icon_authority(row)
                custom=xml_path if complete_xml else _i566_authoritative_custom_path(row)
                if not custom and not complete_xml:
