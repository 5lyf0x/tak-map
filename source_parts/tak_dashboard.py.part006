    def _i565_delete_event(event):
        cot_type = _i565_event_type(event).casefold()
        return cot_type == 't-x-d-d' or cot_type.startswith('t-x-d-') or bool((event or {}).get('deleted') or (event or {}).get('tombstone'))

    def _i565_complete_event_xml(event):
        xml = _i565_text((event or {}).get('mission_cot_xml') or (event or {}).get('cot_xml') or (event or {}).get('xml'))
        return bool(xml and re.search(r'<event\b', xml, re.I))

    def _i565_explicit_sidc(event):
        event = event or {}
        raw = _i565_text(event.get('mission_cot_raw_sidc_i553') or event.get('mission_cot_raw_sidc_i552') or event.get('mission_cot_raw_sidc_i550') or event.get('mission_cot_raw_sidc_i549'))
        if raw:
            return raw
        payload = event.get('mission_cot_payload')
        if isinstance(payload, dict):
            for key in ('sidc','SIDC','mil2525_sidc','milstd2525_sidc','symbol_id','symbolId'):
                if _i565_text(payload.get(key)):
                    return _i565_text(payload.get(key))
        resolution = event.get('symbol_resolution_i537') if isinstance(event.get('symbol_resolution_i537'), dict) else {}
        if _i565_text(resolution.get('source')).casefold() == 'cot-type':
            return ''
        return _i565_text(event.get('sidc') or event.get('SIDC') or event.get('mil2525_sidc') or event.get('milstd2525_sidc'))

    def _i565_custom_icon_path(value):
        path = _i565_canonical_iconset_path(value)
        return path if path and not path.upper().startswith('COT_MAPPING_2525') else ''

    def _i565_event_epoch(event):
        value = (event or {}).get('mission_cot_event_epoch')
        if value is None:
            try: value = _i545_row_epoch(event)
            except Exception: value = None
        try: return float(value) if value is not None else None
        except Exception: return None

    def _i565_select_latest(events):
        current = None
        for order, event in enumerate(events, 1):
            event['_i565_order'] = order
            epoch = _i565_event_epoch(event)
            event['mission_cot_event_epoch'] = epoch
            if current is None:
                current = event; continue
            current_epoch = _i565_event_epoch(current)
            replace = False
            if epoch is not None and (current_epoch is None or epoch > current_epoch):
                replace = True
            elif epoch is not None and current_epoch is not None and epoch == current_epoch:
                score = _i545_event_detail_score(event); old_score = _i545_event_detail_score(current)
                replace = score > old_score or (score == old_score and order > current.get('_i565_order', -1))
            elif epoch is None and current_epoch is None:
                score = _i545_event_detail_score(event); old_score = _i545_event_detail_score(current)
                replace = score > old_score or (score == old_score and order > current.get('_i565_order', -1))
            if replace: current = event
        return current

    def _i565_recover_custom_icon(current, siblings):
        if not isinstance(current, dict) or _i565_delete_event(current):
            return current
        current_icon = _i565_event_iconset(current)
        if current_icon:
            return current
        # A complete newer XML event that intentionally omits usericon is authoritative.
        if _i565_complete_event_xml(current):
            return current
        if _i565_explicit_sidc(current):
            return current
        current_type = _i565_event_type(current).casefold()
        if not current_type or not re.match(r'^a-[fhnu]-[a-z](?:$|-)', current_type, re.I):
            return current
        current_epoch = _i565_event_epoch(current)
        candidates = sorted(siblings, key=lambda row: (_i565_event_epoch(row) is not None, _i565_event_epoch(row) or -1, _i545_event_detail_score(row)), reverse=True)
        for prior in candidates:
            if prior is current or _i565_delete_event(prior):
                continue
            path = _i565_custom_icon_path(_i565_event_iconset(prior))
            if not path or not _i565_complete_event_xml(prior):
                continue
            prior_type = _i565_event_type(prior).casefold()
            if prior_type != current_type:
                continue
            prior_epoch = _i565_event_epoch(prior)
            if current_epoch is not None and prior_epoch is not None:
                delta = current_epoch - prior_epoch
                if delta < -0.001 or delta > _I565_CUSTOM_ICON_WINDOW_SECONDS:
                    continue
            merged = dict(current)
            for key in ('iconsetPath','iconsetpath','iconset_path','usericon_path','user_icon_path'):
                merged[key] = path
            merged['mission_cot_raw_iconset_path_i565'] = path
            merged['current_iconset_path_i565'] = path
            merged['mission_cot_icon_source_xml_i565'] = _i565_text(prior.get('mission_cot_xml'))
            merged['mission_cot_custom_icon_coalesced_i565'] = True
            merged['mission_cot_custom_icon_coalesced_from_epoch_i565'] = prior_epoch
            return merged
        return current

    def _i565_apply_custom_authority(row):
        if not isinstance(row, dict):
            return row
        path = _i565_event_iconset(row)
        if not path:
            # Browser-side final recovery also understands retained XML, but expose it here when possible.
            for key in ('mission_cot_xml','cot_xml','xml','mission_cot_icon_source_xml_i565'):
                xml = _i565_text(row.get(key))
                match = re.search(r'<usericon\b[^>]*\biconsetpath=["\']([^"\']+)["\']', xml, re.I) if xml else None
                if match:
                    path = _i565_canonical_iconset_path(match.group(1)); break
        custom = _i565_custom_icon_path(path)
        if not custom or _i565_delete_event(row):
            return row
        for key in ('iconsetPath','iconsetpath','iconset_path','usericon_path','user_icon_path'):
            row[key] = custom
        row['data_sync_current_iconset_path_i565'] = custom
        row['current_iconset_path_i565'] = custom
        row['mission_cot_raw_iconset_path_i565'] = custom
        row['custom_icon'] = True
        row['data_sync_icon_authority_i565'] = {'authority':'usericon-iconsetpath','custom_usericon':True,'canonical_path':custom}
        for key in ('sidc','SIDC','mil2525_sidc','milstd2525_sidc','mil2525_file','mil2525_name','mil2525_label','generated_mil2525_file'):
            row.pop(key, None)
        props = row.get('properties')
        if isinstance(props, dict):
            for key in ('iconsetPath','iconsetpath','iconset_path','usericon_path','user_icon_path'):
                props[key] = custom
            props['custom_icon'] = True
            props['data_sync_current_iconset_path_i565'] = custom
            for key in ('sidc','SIDC','mil2525_sidc','milstd2525_sidc','mil2525_file','mil2525_name','mil2525_label','generated_mil2525_file'):
                props.pop(key, None)
        return row

    def _i565_extract_events(payload, body=''):
        events = []
        seen_objects = set()
        stack = [payload, body]
        scanned = 0
        while stack and scanned < 20000:
            value = stack.pop(); scanned += 1
            if value is None: continue
            if isinstance(value, str):
                events.extend(_i545_xml_events(value)); continue
            if isinstance(value, dict):
                ident = id(value)
                if ident in seen_objects: continue
                seen_objects.add(ident)
                event = _i545_json_event(value)
                if event: events.append(event)
                for nested in value.values():
                    if isinstance(nested, (dict,list,tuple,str)): stack.append(nested)
                continue
            if isinstance(value, (list,tuple)): stack.extend(value)
        grouped = {}
        for event in events:
            uid = _i565_text(event.get('uid')).casefold()
            if uid: grouped.setdefault(uid, []).append(event)
        latest = {}
        for uid, siblings in grouped.items():
            current = _i565_select_latest(siblings)
            current = _i565_recover_custom_icon(current, siblings)
            current.pop('_i565_order', None)
            latest[uid] = _i565_apply_custom_authority(current)
        return latest

    _i545_extract_events = _i565_extract_events
    globals()['_i545_extract_events'] = _i545_extract_events

