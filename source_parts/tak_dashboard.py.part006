# --- TAK Map i572 protected Mission unlock, confirmed save truth, custom icon authority, and sidebar stacking ---
try:
    _I572_ROOT = Path(__file__).resolve().parent
    _I572_MISSION_SECRET_ROOT = DATA_DIR / 'mission_unlock_users_i572'
    _I572_MISSION_SECRET_ROOT.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(_I572_MISSION_SECRET_ROOT, 0o700)
    except Exception:
        pass
    _I572_MISSION_LOCK = threading.RLock()
    _I572_PROTECTED_MISSIONS = {}

    def _i572_session():
        try:
            return _i570_context_session()
        except Exception:
            return {}

    def _i572_user_ref(sess=None):
        sess = sess if isinstance(sess, dict) else _i572_session()
        return _i535_user_ref(sess)

    def _i572_scope(sess=None):
        return _i535_user_hash(sess if isinstance(sess, dict) else _i572_session())

    def _i572_mission_key(mission):
        return hashlib.sha256(_i568_text(mission).casefold().encode('utf-8')).hexdigest()[:48]

    def _i572_record_path(mission, sess=None):
        return _I572_MISSION_SECRET_ROOT / _i572_scope(sess) / (_i572_mission_key(mission) + '.json')

    def _i572_store_password(mission, password, sess=None):
        mission = _i568_text(mission)
        password = str(password or '')
        sess = sess if isinstance(sess, dict) else _i572_session()
        if not mission or not password:
            return {'ok': False, 'error': 'Mission name and password are required.'}
        path = _i572_record_path(mission, sess)
        record = {
            'version': 'i572',
            'mission_hash': _i572_mission_key(mission),
            'password_encrypted': _i535_encrypt(_i572_user_ref(sess), password),
            'saved_at': datetime.now(timezone.utc).isoformat(),
        }
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(path.parent, 0o700)
        except Exception:
            pass
        _i529_atomic_write(path, json.dumps(record, separators=(',', ':')), 0o600, False)
        return {'ok': True, 'configured': True}

    def _i572_load_password(mission, sess=None):
        mission = _i568_text(mission)
        sess = sess if isinstance(sess, dict) else _i572_session()
        path = _i572_record_path(mission, sess)
        try:
            record = json.loads(path.read_text(encoding='utf-8'))
            encrypted = _i568_text(record.get('password_encrypted')) if isinstance(record, dict) else ''
            if not encrypted:
                return {'ok': False, 'configured': False, 'error': 'Mission is locked.'}
            password = _i535_decrypt(_i572_user_ref(sess), encrypted)
            if not password:
                return {'ok': False, 'configured': True, 'error': 'Stored Mission unlock is empty.'}
            return {'ok': True, 'configured': True, 'password': password}
        except FileNotFoundError:
            return {'ok': False, 'configured': False, 'error': 'Mission is locked.'}
        except Exception:
            return {'ok': False, 'configured': True, 'error': 'Stored Mission unlock could not be read.'}

    def _i572_remove_password(mission, sess=None):
        try:
            _i572_record_path(mission, sess).unlink(missing_ok=True)
        except Exception:
            pass

    def _i572_protected_cache_key(mission, sess=None):
        return (_i572_scope(sess), _i568_text(mission).casefold())

    def _i572_set_protected(mission, protected, sess=None):
        mission = _i568_text(mission)
        if not mission:
            return
        with _I572_MISSION_LOCK:
            _I572_PROTECTED_MISSIONS[_i572_protected_cache_key(mission, sess)] = {
                'mission': mission, 'protected': bool(protected), 'updated_at': time.time()
            }

    def _i572_protected_status(mission, sess=None):
        with _I572_MISSION_LOCK:
            value = _I572_PROTECTED_MISSIONS.get(_i572_protected_cache_key(mission, sess))
            return dict(value) if isinstance(value, dict) else {'mission': _i568_text(mission), 'protected': False, 'known': False}

    def _i572_creator_uid():
        try:
            creator = _i528_strict_creator()
            if isinstance(creator, dict) and creator.get('ok'):
                return _i568_text(creator.get('uid'))
        except Exception:
            pass
        return ''

    def _i572_cached_token(mission, creator_uid=''):
        mission = _i568_text(mission)
        creator_uid = _i568_text(creator_uid) or _i572_creator_uid()
        if not mission or not creator_uid:
            return ''
        identity = _i564_request_identity_key() or creator_uid
        key = (identity, mission.casefold(), creator_uid.casefold())
        with _I564_MISSION_TOKEN_LOCK:
            cached = _I564_MISSION_TOKENS.get(key)
            return _i568_text((cached or {}).get('token'))

    def _i572_unlocked(mission, sess=None):
        creator_uid = _i572_creator_uid()
        if _i572_cached_token(mission, creator_uid):
            return True
        return bool(_i572_load_password(mission, sess).get('ok'))

    _i572_mission_rows_before = _i569_mission_rows
    def _i569_mission_rows(payload):
        rows = _i572_mission_rows_before(payload)
        sess = _i572_session()
        for row in list(rows or []):
            if not isinstance(row, dict):
                continue
            mission = _i568_text(row.get('name') or row.get('mission_name') or row.get('missionName'))
            protected = bool(row.get('passwordProtected') is True or row.get('password_protected') is True)
            _i572_set_protected(mission, protected, sess)
        return rows
    globals()['_i569_mission_rows'] = _i569_mission_rows

    _i572_password_protected_before = _i569_password_protected
    def _i569_password_protected(row):
        protected = bool(_i572_password_protected_before(row))
        if not protected:
            return False
        mission = _i568_text((row or {}).get('name') or (row or {}).get('mission_name') or (row or {}).get('missionName'))
        _i572_set_protected(mission, True)
        # Once the authenticated user has successfully unlocked this protected
        # Mission, include it in the normal per-mission /cot enrichment phase.
        return not _i572_unlocked(mission)
    globals()['_i569_password_protected'] = _i569_password_protected

    def _i572_subscribe_with_password(mission, creator_uid, password, server_host=''):
        mission = _i568_text(mission)
        creator_uid = _i568_text(creator_uid)
        password = str(password or '')
        if not mission or not creator_uid:
            return {'ok': False, 'status': 400, 'error': 'Mission name and authenticated ATAK client UID are required.'}
        query = 'uid=' + quote(creator_uid, safe='')
        if password:
            query += '&password=' + quote(password, safe='')
        path = '/Marti/api/missions/' + quote(mission, safe='') + '/subscription?' + query
        # Use the raw request adapter so the password is sent only to OTS and is
        # never copied into browser-visible responses or TAK Map diagnostics.
        response = _i564_mission_request_raw(
            path, method='PUT', body=b'',
            headers={'User-Agent': _I564_ATAK_USER_AGENT, 'Content-Length': '0', 'Accept': 'application/json,*/*'},
            public_host=server_host, timeout=15)
        token = _i564_extract_subscription_token((response or {}).get('json') or {})
        status = _i564_response_status(response)
        if isinstance(response, dict) and response.get('ok') and token:
            _i564_cache_mission_token(mission, creator_uid, token, 'protected-mission-unlock-i572')
            return {'ok': True, 'status': status or 200, 'token': token, 'source': 'protected-mission-unlock-i572'}
        reason = _i564_response_reason(response, 'OpenTAKServer did not accept the Mission unlock.')
        invalid = status == 401 or 'invalid password' in reason.casefold()
        return {
            'ok': False, 'status': 401 if invalid else (status or 502),
            'invalid_password': bool(invalid),
            'mission_password_required': bool(invalid),
            'error': 'Invalid Mission password.' if invalid else reason,
        }

    _i572_mission_token_before = _i564_mission_token
    def _i564_mission_token(mission, creator_uid, server_host='', force=False):
        mission = _i568_text(mission)
        creator_uid = _i568_text(creator_uid)
        if not mission or not creator_uid:
            return {'ok': False, 'status': 400, 'error': 'Mission name and authenticated ATAK client UID are required.'}
        if not force:
            token = _i572_cached_token(mission, creator_uid)
            if token:
                return {'ok': True, 'token': token, 'source': 'cache', 'status': 200}
        status = _i572_protected_status(mission)
        protected = bool(status.get('protected'))
        stored = _i572_load_password(mission)
        if protected and not stored.get('ok'):
            return {
                'ok': False, 'status': 428, 'mission_password_required': True,
                'error': 'This OpenTAKServer Mission is password protected. Unlock it before continuing.'
            }
        if stored.get('ok'):
            result = _i572_subscribe_with_password(mission, creator_uid, stored.get('password'), server_host)
            if not result.get('ok') and result.get('invalid_password'):
                _i572_remove_password(mission)
                _i564_invalidate_mission_token(mission, creator_uid)
            return result
        return _i572_mission_token_before(mission, creator_uid, server_host, force)
    globals()['_i564_mission_token'] = _i564_mission_token

    def _i572_public_status(mission):
        mission = _i568_text(mission)
        state = _i572_protected_status(mission)
        protected = bool(state.get('protected'))
        return {
            'ok': True, 'version': 'i572', 'mission': mission,
            'protected': protected, 'known': bool(state.get('known', True) if state else False),
            'unlocked': (not protected) or _i572_unlocked(mission),
            'password_stored_server_side': protected and bool(_i572_load_password(mission).get('ok')),
        }

    def _i572_unlock_action(payload):
        payload = payload if isinstance(payload, dict) else {}
        action = _i568_text(payload.get('action') or 'unlock').lower()
        mission = _i568_text(payload.get('mission') or payload.get('mission_name'))[:180]
        if not mission:
            return {'ok': False, 'version': 'i572', 'error': 'Mission name is required.'}, 400
        creator_uid = _i572_creator_uid()
        if not creator_uid:
            return {'ok': False, 'version': 'i572', 'error': 'The authenticated per-user TAK identity is unavailable.'}, 428
        if action == 'lock':
            _i572_remove_password(mission)
            _i564_invalidate_mission_token(mission, creator_uid)
            out = _i572_public_status(mission)
            out.update({'unlocked': False, 'message': 'Mission locked for this TAK Map user.'})
            return out, 200
        password = str(payload.get('password') or '')
        if not password:
            return {'ok': False, 'version': 'i572', 'mission': mission, 'error': 'Enter the Mission password.'}, 400
        if len(password) > 512:
            return {'ok': False, 'version': 'i572', 'mission': mission, 'error': 'Mission password is too long.'}, 400
        result = _i572_subscribe_with_password(mission, creator_uid, password)
        if not result.get('ok'):
            return {
                'ok': False, 'version': 'i572', 'mission': mission,
                'invalid_password': bool(result.get('invalid_password')),
                'mission_password_required': True,
                'error': _i568_text(result.get('error')) or 'Mission unlock failed.',
            }, int(result.get('status') or 401)
        saved = _i572_store_password(mission, password)
        password = ''
        if not saved.get('ok'):
            _i564_invalidate_mission_token(mission, creator_uid)
            return {'ok': False, 'version': 'i572', 'mission': mission, 'error': 'Mission unlocked, but secure server-side storage failed.'}, 500
        _i572_set_protected(mission, True)
        try:
            cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
            sess = _i572_session()
            key = _i570_context_state_key(cfg, sess)
            _i568_schedule_refresh(key, cfg or {}, sess or {}, sess.get('_i570_token') or '', 'i572-protected-mission-unlocked', force=True)
        except Exception:
            pass
        out = _i572_public_status(mission)
        out.update({'unlocked': True, 'message': 'Mission unlocked for this TAK Map user.'})
        return out, 200

    # Stop immediately on protected-Mission authorization failure. Repeating the
    # same unauthorized /cot request cannot make a password appear.
    def _i528_confirm_readback(mission, uid, creator_uid, server_host=''):
        mission_q = quote(_i568_text(mission), safe='')
        event_uid = _i568_text(uid)
        primary_path = f'/Marti/api/missions/{mission_q}/cot'
        fallback_path = primary_path + '?creatorUid=' + quote(_i568_text(creator_uid), safe='') if _i568_text(creator_uid) else ''
        history = []
        deadline = time.monotonic() + _I570_READBACK_DEADLINE_SECONDS
        fallback_used = False
        for attempt in range(1, _I570_READBACK_ATTEMPTS + 1):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            timeout = max(1, min(3, int(remaining + 0.999)))
            result = _ots_mission_api_request(primary_path, method='GET', public_host=server_host, timeout=timeout)
            row = _i570_readback_row(result, mission, event_uid)
            status = _i564_response_status(result)
            reason = _i564_response_reason(result, '')
            history.append({'attempt': attempt, 'path': primary_path, 'strategy': 'authenticated-mission-token-no-creatorUid',
                'status': status, 'ok': bool(isinstance(result, dict) and result.get('ok')), 'exact_uid_present': bool(row),
                'error': reason[:300]})
            if row:
                _i570_cache_confirmed_row(mission, event_uid, row)
                return {'ok': True, 'source': 'mission-api-get-cot-exact-uid-i572', 'event_uid': event_uid,
                    'path': primary_path, 'attempts': history, 'readback_row_cached': True,
                    'creator_uid_filter_primary': False, 'creator_uid_fallback_used': False,
                    'mission_uid_row_alone_counts_as_readback': False}
            if status == 401 or 'invalid password' in reason.casefold():
                _i564_invalidate_mission_token(mission, creator_uid)
                return {'ok': False, 'source': 'mission-api-get-cot-exact-uid-i572', 'event_uid': event_uid,
                    'path': primary_path, 'attempts': history, 'mission_password_required': True,
                    'creator_uid_filter_primary': False, 'creator_uid_fallback_used': False,
                    'mission_uid_row_alone_counts_as_readback': False,
                    'error': 'The protected Mission must be unlocked with the correct password before read-back.'}
            if attempt == 1 and fallback_path and not bool((result or {}).get('ok')) and status in (400, 404, 405, 406, 415, 422):
                remaining = deadline - time.monotonic()
                if remaining > 0:
                    fallback_used = True
                    fallback = _ots_mission_api_request(fallback_path, method='GET', public_host=server_host,
                                                        timeout=max(1, min(3, int(remaining + 0.999))))
                    fallback_row = _i570_readback_row(fallback, mission, event_uid)
                    fallback_status = _i564_response_status(fallback)
                    fallback_reason = _i564_response_reason(fallback, '')
                    history.append({'attempt': attempt, 'path': fallback_path, 'strategy': 'compatibility-creatorUid-fallback',
                        'status': fallback_status, 'ok': bool(isinstance(fallback, dict) and fallback.get('ok')),
                        'exact_uid_present': bool(fallback_row), 'error': fallback_reason[:300]})
                    if fallback_row:
                        _i570_cache_confirmed_row(mission, event_uid, fallback_row)
                        return {'ok': True, 'source': 'mission-api-get-cot-exact-uid-i572', 'event_uid': event_uid,
                            'path': fallback_path, 'attempts': history, 'readback_row_cached': True,
                            'creator_uid_filter_primary': False, 'creator_uid_fallback_used': True,
                            'mission_uid_row_alone_counts_as_readback': False}
                    if fallback_status == 401 or 'invalid password' in fallback_reason.casefold():
                        _i564_invalidate_mission_token(mission, creator_uid)
                        return {'ok': False, 'source': 'mission-api-get-cot-exact-uid-i572', 'event_uid': event_uid,
                            'path': fallback_path, 'attempts': history, 'mission_password_required': True,
                            'creator_uid_filter_primary': False, 'creator_uid_fallback_used': True,
                            'mission_uid_row_alone_counts_as_readback': False,
                            'error': 'The protected Mission must be unlocked with the correct password before read-back.'}
            if attempt < _I570_READBACK_ATTEMPTS and deadline - time.monotonic() > 0.35:
                time.sleep(0.35)
        return {'ok': False, 'source': 'mission-api-get-cot-exact-uid-i572', 'event_uid': event_uid,
            'path': primary_path, 'attempts': history, 'creator_uid_filter_primary': False,
            'creator_uid_fallback_used': fallback_used, 'mission_uid_row_alone_counts_as_readback': False,
            'error': 'The exact point UID was not returned by Mission read-back within the bounded confirmation window. Local Data was retained.'}
    globals()['_i528_confirm_readback'] = _i528_confirm_readback

    def _i572_preflight_mission(mission):
        status = _i572_protected_status(mission)
        if not status.get('protected'):
            return {'ok': True, 'protected': False}
        creator_uid = _i572_creator_uid()
        if not creator_uid:
            return {'ok': False, 'status': 428, 'error': 'The authenticated per-user TAK identity is unavailable.'}
        token = _i564_mission_token(mission, creator_uid, force=False)
        if token.get('ok'):
            return {'ok': True, 'protected': True, 'unlocked': True}
        return {'ok': False, 'status': int(token.get('status') or 428),
            'mission_password_required': True,
            'error': _i568_text(token.get('error')) or 'Unlock the protected Mission before saving.'}

    def _i572_ingest_confirmed(publish):
        points = list((publish or {}).get('points') or []) if isinstance(publish, dict) else []
        if not points:
            return False
        for point in points:
            if not isinstance(point, dict):
                return False
            ingest = point.get('per_user_cot_ingest') if isinstance(point.get('per_user_cot_ingest'), dict) else point.get('native_mission_cot')
            if not isinstance(ingest, dict) or not bool(ingest.get('ingest_confirmed')):
                return False
        return True

    def _i572_auth_only_readback_failure(publish):
        points = list((publish or {}).get('points') or []) if isinstance(publish, dict) else []
        seen = False
        for point in points:
            readback = point.get('mission_readback') if isinstance(point, dict) and isinstance(point.get('mission_readback'), dict) else {}
            attempts = list(readback.get('attempts') or [])
            statuses = [int((row or {}).get('status') or 0) for row in attempts if isinstance(row, dict)]
            if not statuses or any(status != 401 for status in statuses):
                return False
            seen = True
        return seen

    def _i572_payload_row(payload):
        symbol = payload.get('symbol') if isinstance(payload.get('symbol'), dict) else {}
        path = _i568_text(symbol.get('iconsetpath'))
        cot_type = _i568_text(symbol.get('cot_type'))
        row = {
            'uid': _i568_text(payload.get('uid')), 'event_uid': _i568_text(payload.get('uid')),
            'cot_uid': _i568_text(payload.get('uid')), 'mission': _i568_text(payload.get('mission_name') or payload.get('mission')),
            'mission_name': _i568_text(payload.get('mission_name') or payload.get('mission')),
            'name': _i568_text(payload.get('name')) or 'TAK Map Point', 'callsign': _i568_text(payload.get('name')) or 'TAK Map Point',
            'lat': _i555_float(payload.get('lat')), 'lon': _i555_float(payload.get('lon')),
            'notes': _i568_text(payload.get('notes')), 'remarks': _i568_text(payload.get('notes')),
            'cot_type': cot_type, 'type': cot_type, 'sidc': _i568_text(symbol.get('sidc')),
            'iconsetpath': path, 'iconset_path': path, 'source': 'OTS exact-UID ingest confirmation i572',
            'kind': 'datasync', 'is_mission_object': True, 'updated': datetime.now(timezone.utc).isoformat(),
        }
        if path:
            icon = _i555_registry_load().get('by_path', {}).get(path)
            if isinstance(icon, dict):
                row['registry_icon'] = dict(icon)
        return row

    _i572_save_before = _i555_save_point
    def _i555_save_point(payload):
        payload = payload if isinstance(payload, dict) else {}
        mission = _i568_text(payload.get('mission_name') or payload.get('mission'))
        if mission:
            preflight = _i572_preflight_mission(mission)
            if not preflight.get('ok'):
                return {
                    'ok': False, 'version': 'i572', 'mission': mission,
                    'mission_password_required': bool(preflight.get('mission_password_required')),
                    'publication_attempted': False, 'redraw_allowed': False,
                    'error': _i568_text(preflight.get('error')) or 'Unlock the protected Mission before saving.',
                }, int(preflight.get('status') or 428)
        reply, status = _i572_save_before(payload)
        # Defensive truth correction for an authorization race: exact-UID OTS CoT
        # ingest is a successful publication. A later protected /cot 401 is a
        # verification/access problem and must not be mislabeled as publication failure.
        if status == 502 and isinstance(reply, dict):
            publish = reply.get('publish') if isinstance(reply.get('publish'), dict) else {}
            if _i572_ingest_confirmed(publish) and _i572_auth_only_readback_failure(publish):
                row = _i572_payload_row(payload)
                _i570_cache_confirmed_row(mission, _i568_text(payload.get('uid')), row)
                point = _i555_point_public(row)
                return {
                    'ok': True, 'version': 'i572', 'message': 'Point publication was confirmed by exact UID in OpenTAKServer.',
                    'point': point, 'publish': publish, 'redraw_allowed': True,
                    'server_ingest_confirmed': True, 'mission_readback_deferred': True,
                    'warning': 'Mission read-back could not complete because the protected Mission must be unlocked.',
                }, 200
        if status == 200 and isinstance(reply, dict) and reply.get('ok'):
            reply = dict(reply)
            reply['version'] = 'i572'
            reply['protected_mission_preflight_i572'] = True
        return reply, status
    globals()['_i555_save_point'] = _i555_save_point

    _i572_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i572_response_before(state)
        if not isinstance(payload, dict):
            return payload
        payload = _i568_clone(payload)
        missions = []
        with _I572_MISSION_LOCK:
            scope = _i572_scope()
            rows = [dict(value) for (key_scope, _key_mission), value in _I572_PROTECTED_MISSIONS.items() if key_scope == scope]
        for row in rows:
            mission = _i568_text(row.get('mission'))
            missions.append({'mission': mission, 'password_protected': bool(row.get('protected')), 'unlocked': _i572_unlocked(mission)})
        payload['version'] = 'i572'
        payload['mission_access_i572'] = missions
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i572_get_before = Handler.do_GET
    def _i572_do_get(self):
        parsed = urlparse(self.path)
        runtime = {
            '/assets/runtime/tak-map-icon-registry-i572.js': (_I572_ROOT / 'assets' / 'tak-map-icon-registry-i572.js', 'application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-popup-localdata-i572.js': (_I572_ROOT / 'assets' / 'tak-map-popup-localdata-i572.js', 'application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-context-sidebar-i572.js': (_I572_ROOT / 'assets' / 'tak-map-context-sidebar-i572.js', 'application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-data-sync-unlock-i572.js': (_I572_ROOT / 'assets' / 'tak-map-data-sync-unlock-i572.js', 'application/javascript; charset=utf-8'),
        }.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i572-protected-mission-and-custom-icon')
        if parsed.path == '/api/tak-map/data-sync-mission-unlock-i572':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            _i555_set_request_context(self)
            try:
                query = parse_qs(parsed.query or '')
                mission = _i568_text((query.get('mission') or [''])[0])
                if not mission:
                    return self._send_json({'ok': False, 'version': 'i572', 'error': 'Mission name is required.'}, 400)
                return self._send_json(_i572_public_status(mission), 200)
            finally:
                _i555_clear_request_context()
        return _i572_get_before(self)
    Handler.do_GET = _i572_do_get

    _i572_post_before = Handler.do_POST
    def _i572_do_post(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/data-sync-mission-unlock-i572':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            _i555_set_request_context(self)
            try:
                reply, status = _i572_unlock_action(_read_json_body(self))
                return self._send_json(reply, status)
            except Exception as exc:
                return self._send_json({'ok': False, 'version': 'i572', 'error': 'Mission unlock failed: ' + str(exc)}, 500)
            finally:
                _i555_clear_request_context()
        return _i572_post_before(self)
    Handler.do_POST = _i572_do_post

    _i572_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i572_config_before() or {})
