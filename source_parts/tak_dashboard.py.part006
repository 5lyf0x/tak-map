        reason = _i564_response_reason(response,'Mission content deletion failed.')
        status = _i564_response_status(response)
        token_rejected = status in (400,401,403) and not bool((response or {}).get('mission_token_refresh_attempted')) and ('token' in reason.casefold() or status in (401,403))
