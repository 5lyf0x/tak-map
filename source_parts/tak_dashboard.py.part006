    def _i564_atak_cot_xml(xml):
        text = _i555_text(xml)
        if not text:
            return text
        had_decl = text.lstrip().startswith('<?xml')
        try:
            root = ET.fromstring(text.encode('utf-8'))
            detail = root.find('detail')
            if detail is None:
                detail = ET.SubElement(root, 'detail')
