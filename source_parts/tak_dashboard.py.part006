        existing_edit = bool(isinstance(payload, dict) and _i555_text(payload.get('uid')) and _i555_text(payload.get('expected_fingerprint')))
        reset = None; uid = _i555_text((payload or {}).get('uid')) if isinstance(payload, dict) else ''
        mission = _i555_text(mission_name or ((payload or {}).get('mission_name') if isinstance(payload, dict) else ''))
        if existing_edit:
