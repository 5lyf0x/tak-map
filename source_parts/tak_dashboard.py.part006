sb-center-source-row-v491"><span>Center source</span><select id="adsbCenterSource"><option value="manual">Manual</option><option value="map_center">Map Center</option><option value="follow_map_center">Follow Map Center</option><option value="receiver">ADS-B Receiver</option></select></label><label class="adsb-center-combo-row-v491"><span>Center lat/lon</span><input id="adsbCenterLatLon" class="adsb-coord-input" type="text" inputmode="decimal" placeholder="34.000000, -118.000000"></label><input id="adsbCenterLat" type="hidden"><input id="adsbCenterLon" type="hidden"></div><div class="adsb-type-grid-v491"><label class="adsb-type-card-v491 is-checked-v491" data-type="civil" for="adsbFilterCivil"><input id="adsbFilterCivil" class="adsb-type-checkbox-v491" type="checkbox" checked><span class="adsb-type-badge-v491">CIV</span><span class="adsb-type-copy-v491"><span class="adsb-type-name-v491">Civil</span></span><span class="adsb-type-check-v491">&#10003;</span></label><label class="adsb-type-card-v491 is-checked-v491" data-type="govt" for="adsbFilterGovt"><input id="adsbFilterGovt" class="adsb-type-checkbox-v491" type="checkbox" checked><span class="adsb-type-badge-v491">GOV</span><span class="adsb-type-copy-v491"><span class="adsb-type-name-v491">Govt</span></span><span class="adsb-type-check-v491">&#10003;</span></label><label class="adsb-type-card-v491 is-checked-v491" data-type="military" for="adsbFilterMilitary"><input id="adsbFilterMilitary" class="adsb-type-checkbox-v491" type="checkbox" checked><span class="adsb-type-badge-v491">MIL</span><span class="adsb-type-copy-v491"><span class="adsb-type-name-v491">Military</span></span><span class="adsb-type-check-v491">&#10003;</span></label><label class="adsb-type-card-v491 is-checked-v491" data-type="unknown" for="adsbFilterUnknown"><input id="adsbFilterUnknown" class="adsb-type-checkbox-v491" type="checkbox" checked><span class="adsb-type-badge-v491">UNK</span><span class="adsb-type-copy-v491"><span class="adsb-type-name-v491">Unknown</span></span><span class="adsb-type-check-v491">&#10003;</span></label></div><div class="adsb-v320-actions"><button class="layer-button" type="button" onclick="useMapCenterForAdsb()">Use Map Center</button></div><div id="adsbSettingsStatus" class="muted" style="margin-top:7px"></div></div></div></div>'''

    _I520_FIRST_PAINT_STYLE = '''<style id="takMapFirstPaintI520">.top-actions{display:flex;align-items:center;gap:8px}.tak-account-v511{position:relative}.tak-account-button-v511{min-height:32px;border:1px solid #53616b;border-radius:999px;background:#18232c;color:#eef4f7;padding:0 12px;font-weight:850}.tak-account-menu-v511{display:none}.tak-card-header-v491{display:flex;align-items:center;justify-content:space-between;gap:8px}.tak-card-header-actions-v491{display:grid;grid-template-columns:max-content 40px 12px;align-items:center;gap:8px}.tak-header-switch-v491{position:relative;display:inline-flex}.tak-header-switch-v491>input{position:absolute;opacity:0;width:1px;height:1px}.tak-header-switch-button-v491{position:relative;width:40px;height:22px;border:1px solid rgba(57,217,138,.65);border-radius:999px;background:rgba(57,217,138,.18)}.tak-header-switch-knob-v491{position:absolute;top:3px;left:21px;width:14px;height:14px;border-radius:50%;background:#39d98a}.adsb-type-grid-v491{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:8px}.adsb-type-card-v491{display:grid;grid-template-columns:34px minmax(0,1fr) 17px;gap:8px;align-items:center;min-height:44px;padding:7px 9px 7px 7px;border:1px solid rgba(255,255,255,.105);border-radius:9px;background:rgba(255,255,255,.022)}.adsb-type-checkbox-v491{position:absolute;opacity:0;width:1px;height:1px}.adsb-type-badge-v491{width:34px;height:34px;display:grid;place-items:center;border:1px solid #9aa6af;border-radius:8px}.adsb-type-name-v491{font-size:.72rem;font-weight:900;text-transform:uppercase}.adsb-type-check-v491{width:17px;height:17px;display:grid;place-items:center;border-radius:5px;background:#ff6f2e;color:#111}@media(max-width:430px){.adsb-type-grid-v491{grid-template-columns:1fr}}</style>'''

    def _i523_replace_balanced_div(html, marker, replacement):
        marker_pos = html.find(marker)
        if marker_pos < 0:
            return html
        start = html.rfind('<div', 0, marker_pos + 1)
        if start < 0:
            return html
        token_re = re.compile(r'<div\b[^>]*>|</div\s*>', re.I)
        depth = 0
        end = -1
        for match in token_re.finditer(html, start):
            token = match.group(0).lower()
            if token.startswith('<div'):
                depth += 1
            else:
                depth -= 1
                if depth == 0:
                    end = match.end()
                    break
        if end < 0:
            return html
        return html[:start] + replacement + html[end:]

    def _i523_sanitize_map_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i523', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i523', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i523', html)
        html = html.replace("const V='i519'", "const V='i523'")
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i523\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i523\2', html)

        legacy_script_ids = ('v325TakClientIdentitySetup','v327TakClientPrivateKeyHelp','v328TakClientFileDetection','v330TakClientCertificateAutomation')
        for script_id in legacy_script_ids:
            html = re.sub(r'<script[^>]*id=["\']' + re.escape(script_id) + r'["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)

        html = html.replace("&&$('adsbToggleBtn')", '').replace("&&byId('adsbToggleBtn')", '')
        html = re.sub(r'if\s*\(\s*!ok\s*\)\s*\{\s*body\.innerHTML\s*=\s*menuHtml\(\)\s*\}', 'if(!ok){return}', html)
        html = re.sub(r'function\s+menuHtml\(\)\s*\{\s*return\s*`[\s\S]*?`\s*\}', "function menuHtml(){return ''}", html)
        html = html.replace("const rem=by('takClientReminder');if(rem){rem.classList.remove('active');rem.style.display='none'}", "")
        html = re.sub(r"const b=by\('takClientSetupBtn'\);if\(b\)\{[\s\S]*?\}if\(!legacyOpen", "if(!legacyOpen", html, count=1)
        html = html.replace("if(!legacyOpen&&typeof w.openTakClientSetup==='function'&&w.openTakClientSetup!==open)legacyOpen=w.openTakClientSetup;", "")
        html = html.replace("w.openTakClientSetup=open;", "")
        html = html.replace("const oldBtn=by('takClientSetupBtn');if(oldBtn)oldBtn.style.display='none';", "")
        html = html.replace("[...host.querySelectorAll('button,a')].forEach(el=>{const t=(el.textContent||'').trim();if(/^(map logout|cert setup|tak client)$/i.test(t))el.style.display='none'});", "")
        html = html.replace("['takClientModal','takClientReminder'].forEach(id=>{const el=by(id);if(el)el.remove()});", "")

        html = _i523_replace_balanced_div(html, 'class="top-actions"', _I520_ACCOUNT_HTML)
        html = _i523_replace_balanced_div(html, 'data-collapse-key="adsbSettings"', _I520_ADSB_PANEL_HTML)
        html = re.sub(r'<button[^>]*id=["\'](?:takClientSetupBtn|mapCertSetupBtn|adsbToggleBtn)["\'][^>]*>[\s\S]*?</button>', '', html, flags=re.I)
        html = re.sub(r'<button[^>]*>\s*(?:Map Logout|Cert Setup|TAK Client)\s*</button>', '', html, flags=re.I)

        if 'id="takMapFirstPaintI520"' not in html:
            html = html.replace('</head>', _I520_FIRST_PAINT_STYLE + '</head>', 1)
        html = re.sub(r'<script[^>]*id=["\']takMapLegacyUiGuardI520["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        return html

    TAK_MAP_HTML = _i523_sanitize_map_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = re.sub(r'1\.3\.0-i\d+', '1.3.0-i523', TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i523'

    _i523_config_before = tak_map_config
    def tak_map_config():
        cfg = _i523_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i523'
        cfg['version'] = '1.3.0-i523'
        ui = dict(cfg.get('interface_cleanup') or {})
        ui.update({
            'version': 'i523',
            'authoritative_first_paint': True,
            'legacy_adsb_controls_removed': True,
            'legacy_tak_client_controls_removed': True,
            'current_account_menu_only': True,
        })
        cfg['interface_cleanup'] = ui
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i523_exc:
    try: print('TAK Map i523 authoritative first-paint cleanup failed:', _i523_exc)
    except Exception: pass
# --- end TAK Map i523 authoritative first-paint interface cleanup ---


# --- TAK Map i525 integrated NRT satellite imagery basemap ---
try:
    _I525_NRT_ASSET_NAME = 'tak-map-nrt-satellite-i525.js'
    _I525_NRT_ASSET_PATH = '/assets/runtime/' + _I525_NRT_ASSET_NAME
    _I525_NRT_LOADER = '<script id="takMapNrtSatelliteLoaderI525" src="' + _I525_NRT_ASSET_PATH + '?v=1.3.0-i525" defer></script>'

    def _i525_patch_version(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i525', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i525', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i525', html)
        html = html.replace("const V='i523'", "const V='i525'")
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i525\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i525\2', html)
        return html

    def _i525_patch_map_html(html):
        html = _i525_patch_version(html)
        if not isinstance(html, str):
            return html
        html = re.sub(r'<script[^>]*id=["\']takMapNrtSatelliteLoaderI525["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        if '</body>' in html:
            html = html.replace('</body>', _I525_NRT_LOADER + '\n</body>', 1)
        else:
            html += _I525_NRT_LOADER
        return html

    TAK_MAP_HTML = _i525_patch_map_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i525_patch_version(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i525'

    _i525_get_before = Handler.do_GET
    def _i525_get(self):
        parsed = urlparse(self.path)
        if parsed.path == _I525_NRT_ASSET_PATH:
            fp = Path(__file__).resolve().parent / 'assets' / _I525_NRT_ASSET_NAME
            if not fp.exists() or not fp.is_file():
                self.send_response(404)
                self.send_header('Cache-Control', 'no-store')
                self.end_headers()
                return
            body = fp.read_bytes()
            self.send_response(200)
            self.send_header('Content-Type', 'application/javascript; charset=utf-8')
            self.send_header('Cache-Control', 'no-store, max-age=0')
            self.send_header('X-TAK-Map-Module', 'i525-nrt-satellite')
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            if getattr(self, 'command', 'GET') != 'HEAD':
                self.wfile.write(body)
            return
        return _i525_get_before(self)
    Handler.do_GET = _i525_get

    _i525_config_before = tak_map_config
    def tak_map_config():
        cfg = _i525_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i525'
        cfg['version'] = '1.3.0-i525'
        cfg['nrt_satellite_imagery'] = {
            'version': 'i525',
            'basemap_selector_option': 'nrt_satellite_imagery',
            'dedicated_sidebar_card': True,
            'visible_only_when_selected': True,
            'fallback_basemap_preserved': True,
            'side_by_side_date_comparison': True,
            'draggable_divider': True,
            'sidebar_divider_slider': False,
            'divider_design': 'beveled_rail_rounded_clamp',
            'opacity_slider_matches_usgs_relief': True,
            'comparison_labels_lowered': True,
            'toolbar_aware_newer_label': True,
            'newer_label_avoidance_direction': 'left_only',
            'sources': [
                'landsat_esri',
                'viirs_noaa21',
                'viirs_noaa20',
                'viirs_snpp',
            ],
            'landsat_scene_locking': True,
            'landsat_cloud_filter': True,
            'nasa_gibs_daily_dates': True,
            'imagery_pane_z_indexes': [230, 231],
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i525_exc:
    try: print('TAK Map i525 NRT satellite imagery integration failed:', _i525_exc)
    except Exception: pass
# --- end TAK Map i525 integrated NRT satellite imagery basemap ---


# --- TAK Map i526 native OpenTAKServer mission point publishing and header cleanup ---
try:
    import re as _i526_re

    def _i526_text(value):
        return str(value or '').strip()

    def _i526_props(feature):
        feature = feature if isinstance(feature, dict) else {}
        props = feature.get('properties')
        return props if isinstance(props, dict) else {}

    def _i526_value(feature, *keys):
        props = _i526_props(feature)
        for key in keys:
            value = feature.get(key) if isinstance(feature, dict) else None
            if value in (None, ''):
                value = props.get(key)
            if value not in (None, ''):
                return value
        return ''

    def _i526_point_coordinate(feature):
        feature = feature if isinstance(feature, dict) else {}
        # Existing Local Data records use lat/lon or coords in [lat, lon] order.
        try:
            points = _local_data_feature_points(feature) or []
        except Exception:
            points = []
        if len(points) == 1:
            altitude = _coerce_float(_i526_value(feature, 'hae', 'alt', 'altitude', 'elevation'))
            return {'ok': True, 'lat': float(points[0][0]), 'lon': float(points[0][1]), 'altitude': altitude}

        # Browser-created/imported GeoJSON uses coordinates in [lon, lat, optional altitude] order.
        geometry = feature.get('geometry') if isinstance(feature.get('geometry'), dict) else {}
        geometry_type = _i526_text(geometry.get('type')).lower()
        coordinates = geometry.get('coordinates')
        if geometry_type == 'point' and isinstance(coordinates, (list, tuple)) and len(coordinates) >= 2:
            lon = _coerce_float(coordinates[0])
            lat = _coerce_float(coordinates[1])
            altitude = _coerce_float(coordinates[2]) if len(coordinates) > 2 else None
            if altitude is None:
                altitude = _coerce_float(_i526_value(feature, 'hae', 'alt', 'altitude', 'elevation'))
            if lat is not None and lon is not None and -90 <= lat <= 90 and -180 <= lon <= 180:
                return {'ok': True, 'lat': float(lat), 'lon': float(lon), 'altitude': altitude}

        lat = _coerce_float(_i526_value(feature, 'lat', 'latitude'))
        lon = _coerce_float(_i526_value(feature, 'lon', 'lng', 'longitude'))
        altitude = _coerce_float(_i526_value(feature, 'hae', 'alt', 'altitude', 'elevation'))
        if lat is not None and lon is not None and -90 <= lat <= 90 and -180 <= lon <= 180:
            return {'ok': True, 'lat': float(lat), 'lon': float(lon), 'altitude': altitude}
        return {'ok': False, 'error': 'Native mission point requires exactly one valid coordinate.'}

    def _i526_point_features(features, kind=''):
        rows = list(features or [])
        if not rows:
            return []
        requested = _i526_text(kind).lower()
        if requested in ('route', 'routes', 'shape', 'shapes'):
            return []
        out = []
        for feature in rows:
            try:
                actual = _local_data_feature_kind(feature)
            except Exception:
                actual = ''
            geometry = feature.get('geometry') if isinstance(feature, dict) and isinstance(feature.get('geometry'), dict) else {}
            if _i526_text(geometry.get('type')).lower() == 'point':
                actual = 'point'
            coordinate = _i526_point_coordinate(feature)
            if actual != 'point' or not coordinate.get('ok'):
                return []
            out.append(feature)
        return out

    def _i526_original_point_id(feature):
        for key in ('canonical_id', 'object_id', 'source_id', 'local_id', '_local_id', 'uid', 'cot_uid', 'event_uid', 'id'):
            value = _i526_text(_i526_value(feature, key))
            if value:
                return value[:220]
        coordinate = _i526_point_coordinate(feature)
        lat = coordinate.get('lat', 0) if coordinate.get('ok') else 0
        lon = coordinate.get('lon', 0) if coordinate.get('ok') else 0
        name = _v331_name_from_feature(feature, 'Point') if callable(globals().get('_v331_name_from_feature')) else 'Point'
        return json.dumps({'name': name, 'lat': round(float(lat), 7), 'lon': round(float(lon), 7)}, sort_keys=True)

    def _i526_native_point_uid(feature):
        existing = _i526_original_point_id(feature)
        if existing.upper().startswith('TAKMAP-MISSION-POINT-'):
            return existing[:160]
        digest = hashlib.sha256(existing.encode('utf-8', 'ignore')).hexdigest()[:28]
        return 'TAKMAP-MISSION-POINT-' + digest

    def _i526_point_type(feature):
        # Prefer the symbol/type explicitly selected in TAK Map. Older helpers can
        # normalize it when no explicit CoT type is present.
        value = _i526_text(_i526_value(feature, 'cot_type', 'atak_cot_type', 'cotType', 'event_type'))
        if not value:
            try:
                value = _v396_cot_type_for_point(feature) if callable(globals().get('_v396_cot_type_for_point')) else ''
            except Exception:
                value = ''
        value = _i526_text(value)
        if value and _i526_re.match(r'^[a-z]-', value, _i526_re.I):
            return value[:96]
        return 'a-f-G-U-C'

    def _i526_point_xml(feature, mission_name, creator_uid=''):
        coordinate = _i526_point_coordinate(feature)
        if not coordinate.get('ok'):
            return coordinate
        lat = float(coordinate['lat'])
        lon = float(coordinate['lon'])
        uid = _i526_native_point_uid(feature)
        name = (_v331_name_from_feature(feature, 'Point') if callable(globals().get('_v331_name_from_feature')) else 'Point')[:120]
        cot_type = _i526_point_type(feature)
        now = datetime.now(timezone.utc)
        stale = now + timedelta(days=3650)
        altitude = coordinate.get('altitude')
        if altitude is None:
            altitude = _coerce_float(_i526_value(feature, 'hae', 'alt', 'altitude', 'elevation'))
        if altitude is None:
            altitude = 0.0
        event = ET.Element('event', {
            'version': '2.0', 'uid': uid, 'type': cot_type, 'how': 'h-e',
            'time': _cot_time(now), 'start': _cot_time(now), 'stale': _cot_time(stale),
            'access': 'Undefined'
        })
        ET.SubElement(event, 'point', {
            'lat': f'{lat:.7f}', 'lon': f'{lon:.7f}', 'hae': f'{float(altitude):.3f}',
            'ce': '9999999.0', 'le': '9999999.0'
        })
        detail = ET.SubElement(event, 'detail')
        ET.SubElement(detail, 'contact', {'callsign': name})
        ET.SubElement(detail, 'archive')
        ET.SubElement(detail, 'precisionlocation', {'geopointsrc': 'TAK Map', 'altsrc': 'TAK Map'})
        ET.SubElement(detail, 'link', {'uid': _i526_text(mission_name), 'type': 'b-f-t-r', 'relation': 'p-m'})
        source_uid = _i526_original_point_id(feature)
        metadata = {
            'version': 'i526', 'mode': 'native-mission-cot', 'sourceUid': source_uid,
            'creatorUid': _i526_text(creator_uid), 'mission': _i526_text(mission_name)
        }
        sidc = _i526_text(_i526_value(feature, 'sidc', 'mil2525_sidc', 'symbol_id', 'symbolId'))
        if sidc:
            metadata['sidc'] = sidc[:120]
        icon_path = _i526_text(_i526_value(feature, 'iconset_path', 'iconsetpath', 'usericon_path', 'user_icon_path', 'icon_path'))
        if icon_path:
            ET.SubElement(detail, 'usericon', {'iconsetpath': icon_path[:512]})
            metadata['iconsetPath'] = icon_path[:512]
        color = _i526_text(_i526_value(feature, 'color', 'marker_color', 'argb', 'stroke_color'))
        if color:
            ET.SubElement(detail, 'color', {'argb': color[:32]})
            metadata['color'] = color[:32]
        ET.SubElement(detail, 'takmap_point', metadata)
        remarks = _v331_remarks_from_feature(feature) if callable(globals().get('_v331_remarks_from_feature')) else ''
        if remarks:
            ET.SubElement(detail, 'remarks').text = remarks[:3000]
        xml = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)
        return {
            'ok': True, 'uid': uid, 'source_uid': source_uid, 'name': name,
            'cot_type': cot_type, 'lat': lat, 'lon': lon, 'xml': xml,
            'iconset_path': icon_path, 'sidc': sidc, 'color': color
        }

    def _i526_creators(preferred_uid=''):
        try:
            fn = globals().get('_v337_candidate_creators') or globals().get('_v336_mission_api_candidate_creators')
            rows = list(fn(preferred_uid) or []) if callable(fn) else []
        except Exception:
            rows = []
        if not rows:
            choice = _mission_publish_creator_uid(preferred_uid)
            if choice.get('uid'):
                rows = [{'uid': choice.get('uid'), 'source': choice.get('source') or 'mission-creator'}]
        return rows

    def _i526_create_mission(mission, creator_uid, server_host=''):
        try:
            fn = globals().get('_v337_create_or_get_mission')
            if callable(fn):
                return fn(mission, creator_uid, server_host)
        except Exception as exc:
            return {'ok': False, 'error': str(exc)}
        path = '/Marti/api/missions/' + quote(mission, safe='') + '?creatorUid=' + quote(creator_uid, safe='') + '&tool=public&defaultRole=MISSION_SUBSCRIBER'
        return _ots_mission_api_request(path, method='PUT', body=b'', headers={'Content-Length': '0'}, public_host=server_host, timeout=20)

    def _i526_send_native_mission_cot(mission, creator_uid, xml, server_host=''):
        body = xml.encode('utf-8')
        attempts = []
        mission_q = quote(mission, safe='')
        creator_q = quote(creator_uid, safe='')
        for method in ('POST', 'PUT'):
            for suffix in ('', '&tool=public'):
                path = f'/Marti/api/missions/{mission_q}/cot?creatorUid={creator_q}{suffix}'
                result = _ots_mission_api_request(
                    path, method=method, body=body,
                    headers={'Content-Type': 'application/xml; charset=UTF-8', 'Content-Length': str(len(body))},
                    public_host=server_host, timeout=25
                )
                record = dict(result or {})
                record.update({'method': method, 'path': path})
                attempts.append(record)
                if record.get('ok'):
                    record['attempts'] = attempts
                    return record
        return {'ok': False, 'error': 'All native Mission CoT endpoint attempts failed.', 'attempts': attempts}

    def _i526_associate_uid(mission, creator_uid, uid, token='', server_host=''):
        fn = globals().get('_v339_associate_uid_to_mission')
        if callable(fn):
            try:
                return fn(mission, creator_uid, uid, token, server_host)
            except Exception as exc:
                return {'ok': False, 'error': str(exc), 'event_uid': uid}
        body = json.dumps({'uids': [uid]}).encode('utf-8')
        path = '/Marti/api/missions/' + quote(mission, safe='') + '/contents?creatorUid=' + quote(creator_uid, safe='')
        return _ots_mission_api_request(
            path, method='PUT', body=body,
            headers={'Content-Type': 'application/json', 'Content-Length': str(len(body))},
            token=token, public_host=server_host, timeout=25
        )

    def tak_map_publish_native_points_to_mission_i526(features, mission_name='', server_host='', preferred_creator_uid=''):
        mission = _i526_text(mission_name) or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME', 'TAK Map Mission').strip() or 'TAK Map Mission'
        point_features = _i526_point_features(features, 'points')
        if not point_features:
            return {'ok': False, 'error': 'No publishable point-only Local Data selection was found.', 'publish_mode': 'native-mission-cot-i526'}
        preferred = preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        creators = _i526_creators(preferred)
        creator_attempts = []
        selected = None
        for candidate in creators:
            creator_uid = _i526_text(candidate.get('uid'))
            if not creator_uid:
                continue
            create = _i526_create_mission(mission, creator_uid, server_host)
            token = _extract_mission_token(create.get('json') or {})
            point_results = []
            all_ok = True
            for feature in point_features:
                built = _i526_point_xml(feature, mission, creator_uid)
                if not built.get('ok'):
                    point_results.append(built)
                    all_ok = False
                    continue
                native = _i526_send_native_mission_cot(mission, creator_uid, built['xml'], server_host)
                association = {'ok': False, 'error': 'Native Mission CoT request failed; UID association was not attempted.'}
                fallback = {'ok': False, 'skipped': True}
                if native.get('ok'):
                    association = _i526_associate_uid(mission, creator_uid, built['uid'], token, server_host)
                    # OTS versions that associate within /cot may reject a duplicate /contents call.
                    server_confirmed = True
                else:
                    try:
                        fallback = _send_cot_to_ots(built['xml']) if callable(globals().get('_send_cot_to_ots')) else {'ok': False, 'error': 'CoT fallback unavailable.'}
                    except Exception as exc:
                        fallback = {'ok': False, 'error': str(exc)}
                    if fallback.get('ok'):
                        association = _i526_associate_uid(mission, creator_uid, built['uid'], token, server_host)
                    server_confirmed = bool(fallback.get('ok') and association.get('ok'))
                item_ok = bool(server_confirmed)
                point_results.append({
                    **{key: built.get(key) for key in ('uid', 'source_uid', 'name', 'cot_type', 'lat', 'lon', 'iconset_path', 'sidc', 'color')},
                    'ok': item_ok, 'native_mission_cot': native, 'associate_uid': association,
                    'live_cot_fallback': fallback, 'server_confirmed': server_confirmed,
                    'xml_preview': built['xml'][:4000]
                })
                all_ok = all_ok and item_ok
            record = {
                'creator_uid': creator_uid, 'source': candidate.get('source'), 'create_mission': create,
                'points': point_results, 'ok': bool(all_ok and len(point_results) == len(point_features))
            }
            creator_attempts.append(record)
            if record['ok']:
                selected = record
                break
        chosen = selected or (creator_attempts[-1] if creator_attempts else {})
        ok = bool(selected)
        event_uids = [row.get('uid') for row in (chosen.get('points') or []) if row.get('uid')]
        source_uids = [row.get('source_uid') for row in (chosen.get('points') or []) if row.get('source_uid')]
        out = {
            'ok': ok, 'mission': mission, 'publish_mode': 'native-mission-cot-i526',
            'content_kind': 'local-data-point-native-cot', 'point_count': len(point_features),
            'creator_uid': chosen.get('creator_uid') or '', 'creator_attempts': creator_attempts,
            'create_mission': chosen.get('create_mission') or {}, 'points': chosen.get('points') or [],
            'event_uids': event_uids, 'source_uids': source_uids,
            'zip_package_created': False, 'zip_upload_skipped': True,
            'non_package_publish': True, 'native_mission_object': True,
            'message': '', 'error': ''
        }
        if ok:
            count = len(point_features)
            prefix = 'Published native point to Data Sync Mission: ' if count == 1 else f'Published {count} native points to Data Sync Mission: '
            out['message'] = prefix + mission + '.'
            out['user_message'] = out['message']
            out['publish_succeeded'] = True
            out['disable_publish_after_success'] = True
            out['close_publish_modal_after_success'] = True
            out['data_sync_refresh_recommended'] = True
            out['canonical_reconcile'] = {'source_uids': source_uids, 'mission_uids': event_uids, 'mode': 'local-to-datasync-after-readback'}
        else:
            failures = []
            for row in chosen.get('points') or []:
                if not row.get('ok'):
                    native = row.get('native_mission_cot') or {}
                    assoc = row.get('associate_uid') or {}
                    failures.append((row.get('name') or 'point') + ': ' + _i526_text(native.get('error') or assoc.get('error') or 'server did not confirm native mission publish'))
            out['error'] = 'Native Mission point publish failed: ' + ('; '.join(failures) or 'no creator/endpoint attempt succeeded')
        try:
            xml_diag = '\n\n'.join(row.get('xml_preview') or '' for row in (chosen.get('points') or []))
            diag = _write_send_diag('native-mission-point-publish-i526', out, xml_diag or None)
            if isinstance(diag, dict):
                out['diag_paths'] = diag
        except Exception:
            pass
        return out

    _i526_previous_local_publish = globals().get('tak_map_local_data_mission_publish')

    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features = _selected_local_data_features(ids)
        if not features:
            return {'ok': False, 'error': 'No selected Local Data items were found.'}
        points = _i526_point_features(features, kind)
        if points and len(points) == len(features):
            preferred = _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap'
            return tak_map_publish_native_points_to_mission_i526(points, mission_name, server_host, preferred)
        if callable(_i526_previous_local_publish):
            return _i526_previous_local_publish(ids, kind, mission_name, server_host)
        return {'ok': False, 'error': 'Local Data mission publish fallback is unavailable.'}

    globals()['tak_map_local_data_mission_publish'] = tak_map_local_data_mission_publish

    def tak_map_publish_point_uids_to_mission_v340(features, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_native_points_to_mission_i526(features, mission_name, server_host, preferred_creator_uid)

    globals()['tak_map_publish_point_uids_to_mission_v340'] = tak_map_publish_point_uids_to_mission_v340

    def tak_map_publish_point_uid_to_mission_v339(feature, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_native_points_to_mission_i526([feature], mission_name, server_host, preferred_creator_uid)

    globals()['tak_map_publish_point_uid_to_mission_v339'] = tak_map_publish_point_uid_to_mission_v339

    def tak_map_publish_cot_to_mission(feature, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_native_points_to_mission_i526([feature], mission_name, server_host, preferred_creator_uid)

    globals()['tak_map_publish_cot_to_mission'] = tak_map_publish_cot_to_mission

    _I526_HEADER_RUNTIME = r'''<script id="takMapNativeDataSyncI526">
(function(w,d){'use strict';
  const V='i526',by=id=>d.getElementById(id);
  function removeDashboard(){
    try{d.querySelectorAll('.top-actions a,.top-actions button').forEach(function(el){const t=String(el.textContent||'').trim();const href=String(el.getAttribute('href')||'');if(/^dashboard$/i.test(t)||(href==='/'&&/dashboard/i.test(t))){el.remove()}})}catch(_){}
  }
  function bindAccount(){
    try{const btn=by('takMapAccountBtnV511'),menu=by('takMapAccountMenuV511');if(!btn||!menu)return false;if(!btn.dataset.i526Bound){btn.dataset.i526Bound='1';btn.addEventListener('click',function(ev){ev.preventDefault();ev.stopImmediatePropagation();menu.classList.toggle('open')},true);btn.addEventListener('pointerdown',function(ev){ev.stopImmediatePropagation()},true)}return true}catch(_){return false}
  }
  function boot(){removeDashboard();bindAccount();try{const mo=new MutationObserver(function(){removeDashboard();bindAccount()});mo.observe(d.documentElement,{childList:true,subtree:true})}catch(_){}[100,350,900,1800,3500,7000].forEach(ms=>setTimeout(function(){removeDashboard();bindAccount()},ms));}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
  w.TakMapDataSyncI526=Object.freeze({version:V,removeDashboard,bindAccount,diagnostics:function(){return {version:V,dashboardControls:Array.from(d.querySelectorAll('.top-actions a,.top-actions button')).filter(x=>/dashboard/i.test(x.textContent||'')).length,accountButton:!!by('takMapAccountBtnV511'),accountBound:!!(by('takMapAccountBtnV511')&&by('takMapAccountBtnV511').dataset.i526Bound),readyState:d.readyState}}});
})(window,document);
</script>'''

    def _i526_version_html(html):
        if not isinstance(html, str):
            return html
        html = _i526_re.sub(r'1\.3\.0-i\d+', '1.3.0-i526', html)
        html = _i526_re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i526', html)
        html = _i526_re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i526', html)
        html = html.replace("const V='i525'", "const V='i526'")
        html = _i526_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i526\2', html)
        html = _i526_re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i526\2', html)
        return html

    def _i526_patch_map_html(html):
        html = _i526_version_html(html)
        if not isinstance(html, str):
            return html
        html = _i526_re.sub(r'<a\b[^>]*href=["\']/["\'][^>]*>\s*Dashboard\s*</a>\s*', '', html, flags=_i526_re.I)
        html = _i526_re.sub(r'<button\b[^>]*>\s*Dashboard\s*</button>\s*', '', html, flags=_i526_re.I)
        html = _i526_re.sub(r'<script[^>]*id=["\']takMapNativeDataSyncI526["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=_i526_re.I)
        html = html.replace('</body>', _I526_HEADER_RUNTIME + '\n</body>', 1) if '</body>' in html else html + _I526_HEADER_RUNTIME
        return html

    TAK_MAP_HTML = _i526_patch_map_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i526_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i526'

    _i526_config_before = tak_map_config

    def tak_map_config():
        cfg = _i526_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i526'
        cfg['version'] = '1.3.0-i526'
        cfg['data_sync_native_point_publish'] = {
            'version': 'i526', 'publish_mode': 'native-mission-cot',
            'zip_for_points': False, 'stable_mission_uid': True,
            'mission_uid_association': True, 'server_confirmation_required': True,
            'local_to_datasync_reconcile': 'after-readback',
            'preserved_metadata': ['callsign', 'coordinates', 'altitude', 'cot_type', 'sidc', 'iconset_path', 'remarks', 'color', 'creator_uid']
        }
        ui = dict(cfg.get('interface_cleanup') or {})
        ui.update({'version': 'i526', 'legacy_dashboard_button_removed': True, 'preexisting_account_button_binding_fixed': True})
        cfg['interface_cleanup'] = ui
        return cfg

    globals()['tak_map_config'] = tak_map_config

    if 'tak_map_data_sync' in globals():
        _i526_data_sync_before = tak_map_data_sync

        def tak_map_data_sync():
            out = _i526_data_sync_before()
            if isinstance(out, dict):
                out['point_publish_policy_i526'] = {
                    'version': 'i526', 'mode': 'native-mission-cot', 'zip_packages_for_points': False,
                    'stable_uid_namespace': 'TAKMAP-MISSION-POINT', 'explicit_mission_uid_association': True,
                    'note': 'Ordinary TAK Map points are published as native mission-associated CoT objects. ZIP packages remain reserved for actual files/data packages.'
                }
            return out

        globals()['tak_map_data_sync'] = tak_map_data_sync
except Exception as _i526_exc:
    try:
        print('TAK Map i526 native Data Sync point patch failed:', _i526_exc)
    except Exception:
        pass
# --- end TAK Map i526 native OpenTAKServer mission point publishing and header cleanup ---


# --- TAK Map i527 exact MIL-STD point symbol propagation to OTS/Data Sync/ATAK ---
try:
    _i527_re = re

    def _i527_normalize_sidc(value):
        raw = _i526_text(value).upper().strip()
        raw = _i527_re.sub(r'[^A-Z0-9-]', '', raw)
        if len(raw) < 5 or raw[0] != 'S':
            return ''
        return (raw + '---------------')[:15]

    _I527_MIL_NAME_TO_SIDC = {}
    try:
        _i527_icons_path = Path(__file__).resolve().parent / 'assets' / 'mil2525' / 'icons.json'
        _i527_icons = json.loads(_i527_icons_path.read_text(encoding='utf-8')) if _i527_icons_path.exists() else []
        for _i527_icon in _i527_icons if isinstance(_i527_icons, list) else []:
            if not isinstance(_i527_icon, dict):
                continue
            _i527_name = _i526_text(_i527_icon.get('name')).lower().removesuffix('.svg')
            _i527_sidc = _i527_normalize_sidc(_i527_icon.get('sidc'))
            if _i527_name and _i527_sidc:
                _I527_MIL_NAME_TO_SIDC[_i527_name] = _i527_sidc
    except Exception:
        _I527_MIL_NAME_TO_SIDC = {}

    def _i527_selected_sidc(feature):
        # Point Dropper stores the selected icons.json SIDC in properties.sidc.
        # Keep aliases for imported/legacy Local Data and recover by exact icon name
        # when an older record omitted the SIDC field.
        for key in ('sidc', 'SIDC', 'mil2525_sidc', 'symbol_id', 'symbolId', 'symbol_code', 'symbolCode'):
            sidc = _i527_normalize_sidc(_i526_value(feature, key))
            if sidc:
                return sidc
        for key in ('mil2525_name', 'milstd2525_name', 'mil2525_file', 'mil2525_svg'):
            name = _i526_text(_i526_value(feature, key)).lower().strip()
            name = name.rsplit('/', 1)[-1].rsplit('\\', 1)[-1].removesuffix('.svg')
            if name in _I527_MIL_NAME_TO_SIDC:
                return _I527_MIL_NAME_TO_SIDC[name]
        return ''

    def _i527_cot_type_from_sidc(value):
        # This is the inverse of TAK Map's established cotTypeToSidc renderer:
        #   a-f-G-U-C-A <-> SFGPUCA--------
        sidc = _i527_normalize_sidc(value)
        if not sidc:
            return ''
        affiliation = {'F': 'f', 'H': 'h', 'N': 'n', 'U': 'u'}.get(sidc[1])
        dimension = {'G': 'G', 'A': 'A', 'S': 'S', 'U': 'U', 'P': 'P'}.get(sidc[2])
        if not affiliation or not dimension:
            return ''
        function_id = _i527_re.sub(r'[^A-Z0-9]', '', sidc[4:15])
        if not function_id:
            return f'a-{affiliation}-{dimension}'
        return 'a-' + affiliation + '-' + dimension + '-' + '-'.join(function_id)

    _i527_point_type_before = _i526_point_type

    def _i526_point_type(feature):
        # The selected MIL-STD SIDC is the authoritative symbol. Derive the native
        # CoT hierarchy from it before considering a generic or stale cot_type.
        sidc = _i527_selected_sidc(feature)
        derived = _i527_cot_type_from_sidc(sidc)
        if derived:
            return derived[:96]
        return _i527_point_type_before(feature)

    globals()['_i526_point_type'] = _i526_point_type

    _i527_point_xml_before = _i526_point_xml

    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i527_point_xml_before(feature, mission_name, creator_uid)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        sidc = _i527_selected_sidc(feature)
        exact_name = _i526_text(_i526_value(feature, 'mil2525_name', 'milstd2525_name', 'mil2525_file', 'mil2525_svg'))
        exact_name = exact_name.rsplit('/', 1)[-1].rsplit('\\', 1)[-1].removesuffix('.svg')
        exact_label = _i526_text(_i526_value(feature, 'mil2525_label', 'symbol_label', 'label'))
        try:
            root = ET.fromstring(built.get('xml') or '')
            detail = root.find('detail')
            if detail is not None:
                meta = detail.find('takmap_point')
                if meta is None:
                    meta = ET.SubElement(detail, 'takmap_point')
                meta.set('version', 'i527')
                meta.set('symbolMode', 'milstd2525c-exact')
                if sidc:
                    meta.set('sidc', sidc)
                if exact_name:
                    meta.set('mil2525Name', exact_name[:180])
                if exact_label:
                    meta.set('mil2525Label', exact_label[:120])
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
        except Exception:
            pass
        built['sidc'] = sidc or built.get('sidc') or ''
        built['mil2525_name'] = exact_name
        built['mil2525_label'] = exact_label
        built['symbol_mapping_version'] = 'i527'
        built['symbol_mapping_source'] = 'selected-sidc' if sidc else 'cot-type-fallback'
        return built

    globals()['_i526_point_xml'] = _i526_point_xml

    # Preserve the public i526 publisher function names for compatibility while
    # accurately exposing the new symbol-mapping revision in results/diagnostics.
    _i527_publish_before = tak_map_publish_native_points_to_mission_i526

    def tak_map_publish_native_points_to_mission_i526(features, mission_name='', server_host='', preferred_creator_uid=''):
        out = _i527_publish_before(features, mission_name, server_host, preferred_creator_uid)
        if isinstance(out, dict):
            out['publish_mode'] = 'native-mission-cot-i527'
            out['symbol_mapping'] = {
                'version': 'i527',
                'mode': 'selected-mil2525-sidc-to-native-cot-type',
                'generic_combat_fallback_avoided': True,
            }
            for row in out.get('points') or []:
                if isinstance(row, dict):
                    row['symbol_mapping_version'] = 'i527'
        return out

    globals()['tak_map_publish_native_points_to_mission_i526'] = tak_map_publish_native_points_to_mission_i526

    # Rebind compatibility entry points so all point publication paths use the
    # i527 wrapper rather than retaining a reference to the pre-patch function.
    def tak_map_publish_point_uids_to_mission_v340(features, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_native_points_to_mission_i526(features, mission_name, server_host, preferred_creator_uid)

    def tak_map_publish_point_uid_to_mission_v339(feature, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_native_points_to_mission_i526([feature], mission_name, server_host, preferred_creator_uid)

    def tak_map_publish_cot_to_mission(feature, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_native_points_to_mission_i526([feature], mission_name, server_host, preferred_creator_uid)

    globals()['tak_map_publish_point_uids_to_mission_v340'] = tak_map_publish_point_uids_to_mission_v340
    globals()['tak_map_publish_point_uid_to_mission_v339'] = tak_map_publish_point_uid_to_mission_v339
    globals()['tak_map_publish_cot_to_mission'] = tak_map_publish_cot_to_mission

    def _i527_version_html(html):
        if not isinstance(html, str):
            return html
        html = _i527_re.sub(r'1\.3\.0-i\d+', '1.3.0-i527', html)
        html = _i527_re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i527', html)
        html = _i527_re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i527', html)
        html = _i527_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i527\2', html)
        html = _i527_re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i527\2', html)
        return html

    TAK_MAP_HTML = _i527_version_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i527_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i527'

    _i527_config_before = tak_map_config

    def tak_map_config():
        cfg = _i527_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i527'
        cfg['version'] = '1.3.0-i527'
        native = dict(cfg.get('data_sync_native_point_publish') or {})
        native.update({
            'version': 'i527',
            'exact_mil2525_symbol_mapping': True,
            'symbol_source_precedence': ['selected_sidc', 'exact_mil2525_name', 'explicit_cot_type', 'generic_fallback'],
            'sidc_to_cot_type': True,
        })
        cfg['data_sync_native_point_publish'] = native
        return cfg

    globals()['tak_map_config'] = tak_map_config

    if 'tak_map_data_sync' in globals():
        _i527_data_sync_before = tak_map_data_sync

        def tak_map_data_sync():
            out = _i527_data_sync_before()
            if isinstance(out, dict):
                out['point_symbol_policy_i527'] = {
                    'version': 'i527',
                    'mode': 'exact-selected-mil2525-symbol',
                    'sidc_to_native_cot_type': True,
                    'example': {'sidc': 'SFGPUCA--------', 'cot_type': 'a-f-G-U-C-A'},
                    'note': 'The Point Dropper SIDC now determines the native CoT type used by OpenTAKServer, Data Sync, and ATAK.'
                }
            return out

        globals()['tak_map_data_sync'] = tak_map_data_sync
except Exception as _i527_exc:
    try:
        print('TAK Map i527 exact point symbol patch failed:', _i527_exc)
    except Exception:
        pass
# --- end TAK Map i527 exact MIL-STD point symbol propagation ---

# --- TAK Map i528 native mission-point ownership, reconciliation, and EUD isolation ---
try:
    _i528_re = re
    _I528_MISSION_POINT_PREFIX = 'TAKMAP-MISSION-POINT-'
    _I528_POINT_CACHE_LOCK = threading.RLock()
    _I528_POINT_CACHE = {'time': 0.0, 'uids': set(), 'names': set()}

    def _i528_identity():
        try:
            identity = _i512_current_identity() if callable(globals().get('_i512_current_identity')) else {}
        except Exception:
            identity = {}
        identity = identity if isinstance(identity, dict) else {}
        return {
            'tak_uid': _i526_text(identity.get('tak_uid')),
            'callsign': _i526_text(identity.get('callsign')),
            'username': _i526_text(identity.get('username')),
        }

    _i528_point_xml_before = _i526_point_xml

    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i528_point_xml_before(feature, mission_name, creator_uid)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        identity = _i528_identity()
        effective_uid = identity.get('tak_uid') or _i526_text(creator_uid)
        try:
            root = ET.fromstring(built.get('xml') or '')
            detail = root.find('detail')
            if detail is None:
                detail = ET.SubElement(root, 'detail')
            # OTS treats creatorUid as the transport author. Keep the user identity
            # explicit while the event UID remains the map object's stable identity.
            creator = detail.find('creator')
            if creator is None:
                creator = ET.SubElement(detail, 'creator')
            if effective_uid:
                creator.set('uid', effective_uid[:180])
            if identity.get('callsign'):
                creator.set('callsign', identity['callsign'][:120])
            if identity.get('username'):
                creator.set('username', identity['username'][:120])
            creator.set('time', _cot_time(datetime.now(timezone.utc)))
            creator.set('type', creator.get('type') or 'a-f-G-U-C-R-V-G')

            # Explicit Mission API membership marker. The link is retained for TAK
            # clients, while dest gives OTS a direct mission association signal.
            mission = _i526_text(mission_name)
            dest = detail.find('dest')
            if dest is None:
                dest = ET.SubElement(detail, 'dest')
            dest.set('mission', mission[:180])

            meta = detail.find('takmap_point')
            if meta is None:
                meta = ET.SubElement(detail, 'takmap_point')
            meta.set('version', 'i528')
            meta.set('ownershipMode', 'authenticated-user-mission-object')
            meta.set('eudPresence', 'false')
            meta.set('canonicalSource', 'datasync')
            if effective_uid:
                meta.set('authorUid', effective_uid[:180])
            if identity.get('callsign'):
                meta.set('authorCallsign', identity['callsign'][:120])
            if identity.get('username'):
                meta.set('authorUsername', identity['username'][:120])

            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
        except Exception as exc:
            built['i528_identity_xml_warning'] = str(exc)
        built['creator_uid'] = effective_uid
        built['authenticated_user'] = identity
        built['eud_presence'] = False
        built['canonical_source'] = 'datasync'
        return built

    globals()['_i526_point_xml'] = _i526_point_xml

    def _i528_strict_creator():
        identity = _i528_identity()
        uid = identity.get('tak_uid')
        if not uid:
            return {'ok': False, 'error': 'The authenticated OpenTAKServer account does not expose a stable TAK UID. Native mission publication was not attempted because a service/EUD fallback would misattribute the point.', 'identity': identity}
        return {'ok': True, 'uid': uid, 'source': 'authenticated-ots-user-i528', 'identity': identity}

    def _i528_blob_contains_uid(value, uid):
        needle = _i526_text(uid).lower()
        if not needle:
            return False
        try:
            if isinstance(value, (dict, list, tuple)):
                return needle in json.dumps(value, default=str).lower()
            return needle in _i526_text(value).lower()
        except Exception:
            return False

    def _i528_pg_readback(mission, uid):
        mission_lc = _i526_text(mission).lower()
        uid_lc = _i526_text(uid).lower()
        evidence = []
        try:
            pg_uris, _ = _candidate_ots_pg_uris()
        except Exception:
            pg_uris = []
        for uri in (pg_uris or [])[:1]:
            table = 'mission_uids'
            try:
                rows, err = _pg_table_rows(uri, table, 2200)
            except Exception as exc:
                rows, err = [], str(exc)
            if err:
                evidence.append({'source': 'postgres:' + table, 'ok': False, 'error': _i526_text(err)[:240]})
                continue
            for row in rows or []:
                if not isinstance(row, dict) or not _i528_blob_contains_uid(row, uid_lc):
                    continue
                row_mission = _i526_text(row.get('mission_name') or row.get('missionName') or row.get('mission')).lower()
                if row_mission and mission_lc and row_mission != mission_lc:
                    continue
                evidence.append({'source': 'postgres:' + table, 'ok': True, 'mission': row_mission, 'uid': uid_lc})
                return {'ok': True, 'source': 'postgres:' + table, 'evidence': evidence}
            evidence.append({'source': 'postgres:' + table, 'ok': True, 'rows': len(rows or []), 'matched': False})
        return {'ok': False, 'source': 'postgres', 'evidence': evidence}

    def _i528_api_readback(mission, uid, creator_uid, server_host=''):
        attempts = []
        mission_q = quote(_i526_text(mission), safe='')
        creator_q = quote(_i526_text(creator_uid), safe='')
        paths = [
            f'/Marti/api/missions/{mission_q}/cot?creatorUid={creator_q}',
            f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}',
            f'/Marti/api/missions/{mission_q}?creatorUid={creator_q}',
        ]
        for path in paths:
            result = _ots_mission_api_request(path, method='GET', public_host=server_host, timeout=12)
            rec = {'path': path, 'ok': bool(result.get('ok')), 'status': result.get('status')}
            attempts.append(rec)
            if result.get('ok') and (_i528_blob_contains_uid(result.get('json'), uid) or _i528_blob_contains_uid(result.get('body'), uid)):
                return {'ok': True, 'source': 'mission-api', 'attempts': attempts}
        return {'ok': False, 'source': 'mission-api', 'attempts': attempts}

    def _i528_confirm_readback(mission, uid, creator_uid, server_host=''):
        history = []
        for attempt in range(6):
            pg = _i528_pg_readback(mission, uid)
            history.append({'attempt': attempt + 1, 'postgres': pg})
            if pg.get('ok'):
                return {'ok': True, 'source': pg.get('source'), 'attempts': history}
            api = _i528_api_readback(mission, uid, creator_uid, server_host)
            history[-1]['mission_api'] = api
            if api.get('ok'):
                return {'ok': True, 'source': api.get('source'), 'attempts': history}
            if attempt < 5:
                time.sleep(0.45)
        return {'ok': False, 'source': '', 'attempts': history, 'error': 'The native point was accepted but was not visible in Mission read-back before the reconciliation timeout.'}

    def tak_map_publish_native_points_to_mission_i526(features, mission_name='', server_host='', preferred_creator_uid=''):
        mission = _i526_text(mission_name) or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME', 'TAK Map Mission').strip() or 'TAK Map Mission'
        point_features = _i526_point_features(features, 'points')
        if not point_features:
            return {'ok': False, 'error': 'No publishable point-only Local Data selection was found.', 'publish_mode': 'native-mission-cot-i528'}
        creator = _i528_strict_creator()
        if not creator.get('ok'):
            return {'ok': False, 'error': creator.get('error'), 'publish_mode': 'native-mission-cot-i528', 'creator': creator, 'zip_package_created': False, 'live_cot_fallback_disabled': True}
        creator_uid = creator['uid']
        create = _i526_create_mission(mission, creator_uid, server_host)
        token = _extract_mission_token(create.get('json') or {})
        point_results = []
        all_native_ok = True
        all_readback_ok = True
        for feature in point_features:
            built = _i526_point_xml(feature, mission, creator_uid)
            if not built.get('ok'):
                point_results.append(built)
                all_native_ok = False
                all_readback_ok = False
                continue
            native = _i526_send_native_mission_cot(mission, creator_uid, built['xml'], server_host)
            association = {'ok': False, 'skipped': True, 'error': 'Native Mission CoT request failed; UID association was not attempted.'}
            readback = {'ok': False, 'skipped': True}
            if native.get('ok'):
                association = _i526_associate_uid(mission, creator_uid, built['uid'], token, server_host)
                readback = _i528_confirm_readback(mission, built['uid'], creator_uid, server_host)
            item_ok = bool(native.get('ok'))
            all_native_ok = all_native_ok and item_ok
            all_readback_ok = all_readback_ok and bool(readback.get('ok'))
            point_results.append({
                **{key: built.get(key) for key in ('uid', 'source_uid', 'name', 'cot_type', 'lat', 'lon', 'iconset_path', 'sidc', 'color', 'creator_uid', 'authenticated_user')},
                'ok': item_ok,
                'native_mission_cot': native,
                'associate_uid': association,
                'mission_readback': readback,
                'readback_confirmed': bool(readback.get('ok')),
                'live_cot_fallback': {'ok': False, 'skipped': True, 'disabled_by': 'i528-eud-isolation'},
                'server_confirmed': bool(native.get('ok')),
                'xml_preview': built['xml'][:5000],
            })
        ok = bool(all_native_ok and len(point_results) == len(point_features))
        event_uids = [row.get('uid') for row in point_results if row.get('uid')]
        source_uids = [row.get('source_uid') for row in point_results if row.get('source_uid')]
        out = {
            'ok': ok,
            'mission': mission,
            'publish_mode': 'native-mission-cot-i528',
            'content_kind': 'local-data-point-native-cot',
            'point_count': len(point_features),
            'creator_uid': creator_uid,
            'creator': creator,
            'create_mission': create,
            'points': point_results,
            'event_uids': event_uids,
            'source_uids': source_uids,
            'zip_package_created': False,
            'zip_upload_skipped': True,
            'non_package_publish': True,
            'native_mission_object': True,
            'live_cot_fallback_disabled': True,
            'service_identity_authoring_disabled': True,
            'eud_creator_fallback_disabled': True,
            'readback_confirmed': bool(all_readback_ok),
            'symbol_mapping': {
                'version': 'i527',
                'mode': 'selected-mil2525-sidc-to-native-cot-type',
                'preserved_by': 'i528',
                'generic_combat_fallback_avoided': True,
            },
            'message': '',
            'error': '',
        }
        if ok:
            count = len(point_features)
            prefix = 'Published native point to Data Sync Mission: ' if count == 1 else f'Published {count} native points to Data Sync Mission: '
            suffix = '.' if all_readback_ok else '. Mission publication succeeded; Local Data was retained because read-back confirmation is still pending.'
            out['message'] = prefix + mission + suffix
            out['user_message'] = out['message']
            out['publish_succeeded'] = True
            out['disable_publish_after_success'] = True
            out['close_publish_modal_after_success'] = True
            out['data_sync_refresh_recommended'] = True
            out['canonical_reconcile'] = {'source_uids': source_uids, 'mission_uids': event_uids, 'mode': 'local-to-datasync-after-confirmed-readback', 'ready': bool(all_readback_ok)}
        else:
            failures = []
            for row in point_results:
                if not row.get('ok'):
                    native = row.get('native_mission_cot') or {}
                    failures.append((row.get('name') or 'point') + ': ' + _i526_text(native.get('error') or 'native Mission endpoint did not confirm publication'))
            out['error'] = 'Native Mission point publish failed without live-CoT fallback: ' + ('; '.join(failures) or 'the authenticated user Mission write was rejected')
        try:
            xml_diag = '\n\n'.join(row.get('xml_preview') or '' for row in point_results)
            diag = _write_send_diag('native-mission-point-publish-i528', out, xml_diag or None)
            if isinstance(diag, dict):
                out['diag_paths'] = diag
        except Exception:
            pass
        return out

    globals()['tak_map_publish_native_points_to_mission_i526'] = tak_map_publish_native_points_to_mission_i526

    _i528_previous_local_publish = globals().get('tak_map_local_data_mission_publish')

    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        requested = [str(value or '').strip() for value in (ids or []) if str(value or '').strip()]
        features = _selected_local_data_features(requested)
        if not features:
            return {'ok': False, 'error': 'No selected Local Data items were found.'}
        points = _i526_point_features(features, kind)
        if points and len(points) == len(features):
            identity = _i528_identity()
            result = tak_map_publish_native_points_to_mission_i526(points, mission_name, server_host, identity.get('tak_uid') or '')
            result = dict(result or {})
            reconcile = {'attempted': False, 'deleted': False, 'deleted_count': 0, 'deleted_ids': [], 'reason': ''}
            if result.get('ok') and result.get('readback_confirmed'):
                reconcile['attempted'] = True
                try:
                    deletion = tak_map_local_data_delete(requested)
                except Exception as exc:
                    deletion = {'ok': False, 'error': str(exc), 'deleted': False, 'deleted_ids': []}
                reconcile.update({
                    'ok': bool(deletion.get('ok')),
                    'deleted': bool(deletion.get('deleted')),
                    'deleted_count': int(deletion.get('deleted_count') or len(deletion.get('deleted_ids') or [])),
                    'deleted_ids': list(deletion.get('deleted_ids') or []),
                    'not_found_ids': list(deletion.get('not_found_ids') or []),
                    'unsupported_ids': list(deletion.get('unsupported_ids') or []),
                    'failed_ids': list(deletion.get('failed_ids') or []),
                    'error': _i526_text(deletion.get('error')),
                    'reason': 'Mission read-back confirmed; Local Data source record was promoted to Data Sync.',
                })
                if 'imports' in deletion:
                    result['imports'] = deletion.get('imports')
                if reconcile.get('deleted'):
                    result['message'] = (result.get('message') or '').rstrip('.') + '. Local Data was reconciled into the Data Sync object.'
                    result['user_message'] = result['message']
            elif result.get('ok'):
                reconcile['reason'] = 'Local Data retained because Mission read-back was not confirmed.'
            else:
                reconcile['reason'] = 'Local Data retained because publication failed.'
            result['local_reconcile'] = reconcile
            result['local_data_removed_after_readback'] = bool(reconcile.get('deleted'))
            result['canonical_object_count_expected'] = 1
            return result
        if callable(_i528_previous_local_publish):
            return _i528_previous_local_publish(requested, kind, mission_name, server_host)
        return {'ok': False, 'error': 'Local Data mission publish fallback is unavailable.'}

    globals()['tak_map_local_data_mission_publish'] = tak_map_local_data_mission_publish

    def tak_map_publish_point_uids_to_mission_v340(features, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_native_points_to_mission_i526(features, mission_name, server_host, preferred_creator_uid)

    def tak_map_publish_point_uid_to_mission_v339(feature, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_native_points_to_mission_i526([feature], mission_name, server_host, preferred_creator_uid)

    def tak_map_publish_cot_to_mission(feature, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_native_points_to_mission_i526([feature], mission_name, server_host, preferred_creator_uid)

    globals()['tak_map_publish_point_uids_to_mission_v340'] = tak_map_publish_point_uids_to_mission_v340
    globals()['tak_map_publish_point_uid_to_mission_v339'] = tak_map_publish_point_uid_to_mission_v339
    globals()['tak_map_publish_cot_to_mission'] = tak_map_publish_cot_to_mission

    def _i528_refresh_mission_point_keys(force=False):
        now = time.monotonic()
        with _I528_POINT_CACHE_LOCK:
            if not force and now - float(_I528_POINT_CACHE.get('time') or 0) < 3.0:
                return set(_I528_POINT_CACHE.get('uids') or set()), set(_I528_POINT_CACHE.get('names') or set())
        uids = set()
        names = set()
        try:
            pg_uris, _ = _candidate_ots_pg_uris()
        except Exception:
            pg_uris = []
        for uri in (pg_uris or [])[:1]:
            try:
                rows, _ = _pg_table_rows(uri, 'mission_uids', 2200)
            except Exception:
                rows = []
            for row in rows or []:
                if not isinstance(row, dict):
                    continue
                uid = _i526_text(row.get('uid') or row.get('id') or row.get('cot_uid'))
                if not uid.upper().startswith(_I528_MISSION_POINT_PREFIX):
                    continue
                uids.add(uid.lower())
                for key in ('callsign', 'name', 'title'):
                    value = _i526_text(row.get(key)).lower()
                    if value:
                        names.add(value)
        with _I528_POINT_CACHE_LOCK:
            _I528_POINT_CACHE.update({'time': now, 'uids': set(uids), 'names': set(names)})
        return uids, names

    def _i528_row_identity(row):
        row = row if isinstance(row, dict) else {}
        values = set()
        for key in ('uid', 'id', 'cot_uid', 'event_uid', 'client_uid', 'clientUid', 'device_uid'):
            value = _i526_text(row.get(key)).lower()
            if value:
                values.add(value)
        labels = set()
        for key in ('callsign', 'name', 'title', 'sender_callsign'):
            value = _i526_text(row.get(key)).lower()
            if value:
                labels.add(value)
        return values, labels

    def _i528_is_mission_point_live_row(row, xml=''):
        values, labels = _i528_row_identity(row)
        if any(value.upper().startswith(_I528_MISSION_POINT_PREFIX) for value in values):
            return True
        blob = (_i526_text(xml) + ' ' + json.dumps(row or {}, default=str)).lower()
        if _I528_MISSION_POINT_PREFIX.lower() in blob:
            return True
        uids, names = _i528_refresh_mission_point_keys(False)
        if values & uids:
            return True
        if labels & names:
            return True
        return False

    if '_normalize_tak_marker' in globals():
        _i528_normalize_before = _normalize_tak_marker
        def _normalize_tak_marker(row, source_table='cot', default_kind='cot'):
            source = _i526_text(source_table).lower()
            kind = _i526_text(default_kind).lower()
            if (source in ('cot', 'euds', 'eud_stats', 'points', 'markers') or kind in ('cot', 'eud')) and _i528_is_mission_point_live_row(row):
                return None
            return _i528_normalize_before(row, source_table, default_kind)
        globals()['_normalize_tak_marker'] = _normalize_tak_marker

    if '_is_real_eud_candidate' in globals():
        _i528_real_eud_before = _is_real_eud_candidate
        def _is_real_eud_candidate(e, xml=''):
            if _i528_is_mission_point_live_row(e, xml):
                return False
            return _i528_real_eud_before(e, xml)
        globals()['_is_real_eud_candidate'] = _is_real_eud_candidate

    def _i528_filter_live_rows(rows):
        kept = []
        removed = []
        for row in rows or []:
            if _i528_is_mission_point_live_row(row):
                if len(removed) < 80:
                    values, labels = _i528_row_identity(row)
                    removed.append({'uids': sorted(values)[:6], 'labels': sorted(labels)[:6], 'reason': 'Mission-backed point is authoritative in Data Sync and must not render/list as an EUD or live CoT duplicate.'})
                continue
            kept.append(row)
        return kept, removed

    _i528_cot_before = tak_map_cot_markers
    def tak_map_cot_markers():
        out = _i528_cot_before()
        if isinstance(out, dict):
            before = len(out.get('markers') or [])
            kept, removed = _i528_filter_live_rows(out.get('markers') or [])
            out['markers'] = kept
            out['mission_point_live_suppression_i528'] = {'version': 'i528', 'markers_before': before, 'markers_after': len(kept), 'removed_count': len(removed), 'removed_sample': removed}
        return out
    globals()['tak_map_cot_markers'] = tak_map_cot_markers

    _i528_euds_before = tak_map_euds
    def tak_map_euds():
        out = _i528_euds_before()
        if isinstance(out, dict):
            before = len(out.get('euds') or [])
            kept, removed = _i528_filter_live_rows(out.get('euds') or [])
            out['euds'] = kept
            out['mission_point_eud_suppression_i528'] = {'version': 'i528', 'euds_before': before, 'euds_after': len(kept), 'removed_count': len(removed), 'removed_sample': removed}
        return out
    globals()['tak_map_euds'] = tak_map_euds

    _I528_RUNTIME = r'''<script id="takMapMissionPointReconcileI528">
(function(w,d){'use strict';
  const V='i528',P='takmap-mission-point-',uids=new Set(),names=new Set();
  const txt=v=>{try{return String(v==null?'':v)}catch(_){return ''}},lc=v=>txt(v).toLowerCase().trim();
  function learn(j){try{[...(j&&j.mission_uids||[]),...(j&&j.objects||[])].forEach(function(o){const u=lc(o&& (o.uid||o.id||o.cot_uid));if(u.startsWith(P)){uids.add(u);const n=lc(o.callsign||o.name||o.title);if(n)names.add(n)}})}catch(_){} return j}
  function isMissionPoint(o){try{const b=JSON.stringify(o||{}).toLowerCase(),u=lc(o&&(o.uid||o.id||o.cot_uid||o.event_uid)),n=lc(o&&(o.callsign||o.name||o.title));return u.startsWith(P)||b.includes(P)||uids.has(u)||(n&&names.has(n))}catch(_){return false}}
  function filter(j){try{if(j&&Array.isArray(j.markers))j.markers=j.markers.filter(x=>!isMissionPoint(x));if(j&&Array.isArray(j.euds))j.euds=j.euds.filter(x=>!isMissionPoint(x));}catch(_){}return j}
  function patchFetch(){if(w.__takI528FetchPatched||typeof w.fetch!=='function')return;const base=w.fetch;w.fetch=function(input,init){const url=txt((input&&input.url)||input||''),p=base.apply(this,arguments);if(!/\/api\/tak-map\/(data-sync|cot|euds|local-data-mission-publish)/.test(url))return p;return p.then(function(resp){try{resp.clone().json().then(function(j){if(url.includes('/data-sync'))learn(j);if(url.includes('/cot')||url.includes('/euds'))filter(j);if(url.includes('/local-data-mission-publish')&&j&&j.ok&&j.local_reconcile&&j.local_reconcile.deleted){setTimeout(function(){try{if(typeof w.refreshLocalData==='function')w.refreshLocalData()}catch(_){}try{if(typeof w.forceDataSyncSync==='function')w.forceDataSyncSync('i528-local-to-datasync-reconcile')}catch(_){}},80)}}).catch(function(){});}catch(_){}return resp})};w.__takI528FetchPatched=true}
  function sweep(){try{d.querySelectorAll('.leaflet-marker-icon').forEach(function(el){const b=lc((el.getAttribute('title')||'')+' '+(el.getAttribute('aria-label')||'')+' '+(el.dataset&&JSON.stringify(el.dataset)||''));if(b.includes(P))el.style.display='none'})}catch(_){} }
  function boot(){patchFetch();sweep();[250,900,2000,4500].forEach(ms=>setTimeout(sweep,ms))}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
  w.TakMapMissionPointReconcileI528=Object.freeze({version:V,learn,filter,isMissionPoint,diagnostics:()=>({version:V,uids:[...uids],names:[...names],fetchPatched:!!w.__takI528FetchPatched})});
})(window,document);
</script>'''

    def _i528_version_html(html):
        if not isinstance(html, str):
            return html
        html = _i528_re.sub(r'1\.3\.0-i\d+', '1.3.0-i528', html)
        html = _i528_re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i528', html)
        html = _i528_re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i528', html)
        html = _i528_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i528\2', html)
        html = _i528_re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i528\2', html)
        return html

    def _i528_patch_html(html):
        html = _i528_version_html(html)
        if not isinstance(html, str):
            return html
        html = _i528_re.sub(r'<script[^>]*id=["\']takMapMissionPointReconcileI528["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=_i528_re.I)
        return html.replace('</body>', _I528_RUNTIME + '\n</body>', 1) if '</body>' in html else html + _I528_RUNTIME

    TAK_MAP_HTML = _i528_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i528_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i528'

    _i528_config_before = tak_map_config
    def tak_map_config():
        cfg = _i528_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i528'
        cfg['version'] = '1.3.0-i528'
        native = dict(cfg.get('data_sync_native_point_publish') or {})
        native.update({
            'version': 'i528',
            'authenticated_user_creator_required': True,
            'service_identity_authoring_disabled': True,
            'eud_creator_fallback_disabled': True,
            'live_cot_fallback_disabled': True,
            'explicit_dest_mission': True,
            'readback_required_before_local_reconcile': True,
            'local_data_promoted_to_datasync': True,
            'mission_point_live_eud_suppression': True,
            'canonical_object_count': 1,
        })
        cfg['data_sync_native_point_publish'] = native
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _i528_data_sync_before = tak_map_data_sync
    def tak_map_data_sync():
        out = _i528_data_sync_before()
        if isinstance(out, dict):
            out['mission_point_reconcile_i528'] = {
                'version': 'i528',
                'mode': 'authenticated-user-native-point-with-confirmed-local-promotion',
                'live_cot_fallback': False,
                'eud_creator_fallback': False,
                'local_delete_requires_readback': True,
                'live_eud_duplicate_suppression': True,
                'expected_representations': {'local_data': 0, 'data_sync': 1, 'live_eud': 0, 'map_markers': 1},
            }
        return out
    globals()['tak_map_data_sync'] = tak_map_data_sync
except Exception as _i528_exc:
    try:
        print('TAK Map i528 mission-point reconciliation/EUD isolation patch failed:', _i528_exc)
    except Exception:
        pass
# --- end TAK Map i528 native mission-point ownership, reconciliation, and EUD isolation ---

# --- TAK Map i529 per-user OpenTAKServer certificate identity for Data Sync ---
try:
    _I529_CREDENTIAL_ROOT = DATA_DIR / 'ots_user_credentials'
    _I529_MASTER_SECRET_FILE = DATA_DIR / 'ots_user_credentials.master'
    _I529_REQUEST_CONTEXT = threading.local()
    _I529_RENEW_BEFORE_SECONDS = 7 * 24 * 60 * 60
    _I529_CERT_LOCK = threading.RLock()

    def _i529_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i529_user_key(username):
        return hashlib.sha256(_i529_text(username).lower().encode('utf-8')).hexdigest()[:40]

    def _i529_paths(username):
        root = _I529_CREDENTIAL_ROOT / _i529_user_key(username)
        return {
            'root': root,
            'key': root / 'client-key.pem',
            'csr': root / 'client.csr',
            'cert': root / 'client-cert.pem',
            'ca': root / 'ca-chain.pem',
            'meta': root / 'metadata.json',
        }

    def _i529_atomic_write(path, data, mode=0o600, binary=False):
        path = Path(path)
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(path.parent, 0o700)
        except Exception:
            pass
        tmp = path.with_name(path.name + '.tmp-' + secrets.token_hex(4))
        if binary:
            tmp.write_bytes(data if isinstance(data, (bytes, bytearray)) else bytes(data))
        else:
            tmp.write_text(str(data), encoding='utf-8')
        os.chmod(tmp, mode)
        tmp.replace(path)
        os.chmod(path, mode)
        return path

    def _i529_master_secret():
        with _I529_CERT_LOCK:
            _I529_CREDENTIAL_ROOT.mkdir(parents=True, exist_ok=True)
            try:
                os.chmod(_I529_CREDENTIAL_ROOT, 0o700)
            except Exception:
                pass
            if _I529_MASTER_SECRET_FILE.exists():
                raw = _I529_MASTER_SECRET_FILE.read_bytes()
                if len(raw) >= 32:
                    return raw
            raw = secrets.token_bytes(48)
            _i529_atomic_write(_I529_MASTER_SECRET_FILE, raw, 0o600, True)
            return raw

    def _i529_key_password(username):
        digest = hmac.new(_i529_master_secret(), ('tak-map-i529:' + _i529_text(username).lower()).encode('utf-8'), hashlib.sha256).digest()
        return base64.urlsafe_b64encode(digest).decode('ascii').rstrip('=')

    def _i529_pem(value, label='CERTIFICATE'):
        text = _i529_text(value).replace('\\n', '\n')
        if not text:
            return ''
        if '-----BEGIN ' in text:
            return text + ('\n' if not text.endswith('\n') else '')
        compact = re.sub(r'\s+', '', text)
        if not compact:
            return ''
        lines = '\n'.join(compact[i:i + 64] for i in range(0, len(compact), 64))
        return '-----BEGIN ' + label + '-----\n' + lines + '\n-----END ' + label + '-----\n'

    def _i529_decode_cert(path):
        try:
            return ssl._ssl._test_decode_cert(str(path))
        except Exception:
            return {}

    def _i529_cert_cn(decoded):
        try:
            for group in decoded.get('subject') or []:
                for key, value in group:
                    if str(key).lower() == 'commonname':
                        return _i529_text(value)
        except Exception:
            pass
        return ''

    def _i529_cert_expiry_epoch(decoded):
        value = _i529_text((decoded or {}).get('notAfter'))
        if not value:
            return 0.0
        try:
            return float(ssl.cert_time_to_seconds(value))
        except Exception:
            return 0.0

    def _i529_load_metadata(username):
        path = _i529_paths(username)['meta']
        try:
            value = json.loads(path.read_text(encoding='utf-8'))
            return value if isinstance(value, dict) else {}
        except Exception:
            return {}

    def _i529_public_certificate_status(username, expected_uid=''):
        username = _i529_text(username)
        paths = _i529_paths(username)
        meta = _i529_load_metadata(username)
        out = {
            'ok': False,
            'version': 'i529',
            'username': username,
            'client_uid': _i529_text(meta.get('client_uid') or expected_uid),
            'certificate_cn': '',
            'certificate_present': paths['cert'].is_file(),
            'private_key_present': paths['key'].is_file(),
            'ca_chain_present': paths['ca'].is_file(),
            'expires_at': '',
            'expires_epoch': 0,
            'expires_in_seconds': 0,
            'renewal_required': True,
            'identity_mode': 'per-user-enrolled-marti-certificate',
            'shared_service_fallback': False,
            'error': '',
        }
        if not username:
            out['error'] = 'No signed-in OpenTAKServer username is available.'
            return out
        missing = [name for name in ('cert', 'key', 'ca') if not paths[name].is_file()]
        if missing:
            out['error'] = 'Per-user Data Sync certificate enrollment is incomplete: missing ' + ', '.join(missing) + '.'
            return out
        decoded = _i529_decode_cert(paths['cert'])
        cn = _i529_cert_cn(decoded)
        expiry = _i529_cert_expiry_epoch(decoded)
        out['certificate_cn'] = cn
        out['expires_at'] = _i529_text(decoded.get('notAfter'))
        out['expires_epoch'] = int(expiry or 0)
        out['expires_in_seconds'] = max(0, int(expiry - time.time())) if expiry else 0
        out['renewal_required'] = (not expiry) or expiry <= time.time() + _I529_RENEW_BEFORE_SECONDS
        if cn.lower() != username.lower():
            out['error'] = 'The enrolled Marti client certificate CN does not match the signed-in OpenTAKServer username.'
            return out
        if expected_uid and out['client_uid'] and out['client_uid'] != _i529_text(expected_uid):
            out['error'] = 'The enrolled Marti certificate is linked to a different TAK user UID. Sign in again to re-enroll it.'
            return out
        password = _i529_key_password(username)
        env = os.environ.copy()
        env['TAKMAP_I529_KEY_PASSWORD'] = password
        try:
            cert_pub = subprocess.run(['openssl', 'x509', '-in', str(paths['cert']), '-pubkey', '-noout'], capture_output=True, timeout=15, check=True).stdout
            key_pub = subprocess.run(['openssl', 'pkey', '-in', str(paths['key']), '-passin', 'env:TAKMAP_I529_KEY_PASSWORD', '-pubout'], env=env, capture_output=True, timeout=15, check=True).stdout
            if hashlib.sha256(cert_pub).digest() != hashlib.sha256(key_pub).digest():
                out['error'] = 'The enrolled client certificate does not match its encrypted private key.'
                return out
        except Exception as exc:
            out['error'] = 'The encrypted per-user client key could not be validated: ' + str(exc)
            return out
        if out['renewal_required']:
            out['error'] = 'The per-user Data Sync certificate is expired or within the seven-day renewal window.'
            return out
        out['ok'] = True
        out['error'] = ''
        out['certificate_path'] = str(paths['cert'])
        out['private_key_path'] = str(paths['key'])
        out['ca_chain_path'] = str(paths['ca'])
        out['key_password'] = password
        return out

    def _i529_strict_tls_context(cfg, ca_override=''):
        ca = _i529_text(ca_override or (cfg or {}).get('ca_cert_path'))
        if not ca or not Path(ca).expanduser().is_file():
            raise RuntimeError('OpenTAKServer trusted CA path is missing. Configure OTS trust before per-user Data Sync enrollment.')
        ctx = ssl.create_default_context(cafile=str(Path(ca).expanduser()))
        ctx.check_hostname = True
        ctx.verify_mode = ssl.CERT_REQUIRED
        return ctx

    def _i529_enrollment_request(cfg, username, password, client_uid, csr_pem):
        base = _i529_text((cfg or {}).get('enrollment_url')).rstrip('/')
        if not base:
            raise RuntimeError('OpenTAKServer enrollment URL is not configured.')
        endpoint = base + '/Marti/api/tls/signClient/v2?clientUid=' + quote(client_uid, safe='') + '&version=5.2.0'
        auth = base64.b64encode((username + ':' + password).encode('utf-8')).decode('ascii')
        headers = {
            'Authorization': 'Basic ' + auth,
            'Accept': 'application/json',
            'Content-Type': 'text/plain; charset=utf-8',
            'User-Agent': 'TAK-Map/1.3.0-i529 PerUserEnrollment',
            'Content-Length': str(len(csr_pem)),
        }
        req = Request(endpoint, data=csr_pem, method='POST', headers=headers)
        ctx = _i529_strict_tls_context(cfg)
        try:
            with urlopen(req, timeout=35, context=ctx) as resp:
                raw = resp.read(4 * 1024 * 1024)
                text = decode_http_body(raw, getattr(resp, 'headers', {}) or {})
                code = int(getattr(resp, 'status', None) or resp.getcode())
        except HTTPError as exc:
            try:
                detail = decode_http_body(exc.read(4096), getattr(exc, 'headers', {}) or {})
            except Exception:
                detail = ''
            raise RuntimeError('OpenTAKServer certificate enrollment failed with HTTP ' + str(getattr(exc, 'code', 0) or 0) + (': ' + detail[:500] if detail else '.'))
        if code < 200 or code >= 300:
            raise RuntimeError('OpenTAKServer certificate enrollment failed with HTTP ' + str(code) + '.')
        try:
            payload = json.loads(text)
        except Exception:
            raise RuntimeError('OpenTAKServer certificate enrollment returned a non-JSON response.')
        if isinstance(payload, dict) and isinstance(payload.get('data'), dict):
            payload = payload.get('data')
        signed = _i529_pem((payload or {}).get('signedCert') or (payload or {}).get('signed_cert') or (payload or {}).get('certificate'), 'CERTIFICATE')
        ca0 = _i529_pem((payload or {}).get('ca0') or (payload or {}).get('ca'), 'CERTIFICATE')
        ca1 = _i529_pem((payload or {}).get('ca1'), 'CERTIFICATE')
        if 'BEGIN CERTIFICATE' not in signed:
            raise RuntimeError('OpenTAKServer enrollment response did not include a signed client certificate.')
        chain = ''.join([part for part in (ca0, ca1) if 'BEGIN CERTIFICATE' in part])
        if not chain:
            configured_ca = Path(_i529_text((cfg or {}).get('ca_cert_path'))).expanduser()
            if configured_ca.is_file():
                chain = configured_ca.read_text(encoding='utf-8', errors='ignore')
        if 'BEGIN CERTIFICATE' not in chain:
            raise RuntimeError('OpenTAKServer enrollment response did not include a usable CA chain.')
        return {'signed_cert': signed, 'ca_chain': chain, 'endpoint': endpoint, 'status': code}

    def _i529_ensure_user_certificate(cfg, username, password, client_uid, force=False):
        username = sanitize_ots_username(username)
        client_uid = _i529_text(client_uid)
        if not username or not password:
            return {'ok': False, 'error': 'OpenTAKServer username and password are required for per-user certificate enrollment.', 'version': 'i529'}
        if not client_uid:
            return {'ok': False, 'error': 'The signed-in user does not have a stable TAK UID. Data Sync certificate enrollment cannot continue.', 'version': 'i529'}
        current = _i529_public_certificate_status(username, client_uid)
        if current.get('ok') and not force:
            return current
        paths = _i529_paths(username)
        paths['root'].mkdir(parents=True, exist_ok=True)
        os.chmod(paths['root'], 0o700)
        password_value = _i529_key_password(username)
        env = os.environ.copy()
        env['TAKMAP_I529_KEY_PASSWORD'] = password_value
        tmp_root = Path(tempfile.mkdtemp(prefix='tak-map-i529-enroll-', dir=str(paths['root'])))
        try:
            os.chmod(tmp_root, 0o700)
            tmp_key = tmp_root / 'client-key.pem'
            tmp_csr = tmp_root / 'client.csr'
            subject_cn = re.sub(r'[^A-Za-z0-9_.@-]', '_', username)[:128]
            cmd = [
                'openssl', 'req', '-new', '-newkey', 'rsa:3072', '-sha256',
                '-keyout', str(tmp_key), '-out', str(tmp_csr),
                '-subj', '/CN=' + subject_cn,
                '-passout', 'env:TAKMAP_I529_KEY_PASSWORD',
            ]
            proc = subprocess.run(cmd, env=env, capture_output=True, timeout=45)
            if proc.returncode != 0:
                raise RuntimeError('OpenSSL could not generate the per-user client key and CSR: ' + (proc.stderr or b'').decode('utf-8', 'ignore')[-800:])
            csr = tmp_csr.read_bytes()
            enrollment = _i529_enrollment_request(cfg, username, password, client_uid, csr)
            _i529_atomic_write(paths['key'], tmp_key.read_bytes(), 0o600, True)
            _i529_atomic_write(paths['csr'], csr, 0o600, True)
            _i529_atomic_write(paths['cert'], enrollment['signed_cert'], 0o640, False)
            _i529_atomic_write(paths['ca'], enrollment['ca_chain'], 0o640, False)
            decoded = _i529_decode_cert(paths['cert'])
            meta = {
                'version': 'i529',
                'username': username,
                'client_uid': client_uid,
                'certificate_cn': _i529_cert_cn(decoded),
                'not_after': _i529_text(decoded.get('notAfter')),
                'enrolled_at': datetime.now(timezone.utc).isoformat(),
                'enrollment_endpoint': enrollment.get('endpoint'),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'shared_service_fallback': False,
            }
            _i529_atomic_write(paths['meta'], json.dumps(meta, indent=2, sort_keys=True) + '\n', 0o600, False)
            validated = _i529_public_certificate_status(username, client_uid)
            if not validated.get('ok'):
                raise RuntimeError(validated.get('error') or 'The newly enrolled client certificate did not validate.')
            return validated
        except Exception as exc:
            return {
                'ok': False,
                'version': 'i529',
                'username': username,
                'client_uid': client_uid,
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'shared_service_fallback': False,
                'error': str(exc),
            }
        finally:
            shutil.rmtree(tmp_root, ignore_errors=True)

    def _i529_current_session():
        token = _i529_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', ''))
        if not token:
            return {}
        with TAK_MAP_SESSIONS_LOCK:
            return dict(TAK_MAP_SESSIONS.get(token) or {})

    def _i529_current_user_credential():
        sess = _i529_current_session()
        identity = _i512_current_identity() if '_i512_current_identity' in globals() else {}
        username = _i529_text(identity.get('username') or sess.get('username'))
        profile = dict(sess.get('profile') or {})
        client_uid = _i529_text(identity.get('tak_uid') or sess.get('tak_uid') or profile.get('tak_uid'))
        status = _i529_public_certificate_status(username, client_uid)
        status['auth_mode'] = _i529_text(sess.get('auth_mode'))
        return status

    def _i529_user_mission_api_request(path, method='GET', body=None, headers=None, token='', public_host='', timeout=25):
        credential = _i529_current_user_credential()
        if not credential.get('ok'):
            return {
                'ok': False,
                'status': 428,
                'error': 'Per-user OpenTAKServer Data Sync identity is unavailable: ' + _i529_text(credential.get('error')),
                'attempts': [],
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'shared_service_fallback': False,
                'credential': {k: v for k, v in credential.items() if k not in ('key_password', 'private_key_path')},
            }
        cfg = _i509_load_ots_config()
        base = _i529_text(cfg.get('marti_url')).rstrip('/')
        if not base:
            return {'ok': False, 'status': 503, 'error': 'OpenTAKServer Marti URL is not configured.', 'attempts': [], 'shared_service_fallback': False}
        url = base + ('/' if not str(path).startswith('/') else '') + str(path)
        req_headers = dict(headers or {})
        req_headers.setdefault('Accept', 'application/json,*/*')
        req_headers.setdefault('User-Agent', 'TAK-Map/1.3.0-i529 PerUserMissionAPI')
        if token:
            req_headers['Authorization'] = 'Bearer ' + str(token)
        if isinstance(body, str):
            body = body.encode('utf-8')
        attempts = []
        try:
            ctx = _i529_strict_tls_context(cfg, credential.get('ca_chain_path'))
            ctx.load_cert_chain(credential['certificate_path'], credential['private_key_path'], password=credential['key_password'])
            req = Request(url, data=body, method=method, headers=req_headers)
            with urlopen(req, timeout=timeout, context=ctx) as resp:
                raw = resp.read(8 * 1024 * 1024)
                text = decode_http_body(raw, getattr(resp, 'headers', {}) or {})
                code = int(getattr(resp, 'status', None) or resp.getcode())
                rec = {'url': url, 'method': method, 'status': code, 'ok': 200 <= code < 300, 'body_preview': text[:2400], 'certificate_cn': credential.get('certificate_cn'), 'client_uid': credential.get('client_uid')}
                try:
                    rec['json'] = json.loads(text) if text.strip() else {}
                except Exception:
                    rec['json_parse_error'] = 'response was not JSON'
                attempts.append(rec)
                return {'ok': rec['ok'], 'status': code, 'url': url, 'body': text, 'json': rec.get('json') or {}, 'attempts': attempts, 'identity_mode': 'per-user-enrolled-marti-certificate', 'shared_service_fallback': False, 'certificate_cn': credential.get('certificate_cn'), 'client_uid': credential.get('client_uid')}
        except HTTPError as exc:
            try:
                text = decode_http_body(exc.read(4096), getattr(exc, 'headers', {}) or {})
            except Exception:
                text = ''
            code = int(getattr(exc, 'code', 0) or 0)
            attempts.append({'url': url, 'method': method, 'status': code, 'ok': False, 'error': str(exc), 'body_preview': text[:2400], 'certificate_cn': credential.get('certificate_cn'), 'client_uid': credential.get('client_uid')})
        except Exception as exc:
            attempts.append({'url': url, 'method': method, 'ok': False, 'error': str(exc), 'certificate_cn': credential.get('certificate_cn'), 'client_uid': credential.get('client_uid')})
        return {'ok': False, 'error': 'The per-user OpenTAKServer Mission API request failed.', 'attempts': attempts, 'identity_mode': 'per-user-enrolled-marti-certificate', 'shared_service_fallback': False, 'certificate_cn': credential.get('certificate_cn'), 'client_uid': credential.get('client_uid')}

    _i529_service_mission_request = _ots_mission_api_request
    def _ots_mission_api_request(path, method='GET', body=None, headers=None, token='', public_host='', timeout=25):
        auth_mode = _i529_text(getattr(_I529_REQUEST_CONTEXT, 'auth_mode', ''))
        if auth_mode.startswith('ots-'):
            return _i529_user_mission_api_request(path, method, body, headers, token, public_host, timeout)
        return _i529_service_mission_request(path, method, body, headers, token, public_host, timeout)
    globals()['_ots_mission_api_request'] = _ots_mission_api_request

    def _i528_strict_creator():
        identity = _i528_identity()
        credential = _i529_current_user_credential()
        if not credential.get('ok'):
            return {'ok': False, 'uid': '', 'error': 'Per-user OpenTAKServer Data Sync identity is required: ' + _i529_text(credential.get('error')), 'identity': identity, 'shared_service_fallback': False}
        uid = _i529_text(credential.get('client_uid'))
        if not uid:
            return {'ok': False, 'uid': '', 'error': 'The enrolled per-user certificate has no associated TAK client UID.', 'identity': identity, 'shared_service_fallback': False}
        return {'ok': True, 'uid': uid, 'source': 'per-user-enrolled-marti-certificate-i529', 'identity': identity, 'certificate_cn': credential.get('certificate_cn'), 'shared_service_fallback': False}
    globals()['_i528_strict_creator'] = _i528_strict_creator

    _i529_point_xml_before = _i526_point_xml
    def _i526_point_xml(feature, mission_name, creator_uid):
        built = _i529_point_xml_before(feature, mission_name, creator_uid)
        try:
            root = ET.fromstring(_i529_text(built.get('xml')).encode('utf-8'))
            detail = root.find('detail')
            if detail is None:
                detail = ET.SubElement(root, 'detail')
            meta = detail.find('takmap')
            if meta is None:
                meta = ET.SubElement(detail, 'takmap')
            meta.set('version', 'i529')
            meta.set('transportIdentity', 'per-user-enrolled-marti-certificate')
            meta.set('serviceCredentialFallback', 'false')
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            built['identity_mode'] = 'per-user-enrolled-marti-certificate'
            built['shared_service_fallback'] = False
        except Exception as exc:
            built['i529_identity_xml_warning'] = str(exc)
        return built
    globals()['_i526_point_xml'] = _i526_point_xml

    _i529_session_public_before = _i509_session_public
    def _i509_session_public(sess):
        out = dict(_i529_session_public_before(sess))
        sess = sess or {}
        if _i529_text(sess.get('auth_mode')).startswith('ots-'):
            profile = dict(sess.get('profile') or {})
            status = _i529_public_certificate_status(_i529_text(sess.get('username')), _i529_text(sess.get('tak_uid') or profile.get('tak_uid')))
            out['data_sync_identity_ready'] = bool(status.get('ok'))
            out['data_sync_identity'] = {k: v for k, v in status.items() if k not in ('key_password', 'private_key_path', 'certificate_path', 'ca_chain_path')}
        else:
            out['data_sync_identity_ready'] = False
            out['data_sync_identity'] = {'ok': False, 'version': 'i529', 'identity_mode': 'not-applicable', 'shared_service_fallback': False}
        out['version'] = 'i529'
        return out
    globals()['_i509_session_public'] = _i509_session_public

    def _i529_handle_login(self):
        if not self._is_secure_request() and not ALLOW_INSECURE_UPLOAD_AUTH:
            return self._send_json({'ok': False, 'error': 'TAK Map login requires HTTPS.'}, 403)
        form = self._read_form()
        mode = _i529_text(form.get('mode')).lower()
        username = sanitize_ots_username(form.get('username', ''))
        password = str(form.get('password') or '')
        otp = str(form.get('otp') or '')
        cfg = _i509_load_ots_config()
        ots_connected = bool(cfg.get('enabled') and cfg.get('login_enabled'))
        if not mode:
            mode = 'ots' if ots_connected else 'local'
        if mode in ('local', 'local-user', 'local-admin', 'recovery', 'admin'):
            account, error, status_code = _i512_authenticate_local(self, username, password)
            if not account:
                return self._send_json({'ok': False, 'error': error, 'local_login': True}, status_code)
            session_token = _i512_create_local_session(account)
            reply = _i509_session_public(TAK_MAP_SESSIONS.get(session_token))
            reply['ok'] = True
            return self._send_json(reply, 200, headers={'Set-Cookie': self._tak_map_session_cookie(session_token)})
        if mode not in ('ots', 'opentakserver'):
            return self._send_json({'ok': False, 'error': 'Select OpenTAKServer Login or Local Login.'}, 400)
        if not ots_connected:
            return self._send_json({'ok': False, 'error': 'OpenTAKServer Login is not currently enabled. Use Local Login.'}, 403)
        auth = _i509_authenticate_remote(cfg, username, password, otp)
        if not auth.get('ok'):
            return self._send_json({'ok': False, 'error': auth.get('error') or 'OpenTAKServer login failed.', 'attempts': auth.get('attempts', [])}, 401)
        fetched = _i511_fetch_profile(cfg, auth, username)
        if fetched.get('ok'):
            profile = fetched['profile']
        else:
            profile = _i511_profile_from_me({'username': username, 'roles': [], 'euds': []}, username)
            profile['profile_warning'] = _i529_text(fetched.get('error') or 'OpenTAKServer profile unavailable.')
        client_uid = _i529_text(profile.get('tak_uid'))
        enrolled = _i529_ensure_user_certificate(cfg, username, password, client_uid, False)
        if not enrolled.get('ok'):
            return self._send_json({
                'ok': False,
                'error': 'OpenTAKServer login succeeded, but the required per-user Data Sync certificate could not be enrolled or validated: ' + _i529_text(enrolled.get('error')),
                'data_sync_identity_required': True,
                'shared_service_fallback': False,
                'enrollment': {k: v for k, v in enrolled.items() if k not in ('key_password', 'private_key_path', 'certificate_path', 'ca_chain_path')},
            }, 502)
        session_token = _i511_create_profile_session(username, password, 'ots-user', bool(profile.get('is_admin')), auth, profile)
        with TAK_MAP_SESSIONS_LOCK:
            sess = TAK_MAP_SESSIONS.get(session_token)
            if sess is not None:
                sess['password'] = ''
                sess['tak_uid'] = client_uid
                sess['data_sync_identity_ready'] = True
                sess['data_sync_certificate_cn'] = enrolled.get('certificate_cn')
                sess['data_sync_certificate_expires_at'] = enrolled.get('expires_at')
        reply = _i509_session_public(TAK_MAP_SESSIONS.get(session_token))
        reply['ok'] = True
        reply['version'] = 'i529'
        if profile.get('profile_warning'):
            reply['profile_warning'] = profile['profile_warning']
        return self._send_json(reply, 200, headers={'Set-Cookie': self._tak_map_session_cookie(session_token)})
    Handler._handle_tak_map_login = _i529_handle_login

    _i529_do_get_before = Handler.do_GET
    def _i529_do_get(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if path == '/api/tak-map/ots/user-certificate':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session() or {}
            if not _i529_text(sess.get('auth_mode')).startswith('ots-'):
                return self._send_json({'ok': False, 'error': 'Per-user Data Sync certificates apply only to OpenTAKServer sessions.', 'version': 'i529'}, 409)
            profile = dict(sess.get('profile') or {})
            status = _i529_public_certificate_status(_i529_text(sess.get('username')), _i529_text(sess.get('tak_uid') or profile.get('tak_uid')))
            safe = {k: v for k, v in status.items() if k not in ('key_password', 'private_key_path', 'certificate_path', 'ca_chain_path')}
            return self._send_json(safe, 200 if status.get('ok') else 428)
        sess = self._tak_map_session() if self._tak_map_auth_ok() else None
        _I529_REQUEST_CONTEXT.session_token = (self._tak_map_token() if sess and callable(getattr(self, '_tak_map_token', None)) else '')
        _I529_REQUEST_CONTEXT.auth_mode = _i529_text((sess or {}).get('auth_mode'))
        try:
            return _i529_do_get_before(self)
        finally:
            _I529_REQUEST_CONTEXT.session_token = ''
            _I529_REQUEST_CONTEXT.auth_mode = ''
    Handler.do_GET = _i529_do_get

    _i529_do_post_before = Handler.do_POST
    def _i529_do_post(self):
        sess = self._tak_map_session() if self._tak_map_auth_ok() else None
        _I529_REQUEST_CONTEXT.session_token = (self._tak_map_token() if sess and callable(getattr(self, '_tak_map_token', None)) else '')
        _I529_REQUEST_CONTEXT.auth_mode = _i529_text((sess or {}).get('auth_mode'))
        try:
            return _i529_do_post_before(self)
        finally:
            _I529_REQUEST_CONTEXT.session_token = ''
            _I529_REQUEST_CONTEXT.auth_mode = ''
    Handler.do_POST = _i529_do_post

    _I529_RUNTIME = r'''<script id="takMapPerUserDataSyncIdentityI529">
(function(w,d){'use strict';const V='i529',by=id=>d.getElementById(id),esc=s=>String(s==null?'':s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));let state=null;
async function load(){try{const r=await fetch('/api/tak-map/ots/user-certificate',{cache:'no-store',credentials:'same-origin'}),j=await r.json();state=j;render();return j}catch(e){state={ok:false,error:String(e),identity_mode:'per-user-enrolled-marti-certificate'};render();return state}}
function render(){try{const menu=by('takMapAccountMenuV511');if(!menu||!state)return;let box=by('takMapDataSyncIdentityI529');if(!box){box=d.createElement('div');box.id='takMapDataSyncIdentityI529';box.style.cssText='margin:8px 0;padding:8px;border:1px solid rgba(255,255,255,.1);border-radius:8px;font-size:.72rem;line-height:1.45';const actions=menu.querySelector('.tak-account-actions-v511');menu.insertBefore(box,actions||null)}box.innerHTML='<b>Data Sync identity</b><br><span style="color:'+(state.ok?'#7ee787':'#ffb86b')+'">'+(state.ok?'Ready':'Unavailable')+'</span><br><span>'+esc(state.certificate_cn||state.username||'')+'</span>'+(state.expires_at?'<br><span>Expires '+esc(state.expires_at)+'</span>':'')+(state.error?'<br><span title="'+esc(state.error)+'">'+esc(state.error)+'</span>':'')}catch(_){} }
function boot(){load();const mo=new MutationObserver(render);mo.observe(d.body,{childList:true,subtree:true});[500,1500,3500].forEach(ms=>setTimeout(()=>{load()},ms))}if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapPerUserDataSyncIdentityI529=Object.freeze({version:V,load,render,diagnostics:()=>state});
})(window,document);
</script>'''

    def _i529_version_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i529', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i529', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i529', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i529\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i529\2', html)
        return html

    def _i529_patch_html(html):
        html = _i529_version_html(html)
        if not isinstance(html, str):
            return html
        html = re.sub(r'<script[^>]*id=["\']takMapPerUserDataSyncIdentityI529["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        return html.replace('</body>', _I529_RUNTIME + '\n</body>', 1) if '</body>' in html else html + _I529_RUNTIME

    TAK_MAP_HTML = _i529_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i529_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i529'

    _i529_config_before = tak_map_config
    def tak_map_config():
        cfg = _i529_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i529'
        cfg['version'] = '1.3.0-i529'
        ots = dict(cfg.get('ots_integration') or {})
        ots.update({
            'version': 'i529',
            'per_user_marti_certificate_required': True,
            'automatic_certificate_enrollment_at_login': True,
            'certificate_cn_matches_ots_username': True,
            'private_key_encrypted_at_rest': True,
            'private_key_never_sent_to_browser': True,
            'user_password_not_retained_after_enrollment': True,
            'shared_service_certificate_fallback': False,
            'user_write_blocked_when_identity_unavailable': True,
        })
        cfg['ots_integration'] = ots
        native = dict(cfg.get('data_sync_native_point_publish') or {})
        native.update({
            'version': 'i529',
            'identity_mode': 'per-user-enrolled-marti-certificate',
            'shared_service_certificate_fallback': False,
            'synthetic_creator_uid_without_certificate_disabled': True,
            'user_certificate_required': True,
        })
        cfg['data_sync_native_point_publish'] = native
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _i529_data_sync_before = tak_map_data_sync
    def tak_map_data_sync():
        out = _i529_data_sync_before()
        if isinstance(out, dict):
            credential = _i529_current_user_credential()
            out['per_user_data_sync_identity_i529'] = {
                'version': 'i529',
                'ok': bool(credential.get('ok')),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'username': credential.get('username'),
                'client_uid': credential.get('client_uid'),
                'certificate_cn': credential.get('certificate_cn'),
                'expires_at': credential.get('expires_at'),
                'shared_service_fallback': False,
                'error': credential.get('error') or '',
            }
        return out
    globals()['tak_map_data_sync'] = tak_map_data_sync
except Exception as _i529_exc:
    try:
        print('TAK Map i529 per-user OpenTAKServer certificate identity patch failed:', _i529_exc)
    except Exception:
        pass
# --- end TAK Map i529 per-user OpenTAKServer certificate identity for Data Sync ---

# --- TAK Map i531 per-user CoT ingest + Mission UID association ---
try:
    _I531_STATUS_CACHE = {}
    _I531_STATUS_CACHE_TTL_SECONDS = 60.0
    _i531_certificate_status_uncached = _i529_public_certificate_status

    def _i531_status_file_signature(username):
        signature = []
        paths = _i529_paths(username)
        for name in ('cert', 'key', 'ca', 'meta'):
            path = paths[name]
            try:
                stat = path.stat()
                signature.append((name, int(stat.st_mtime_ns), int(stat.st_size)))
            except FileNotFoundError:
                signature.append((name, 0, 0))
            except Exception:
                signature.append((name, -1, -1))
        return tuple(signature)

    def _i529_public_certificate_status(username, expected_uid=''):
        username = _i529_text(username)
        expected_uid = _i529_text(expected_uid)
        signature = _i531_status_file_signature(username)
        cache_key = (username.lower(), expected_uid, signature)
        now = time.monotonic()
        with _I529_CERT_LOCK:
            cached = _I531_STATUS_CACHE.get(cache_key)
            if cached and now - float(cached[0]) <= _I531_STATUS_CACHE_TTL_SECONDS:
                return dict(cached[1])
            result = dict(_i531_certificate_status_uncached(username, expected_uid) or {})
            result['version'] = 'i531'
            for key in list(_I531_STATUS_CACHE):
                if key[0] == username.lower() and key != cache_key:
                    _I531_STATUS_CACHE.pop(key, None)
            _I531_STATUS_CACHE[cache_key] = (now, dict(result))
            return dict(result)

    globals()['_i529_public_certificate_status'] = _i529_public_certificate_status

    def _i531_cot_endpoint(cfg):
        cfg = cfg if isinstance(cfg, dict) else {}
        host = _i529_text(cfg.get('cot_host'))
        if not host:
            host = _i529_text(urlparse(_i529_text(cfg.get('marti_url'))).hostname)
        try:
            port = int(cfg.get('cot_port') or 8089)
        except Exception:
            port = 0
        if not host:
            raise RuntimeError('OpenTAKServer SSL CoT host is not configured.')
        if port < 1 or port > 65535:
            raise RuntimeError('OpenTAKServer SSL CoT port is invalid.')
        return host, port

    def _i531_user_presence_xml(credential):
        credential = credential if isinstance(credential, dict) else {}
        identity = _i512_current_identity() if '_i512_current_identity' in globals() else {}
        identity = identity if isinstance(identity, dict) else {}
        client_uid = _i529_text(credential.get('client_uid') or identity.get('tak_uid'))
        username = _i529_text(identity.get('username') or credential.get('username') or credential.get('certificate_cn'))
        callsign = _i529_text(identity.get('callsign') or identity.get('display_name') or username or credential.get('certificate_cn'))
        if not client_uid:
            return {'ok': False, 'error': 'The enrolled per-user certificate has no stable TAK client UID for the authenticated CoT session.'}
        if not callsign:
            return {'ok': False, 'error': 'The authenticated OpenTAKServer user has no callsign or username for the CoT session identity.'}
        now = datetime.now(timezone.utc)
        stale = now + timedelta(minutes=10)
        event = ET.Element('event', {
            'version': '2.0',
            'uid': client_uid,
            'type': 'a-f-G-U-C',
            'how': 'm-g',
            'time': _cot_time(now),
            'start': _cot_time(now),
            'stale': _cot_time(stale),
            'access': 'Undefined',
        })
        # A zero coordinate identifies the authenticated socket/EUD without falsely
        # placing the browser user at the mission object's coordinates. OTS records
        # the contact identity first and ignores 0,0 as a usable map position.
        ET.SubElement(event, 'point', {
            'lat': '0.0000000',
            'lon': '0.0000000',
            'hae': '0',
            'ce': '9999999.0',
            'le': '9999999.0',
        })
        detail = ET.SubElement(event, 'detail')
        ET.SubElement(detail, 'contact', {'callsign': callsign})
        ET.SubElement(detail, 'takv', {
            'device': 'TAK Map',
            'platform': 'TAK Map',
            'os': 'Web',
            'version': '1.3.0-i531',
        })
        ET.SubElement(detail, '__group', {'name': 'Cyan', 'role': 'Team Member'})
        ET.SubElement(detail, 'status', {'battery': '100'})
        ET.SubElement(detail, 'track', {'course': '0.0', 'speed': '0.0'})
        ET.SubElement(detail, 'takmap_user_presence', {
            'version': 'i531',
            'purpose': 'per-user-certificate-session-identity',
            'missionObject': 'false',
            'serviceCredentialFallback': 'false',
        })
        xml = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)
        return {
            'ok': True,
            'xml': xml,
            'uid': client_uid,
            'callsign': callsign,
            'username': username,
            'certificate_cn': _i529_text(credential.get('certificate_cn')),
        }

    def _i531_wait_for_cot_ingest(event_uid, timeout_seconds=5.0):
        deadline = time.monotonic() + max(0.5, min(float(timeout_seconds or 5.0), 12.0))
        attempts = []
        while True:
            try:
                result = _cot_db_lookup(event_uid, '', '', '', timeout=3)
            except Exception as exc:
                result = {'ok': False, 'error': str(exc), 'rows': []}
            attempts.append({
                'ok': bool(result.get('ok')),
                'error': _i529_text(result.get('error'))[:300],
                'row_count': len(result.get('rows') or []),
            })
            if result.get('ok'):
                return {'ok': True, 'source': 'opentakserver-cot-database', 'attempts': attempts}
            error = _i529_text(result.get('error')).lower()
            if 'no opentakserver postgresql uri' in error or 'no cot identifiers' in error:
                return {'ok': False, 'skipped': True, 'source': 'opentakserver-cot-database', 'error': result.get('error'), 'attempts': attempts}
            if time.monotonic() >= deadline:
                return {'ok': False, 'source': 'opentakserver-cot-database', 'error': 'The per-user CoT socket write was not visible in the OTS CoT database before the ingest timeout.', 'attempts': attempts}
            time.sleep(0.35)

    def _i531_send_per_user_cot(xml, event_uid=''):
        credential = _i529_current_user_credential()
        if not credential.get('ok'):
            return {
                'ok': False,
                'status': 428,
                'error': 'Per-user OpenTAKServer Data Sync identity is unavailable: ' + _i529_text(credential.get('error')),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'shared_service_fallback': False,
                'plaintext_fallback': False,
                'http_cot_fallback': False,
            }
        cfg = _i509_load_ots_config()
        try:
            host, port = _i531_cot_endpoint(cfg)
        except Exception as exc:
            return {
                'ok': False,
                'status': 503,
                'error': str(exc),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'shared_service_fallback': False,
                'plaintext_fallback': False,
                'http_cot_fallback': False,
            }
        uid = _i529_text(event_uid)
        if not uid:
            try:
                uid = _cot_xml_ids(xml)[0]
            except Exception:
                uid = ''
        started = time.monotonic()
        try:
            ctx = _i529_strict_tls_context(cfg, credential.get('ca_chain_path'))
            ctx.load_cert_chain(
                credential['certificate_path'],
                credential['private_key_path'],
                password=credential['key_password'],
            )
            raw = socket.create_connection((host, int(port)), timeout=8)
            try:
                raw.settimeout(8)
                tls = ctx.wrap_socket(raw, server_hostname=host)
            except Exception:
                try:
                    raw.close()
                except Exception:
                    pass
                raise
            presence = _i531_user_presence_xml(credential)
            if not presence.get('ok'):
                raise RuntimeError(_i529_text(presence.get('error')) or 'Could not build the authenticated user CoT session identity.')
            with tls:
                # OTS assigns the first contact-bearing CoT UID on a TLS socket as
                # the connected EUD identity. Send the authenticated user's stable
                # UID first, then the independent mission-object UID on that same
                # certificate-authenticated session. This prevents the point itself
                # from becoming an EUD while preserving per-user attribution.
                presence_payload = _normalize_traditional_xml_stream_doc(presence['xml']).encode('utf-8')
                point_payload = _normalize_traditional_xml_stream_doc(xml).encode('utf-8')
                tls.sendall(presence_payload)
                time.sleep(0.20)
                tls.sendall(point_payload)
                # Give OTS enough time to consume the second complete XML document
                # before the short-lived user-initiated connection closes.
                time.sleep(0.35)
            ingest = _i531_wait_for_cot_ingest(uid, 5.0) if uid else {'ok': False, 'skipped': True, 'error': 'No event UID was available for ingest confirmation.'}
            return {
                'ok': True,
                'status': 202,
                'host': host,
                'port': int(port),
                'tls': True,
                'strict_tls': True,
                'socket_framing': 'traditional-xml',
                'event_uid': uid,
                'duration_seconds': round(time.monotonic() - started, 3),
                'ingest_confirmation': ingest,
                'ingest_confirmed': bool(ingest.get('ok')),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'certificate_cn': credential.get('certificate_cn'),
                'client_uid': credential.get('client_uid'),
                'connection_identity_uid': presence.get('uid'),
                'connection_identity_callsign': presence.get('callsign'),
                'connection_identity_preamble_sent': True,
                'mission_object_uid': uid,
                'point_uid_used_as_eud_identity': False,
                'same_tls_session': True,
                'shared_service_fallback': False,
                'plaintext_fallback': False,
                'http_cot_fallback': False,
                'mission_cot_write_endpoint_used': False,
            }
        except Exception as exc:
            return {
                'ok': False,
                'status': 502,
                'host': host,
                'port': int(port),
                'tls': True,
                'strict_tls': True,
                'error': 'Per-user certificate-authenticated SSL CoT publication failed: ' + str(exc),
                'duration_seconds': round(time.monotonic() - started, 3),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'certificate_cn': credential.get('certificate_cn'),
                'client_uid': credential.get('client_uid'),
                'shared_service_fallback': False,
                'plaintext_fallback': False,
                'http_cot_fallback': False,
                'mission_cot_write_endpoint_used': False,
            }

    def _i526_send_native_mission_cot(mission, creator_uid, xml, server_host=''):
        event_uids = _cot_xml_ids(xml)
        event_uid = event_uids[0] if event_uids else ''
        result = dict(_i531_send_per_user_cot(xml, event_uid) or {})
        result['mission'] = _i529_text(mission)
        result['creator_uid'] = _i529_text(creator_uid)
        result['publication_stage'] = 'per-user-ssl-cot-ingest'
        result['mission_cot_endpoint'] = 'GET-only; not used for publication'
        result['mission_cot_write_endpoint'] = 'GET-only; not used for publication'
        result['mission_cot_write_endpoint_used'] = False
        return result

    globals()['_i526_send_native_mission_cot'] = _i526_send_native_mission_cot

    def _i531_associate_uid(mission, creator_uid, uid, token='', server_host=''):
        mission_q = quote(_i529_text(mission), safe='')
        creator_q = quote(_i529_text(creator_uid), safe='')
        path = f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}'
        body = json.dumps({'uids': [_i529_text(uid)]}).encode('utf-8')
        attempts = []
        for number in range(1, 7):
            result = _ots_mission_api_request(
                path,
                method='PUT',
                body=body,
                headers={'Content-Type': 'application/json', 'Content-Length': str(len(body))},
                token=token,
                public_host=server_host,
                timeout=25,
            )
            record = dict(result or {})
            record.update({
                'attempt': number,
                'method': 'PUT',
                'path': path,
                'body_variant': 'uids-json',
                'event_uid': _i529_text(uid),
            })
            attempts.append(record)
            if record.get('ok'):
                out = dict(record)
                out['attempts'] = attempts
                out['association_endpoint'] = 'mission-contents-uids'
                return out
            status = int(record.get('status') or 0)
            if status in (400, 401, 403, 405):
                break
            if number < 6:
                time.sleep(0.4)
        return {
            'ok': False,
            'error': 'Mission UID association through PUT /contents failed.',
            'event_uid': _i529_text(uid),
            'association_endpoint': 'mission-contents-uids',
            'attempts': attempts,
        }

    _i531_point_xml_before = _i526_point_xml
    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i531_point_xml_before(feature, mission_name, creator_uid)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        try:
            root = ET.fromstring(_i529_text(built.get('xml')).encode('utf-8'))
            detail = root.find('detail')
            if detail is None:
                detail = ET.SubElement(root, 'detail')
            transport = detail.find('takmap')
            if transport is None:
                transport = ET.SubElement(detail, 'takmap')
            transport.set('version', 'i531')
            transport.set('transportIdentity', 'per-user-enrolled-marti-certificate')
            transport.set('publicationFlow', 'ssl-cot-ingest-then-mission-uid-association')
            transport.set('missionCotWriteEndpoint', 'false')
            transport.set('serviceCredentialFallback', 'false')
            point_meta = detail.find('takmap_point')
            if point_meta is not None:
                point_meta.set('version', 'i531')
                point_meta.set('publicationFlow', 'ssl-cot-ingest-then-mission-uid-association')
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            built['identity_mode'] = 'per-user-enrolled-marti-certificate'
            built['publication_flow'] = 'ssl-cot-ingest-then-mission-uid-association'
            built['mission_cot_write_endpoint_used'] = False
            built['shared_service_fallback'] = False
        except Exception as exc:
            built['i531_publication_xml_warning'] = str(exc)
        return built

    globals()['_i526_point_xml'] = _i526_point_xml

    def tak_map_publish_native_points_to_mission_i526(features, mission_name='', server_host='', preferred_creator_uid=''):
        mission = _i526_text(mission_name) or os.environ.get('TAK_DASH_DEFAULT_MISSION_NAME', 'TAK Map Mission').strip() or 'TAK Map Mission'
        point_features = _i526_point_features(features, 'points')
        if not point_features:
            return {'ok': False, 'error': 'No publishable point-only Local Data selection was found.', 'publish_mode': 'per-user-cot-mission-uid-i531'}
        creator = _i528_strict_creator()
        if not creator.get('ok'):
            return {
                'ok': False,
                'error': creator.get('error'),
                'publish_mode': 'per-user-cot-mission-uid-i531',
                'creator': creator,
                'zip_package_created': False,
                'live_cot_fallback_disabled': True,
                'shared_service_fallback': False,
            }
        creator_uid = creator['uid']
        create = _i526_create_mission(mission, creator_uid, server_host)
        if not create.get('ok'):
            out = {
                'ok': False,
                'mission': mission,
                'publish_mode': 'per-user-cot-mission-uid-i531',
                'creator_uid': creator_uid,
                'creator': creator,
                'create_mission': create,
                'points': [],
                'zip_package_created': False,
                'shared_service_fallback': False,
                'error': 'The authenticated user could not create or access the selected OpenTAKServer mission.',
            }
            try:
                diag = _write_send_diag('native-mission-point-publish-i531', out, None)
                if isinstance(diag, dict):
                    out['diag_paths'] = diag
            except Exception:
                pass
            return out
        token = _extract_mission_token(create.get('json') or {})
        point_results = []
        for feature in point_features:
            built = _i526_point_xml(feature, mission, creator_uid)
            if not built.get('ok'):
                point_results.append(dict(built or {}))
                continue
            native = _i526_send_native_mission_cot(mission, creator_uid, built['xml'], server_host)
            association = {'ok': False, 'skipped': True, 'error': 'CoT ingest failed; Mission UID association was not attempted.'}
            readback = {'ok': False, 'skipped': True, 'error': 'Mission UID association was not confirmed.'}
            if native.get('ok'):
                association = _i531_associate_uid(mission, creator_uid, built['uid'], token, server_host)
                if association.get('ok'):
                    readback = _i528_confirm_readback(mission, built['uid'], creator_uid, server_host)
            item_ok = bool(native.get('ok') and association.get('ok') and readback.get('ok'))
            point_results.append({
                **{key: built.get(key) for key in ('uid', 'source_uid', 'name', 'cot_type', 'lat', 'lon', 'iconset_path', 'sidc', 'color', 'creator_uid', 'authenticated_user')},
                'ok': item_ok,
                'per_user_cot_ingest': native,
                'native_mission_cot': native,
                'associate_uid': association,
                'mission_readback': readback,
                'readback_confirmed': bool(readback.get('ok')),
                'server_confirmed': item_ok,
                'live_cot_fallback': {'ok': False, 'skipped': True, 'disabled_by': 'i531-single-supported-publication-flow'},
                'xml_preview': built['xml'][:5000],
            })
        ok = bool(point_results and len(point_results) == len(point_features) and all(row.get('ok') for row in point_results))
        event_uids = [row.get('uid') for row in point_results if row.get('uid')]
        source_uids = [row.get('source_uid') for row in point_results if row.get('source_uid')]
        out = {
            'ok': ok,
            'mission': mission,
            'publish_mode': 'per-user-cot-mission-uid-i531',
            'content_kind': 'local-data-point-native-cot',
            'point_count': len(point_features),
            'creator_uid': creator_uid,
            'creator': creator,
            'create_mission': create,
            'points': point_results,
            'event_uids': event_uids,
            'source_uids': source_uids,
            'zip_package_created': False,
            'zip_upload_skipped': True,
            'non_package_publish': True,
            'native_mission_object': True,
            'readback_confirmed': ok,
            'shared_service_fallback': False,
            'service_identity_authoring_disabled': True,
            'live_cot_fallback_disabled': True,
            'eud_creator_fallback_disabled': True,
            'plaintext_cot_fallback_disabled': True,
            'http_cot_fallback_disabled': True,
            'mission_cot_write_endpoint_disabled': True,
            'publication_flow': [
                'per-user-certificate-authenticated-ssl-cot-ingest',
                'put-mission-contents-uid-association',
                'get-mission-cot-readback',
                'local-data-reconciliation',
            ],
            'symbol_mapping': {
                'version': 'i527',
                'mode': 'selected-mil2525-sidc-to-native-cot-type',
                'preserved_by': 'i531',
                'generic_combat_fallback_avoided': True,
            },
            'message': '',
            'error': '',
        }
        if ok:
            count = len(point_features)
            prefix = 'Published point to Data Sync Mission: ' if count == 1 else f'Published {count} points to Data Sync Mission: '
            out['message'] = prefix + mission + '.'
            out['user_message'] = out['message']
            out['publish_succeeded'] = True
            out['disable_publish_after_success'] = True
            out['close_publish_modal_after_success'] = True
            out['data_sync_refresh_recommended'] = True
            out['canonical_reconcile'] = {
                'source_uids': source_uids,
                'mission_uids': event_uids,
                'mode': 'local-to-datasync-after-confirmed-readback',
                'ready': True,
            }
        else:
            failures = []
            for row in point_results:
                if row.get('ok'):
                    continue
                stage = 'CoT ingest'
                detail = row.get('per_user_cot_ingest') or {}
                if detail.get('ok'):
                    stage = 'Mission UID association'
                    detail = row.get('associate_uid') or {}
                if detail.get('ok'):
                    stage = 'Mission read-back'
                    detail = row.get('mission_readback') or {}
                failures.append((row.get('name') or 'point') + ' (' + stage + '): ' + _i529_text(detail.get('error') or 'not confirmed'))
            out['error'] = 'Per-user Data Sync point publication failed without any fallback: ' + ('; '.join(failures) or 'the authenticated user publication flow was not confirmed')
        try:
            xml_diag = '\n\n'.join(row.get('xml_preview') or '' for row in point_results)
            diag = _write_send_diag('native-mission-point-publish-i531', out, xml_diag or None)
            if isinstance(diag, dict):
                out['diag_paths'] = diag
        except Exception:
            pass
        return out

    globals()['tak_map_publish_native_points_to_mission_i526'] = tak_map_publish_native_points_to_mission_i526

    _I531_RUNTIME = r'''<script id="takMapPerUserDataSyncIdentityI531">
(function(w,d){'use strict';const V='i531',by=id=>d.getElementById(id),esc=s=>String(s==null?'':s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));let state=null,lastMarkup='';
