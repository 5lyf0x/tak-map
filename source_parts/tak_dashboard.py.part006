    def _i531_version_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i531', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i531', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i531', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i531\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i531\2', html)
        return html

    def _i531_patch_html(html):
        html = _i531_version_html(html)
        if not isinstance(html, str):
            return html
        html = re.sub(r'<script[^>]*id=["\']takMapPerUserDataSyncIdentityI529["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapPerUserDataSyncIdentityI531["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        return html.replace('</body>', _I531_RUNTIME + '\n</body>', 1) if '</body>' in html else html + _I531_RUNTIME

    TAK_MAP_HTML = _i531_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i531_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i531'

    _i531_config_before = tak_map_config
    def tak_map_config():
        cfg = _i531_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i531'
        cfg['version'] = '1.3.0-i531'
        ots = dict(cfg.get('ots_integration') or {})
        ots.update({
            'version': 'i531',
            'per_user_marti_certificate_required': True,
            'shared_service_certificate_fallback': False,
            'certificate_status_cache_ttl_seconds': int(_I531_STATUS_CACHE_TTL_SECONDS),
            'browser_identity_status_single_startup_request': True,
        })
        cfg['ots_integration'] = ots
        native = dict(cfg.get('data_sync_native_point_publish') or {})
        native.update({
            'version': 'i531',
            'publish_mode': 'per-user-cot-mission-uid-i531',
            'identity_mode': 'per-user-enrolled-marti-certificate',
            'ssl_cot_ingest_required': True,
            'connection_identity_preamble_required': True,
            'stable_user_uid_sent_first': True,
            'mission_object_uid_independent': True,
            'same_tls_session_for_identity_and_object': True,
            'point_uid_used_as_eud_identity': False,
            'mission_uid_association_endpoint': 'PUT /Marti/api/missions/{mission}/contents',
            'mission_readback_endpoint': 'GET /Marti/api/missions/{mission}/cot',
            'mission_cot_write_endpoint_used': False,
            'shared_service_certificate_fallback': False,
            'plaintext_cot_fallback': False,
            'http_cot_fallback': False,
            'zip_for_points': False,
            'readback_required_before_local_reconcile': True,
        })
        cfg['data_sync_native_point_publish'] = native
        cfg['browser_https_certificate_upgrade_policy'] = {
            'version': 'i531',
            'preserve_existing_certificate_and_key': True,
            'regenerate_only_when_missing_or_explicitly_requested': True,
            'per_user_marti_enrollment_is_separate': True,
        }
        return cfg

    globals()['tak_map_config'] = tak_map_config

    _i531_session_public_before = _i509_session_public
    def _i509_session_public(sess):
        out = dict(_i531_session_public_before(sess))
        out['version'] = 'i531'
        if isinstance(out.get('data_sync_identity'), dict):
            out['data_sync_identity'] = dict(out['data_sync_identity'])
