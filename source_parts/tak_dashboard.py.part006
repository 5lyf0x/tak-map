            'atak_point_symbol_linkage_corrected': True,
            'semantic_mission_readback_required': True,
        })
        cfg['startup_architecture_i562'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i562_package_patch_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i561', '1.3.0-i562').replace('TAKDashboard/i561', 'TAKDashboard/i562').replace('TAK-Map/1.3.0 i561', 'TAK-Map/1.3.0 i562')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i562\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i562\2', html)
        html = re.sub(r'<script[^>]+(?:tak-map-icon-registry-i\d+\.js|tak-map-popup-localdata-i\d+\.js|tak-map-context-sidebar-i\d+\.js)[^>]*></script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\'](?:takMapIconRegistryI\d+|takMapPopupLocalDataI\d+|takMapContextSidebarI\d+)["\'][^>]*></script>\s*', '', html, flags=re.I)
        if 'takMapStartupLoaderI541' not in html and '/assets/runtime/tak-map-startup-i553.js' not in html:
            return html
        scripts = '\n'.join([
            '<script id="takMapIconRegistryI562" defer src="/assets/runtime/tak-map-icon-registry-i562.js?v=1.3.0-i562"></script>',
            '<script id="takMapPopupLocalDataI562" defer src="/assets/runtime/tak-map-popup-localdata-i562.js?v=1.3.0-i562"></script>',
            '<script id="takMapContextSidebarI562" defer src="/assets/runtime/tak-map-context-sidebar-i562.js?v=1.3.0-i562"></script>',
        ])
        return html.replace('</body>', scripts + '\n</body>', 1) if '</body>' in html else html + scripts

    TAK_MAP_HTML = _i562_package_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i562_package_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i562'
except Exception as _i562_package_exc:
    try:
        print('TAK Map i562 package promotion failed:', _i562_package_exc)
    except Exception:
        pass
