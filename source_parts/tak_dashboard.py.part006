function markup(){return '<b>Data Sync identity</b><br><span style="color:'+(state&&state.ok?'#7ee787':'#ffb86b')+'">'+(state&&state.ok?'Ready':'Unavailable')+'</span><br><span>'+esc(state&&(state.certificate_cn||state.username)||'')+'</span>'+(state&&state.expires_at?'<br><span>Expires '+esc(state.expires_at)+'</span>':'')+(state&&state.error?'<br><span title="'+esc(state.error)+'">'+esc(state.error)+'</span>':'')}
function render(){try{const menu=by('takMapAccountMenuV511');if(!menu||!state)return;let box=by('takMapDataSyncIdentityI531');if(!box){box=d.createElement('div');box.id='takMapDataSyncIdentityI531';box.style.cssText='margin:8px 0;padding:8px;border:1px solid rgba(255,255,255,.1);border-radius:8px;font-size:.72rem;line-height:1.45';const actions=menu.querySelector('.tak-account-actions-v511');menu.insertBefore(box,actions||null);lastMarkup=''}const next=markup();if(next!==lastMarkup&&box.innerHTML!==next){box.innerHTML=next;lastMarkup=next}}catch(_){} }
function boot(){load();try{const mo=new MutationObserver(()=>{if(state&&by('takMapAccountMenuV511')&&!by('takMapDataSyncIdentityI531'))render()});mo.observe(d.body,{childList:true,subtree:true})}catch(_){}}
if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapPerUserDataSyncIdentityI531=Object.freeze({version:V,load,render,diagnostics:()=>state});
})(window,document);
