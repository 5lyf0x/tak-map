    _i566_normalize_before=_normalize_tak_marker
    def _normalize_tak_marker(row, source_table='cot', default_kind='cot'):
        prepared=row
        if isinstance(row,dict):
            prepared=dict(row)
            details=_i566_details_dict(row)
            location=details.get('location') if isinstance(details.get('location'),dict) else {}
            def carry(target, keys, value):
                if value in (None,''): return
                if not any(prepared.get(key) not in (None,'') for key in keys): prepared[target]=value
            carry('uid',('uid','cot_uid','event_uid','id'),row.get('data'))
            carry('type',('type','cot_type','event_type'),details.get('type'))
            carry('callsign',('callsign','call_sign','name','title'),details.get('callsign'))
            carry('lat',('lat','latitude','point_lat','point_latitude'),location.get('lat',location.get('latitude')))
            carry('lon',('lon','lng','longitude','point_lon','point_longitude'),location.get('lon',location.get('lng',location.get('longitude'))))
            custom=_i566_authoritative_custom_path(row)
            if custom: prepared['iconsetPath']=custom
        marker=_i566_normalize_before(prepared, source_table, default_kind)
        if isinstance(marker,dict) and isinstance(row,dict):
            custom=_i566_authoritative_custom_path(row)
            if custom: marker=_i566_apply_custom_path(marker, custom)
        return marker
    globals()['_normalize_tak_marker']=_normalize_tak_marker

