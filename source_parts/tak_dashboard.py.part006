        html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i566\2',html)
        html=re.sub(r'tak-map-icon-registry-i\d+\.js', 'tak-map-icon-registry-i566.js', html)
        html=re.sub(r'tak-map-popup-localdata-i\d+\.js', 'tak-map-popup-localdata-i566.js', html)
