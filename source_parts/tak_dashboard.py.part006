        runtime = {
            '/assets/runtime/tak-map-icon-registry-i567.js': (_I567_ROOT/'assets'/'tak-map-icon-registry-i567.js','application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-popup-localdata-i567.js': (_I567_ROOT/'assets'/'tak-map-popup-localdata-i567.js','application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-context-sidebar-i567.js': (_I567_ROOT/'assets'/'tak-map-context-sidebar-i567.js','application/javascript; charset=utf-8'),
        }.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i567-single-final-icon-authority')
        return _i567_get_before(self)
    Handler.do_GET = _i567_do_get

