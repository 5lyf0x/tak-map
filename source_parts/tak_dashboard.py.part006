                key = _i565_iconset_key(canonical)
                if key:
                    self._normalized[key] = row
        def get(self, key, default=None):
            exact = super().get(key)
            if exact is not None:
                return exact
            return self._normalized.get(_i565_iconset_key(key), default)
        def __contains__(self, key):
            return super().__contains__(key) or _i565_iconset_key(key) in self._normalized

    _i565_registry_load_before = _i555_registry_load
    def _i555_registry_load():
        cache = _i565_registry_load_before()
        if not isinstance(cache.get('by_path'), _I565IconPathMap):
            cache['by_path'] = _I565IconPathMap(cache.get('by_path') or {})
        return cache
    globals()['_i555_registry_load'] = _i555_registry_load

    def _i565_canonical_iconset_path(value):
        normalized = _i565_normalize_iconset_path(value)
        if not normalized:
            return ''
        try:
            row = _i555_registry_load().get('by_path', {}).get(normalized)
        except Exception:
            row = None
        return _i565_text((row or {}).get('iconsetpath')) or normalized

    def _i565_event_type(event):
        if not isinstance(event, dict):
            return ''
        return _i565_text(event.get('cot_type') or event.get('atak_cot_type') or event.get('event_type') or event.get('type'))

    def _i565_event_iconset(event):
        if not isinstance(event, dict):
            return ''
