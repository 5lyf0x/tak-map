    def _i565_normalize_iconset_path(value):
        out = _i565_text(value)
        if not out:
            return ''
        for _ in range(2):
            try:
                decoded = unquote(out)
            except Exception:
                break
            if decoded == out:
                break
            out = decoded
        out = out.replace('\\', '/')
