    def _i566_details_dict(row):
        if not isinstance(row,dict): return {}
        details=row.get('details')
        if isinstance(details,dict): return details
        if isinstance(details,str):
            try:
                parsed=json.loads(details)
                return parsed if isinstance(parsed,dict) else {}
            except Exception: return {}
        return {}

    _i566_route_like_before=_row_route_like
    def _row_route_like(row, source_key=''):
        if isinstance(row,dict):
            details=_i566_details_dict(row)
            location=details.get('location') if isinstance(details.get('location'),dict) else {}
            custom=_i566_authoritative_custom_path(row)
            explicit=' '.join(_i566_text(row.get(key)) for key in ('type','cot_type','category','name','title','filename')).casefold()
            explicit_route=bool(re.search(r'(^|[-_\s])(route|track|linestring|b-m-r|u-r)([-_\s]|$)',explicit))
            has_point_location=bool(location and any(key in location for key in ('lat','latitude')) and any(key in location for key in ('lon','lng','longitude')))
            # The legacy detector scans serialized JSON and treats the field name
            # iconsetPath as the word "path", classifying every custom point as a
