    _I553_ALIAS_PATH = _I553_ROOT / 'assets' / 'mil2525' / 'atak-compatibility-aliases-i553.json'
    _I553_RUNTIME_FILES = {
        '/assets/runtime/tak-map-core-i553.js': (_I553_ROOT / 'assets' / 'tak-map-core-i553.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-data-sync-i553.js': (_I553_ROOT / 'assets' / 'tak-map-data-sync-i553.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-startup-i553.js': (_I553_ROOT / 'assets' / 'tak-map-startup-i553.js', 'application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-deferred-i553.json': (_I553_ROOT / 'assets' / 'tak-map-deferred-i553.json', 'application/json; charset=utf-8'),
        '/assets/runtime/tak-map-milstd2525c-i553.js': (_I553_ROOT / 'assets' / 'tak-map-milstd2525c-i553.js', 'application/javascript; charset=utf-8'),
        '/mil2525/atak-compatibility-aliases-i553.json': (_I553_ALIAS_PATH, 'application/json; charset=utf-8'),
        '/assets/mil2525/atak-compatibility-aliases-i553.json': (_I553_ALIAS_PATH, 'application/json; charset=utf-8'),
    }

    def _i553_promote_symbol_fields(row):
        if not isinstance(row, dict):
            return row
        out = dict(row)
        props = dict(out.get('properties') or {}) if isinstance(out.get('properties'), dict) else {}
        pairs = (
            ('data_sync_symbol_decision_i552', 'data_sync_symbol_decision_i553'),
            ('data_sync_icon_authority_i552', 'data_sync_icon_authority_i553'),
            ('symbol_resolution_i552', 'symbol_resolution_i553'),
            ('mission_cot_raw_sidc_i552', 'mission_cot_raw_sidc_i553'),
            ('data_sync_current_sidc_i552', 'data_sync_current_sidc_i553'),
            ('mission_cot_raw_type_i552', 'mission_cot_raw_type_i553'),
            ('data_sync_current_cot_type_i552', 'data_sync_current_cot_type_i553'),
            ('mission_cot_raw_iconset_path_i552', 'mission_cot_raw_iconset_path_i553'),
            ('data_sync_current_iconset_path_i552', 'data_sync_current_iconset_path_i553'),
            ('current_iconset_path_i552', 'current_iconset_path_i553'),
            ('data_sync_symbol_fingerprint_i552', 'data_sync_symbol_fingerprint_i553'),
            ('data_sync_symbol_changed_i552', 'data_sync_symbol_changed_i553'),
            ('data_sync_upgrade_normalized_i552', 'data_sync_upgrade_normalized_i553'),
            ('data_sync_live_event_i552', 'data_sync_live_event_i553'),
        )
        for old, new in pairs:
            value = out.get(old)
            if value is None and old in props:
                value = props.get(old)
            if value is None:
                continue
            if isinstance(value, dict):
                value = dict(value)
                value['version'] = 'i553'
                if isinstance(value.get('source'), str):
                    value['source'] = value['source'].replace('i552', 'i553')
            out[new] = value
            props[new] = dict(value) if isinstance(value, dict) else value
        out['properties'] = props
        return out

    _i553_fresh_before = _tak_fresh_data_sync_result
    def _tak_fresh_data_sync_result():
        out = _i553_fresh_before()
        if not isinstance(out, dict):
            return out
        out = dict(out)
        out['objects'] = [_i553_promote_symbol_fields(row) for row in (out.get('objects') or [])]
        out['version'] = 'i553'
        diag = dict(out.get('mission_cot_symbol_enrichment_i552') or {})
        diag.update({
            'version': 'i553',
            'deferred_resolver_manifest_parity': True,
            'normal_startup_loads_reviewed_alias_resolver': True,
            'existing_i552_symbol_decisions_promoted': True,
        })
        out['mission_cot_symbol_enrichment_i553'] = diag
        snap = dict(out.get('data_sync_delete_snapshot_i552') or {})
        if snap:
            snap['version'] = 'i553'
            out['data_sync_delete_snapshot_i553'] = snap
        tombstones = out.get('data_sync_deleted_uid_tombstones_i552')
        if isinstance(tombstones, dict):
            current = dict(tombstones); current['version'] = 'i553'
            out['data_sync_deleted_uid_tombstones_i553'] = current
        return out
    globals()['_tak_fresh_data_sync_result'] = _tak_fresh_data_sync_result

    _i553_get_before = Handler.do_GET
    def _i553_do_get(self):
        parsed = urlparse(self.path)
        runtime = _I553_RUNTIME_FILES.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i553-deferred-resolver-parity')
        return _i553_get_before(self)
    Handler.do_GET = _i553_do_get

    _i553_config_before = tak_map_config
    def tak_map_config():
        cfg = _i553_config_before()
        if not isinstance(cfg, dict):
            cfg = {}
        cfg['tak_map_iteration'] = 'i553'
        cfg['version'] = '1.3.0-i553'
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version': 'i553',
            'current_response_promotes_i552_symbol_decisions': True,
            'normal_startup_reviewed_alias_resolver': True,
            'deferred_manifest_resolver_parity_required': True,
            'construction_and_howitzer_full_startup_regression': True,
        })
        cfg['data_sync_control'] = control
        mil = dict(cfg.get('milstd2525c') or {})
        mil.update({
            'version': 'i553',
            'reviewed_atak_alias_catalog': 'atak-compatibility-aliases-i553.json',
            'decision_metadata': 'data_sync_symbol_decision_i553',
            'standalone_deferred_resolver_byte_parity': True,
            'normal_startup_uses_reviewed_aliases': True,
        })
        cfg['milstd2525c'] = mil
        startup = dict(cfg.get('startup_architecture_i552') or {})
        startup.update({
            'version': 'i553',
            'startup_diagnostics_global': 'TakMapStartupDiagnosticsI553',
            'shell_ready_event': 'takmap:shell-ready-i553',
            'runtime_ready_event': 'takmap:runtime-ready-i553',
            'deferred_resolver_manifest_parity': True,
        })
        cfg['startup_architecture_i553'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i553_patch_main_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i552', '1.3.0-i553').replace('TAKDashboard/i552', 'TAKDashboard/i553').replace('TAK-Map/1.3.0 i552', 'TAK-Map/1.3.0 i553')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i553\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i553\2', html)
        html = html.replace('/assets/runtime/tak-map-startup-i552.js?v=1.3.0-i553', '/assets/runtime/tak-map-startup-i553.js?v=1.3.0-i553')
        html = html.replace('/assets/runtime/tak-map-startup-i552.js?v=1.3.0-i552', '/assets/runtime/tak-map-startup-i553.js?v=1.3.0-i553')
        return html

    TAK_MAP_HTML = _i553_patch_main_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i553_patch_main_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i553'
except Exception as _i553_exc:
    try:
        print('TAK Map i553 deferred resolver parity patch failed:', _i553_exc)
    except Exception:
        pass
# --- end TAK Map i553 deferred resolver parity and current-response promotion ---

# --- TAK Map i555 read-only icon registry + registry-managed point symbols ---
try:
    _I555_ROOT = Path(__file__).resolve().parent
    _I555_REGISTRY_LOCK = threading.RLock()
    _I555_REGISTRY_CACHE = {'path': '', 'mtime': 0.0, 'manifest': {}, 'by_path': {}, 'by_set': {}}

    def _i555_text(value):
        return str(value or '').strip()

    def _i555_registry_file():
        candidates = (
            Path('/usr/share/tak-server-dash/icon-registry/icon-registry.json'),
            _I555_ROOT / 'assets' / 'icon-registry' / 'icon-registry.json',
        )
        for candidate in candidates:
            try:
                if candidate.is_file():
                    return candidate
            except Exception:
                pass
        return candidates[-1]

    def _i555_registry_load():
        path = _i555_registry_file()
        try:
            mtime = path.stat().st_mtime
        except Exception:
            mtime = 0.0
        with _I555_REGISTRY_LOCK:
            if (_I555_REGISTRY_CACHE.get('manifest') and
                    _I555_REGISTRY_CACHE.get('path') == str(path) and
                    float(_I555_REGISTRY_CACHE.get('mtime') or 0) == float(mtime)):
                return _I555_REGISTRY_CACHE
            manifest = json.loads(path.read_text(encoding='utf-8'))
            if not isinstance(manifest, dict):
                raise RuntimeError('Icon registry manifest is not a JSON object.')
            icons = list(manifest.get('icons') or [])
            by_path = {}
            by_set = {}
            for row in icons:
                if not isinstance(row, dict):
                    continue
                iconsetpath = _i555_text(row.get('iconsetpath'))
                set_uid = _i555_text(row.get('iconset_uid'))
                if not iconsetpath or not set_uid:
                    continue
                by_path[iconsetpath] = row
                by_set.setdefault(set_uid, []).append(row)
            _I555_REGISTRY_CACHE.update({
                'path': str(path), 'mtime': float(mtime), 'manifest': manifest,
                'by_path': by_path, 'by_set': by_set,
            })
            return _I555_REGISTRY_CACHE

    def _i555_public_icon(row):
        if not isinstance(row, dict):
            return {}
        return {
            'kind': 'custom',
            'iconset_uid': _i555_text(row.get('iconset_uid')),
            'iconset_name': _i555_text(row.get('iconset_name')),
            'iconset_version': row.get('iconset_version'),
            'group_name': _i555_text(row.get('group_name')),
            'filename': _i555_text(row.get('filename')),
            'iconsetpath': _i555_text(row.get('iconsetpath')),
            'cot_type': _i555_text(row.get('type2525b')),
            'type2525b': _i555_text(row.get('type2525b')),
            'mime_type': _i555_text(row.get('mime_type')) or 'image/png',
            'width': int(row.get('width') or 0),
            'height': int(row.get('height') or 0),
            'asset_url': '/api/tak-map/icon-registry/icon?path=' + quote(_i555_text(row.get('iconsetpath')), safe=''),
        }

    def _i555_registry_summary():
        cache = _i555_registry_load()
        manifest = cache.get('manifest') or {}
        sets = []
        for row in manifest.get('sets') or []:
            if not isinstance(row, dict):
                continue
            sets.append({
                'uid': _i555_text(row.get('uid')),
                'name': _i555_text(row.get('name')),
                'version': row.get('version'),
                'type': 'custom',
                'created': _i555_text(row.get('created')),
                'icon_count': int(row.get('icon_count') or 0),
                'group_count': int(row.get('group_count') or 0),
                'groups': [dict(item) for item in (row.get('groups') or []) if isinstance(item, dict)],
            })
        return {
            'ok': True,
            'version': 'i555',
            'schema_version': int(manifest.get('schema_version') or 1),
            'read_only': True,
            'milstd2525c': dict(manifest.get('milstd2525c') or {}),
            'custom_set_count': len(sets),
            'custom_icon_count': sum(int(row.get('icon_count') or 0) for row in sets),
            'sets': sets,
            'excluded_sets': [dict(row) for row in (manifest.get('excluded_sets') or []) if isinstance(row, dict)],
            'custom_icons_fully_editable': True,
            'unregistered_custom_icons_symbol_locked': True,
            'atak_iconsetpath_identity': 'icon-set UID/group/filename',
        }

    def _i555_nested_dicts(value):
        out = []
        stack = [value]
        seen = set()
        while stack and len(out) < 96:
            current = stack.pop()
            if isinstance(current, dict):
                marker = id(current)
                if marker in seen:
                    continue
                seen.add(marker)
                out.append(current)
                for child in current.values():
                    if isinstance(child, (dict, list, tuple)):
                        stack.append(child)
            elif isinstance(current, (list, tuple)):
                stack.extend(current[:96])
        return out

    def _i555_ci_value(value, names):
        targets = {str(name).casefold() for name in names}
        for source in _i555_nested_dicts(value):
            for key, item in source.items():
                if str(key).casefold() in targets and item not in (None, ''):
                    return item
        return ''

    def _i555_object_uid(row):
        try:
            uid = _i537_object_uid(row) if callable(globals().get('_i537_object_uid')) else ''
        except Exception:
            uid = ''
        if uid:
            # The current canonical helper case-folds identities; recover the exact
            # event UID from the normalized row when available.
            for key in ('event_uid', 'cot_uid', 'uid'):
                exact = _i555_text(_i555_ci_value(row, (key,)))
                if exact and exact.casefold() == str(uid).casefold():
                    return exact
            return str(uid)
        return _i555_text(_i555_ci_value(row, ('event_uid', 'cot_uid', 'uid', 'id')))

    def _i555_object_mission(row):
        return _i555_text(_i555_ci_value(row, ('mission_name', 'missionName', 'mission')))

    def _i555_object_iconsetpath(row):
        return _i555_text(_i555_ci_value(row, (
            'data_sync_current_iconset_path_i553', 'current_iconset_path_i553',
            'mission_cot_raw_iconset_path_i553', 'iconsetpath', 'iconset_path',
            'iconsetPath', 'usericon_path', 'user_icon_path', 'icon_path',
        )))

    def _i555_object_sidc(row):
        return _i555_text(_i555_ci_value(row, (
            'data_sync_current_sidc_i553', 'mission_cot_raw_sidc_i553',
            'sidc', 'SIDC', 'mil2525_sidc', 'milstd2525_sidc', 'symbol_id', 'symbolId',
        )))

    def _i555_object_cot_type(row):
        return _i555_text(_i555_ci_value(row, (
            'data_sync_current_cot_type_i553', 'mission_cot_raw_type_i553',
            'cot_type', 'cotType', 'event_type', 'type',
        )))

    def _i555_object_name(row):
        return _i555_text(_i555_ci_value(row, ('callsign', 'name', 'title', 'label'))) or _i555_object_uid(row) or 'Point'

    def _i555_object_notes(row):
        return _i555_text(_i555_ci_value(row, ('remarks', 'notes', 'description')))

    def _i555_object_xml(row):
        # Keep the authoritative Mission CoT event available for protected
        # unregistered custom icons. A new event may only be emitted when its
        # original detail metadata can be carried forward byte-semantically.
        preferred = (
            'mission_cot_xml_i553', 'mission_cot_xml', 'event_xml', 'cot_xml',
            'raw_cot_xml', 'raw_xml', 'xml', 'cot', 'event',
        )
        targets = {name.casefold() for name in preferred}
        candidates = []
        for source in _i555_nested_dicts(row):
            for key, value in source.items():
                if str(key).casefold() not in targets or not isinstance(value, str):
                    continue
                text = value.strip()
                if '<event' in text and '</event>' in text:
                    rank = preferred.index(str(key).casefold()) if str(key).casefold() in preferred else len(preferred)
                    candidates.append((rank, len(text), text))
        if not candidates:
            return ''
        candidates.sort(key=lambda item: (item[0], -item[1]))
        return candidates[0][2][:2 * 1024 * 1024]

    def _i555_xml_local_name(tag):
        return str(tag or '').rsplit('}', 1)[-1].lower()

    def _i555_xml_usericon_path(xml_text):
        try:
            root = ET.fromstring(_i555_text(xml_text).encode('utf-8'))
            detail = root.find('detail')
            if detail is None:
                return ''
            for child in list(detail):
                if _i555_xml_local_name(child.tag) == 'usericon':
                    return _i555_text(child.attrib.get('iconsetpath') or child.attrib.get('iconsetPath'))
        except Exception:
            pass
        return ''

    def _i555_float(value):
        try:
            result = float(value)
            return result if math.isfinite(result) else None
        except Exception:
            return None

    def _i555_object_lat_lon(row):
        lat = _i555_float(_i555_ci_value(row, ('lat', 'latitude')))
        lon = _i555_float(_i555_ci_value(row, ('lon', 'lng', 'longitude')))
        if lat is not None and lon is not None and -90 <= lat <= 90 and -180 <= lon <= 180:
            return lat, lon
        return None, None

    def _i555_object_fingerprint(row):
        lat, lon = _i555_object_lat_lon(row)
        payload = {
            'uid': _i555_object_uid(row),
            'mission': _i555_object_mission(row),
            'name': _i555_object_name(row),
            'lat': round(lat, 7) if lat is not None else None,
            'lon': round(lon, 7) if lon is not None else None,
            'cot_type': _i555_object_cot_type(row),
            'sidc': _i555_object_sidc(row),
            'iconsetpath': _i555_object_iconsetpath(row),
            'notes': _i555_object_notes(row),
            'updated': _i555_text(_i555_ci_value(row, ('updated', 'time', 'start', 'added'))),
        }
        raw = json.dumps(payload, sort_keys=True, separators=(',', ':'), ensure_ascii=False)
        return hashlib.sha256(raw.encode('utf-8', 'ignore')).hexdigest()

    def _i555_point_public(row):
        lat, lon = _i555_object_lat_lon(row)
        uid = _i555_object_uid(row)
        mission = _i555_object_mission(row)
        iconsetpath = _i555_object_iconsetpath(row)
        cache = _i555_registry_load()
        registry_row = cache.get('by_path', {}).get(iconsetpath)
        is_custom = bool(iconsetpath and not iconsetpath.upper().startswith('COT_MAPPING_2525'))
        return {
            'uid': uid,
            'mission_name': mission,
            'name': _i555_object_name(row),
            'lat': lat,
            'lon': lon,
            'notes': _i555_object_notes(row),
            'cot_type': _i555_object_cot_type(row),
            'sidc': _i555_object_sidc(row),
            'iconsetpath': iconsetpath,
            'fingerprint': _i555_object_fingerprint(row),
            'source_owned': bool(uid and mission and lat is not None and lon is not None),
            'custom_icon': is_custom,
            'registered_custom_icon': bool(registry_row),
            'symbol_locked': bool(is_custom and not registry_row),
            'registry_icon': _i555_public_icon(registry_row) if registry_row else None,
        }

    def _i555_set_request_context(handler):
        sess = handler._tak_map_session() if handler._tak_map_auth_ok() else None
        token = handler._tak_map_token() if sess and callable(getattr(handler, '_tak_map_token', None)) else ''
        identity = {
            'username': (sess or {}).get('username'),
            'callsign': (sess or {}).get('callsign'),
            'tak_uid': (sess or {}).get('tak_uid') or ((sess or {}).get('profile') or {}).get('tak_uid'),
        }
        if '_I529_REQUEST_CONTEXT' in globals():
            _I529_REQUEST_CONTEXT.session_token = token
            _I529_REQUEST_CONTEXT.auth_mode = _i555_text((sess or {}).get('auth_mode'))
        if '_I512_REQUEST_CONTEXT' in globals():
            _I512_REQUEST_CONTEXT.identity = identity
            _I512_REQUEST_CONTEXT.session_token = token
        return sess or {}

    def _i555_clear_request_context():
        if '_I529_REQUEST_CONTEXT' in globals():
            _I529_REQUEST_CONTEXT.session_token = ''
            _I529_REQUEST_CONTEXT.auth_mode = ''
        if '_I512_REQUEST_CONTEXT' in globals():
            _I512_REQUEST_CONTEXT.identity = {}
            _I512_REQUEST_CONTEXT.session_token = ''
        if '_I547_REQUEST_CONTEXT' in globals():
            _I547_REQUEST_CONTEXT.force = False
            _I547_REQUEST_CONTEXT.reason = ''

    def _i555_snapshot(force=False, reason='i555-point-read'):
        if force and '_I547_REQUEST_CONTEXT' in globals():
            _I547_REQUEST_CONTEXT.force = True
            _I547_REQUEST_CONTEXT.reason = reason
        try:
            result = _tak_fresh_data_sync_result() if callable(globals().get('_tak_fresh_data_sync_result')) else tak_map_data_sync()
            return dict(result or {})
        finally:
            if force and '_I547_REQUEST_CONTEXT' in globals():
                _I547_REQUEST_CONTEXT.force = False
                _I547_REQUEST_CONTEXT.reason = ''

    def _i555_find_point(uid, mission='', force=False):
        uid_folded = _i555_text(uid).casefold()
        mission_folded = _i555_text(mission).casefold()
        if not uid_folded:
            return None
        snapshot = _i555_snapshot(force, 'i555-point-lookup')
        for row in snapshot.get('objects') or []:
            if not isinstance(row, dict):
                continue
            candidate = _i555_object_uid(row)
            if not candidate or candidate.casefold() != uid_folded:
                continue
            row_mission = _i555_object_mission(row)
            if mission_folded and row_mission and row_mission.casefold() != mission_folded:
                continue
            lat, lon = _i555_object_lat_lon(row)
            if lat is None or lon is None:
                continue
            return row
        return None

    def _i555_affiliation_code(value, default='f'):
        text = _i555_text(value).lower()
        return {'friendly': 'f', 'friend': 'f', 'f': 'f', 'hostile': 'h', 'h': 'h',
                'neutral': 'n', 'n': 'n', 'unknown': 'u', 'u': 'u'}.get(text, default)

    def _i555_custom_fallback_type(icon, affiliation='f'):
        code = _i555_affiliation_code(affiliation)
        raw = _i555_text((icon or {}).get('type2525b') or (icon or {}).get('cot_type'))
        if re.match(r'^a-[fhnu]-[A-Za-z](?:-|$)', raw):
            parts = raw.split('-')
            if len(parts) >= 3:
                parts[1] = code
                return '-'.join(parts)[:96]
        return f'a-{code}-G'

    _i555_native_uid_before = _i526_native_point_uid
    def _i526_native_point_uid(feature):
        preserve = str(_i526_value(feature, 'preserve_event_uid_i555')).strip().lower() in ('1', 'true', 'yes')
        if preserve:
            exact = _i555_text(_i526_value(feature, 'event_uid', 'cot_uid', 'uid', 'id'))
            if exact and len(exact) <= 160 and not re.search(r'[<>&"\s]', exact):
                return exact
        return _i555_native_uid_before(feature)
    globals()['_i526_native_point_uid'] = _i526_native_point_uid

    _i555_point_xml_before = _i526_point_xml
    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i555_point_xml_before(feature, mission_name, creator_uid)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        preserve_xml = _i555_text(_i526_value(feature, 'preserve_original_detail_xml_i555'))
        try:
            root = ET.fromstring(_i555_text(built.get('xml')).encode('utf-8'))
            detail = root.find('detail')
            if detail is None:
                detail = ET.SubElement(root, 'detail')
            preserved_tags = []
            if preserve_xml:
                original_root = ET.fromstring(preserve_xml.encode('utf-8'))
                original_detail = original_root.find('detail')
                if original_detail is None:
                    raise ValueError('Protected custom icon source event has no detail element.')
                # Contact/remarks/mission ownership and TAK Map diagnostics are
                # intentionally rebuilt. Every other original detail element is
                # copied intact, including usericon/icon/iconset/package metadata.
                rebuilt_tags = {
                    'contact', 'remarks', 'link', 'dest', 'creator', 'takmap',
                    'takmap_point', 'precisionlocation', 'archive',
                }
                for original_child in list(original_detail):
                    local = _i555_xml_local_name(original_child.tag)
                    if local in rebuilt_tags:
                        continue
                    for current_child in list(detail):
                        if _i555_xml_local_name(current_child.tag) == local:
                            detail.remove(current_child)
                    detail.append(ET.fromstring(ET.tostring(original_child, encoding='utf-8')))
                    preserved_tags.append(local)
            meta = detail.find('takmap_point')
            if meta is None:
                meta = ET.SubElement(detail, 'takmap_point')
            mode = _i555_text(_i526_value(feature, 'icon_mode', 'symbol_mode'))
            iconsetpath = _i555_text(_i526_value(feature, 'iconsetpath', 'iconset_path'))
            meta.set('version', 'i555')
            meta.set('iconRegistry', 'read-only-i555')
            meta.set('symbolMode', mode or ('custom-registry' if iconsetpath else 'milstd2525c'))
            if iconsetpath:
                meta.set('iconsetPath', iconsetpath[:512])
                icon = _i555_registry_load().get('by_path', {}).get(iconsetpath)
                if icon:
                    meta.set('registryManagedCustomIcon', 'true')
                    meta.set('iconsetUid', _i555_text(icon.get('iconset_uid'))[:180])
                    meta.set('iconGroup', _i555_text(icon.get('group_name'))[:180])
                    meta.set('iconFilename', _i555_text(icon.get('filename'))[:180])
            if preserve_xml:
                meta.set('protectedOriginalDetailPreserved', 'true')
                meta.set('preservedDetailTags', ','.join(sorted(set(preserved_tags)))[:512])
                built['protected_original_detail_preserved_i555'] = True
                built['preserved_detail_tags_i555'] = sorted(set(preserved_tags))
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            built['version'] = 'i555'
            built['icon_registry'] = 'read-only-i555'
        except Exception as exc:
            if preserve_xml:
                built['ok'] = False
                built['error'] = 'Protected custom icon detail preservation failed: ' + str(exc)
                built['protected_original_detail_preserved_i555'] = False
            else:
                built['i555_icon_registry_xml_warning'] = str(exc)
        return built
    globals()['_i526_point_xml'] = _i526_point_xml

    def _i555_save_point(payload):
        if not isinstance(payload, dict):
            return {'ok': False, 'error': 'Point update payload must be a JSON object.', 'version': 'i555'}, 400
        mission = _i555_text(payload.get('mission_name') or payload.get('mission'))[:180]
        if not mission:
            return {'ok': False, 'error': 'Select a Data Sync Mission.', 'version': 'i555'}, 400
        name = _i555_text(payload.get('name'))[:120] or 'TAK Map Point'
        notes = _i555_text(payload.get('notes') or payload.get('remarks'))[:3000]
        lat = _i555_float(payload.get('lat'))
        lon = _i555_float(payload.get('lon'))
        if lat is None or lon is None or not (-90 <= lat <= 90 and -180 <= lon <= 180):
            return {'ok': False, 'error': 'Enter valid latitude and longitude values.', 'version': 'i555'}, 400

        uid = _i555_text(payload.get('uid'))[:160]
        existing = None
        if uid:
            existing = _i555_find_point(uid, mission, True)
            if not existing:
                return {'ok': False, 'error': 'The source-owned Data Sync point could not be found in the selected Mission.', 'version': 'i555'}, 404
            current = _i555_point_public(existing)
            if not current.get('source_owned'):
                return {'ok': False, 'error': 'This point does not have a safe source-owned Mission identity.', 'version': 'i555'}, 409
            expected = _i555_text(payload.get('expected_fingerprint'))
            if not expected:
                return {'ok': False, 'error': 'Concurrent-edit protection requires the current point fingerprint.', 'current': current, 'version': 'i555'}, 409
            if not hmac.compare_digest(expected, current.get('fingerprint') or ''):
                return {'ok': False, 'error': 'This point changed after the editor opened. Reload the current point before saving.', 'concurrent_edit': True, 'current': current, 'version': 'i555'}, 409
        else:
            uid = str(uuid.uuid4())

        symbol = payload.get('symbol') if isinstance(payload.get('symbol'), dict) else {}
        mode = _i555_text(symbol.get('kind') or symbol.get('mode')).lower()
        affiliation = _i555_affiliation_code(payload.get('affiliation') or symbol.get('affiliation') or 'friendly')
        iconsetpath = ''
        sidc = ''
        cot_type = ''
        mil_name = ''
        mil_label = ''
        preserve_original_detail_xml = ''
        if mode == 'custom':
            iconsetpath = _i555_text(symbol.get('iconsetpath'))
            icon = _i555_registry_load().get('by_path', {}).get(iconsetpath)
            if not icon:
                return {'ok': False, 'error': 'The selected custom icon is not present in the read-only TAK Map registry.', 'version': 'i555'}, 400
            cot_type = _i555_custom_fallback_type(icon, affiliation)
        elif mode in ('unregistered', 'unregistered-custom'):
            if not existing:
                return {'ok': False, 'error': 'An unregistered custom icon cannot be assigned to a new point.', 'version': 'i555'}, 400
            current_path = _i555_object_iconsetpath(existing)
            requested_path = _i555_text(symbol.get('iconsetpath'))
            if not current_path or requested_path != current_path or current_path in _i555_registry_load().get('by_path', {}):
                return {'ok': False, 'error': 'Unregistered custom icon metadata must remain unchanged.', 'version': 'i555'}, 409
            iconsetpath = current_path
            cot_type = _i555_object_cot_type(existing) or f'a-{affiliation}-G'
            sidc = _i555_object_sidc(existing)
            preserve_original_detail_xml = _i555_object_xml(existing)
            if not preserve_original_detail_xml:
                return {'ok': False, 'error': 'This unregistered custom icon cannot be edited safely because its authoritative source CoT detail metadata is unavailable.', 'version': 'i555'}, 409
            original_path = _i555_xml_usericon_path(preserve_original_detail_xml)
            if not original_path or original_path != current_path:
                return {'ok': False, 'error': 'This unregistered custom icon cannot be edited safely because its source usericon metadata does not match the visible point.', 'version': 'i555'}, 409
        else:
            sidc = _i555_text(symbol.get('sidc'))
            try:
                normalized = _i527_normalize_sidc(sidc) if callable(globals().get('_i527_normalize_sidc')) else sidc
            except Exception:
                normalized = sidc
            sidc = _i555_text(normalized)
            if not sidc or len(sidc) < 10:
                return {'ok': False, 'error': 'Select a reviewed MIL-STD-2525C symbol or a registered custom icon.', 'version': 'i555'}, 400
            mil_name = _i555_text(symbol.get('name'))[:180]
            mil_label = _i555_text(symbol.get('label'))[:120]
            cot_type = _i555_text(symbol.get('cot_type'))

        props = {
            'uid': uid, 'cot_uid': uid, 'event_uid': uid, 'preserve_event_uid_i555': True,
            'name': name, 'callsign': name, 'notes': notes, 'remarks': notes,
            'kind': 'point', 'source': 'TAK Map Icon Registry i555',
            'mission_name': mission,
            'icon_mode': ('unregistered-custom' if mode in ('unregistered', 'unregistered-custom')
                          else ('custom-registry' if iconsetpath else 'milstd2525c')),
            'cot_type': cot_type, 'sidc': sidc,
            'mil2525_name': mil_name, 'mil2525_label': mil_label,
            'iconsetpath': iconsetpath, 'iconset_path': iconsetpath,
            'preserve_original_detail_xml_i555': preserve_original_detail_xml,
        }
        feature = {
            'type': 'Feature', 'uid': uid, 'cot_uid': uid, 'event_uid': uid,
            'geometry': {'type': 'Point', 'coordinates': [lon, lat]},
            'properties': props,
        }
        result = tak_map_publish_native_points_to_mission_i526([feature], mission, '', '')
        result = dict(result or {})
        if not result.get('ok') or not result.get('readback_confirmed'):
            return {
                'ok': False, 'error': result.get('error') or 'OpenTAKServer did not confirm the point update through Mission read-back.',
                'publish': result, 'version': 'i555', 'redraw_allowed': False,
            }, 502
        try:
            if callable(globals().get('_tak_invalidate_data_sync_cache')):
                _tak_invalidate_data_sync_cache()
        except Exception:
            pass
        confirmed = _i555_find_point(uid, mission, True)
        if not confirmed:
            return {
                'ok': False, 'error': 'OpenTAKServer confirmed publication, but the updated point was not present in the final Data Sync snapshot.',
                'publish': result, 'version': 'i555', 'redraw_allowed': False,
            }, 502
        public = _i555_point_public(confirmed)
        return {
            'ok': True, 'version': 'i555', 'message': 'Data Sync point saved and confirmed by OpenTAKServer.',
            'point': public, 'publish': result, 'redraw_allowed': True,
        }, 200

    _i555_get_before = Handler.do_GET
    def _i555_do_get(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if path == '/assets/runtime/tak-map-icon-registry-i555.js':
            return _i541_send_file(self, _I555_ROOT / 'assets' / 'tak-map-icon-registry-i555.js', 'application/javascript; charset=utf-8', 'i555-icon-registry')
        if path.startswith('/api/tak-map/icon-registry') or path == '/api/tak-map/data-sync-point-i555':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            _i555_set_request_context(self)
            try:
                query = parse_qs(parsed.query or '')
                if path == '/api/tak-map/icon-registry':
                    return self._send_json(_i555_registry_summary())
                if path == '/api/tak-map/icon-registry/icons':
                    set_uid = _i555_text((query.get('set_uid') or [''])[0])
                    cache = _i555_registry_load()
                    if set_uid not in cache.get('by_set', {}):
                        return self._send_json({'ok': False, 'error': 'Icon set not found.', 'version': 'i555'}, 404)
                    rows = [_i555_public_icon(row) for row in cache['by_set'][set_uid]]
                    return self._send_json({'ok': True, 'version': 'i555', 'set_uid': set_uid, 'icons': rows, 'count': len(rows), 'read_only': True})
                if path == '/api/tak-map/icon-registry/lookup':
                    iconsetpath = _i555_text((query.get('path') or [''])[0])
                    row = _i555_registry_load().get('by_path', {}).get(iconsetpath)
                    return self._send_json({'ok': bool(row), 'version': 'i555', 'registered': bool(row), 'icon': _i555_public_icon(row) if row else None}, 200 if row else 404)
                if path == '/api/tak-map/icon-registry/icon':
                    iconsetpath = _i555_text((query.get('path') or [''])[0])
                    row = _i555_registry_load().get('by_path', {}).get(iconsetpath)
                    if not row:
                        self.send_response(404); self.send_header('Cache-Control', 'no-store'); self.end_headers(); return
                    registry_root = _i555_registry_file().parent.resolve()
                    internal = _i555_text(row.get('internal_path'))
                    file_path = (registry_root / internal).resolve()
                    try:
                        file_path.relative_to(registry_root)
                    except Exception:
                        self.send_response(403); self.end_headers(); return
                    return _i541_send_file(self, file_path, 'image/png', 'i555-registry-custom-icon')
                if path == '/api/tak-map/data-sync-point-i555':
                    uid = _i555_text((query.get('uid') or [''])[0])
                    mission = _i555_text((query.get('mission') or [''])[0])
                    row = _i555_find_point(uid, mission, True)
                    if not row:
                        return self._send_json({'ok': False, 'error': 'Data Sync point not found.', 'version': 'i555'}, 404)
                    return self._send_json({'ok': True, 'version': 'i555', 'point': _i555_point_public(row)})
            except Exception as exc:
                return self._send_json({'ok': False, 'error': 'Icon registry request failed: ' + str(exc), 'version': 'i555'}, 500)
            finally:
                _i555_clear_request_context()
        return _i555_get_before(self)
    Handler.do_GET = _i555_do_get

    _i555_post_before = Handler.do_POST
    def _i555_do_post(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/data-sync-point-i555':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session() or {}
            if callable(globals().get('_i512_forced_change')) and _i512_forced_change(sess):
                return self._send_json({'ok': False, 'password_change_required': True, 'error': 'Change the default local administrator password first.'}, 428)
            _i555_set_request_context(self)
            try:
                reply, status = _i555_save_point(_read_json_body(self))
                return self._send_json(reply, status)
            except Exception as exc:
                return self._send_json({'ok': False, 'error': 'Data Sync point save failed: ' + str(exc), 'traceback': traceback.format_exc(), 'version': 'i555'}, 500)
            finally:
                _i555_clear_request_context()
        return _i555_post_before(self)
    Handler.do_POST = _i555_do_post

    _i555_config_before = tak_map_config
    def tak_map_config():
        cfg = _i555_config_before()
        if not isinstance(cfg, dict):
            cfg = {}
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i555'
        cfg['version'] = '1.3.0-i555'
        cfg['icon_registry'] = {
            'version': 'i555', 'read_only': True,
            'reviewed_milstd2525c_authoritative': True,
            'custom_set_count': 10, 'custom_icon_count': 3742,
            'custom_icons_fully_editable': True,
            'unregistered_custom_icons_symbol_locked': True,
            'unknown_leaflet_set_excluded': True,
            'exact_atak_iconsetpath': True,
        }
        startup = dict(cfg.get('startup_architecture_i553') or {})
        startup.update({
            'package_version': 'i555',
            'i553_shell_first_runtime_preserved': True,
            'icon_registry_plugin_non_blocking': True,
            'icon_registry_runtime': '/assets/runtime/tak-map-icon-registry-i555.js',
        })
        cfg['startup_architecture_i555'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i555_patch_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i553', '1.3.0-i555').replace('TAKDashboard/i553', 'TAKDashboard/i555').replace('TAK-Map/1.3.0 i553', 'TAK-Map/1.3.0 i555')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i555\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i555\2', html)
        html = re.sub(r'<script[^>]*id=["\']takMapIconRegistryI555["\'][^>]*></script>\s*', '', html, flags=re.I)
        # Keep login/recovery pages lean. The registry plug-in belongs only to the
        # map shell and must never delay or interfere with authentication startup.
        if 'takMapStartupLoaderI541' not in html and '/assets/runtime/tak-map-startup-i553.js' not in html:
            return html
        script = '<script id="takMapIconRegistryI555" defer src="/assets/runtime/tak-map-icon-registry-i555.js?v=1.3.0-i555"></script>'
        return html.replace('</body>', script + '\n</body>', 1) if '</body>' in html else html + script

    TAK_MAP_HTML = _i555_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i555_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i555'
except Exception as _i555_exc:
    try:
        print('TAK Map i555 icon registry patch failed:', _i555_exc)
    except Exception:
        pass
# --- end TAK Map i555 read-only icon registry + registry-managed point symbols ---


# --- TAK Map i556 corrective point popup/editor/runtime patch ---
try:
    _I556_ROOT = Path(__file__).resolve().parent
    _I556_LOCAL_LOCK = threading.RLock()

    def _i556_reply_version(value):
        if isinstance(value, dict):
            value = dict(value)
            value['version'] = 'i556'
        return value

    def _i556_local_parts(local_id):
        raw = _i555_text(local_id)
        if ':' not in raw:
            return '', None
        import_id, index_text = raw.rsplit(':', 1)
        try:
            index = int(index_text)
        except Exception:
            return '', None
        if not import_id or index < 0:
            return '', None
        return import_id, index

    def _i556_imports_data():
        data = load_json_file(TAK_MAP_IMPORT_FILE, {'imports': []})
        if not isinstance(data, dict):
            data = {'imports': []}
        imports = data.get('imports')
        if not isinstance(imports, list):
            data['imports'] = []
        return data

    def _i556_find_local_point(local_id):
        # i696: imported Local Data uses a persistent local-<uuid> identity since
        # i682. The old editor only understood import-id:feature-index, so its
        # GET/POST handlers rejected valid points already visible on the map.
        # Resolve persisted identity first, and only use a *frozen* legacy alias
        # (or an unmigrated legacy record). Never guess the current array index
        # for an ID whose original feature may have moved or been deleted.
        requested = _i555_text(local_id).strip()
        if not requested:
            return None
        normalized = requested[6:] if requested.startswith('local:') else requested
        import_id, old_index = _i556_local_parts(requested)
        data = _i556_imports_data()
        stable_matches = []
        legacy_matches = []
        for import_index, imported in enumerate(data.get('imports') or []):
            if not isinstance(imported, dict):
                continue
            candidate_id = _i555_text(imported.get('id') or imported.get('name'))
            features = imported.get('features')
            if not isinstance(features, list):
                continue
            for feature_index, feature in enumerate(features):
                if not isinstance(feature, dict):
                    continue
                stable = set()
                for key in ('object_id', 'local_id', '_local_id', 'source_id', 'canonical_id'):
                    value = _i555_text(feature.get(key)).strip()
                    if value.startswith('local:'):
                        value = value[6:]
                    if value.startswith('local-'):
                        stable.add(value)
                canonical = _i555_text(feature.get('object_id') or feature.get('local_id') or feature.get('_local_id'))
                if canonical.startswith('local:'):
                    canonical = canonical[6:]
                match = (import_index, feature_index, imported, feature, candidate_id, canonical)
                if normalized in stable:
                    stable_matches.append(match)
                    continue
                alias = _i555_text(feature.get('legacy_local_id')).strip()
                if alias and requested == alias:
                    legacy_matches.append(match)
                elif (not stable and not alias and old_index is not None
                      and candidate_id == import_id and feature_index == old_index):
                    # Backward compatibility exclusively for pre-migration data.
                    legacy_matches.append(match)
        matches = stable_matches if stable_matches else legacy_matches
        if len(matches) != 1:
            # Reject ambiguous identities rather than editing the wrong point.
            return None
        import_index, feature_index, imported, feature, candidate_id, canonical = matches[0]
        lat, lon = _i555_object_lat_lon(feature)
        kind = _i555_text(feature.get('kind') or feature.get('geometry') or feature.get('geometry_type')).lower()
        if lat is None or lon is None or any(word in kind for word in ('route', 'shape', 'polygon', 'area', 'line')):
            return None
        return {
            'data': data,
            'import_index': import_index,
            'feature_index': feature_index,
            'import': imported,
            'feature': feature,
            'local_id': canonical if canonical.startswith('local-') else f'{candidate_id}:{feature_index}',
        }

    def _i556_local_fingerprint(record):
        feature = (record or {}).get('feature') or {}
        imported = (record or {}).get('import') or {}
        lat, lon = _i555_object_lat_lon(feature)
        payload = {
            'local_id': (record or {}).get('local_id'),
            'source': _i555_text(imported.get('name') or feature.get('source')),
            'name': _i555_object_name(feature),
            'lat': round(lat, 7) if lat is not None else None,
            'lon': round(lon, 7) if lon is not None else None,
            'notes': _i555_object_notes(feature),
            'cot_type': _i555_object_cot_type(feature),
            'sidc': _i555_object_sidc(feature),
            'iconsetpath': _i555_object_iconsetpath(feature),
            'updated': _i555_text(_i555_ci_value(feature, ('updated', 'modified', 'time', 'added', 'uploaded'))),
        }
        raw = json.dumps(payload, sort_keys=True, separators=(',', ':'), ensure_ascii=False)
        return hashlib.sha256(raw.encode('utf-8', 'ignore')).hexdigest()

    def _i556_local_public(record):
        feature = (record or {}).get('feature') or {}
        imported = (record or {}).get('import') or {}
        lat, lon = _i555_object_lat_lon(feature)
        iconsetpath = _i555_object_iconsetpath(feature)
        registry_row = _i555_registry_load().get('by_path', {}).get(iconsetpath)
        is_custom = bool(iconsetpath and not iconsetpath.upper().startswith('COT_MAPPING_2525'))
        return {
            'local_id': _i555_text((record or {}).get('local_id')),
            'uid': _i555_object_uid(feature),
            'name': _i555_object_name(feature),
            'lat': lat,
            'lon': lon,
            'notes': _i555_object_notes(feature),
            'cot_type': _i555_object_cot_type(feature),
            'sidc': _i555_object_sidc(feature),
            'iconsetpath': iconsetpath,
            'source': _i555_text(imported.get('name') or feature.get('import_name') or feature.get('source')) or 'Local Data',
            'fingerprint': _i556_local_fingerprint(record),
            'source_owned': True,
            'custom_icon': is_custom,
            'registered_custom_icon': bool(registry_row),
            'symbol_locked': bool(is_custom and not registry_row),
            'registry_icon': _i555_public_icon(registry_row) if registry_row else None,
        }

    def _i556_affiliated_cot_type(current, affiliation, fallback='a-f-G'):
        code = _i555_affiliation_code(affiliation)
        raw = _i555_text(current or fallback)
        if re.match(r'^a-[fhnu]-[A-Za-z](?:-|$)', raw):
            parts = raw.split('-')
            if len(parts) >= 3:
                parts[1] = code
                return '-'.join(parts)[:96]
        return f'a-{code}-G'

    def _i556_set_local_value(feature, properties, key, value):
        feature[key] = value
        properties[key] = value

    def _i556_save_local_point(payload):
        if not isinstance(payload, dict):
            return {'ok': False, 'error': 'Point update payload must be a JSON object.', 'version': 'i556'}, 400
        local_id = _i555_text(payload.get('local_id'))
        if not local_id:
            return {'ok': False, 'error': 'A Local Data point identity is required.', 'version': 'i556'}, 400
        name = _i555_text(payload.get('name'))[:120] or 'Local Data Point'
        notes = _i555_text(payload.get('notes') or payload.get('remarks'))[:3000]
        lat = _i555_float(payload.get('lat'))
        lon = _i555_float(payload.get('lon'))
        if lat is None or lon is None or not (-90 <= lat <= 90 and -180 <= lon <= 180):
            return {'ok': False, 'error': 'Enter valid latitude and longitude values.', 'version': 'i556'}, 400

        with _I556_LOCAL_LOCK:
            record = _i556_find_local_point(local_id)
            if not record:
                return {'ok': False, 'error': 'Local Data point not found.', 'version': 'i556'}, 404
            current = _i556_local_public(record)
            expected = _i555_text(payload.get('expected_fingerprint'))
            if not expected:
                return {'ok': False, 'error': 'Concurrent-edit protection requires the current point fingerprint.', 'current': current, 'version': 'i556'}, 409
            if not hmac.compare_digest(expected, current.get('fingerprint') or ''):
                return {
                    'ok': False,
                    'error': 'This Local Data point changed after the editor opened. Reload it before saving.',
                    'concurrent_edit': True,
                    'current': current,
                    'version': 'i556',
                }, 409

            feature = dict(record['feature'])
            properties = dict(feature.get('properties') or {}) if isinstance(feature.get('properties'), dict) else {}
            symbol = payload.get('symbol') if isinstance(payload.get('symbol'), dict) else {}
            mode = _i555_text(symbol.get('kind') or symbol.get('mode')).lower()
            affiliation = _i555_affiliation_code(payload.get('affiliation') or symbol.get('affiliation') or 'friendly')
            existing_path = _i555_object_iconsetpath(feature)
            existing_sidc = _i555_object_sidc(feature)
            existing_cot = _i555_object_cot_type(feature)

            iconsetpath = ''
            sidc = ''
            cot_type = ''
            mil_name = ''
            mil_label = ''

            if mode == 'custom':
                iconsetpath = _i555_text(symbol.get('iconsetpath'))
                icon = _i555_registry_load().get('by_path', {}).get(iconsetpath)
                if not icon:
                    return {'ok': False, 'error': 'The selected custom icon is not present in the read-only TAK Map registry.', 'version': 'i556'}, 400
                cot_type = _i555_custom_fallback_type(icon, affiliation)
            elif mode in ('unregistered', 'unregistered-custom'):
                if not existing_path or existing_path in _i555_registry_load().get('by_path', {}):
                    return {'ok': False, 'error': 'This point does not contain a protected unregistered custom icon.', 'version': 'i556'}, 409
                requested_path = _i555_text(symbol.get('iconsetpath'))
                if requested_path != existing_path:
                    return {'ok': False, 'error': 'Unregistered custom icon metadata must remain unchanged.', 'version': 'i556'}, 409
                iconsetpath = existing_path
                sidc = existing_sidc
                cot_type = _i556_affiliated_cot_type(existing_cot, affiliation)
            else:
                sidc = _i555_text(symbol.get('sidc'))
                try:
                    sidc = _i555_text(_i527_normalize_sidc(sidc) if callable(globals().get('_i527_normalize_sidc')) else sidc)
                except Exception:
                    pass
                if not sidc or len(sidc) < 10:
                    return {'ok': False, 'error': 'Select a reviewed MIL-STD-2525C symbol or a registered custom icon.', 'version': 'i556'}, 400
                mil_name = _i555_text(symbol.get('name'))[:180]
                mil_label = _i555_text(symbol.get('label'))[:120]
                cot_type = _i555_text(symbol.get('cot_type')) or _i556_affiliated_cot_type(existing_cot, affiliation)
                cot_type = _i556_affiliated_cot_type(cot_type, affiliation)

            now = datetime.now(timezone.utc).isoformat()
            feature['kind'] = 'point'
            feature['geometry'] = 'point'
            feature['name'] = name
            feature['callsign'] = name
            feature['lat'] = lat
            feature['lon'] = lon
            feature['coords'] = [[lat, lon]]
            feature['notes'] = notes
            feature['remarks'] = notes
            feature['updated'] = now

            properties.update({
                'name': name,
                'callsign': name,
                'notes': notes,
                'remarks': notes,
                'kind': 'point',
                'updated': now,
                'cot_type': cot_type,
                'type': cot_type,
                'sidc': sidc,
                'mil2525_name': mil_name,
                'mil2525_label': mil_label,
                'iconsetpath': iconsetpath,
                'iconset_path': iconsetpath,
                'icon_mode': ('unregistered-custom' if mode in ('unregistered', 'unregistered-custom') else ('custom-registry' if iconsetpath else 'milstd2525c')),
            })
            if iconsetpath:
                icon = _i555_registry_load().get('by_path', {}).get(iconsetpath)
                if icon:
                    properties.update({
                        'iconset_uid': _i555_text(icon.get('iconset_uid')),
                        'iconset_name': _i555_text(icon.get('iconset_name')),
                        'icon_group': _i555_text(icon.get('group_name')),
                        'icon_filename': _i555_text(icon.get('filename')),
                    })
            else:
                for key in ('iconset_uid', 'iconset_name', 'icon_group', 'icon_filename', 'usericon_path', 'user_icon_path', 'icon_path'):
                    properties.pop(key, None)

            feature['properties'] = properties
            record['data']['imports'][record['import_index']]['features'][record['feature_index']] = feature
            try:
                record['data']['imports'][record['import_index']]['counts'] = _import_summary(record['data']['imports'][record['import_index']]['features'])
            except Exception:
                pass
            TAK_MAP_IMPORT_DIR.mkdir(parents=True, exist_ok=True)
            atomic_write_json(TAK_MAP_IMPORT_FILE, record['data'])

            saved = _i556_find_local_point(local_id)
            if not saved:
                return {'ok': False, 'error': 'The Local Data point was saved but could not be read back.', 'version': 'i556'}, 500
            return {
                'ok': True,
                'version': 'i556',
                'message': 'Local Data point saved.',
                'point': _i556_local_public(saved),
                'redraw_allowed': True,
            }, 200

    _i556_get_before = Handler.do_GET
    def _i556_do_get(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if path == '/assets/runtime/tak-map-icon-registry-i556.js':
            return _i541_send_file(self, _I556_ROOT / 'assets' / 'tak-map-icon-registry-i556.js', 'application/javascript; charset=utf-8', 'i556-icon-registry')
        if path in ('/api/tak-map/data-sync-point-i556', '/api/tak-map/local-point-i556'):
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            _i555_set_request_context(self)
            try:
                query = parse_qs(parsed.query or '')
                if path == '/api/tak-map/data-sync-point-i556':
                    uid = _i555_text((query.get('uid') or [''])[0])
                    mission = _i555_text((query.get('mission') or [''])[0])
                    row = _i555_find_point(uid, mission, True)
                    if not row:
                        return self._send_json({'ok': False, 'error': 'Data Sync point not found.', 'version': 'i556'}, 404)
                    return self._send_json({'ok': True, 'version': 'i556', 'point': _i555_point_public(row)})
                local_id = _i555_text((query.get('local_id') or [''])[0])
                record = _i556_find_local_point(local_id)
                if not record:
                    return self._send_json({'ok': False, 'error': 'Local Data point not found.', 'version': 'i556'}, 404)
                return self._send_json({'ok': True, 'version': 'i556', 'point': _i556_local_public(record)})
            except Exception as exc:
                return self._send_json({'ok': False, 'error': 'Point request failed: ' + str(exc), 'version': 'i556'}, 500)
            finally:
                _i555_clear_request_context()
        return _i556_get_before(self)
    Handler.do_GET = _i556_do_get

    _i556_post_before = Handler.do_POST
    def _i556_do_post(self):
        parsed = urlparse(self.path)
        if parsed.path in ('/api/tak-map/data-sync-point-i556', '/api/tak-map/local-point-i556'):
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session() or {}
            if callable(globals().get('_i512_forced_change')) and _i512_forced_change(sess):
                return self._send_json({'ok': False, 'password_change_required': True, 'error': 'Change the default local administrator password first.'}, 428)
            _i555_set_request_context(self)
            try:
                if parsed.path == '/api/tak-map/data-sync-point-i556':
                    reply, status = _i555_save_point(_read_json_body(self))
                    return self._send_json(_i556_reply_version(reply), status)
                reply, status = _i556_save_local_point(_read_json_body(self))
                return self._send_json(reply, status)
            except Exception as exc:
                return self._send_json({'ok': False, 'error': 'Point save failed: ' + str(exc), 'traceback': traceback.format_exc(), 'version': 'i556'}, 500)
            finally:
                _i555_clear_request_context()
        return _i556_post_before(self)
    Handler.do_POST = _i556_do_post

    _i556_config_before = tak_map_config
    def tak_map_config():
        cfg = _i556_config_before()
        if not isinstance(cfg, dict):
            cfg = {}
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i556'
        cfg['version'] = '1.3.0-i556'
        registry = dict(cfg.get('icon_registry') or {})
        registry.update({
            'version': 'i556',
            'authoritative_custom_renderer': True,
            'registered_custom_icon_redraw_after_registry_ready': True,
            'point_popup_redesign': ['data-sync', 'local-data'],
            'unified_point_editor': True,
            'point_window_map_viewport_clamped': True,
        })
        cfg['icon_registry'] = registry
        startup = dict(cfg.get('startup_architecture_i555') or cfg.get('startup_architecture_i553') or {})
        startup.update({
            'package_version': 'i556',
            'i553_shell_first_runtime_preserved': True,
            'icon_registry_plugin_non_blocking': True,
            'icon_registry_runtime': '/assets/runtime/tak-map-icon-registry-i556.js',
        })
        cfg['startup_architecture_i556'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i556_patch_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i555', '1.3.0-i556').replace('TAKDashboard/i555', 'TAKDashboard/i556').replace('TAK-Map/1.3.0 i555', 'TAK-Map/1.3.0 i556')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i556\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i556\2', html)
        html = re.sub(r'<script[^>]*id=["\']takMapIconRegistryI55[56]["\'][^>]*></script>\s*', '', html, flags=re.I)
        if 'takMapStartupLoaderI541' not in html and '/assets/runtime/tak-map-startup-i553.js' not in html:
            return html
        script = '<script id="takMapIconRegistryI556" defer src="/assets/runtime/tak-map-icon-registry-i556.js?v=1.3.0-i556"></script>'
        return html.replace('</body>', script + '\n</body>', 1) if '</body>' in html else html + script

    TAK_MAP_HTML = _i556_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i556_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i556'
except Exception as _i556_exc:
    try:
        print('TAK Map i556 corrective point patch failed:', _i556_exc)
    except Exception:
        pass
# --- end TAK Map i556 corrective point popup/editor/runtime patch ---


