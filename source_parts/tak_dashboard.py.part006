        html = re.sub(r'tak-map-icon-registry-i\d+\.js', 'tak-map-icon-registry-i567.js', html)
        html = re.sub(r'tak-map-popup-localdata-i\d+\.js', 'tak-map-popup-localdata-i567.js', html)
