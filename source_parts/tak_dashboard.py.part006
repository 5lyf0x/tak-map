    globals()['tak_map_config'] = tak_map_config

    def _i552_patch_main_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i551', '1.3.0-i552').replace('TAKDashboard/i551', 'TAKDashboard/i552').replace('TAK-Map/1.3.0 i551', 'TAK-Map/1.3.0 i552')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i552\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i552\2', html)
        html = html.replace('/assets/runtime/tak-map-startup-i551.js?v=1.3.0-i552', '/assets/runtime/tak-map-startup-i552.js?v=1.3.0-i552')
        html = html.replace('/assets/runtime/tak-map-startup-i551.js?v=1.3.0-i551', '/assets/runtime/tak-map-startup-i552.js?v=1.3.0-i552')
        return html

