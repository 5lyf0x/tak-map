        cfg = dict(_i567_config_before() or {})
        cfg['tak_map_iteration'] = 'i567'; cfg['version'] = '1.3.0-i567'
        cfg['custom_icon_resolution_i567'] = {
            'version':'i567','single_final_response_pass':True,
            'pre_augmentation_mutation':False,'raw_mission_uids_read_only':True,
            'visible_rows_cloned':True,'object_count_preserved':True,
            'nested_mission_uid_details':True,'generic_mil_fallback_suppressed':True,
        }
        startup = dict(cfg.get('startup_architecture_i566') or cfg.get('startup_architecture_i565') or {})
        startup.update({
            'package_version':'i567',
            'icon_registry_runtime':'/assets/runtime/tak-map-icon-registry-i567.js',
            'popup_localdata_runtime':'/assets/runtime/tak-map-popup-localdata-i567.js',
            'context_sidebar_runtime':'/assets/runtime/tak-map-context-sidebar-i567.js',
        })
