        obj['data_sync_symbol_changed_i552'] = bool(
            row.get('data_sync_symbol_changed_i551') or row.get('data_sync_symbol_changed_i550') or row.get('data_sync_symbol_changed_i549') or
            (before_fingerprint and obj['data_sync_symbol_fingerprint_i552'] and before_fingerprint != obj['data_sync_symbol_fingerprint_i552'])
        )
        obj['data_sync_upgrade_normalized_i552'] = True

        live = dict(obj.get('data_sync_live_event_i551') or obj.get('data_sync_live_event_i550') or obj.get('data_sync_live_event_i549') or {})
        live.update({
            'version': 'i552',
            'upgrade_normalized': True,
            'reviewed_alias_catalog': True,
            'symbol_decision': dict(decision),
        })
        obj['data_sync_live_event_i552'] = live

        props = obj.get('properties')
        if isinstance(props, dict):
            props = dict(props)
            for key in _I552_DERIVED_SYMBOL_KEYS:
                props.pop(key, None)
            for key in ('sidc', 'SIDC', 'mil2525_name', 'mil2525_file', 'mil2525_label'):
                if obj.get(key) not in (None, ''):
                    props[key] = obj.get(key)
            if resolution:
                props['symbol_resolution_i552'] = dict(resolution)
            if raw_sidc:
                props['mission_cot_raw_sidc_i552'] = raw_sidc
                props['data_sync_current_sidc_i552'] = raw_sidc
            if raw_type:
                props['mission_cot_raw_type_i552'] = raw_type
