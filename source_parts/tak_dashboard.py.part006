# --- TAK Map i531 confirmed CoT ingest/read-back correction ---
try:
    def _i531_wait_for_cot_ingest(event_uid, timeout_seconds=15.0):
        uid = _i529_text(event_uid)
        if not uid:
            return {
                'ok': False,
                'source': 'opentakserver-cot-database',
                'error': 'No exact mission-object UID was available for CoT ingest confirmation.',
                'attempts': [],
            }
        try:
            timeout_seconds = max(2.0, min(float(timeout_seconds or 15.0), 20.0))
        except Exception:
            timeout_seconds = 15.0
        deadline = time.monotonic() + timeout_seconds
        attempts = []
        while True:
            try:
                result = _cot_db_lookup(uid, '', '', '', timeout=3)
            except Exception as exc:
                result = {'ok': False, 'error': str(exc), 'rows': []}
            rows = list(result.get('rows') or []) if isinstance(result, dict) else []
            exact_rows = []
            for row in rows:
                if not isinstance(row, dict):
                    continue
                row_uid = _i529_text(row.get('uid'))
                xml_preview = _i529_text(row.get('xml_preview'))
                if row_uid == uid or uid in xml_preview:
                    exact_rows.append(row)
            attempts.append({
                'ok': bool(exact_rows),
                'error': _i529_text(result.get('error'))[:300] if isinstance(result, dict) else '',
                'row_count': len(rows),
                'exact_row_count': len(exact_rows),
            })
            if exact_rows:
                return {
                    'ok': True,
                    'source': 'opentakserver-cot-database-exact-uid',
                    'event_uid': uid,
                    'rows': exact_rows[:4],
                    'attempts': attempts,
                }
            error = _i529_text(result.get('error')).lower() if isinstance(result, dict) else ''
            if 'no opentakserver postgresql uri' in error:
                return {
                    'ok': False,
                    'source': 'opentakserver-cot-database',
                    'event_uid': uid,
                    'error': result.get('error'),
                    'attempts': attempts,
                }
            if time.monotonic() >= deadline:
                return {
                    'ok': False,
                    'source': 'opentakserver-cot-database-exact-uid',
                    'event_uid': uid,
                    'error': 'The exact mission-object UID was not visible in the OpenTAKServer CoT database before the ingest timeout.',
                    'attempts': attempts,
                }
            time.sleep(0.35)

    globals()['_i531_wait_for_cot_ingest'] = _i531_wait_for_cot_ingest

    def _i531_send_per_user_cot(xml, event_uid=''):
        credential = _i529_current_user_credential()
        if not credential.get('ok'):
            return {
                'ok': False,
                'status': 428,
                'error': 'Per-user OpenTAKServer Data Sync identity is unavailable: ' + _i529_text(credential.get('error')),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'shared_service_fallback': False,
                'plaintext_fallback': False,
                'http_cot_fallback': False,
            }
        cfg = _i509_load_ots_config()
        try:
            host, port = _i531_cot_endpoint(cfg)
        except Exception as exc:
            return {
                'ok': False,
                'status': 503,
                'error': str(exc),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'shared_service_fallback': False,
                'plaintext_fallback': False,
                'http_cot_fallback': False,
            }
        uid = _i529_text(event_uid)
        if not uid:
            try:
                uid = _cot_xml_ids(xml)[0]
            except Exception:
                uid = ''
        started = time.monotonic()
        tls = None
        try:
            ctx = _i529_strict_tls_context(cfg, credential.get('ca_chain_path'))
            ctx.load_cert_chain(
                credential['certificate_path'],
                credential['private_key_path'],
                password=credential['key_password'],
            )
            raw = socket.create_connection((host, int(port)), timeout=8)
            try:
                raw.settimeout(8)
                tls = ctx.wrap_socket(raw, server_hostname=host)
            except Exception:
                try:
                    raw.close()
                except Exception:
                    pass
                raise
            presence = _i531_user_presence_xml(credential)
            if not presence.get('ok'):
                raise RuntimeError(_i529_text(presence.get('error')) or 'Could not build the authenticated user CoT session identity.')
            presence_payload = _normalize_traditional_xml_stream_doc(presence['xml']).encode('utf-8')
            point_payload = _normalize_traditional_xml_stream_doc(xml).encode('utf-8')
            with tls:
                tls.sendall(presence_payload)
                time.sleep(0.25)
                tls.sendall(point_payload)
                # Keep this exact certificate-authenticated socket open while OTS
                # initializes its per-connection parser/RabbitMQ channel and flushes
                # any CoT documents temporarily cached by that connection.
                ingest = _i531_wait_for_cot_ingest(uid, 15.0)
                if not ingest.get('ok'):
                    return {
                        'ok': False,
                        'status': 504,
                        'host': host,
                        'port': int(port),
                        'tls': True,
                        'strict_tls': True,
                        'socket_framing': 'traditional-xml',
                        'event_uid': uid,
                        'duration_seconds': round(time.monotonic() - started, 3),
                        'ingest_confirmation': ingest,
                        'ingest_confirmed': False,
                        'error': _i529_text(ingest.get('error')) or 'The exact mission-object UID was not confirmed in OpenTAKServer CoT ingest.',
                        'identity_mode': 'per-user-enrolled-marti-certificate',
                        'certificate_cn': credential.get('certificate_cn'),
                        'client_uid': credential.get('client_uid'),
                        'connection_identity_uid': presence.get('uid'),
                        'connection_identity_callsign': presence.get('callsign'),
                        'connection_identity_preamble_sent': True,
                        'mission_object_uid': uid,
                        'point_uid_used_as_eud_identity': False,
                        'same_tls_session': True,
                        'socket_held_open_through_ingest_confirmation': True,
                        'shared_service_fallback': False,
                        'plaintext_fallback': False,
                        'http_cot_fallback': False,
                        'mission_cot_write_endpoint_used': False,
                    }
            return {
                'ok': True,
                'status': 202,
                'host': host,
                'port': int(port),
                'tls': True,
                'strict_tls': True,
                'socket_framing': 'traditional-xml',
                'event_uid': uid,
                'duration_seconds': round(time.monotonic() - started, 3),
                'ingest_confirmation': ingest,
                'ingest_confirmed': True,
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'certificate_cn': credential.get('certificate_cn'),
                'client_uid': credential.get('client_uid'),
                'connection_identity_uid': presence.get('uid'),
                'connection_identity_callsign': presence.get('callsign'),
                'connection_identity_preamble_sent': True,
                'mission_object_uid': uid,
                'point_uid_used_as_eud_identity': False,
                'same_tls_session': True,
                'socket_held_open_through_ingest_confirmation': True,
                'shared_service_fallback': False,
                'plaintext_fallback': False,
                'http_cot_fallback': False,
                'mission_cot_write_endpoint_used': False,
            }
        except Exception as exc:
            return {
                'ok': False,
                'status': 502,
                'host': host,
                'port': int(port),
                'tls': True,
                'strict_tls': True,
                'error': 'Per-user certificate-authenticated SSL CoT publication failed: ' + str(exc),
                'duration_seconds': round(time.monotonic() - started, 3),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'certificate_cn': credential.get('certificate_cn'),
                'client_uid': credential.get('client_uid'),
                'shared_service_fallback': False,
                'plaintext_fallback': False,
                'http_cot_fallback': False,
                'mission_cot_write_endpoint_used': False,
            }

    globals()['_i531_send_per_user_cot'] = _i531_send_per_user_cot

    def _i526_send_native_mission_cot(mission, creator_uid, xml, server_host=''):
        event_uids = _cot_xml_ids(xml)
        event_uid = event_uids[0] if event_uids else ''
        result = dict(_i531_send_per_user_cot(xml, event_uid) or {})
        result['mission'] = _i529_text(mission)
        result['creator_uid'] = _i529_text(creator_uid)
        result['publication_stage'] = 'per-user-ssl-cot-ingest-exact-uid-confirmed'
        result['mission_cot_endpoint'] = 'GET-only; used only for exact UID read-back'
        result['mission_cot_write_endpoint'] = 'GET-only; not used for publication'
        result['mission_cot_write_endpoint_used'] = False
        return result

    globals()['_i526_send_native_mission_cot'] = _i526_send_native_mission_cot

    def _i531_associate_uid(mission, creator_uid, uid, token='', server_host=''):
        mission_q = quote(_i529_text(mission), safe='')
        creator_q = quote(_i529_text(creator_uid), safe='')
        path = f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}'
        body = json.dumps({'uids': [_i529_text(uid)]}).encode('utf-8')
        attempts = []
        for number in range(1, 7):
            result = _ots_mission_api_request(
                path,
                method='PUT',
                body=body,
                headers={'Content-Type': 'application/json', 'Content-Length': str(len(body))},
                token=token,
                public_host=server_host,
                timeout=25,
            )
            record = dict(result or {})
            record.update({
                'attempt': number,
                'method': 'PUT',
                'path': path,
                'body_variant': 'uids-json',
                'event_uid': _i529_text(uid),
            })
            attempts.append(record)
            status = int(record.get('status') or 0)
            if record.get('ok') or status == 409:
                out = dict(record)
                out['ok'] = True
                out['attempts'] = attempts
                out['association_endpoint'] = 'mission-contents-uids'
                out['already_associated'] = status == 409
                out['provisional_until_exact_cot_readback'] = status == 409
                return out
            if status in (400, 401, 403, 405):
                break
            if number < 6:
                time.sleep(0.4)
        return {
            'ok': False,
            'error': 'Mission UID association through PUT /contents failed.',
            'event_uid': _i529_text(uid),
            'association_endpoint': 'mission-contents-uids',
            'attempts': attempts,
        }

    globals()['_i531_associate_uid'] = _i531_associate_uid

    def _i528_confirm_readback(mission, uid, creator_uid, server_host=''):
        mission_q = quote(_i529_text(mission), safe='')
        creator_q = quote(_i529_text(creator_uid), safe='')
        event_uid = _i529_text(uid)
        path = f'/Marti/api/missions/{mission_q}/cot?creatorUid={creator_q}'
        history = []
        for attempt in range(1, 13):
            result = _ots_mission_api_request(path, method='GET', public_host=server_host, timeout=20)
            body = result.get('body') if isinstance(result, dict) else ''
            payload = result.get('json') if isinstance(result, dict) else None
            exact = bool(result.get('ok') and (
                _i528_blob_contains_uid(payload, event_uid)
                or _i528_blob_contains_uid(body, event_uid)
            )) if isinstance(result, dict) else False
            history.append({
                'attempt': attempt,
                'path': path,
                'status': result.get('status') if isinstance(result, dict) else None,
                'ok': bool(result.get('ok')) if isinstance(result, dict) else False,
                'exact_uid_present': exact,
                'error': _i529_text(result.get('error'))[:300] if isinstance(result, dict) else '',
            })
            if exact:
                return {
                    'ok': True,
                    'source': 'mission-api-get-cot-exact-uid',
                    'event_uid': event_uid,
                    'path': path,
                    'attempts': history,
                    'mission_uid_row_alone_counts_as_readback': False,
                }
            if attempt < 12:
                time.sleep(0.5)
        return {
            'ok': False,
            'source': 'mission-api-get-cot-exact-uid',
            'event_uid': event_uid,
            'path': path,
            'attempts': history,
            'mission_uid_row_alone_counts_as_readback': False,
            'error': 'The exact point UID was not returned by the Mission GET /cot read-back endpoint. Local Data was retained.',
        }

    globals()['_i528_confirm_readback'] = _i528_confirm_readback

    def _i528_refresh_mission_point_keys(force=False):
        now = time.monotonic()
        with _I528_POINT_CACHE_LOCK:
            if not force and now - float(_I528_POINT_CACHE.get('time') or 0) < 3.0:
                return set(_I528_POINT_CACHE.get('uids') or set()), set(_I528_POINT_CACHE.get('names') or set())
        associated = {}
        cot_rows = {}
        try:
            pg_uris, _ = _candidate_ots_pg_uris()
        except Exception:
            pg_uris = []
        for uri in (pg_uris or [])[:1]:
            try:
                mission_rows, _ = _pg_table_rows(uri, 'mission_uids', 1500)
            except Exception:
                mission_rows = []
            for row in mission_rows or []:
                if not isinstance(row, dict):
                    continue
                uid = _i526_text(row.get('uid') or row.get('id') or row.get('cot_uid'))
                if uid.upper().startswith(_I528_MISSION_POINT_PREFIX):
                    associated[uid.lower()] = row
            try:
                rows, _ = _pg_table_rows(uri, 'cot', 1500)
            except Exception:
                rows = []
            for row in rows or []:
                if not isinstance(row, dict):
                    continue
                uid = _i526_text(row.get('uid') or row.get('id') or row.get('cot_uid'))
                if uid.upper().startswith(_I528_MISSION_POINT_PREFIX):
                    cot_rows[uid.lower()] = row
            break
        uids = set(associated) & set(cot_rows)
        names = set()
        for uid in uids:
            for row in (associated.get(uid), cot_rows.get(uid)):
                if not isinstance(row, dict):
                    continue
                for key in ('callsign', 'name', 'title', 'sender_callsign'):
                    value = _i526_text(row.get(key)).lower()
                    if value:
                        names.add(value)
        with _I528_POINT_CACHE_LOCK:
            _I528_POINT_CACHE.update({'time': now, 'uids': set(uids), 'names': set(names)})
        return uids, names

    globals()['_i528_refresh_mission_point_keys'] = _i528_refresh_mission_point_keys

    _I531_RECONCILE_RUNTIME = r'''<script id="takMapMissionPointReconcileI531">
(function(w,d){'use strict';
  const V='i531',P='takmap-mission-point-',uids=new Set();
  const txt=v=>{try{return String(v==null?'':v)}catch(_){return ''}},lc=v=>txt(v).toLowerCase().trim();
  function learn(j){try{(j&&j.objects||[]).forEach(function(o){const u=lc(o&&(o.uid||o.id||o.cot_uid));if(u.startsWith(P))uids.add(u)})}catch(_){}return j}
  function isCanonicalMissionPoint(o){try{const u=lc(o&&(o.uid||o.id||o.cot_uid||o.event_uid));return !!u&&uids.has(u)}catch(_){return false}}
  function filter(j){try{if(j&&Array.isArray(j.markers))j.markers=j.markers.filter(x=>!isCanonicalMissionPoint(x));if(j&&Array.isArray(j.euds))j.euds=j.euds.filter(x=>!isCanonicalMissionPoint(x))}catch(_){}return j}
  function refreshAfterReconcile(j){try{if(j&&j.ok&&j.readback_confirmed&&j.local_reconcile&&j.local_reconcile.deleted){setTimeout(function(){try{if(typeof w.refreshLocalData==='function')w.refreshLocalData()}catch(_){}try{if(typeof w.forceDataSyncSync==='function')w.forceDataSyncSync('i531-confirmed-local-to-datasync-reconcile')}catch(_){}},80)}}catch(_){}return j}
  function patchFetch(){if(w.__takI531MissionReconcileFetchPatched||typeof w.fetch!=='function')return;const base=w.fetch;w.fetch=function(input,init){const url=txt((input&&input.url)||input||''),p=base.apply(this,arguments);if(!/\/api\/tak-map\/(data-sync|cot|euds|local-data-mission-publish)/.test(url))return p;return p.then(function(resp){try{resp.clone().json().then(function(j){if(url.includes('/data-sync'))learn(j);if(url.includes('/cot')||url.includes('/euds'))filter(j);if(url.includes('/local-data-mission-publish'))refreshAfterReconcile(j)}).catch(function(){})}catch(_){}return resp})};w.__takI531MissionReconcileFetchPatched=true}
  function boot(){patchFetch()}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
  w.TakMapMissionPointReconcileI531=Object.freeze({version:V,learn,filter,isCanonicalMissionPoint,diagnostics:()=>({version:V,uids:[...uids],fetchPatched:!!w.__takI531MissionReconcileFetchPatched})});
})(window,document);
</script>'''

    def _i531_confirmed_patch_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'<script[^>]*id=["\']takMapMissionPointReconcileI528["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapMissionPointReconcileI531["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        return html.replace('</body>', _I531_RECONCILE_RUNTIME + '\n</body>', 1) if '</body>' in html else html + _I531_RECONCILE_RUNTIME

    TAK_MAP_HTML = _i531_confirmed_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML

    _i531_confirmed_config_before = tak_map_config
    def tak_map_config():
        cfg = _i531_confirmed_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        native = dict(cfg.get('data_sync_native_point_publish') or {})
        native.update({
            'version': 'i531',
            'success_requires_exact_cot_ingest_confirmation': True,
            'cot_socket_held_open_through_ingest_confirmation': True,
            'ingest_confirmation_timeout_seconds': 15,
            'association_requires_confirmed_ingest': True,
            'mission_readback_requires_exact_uid_from_get_cot': True,
            'mission_uid_row_alone_counts_as_readback': False,
            'orphan_mission_uid_suppresses_local_marker': False,
            'client_reconcile_learns_from_objects_only': True,
        })
        cfg['data_sync_native_point_publish'] = native
        return cfg

    globals()['tak_map_config'] = tak_map_config

    _i531_confirmed_data_sync_before = tak_map_data_sync
    def tak_map_data_sync():
        out = _i531_confirmed_data_sync_before()
        if isinstance(out, dict):
            out['confirmed_point_publication_i531'] = {
                'version': 'i531',
                'exact_cot_ingest_required_before_association': True,
                'exact_mission_get_cot_readback_required': True,
                'mission_uid_row_alone_is_not_readback': True,
                'orphan_mission_uid_client_suppression_disabled': True,
                'shared_service_fallback': False,
            }
        return out

    globals()['tak_map_data_sync'] = tak_map_data_sync
except Exception as _i531_confirmed_exc:
    try:
        print('TAK Map i531 confirmed CoT ingest/read-back correction failed:', _i531_confirmed_exc)
    except Exception:
        pass
# --- end TAK Map i531 confirmed CoT ingest/read-back correction ---


# --- TAK Map i531 UID-only live mission-point suppression ---
try:
    def _i528_is_mission_point_live_row(row, xml=''):
        values, _labels = _i528_row_identity(row)
        if any(value.upper().startswith(_I528_MISSION_POINT_PREFIX) for value in values):
            return True
        try:
            for uid in _cot_xml_ids(_i526_text(xml)):
                if _i526_text(uid).upper().startswith(_I528_MISSION_POINT_PREFIX):
                    return True
        except Exception:
            pass
        uids, _names = _i528_refresh_mission_point_keys(False)
        return bool(values & uids)

    globals()['_i528_is_mission_point_live_row'] = _i528_is_mission_point_live_row
except Exception as _i531_uid_suppression_exc:
    try:
        print('TAK Map i531 UID-only live mission-point suppression patch failed:', _i531_uid_suppression_exc)
    except Exception:
        pass
# --- end TAK Map i531 UID-only live mission-point suppression ---

# --- TAK Map i532 persistent per-user EUD session + confirmed Local Data reconciliation ---
try:
    import atexit as _i532_atexit

    _I532_PRESENCE_GUARD = threading.RLock()
    _I532_PRESENCE = {}
    _I532_TOKEN_KEYS = {}
    _I532_HEARTBEAT_SECONDS = 30.0
    _I532_RECONNECT_SECONDS = 5.0

    _i532_certificate_status_before = _i529_public_certificate_status
    def _i529_public_certificate_status(username, expected_uid=''):
        status = _i532_certificate_status_before(username, expected_uid)
        if isinstance(status, dict):
            status = dict(status)
            status['version'] = 'i532'
            status['shared_service_fallback'] = False
        return status
    globals()['_i529_public_certificate_status'] = _i529_public_certificate_status

    def _i532_session_snapshot(token):
        token = _i529_text(token)
        if not token:
            return {}
        with TAK_MAP_SESSIONS_LOCK:
            sess = TAK_MAP_SESSIONS.get(token)
            if not isinstance(sess, dict):
                return {}
            if float(sess.get('expires') or 0) <= time.time():
                return {}
            return dict(sess)

    def _i532_session_identity(sess):
        sess = sess if isinstance(sess, dict) else {}
        profile = dict(sess.get('profile') or {})
        username = _i529_text(profile.get('username') or sess.get('username'))
        callsign = _i529_text(
            profile.get('selected_callsign')
            or profile.get('callsign')
            or profile.get('suggested_callsign')
            or sess.get('callsign')
            or sess.get('display_identity')
            or username
        )
        uid = _i529_text(sess.get('tak_uid') or profile.get('tak_uid'))
        return {'username': username, 'callsign': callsign, 'uid': uid}

    def _i532_presence_key(sess):
        ident = _i532_session_identity(sess)
        return (_i529_text(ident.get('uid')) or ('user:' + _i529_text(ident.get('username')))).lower()

    def _i532_session_credential(sess):
        ident = _i532_session_identity(sess)
        status = dict(_i529_public_certificate_status(ident.get('username'), ident.get('uid')) or {})
        status['username'] = ident.get('username') or status.get('username')
        status['client_uid'] = ident.get('uid') or status.get('client_uid')
        status['callsign'] = ident.get('callsign')
        return status

    def _i532_presence_xml(sess, credential):
        ident = _i532_session_identity(sess)
        client_uid = _i529_text(ident.get('uid') or credential.get('client_uid'))
        username = _i529_text(ident.get('username') or credential.get('username') or credential.get('certificate_cn'))
        callsign = _i529_text(ident.get('callsign') or username or credential.get('certificate_cn'))
        if not client_uid:
            return {'ok': False, 'error': 'The authenticated OTS user has no stable TAK UID for persistent EUD presence.'}
        if not callsign:
            return {'ok': False, 'error': 'The authenticated OTS user has no callsign or username for persistent EUD presence.'}
        now = datetime.now(timezone.utc)
        stale = now + timedelta(minutes=3)
        event = ET.Element('event', {
            'version': '2.0',
            'uid': client_uid,
            'type': 'a-f-G-U-C',
            'how': 'm-g',
            'time': _cot_time(now),
            'start': _cot_time(now),
            'stale': _cot_time(stale),
            'access': 'Undefined',
        })
        ET.SubElement(event, 'point', {
            'lat': '0.0000000',
            'lon': '0.0000000',
            'hae': '0',
            'ce': '9999999.0',
            'le': '9999999.0',
        })
        detail = ET.SubElement(event, 'detail')
        ET.SubElement(detail, 'contact', {'callsign': callsign, 'endpoint': '*:-1:stcp'})
        ET.SubElement(detail, 'uid', {'Droid': callsign})
        ET.SubElement(detail, 'takv', {
            'device': 'TAK Map',
            'platform': 'TAK Map',
            'os': 'Web',
            'version': '1.3.0-i532',
        })
        ET.SubElement(detail, '__group', {'name': 'Cyan', 'role': 'Team Member'})
        ET.SubElement(detail, 'status', {'battery': '100'})
        ET.SubElement(detail, 'track', {'course': '0.0', 'speed': '0.0'})
        ET.SubElement(detail, 'takmap_user_presence', {
            'version': 'i532',
            'purpose': 'persistent-authenticated-web-session-eud',
            'username': username,
            'callsign': callsign,
            'missionObject': 'false',
            'serviceCredentialFallback': 'false',
        })
        xml = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)
        return {'ok': True, 'xml': xml, 'uid': client_uid, 'callsign': callsign, 'username': username}

    def _i532_close_locked(state, reason='disconnected'):
        tls = state.get('tls')
        state['tls'] = None
        if tls is not None:
            try:
                tls.shutdown(socket.SHUT_RDWR)
            except Exception:
                pass
            try:
                tls.close()
            except Exception:
                pass
        state['connected'] = False
        state['state'] = 'disconnected'
        state['disconnect_reason'] = _i529_text(reason)
        state['disconnected_at'] = datetime.now(timezone.utc).isoformat()

    def _i532_live_session(state):
        live = []
        for token in list(state.get('tokens') or set()):
            sess = _i532_session_snapshot(token)
            if sess and _i529_text(sess.get('auth_mode')).startswith('ots-'):
                live.append((token, sess))
            else:
                state['tokens'].discard(token)
                with _I532_PRESENCE_GUARD:
                    _I532_TOKEN_KEYS.pop(token, None)
        if not live:
            return '', {}
        live.sort(key=lambda pair: float(pair[1].get('created') or 0), reverse=True)
        return live[0]

    def _i532_connect_locked(state, sess):
        credential = _i532_session_credential(sess)
        if not credential.get('ok'):
            raise RuntimeError('Per-user OTS certificate unavailable: ' + _i529_text(credential.get('error')))
        cfg = _i509_load_ots_config()
        host, port = _i531_cot_endpoint(cfg)
        presence = _i532_presence_xml(sess, credential)
        if not presence.get('ok'):
            raise RuntimeError(_i529_text(presence.get('error')))
        _i532_close_locked(state, 'reconnecting')
        ctx = _i529_strict_tls_context(cfg, credential.get('ca_chain_path'))
        ctx.load_cert_chain(
            credential['certificate_path'],
            credential['private_key_path'],
            password=credential['key_password'],
        )
        raw = socket.create_connection((host, int(port)), timeout=8)
        try:
            raw.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        except Exception:
            pass
        try:
            raw.settimeout(10)
            tls = ctx.wrap_socket(raw, server_hostname=host)
        except Exception:
            try:
                raw.close()
            except Exception:
                pass
            raise
        payload = _normalize_traditional_xml_stream_doc(presence['xml']).encode('utf-8')
        tls.sendall(payload)
        state.update({
            'tls': tls,
            'connected': True,
            'state': 'connected',
            'host': host,
            'port': int(port),
            'certificate_cn': credential.get('certificate_cn'),
            'client_uid': presence.get('uid'),
            'callsign': presence.get('callsign'),
            'username': presence.get('username'),
            'connected_at': datetime.now(timezone.utc).isoformat(),
            'last_heartbeat_at': datetime.now(timezone.utc).isoformat(),
            'last_heartbeat_monotonic': time.monotonic(),
            'last_error': '',
            'disconnect_reason': '',
        })
        return presence

    def _i532_send_presence_locked(state, sess, force=False):
        current = _i532_session_identity(sess)
        age = time.monotonic() - float(state.get('last_heartbeat_monotonic') or 0)
        changed = _i529_text(current.get('callsign')) != _i529_text(state.get('callsign'))
        if not force and state.get('tls') is not None and age < _I532_HEARTBEAT_SECONDS and not changed:
            return {'ok': True, 'uid': state.get('client_uid'), 'callsign': state.get('callsign')}
        if state.get('tls') is None:
            return _i532_connect_locked(state, sess)
        credential = _i532_session_credential(sess)
        presence = _i532_presence_xml(sess, credential)
        if not presence.get('ok'):
            raise RuntimeError(_i529_text(presence.get('error')))
        state['tls'].sendall(_normalize_traditional_xml_stream_doc(presence['xml']).encode('utf-8'))
        state.update({
            'callsign': presence.get('callsign'),
            'username': presence.get('username'),
            'client_uid': presence.get('uid'),
            'last_heartbeat_at': datetime.now(timezone.utc).isoformat(),
            'last_heartbeat_monotonic': time.monotonic(),
            'connected': True,
            'state': 'connected',
            'last_error': '',
        })
        return presence

    def _i532_presence_worker(key, state):
        try:
            while not state['stop'].is_set():
                token, sess = _i532_live_session(state)
                if not token or not sess:
                    break
                delay = _I532_HEARTBEAT_SECONDS
                try:
                    with state['io_lock']:
                        _i532_send_presence_locked(state, sess, force=state.get('tls') is None)
                except Exception as exc:
                    with state['io_lock']:
                        state['last_error'] = str(exc)
                        state['state'] = 'reconnecting'
                        _i532_close_locked(state, 'connection-error')
                    delay = _I532_RECONNECT_SECONDS
                state['wake'].wait(delay)
                state['wake'].clear()
        finally:
            with state['io_lock']:
                _i532_close_locked(state, 'logout-or-session-expired')
            with _I532_PRESENCE_GUARD:
                if _I532_PRESENCE.get(key) is state:
                    _I532_PRESENCE.pop(key, None)
                for token in list(state.get('tokens') or set()):
                    if _I532_TOKEN_KEYS.get(token) == key:
                        _I532_TOKEN_KEYS.pop(token, None)

    def _i532_ensure_presence(token, sess=None):
        token = _i529_text(token)
        sess = dict(sess or _i532_session_snapshot(token) or {})
        if not token or not sess or not _i529_text(sess.get('auth_mode')).startswith('ots-'):
            return {'ok': False, 'state': 'not-applicable', 'connected': False, 'error': 'Persistent EUD presence requires an authenticated OpenTAKServer session.'}
        key = _i532_presence_key(sess)
        if not key:
            return {'ok': False, 'state': 'unavailable', 'connected': False, 'error': 'No stable per-user identity is available for persistent EUD presence.'}
        start = False
        with _I532_PRESENCE_GUARD:
            state = _I532_PRESENCE.get(key)
            if state is None or state.get('stop').is_set():
                state = {
                    'key': key,
                    'tokens': set(),
                    'stop': threading.Event(),
                    'wake': threading.Event(),
                    'io_lock': threading.RLock(),
                    'tls': None,
                    'connected': False,
                    'state': 'starting',
                    'last_error': '',
                }
                _I532_PRESENCE[key] = state
                start = True
            state['tokens'].add(token)
            _I532_TOKEN_KEYS[token] = key
        if start:
            thread = threading.Thread(target=_i532_presence_worker, args=(key, state), name='tak-map-i532-eud-' + hashlib.sha256(key.encode()).hexdigest()[:8], daemon=True)
            state['thread'] = thread
            thread.start()
        else:
            state['wake'].set()
        return _i532_presence_public(token, state)

    def _i532_presence_public(token='', state=None):
        token = _i529_text(token)
        if state is None:
            with _I532_PRESENCE_GUARD:
                key = _I532_TOKEN_KEYS.get(token, '')
                state = _I532_PRESENCE.get(key)
        if not isinstance(state, dict):
            return {'ok': False, 'version': 'i532', 'state': 'disconnected', 'connected': False, 'persistent': True}
        return {
            'ok': bool(state.get('connected')),
            'version': 'i532',
            'state': _i529_text(state.get('state') or ('connected' if state.get('connected') else 'starting')),
            'connected': bool(state.get('connected')),
            'persistent': True,
            'username': _i529_text(state.get('username')),
            'callsign': _i529_text(state.get('callsign')),
            'client_uid': _i529_text(state.get('client_uid')),
            'certificate_cn': _i529_text(state.get('certificate_cn')),
            'connected_at': _i529_text(state.get('connected_at')),
            'last_heartbeat_at': _i529_text(state.get('last_heartbeat_at')),
            'last_error': _i529_text(state.get('last_error')),
            'heartbeat_seconds': int(_I532_HEARTBEAT_SECONDS),
            'shared_service_fallback': False,
        }

    def _i532_remove_session_token(token, reason='logout'):
        token = _i529_text(token)
        if not token:
            return
        with _I532_PRESENCE_GUARD:
            key = _I532_TOKEN_KEYS.pop(token, '')
            state = _I532_PRESENCE.get(key)
            if not state:
                return
            state['tokens'].discard(token)
            has_live = any(_i532_session_snapshot(candidate) for candidate in list(state['tokens']))
            if not has_live:
                state['stop'].set()
                state['wake'].set()
                with state['io_lock']:
                    _i532_close_locked(state, reason)

    def _i532_stop_all_presence(reason='service-shutdown'):
        with _I532_PRESENCE_GUARD:
            states = list(_I532_PRESENCE.values())
        for state in states:
            state['stop'].set()
            state['wake'].set()
            with state['io_lock']:
                _i532_close_locked(state, reason)

    _i532_atexit.register(_i532_stop_all_presence)

    if '_i512_disconnect_ots' in globals():
        _i532_disconnect_ots_before = _i512_disconnect_ots
        def _i512_disconnect_ots():
            result = _i532_disconnect_ots_before()
            if isinstance(result, dict) and result.get('ok'):
                _i532_stop_all_presence('ots-disconnect')
            return result
        globals()['_i512_disconnect_ots'] = _i512_disconnect_ots

    _i532_destroy_session_before = destroy_tak_map_session
    def destroy_tak_map_session(token):
        _i532_remove_session_token(token, 'logout')
        return _i532_destroy_session_before(token)
    globals()['destroy_tak_map_session'] = destroy_tak_map_session

    if '_i511_create_profile_session' in globals():
        _i532_create_profile_session_before = _i511_create_profile_session
        def _i511_create_profile_session(username, password, auth_mode, is_admin, auth, profile):
            token = _i532_create_profile_session_before(username, password, auth_mode, is_admin, auth, profile)
            if _i529_text(auth_mode).startswith('ots-'):
                _i532_ensure_presence(token, _i532_session_snapshot(token))
            return token
        globals()['_i511_create_profile_session'] = _i511_create_profile_session

    if '_i512_update_callsign' in globals():
        _i532_update_callsign_before = _i512_update_callsign
        def _i512_update_callsign(sess, raw):
            out = _i532_update_callsign_before(sess, raw)
            username = _i529_text((sess or {}).get('username')).lower()
            with _I532_PRESENCE_GUARD:
                states = [state for state in _I532_PRESENCE.values() if _i529_text(state.get('username')).lower() == username or any(_i529_text((_i532_session_snapshot(token) or {}).get('username')).lower() == username for token in state.get('tokens') or set())]
            for state in states:
                state['wake'].set()
            return out
        globals()['_i512_update_callsign'] = _i512_update_callsign

    def _i532_send_per_user_cot(xml, event_uid=''):
        token = _i529_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', ''))
        sess = _i532_session_snapshot(token)
        if not token or not sess:
            return {
                'ok': False,
                'status': 401,
                'error': 'The authenticated TAK Map session is unavailable for persistent per-user CoT publication.',
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'persistent_user_eud': True,
                'shared_service_fallback': False,
            }
        presence_status = _i532_ensure_presence(token, sess)
        with _I532_PRESENCE_GUARD:
            key = _I532_TOKEN_KEYS.get(token, '')
            state = _I532_PRESENCE.get(key)
        if not state:
            return {'ok': False, 'status': 503, 'error': presence_status.get('error') or 'Persistent per-user EUD connection could not be created.', 'shared_service_fallback': False}
        uid = _i529_text(event_uid)
        if not uid:
            try:
                uid = _cot_xml_ids(xml)[0]
            except Exception:
                uid = ''
        started = time.monotonic()
        last_error = ''
        for attempt in range(1, 3):
            try:
                with state['io_lock']:
                    _i532_send_presence_locked(state, sess, force=False)
                    state['tls'].sendall(_normalize_traditional_xml_stream_doc(xml).encode('utf-8'))
                    state['last_object_uid'] = uid
                    state['last_object_sent_at'] = datetime.now(timezone.utc).isoformat()
                ingest = _i531_wait_for_cot_ingest(uid, 15.0) if uid else {'ok': False, 'error': 'No event UID was available for ingest confirmation.'}
                if not ingest.get('ok'):
                    return {
                        'ok': False,
                        'status': 504,
                        'error': _i529_text(ingest.get('error') or 'The point was not visible in OTS after the persistent CoT write.'),
                        'event_uid': uid,
                        'ingest_confirmation': ingest,
                        'ingest_confirmed': False,
                        'identity_mode': 'per-user-enrolled-marti-certificate',
                        'persistent_user_eud': True,
                        'connection_identity_uid': state.get('client_uid'),
                        'connection_identity_callsign': state.get('callsign'),
                        'point_uid_used_as_eud_identity': False,
                        'shared_service_fallback': False,
                    }
                return {
                    'ok': True,
                    'status': 202,
                    'host': state.get('host'),
                    'port': state.get('port'),
                    'tls': True,
                    'strict_tls': True,
                    'socket_framing': 'traditional-xml',
                    'event_uid': uid,
                    'duration_seconds': round(time.monotonic() - started, 3),
                    'ingest_confirmation': ingest,
                    'ingest_confirmed': True,
                    'identity_mode': 'per-user-enrolled-marti-certificate',
                    'certificate_cn': state.get('certificate_cn'),
                    'client_uid': state.get('client_uid'),
                    'connection_identity_uid': state.get('client_uid'),
                    'connection_identity_callsign': state.get('callsign'),
                    'persistent_user_eud': True,
                    'persistent_connection_reused': True,
                    'mission_object_uid': uid,
                    'point_uid_used_as_eud_identity': False,
                    'shared_service_fallback': False,
                    'plaintext_fallback': False,
                    'http_cot_fallback': False,
                    'mission_cot_write_endpoint_used': False,
                }
            except Exception as exc:
                last_error = str(exc)
                with state['io_lock']:
                    state['last_error'] = last_error
                    _i532_close_locked(state, 'object-send-error')
                    if attempt < 2:
                        try:
                            _i532_connect_locked(state, sess)
                        except Exception as reconnect_exc:
                            last_error = str(reconnect_exc)
                if attempt < 2:
                    time.sleep(0.2)
        return {
            'ok': False,
            'status': 502,
            'error': 'Per-user certificate-authenticated persistent SSL CoT publication failed: ' + last_error,
            'event_uid': uid,
            'identity_mode': 'per-user-enrolled-marti-certificate',
            'persistent_user_eud': True,
            'shared_service_fallback': False,
            'plaintext_fallback': False,
            'http_cot_fallback': False,
        }

    globals()['_i531_send_per_user_cot'] = _i532_send_per_user_cot

    def _i526_send_native_mission_cot(mission, creator_uid, xml, server_host=''):
        event_uids = _cot_xml_ids(xml)
        event_uid = event_uids[0] if event_uids else ''
        result = dict(_i532_send_per_user_cot(xml, event_uid) or {})
        result['mission'] = _i529_text(mission)
        result['creator_uid'] = _i529_text(creator_uid)
        result['publication_stage'] = 'persistent-per-user-ssl-cot-ingest-exact-uid-confirmed'
        result['mission_cot_endpoint'] = 'GET-only; not used for publication'
        result['mission_cot_write_endpoint_used'] = False
        return result
    globals()['_i526_send_native_mission_cot'] = _i526_send_native_mission_cot

    _i532_point_xml_before = _i526_point_xml
    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i532_point_xml_before(feature, mission_name, creator_uid)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(_i529_text(built.get('xml')).encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                transport = detail.find('takmap')
                if transport is not None:
                    transport.set('version', 'i532')
                    transport.set('publicationFlow', 'persistent-user-eud-cot-then-mission-uid-association')
                    transport.set('persistentUserEud', 'true')
                point_meta = detail.find('takmap_point')
                if point_meta is not None:
                    point_meta.set('version', 'i532')
                    point_meta.set('publicationFlow', 'persistent-user-eud-cot-then-mission-uid-association')
                    point_meta.set('eudPresence', 'false')
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            built['version'] = 'i532'
            built['publication_flow'] = 'persistent-user-eud-cot-then-mission-uid-association'
            built['persistent_user_eud'] = True
            built['mission_object_uid_independent'] = True
        except Exception as exc:
            built['i532_publication_xml_warning'] = str(exc)
        return built
    globals()['_i526_point_xml'] = _i526_point_xml

    _i532_native_publish_before = tak_map_publish_native_points_to_mission_i526
    def tak_map_publish_native_points_to_mission_i526(points, mission_name='', server_host='', creator_uid=''):
        result = _i532_native_publish_before(points, mission_name, server_host, creator_uid)
        if isinstance(result, dict):
            result = dict(result)
            result['version'] = 'i532'
            result['publish_mode'] = 'persistent-per-user-cot-mission-uid-i532'
            result['persistent_authenticated_user_eud'] = True
            result['mission_object_uid_independent'] = True
            result['shared_service_fallback'] = False
        return result
    globals()['tak_map_publish_native_points_to_mission_i526'] = tak_map_publish_native_points_to_mission_i526

    def _i532_stable_local_ids(features, requested):
        out = []
        for feature in features or []:
            value = ''
            try:
                value = _tak_existing_local_object_id(feature)
            except Exception:
                value = ''
            if not value:
                for key in ('object_id', 'source_id', 'local_id', '_local_id', 'canonical_id'):
                    value = _i529_text((feature or {}).get(key))
                    if value:
                        break
            if value.startswith('local:'):
                value = value.split(':', 1)[1]
            if value and value not in out:
                out.append(value)
        for value in requested or []:
            value = _i529_text(value)
            if value and value not in out:
                out.append(value)
        return out

    _i532_local_publish_before = tak_map_local_data_mission_publish
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        requested = [_i529_text(value) for value in (ids or []) if _i529_text(value)]
        features = _selected_local_data_features(requested)
        points = _i526_point_features(features, kind)
        if not points or len(points) != len(features):
            return _i532_local_publish_before(requested, kind, mission_name, server_host)
        stable_ids = _i532_stable_local_ids(points, requested)
        identity = _i528_identity() if '_i528_identity' in globals() else {}
        result = dict(tak_map_publish_native_points_to_mission_i526(points, mission_name, server_host, identity.get('tak_uid') or '') or {})
        reconcile = {
            'attempted': False,
            'deleted': False,
            'deleted_count': 0,
            'deleted_ids': [],
            'stable_source_ids': stable_ids,
            'verified_absent': False,
            'reason': '',
            'version': 'i532',
        }
        if result.get('ok') and result.get('readback_confirmed'):
            reconcile['attempted'] = True
            try:
                deletion = dict(tak_map_local_data_delete(stable_ids) or {})
            except Exception as exc:
                deletion = {'ok': False, 'error': str(exc), 'deleted': False, 'deleted_ids': []}
            remaining = _selected_local_data_features(stable_ids)
            if remaining and requested != stable_ids:
                try:
                    retry = dict(tak_map_local_data_delete(requested) or {})
                    deletion['deleted_ids'] = list(dict.fromkeys((deletion.get('deleted_ids') or []) + (retry.get('deleted_ids') or [])))
                    deletion['deleted'] = bool(deletion.get('deleted_ids'))
                    deletion['deleted_count'] = len(deletion.get('deleted_ids') or [])
                    if retry.get('imports') is not None:
                        deletion['imports'] = retry.get('imports')
                    if retry.get('error') and not deletion.get('error'):
                        deletion['error'] = retry.get('error')
                except Exception as exc:
                    deletion['error'] = deletion.get('error') or str(exc)
                remaining = _selected_local_data_features(stable_ids)
            reconcile.update({
                'ok': bool(deletion.get('ok')) and not remaining,
                'deleted': bool(deletion.get('deleted')) and not remaining,
                'deleted_count': int(deletion.get('deleted_count') or len(deletion.get('deleted_ids') or [])),
                'deleted_ids': list(deletion.get('deleted_ids') or []),
                'not_found_ids': list(deletion.get('not_found_ids') or []),
                'unsupported_ids': list(deletion.get('unsupported_ids') or []),
                'failed_ids': list(deletion.get('failed_ids') or []),
                'verified_absent': not bool(remaining),
                'remaining_ids': [_tak_existing_local_object_id(row) for row in remaining],
                'error': _i529_text(deletion.get('error')),
                'reason': 'Exact Mission read-back confirmed; the stable Local Data source record was removed.' if not remaining else 'Mission publication succeeded, but the Local Data source record could not be removed.',
            })
            if deletion.get('imports') is not None:
                result['imports'] = deletion.get('imports')
            if not remaining:
                reconcile['deleted'] = True
                result['message'] = (result.get('message') or '').rstrip('.') + '. Local Data was reconciled into the canonical Data Sync object.'
                result['user_message'] = result['message']
            else:
                result['reconcile_warning'] = reconcile.get('error') or reconcile.get('reason')
        elif result.get('ok'):
            reconcile['reason'] = 'Local Data retained because exact Mission read-back was not confirmed.'
        else:
            reconcile['reason'] = 'Local Data retained because publication failed.'
        result['local_reconcile'] = reconcile
        result['local_data_removed_after_readback'] = bool(reconcile.get('verified_absent'))
        result['canonical_object_count_expected'] = 1
        return result
    globals()['tak_map_local_data_mission_publish'] = tak_map_local_data_mission_publish

    _i532_do_get_before = Handler.do_GET
    def _i532_do_get(self):
        parsed = urlparse(self.path)
        path = parsed.path
        sess = self._tak_map_session() if self._tak_map_auth_ok() else None
        token = self._tak_map_token() if sess and callable(getattr(self, '_tak_map_token', None)) else ''
        if sess and _i529_text(sess.get('auth_mode')).startswith('ots-'):
            _i532_ensure_presence(token, sess)
        if path == '/api/tak-map/ots/user-certificate':
            if not sess:
                return self._require_tak_map_login()
            if not _i529_text(sess.get('auth_mode')).startswith('ots-'):
                return self._send_json({'ok': False, 'error': 'Per-user Data Sync certificates apply only to OpenTAKServer sessions.', 'version': 'i532'}, 409)
            profile = dict(sess.get('profile') or {})
            status = dict(_i529_public_certificate_status(_i529_text(sess.get('username')), _i529_text(sess.get('tak_uid') or profile.get('tak_uid'))) or {})
            safe = {key: value for key, value in status.items() if key not in ('key_password', 'private_key_path', 'certificate_path', 'ca_chain_path')}
            safe['version'] = 'i532'
            safe['user_presence'] = _i532_presence_public(token)
            return self._send_json(safe, 200 if status.get('ok') else 428)
        return _i532_do_get_before(self)
    Handler.do_GET = _i532_do_get

    _i532_do_post_before = Handler.do_POST
    def _i532_do_post(self):
        sess = self._tak_map_session() if self._tak_map_auth_ok() else None
        token = self._tak_map_token() if sess and callable(getattr(self, '_tak_map_token', None)) else ''
        if sess and _i529_text(sess.get('auth_mode')).startswith('ots-'):
            _i532_ensure_presence(token, sess)
        return _i532_do_post_before(self)
    Handler.do_POST = _i532_do_post

    _I532_RUNTIME = r'''<script id="takMapPerUserDataSyncIdentityI532">
(function(w,d){'use strict';const V='i532',by=id=>d.getElementById(id),esc=s=>String(s==null?'':s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));let state=null,lastMarkup='';
async function load(){try{const r=await fetch('/api/tak-map/ots/user-certificate',{cache:'no-store',credentials:'same-origin'}),j=await r.json();state=j;render();return j}catch(e){state={ok:false,error:String(e),user_presence:{connected:false,state:'unavailable'}};render();return state}}
function markup(){const p=state&&state.user_presence||{},ready=!!(state&&state.ok),connected=!!p.connected;return '<b>Data Sync identity</b><br><span style="color:'+(ready?'#7ee787':'#ffb86b')+'">'+(ready?'Ready':'Unavailable')+'</span><br><span>'+esc(state&&(state.certificate_cn||state.username)||'')+'</span><br><b>User EUD</b><br><span style="color:'+(connected?'#7ee787':'#ffb86b')+'">'+esc(connected?'Connected':(p.state||'Connecting'))+'</span>'+(p.callsign?'<br><span>Callsign '+esc(p.callsign)+'</span>':'')+(p.client_uid?'<br><span title="'+esc(p.client_uid)+'">'+esc(p.client_uid)+'</span>':'')+(state&&state.expires_at?'<br><span>Cert expires '+esc(state.expires_at)+'</span>':'')+(p.last_error?'<br><span title="'+esc(p.last_error)+'">'+esc(p.last_error)+'</span>':'')+(state&&state.error?'<br><span title="'+esc(state.error)+'">'+esc(state.error)+'</span>':'')}
function render(){try{const menu=by('takMapAccountMenuV511');if(!menu||!state)return;let box=by('takMapDataSyncIdentityI532');if(!box){box=d.createElement('div');box.id='takMapDataSyncIdentityI532';box.style.cssText='margin:8px 0;padding:8px;border:1px solid rgba(255,255,255,.1);border-radius:8px;font-size:.72rem;line-height:1.45';const actions=menu.querySelector('.tak-account-actions-v511');menu.insertBefore(box,actions||null);lastMarkup=''}const next=markup();if(next!==lastMarkup&&box.innerHTML!==next){box.innerHTML=next;lastMarkup=next}}catch(_){} }
function boot(){load();try{const mo=new MutationObserver(()=>{if(state&&by('takMapAccountMenuV511')&&!by('takMapDataSyncIdentityI532'))render()});mo.observe(d.body,{childList:true,subtree:true})}catch(_){}}
if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapPerUserDataSyncIdentityI532=Object.freeze({version:V,load,render,diagnostics:()=>state});
})(window,document);
</script>
<script id="takMapMissionPointReconcileI532">
(function(w,d){'use strict';const V='i532',P='takmap-mission-point-',uids=new Set(),txt=v=>{try{return String(v==null?'':v)}catch(_){return ''}},lc=v=>txt(v).toLowerCase().trim();
function learn(j){try{(j&&j.objects||[]).forEach(o=>{const u=lc(o&&(o.uid||o.id||o.cot_uid));if(u.startsWith(P))uids.add(u)})}catch(_){}return j}
function isMissionPoint(o){try{const u=lc(o&&(o.uid||o.id||o.cot_uid||o.event_uid));return !!u&&(u.startsWith(P)||uids.has(u))}catch(_){return false}}
function filter(j){try{if(j&&Array.isArray(j.markers))j.markers=j.markers.filter(x=>!isMissionPoint(x));if(j&&Array.isArray(j.euds))j.euds=j.euds.filter(x=>!isMissionPoint(x))}catch(_){}return j}
function refresh(j){try{if(j&&j.ok&&j.readback_confirmed&&j.local_reconcile&&(j.local_reconcile.deleted||j.local_reconcile.verified_absent)){setTimeout(async function(){try{if(typeof w.refreshLocalData==='function')await w.refreshLocalData()}catch(_){}try{if(typeof w.refreshImports==='function')await w.refreshImports()}catch(_){}try{if(typeof w.forceDataSyncSync==='function')w.forceDataSyncSync('i532-confirmed-local-to-datasync-reconcile')}catch(_){}},80)}}catch(_){}return j}
function patch(){if(w.__takI532MissionReconcileFetchPatched||typeof w.fetch!=='function')return;const base=w.fetch;w.fetch=function(input,init){const url=txt((input&&input.url)||input||''),p=base.apply(this,arguments);if(!/\/api\/tak-map\/(data-sync|cot|euds|local-data-mission-publish)/.test(url))return p;return p.then(resp=>{try{resp.clone().json().then(j=>{if(url.includes('/data-sync'))learn(j);if(url.includes('/cot')||url.includes('/euds'))filter(j);if(url.includes('/local-data-mission-publish'))refresh(j)}).catch(()=>{})}catch(_){}return resp})};w.__takI532MissionReconcileFetchPatched=true}
if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',patch,{once:true});else patch();w.TakMapMissionPointReconcileI532=Object.freeze({version:V,learn,filter,refresh,diagnostics:()=>({version:V,uids:[...uids],fetchPatched:!!w.__takI532MissionReconcileFetchPatched})});
})(window,document);
