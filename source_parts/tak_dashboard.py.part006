function c(v){if(v<-0.2)return[0.08,0.35,0.18];if(v<0)return[0.35,0.55,0.25];if(v<0.2)return[0.72,0.62,0.40];if(v<0.4)return[0.72,0.40,0.18];return[0.52,0.22,0.08];}
function setup(){return {input:[{bands:["B02","B04","B08","B11","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let a=s.B11+s.B04,b=s.B08+s.B02,v=(a-b)/(a+b+0.000001),x=c(v);return[x[0],x[1],x[2],s.dataMask];}''',
