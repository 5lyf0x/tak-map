    except Exception:
        pass
# --- end TAK Map i533 OTS-confirmed persistent per-user EUD presence ---

# --- TAK Map i534 self-service TAK identity + valid OTS EUD team registration ---
try:
    _I534_TEAM_COLORS = (
        'White', 'Yellow', 'Orange', 'Magenta', 'Red', 'Maroon',
        'Purple', 'Dark Blue', 'Blue', 'Cyan', 'Teal', 'Green', 'Brown',
    )
    _I534_TEAM_ROLES = (
        'Team Member', 'Team Lead', 'HQ', 'Sniper', 'Medic',
        'Forward Observer', 'RTO', 'K9',
    )
    _I534_IDENTITY_LOCK = threading.RLock()

    def _i534_choice(value, choices, label, allow_empty=False):
        value = _i529_text(value).strip()
        if not value and allow_empty:
            return ''
        for item in choices:
            if value.casefold() == item.casefold():
                return item
        raise ValueError(label + ' must be one of: ' + ', '.join(choices) + '.')

    def _i534_team_color(value, allow_empty=False):
        return _i534_choice(value, _I534_TEAM_COLORS, 'Team color', allow_empty)

    def _i534_team_role(value, allow_empty=False):
        return _i534_choice(value, _I534_TEAM_ROLES, 'Team role', allow_empty)

    def _i534_optional_choice(value, choices):
        try:
            return _i534_choice(value, choices, 'Value', True)
        except Exception:
            return ''

    def _i534_apply_record_to_profile(profile, record=None, local=False):
        profile = dict(profile or {})
        record = dict(record or {})
        selected_color = _i534_optional_choice(record.get('team_color'), _I534_TEAM_COLORS)
        selected_role = _i534_optional_choice(record.get('team_role'), _I534_TEAM_ROLES)
        suggested_color = _i534_optional_choice(
            profile.get('suggested_team_color') or profile.get('team_color') or profile.get('team'),
            _I534_TEAM_COLORS,
        )
        suggested_role = _i534_optional_choice(
            profile.get('suggested_team_role') or profile.get('team_role'),
            _I534_TEAM_ROLES,
        )
        effective_color = selected_color or suggested_color or 'Cyan'
        effective_role = selected_role or suggested_role or 'Team Member'
        profile.update({
            'selected_team_color': selected_color,
            'selected_team_role': selected_role,
            'suggested_team_color': suggested_color,
            'suggested_team_role': suggested_role,
            'team_color': effective_color,
            'team': effective_color,
            'team_role': effective_role,
            'tak_identity_configured': bool(
                record.get('tak_identity_configured')
                or record.get('identity_configured')
                or selected_color
                or selected_role
                or (record.get('callsign') if local else False)
            ),
            'tak_identity_configured_at': _i529_text(record.get('tak_identity_configured_at')),
        })
        return profile

    _i534_apply_ots_identity_before = _i512_apply_ots_identity
    def _i512_apply_ots_identity(cfg, profile):
        profile = _i534_apply_ots_identity_before(cfg, profile)
        key = _i529_text(profile.get('identity_key') or _i512_ots_identity_key(cfg, profile))
        with _I534_IDENTITY_LOCK:
            record = dict((_i512_load_identities().get('identities') or {}).get(key) or {})
        return _i534_apply_record_to_profile(profile, record, local=False)
    globals()['_i512_apply_ots_identity'] = _i512_apply_ots_identity

    _i534_local_profile_before = _i512_local_profile
    def _i512_local_profile(account):
        profile = _i534_local_profile_before(account)
        return _i534_apply_record_to_profile(profile, account, local=True)
    globals()['_i512_local_profile'] = _i512_local_profile

    def _i534_identity_from_session(sess):
        sess = sess if isinstance(sess, dict) else {}
        profile = dict(sess.get('profile') or {})
        username = _i529_text(profile.get('username') or sess.get('username'))
        selected_callsign = _i529_text(profile.get('selected_callsign'))
        suggested_callsign = _i529_text(profile.get('suggested_callsign') or profile.get('callsign') or sess.get('callsign') or username)
        callsign = selected_callsign or suggested_callsign or username
        selected_color = _i534_optional_choice(profile.get('selected_team_color'), _I534_TEAM_COLORS)
        selected_role = _i534_optional_choice(profile.get('selected_team_role'), _I534_TEAM_ROLES)
        suggested_color = _i534_optional_choice(profile.get('suggested_team_color') or profile.get('team'), _I534_TEAM_COLORS)
        suggested_role = _i534_optional_choice(profile.get('suggested_team_role') or profile.get('team_role'), _I534_TEAM_ROLES)
        team_color = selected_color or suggested_color or 'Cyan'
        team_role = selected_role or suggested_role or 'Team Member'
        configured = bool(profile.get('tak_identity_configured') or selected_callsign or selected_color or selected_role)
        return {
            'username': username,
            'callsign': callsign,
            'selected_callsign': selected_callsign,
            'suggested_callsign': suggested_callsign,
            'team_color': team_color,
            'team_role': team_role,
            'selected_team_color': selected_color,
            'selected_team_role': selected_role,
            'suggested_team_color': suggested_color,
            'suggested_team_role': suggested_role,
            'configured': configured,
            'configured_at': _i529_text(profile.get('tak_identity_configured_at')),
            'uid': _i529_text(sess.get('tak_uid') or profile.get('tak_uid')),
            'identity_source': _i529_text(profile.get('identity_source') or ('Local' if _i529_text(sess.get('auth_mode')).startswith('local-') else 'OpenTAKServer')),
        }

    _i534_session_identity_before = _i532_session_identity
    def _i532_session_identity(sess):
        base = dict(_i534_session_identity_before(sess) or {})
        identity = _i534_identity_from_session(sess)
        base.update({
            'username': identity['username'] or base.get('username'),
            'callsign': identity['callsign'] or base.get('callsign'),
            'uid': identity['uid'] or base.get('uid'),
            'team_color': identity['team_color'],
            'team_role': identity['team_role'],
            'tak_identity_configured': identity['configured'],
        })
        return base
    globals()['_i532_session_identity'] = _i532_session_identity

    def _i534_same_identity(candidate, target):
        candidate = candidate if isinstance(candidate, dict) else {}
        target = target if isinstance(target, dict) else {}
        c_profile = dict(candidate.get('profile') or {})
        t_profile = dict(target.get('profile') or {})
        c_mode = _i529_text(candidate.get('auth_mode'))
        t_mode = _i529_text(target.get('auth_mode'))
        if c_mode.startswith('local-') or t_mode.startswith('local-'):
            return c_mode.startswith('local-') and t_mode.startswith('local-') and _i529_text(candidate.get('username')).casefold() == _i529_text(target.get('username')).casefold()
        c_key = _i529_text(c_profile.get('identity_key'))
        t_key = _i529_text(t_profile.get('identity_key'))
        if c_key and t_key:
            return c_key == t_key
        return _i529_text(candidate.get('username')).casefold() == _i529_text(target.get('username')).casefold()

    def _i534_restart_user_presence(sess):
        states = []
        with _I532_PRESENCE_GUARD:
            for state in _I532_PRESENCE.values():
                matched = False
                for token in list(state.get('tokens') or set()):
                    if _i534_same_identity(_i532_session_snapshot(token), sess):
                        matched = True
                        break
                if matched:
                    states.append(state)
        for state in states:
            try:
                with state['io_lock']:
                    state['last_error'] = ''
                    _i532_close_locked(state, 'tak-identity-updated')
                state['wake'].set()
            except Exception:
                try:
                    state['wake'].set()
                except Exception:
                    pass
        return len(states)

    def _i534_update_live_sessions(target_sess, profile_builder):
        updated = []
        with TAK_MAP_SESSIONS_LOCK:
            for token, live in TAK_MAP_SESSIONS.items():
                if not _i534_same_identity(live, target_sess):
                    continue
                profile = profile_builder(dict(live.get('profile') or {}))
                live['profile'] = profile
                live['callsign'] = _i529_text(profile.get('callsign'))
                live['display_identity'] = _i529_text(profile.get('display_identity') or profile.get('callsign') or live.get('username'))
                live['tak_uid'] = _i529_text(profile.get('tak_uid') or live.get('tak_uid'))
                updated.append((token, live))
        return updated

    def _i534_update_tak_identity(sess, payload):
        if not isinstance(sess, dict):
            raise ValueError('The authenticated TAK Map session is unavailable.')
        payload = payload if isinstance(payload, dict) else {}
        callsign = _i512_callsign(payload.get('callsign'), allow_empty=True)
        team_color = _i534_team_color(payload.get('team_color'))
        team_role = _i534_team_role(payload.get('team_role'))
        now = _i512_iso_now()
        profile = dict(sess.get('profile') or {})
        mode = _i529_text(sess.get('auth_mode'))

        if mode.startswith('local-'):
            key = _i529_text(profile.get('username') or sess.get('username')).lower()
            with _I534_IDENTITY_LOCK:
                data = _i512_load_local_accounts()
                account = dict((data.get('users') or {}).get(key) or {})
                if not account:
                    raise ValueError('Local account was not found.')
                owner = _i512_callsign_owner(callsign, 'local', key) if callsign else ''
                if owner:
                    raise ValueError('That callsign is already assigned to ' + owner + '.')
                account.update({
                    'callsign': callsign,
                    'team_color': team_color,
                    'team_role': team_role,
                    'tak_identity_configured': True,
                    'tak_identity_configured_at': now,
                    'updated_at': now,
                })
                data['users'][key] = account
                _i512_save_local_accounts(data)
            updated = _i534_update_live_sessions(sess, lambda _p: _i512_local_profile(account))
        else:
            cfg = _i509_load_ots_config()
            key = _i529_text(profile.get('identity_key') or _i512_ots_identity_key(cfg, profile))
            if not key:
                raise ValueError('The OpenTAKServer identity key is unavailable.')
            with _I534_IDENTITY_LOCK:
                data = _i512_load_identities()
                identities = data.get('identities') if isinstance(data.get('identities'), dict) else {}
                record = dict(identities.get(key) or {})
                owner = _i512_callsign_owner(callsign, 'ots', key) if callsign else ''
                if owner:
                    raise ValueError('That callsign is already assigned to ' + owner + '.')
                record.update({
                    'provider': 'ots',
                    'origin': _i529_text(cfg.get('base_url')).rstrip('/'),
                    'user_id': profile.get('user_id') or record.get('user_id') or '',
                    'username': profile.get('username') or sess.get('username') or record.get('username') or '',
                    'callsign': callsign,
                    'team_color': team_color,
                    'team_role': team_role,
                    'tak_uid': _i529_text(record.get('tak_uid') or profile.get('tak_uid') or _i512_ots_uid(cfg, profile)),
                    'tak_identity_configured': True,
                    'tak_identity_configured_at': now,
                    'updated_at': now,
                })
                identities[key] = record
                data['identities'] = identities
                _i512_save_identities(data)

            def build_profile(current):
                current = dict(current or {})
                current['identity_key'] = key
                current['selected_callsign'] = callsign
                current['callsign'] = callsign or _i529_text(current.get('suggested_callsign') or current.get('username'))
                current['display_identity'] = current['callsign'] or _i529_text(current.get('username'))
                current['tak_uid'] = record['tak_uid']
                return _i534_apply_record_to_profile(current, record, local=False)
            updated = _i534_update_live_sessions(sess, build_profile)

        if not updated:
            raise ValueError('The current TAK Map session could not be updated.')
        current = next((live for _token, live in updated if live is sess), updated[0][1])
        _i512_audit('tak-identity-change', _i529_text(current.get('username')), True, 'callsign=%s team=%s role=%s' % (callsign or 'fallback', team_color, team_role))
        restarted = _i534_restart_user_presence(current)
        return {
            'ok': True,
            'version': 'i534',
            'message': 'TAK identity settings saved.',
            'identity': _i534_identity_from_session(current),
            'session': _i509_session_public(current),
            'presence_reconnect_requested': bool(restarted),
            'presence_sessions_restarted': restarted,
            'self_service': True,
            'administrator_override': False,
        }

    def _i534_public_identity(sess):
        identity = _i534_identity_from_session(sess)
        return {
            'ok': True,
            'version': 'i534',
            'username': identity['username'],
            'callsign': identity['callsign'],
            'selected_callsign': identity['selected_callsign'],
            'suggested_callsign': identity['suggested_callsign'],
            'team_color': identity['team_color'],
            'team_role': identity['team_role'],
            'selected_team_color': identity['selected_team_color'],
            'selected_team_role': identity['selected_team_role'],
            'suggested_team_color': identity['suggested_team_color'],
            'suggested_team_role': identity['suggested_team_role'],
            'configured': identity['configured'],
            'configured_at': identity['configured_at'],
            'tak_uid': identity['uid'],
            'identity_source': identity['identity_source'],
            'callsign_source': 'user' if identity['selected_callsign'] else 'provider-fallback',
            'team_color_source': 'user' if identity['selected_team_color'] else ('provider-fallback' if identity['suggested_team_color'] else 'default'),
            'team_role_source': 'user' if identity['selected_team_role'] else ('provider-fallback' if identity['suggested_team_role'] else 'default'),
            'team_colors': list(_I534_TEAM_COLORS),
            'team_roles': list(_I534_TEAM_ROLES),
            'self_service': True,
            'administrator_override': False,
        }

    _i534_presence_xml_before = _i532_presence_xml
    def _i532_presence_xml(sess, credential):
        built = _i534_presence_xml_before(sess, credential)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        identity = _i534_identity_from_session(sess)
        try:
            root = ET.fromstring(_i529_text(built.get('wire_xml') or built.get('xml')).strip().encode('utf-8'))
            detail = root.find('detail')
            if detail is None:
                detail = ET.SubElement(root, 'detail')
            for existing in list(detail.findall('__group')):
                detail.remove(existing)
            group = ET.Element('__group', {
                'name': identity['team_color'],
                'role': identity['team_role'],
            })
            children = list(detail)
            insert_at = 0
            for index, child in enumerate(children):
                if child.tag in ('contact', 'uid'):
                    insert_at = index + 1
            detail.insert(insert_at, group)
            takv = detail.find('takv')
            if takv is None:
                takv = ET.SubElement(detail, 'takv')
            takv.attrib.update({
                'device': 'Web Browser',
                'platform': 'TAK Map',
                'os': 'Web',
                'version': '1.3.0-i534',
            })
            meta = detail.find('takmap_user_presence')
            if meta is None:
                meta = ET.SubElement(detail, 'takmap_user_presence')
            meta.attrib.update({
                'version': 'i534',
                'teamColor': identity['team_color'],
                'teamRole': identity['team_role'],
                'selfConfigured': 'true' if identity['configured'] else 'false',
                'timestamps': 'timezone-aware-utc',
                'missionObject': 'false',
                'serviceCredentialFallback': 'false',
            })
            wire_xml = ET.tostring(root, encoding='unicode', short_empty_elements=True) + '\n'
            built.update({
                'xml': '<?xml version="1.0" encoding="UTF-8"?>\n' + wire_xml.rstrip('\n'),
                'wire_xml': wire_xml,
                'version': 'i534',
                'callsign': identity['callsign'],
                'team_color': identity['team_color'],
                'team_role': identity['team_role'],
                'tak_identity_configured': identity['configured'],
            })
        except Exception as exc:
            return {'ok': False, 'error': 'Could not create the callsign/team-complete TAK Map EUD identity CoT: ' + str(exc), 'version': 'i534'}
        return built
    globals()['_i532_presence_xml'] = _i532_presence_xml

    _i534_record_presence_before = _i533_record_presence
    def _i533_record_presence(state, presence):
        _i534_record_presence_before(state, presence)
        state['team_color'] = _i529_text((presence or {}).get('team_color'))
        state['team_role'] = _i529_text((presence or {}).get('team_role'))
        state['tak_identity_configured'] = bool((presence or {}).get('tak_identity_configured'))
    globals()['_i533_record_presence'] = _i533_record_presence

    _i534_send_presence_before = _i532_send_presence_locked
    def _i532_send_presence_locked(state, sess, force=False):
        identity = _i534_identity_from_session(sess)
        if (
            _i529_text(state.get('team_color')) != identity['team_color']
            or _i529_text(state.get('team_role')) != identity['team_role']
        ):
            force = True
        result = _i534_send_presence_before(state, sess, force=force)
        if isinstance(result, dict):
            state['team_color'] = _i529_text(result.get('team_color') or identity['team_color'])
            state['team_role'] = _i529_text(result.get('team_role') or identity['team_role'])
            state['tak_identity_configured'] = bool(result.get('tak_identity_configured', identity['configured']))
        return result
    globals()['_i532_send_presence_locked'] = _i532_send_presence_locked

    _i534_presence_public_before = _i532_presence_public
    def _i532_presence_public(token='', state=None):
        out = dict(_i534_presence_public_before(token, state) or {})
        out['version'] = 'i534'
        if isinstance(state, dict):
            active_state = state
        else:
            active_state = None
            with _I532_PRESENCE_GUARD:
                active_state = _I532_PRESENCE.get(_I532_TOKEN_KEYS.get(_i529_text(token), ''))
        if isinstance(active_state, dict):
            out['team_color'] = _i529_text(active_state.get('team_color'))
            out['team_role'] = _i529_text(active_state.get('team_role'))
            out['tak_identity_configured'] = bool(active_state.get('tak_identity_configured'))
        out['valid_group_required'] = True
        out['self_service_identity'] = True
        return out
    globals()['_i532_presence_public'] = _i532_presence_public

    _i534_certificate_status_before = _i529_public_certificate_status
    def _i529_public_certificate_status(username, expected_uid=''):
        status = _i534_certificate_status_before(username, expected_uid)
        if isinstance(status, dict):
            status = dict(status)
            status['version'] = 'i534'
            status['shared_service_fallback'] = False
        return status
    globals()['_i529_public_certificate_status'] = _i529_public_certificate_status

    _i534_do_get_before = Handler.do_GET
    def _i534_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/account/tak-identity':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session()
            if _i512_forced_change(sess):
                return self._send_json({'ok': False, 'password_change_required': True, 'error': 'Change the default local administrator password first.'}, 428)
            token = self._tak_map_token() if callable(getattr(self, '_tak_map_token', None)) else ''
            return self._send_json({
                'ok': True,
                'version': 'i534',
                'identity': _i534_public_identity(sess),
                'user_presence': _i532_presence_public(token),
                'self_service': True,
                'administrator_override': False,
            })
        return _i534_do_get_before(self)
    Handler.do_GET = _i534_do_get

    _i534_do_post_before = Handler.do_POST
    def _i534_do_post(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/account/tak-identity':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session()
            if _i512_forced_change(sess):
                return self._send_json({'ok': False, 'password_change_required': True, 'error': 'Change the default local administrator password first.'}, 428)
            try:
                result = _i534_update_tak_identity(sess, _read_json_body(self))
                token = self._tak_map_token() if callable(getattr(self, '_tak_map_token', None)) else ''
                result['user_presence'] = _i532_presence_public(token)
                return self._send_json(result)
            except Exception as exc:
                return self._send_json({'ok': False, 'version': 'i534', 'error': str(exc)}, 400)
        return _i534_do_post_before(self)
    Handler.do_POST = _i534_do_post

    _I534_RUNTIME = r'''<script id="takMapSelfServiceIdentityI534">
(function(w,d){'use strict';
const V='i534',by=id=>d.getElementById(id),esc=s=>String(s==null?'':s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));
let state=null,observer=null;
function api(url,opt){return fetch(url,Object.assign({cache:'no-store',credentials:'same-origin'},opt||{})).then(async r=>{const j=await r.json().catch(()=>({ok:false,error:'HTTP '+r.status}));if(!r.ok||!j.ok)throw Error(j.error||('HTTP '+r.status));return j})}
function optionHtml(values,current){return (values||[]).map(v=>'<option value="'+esc(v)+'"'+(v===current?' selected':'')+'>'+esc(v)+'</option>').join('')}
function presenceText(p){p=p||{};if(p.ots_eud_confirmed)return 'Connected · OTS confirmed';if(p.socket_connected)return 'Socket connected · awaiting OTS confirmation';return p.state||'Disconnected'}
function build(){const menu=by('takMapAccountMenuV511');if(!menu||!state||!state.identity)return;const old=by('takMapDataSyncIdentityI533');if(old)old.remove();const legacy=by('changeCallsignV512');if(legacy)legacy.style.display='none';let box=by('takMapIdentityI534');if(box)return updateStatus();const i=state.identity,p=state.user_presence||{};box=d.createElement('section');box.id='takMapIdentityI534';box.className='tak-identity-i534';box.innerHTML='<div class="tak-identity-title-i534">TAK Identity</div><label>Callsign<input id="takCallsignI534" maxlength="32" value="'+esc(i.selected_callsign||i.callsign||'')+'"></label><label>Team color<select id="takTeamColorI534">'+optionHtml(i.team_colors,i.team_color)+'</select></label><label>Team role<select id="takTeamRoleI534">'+optionHtml(i.team_roles,i.team_role)+'</select></label><div class="tak-identity-effective-i534"><b>Publishing</b><span id="takIdentityEffectiveI534"></span><b>EUD state</b><span id="takIdentityPresenceI534"></span></div><div id="takIdentityNoteI534" class="tak-identity-note-i534"></div><button id="saveTakIdentityI534" type="button">Save My TAK Identity</button>';const actions=menu.querySelector('.tak-account-actions-v511');menu.insertBefore(box,actions||null);by('saveTakIdentityI534').onclick=save;updateStatus()}
function updateHeader(i){try{const label=i.callsign||i.username||'ACCOUNT',btn=by('takMapAccountBtnV511'),name=d.querySelector('#takMapAccountMenuV511 .tak-account-name-v511');if(btn)btn.textContent=label+' ▾';if(name)name.textContent=label;d.querySelectorAll('#takMapAccountMenuV511 .tak-account-meta-v511 b').forEach(b=>{if((b.textContent||'').trim()==='Callsign'&&b.nextElementSibling)b.nextElementSibling.textContent=i.callsign||'Not assigned'})}catch(_){}}
function updateStatus(){if(!state||!state.identity)return;const i=state.identity,p=state.user_presence||{};const effective=by('takIdentityEffectiveI534'),presence=by('takIdentityPresenceI534'),note=by('takIdentityNoteI534');if(effective)effective.textContent=(i.callsign||'—')+' · '+(i.team_color||'Cyan')+' · '+(i.team_role||'Team Member');if(presence){presence.textContent=presenceText(p);presence.classList.toggle('ok',!!p.ots_eud_confirmed)}if(note&&!note.dataset.busy)note.textContent=i.configured?'Configured by you.':'Using provider/default values until you save.';updateHeader(i)}
async function load(){try{state=await api('/api/tak-map/account/tak-identity');build();return state}catch(e){state={ok:false,error:String(e)};return state}}
async function refresh(){try{const j=await api('/api/tak-map/ots/session');if(!state)await load();if(state){state.user_presence=j.user_eud_presence||state.user_presence;updateStatus()}return state}catch(_){return state}}
async function save(){const btn=by('saveTakIdentityI534'),note=by('takIdentityNoteI534');if(!btn)return;btn.disabled=true;if(note){note.dataset.busy='1';note.textContent='Saving and reconnecting your EUD…'}try{const j=await api('/api/tak-map/account/tak-identity',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({callsign:by('takCallsignI534').value,team_color:by('takTeamColorI534').value,team_role:by('takTeamRoleI534').value})});state.identity=j.identity;state.user_presence=j.user_presence||state.user_presence;if(note)note.textContent='Saved. OTS presence is reconnecting with these values.';updateHeader(state.identity);setTimeout(refresh,1200);setTimeout(refresh,3500)}catch(e){if(note)note.textContent=e.message||String(e)}finally{if(note)delete note.dataset.busy;btn.disabled=false;updateStatus()}}
function css(){if(by('takIdentityStyleI534'))return;const s=d.createElement('style');s.id='takIdentityStyleI534';s.textContent='.tak-identity-i534{margin:8px 0;padding:9px;border:1px solid rgba(255,255,255,.12);border-radius:9px;background:rgba(0,0,0,.14);display:grid;gap:7px;font-size:.72rem}.tak-identity-title-i534{font-weight:900;letter-spacing:.08em;text-transform:uppercase}.tak-identity-i534 label{display:grid;gap:3px;color:#9fb0ba;font-weight:800}.tak-identity-i534 input,.tak-identity-i534 select{width:100%;box-sizing:border-box;min-height:30px;border-radius:7px;border:1px solid rgba(255,255,255,.14);background:#0a1118;color:#edf4f7;padding:5px 7px}.tak-identity-i534 button{min-height:31px}.tak-identity-effective-i534{display:grid;grid-template-columns:auto 1fr;gap:3px 8px;line-height:1.35}.tak-identity-effective-i534 b{color:#9fb0ba}.tak-identity-effective-i534 span{overflow:hidden;text-overflow:ellipsis}.tak-identity-effective-i534 span.ok{color:#7ee787}.tak-identity-note-i534{min-height:15px;color:#9fb0ba;line-height:1.35}';d.head.appendChild(s)}
function ensure(){if(state&&by('takMapAccountMenuV511')&&!by('takMapIdentityI534'))build()}
function boot(){css();load();observer=new MutationObserver(ensure);observer.observe(d.body,{childList:true,subtree:true});setInterval(refresh,15000)}
if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapSelfServiceIdentityI534=Object.freeze({version:V,load,refresh,save,diagnostics:()=>state});
})(window,document);
</script>'''

    def _i534_version_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i534', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i534', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i534', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i534\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i534\2', html)
        return html

    def _i534_patch_html(html):
        html = _i534_version_html(html)
        if not isinstance(html, str):
            return html
        for script_id in (
            'takMapPerUserDataSyncIdentityI529', 'takMapPerUserDataSyncIdentityI531',
            'takMapPerUserDataSyncIdentityI532', 'takMapPerUserDataSyncIdentityI533',
            'takMapSelfServiceIdentityI534',
        ):
            html = re.sub(r'<script[^>]*id=["\']' + re.escape(script_id) + r'["\'][^>]*>[\s\S]*?</script>\s*', '', html, flags=re.I)
        return html.replace('</body>', _I534_RUNTIME + '\n</body>', 1) if '</body>' in html else html + _I534_RUNTIME

    TAK_MAP_HTML = _i534_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i534_version_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i534'

    _i534_session_public_before = _i509_session_public
    def _i509_session_public(sess):
        out = dict(_i534_session_public_before(sess))
        token = ''
        try:
            token = _i529_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', ''))
        except Exception:
            token = ''
        out['version'] = 'i534'
        out['tak_identity'] = _i534_public_identity(sess)
        out['user_eud_presence'] = _i532_presence_public(token) if token else {
            'ok': False, 'version': 'i534', 'state': 'pending', 'connected': False,
            'socket_connected': False, 'ots_eud_confirmed': False, 'persistent': True,
        }
        return out
    globals()['_i509_session_public'] = _i509_session_public

    _i534_config_before = tak_map_config
    def tak_map_config():
        cfg = _i534_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i534'
        cfg['version'] = '1.3.0-i534'
        ots = dict(cfg.get('ots_integration') or {})
        ots.update({
            'version': 'i534',
            'persistent_per_user_eud_connection': True,
            'ots_eud_row_confirmation_required': True,
            'timezone_aware_utc_presence_timestamps': True,
            'valid_cot_group_required': True,
            'initial_identity_group_side_effects_removed': False,
            'initial_identity_valid_group_restored': True,
            'self_service_tak_identity': True,
            'per_user_callsign_team_color_role': True,
            'administrator_identity_override': False,
            'team_colors': list(_I534_TEAM_COLORS),
            'team_roles': list(_I534_TEAM_ROLES),
            'presence_heartbeat_seconds': int(_I532_HEARTBEAT_SECONDS),
            'shared_service_certificate_fallback': False,
        })
        cfg['ots_integration'] = ots
        native = dict(cfg.get('data_sync_native_point_publish') or {})
        native.update({
            'version': 'i534',
            'publish_mode': 'ots-confirmed-self-configured-persistent-per-user-cot-mission-uid-i534',
            'persistent_authenticated_user_eud': True,
            'valid_user_group_identity': True,
            'mission_object_uid_independent': True,
            'local_data_removed_after_exact_readback': True,
            'shared_service_certificate_fallback': False,
        })
        cfg['data_sync_native_point_publish'] = native
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _i534_point_xml_before = _i526_point_xml
    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i534_point_xml_before(feature, mission_name, creator_uid)
        if not isinstance(built, dict) or not built.get('ok'):
            return built
        built = dict(built)
        try:
            root = ET.fromstring(_i529_text(built.get('xml')).encode('utf-8'))
            detail = root.find('detail')
            if detail is not None:
                transport = detail.find('takmap')
                if transport is not None:
                    transport.set('version', 'i534')
                    transport.set('publicationFlow', 'ots-confirmed-self-configured-persistent-user-eud-cot-then-mission-uid-association')
                    transport.set('validUserGroupIdentity', 'true')
                point_meta = detail.find('takmap_point')
                if point_meta is not None:
                    point_meta.set('version', 'i534')
                    point_meta.set('publicationFlow', 'ots-confirmed-self-configured-persistent-user-eud-cot-then-mission-uid-association')
                    point_meta.set('eudPresence', 'false')
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            built['version'] = 'i534'
            built['publication_flow'] = 'ots-confirmed-self-configured-persistent-user-eud-cot-then-mission-uid-association'
            built['persistent_user_eud'] = True
            built['valid_user_group_identity'] = True
            built['mission_object_uid_independent'] = True
        except Exception as exc:
            built['i534_publication_xml_warning'] = str(exc)
        return built
    globals()['_i526_point_xml'] = _i526_point_xml

    _i534_native_publish_before = tak_map_publish_native_points_to_mission_i526
    def tak_map_publish_native_points_to_mission_i526(points, mission_name='', server_host='', creator_uid=''):
        result = _i534_native_publish_before(points, mission_name, server_host, creator_uid)
        if isinstance(result, dict):
            result = dict(result)
            result['version'] = 'i534'
            result['publish_mode'] = 'ots-confirmed-self-configured-persistent-per-user-cot-mission-uid-i534'
            result['persistent_authenticated_user_eud'] = True
            result['valid_user_group_identity'] = True
            result['mission_object_uid_independent'] = True
            result['shared_service_fallback'] = False
        return result
    globals()['tak_map_publish_native_points_to_mission_i526'] = tak_map_publish_native_points_to_mission_i526

    _i534_data_sync_before = tak_map_data_sync
    def tak_map_data_sync():
        out = _i534_data_sync_before()
        if isinstance(out, dict):
            token = _i529_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', ''))
            out['persistent_user_eud_i534'] = _i532_presence_public(token)
            out['version'] = 'i534'
        return out
    globals()['tak_map_data_sync'] = tak_map_data_sync
except Exception as _i534_exc:
    try:
        print('TAK Map i534 self-service TAK identity patch failed:', _i534_exc)
    except Exception:
        pass
# --- end TAK Map i534 self-service TAK identity + valid OTS EUD team registration ---

