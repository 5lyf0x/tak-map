            '/assets/runtime/tak-map-popup-localdata-i566.js': (_I566_ROOT/'assets'/'tak-map-popup-localdata-i566.js','application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-context-sidebar-i566.js': (_I566_ROOT/'assets'/'tak-map-context-sidebar-i566.js','application/javascript; charset=utf-8'),
        }.get(parsed.path)
