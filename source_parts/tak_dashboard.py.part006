# --- TAK Map i564 ATAK-style Mission deletion and contextual delete sidebar ---
try:
    _I564_ROOT = Path(__file__).resolve().parent
    _I564_ATAK_USER_AGENT = 'ATAK/5.4.0.14 (Android; TAK Map Data Sync)'
    _I564_MISSION_TOKEN_LOCK = threading.RLock()
    _I564_MISSION_TOKENS = {}

    def _i564_request_identity_key():
        try:
            credential = _i529_current_user_credential()
            return _i555_text(credential.get('client_uid') or credential.get('username') or credential.get('certificate_cn'))
        except Exception:
            return ''

    def _i564_extract_subscription_token(payload):
        if not isinstance(payload, dict):
            return ''
        data = payload.get('data')
        if isinstance(data, dict):
            return _i555_text(data.get('token'))
        if isinstance(data, list):
            for row in data:
                if isinstance(row, dict) and _i555_text(row.get('token')):
                    return _i555_text(row.get('token'))
        return _i555_text(payload.get('token'))

    def _i564_response_status(response):
        response = response or {}
        try:
            status = int(response.get('status') or 0)
            if status: return status
        except Exception:
            pass
        attempts = response.get('attempts') if isinstance(response.get('attempts'), list) else []
        for attempt in reversed(attempts):
            if not isinstance(attempt, dict): continue
            try:
                status = int(attempt.get('status') or 0)
                if status: return status
            except Exception:
                continue
        return 0

    def _i564_response_reason(response, fallback='OpenTAKServer Mission API request failed.'):
        response = response or {}
        payload = response.get('json') if isinstance(response.get('json'), dict) else {}
        reason = _i555_text(payload.get('error') or payload.get('message') or payload.get('detail'))
        if not reason:
            body = _i555_text(response.get('body'))
            if body and len(body) <= 500 and not body.lstrip().startswith('<'):
                reason = body
        if not reason:
            attempts = response.get('attempts') if isinstance(response.get('attempts'), list) else []
            for attempt in reversed(attempts):
                if not isinstance(attempt, dict): continue
                preview = _i555_text(attempt.get('body_preview'))
                try:
                    parsed = json.loads(preview) if preview.startswith('{') else {}
                except Exception:
                    parsed = {}
                reason = _i555_text(parsed.get('error') or parsed.get('message') or attempt.get('error'))
                if reason: break
        reason = reason or fallback
        # Never surface credentials, bearer tokens, certificate paths, or request URLs.
        reason = re.sub(r'(?i)Bearer\s+[A-Za-z0-9._~+\-/]+=*', 'Bearer [redacted]', reason)
        reason = re.sub(r'(?i)(token|password|private[_ -]?key)\s*[:=]\s*\S+', r'\1=[redacted]', reason)
        return reason[:700]

    def _i564_mission_token(mission, creator_uid, server_host='', force=False):
        mission = _i555_text(mission); creator_uid = _i555_text(creator_uid)
        if not mission or not creator_uid:
            return {'ok':False,'status':400,'error':'Mission name and authenticated ATAK client UID are required.'}
        key = (_i564_request_identity_key() or creator_uid, mission.casefold(), creator_uid.casefold())
        if not force:
            with _I564_MISSION_TOKEN_LOCK:
                cached = _I564_MISSION_TOKENS.get(key)
                if cached and _i555_text(cached.get('token')):
                    return {'ok':True,'token':cached['token'],'source':'cache','status':200}
        path = '/Marti/api/missions/' + quote(mission, safe='') + '/subscription?uid=' + quote(creator_uid, safe='')
        response = _ots_mission_api_request(
            path, method='PUT', body=b'',
            headers={'User-Agent':_I564_ATAK_USER_AGENT,'Content-Length':'0','Accept':'application/json,*/*'},
            public_host=server_host, timeout=25)
        token = _i564_extract_subscription_token(response.get('json') or {})
        if response.get('ok') and token:
            with _I564_MISSION_TOKEN_LOCK:
                _I564_MISSION_TOKENS[key] = {'token':token,'created_at':time.time()}
            return {'ok':True,'token':token,'source':'atak-subscription','status':response.get('status')}
        status = _i564_response_status(response)
        return {'ok':False,'status':status,'error':_i564_response_reason(response,'ATAK-style Mission subscription did not return a mission token.')}

    def _i564_invalidate_mission_token(mission, creator_uid):
        mission = _i555_text(mission); creator_uid = _i555_text(creator_uid)
        identity = _i564_request_identity_key() or creator_uid
        with _I564_MISSION_TOKEN_LOCK:
            for key in list(_I564_MISSION_TOKENS):
                if key[0] == identity and key[1] == mission.casefold() and key[2] == creator_uid.casefold():
                    _I564_MISSION_TOKENS.pop(key, None)

    def _i564_tokenized_delete_record(obj, server_host=''):
        object_id = _i555_text((obj or {}).get('object_id'))
