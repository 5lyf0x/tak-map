    def _i509_auth_test(payload):
        payload = payload or {}
        current = _i509_load_ots_config()
        cfg = _i509_normalize_ots_config(payload, current)
        auth = _i509_authenticate_remote(cfg, payload.get('username', ''), payload.get('password', ''), payload.get('otp', ''))
        if not auth.get('ok'):
            return auth
        fetched = _i511_fetch_profile(cfg, auth, payload.get('username', ''))
        if not fetched.get('ok'):
            return {'ok': False, 'error': 'Authentication succeeded, but TAK Map could not read /api/me: ' + str(fetched.get('error') or 'unknown error'), 'profile_required': True}
        profile = fetched['profile']
        if not profile.get('is_admin'):
            return {
                'ok': False,
                'error': 'The account authenticated successfully but does not have the OpenTAKServer administrator role.',
                'administrator_required': True,
                'profile': profile,
            }
        validation = {
            'username': profile.get('username', ''),
            'display_identity': profile.get('display_identity', ''),
            'base_url': str(cfg.get('base_url') or '').rstrip('/'),
            'validated_at': datetime.now(timezone.utc).isoformat(),
            'role_names': list(profile.get('role_names') or []),
        }
        # Record approval for the candidate origin without replacing the
        # currently active/saved endpoint values. The candidate becomes active
        # only after the administrator explicitly presses Save.
        persisted = _i509_normalize_ots_config(current, current)
        persisted['last_admin_validation'] = validation
        _i511_write_ots_config(persisted)
        cot = _i509_cert_probe(cfg.get('cot_host'), cfg.get('cot_port'), cfg)
        return {
            'ok': True,
            'version': 'i511',
            'administrator_authenticated': True,
            'profile': profile,
            'capabilities': _i511_safe_capabilities(cfg, auth),
            'cot_tls': cot,
            'cot_auth_prototype': {
                'ready': bool(cot.get('strict_tls_ok')),
                'credential_mode': 'server-side OpenTAKServer user session; enrolled client certificate when required',
                'private_key_persisted_in_browser': False,
            },
            'message': 'OpenTAKServer administrator authentication successful.',
        }

    _i511_discover_ots_before = _i509_discover_ots
    def _i509_discover_ots(payload=None):
        result = dict(_i511_discover_ots_before(payload))
        result['version'] = 'i511'
        cfg = _i509_normalize_ots_config(payload or {}, _i509_load_ots_config())
        persisted = _i509_load_ots_config()
        validation = persisted.get('last_admin_validation') or {}
        summary = dict(result.get('summary') or {})
        summary['administrator_authenticated'] = bool(
            validation.get('validated_at') and
            str(validation.get('base_url') or '').rstrip('/') == str(cfg.get('base_url') or '').rstrip('/')
        )
        summary['configuration_saved'] = bool(
            persisted.get('configured_at') and
            str(persisted.get('base_url') or '').rstrip('/') == str(cfg.get('base_url') or '').rstrip('/')
        )
        summary['login_enabled'] = bool(persisted.get('enabled') and persisted.get('login_enabled'))
        summary['complete'] = all(bool(summary.get(k)) for k in (
            'web_reachable', 'strict_web_tls', 'hostname_match',
            'administrator_authenticated', 'configuration_saved', 'login_enabled'
        ))
        result['summary'] = summary
        return result

    def _i511_local_profile(username):
        username = sanitize_ots_username(username)
        return {
            'username': username,
            'user_id': '',
            'active': True,
            'callsign': '',
            'display_identity': 'LOCAL ADMIN',
            'identity_source': 'Local Recovery',
            'connection_state': 'Authenticated',
            'is_admin': True,
            'roles': [{'name': 'Local Recovery Administrator', 'description': 'Emergency TAK Map recovery access', 'permissions': ['configure-ots']}],
            'role_names': ['Local Recovery Administrator'],
            'permissions': ['configure-ots'],
            'groups': [], 'group_memberships': [], 'euds': [], 'team': '', 'team_role': '',
        }

    _i511_create_session_before = _i509_create_session
    def _i511_create_profile_session(username, password, auth_mode, is_admin, auth, profile):
        token = _i511_create_session_before(username, password, auth_mode, is_admin, auth)
        with TAK_MAP_SESSIONS_LOCK:
            sess = TAK_MAP_SESSIONS.get(token)
            if sess is not None:
                sess['profile'] = dict(profile or {})
                sess['is_admin'] = bool((profile or {}).get('is_admin', is_admin))
                sess['display_identity'] = str((profile or {}).get('display_identity') or username)
                sess['callsign'] = str((profile or {}).get('callsign') or '')
        return token

    def _i509_session_public(sess):
        sess = sess or {}
        profile = dict(sess.get('profile') or {})
        username = str(profile.get('username') or sess.get('username') or '')
        callsign = str(profile.get('callsign') or sess.get('callsign') or '')
        auth_mode = str(sess.get('auth_mode') or 'legacy')
        return {
            'ok': bool(sess),
            'version': 'i511',
            'username': username,
            'callsign': callsign,
            'display_identity': str(profile.get('display_identity') or sess.get('display_identity') or callsign or username),
            'identity_source': str(profile.get('identity_source') or ('Local Recovery' if auth_mode == 'local-recovery' else 'OpenTAKServer')),
            'connection_state': str(profile.get('connection_state') or 'Authenticated'),
            'auth_mode': auth_mode,
            'is_admin': bool(sess.get('is_admin')),
            'ots_authenticated': auth_mode.startswith('ots-'),
            'roles': list(profile.get('roles') or []),
            'role_names': list(profile.get('role_names') or []),
            'permissions': list(profile.get('permissions') or []),
            'groups': list(profile.get('groups') or []),
            'group_memberships': list(profile.get('group_memberships') or []),
            'euds': list(profile.get('euds') or []),
            'team': str(profile.get('team') or ''),
            'team_role': str(profile.get('team_role') or ''),
            'expires_in': TAK_MAP_SESSION_TTL_SECONDS,
        }

    def _i509_require_config_admin(handler):
        sess = handler._tak_map_session()
        if not sess or not sess.get('is_admin'):
            handler._send_json({'ok': False, 'error': 'Configure OTS requires an OpenTAKServer administrator or Local Recovery administrator session.', 'admin_required': True}, 403)
            return None
        return sess

    def _i511_handle_tak_map_login(self):
        if not self._is_secure_request() and not ALLOW_INSECURE_UPLOAD_AUTH:
            return self._send_json({'ok': False, 'error': 'TAK Map login requires HTTPS.'}, 403)
        f = self._read_form(); mode = str(f.get('mode') or '').strip().lower()
        username = sanitize_ots_username(f.get('username', '')); password = str(f.get('password') or ''); otp = str(f.get('otp') or '')
        cfg = _i509_load_ots_config()
        use_recovery = (mode in ('recovery', 'local-admin', 'admin')) or not (cfg.get('enabled') and cfg.get('login_enabled'))
        if use_recovery:
            try: ok, msg = authenticate_opentak_admin(username, password)
            except Exception as e: return self._send_json({'ok': False, 'error': 'Local Recovery authentication error: ' + str(e), 'admin_required': True}, 500)
            if not ok: return self._send_json({'ok': False, 'error': msg, 'admin_required': True}, 403)
            profile = _i511_local_profile(username)
            token = _i511_create_profile_session(username, password, 'local-recovery', True, {'auth_method': 'local-ots-admin-verification'}, profile)
            reply = _i509_session_public(TAK_MAP_SESSIONS.get(token)); reply['ok'] = True
            return self._send_json(reply, 200, headers={'Set-Cookie': self._tak_map_session_cookie(token)})
        auth = _i509_authenticate_remote(cfg, username, password, otp)
        if not auth.get('ok'):
            return self._send_json({'ok': False, 'error': auth.get('error') or 'OpenTAKServer login failed.', 'attempts': auth.get('attempts', [])}, 401)
        fetched = _i511_fetch_profile(cfg, auth, username)
        if fetched.get('ok'):
            profile = fetched['profile']
        else:
            # Preserve login availability on older/partially compatible OTS
            # installations, but never grant administration without /api/me.
            profile = _i511_profile_from_me({'username': username, 'roles': [], 'euds': []}, username)
            profile['profile_warning'] = str(fetched.get('error') or 'OpenTAKServer profile unavailable.')
        token = _i511_create_profile_session(username, password, 'ots-user', bool(profile.get('is_admin')), auth, profile)
        reply = _i509_session_public(TAK_MAP_SESSIONS.get(token)); reply['ok'] = True
        if profile.get('profile_warning'): reply['profile_warning'] = profile['profile_warning']
        return self._send_json(reply, 200, headers={'Set-Cookie': self._tak_map_session_cookie(token)})
    Handler._handle_tak_map_login = _i511_handle_tak_map_login

    def _i511_status_payload(cfg=None, discovery=None):
        cfg = cfg or _i509_load_ots_config()
        discovery = discovery if isinstance(discovery, dict) else (cfg.get('last_discovery') if isinstance(cfg.get('last_discovery'), dict) else {})
        summary = discovery.get('summary') if isinstance(discovery, dict) else {}
        summary = summary if isinstance(summary, dict) else {}
        validation = cfg.get('last_admin_validation') or {}
        base = str(cfg.get('base_url') or '').rstrip('/')
        checks = {
            'web_reachable': bool(summary.get('web_reachable')),
            'tls_trusted': bool(summary.get('strict_web_tls')),
            'hostname_verified': bool(summary.get('hostname_match')),
            'administrator_authenticated': bool(validation.get('validated_at') and str(validation.get('base_url') or '').rstrip('/') == base),
            'configuration_saved': bool(cfg.get('configured_at') and base),
            'login_enabled': bool(cfg.get('enabled') and cfg.get('login_enabled')),
        }
        complete = all(checks.values())
        return {
            'ok': True,
            'version': 'i511',
            'state': 'complete' if complete else 'incomplete',
            'title': 'OTS Connection: Complete' if complete else 'OTS Connection: Setup Incomplete',
            'message': 'OpenTAKServer has been successfully configured. TAK Map is ready for end-user sign-in.' if complete else 'Complete the remaining OpenTAKServer checks before relying on end-user sign-in.',
            'checks': checks,
            'admin_validation': validation,
            'technical': discovery,
        }

    _i511_do_get_before = Handler.do_GET
    def _i511_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/ots/status':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            if not _i509_require_config_admin(self): return
            return self._send_json(_i511_status_payload())
        return _i511_do_get_before(self)
    Handler.do_GET = _i511_do_get

    _i511_prev_config = tak_map_config
    def tak_map_config():
        cfg = _i511_prev_config()
        if isinstance(cfg, dict):
            cfg = dict(cfg); cfg['tak_map_iteration'] = 'i511'
            ots = dict(cfg.get('ots_integration') or {})
            ots.update({
                'version': 'i511',
                'ots_only_supported_installation': True,
                'account_header': True,
                'callsign_fallback_to_username': True,
                'ots_role_based_administration': True,
                'legacy_client_assistant_primary_ui': False,
                'service_identity_preserved': True,
            })
            cfg['ots_integration'] = ots
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _I511_IDENTITY_UI = r'''<script id="takMapOtsIdentityV511">
(function(w,d){'use strict';const V='i511',by=id=>d.getElementById(id),esc=s=>String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));let session=null,lastStatus=null;
function css(){if(by('otsIdentityStyleV511'))return;const s=d.createElement('style');s.id='otsIdentityStyleV511';s.textContent=`.tak-account-v511{position:relative;display:inline-flex;align-items:center}.tak-account-button-v511{min-height:34px;padding:7px 10px;border:1px solid rgba(255,255,255,.18);border-radius:9px;background:rgba(8,14,20,.82);color:#e8f2f5;font-size:.76rem;font-weight:900;letter-spacing:.045em}.tak-account-menu-v511{position:absolute;right:0;top:calc(100% + 7px);z-index:7200;width:min(310px,calc(100vw - 24px));display:none;padding:10px;border:1px solid rgba(66,211,255,.28);border-radius:12px;background:linear-gradient(180deg,#121d27,#070b10);box-shadow:0 18px 55px rgba(0,0,0,.55)}.tak-account-menu-v511.open{display:block}.tak-account-name-v511{font-size:.92rem;font-weight:950;letter-spacing:.05em}.tak-account-meta-v511{display:grid;grid-template-columns:104px 1fr;gap:5px 8px;margin:9px 0 10px;padding:8px 0;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);font-size:.72rem}.tak-account-meta-v511 b{color:#8fa5af}.tak-account-actions-v511{display:flex;gap:7px;justify-content:flex-end}.ots-primary-status-v511{margin-bottom:10px;padding:12px;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:rgba(255,255,255,.035)}.ots-primary-status-v511.complete{border-color:rgba(86,224,145,.42);background:rgba(38,144,84,.10)}.ots-primary-status-v511 h3{margin:0 0 5px;font-size:.92rem;letter-spacing:.045em}.ots-primary-status-v511 p{margin:0 0 9px;color:#9fb1b9;font-size:.75rem}.ots-checks-v511{display:grid;gap:5px}.ots-check-v511{display:flex;justify-content:space-between;gap:10px;padding:5px 0;border-top:1px solid rgba(255,255,255,.06);font-size:.74rem}.ots-check-v511 span:last-child{font-weight:900}.ots-technical-v511{margin-top:10px;border-top:1px solid rgba(255,255,255,.08);padding-top:8px}.ots-service-note-v511{margin-top:10px;padding:9px;border:1px solid rgba(255,255,255,.08);border-radius:9px;color:#9fb1b9;font-size:.74rem;line-height:1.45}.ots-modal-v509 .ots-grid-v509{grid-template-columns:1fr}.ots-modal-v509 aside.ots-card-v509{display:none}`;d.head.appendChild(s)}
function account(){css();let host=d.querySelector('.top-actions');if(!host)return;const oldBtn=by('takClientSetupBtn');if(oldBtn)oldBtn.style.display='none';[...host.querySelectorAll('button,a')].forEach(el=>{const t=(el.textContent||'').trim();if(/^(map logout|cert setup|tak client)$/i.test(t))el.style.display='none'});['takClientModal','takClientReminder'].forEach(id=>{const el=by(id);if(el)el.remove()});let wrap=by('takAccountV511');if(!wrap){wrap=d.createElement('div');wrap.id='takAccountV511';wrap.className='tak-account-v511';wrap.innerHTML='<button id="takMapAccountBtnV511" class="tak-account-button-v511" type="button">ACCOUNT ▾</button><div id="takMapAccountMenuV511" class="tak-account-menu-v511" role="menu"></div>';host.appendChild(wrap);by('takMapAccountBtnV511').onclick=e=>{e.stopPropagation();by('takMapAccountMenuV511').classList.toggle('open')}}renderAccount();}
function renderAccount(){if(!session)return;const label=session.display_identity||session.callsign||session.username||'ACCOUNT',btn=by('takMapAccountBtnV511'),menu=by('takMapAccountMenuV511');if(!btn||!menu)return;btn.textContent=label+' ▾';const rows=[['Username',session.username||'—'],['Callsign',session.callsign||'Not assigned'],['Identity source',session.identity_source||'OpenTAKServer'],['Connection',session.connection_state||'Authenticated']];if(session.team)rows.push(['Team',session.team]);if(session.team_role)rows.push(['Role',session.team_role]);menu.innerHTML='<div class="tak-account-name-v511">'+esc(label)+'</div><div class="tak-account-meta-v511">'+rows.map(r=>'<b>'+esc(r[0])+'</b><span>'+esc(r[1])+'</span>').join('')+'</div><div class="tak-account-actions-v511">'+(session.is_admin?'<button id="takAccountConfigureV511" type="button">Configure OTS</button>':'')+'<button id="takAccountLogoutV511" type="button">Log Out</button></div>';const c=by('takAccountConfigureV511');if(c)c.onclick=()=>{menu.classList.remove('open');if(typeof w.openConfigureOTS==='function'){w.openConfigureOTS();setTimeout(()=>{cleanModal();status()},60)}};by('takAccountLogoutV511').onclick=()=>{menu.classList.remove('open');if(typeof w.logoutTakMap==='function')w.logoutTakMap()};}
function cleanModal(){const m=by('otsModalV509');if(!m)return;const auth=by('otsAuthV509'),user=by('otsTestUserV509'),pass=by('otsTestPassV509');if(user)user.placeholder='OTS administrator username';if(pass)pass.placeholder='Administrator password (not saved)';if(auth)auth.textContent='Validate Administrator';const legacy=by('otsLegacyClientV509');if(legacy){const det=legacy.closest('details');if(det)det.remove();else legacy.remove()}if(!by('otsServiceIdentityNoteV511')){const out=by('otsOutputV509');if(out)out.insertAdjacentHTML('beforebegin','<div id="otsServiceIdentityNoteV511" class="ots-service-note-v511"><b>TAK Map service identity</b><br>Replay, Gateway Data, composite basemaps, recording integration, and other background services remain separate from the signed-in OpenTAKServer user and continue using the managed TAK Map service identity.</div>')}const status=by('otsStatusV509'),output=by('otsOutputV509');if(status&&!by('otsTechnicalV511')){const card=status.closest('.ots-card-v509');if(card)card.style.display='none';const primary=d.createElement('section');primary.id='otsPrimaryStatusV511';primary.className='ots-primary-status-v511';const left=m.querySelector('.ots-grid-v509 > .ots-card-v509');if(left)left.insertBefore(primary,left.firstChild);const details=d.createElement('details');details.id='otsTechnicalV511';details.className='ots-technical-v511';details.innerHTML='<summary>Technical details</summary><div id="otsTechnicalStatusV511" class="ots-status-v509"></div>';if(output){output.parentNode.insertBefore(details,output);details.appendChild(output)}if(status)by('otsTechnicalStatusV511').appendChild(status)}renderStatus(lastStatus);}
const labels={web_reachable:'OpenTAKServer reachable',tls_trusted:'TLS trusted',hostname_verified:'Hostname verified',administrator_authenticated:'Administrator authentication successful',configuration_saved:'Configuration saved',login_enabled:'End-user login enabled'};
function renderStatus(j){const p=by('otsPrimaryStatusV511');if(!p||!j)return;lastStatus=j;const checks=j.checks||{};p.classList.toggle('complete',j.state==='complete');p.innerHTML='<h3>'+esc(j.title||'OTS Connection')+'</h3><p>'+esc(j.message||'')+'</p><div class="ots-checks-v511">'+Object.keys(labels).map(k=>'<div class="ots-check-v511"><span>'+esc(labels[k])+'</span><span class="'+(checks[k]?'ots-ok-v509':'ots-warn-v509')+'">'+(checks[k]?'Complete':'Needed')+'</span></div>').join('')+'</div>';}
async function status(extra){try{const r=await fetch('/api/tak-map/ots/status',{cache:'no-store',credentials:'same-origin'}),j=await r.json();if(r.ok&&j.ok){if(extra&&extra.summary){j.checks.web_reachable=!!extra.summary.web_reachable;j.checks.tls_trusted=!!extra.summary.strict_web_tls;j.checks.hostname_verified=!!extra.summary.hostname_match;j.state=Object.values(j.checks).every(Boolean)?'complete':'incomplete';j.title=j.state==='complete'?'OTS Connection: Complete':'OTS Connection: Setup Incomplete'}renderStatus(j)}}catch(_){}}
function hook(){cleanModal();['otsDiscoverV509','otsTrustV509','otsSaveV509','otsAuthV509'].forEach(id=>{const b=by(id);if(b&&!b.dataset.i511Status){b.dataset.i511Status='1';b.addEventListener('click',()=>{[350,1000,2200].forEach(ms=>setTimeout(()=>status(w.TakMapOtsFoundationV509&&w.TakMapOtsFoundationV509.lastDiscovery),ms))})}});}
function boot(){css();fetch('/api/tak-map/ots/session',{cache:'no-store',credentials:'same-origin'}).then(r=>r.json()).then(j=>{if(j&&j.ok){session=j;account()}}).catch(()=>{});const prior=w.openConfigureOTS;if(typeof prior==='function')w.openConfigureOTS=function(){prior();setTimeout(()=>{cleanModal();status()},30)};d.addEventListener('click',e=>{const wrap=by('takAccountV511');if(wrap&&!wrap.contains(e.target)){const m=by('takMapAccountMenuV511');if(m)m.classList.remove('open')}});[100,350,900,1800,3200].forEach(ms=>setTimeout(()=>{account();hook()},ms));}
if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapOtsIdentityV511=Object.freeze({version:V,account,cleanModal,renderStatus,status});
})(window,document);
</script>'''

    def _i511_patch_html(html):
        if not isinstance(html, str): return html
        html = html.replace('1.3.0-i510', '1.3.0-i511').replace('TAKDashboard/i510', 'TAKDashboard/i511').replace('TAK-Map/1.3.0 i510', 'TAK-Map/1.3.0 i511')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i511\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i511\2', html)
        if 'id="takMapOtsIdentityV511"' not in html:
            html = html.replace('</body></html>', _I511_IDENTITY_UI + '</body></html>')
        return html

    TAK_MAP_HTML = _i511_patch_html(TAK_MAP_HTML); INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i511_patch_html(TAK_MAP_LOGIN_HTML); LOGIN_HTML = _i511_patch_html(LOGIN_HTML)
except Exception as _i511_exc:
    try: print('TAK Map i511 OTS identity refinement failed:', _i511_exc)
    except Exception: pass
# --- end TAK Map i511 OTS identity, permissions, and account-menu refinement ---


# --- TAK Map i512 local accounts, callsigns, OTS disconnect, and user-scoped Data Sync ---
try:
    TAK_MAP_LOCAL_ACCOUNTS_FILE = DATA_DIR / 'local_accounts.json'
    TAK_MAP_USER_IDENTITIES_FILE = DATA_DIR / 'user_identities.json'
    TAK_MAP_LOCAL_AUTH_AUDIT_FILE = DIAG_DIR / 'local_auth_audit.jsonl'
    TAK_MAP_LOCAL_ACCOUNTS_LOCK = threading.RLock()
    TAK_MAP_LOCAL_LOGIN_FAILURES = {}
    TAK_MAP_LOCAL_LOGIN_FAILURES_LOCK = threading.Lock()
    TAK_MAP_LOCAL_LOGIN_FAIL_LIMIT = max(3, int(os.environ.get('TAK_MAP_LOCAL_LOGIN_FAIL_LIMIT', '5') or '5'))
    TAK_MAP_LOCAL_LOGIN_FAIL_WINDOW = max(60, int(os.environ.get('TAK_MAP_LOCAL_LOGIN_FAIL_WINDOW_SECONDS', '900') or '900'))
    TAK_MAP_LOCAL_PASSWORD_ITERATIONS = max(200000, int(os.environ.get('TAK_MAP_LOCAL_PASSWORD_ITERATIONS', '310000') or '310000'))
    TAK_MAP_GATEWAY_PUBLIC_BASEMAP_BASE_URL = str(os.environ.get('TAK_MAP_GATEWAY_PUBLIC_BASEMAP_BASE_URL', '') or '').strip()
    _I512_REQUEST_CONTEXT = threading.local()

    def _i512_iso_now():
        return datetime.now(timezone.utc).isoformat()

    def _i512_atomic_json(path, data, mode=0o600):
        path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp_name = tempfile.mkstemp(prefix=path.name + '.', suffix='.tmp', dir=str(path.parent))
        try:
            with os.fdopen(fd, 'w') as f:
                json.dump(data, f, indent=2, sort_keys=True)
                f.write('\n'); f.flush(); os.fsync(f.fileno())
            os.chmod(tmp_name, mode); os.replace(tmp_name, path)
        finally:
            try:
                if os.path.exists(tmp_name): os.unlink(tmp_name)
            except Exception: pass

    def _i512_hash_password(password, salt=None, iterations=None):
        password = str(password or '')
        iterations = int(iterations or TAK_MAP_LOCAL_PASSWORD_ITERATIONS)
        salt_bytes = secrets.token_bytes(16) if salt is None else salt
        digest = hashlib.pbkdf2_hmac('sha256', password.encode('utf-8'), salt_bytes, iterations)
        return 'pbkdf2_sha256$%d$%s$%s' % (iterations, base64.urlsafe_b64encode(salt_bytes).decode().rstrip('='), base64.urlsafe_b64encode(digest).decode().rstrip('='))

    def _i512_b64decode(value):
        value = str(value or '')
        return base64.urlsafe_b64decode(value + ('=' * ((4 - len(value) % 4) % 4)))

    def _i512_verify_password(stored, password):
        try:
            scheme, iterations, salt, expected = str(stored or '').split('$', 3)
            if scheme != 'pbkdf2_sha256': return False
            actual = hashlib.pbkdf2_hmac('sha256', str(password or '').encode('utf-8'), _i512_b64decode(salt), int(iterations))
            return hmac.compare_digest(actual, _i512_b64decode(expected))
        except Exception:
            return False

    def _i512_local_uid(username, account_id=''):
        seed = 'tak-map-local|' + str(account_id or username).strip().lower()
        return 'TAKMAP-LOCAL-' + str(uuid.uuid5(uuid.NAMESPACE_URL, seed)).upper()

    def _i512_default_local_admin():
        account_id = str(uuid.uuid4())
        now = _i512_iso_now()
        return {
            'id': account_id,
            'username': 'administrator',
            'password_hash': _i512_hash_password('password'),
            'is_admin': True,
            'active': True,
            'must_change_password': True,
            'callsign': '',
            'tak_uid': _i512_local_uid('administrator', account_id),
            'created_at': now,
            'updated_at': now,
            'last_login_at': '',
        }

    def _i512_load_local_accounts(create=True):
        with TAK_MAP_LOCAL_ACCOUNTS_LOCK:
            raw = load_json_file(TAK_MAP_LOCAL_ACCOUNTS_FILE, {})
            if not isinstance(raw, dict): raw = {}
            users = raw.get('users') if isinstance(raw.get('users'), dict) else {}
            normalized = {}
            for key, row in users.items():
                if not isinstance(row, dict): continue
                username = sanitize_ots_username(row.get('username') or key)
                if not username: continue
                item = dict(row); item['username'] = username
                item['id'] = str(item.get('id') or uuid.uuid4())
                item['is_admin'] = bool(item.get('is_admin'))
                item['active'] = item.get('active') is not False
                item['must_change_password'] = bool(item.get('must_change_password'))
                item['callsign'] = str(item.get('callsign') or '')[:64]
                item['tak_uid'] = str(item.get('tak_uid') or _i512_local_uid(username, item['id']))[:240]
                normalized[username.lower()] = item
            if 'administrator' not in normalized:
                normalized['administrator'] = _i512_default_local_admin()
            data = {'version': 'i512', 'users': normalized, 'updated_at': str(raw.get('updated_at') or _i512_iso_now())}
            if create and (not TAK_MAP_LOCAL_ACCOUNTS_FILE.exists() or normalized != users):
                data['updated_at'] = _i512_iso_now(); _i512_atomic_json(TAK_MAP_LOCAL_ACCOUNTS_FILE, data)
            return data

    def _i512_save_local_accounts(data):
        with TAK_MAP_LOCAL_ACCOUNTS_LOCK:
            data = dict(data or {}); data['version'] = 'i512'; data['updated_at'] = _i512_iso_now()
            _i512_atomic_json(TAK_MAP_LOCAL_ACCOUNTS_FILE, data)
            return data

    def _i512_audit(event, username='', ok=None, detail='', remote=''):
        try:
            DIAG_DIR.mkdir(parents=True, exist_ok=True)
            row = {'time': _i512_iso_now(), 'event': str(event or '')[:80], 'username': str(username or '')[:80], 'remote': str(remote or '')[:120], 'detail': str(detail or '')[:500]}
            if ok is not None: row['ok'] = bool(ok)
            with open(TAK_MAP_LOCAL_AUTH_AUDIT_FILE, 'a') as f: f.write(json.dumps(row, sort_keys=True) + '\n')
            try: os.chmod(TAK_MAP_LOCAL_AUTH_AUDIT_FILE, 0o600)
            except Exception: pass
        except Exception: pass

    def _i512_remote(handler):
        try: return str(handler.client_address[0])
        except Exception: return ''

    def _i512_failure_key(handler, username):
        return (_i512_remote(handler), str(username or '').lower())

    def _i512_rate_limited(handler, username):
        now = time.time(); key = _i512_failure_key(handler, username)
        with TAK_MAP_LOCAL_LOGIN_FAILURES_LOCK:
            rows = [t for t in TAK_MAP_LOCAL_LOGIN_FAILURES.get(key, []) if now - t < TAK_MAP_LOCAL_LOGIN_FAIL_WINDOW]
            TAK_MAP_LOCAL_LOGIN_FAILURES[key] = rows
            return len(rows) >= TAK_MAP_LOCAL_LOGIN_FAIL_LIMIT

    def _i512_record_failure(handler, username):
        key = _i512_failure_key(handler, username); now = time.time()
        with TAK_MAP_LOCAL_LOGIN_FAILURES_LOCK:
            rows = [t for t in TAK_MAP_LOCAL_LOGIN_FAILURES.get(key, []) if now - t < TAK_MAP_LOCAL_LOGIN_FAIL_WINDOW]
            rows.append(now); TAK_MAP_LOCAL_LOGIN_FAILURES[key] = rows

    def _i512_clear_failures(handler, username):
        with TAK_MAP_LOCAL_LOGIN_FAILURES_LOCK:
            TAK_MAP_LOCAL_LOGIN_FAILURES.pop(_i512_failure_key(handler, username), None)

    def _i512_callsign(value, allow_empty=False):
        value = str(value or '').strip()
        if not value and allow_empty: return ''
        if not value: raise ValueError('Callsign is required.')
        if len(value) > 32: raise ValueError('Callsign must be 32 characters or fewer for TAK client compatibility.')
        if any(ord(ch) < 32 or ch in '<>&\"\'' for ch in value):
            raise ValueError('Callsign contains characters that are not safe for TAK/CoT XML.')
        if value[0].isspace() or value[-1].isspace(): raise ValueError('Callsign cannot start or end with whitespace.')
        return value

    def _i512_load_identities():
        raw = load_json_file(TAK_MAP_USER_IDENTITIES_FILE, {})
        if not isinstance(raw, dict): raw = {}
        identities = raw.get('identities') if isinstance(raw.get('identities'), dict) else {}
        return {'version': 'i512', 'identities': identities, 'updated_at': str(raw.get('updated_at') or '')}

    def _i512_save_identities(data):
        data = dict(data or {}); data['version'] = 'i512'; data['updated_at'] = _i512_iso_now()
        _i512_atomic_json(TAK_MAP_USER_IDENTITIES_FILE, data); return data

    def _i512_ots_identity_key(cfg, profile):
        origin = str((cfg or {}).get('base_url') or '').rstrip('/').lower()
        user_key = str((profile or {}).get('user_id') or (profile or {}).get('username') or '').strip().lower()
        return hashlib.sha256((origin + '|' + user_key).encode()).hexdigest()

    def _i512_ots_uid(cfg, profile):
        origin = str((cfg or {}).get('base_url') or '').rstrip('/').lower()
        user_key = str((profile or {}).get('user_id') or (profile or {}).get('username') or '').strip().lower()
        return 'TAKMAP-USER-' + str(uuid.uuid5(uuid.NAMESPACE_URL, 'tak-map-ots|' + origin + '|' + user_key)).upper()

    def _i512_callsign_owner(callsign, exclude_kind='', exclude_key=''):
        needle = str(callsign or '').strip().casefold()
        if not needle: return ''
        accounts = _i512_load_local_accounts().get('users', {})
        for key, row in accounts.items():
            if exclude_kind == 'local' and key == exclude_key: continue
            if str(row.get('callsign') or '').strip().casefold() == needle: return 'local user ' + str(row.get('username') or key)
        identities = _i512_load_identities().get('identities', {})
        for key, row in identities.items():
            if exclude_kind == 'ots' and key == exclude_key: continue
            if str(row.get('callsign') or '').strip().casefold() == needle: return 'OpenTAKServer user ' + str(row.get('username') or key[:10])
        return ''

    def _i512_apply_ots_identity(cfg, profile):
        profile = dict(profile or {}); key = _i512_ots_identity_key(cfg, profile)
        data = _i512_load_identities(); identities = data.get('identities', {})
        item = dict(identities.get(key) or {})
        suggested = str(profile.get('callsign') or '')
        if not item:
            item = {'provider': 'ots', 'origin': str(cfg.get('base_url') or '').rstrip('/'), 'user_id': profile.get('user_id') or '', 'username': profile.get('username') or '', 'callsign': '', 'tak_uid': _i512_ots_uid(cfg, profile), 'created_at': _i512_iso_now()}
        item['username'] = str(profile.get('username') or item.get('username') or '')
        item['user_id'] = profile.get('user_id') or item.get('user_id') or ''
        item['tak_uid'] = str(item.get('tak_uid') or _i512_ots_uid(cfg, profile))
        item['suggested_callsign'] = suggested
        item['updated_at'] = _i512_iso_now(); identities[key] = item; data['identities'] = identities; _i512_save_identities(data)
        selected = str(item.get('callsign') or '')
        profile['suggested_callsign'] = suggested
        profile['selected_callsign'] = selected
        profile['callsign'] = selected or suggested
        profile['display_identity'] = profile['callsign'] or profile.get('username') or ''
        profile['tak_uid'] = item['tak_uid']; profile['identity_key'] = key
        return profile

    def _i512_local_profile(account):
        account = dict(account or {}); username = str(account.get('username') or '')
        is_admin = bool(account.get('is_admin')); callsign = str(account.get('callsign') or '')
        return {
            'username': username, 'user_id': str(account.get('id') or ''), 'active': account.get('active') is not False,
            'callsign': callsign, 'selected_callsign': callsign, 'suggested_callsign': '',
            'display_identity': 'LOCAL ADMIN' if is_admin else (callsign or username),
            'identity_source': 'Local', 'connection_state': 'Authenticated', 'is_admin': is_admin,
            'roles': [{'name': 'Local Administrator' if is_admin else 'Local User', 'description': 'Built-in TAK Map account', 'permissions': ['configure-ots', 'manage-local-users'] if is_admin else ['use-tak-map']}],
            'role_names': ['Local Administrator' if is_admin else 'Local User'],
            'permissions': ['configure-ots', 'manage-local-users'] if is_admin else ['use-tak-map'],
            'groups': [], 'group_memberships': [], 'euds': [], 'team': '', 'team_role': '',
            'tak_uid': str(account.get('tak_uid') or _i512_local_uid(username, account.get('id'))),
            'must_change_password': bool(account.get('must_change_password')), 'local_account': True,
        }

    def _i512_public_local_user(row):
        return {k: row.get(k) for k in ('id','username','is_admin','active','must_change_password','callsign','tak_uid','created_at','updated_at','last_login_at')}

    def _i512_local_admin_ready():
        admin = _i512_load_local_accounts().get('users', {}).get('administrator') or {}
        return bool(admin.get('active') and admin.get('is_admin') and not admin.get('must_change_password'))

    def _i512_authenticate_local(handler, username, password):
        username = sanitize_ots_username(username)
        if _i512_rate_limited(handler, username):
            _i512_audit('local-login-rate-limited', username, False, remote=_i512_remote(handler))
            return None, 'Too many failed Local Login attempts. Try again later.', 429
        data = _i512_load_local_accounts(); account = data.get('users', {}).get(username.lower())
        cfg = _i509_load_ots_config(); ots_active = bool(cfg.get('enabled') and cfg.get('login_enabled'))
        ok = bool(account and account.get('active') and _i512_verify_password(account.get('password_hash'), password))
        if not ok:
            _i512_record_failure(handler, username); _i512_audit('local-login', username, False, 'Invalid credentials or disabled account.', _i512_remote(handler))
            return None, 'Invalid Local Login username or password.', 401
        if ots_active and not account.get('is_admin'):
            _i512_audit('local-login-blocked-ots-active', username, False, 'Local non-admin accounts are preserved but unavailable while OTS login is active.', _i512_remote(handler))
            return None, 'Local non-administrator accounts are unavailable while OpenTAKServer Login is active.', 403
        _i512_clear_failures(handler, username); account = dict(account); account['last_login_at'] = _i512_iso_now(); account['updated_at'] = _i512_iso_now()
        data['users'][username.lower()] = account; _i512_save_local_accounts(data)
        _i512_audit('local-login', username, True, 'Administrator' if account.get('is_admin') else 'User', _i512_remote(handler))
        return account, '', 200

    _i512_profile_from_me_before = _i511_profile_from_me
    def _i511_profile_from_me(raw, fallback_username=''):
        profile = _i512_profile_from_me_before(raw, fallback_username)
        try: return _i512_apply_ots_identity(_i509_load_ots_config(), profile)
        except Exception: return profile

    _i512_session_public_before = _i509_session_public
    def _i509_session_public(sess):
        out = dict(_i512_session_public_before(sess)); sess = sess or {}; profile = dict(sess.get('profile') or {})
        out.update({
            'version':'i512', 'tak_uid': str(profile.get('tak_uid') or sess.get('tak_uid') or ''),
            'selected_callsign': str(profile.get('selected_callsign') or ''), 'suggested_callsign': str(profile.get('suggested_callsign') or ''),
            'must_change_password': bool(sess.get('must_change_password') or profile.get('must_change_password')),
            'local_account': bool(profile.get('local_account') or str(sess.get('auth_mode') or '').startswith('local-')),
        })
        return out

    def _i512_create_local_session(account):
        profile = _i512_local_profile(account); mode = 'local-admin' if account.get('is_admin') else 'local-user'
        token = _i511_create_profile_session(account.get('username'), '', mode, bool(account.get('is_admin')), {'auth_method':'tak-map-local-account'}, profile)
        with TAK_MAP_SESSIONS_LOCK:
            sess = TAK_MAP_SESSIONS.get(token)
            if sess is not None:
                sess['password'] = ''; sess['must_change_password'] = bool(account.get('must_change_password')); sess['tak_uid'] = profile.get('tak_uid')
        return token

    def _i512_handle_login(self):
        if not self._is_secure_request() and not ALLOW_INSECURE_UPLOAD_AUTH:
            return self._send_json({'ok':False,'error':'TAK Map login requires HTTPS.'},403)
        f = self._read_form(); mode = str(f.get('mode') or '').strip().lower()
        username = sanitize_ots_username(f.get('username','')); password = str(f.get('password') or '')
        if mode in ('local','local-user','local-admin','recovery','admin'):
            account, error, status = _i512_authenticate_local(self, username, password)
            if not account: return self._send_json({'ok':False,'error':error,'local_login':True}, status)
            token = _i512_create_local_session(account); reply = _i509_session_public(TAK_MAP_SESSIONS.get(token)); reply['ok'] = True
            return self._send_json(reply, 200, headers={'Set-Cookie':self._tak_map_session_cookie(token)})
        return _i511_handle_tak_map_login(self)
    Handler._handle_tak_map_login = _i512_handle_login

    def _i512_forced_change(sess):
        return bool(sess and sess.get('must_change_password'))

    def _i512_password_page():
        return '''<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Change Local Password · TAK Map</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#06090d;color:#e9f0f5;font-family:system-ui}.card{width:min(440px,calc(100vw - 28px));padding:24px;border:1px solid #354556;border-radius:16px;background:#101923;box-shadow:0 25px 80px #0008}h1{font-size:1.15rem;letter-spacing:.05em}p{color:#a7b5bd;line-height:1.5}label{display:block;margin:12px 0 5px;font-size:.8rem;font-weight:800}input{width:100%;box-sizing:border-box;padding:10px;border:1px solid #405261;border-radius:9px;background:#081018;color:#fff}button{width:100%;margin-top:16px;padding:11px;border:1px solid #ff6f2e;border-radius:10px;background:#d95720;color:white;font-weight:900}.error{color:#ff7a72;margin-top:10px}.success{color:#7ee787;margin-top:10px;font-weight:800}</style></head><body><form class="card" id="localPasswordChangeForm"><h1>Change the default local administrator password</h1><p>Nothing else in TAK Map is available until the default password is replaced. Use a unique password with at least 8 characters.</p><label for="currentPassword">Current password</label><input id="currentPassword" name="current_password" type="password" autocomplete="current-password" required><label for="newPassword">New password</label><input id="newPassword" name="new_password" type="password" autocomplete="new-password" minlength="8" required><label for="confirmPassword">Confirm new password</label><input id="confirmPassword" name="confirm_password" type="password" autocomplete="new-password" minlength="8" required><button id="changePasswordButton" type="submit">Change Password</button><div id="passwordChangeStatus" class="error" role="alert" aria-live="polite"></div></form><script>(function(){'use strict';const form=document.getElementById('localPasswordChangeForm'),currentInput=document.getElementById('currentPassword'),newInput=document.getElementById('newPassword'),confirmInput=document.getElementById('confirmPassword'),button=document.getElementById('changePasswordButton'),box=document.getElementById('passwordChangeStatus');function compare(){const match=newInput.value===confirmInput.value;confirmInput.setCustomValidity(match?'':'New password and confirmation do not match.');return match}newInput.addEventListener('input',compare);confirmInput.addEventListener('input',compare);form.addEventListener('submit',async event=>{event.preventDefault();box.className='error';box.textContent='';if(!compare()){confirmInput.reportValidity();return}button.disabled=true;button.textContent='Changing…';try{const r=await fetch('/api/tak-map/account/change-password',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({current_password:currentInput.value,new_password:newInput.value,confirm_password:confirmInput.value})});const j=await r.json().catch(()=>({error:'Password change failed. Server did not return JSON.'}));if(!r.ok||!j.ok)throw Error(j.error||'Password change failed');box.className='success';box.textContent=j.message||'Password changed successfully. Opening TAK Map…';button.textContent='Password Changed';setTimeout(()=>{window.location.replace('/tak-map')},700)}catch(x){box.className='error';box.textContent=x.message||String(x);button.disabled=false;button.textContent='Change Password'}})})();</script></body></html>'''

    def _i512_update_callsign(sess, requested):
        callsign = _i512_callsign(requested, allow_empty=True); profile = dict(sess.get('profile') or {})
        mode = str(sess.get('auth_mode') or '')
        if mode.startswith('local-'):
            data = _i512_load_local_accounts(); key = str(profile.get('username') or sess.get('username') or '').lower(); account = data.get('users', {}).get(key)
            if not account: raise ValueError('Local account was not found.')
            owner = _i512_callsign_owner(callsign, 'local', key) if callsign else ''
            if owner: raise ValueError('That callsign is already assigned to ' + owner + '.')
            account = dict(account); account['callsign'] = callsign; account['updated_at'] = _i512_iso_now(); data['users'][key] = account; _i512_save_local_accounts(data)
            new_profile = _i512_local_profile(account)
        else:
            cfg = _i509_load_ots_config(); key = str(profile.get('identity_key') or _i512_ots_identity_key(cfg, profile)); data = _i512_load_identities(); identities = data.get('identities', {}); item = dict(identities.get(key) or {})
            owner = _i512_callsign_owner(callsign, 'ots', key) if callsign else ''
            if owner: raise ValueError('That callsign is already assigned to ' + owner + '.')
            item.update({'provider':'ots','origin':str(cfg.get('base_url') or '').rstrip('/'),'user_id':profile.get('user_id') or '', 'username':profile.get('username') or sess.get('username') or '', 'callsign':callsign, 'tak_uid':str(item.get('tak_uid') or profile.get('tak_uid') or _i512_ots_uid(cfg, profile)), 'updated_at':_i512_iso_now()})
            identities[key] = item; data['identities'] = identities; _i512_save_identities(data)
            new_profile = dict(profile); new_profile['selected_callsign'] = callsign; new_profile['callsign'] = callsign or str(new_profile.get('suggested_callsign') or ''); new_profile['display_identity'] = new_profile['callsign'] or str(new_profile.get('username') or '')
        with TAK_MAP_SESSIONS_LOCK:
            sess['profile'] = new_profile; sess['callsign'] = new_profile.get('callsign') or ''; sess['display_identity'] = new_profile.get('display_identity') or ''; sess['tak_uid'] = new_profile.get('tak_uid') or sess.get('tak_uid') or ''
        _i512_audit('callsign-change', new_profile.get('username') or '', True, callsign or 'reset-to-fallback')
        return _i509_session_public(sess)

    def _i512_change_local_password(sess, payload):
        if not str(sess.get('auth_mode') or '').startswith('local-'): raise ValueError('Password changes here are only for Local Login accounts.')
        username = str(sess.get('username') or '').lower(); data = _i512_load_local_accounts(); account = data.get('users', {}).get(username)
        if not account: raise ValueError('Local account was not found.')
        current = str(payload.get('current_password') or ''); new = str(payload.get('new_password') or ''); confirm = str(payload.get('confirm_password') or '')
        if not _i512_verify_password(account.get('password_hash'), current): raise ValueError('Current password is incorrect.')
        if new != confirm: raise ValueError('New password and confirmation do not match.')
        if len(new) < 8: raise ValueError('New password must be at least 8 characters.')
        if new == 'password' or new.lower() == username: raise ValueError('Choose a password that is not the default password or username.')
        account = dict(account); account['password_hash'] = _i512_hash_password(new); account['must_change_password'] = False; account['updated_at'] = _i512_iso_now(); data['users'][username] = account; _i512_save_local_accounts(data)
        token = ''
        try: token = str(getattr(_I512_REQUEST_CONTEXT, 'session_token', '') or '')
        except Exception: token = ''
        with TAK_MAP_SESSIONS_LOCK:
            live = TAK_MAP_SESSIONS.get(token) if token else None
            if live is None:
                for candidate_token, candidate in TAK_MAP_SESSIONS.items():
                    if candidate is sess:
                        token, live = candidate_token, candidate
                        break
            if live is not None:
                live['must_change_password'] = False
                profile = dict(live.get('profile') or {}); profile['must_change_password'] = False; live['profile'] = profile
                live['expires'] = time.time() + TAK_MAP_SESSION_TTL_SECONDS
                sess = live
            else:
                sess = dict(sess or {}); sess['must_change_password'] = False
                profile = dict(sess.get('profile') or {}); profile['must_change_password'] = False; sess['profile'] = profile
        _i512_audit('local-password-change', username, True)
        return {'ok':True,'message':'Password changed successfully. Opening TAK Map…','session':_i509_session_public(sess)}

    def _i512_manage_local_users(payload, actor):
        action = str(payload.get('action') or '').strip().lower(); data = _i512_load_local_accounts(); users = data.get('users', {})
        if action == 'create':
            username = sanitize_ots_username(payload.get('username') or '')
            if not username or not re.fullmatch(r'[A-Za-z0-9_.-]{1,64}', username): raise ValueError('Local username must use 1–64 letters, numbers, periods, underscores, or hyphens.')
            key = username.lower()
            if key in users: raise ValueError('That local username already exists.')
            password = str(payload.get('password') or '')
            if len(password) < 8: raise ValueError('Temporary password must be at least 8 characters.')
            callsign = _i512_callsign(payload.get('callsign') or '', allow_empty=True)
            owner = _i512_callsign_owner(callsign) if callsign else ''
            if owner: raise ValueError('That callsign is already assigned to ' + owner + '.')
            account_id = str(uuid.uuid4()); now = _i512_iso_now()
            users[key] = {'id':account_id,'username':username,'password_hash':_i512_hash_password(password),'is_admin':False,'active':True,'must_change_password':True,'callsign':callsign,'tak_uid':_i512_local_uid(username, account_id),'created_at':now,'updated_at':now,'last_login_at':''}
        elif action in ('enable','disable','reset-password','set-callsign'):
            key = sanitize_ots_username(payload.get('username') or '').lower(); account = users.get(key)
            if not account: raise ValueError('Local user was not found.')
            if key == 'administrator' and action == 'disable': raise ValueError('The built-in local administrator cannot be disabled.')
            account = dict(account)
            if action == 'enable': account['active'] = True
            elif action == 'disable': account['active'] = False
            elif action == 'reset-password':
                password = str(payload.get('password') or '')
                if len(password) < 8: raise ValueError('Temporary password must be at least 8 characters.')
                account['password_hash'] = _i512_hash_password(password); account['must_change_password'] = True
            elif action == 'set-callsign':
                callsign = _i512_callsign(payload.get('callsign') or '', allow_empty=True); owner = _i512_callsign_owner(callsign, 'local', key) if callsign else ''
                if owner: raise ValueError('That callsign is already assigned to ' + owner + '.')
                account['callsign'] = callsign
            account['updated_at'] = _i512_iso_now(); users[key] = account
        else: raise ValueError('Unknown local-user action.')
        data['users'] = users; _i512_save_local_accounts(data); _i512_audit('local-user-' + action, str(payload.get('username') or ''), True, 'actor=' + str((actor or {}).get('username') or ''))
        return {'ok':True,'users':[_i512_public_local_user(v) for v in sorted(users.values(), key=lambda r:(not bool(r.get('is_admin')), str(r.get('username') or '').lower()))]}

    def _i512_disconnect_ots():
        if not _i512_local_admin_ready(): raise ValueError('Change the built-in local administrator password before disconnecting OpenTAKServer.')
        cfg = _i509_load_ots_config(); cfg = dict(cfg); cfg['enabled'] = False; cfg['login_enabled'] = False; cfg['disconnected_at'] = _i512_iso_now()
        _i511_write_ots_config(_i509_normalize_ots_config(cfg, cfg))
        with TAK_MAP_SESSIONS_LOCK:
            for token, sess in list(TAK_MAP_SESSIONS.items()):
                if str(sess.get('auth_mode') or '').startswith('ots-'): TAK_MAP_SESSIONS.pop(token, None)
        _i512_audit('ots-disconnect', 'administrator', True)
        return {'ok':True,'message':'OpenTAKServer disconnected. Preserved local non-administrator accounts are available again.','config':_i509_public_ots_config()}

    def _i512_json_response_body(probe):
        try: return json.loads(str(probe.get('body') or probe.get('body_preview') or '{}'))
        except Exception: return None

    def _i512_request_json(cfg, sess, url, timeout=10):
        auth = {
            'token': str((sess or {}).get('ots_token') or (sess or {}).get('token') or ''),
            'token_header': str((sess or {}).get('ots_token_header') or (sess or {}).get('token_header') or 'Authorization'),
            'token_prefix': str((sess or {}).get('ots_token_prefix') or (sess or {}).get('token_prefix') or 'Bearer'),
            'cookies': dict((sess or {}).get('ots_cookies') or (sess or {}).get('cookies') or {}),
            'csrf_token': str((sess or {}).get('ots_csrf_token') or (sess or {}).get('csrf_token') or ''),
        }
        headers = _i511_auth_headers(cfg, auth)
        context = _i509_ssl_context(cfg)
        cert = str(cfg.get('client_cert_path') or '').strip(); key = str(cfg.get('client_key_path') or '').strip()
        if cert and Path(cert).is_file():
            try: context.load_cert_chain(certfile=cert, keyfile=key or None)
            except Exception: pass
        try:
            req = Request(url, headers=headers, method='GET')
            with urlopen(req, timeout=timeout, context=context) as resp:
                body = resp.read(2*1024*1024).decode('utf-8','replace'); status = int(getattr(resp,'status',200) or 200)
            try: obj = json.loads(body or '{}')
            except Exception: obj = body
            return {'ok':200 <= status < 300,'status':status,'body':obj,'error':''}
        except HTTPError as e:
            try: body=e.read(262144).decode('utf-8','replace')
            except Exception: body=''
            return {'ok':False,'status':int(getattr(e,'code',0) or 0),'body':body[:1000],'error':'HTTP '+str(getattr(e,'code',''))}
        except Exception as e: return {'ok':False,'status':0,'body':None,'error':str(e)}

    def _i512_mission_names(value):
        out=[]
        def walk(v):
            if isinstance(v, list):
                for x in v: walk(x)
            elif isinstance(v, dict):
                name = v.get('name') or v.get('mission_name') or v.get('missionName')
                if isinstance(name,(str,int)) and str(name).strip() and str(name).strip() not in out: out.append(str(name).strip())
                for k,x in v.items():
                    if k not in ('name','mission_name','missionName') and isinstance(x,(list,dict)): walk(x)
        walk(value); return out[:40]

    def _i512_mission_api_objects(value, mission):
        rows=[]
        def add_dict(d):
            candidate=dict(d); candidate.setdefault('mission',mission); candidate.setdefault('source','Mission API'); candidate.setdefault('kind','datasync')
            marker=None
            try: marker=_normalize_tak_marker(candidate,'mission_api','datasync')
            except Exception: marker=None
            if marker and (marker.get('uid') or marker.get('lat') is not None or marker.get('geometry')):
                marker['mission']=mission; marker['source']='Mission API'; marker['kind']='datasync'; marker['is_mission_object']=True; rows.append(marker); return
            for key in ('cot','xml','event'):
                text=d.get(key)
                if isinstance(text,str) and '<event' in text:
                    try:
                        parsed=_parse_cot_text_fields({'xml':text}); parsed.update({'xml':text,'mission':mission,'source':'Mission API','kind':'datasync'})
                        marker=_normalize_tak_marker(parsed,'mission_api','datasync')
                        if marker: marker.update({'mission':mission,'source':'Mission API','kind':'datasync','is_mission_object':True}); rows.append(marker)
                    except Exception: pass
        def walk(v):
            if isinstance(v,list):
                for x in v: walk(x)
            elif isinstance(v,dict):
                interesting = any(k in v for k in ('uid','cot','xml','event','lat','latitude','geometry','GeoJSON','coordinates'))
                if interesting: add_dict(v)
                for x in v.values():
                    if isinstance(x,(list,dict)): walk(x)
        walk(value); return rows

    def _i512_augment_data_sync(base, cfg, sess):
        out = dict(base or {}); diagnostics=[]; api_objects=[]; mission_names=[]
        if not str(sess.get('auth_mode') or '').startswith('ots-'):
            out['mission_api_user_scope_i512']={'version':'i512','state':'not-applicable','reason':'Local Login session'}; return out
        api = str(cfg.get('api_url') or cfg.get('base_url') or '').rstrip('/'); marti = str(cfg.get('marti_url') or '').rstrip('/')
        for label,url in (('ots-api',api+'/api/missions' if api else ''),('marti',marti+'/Marti/api/missions' if marti else '')):
            if not url: continue
            res=_i512_request_json(cfg,sess,url); diagnostics.append({'endpoint':label,'status':res.get('status'),'ok':res.get('ok'),'error':res.get('error')})
            if res.get('ok'):
                for name in _i512_mission_names(res.get('body')):
                    if name not in mission_names: mission_names.append(name)
        for mission in mission_names[:20]:
            q=quote(mission,safe='')
            for suffix in ('','/contents','/cot'):
                url=marti+'/Marti/api/missions/'+q+suffix if marti else ''
                if not url: continue
                res=_i512_request_json(cfg,sess,url); diagnostics.append({'endpoint':'mission:'+mission+suffix,'status':res.get('status'),'ok':res.get('ok'),'error':res.get('error')})
                if res.get('ok'): api_objects.extend(_i512_mission_api_objects(res.get('body'),mission))
        existing=list(out.get('objects') or []); seen=set()
        for row in existing:
            key=(str(row.get('mission') or '').lower(),str(row.get('uid') or row.get('id') or row.get('name') or '').lower())
            if key[1]: seen.add(key)
        added=[]
        for row in api_objects:
            key=(str(row.get('mission') or '').lower(),str(row.get('uid') or row.get('id') or row.get('name') or '').lower())
            if key[1] and key in seen: continue
            if key[1]: seen.add(key)
            added.append(row)
        out['objects']=existing+added
        current_missions=list(out.get('missions') or [])
        known={str((m.get('name') if isinstance(m,dict) else m) or '').lower() for m in current_missions}
        for name in mission_names:
            if name.lower() not in known: current_missions.append({'name':name,'source':'Mission API'}); known.add(name.lower())
        out['missions']=current_missions
        out['mission_api_user_scope_i512']={'version':'i512','state':'ok' if any(d.get('ok') for d in diagnostics) else 'unavailable','mission_count':len(mission_names),'objects_added':len(added),'endpoints':diagnostics[:80],'identity':str((sess.get('profile') or {}).get('username') or sess.get('username') or '')}
        return out

    def _i512_current_identity():
        identity = getattr(_I512_REQUEST_CONTEXT, 'identity', {}) or {}
        if not isinstance(identity, dict): return {}
        return {
            'username': str(identity.get('username') or '').strip(),
            'callsign': str(identity.get('callsign') or '').strip(),
            'tak_uid': str(identity.get('tak_uid') or '').strip(),
        }

    def _i512_stamp_cot_creator(xml):
        """Attach TAK-native creator identity without changing the object's own contact/name."""
        identity = _i512_current_identity()
        if not identity.get('tak_uid') or not identity.get('callsign') or not xml:
            return xml
        as_bytes = isinstance(xml, (bytes, bytearray))
        try:
            root = ET.fromstring(bytes(xml) if as_bytes else str(xml).encode('utf-8'))
            detail = root.find('detail')
            if detail is None: detail = ET.SubElement(root, 'detail')
            creator = detail.find('creator')
            if creator is None: creator = ET.SubElement(detail, 'creator')
            creator.set('uid', identity['tak_uid'])
            creator.set('callsign', identity['callsign'])
            creator.set('time', _cot_time(datetime.now(timezone.utc)))
            creator.set('type', creator.get('type') or 'a-f-G-U-C-R-V-G')
            rendered = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            return rendered.encode('utf-8') if as_bytes else rendered
        except Exception:
            return xml

    # Mission API authorization may require a server-recognized EUD UID. Keep
    # those candidates, but carry the signed-in user's selected callsign on the
    # candidate so generated TAK objects use the same human-readable identity.
    _i512_candidate_creators_before = globals().get('_v337_candidate_creators')
    if callable(_i512_candidate_creators_before):
        def _v337_candidate_creators(preferred_uid=''):
            rows = list(_i512_candidate_creators_before(preferred_uid) or [])
            identity = _i512_current_identity()
            if not identity: return rows
            for row in rows:
                if isinstance(row, dict):
                    row['callsign'] = identity.get('callsign') or row.get('callsign') or ''
                    row['username'] = identity.get('username') or row.get('username') or ''
                    row['tak_map_user_uid'] = identity.get('tak_uid') or ''
            # If no real EUD candidate exists, try the stable TAK Map user UID
            # before the machine-service fallback. Failed attempts still fall
            # through to the preserved legacy candidates.
            if identity.get('tak_uid') and not any(str((r or {}).get('source') or '') == 'tak_map_euds' for r in rows):
                if not any(str((r or {}).get('uid') or '') == identity['tak_uid'] for r in rows):
                    rec={'uid':identity['tak_uid'],'source':'tak-map-user-i512','callsign':identity.get('callsign') or '', 'username':identity.get('username') or '', 'tak_map_user_uid':identity['tak_uid']}
                    index=next((i for i,r in enumerate(rows) if str((r or {}).get('source') or '').startswith('fallback')),len(rows))
                    rows.insert(index,rec)
            return rows
        globals()['_v337_candidate_creators'] = _v337_candidate_creators

    _i512_send_cot_before = globals().get('_send_cot_to_ots')
    if callable(_i512_send_cot_before):
        def _send_cot_to_ots(xml, *args, **kwargs):
            return _i512_send_cot_before(_i512_stamp_cot_creator(xml), *args, **kwargs)
        globals()['_send_cot_to_ots'] = _send_cot_to_ots

    _i512_publish_package_before = tak_map_publish_package_to_mission
    def tak_map_publish_package_to_mission(zip_path, package_filename, sha256_hash, mission_name='', content_label='', content_kind='package', server_host='', preferred_creator_uid=''):
        identity = _i512_current_identity()
        preferred_creator_uid = preferred_creator_uid or str(identity.get('tak_uid') or '')
        result = _i512_publish_package_before(zip_path, package_filename, sha256_hash, mission_name, content_label, content_kind, server_host, preferred_creator_uid)
        if isinstance(result,dict) and identity:
            result['tak_map_user_identity_i512']={'uid':identity.get('tak_uid'),'callsign':identity.get('callsign'),'username':identity.get('username'),'uid_stable':True,'callsign_editable':True,'cot_creator_metadata':True,'live_presence_requires_per_user_cot':True}
        return result
    globals()['tak_map_publish_package_to_mission']=tak_map_publish_package_to_mission

    _i512_do_get_before = Handler.do_GET
    def _i512_do_get(self):
        parsed=urlparse(self.path); path=parsed.path
        if path == '/api/tak-map/ots/public-status':
            cfg=_i509_public_ots_config(); local=_i512_load_local_accounts().get('users',{})
            return self._send_json({'ok':True,'version':'i512','enabled':bool(cfg.get('enabled')),'login_enabled':bool(cfg.get('login_enabled')),'configured':bool(cfg.get('configured')),'display_name':cfg.get('display_name'),'ots_connected':bool(cfg.get('enabled') and cfg.get('login_enabled')),'local_login':True,'local_non_admin_login_enabled':not bool(cfg.get('enabled') and cfg.get('login_enabled')),'local_users_preserved':sum(1 for r in local.values() if not r.get('is_admin'))})
        if path == '/tak-map' and self._tak_map_auth_ok() and _i512_forced_change(self._tak_map_session()):
            return self._send_html(_i512_password_page(), 200)
        if path == '/api/tak-map/local-users':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            sess=self._tak_map_session()
            if _i512_forced_change(sess): return self._send_json({'ok':False,'password_change_required':True,'error':'Change the default local administrator password first.'},428)
            if not _i509_require_config_admin(self): return
            users=_i512_load_local_accounts().get('users',{})
            return self._send_json({'ok':True,'version':'i512','ots_connected':bool(_i509_load_ots_config().get('enabled') and _i509_load_ots_config().get('login_enabled')),'users':[_i512_public_local_user(v) for v in sorted(users.values(), key=lambda r:(not bool(r.get('is_admin')),str(r.get('username') or '').lower()))]})
        if path == '/api/tak-map/data-sync':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            sess=self._tak_map_session()
            if _i512_forced_change(sess): return self._send_json({'ok':False,'password_change_required':True,'error':'Change the default local administrator password first.'},428)
            _I512_REQUEST_CONTEXT.identity={'username':sess.get('username'),'callsign':sess.get('callsign'),'tak_uid':sess.get('tak_uid') or (sess.get('profile') or {}).get('tak_uid')}
            try: return self._send_json(_i512_augment_data_sync(tak_map_data_sync(),_i509_load_ots_config(),sess))
            finally: _I512_REQUEST_CONTEXT.identity={}
        if path.startswith('/api/tak-map/') and self._tak_map_auth_ok() and _i512_forced_change(self._tak_map_session()) and path not in ('/api/tak-map/ots/session',):
            return self._send_json({'ok':False,'password_change_required':True,'error':'Change the default local administrator password first.'},428)
        return _i512_do_get_before(self)
    Handler.do_GET=_i512_do_get

    _i512_do_post_before = Handler.do_POST
    def _i512_do_post(self):
        parsed=urlparse(self.path); path=parsed.path
        if path == '/api/tak-map/login': return self._handle_tak_map_login()
        if path == '/api/tak-map/account/change-password':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            try:
                _I512_REQUEST_CONTEXT.session_token = self._tak_map_token()
                return self._send_json(_i512_change_local_password(self._tak_map_session(),_read_json_body(self)))
            except Exception as e: return self._send_json({'ok':False,'error':str(e)},400)
            finally: _I512_REQUEST_CONTEXT.session_token = ''
        if path == '/api/tak-map/account/callsign':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            sess=self._tak_map_session()
            if _i512_forced_change(sess): return self._send_json({'ok':False,'password_change_required':True,'error':'Change the default local administrator password first.'},428)
            try:
                payload=_read_json_body(self); public=_i512_update_callsign(sess,payload.get('callsign'))
                return self._send_json({'ok':True,'message':'Callsign updated.','session':public})
            except Exception as e: return self._send_json({'ok':False,'error':str(e)},400)
        if path == '/api/tak-map/local-users/manage':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            sess=self._tak_map_session()
            if _i512_forced_change(sess): return self._send_json({'ok':False,'password_change_required':True,'error':'Change the default local administrator password first.'},428)
            if not _i509_require_config_admin(self): return
            try: return self._send_json(_i512_manage_local_users(_read_json_body(self),sess))
            except Exception as e: return self._send_json({'ok':False,'error':str(e)},400)
        if path == '/api/tak-map/ots/disconnect':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            sess=self._tak_map_session()
            if _i512_forced_change(sess): return self._send_json({'ok':False,'password_change_required':True,'error':'Change the default local administrator password first.'},428)
            if not _i509_require_config_admin(self): return
            try:
                result=_i512_disconnect_ots(); return self._send_json(result,200,headers={'Set-Cookie':self._clear_tak_map_session_cookie()})
            except Exception as e: return self._send_json({'ok':False,'error':str(e)},400)
        if path.startswith('/api/tak-map/') and self._tak_map_auth_ok() and _i512_forced_change(self._tak_map_session()) and path != '/api/tak-map/logout':
            return self._send_json({'ok':False,'password_change_required':True,'error':'Change the default local administrator password first.'},428)
        sess=self._tak_map_session() if self._tak_map_auth_ok() else None
        if sess: _I512_REQUEST_CONTEXT.identity={'username':sess.get('username'),'callsign':sess.get('callsign'),'tak_uid':sess.get('tak_uid') or (sess.get('profile') or {}).get('tak_uid')}
        try: return _i512_do_post_before(self)
        finally: _I512_REQUEST_CONTEXT.identity={}
    Handler.do_POST=_i512_do_post

    _i512_default_ots_before = _i509_default_ots_config
    def _i509_default_ots_config():
        cfg=dict(_i512_default_ots_before()); cfg['version']='i512'; cfg.setdefault('disconnected_at',''); return cfg

    _i512_normalize_ots_before = _i509_normalize_ots_config
    def _i509_normalize_ots_config(payload=None,current=None):
        cfg=dict(_i512_normalize_ots_before(payload,current)); cfg['version']='i512'
        source=payload if isinstance(payload,dict) else {}
        if 'disconnected_at' in source: cfg['disconnected_at']=str(source.get('disconnected_at') or '')[:80]
        elif isinstance(current,dict): cfg['disconnected_at']=str(current.get('disconnected_at') or '')[:80]
        else: cfg.setdefault('disconnected_at','')
        return cfg

    _i512_gateway_url_before = _i507_direct_gateway_url
    def _i507_direct_gateway_url(upstream):
        value = _i512_gateway_url_before(upstream)
        if not TAK_MAP_GATEWAY_PUBLIC_BASEMAP_BASE_URL: return value
        parsed=urlparse(value); path=parsed.path or ''
        if path.startswith('/tiles/') or path.startswith('/basemaps/'):
            return TAK_MAP_GATEWAY_PUBLIC_BASEMAP_BASE_URL.rstrip('/') + path + (('?' + parsed.query) if parsed.query else '')
        return value
    globals()['_i507_direct_gateway_url']=_i507_direct_gateway_url

    _i512_prev_config=tak_map_config
    def tak_map_config():
        cfg=_i512_prev_config()
        if isinstance(cfg,dict):
            cfg=dict(cfg); cfg['tak_map_iteration']='i512'
            ots=dict(cfg.get('ots_integration') or {}); ots.update({'version':'i512','local_accounts':True,'default_local_admin':'administrator','forced_default_password_change':True,'local_non_admin_accounts':True,'local_non_admin_disabled_while_ots_connected':True,'disconnect_ots':True,'login_options':['OpenTAKServer Login','Local Login'],'tak_native_user_callsigns':True,'stable_user_uid':True,'mission_api_user_scoped_review':True}); cfg['ots_integration']=ots
            comp=dict(cfg.get('composite_basemaps') or {}); comp.update({'version':'i512','tak_map_python_tile_proxy_for_gateway':False,'browser_client_certificate_required':False,'required_gateway_transport':'dedicated-read-only-https-listener-without-client-certificate-request','gateway_public_basemap_base_url':TAK_MAP_GATEWAY_PUBLIC_BASEMAP_BASE_URL,'service_mtls_listener_separate':True}); cfg['composite_basemaps']=comp
        return cfg
    globals()['tak_map_config']=tak_map_config

    _I512_UI=r'''<script id="takMapAccountsV512">
(function(w,d){'use strict';const V='i512',by=id=>d.getElementById(id),esc=s=>String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));let session=null;
function css(){if(by('takAccountsStyleV512'))return;const s=d.createElement('style');s.id='takAccountsStyleV512';s.textContent=`.login-modes-v512{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}.login-modes-v512 button{margin:0!important}.login-modes-v512 button.active{border-color:#ff6f2e!important;background:rgba(255,111,46,.16)!important;color:#fff!important}.local-panel-v512{margin-top:12px;padding:11px;border:1px solid rgba(255,255,255,.1);border-radius:11px;background:rgba(255,255,255,.025)}.local-panel-v512 h3{margin:0 0 8px;font-size:.82rem}.local-user-v512{display:grid;grid-template-columns:1fr auto;gap:7px;padding:7px 0;border-top:1px solid rgba(255,255,255,.06);font-size:.72rem}.local-user-v512 small{display:block;color:#91a4af}.local-user-actions-v512{display:flex;gap:5px;flex-wrap:wrap}.local-user-actions-v512 button{padding:4px 7px;font-size:.68rem}.danger-v512{border-color:rgba(255,92,82,.6)!important;color:#ff8b84!important}.account-form-v512{display:grid;gap:7px;margin-top:9px}.account-form-v512 input{width:100%;padding:7px;border:1px solid rgba(255,255,255,.16);border-radius:7px;background:#071019;color:#fff}.account-form-v512 .row-v512{display:grid;grid-template-columns:1fr 1fr;gap:7px}.ots-disconnect-v512{margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,.08)}.tak-account-actions-v511{flex-wrap:wrap}`;d.head.appendChild(s)}
function api(url,payload){return fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify(payload||{})}).then(async r=>{const j=await r.json().catch(()=>({error:'Invalid server response'}));if(!r.ok||!j.ok)throw Error(j.error||('HTTP '+r.status));return j})}
function login(){const old=by('takMapLoginForm');if(!old||old.dataset.i512)return;const form=old.cloneNode(true);old.replaceWith(form);form.dataset.i512='1';['otsRecoveryV509','otsOtpLabelV509','otsLoginStateV509'].forEach(id=>{const e=by(id);if(e)e.remove()});const sub=form.querySelector('.sub'),err=by('takMapError'),submit=by('takMapLoginButton');let selected='ots',status={};const modes=d.createElement('div');modes.className='login-modes-v512';modes.innerHTML='<button type="button" id="otsModeV512">OpenTAKServer Login</button><button type="button" id="localModeV512">Local Login</button>';submit.insertAdjacentElement('beforebegin',modes);const note=d.createElement('div');note.id='loginStateV512';note.style='margin:8px 0;color:#91a4af;font-size:.78rem;line-height:1.4';modes.insertAdjacentElement('afterend',note);function render(){by('otsModeV512').classList.toggle('active',selected==='ots');by('localModeV512').classList.toggle('active',selected==='local');by('otsModeV512').disabled=!status.ots_connected;if(selected==='ots'){sub.textContent='Sign in with your OpenTAKServer account';note.textContent=status.ots_connected?'OTS identities and permissions are active.':'OpenTAKServer is not connected. Use Local Login.'}else{sub.textContent='Sign in with a built-in TAK Map account';note.textContent=status.ots_connected?'Only the built-in local administrator is available while OTS is connected.':'Local administrator and local user accounts are available.'}submit.textContent=selected==='ots'?'Open TAK Map with OTS':'Open TAK Map Locally'}by('otsModeV512').onclick=()=>{if(status.ots_connected){selected='ots';render()}};by('localModeV512').onclick=()=>{selected='local';render()};fetch('/api/tak-map/ots/public-status',{cache:'no-store'}).then(r=>r.json()).then(j=>{status=j||{};selected=status.ots_connected?'ots':'local';render()}).catch(()=>{selected='local';render()});form.addEventListener('submit',async e=>{e.preventDefault();err.style.display='none';submit.disabled=true;try{const body=new URLSearchParams({username:by('username').value,password:by('password').value,mode:selected});const r=await fetch('/api/tak-map/login',{method:'POST',body});const j=await r.json().catch(()=>({error:'Login failed'}));if(!r.ok||!j.ok)throw Error(j.error||('HTTP '+r.status));location.href='/tak-map'}catch(x){err.textContent=x.message||String(x);err.style.display='block';submit.disabled=false;render()}})}
function account(){fetch('/api/tak-map/ots/session',{cache:'no-store',credentials:'same-origin'}).then(r=>r.json()).then(j=>{if(!j.ok)return;session=j;setTimeout(renderAccount,30)}).catch(()=>{})}
function renderAccount(){const menu=by('takMapAccountMenuV511'),btn=by('takMapAccountBtnV511');if(!menu||!btn||!session)return;const label=session.display_identity||session.callsign||session.username||'ACCOUNT';btn.textContent=label+' ▾';const rows=[['Username',session.username||'—'],['Callsign',session.callsign||'Not assigned'],['TAK UID',session.tak_uid||'Pending'],['Identity source',session.identity_source||'—'],['Connection',session.connection_state||'Authenticated']];menu.innerHTML='<div class="tak-account-name-v511">'+esc(label)+'</div><div class="tak-account-meta-v511">'+rows.map(r=>'<b>'+esc(r[0])+'</b><span title="'+esc(r[1])+'">'+esc(r[1])+'</span>').join('')+'</div><div class="tak-account-actions-v511"><button id="changeCallsignV512" type="button">Change Callsign</button>'+(session.is_admin?'<button id="configureV512" type="button">Configure OTS</button>':'')+'<button id="logoutV512" type="button">Log Out</button></div>';by('changeCallsignV512').onclick=async()=>{const current=session.selected_callsign||session.callsign||session.suggested_callsign||'';const value=prompt('Enter the TAK callsign for this user. Leave blank to use the OTS EUD callsign or username fallback.',current);if(value===null)return;try{const j=await api('/api/tak-map/account/callsign',{callsign:value});session=j.session;renderAccount()}catch(e){alert(e.message)}};const c=by('configureV512');if(c)c.onclick=()=>{menu.classList.remove('open');w.openConfigureOTS&&w.openConfigureOTS();setTimeout(configure,80)};by('logoutV512').onclick=()=>w.logoutTakMap&&w.logoutTakMap()}
function configure(){css();const m=by('otsModalV509');if(!m)return;if(!by('localAccountsV512')){const host=by('otsServiceIdentityNoteV511')||by('otsOutputV509')||m.querySelector('.ots-card-v509');const panel=d.createElement('section');panel.id='localAccountsV512';panel.className='local-panel-v512';panel.innerHTML='<h3>Local Accounts</h3><div id="localAccountStatusV512">Loading…</div><div id="localAccountRowsV512"></div><div class="account-form-v512"><div class="row-v512"><input id="newLocalUserV512" placeholder="Username"><input id="newLocalCallsignV512" placeholder="Callsign (optional)"></div><input id="newLocalPasswordV512" type="password" placeholder="Temporary password (12+ characters)"><button id="createLocalUserV512" type="button">Create Local User</button></div><div class="ots-disconnect-v512"><button id="disconnectOtsV512" class="danger-v512" type="button">Disconnect OTS</button><div style="color:#91a4af;font-size:.7rem;margin-top:5px">Preserves OTS settings and restores local non-admin login. Does not proxy Gateway tiles.</div></div>';host.parentNode.insertBefore(panel,host);by('createLocalUserV512').onclick=createUser;by('disconnectOtsV512').onclick=disconnect}loadUsers()}
async function loadUsers(){try{const r=await fetch('/api/tak-map/local-users',{cache:'no-store',credentials:'same-origin'}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'Could not load local users');by('localAccountStatusV512').textContent=(j.ots_connected?'OTS connected · local non-admin login disabled':'OTS disconnected · local users enabled')+' · '+j.users.length+' account(s)';by('localAccountRowsV512').innerHTML=j.users.map(u=>'<div class="local-user-v512"><div><b>'+esc(u.username)+'</b><small>'+(u.is_admin?'Administrator':'Local user')+' · '+(u.active?'Enabled':'Disabled')+' · callsign '+esc(u.callsign||'not set')+(u.must_change_password?' · password change required':'')+'</small></div><div class="local-user-actions-v512">'+(!u.is_admin?'<button onclick="TakMapAccountsV512.toggleUser(\''+esc(u.username)+'\','+(u.active?'false':'true')+')">'+(u.active?'Disable':'Enable')+'</button>':'')+'<button onclick="TakMapAccountsV512.resetUser(\''+esc(u.username)+'\')">Reset Password</button></div></div>').join('')}catch(e){const x=by('localAccountStatusV512');if(x)x.textContent=e.message}}
async function createUser(){try{await api('/api/tak-map/local-users/manage',{action:'create',username:by('newLocalUserV512').value,callsign:by('newLocalCallsignV512').value,password:by('newLocalPasswordV512').value});by('newLocalUserV512').value='';by('newLocalCallsignV512').value='';by('newLocalPasswordV512').value='';loadUsers()}catch(e){alert(e.message)}}
async function toggleUser(username,enable){try{await api('/api/tak-map/local-users/manage',{action:enable?'enable':'disable',username});loadUsers()}catch(e){alert(e.message)}}
async function resetUser(username){const p=prompt('Enter a temporary password with at least 8 characters for '+username+'. The user must change it at next login.');if(p===null)return;try{await api('/api/tak-map/local-users/manage',{action:'reset-password',username,password:p});loadUsers()}catch(e){alert(e.message)}}
async function disconnect(){if(!confirm('Disconnect OpenTAKServer? OTS login, missions, contacts, and Data Sync will become unavailable. Local non-admin login will be restored. Saved OTS settings will be preserved.'))return;try{await api('/api/tak-map/ots/disconnect',{});alert('OpenTAKServer disconnected. Sign in with Local Login.');location.href='/tak-map/login'}catch(e){alert(e.message)}}
function boot(){css();setTimeout(login,20);setTimeout(account,60);const prior=w.openConfigureOTS;if(typeof prior==='function'&&!prior.__i512){const wrapped=function(){prior();setTimeout(configure,90)};wrapped.__i512=true;w.openConfigureOTS=wrapped}const watch=()=>{const menu=by('takMapAccountMenuV511');if(menu&&!by('changeCallsignV512')&&session)renderAccount()};const mo=new MutationObserver(watch);mo.observe(d.body,{childList:true,subtree:true});[200,700,1600,3000,3600,5000].forEach(ms=>setTimeout(()=>{login();account();watch();if(by('otsModalV509')&&by('otsModalV509').classList.contains('active'))configure()},ms))}
if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapAccountsV512=Object.freeze({version:V,loadUsers,toggleUser,resetUser,configure});
})(window,document);
</script>'''

    def _i512_patch_html(html):
        if not isinstance(html,str): return html
        html=html.replace('1.3.0-i511','1.3.0-i512').replace('TAKDashboard/i511','TAKDashboard/i512').replace('TAK-Map/1.3.0 i511','TAK-Map/1.3.0 i512')
        html=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i512\2',html); html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i512\2',html)
        if 'id="takMapAccountsV512"' not in html: html=html.replace('</body></html>',_I512_UI+'</body></html>')
        return html

    TAK_MAP_HTML=_i512_patch_html(TAK_MAP_HTML); INDEX_HTML=TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML=_i512_patch_html(TAK_MAP_LOGIN_HTML); LOGIN_HTML=_i512_patch_html(LOGIN_HTML)
except Exception as _i512_exc:
    try: print('TAK Map i512 account and identity foundation failed:',_i512_exc)
    except Exception: pass
# --- end TAK Map i512 local accounts, callsigns, OTS disconnect, and user-scoped Data Sync ---


# --- TAK Map i513 login reliability and compact login UI ---
try:
    def _i513_handle_login(self):
        if not self._is_secure_request() and not ALLOW_INSECURE_UPLOAD_AUTH:
            return self._send_json({'ok':False,'error':'TAK Map login requires HTTPS.'},403)
        form = self._read_form()
        mode = str(form.get('mode') or '').strip().lower()
        username = sanitize_ots_username(form.get('username',''))
        password = str(form.get('password') or '')
        otp = str(form.get('otp') or '')
        cfg = _i509_load_ots_config()
        ots_connected = bool(cfg.get('enabled') and cfg.get('login_enabled'))
        if not mode:
            mode = 'ots' if ots_connected else 'local'
        if mode in ('local','local-user','local-admin','recovery','admin'):
            account, error, status = _i512_authenticate_local(self, username, password)
            if not account:
                return self._send_json({'ok':False,'error':error,'local_login':True}, status)
            token = _i512_create_local_session(account)
            reply = _i509_session_public(TAK_MAP_SESSIONS.get(token)); reply['ok'] = True; reply['version'] = 'i517'
            return self._send_json(reply, 200, headers={'Set-Cookie':self._tak_map_session_cookie(token)})
        if mode not in ('ots','opentakserver'):
            return self._send_json({'ok':False,'error':'Select OpenTAKServer Login or Local Login.'},400)
        if not ots_connected:
            return self._send_json({'ok':False,'error':'OpenTAKServer Login is not currently enabled. Use Local Login.'},403)
        auth = _i509_authenticate_remote(cfg, username, password, otp)
        if not auth.get('ok'):
            return self._send_json({'ok':False,'error':auth.get('error') or 'OpenTAKServer login failed.','attempts':auth.get('attempts',[])},401)
        fetched = _i511_fetch_profile(cfg, auth, username)
        if fetched.get('ok'):
            profile = fetched['profile']
        else:
            profile = _i511_profile_from_me({'username':username,'roles':[],'euds':[]}, username)
            profile['profile_warning'] = str(fetched.get('error') or 'OpenTAKServer profile unavailable.')
        token = _i511_create_profile_session(username, password, 'ots-user', bool(profile.get('is_admin')), auth, profile)
        reply = _i509_session_public(TAK_MAP_SESSIONS.get(token)); reply['ok'] = True; reply['version'] = 'i517'
        if profile.get('profile_warning'):
            reply['profile_warning'] = profile['profile_warning']
        return self._send_json(reply, 200, headers={'Set-Cookie':self._tak_map_session_cookie(token)})
    Handler._handle_tak_map_login = _i513_handle_login

    _i513_prev_config = tak_map_config
    def tak_map_config():
        cfg = _i513_prev_config()
        if isinstance(cfg,dict):
            cfg = dict(cfg); cfg['tak_map_iteration'] = 'i517'
            ots = dict(cfg.get('ots_integration') or {})
            ots.update({'version':'i517','login_request_body_single_read':True,'dedicated_login_page':True,'compact_login_controls':True,'login_submit_label':'Login','split_identity_login':True,'mid_silver_accent':True,'rajdhani_wordmark':True,'optimized_login_webp_assets':True})
            cfg['ots_integration'] = ots
            comp = dict(cfg.get('composite_basemaps') or {}); comp['version'] = 'i517'; cfg['composite_basemaps'] = comp
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i513_patch_main_html(html):
        if not isinstance(html,str): return html
        html = html.replace('1.3.0-i512','1.3.0-i517').replace('1.3.0-i513','1.3.0-i517').replace('TAKDashboard/i512','TAKDashboard/i517').replace('TAKDashboard/i513','TAKDashboard/i517').replace('TAK-Map/1.3.0 i512','TAK-Map/1.3.0 i517').replace('TAK-Map/1.3.0 i513','TAK-Map/1.3.0 i517')
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i517\2',html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i517\2',html)
        return html
    TAK_MAP_HTML = _i513_patch_main_html(TAK_MAP_HTML); INDEX_HTML = TAK_MAP_HTML

    TAK_MAP_LOGIN_HTML = r'''<!doctype html><html lang="en"><head><meta charset="utf-8"><title>TAK Map Login</title><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="preload" href="/tak-map-login-bg.webp" as="image" type="image/webp"><style>
:root{--text:#eef1f4;--muted:#9da5ad;--silver:#bcc2c8;--silver-hi:#d9dde1;--silver-low:#8d949b;--line:rgba(210,215,222,.24);--bad:#ff6b67}*{box-sizing:border-box}html,body{min-height:100%;margin:0}body{font-family:Inter,Segoe UI,Arial,sans-serif;color:var(--text);background-color:#070a0d;background-image:linear-gradient(110deg,rgba(4,7,10,.56),rgba(4,7,10,.83)),url('/tak-map-login-bg.webp');background-position:center;background-size:cover;background-repeat:no-repeat;background-attachment:fixed;display:grid;place-items:center;padding:24px}.shell{width:min(900px,100%);filter:drop-shadow(0 28px 70px rgba(0,0,0,.58))}.card{display:grid;grid-template-columns:minmax(280px,.9fr) minmax(360px,1.1fr);overflow:hidden;border:1px solid var(--line);border-radius:22px;background:rgba(10,14,18,.88);backdrop-filter:blur(14px)}.identity{min-height:500px;padding:34px 26px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(145deg,rgba(210,215,222,.13),rgba(255,255,255,.025));border-right:1px solid var(--line)}.logo{width:min(250px,80%);aspect-ratio:1;object-fit:contain;filter:drop-shadow(0 16px 26px rgba(0,0,0,.55));margin-bottom:12px}.wordmark{margin:0;font-family:Rajdhani,'Arial Narrow','Segoe UI',sans-serif;font-size:2rem;font-weight:700;letter-spacing:.045em;text-transform:none;color:#f0f2f4}.formpane{padding:46px 48px;display:flex;flex-direction:column;justify-content:center}.formpane h1{margin:0 0 6px;font-size:1.72rem;letter-spacing:.01em}.sub{margin:0 0 20px;color:var(--muted);font-size:.86rem;line-height:1.45}.mode-row{display:flex;gap:7px;margin-bottom:18px}.mode-row button{margin:0;padding:7px 11px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.035);color:#aeb5bc;font-size:.72rem;font-weight:700;cursor:pointer}.mode-row button.active{color:#101316;border-color:var(--silver-hi);background:linear-gradient(180deg,var(--silver-hi),var(--silver-low));box-shadow:0 0 0 2px rgba(210,215,222,.09)}.mode-row button:disabled{opacity:.38;cursor:not-allowed}label{display:block;margin:11px 0 5px;color:#aab1b8;font-size:.7rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}input{width:100%;border:1px solid rgba(210,215,222,.2);background:rgba(0,0,0,.34);color:var(--text);border-radius:9px;padding:10px 11px;font-size:.95rem;outline:none}input:focus{border-color:var(--silver);box-shadow:0 0 0 3px rgba(188,194,200,.12)}.otp{display:none}.state{min-height:32px;margin:10px 0 3px;color:var(--muted);font-size:.72rem;line-height:1.4}.submit{display:flex;justify-content:flex-start}.login-button{width:auto;min-width:104px;margin-top:8px;padding:9px 18px;border:1px solid var(--silver-hi);border-radius:9px;background:linear-gradient(180deg,#d4d8dc,#92999f);color:#111417;font-size:.78rem;font-weight:800;cursor:pointer}.login-button:hover{filter:brightness(1.06)}.login-button:disabled{opacity:.66;cursor:wait}.error{display:none;margin-top:12px;border:1px solid rgba(255,107,103,.55);background:rgba(255,107,103,.1);color:#ffd4d2;border-radius:9px;padding:9px 10px;font-size:.78rem;line-height:1.35}@media(max-width:760px){body{padding:14px}.card{grid-template-columns:1fr}.identity{min-height:auto;padding:20px;border-right:0;border-bottom:1px solid var(--line)}.logo{width:150px;margin-bottom:4px}.wordmark{font-size:1.55rem}.formpane{padding:26px 22px 30px}}@media(max-width:420px){.mode-row{align-items:stretch}.mode-row button{flex:1;padding:7px 6px;font-size:.67rem}}
</style></head><body><main class="shell"><form class="card" id="takMapLoginForm" autocomplete="off"><section class="identity"><img class="logo" src="/tak-map-login-logo.webp" onerror="this.onerror=null;this.src='/tak-map-logo.png'" alt="TAK Map logo"><h2 class="wordmark">TAK Map</h2></section><section class="formpane"><h1>Sign in</h1><p class="sub" id="loginSubtitle">Checking authentication mode...</p><div class="mode-row"><button type="button" id="otsMode">OpenTAKServer Login</button><button type="button" id="localMode">Local Login</button></div><label for="username">Username</label><input id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus required><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" autocapitalize="none" spellcheck="false" required><label class="otp" id="otpLabel" for="otp">2FA code</label><input class="otp" id="otp" name="otp" autocomplete="one-time-code" inputmode="numeric"><div class="state" id="loginState"></div><div class="submit"><button class="login-button" id="takMapLoginButton" type="submit">Login</button></div><div class="error" id="takMapError" role="alert"></div></section></form></main><script>
(function(){'use strict';const form=document.getElementById('takMapLoginForm'),err=document.getElementById('takMapError'),btn=document.getElementById('takMapLoginButton'),ots=document.getElementById('otsMode'),local=document.getElementById('localMode'),sub=document.getElementById('loginSubtitle'),state=document.getElementById('loginState');let mode='local',status={ots_connected:false};function showError(text){err.textContent=String(text||'Login failed.');err.style.display='block'}if(new URLSearchParams(location.search).get('reason')==='session-expired')showError('Your TAK Map session expired or the service restarted. Please log in again.');function render(){ots.classList.toggle('active',mode==='ots');local.classList.toggle('active',mode==='local');ots.disabled=!status.ots_connected;if(mode==='ots'){sub.textContent='Sign in with your OpenTAKServer account';state.textContent='OTS identities and permissions are active.'}else{sub.textContent='Sign in with a built-in TAK Map account';state.textContent=status.ots_connected?'Only the built-in local administrator is available while OTS is connected.':'Local administrator and local user accounts are available.'}btn.textContent='Login'}ots.addEventListener('click',()=>{if(status.ots_connected){mode='ots';render()}});local.addEventListener('click',()=>{mode='local';render()});fetch('/api/tak-map/ots/public-status',{cache:'no-store',credentials:'same-origin'}).then(async r=>{const j=await r.json();status=j||status;mode=status.ots_connected?'ots':'local';render()}).catch(()=>{mode='local';state.textContent='Could not read OTS status. Local Login remains available.';render()});form.addEventListener('submit',async event=>{event.preventDefault();err.style.display='none';btn.disabled=true;btn.textContent='Logging in...';const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),30000);try{const body=new URLSearchParams({username:document.getElementById('username').value,password:document.getElementById('password').value,otp:document.getElementById('otp').value,mode});const response=await fetch('/api/tak-map/login',{method:'POST',credentials:'same-origin',body,signal:controller.signal});const data=await response.json().catch(()=>({error:'Login failed. Server did not return JSON.'}));if(!response.ok||!data.ok)throw new Error(data.error||('Login failed. HTTP '+response.status));location.assign('/tak-map')}catch(error){showError(error&&error.name==='AbortError'?'Login timed out. Check the TAK Map service and try again.':(error.message||String(error)));btn.disabled=false;render()}finally{clearTimeout(timer)}});render()})();
</script></body></html>'''
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
except Exception as _i513_exc:
    try: print('TAK Map i513 login reliability patch failed:', _i513_exc)
    except Exception: pass
# --- end TAK Map i513 login reliability and compact login UI ---


# --- TAK Map i517 vertically centered login and shared persistent basemap catalog ---
try:
    _I517_BASEMAP_CATALOG_LOCK = threading.RLock()
    _I517_IMPORT_CONTEXT = threading.local()

    def _i517_normalize_catalog_url(value):
        raw = str(value or '').strip()
        if not raw:
            return ''
        try:
            raw = _i505_normalize_template(raw)
        except Exception:
            pass
        try:
            parsed = urlparse(raw)
            if not parsed.scheme or not parsed.netloc:
                return raw.rstrip('/')
            scheme = parsed.scheme.lower()
            host = (parsed.hostname or '').lower()
            port = parsed.port
            default = (scheme == 'https' and port == 443) or (scheme == 'http' and port == 80)
            netloc = host + ((':' + str(port)) if port and not default else '')
            path = re.sub(r'/+', '/', parsed.path or '/')
            if path != '/':
                path = path.rstrip('/')
            return parsed._replace(scheme=scheme, netloc=netloc, path=path, fragment='').geturl()
        except Exception:
            return raw.rstrip('/')

    def _i517_basemap_identity(row):
        item = row or {}
        source_kind = str(item.get('source_kind') or '').strip().lower()
        catalog_id = str(item.get('gateway_catalog_id') or item.get('gatewayCatalogId') or '').strip().lower()
        if catalog_id:
            return 'gateway-catalog:' + catalog_id
        comp = item.get('client_composition') or item.get('clientComposition')
        if isinstance(comp, dict):
            base = _i517_normalize_catalog_url(comp.get('base_url') or comp.get('baseUrl'))
            overlay = _i517_normalize_catalog_url(comp.get('overlay_url') or comp.get('overlayUrl'))
            if base or overlay:
                return 'composition:' + hashlib.sha256((base + '\n' + overlay).encode('utf-8')).hexdigest()
        upstream = _i517_normalize_catalog_url(item.get('upstream_url') or item.get('url'))
        if upstream:
            return ('gateway:' if source_kind == 'tak-gateway' else 'url:') + hashlib.sha256(upstream.encode('utf-8')).hexdigest()
        fallback = '|'.join([
            source_kind,
            str(item.get('source_xml_name') or '').strip().lower(),
            str(item.get('label') or item.get('name') or '').strip().lower(),
        ])
        return 'fallback:' + hashlib.sha256(fallback.encode('utf-8')).hexdigest()

    def _i517_prepare_row(row, existing=None):
        item = dict(existing or {})
        item.update(dict(row or {}))
        identity = _i517_basemap_identity(item)
        if existing:
            item['id'] = str((existing or {}).get('id') or item.get('id') or '')
            item['imported_at'] = str((existing or {}).get('imported_at') or item.get('imported_at') or _i512_iso_now())
            item['imported_by'] = str((existing or {}).get('imported_by') or item.get('imported_by') or '')
        actor = str(getattr(_I517_IMPORT_CONTEXT, 'username', '') or '')
        item['catalog_identity'] = identity
        item['shared_catalog'] = True
        item['server_persisted'] = True
        item['updated_at'] = _i512_iso_now()
        if actor:
            item['last_imported_by'] = actor
            item.setdefault('imported_by', actor)
        return item

    def _i517_dedupe_rows(rows):
        by_identity = {}
        order = []
        for raw in list(rows or []):
            if not isinstance(raw, dict):
                continue
            identity = _i517_basemap_identity(raw)
            if identity not in by_identity:
                by_identity[identity] = _i517_prepare_row(raw)
                order.append(identity)
            else:
                by_identity[identity] = _i517_prepare_row(raw, by_identity[identity])
        return [by_identity[k] for k in order][-TAK_MAP_CUSTOM_BASEMAP_LIMIT:]

    _i517_load_custom_basemaps_before = _i505_load_custom_basemaps
    def _i505_load_custom_basemaps():
        with _I517_BASEMAP_CATALOG_LOCK:
            rows = _i517_load_custom_basemaps_before()
            return _i517_dedupe_rows(rows)
    globals()['_i505_load_custom_basemaps'] = _i505_load_custom_basemaps

    def _i517_save_custom_basemaps(rows):
        with _I517_BASEMAP_CATALOG_LOCK:
            TAK_MAP_OFFLINE_DIR.mkdir(parents=True, exist_ok=True)
            final = _i517_dedupe_rows(rows)
            atomic_write_json(TAK_MAP_CUSTOM_BASEMAPS_FILE, {
                'version':'i517',
                'scope':'shared',
                'server_persisted':True,
                'duplicate_prevention':'normalized-catalog-identity',
                'basemaps':final,
                'updated':_i512_iso_now(),
            })
            return final
    globals()['_i505_save_custom_basemaps'] = _i517_save_custom_basemaps
    globals()['_i506_save_custom_basemaps'] = _i517_save_custom_basemaps

    def _i505_upsert_custom_basemaps(incoming):
        with _I517_BASEMAP_CATALOG_LOCK:
            rows = _i505_load_custom_basemaps()
            by_identity = {_i517_basemap_identity(row):dict(row) for row in rows}
            order = [_i517_basemap_identity(row) for row in rows]
            for raw in list(incoming or []):
                if not isinstance(raw, dict):
                    continue
                identity = _i517_basemap_identity(raw)
                current = by_identity.get(identity)
                by_identity[identity] = _i517_prepare_row(raw, current)
                if identity not in order:
                    order.append(identity)
            return _i517_save_custom_basemaps([by_identity[k] for k in order if k in by_identity])
    globals()['_i505_upsert_custom_basemaps'] = _i505_upsert_custom_basemaps

    def _i505_delete_custom_basemap(basemap_id):
        bid = str(basemap_id or '').strip()
        with _I517_BASEMAP_CATALOG_LOCK:
            rows = _i505_load_custom_basemaps()
            kept = [x for x in rows if str(x.get('id') or '') != bid]
            if len(kept) == len(rows):
                return {'ok':False,'version':'i517','error':'Imported basemap not found.'}
            _i517_save_custom_basemaps(kept)
        return _i505_custom_basemap_result('Shared imported basemap removed.')
    globals()['_i505_delete_custom_basemap'] = _i505_delete_custom_basemap

    def _i505_clear_custom_basemaps():
        with _I517_BASEMAP_CATALOG_LOCK:
            _i517_save_custom_basemaps([])
        return _i505_custom_basemap_result('All shared imported basemaps removed.')
    globals()['_i505_clear_custom_basemaps'] = _i505_clear_custom_basemaps

    def _i506_bulk_delete(scope):
        scope = str(scope or '').strip().lower()
        with _I517_BASEMAP_CATALOG_LOCK:
            rows = _i505_load_custom_basemaps()
            if scope in ('gateway','tak-gateway','composite'):
                removed = [x for x in rows if str(x.get('source_kind') or '') == 'tak-gateway']
                kept = [x for x in rows if str(x.get('source_kind') or '') != 'tak-gateway']
                label = 'TAK Gateway composite import'
            elif scope in ('custom','manual','xml'):
                removed = [x for x in rows if str(x.get('source_kind') or '') != 'tak-gateway']
                kept = [x for x in rows if str(x.get('source_kind') or '') == 'tak-gateway']
                label = 'custom XML basemap'
            elif scope in ('all',''):
                removed, kept, label = rows, [], 'imported basemap'
            else:
                return {'ok':False,'version':'i517','error':'Unknown basemap removal scope.'}
            _i517_save_custom_basemaps(kept)
        count = len(removed)
        return _i505_custom_basemap_result(
            'Removed ' + str(count) + ' shared ' + label + ('s' if count != 1 else '') + '.',
            removed=[], errors=[], removed_ids=[str(x.get('id') or '') for x in removed],
            removed_count=count, scope=scope or 'all')
    globals()['_i506_bulk_delete'] = _i506_bulk_delete

    _i517_result_before = _i505_custom_basemap_result
    def _i517_custom_basemap_result(message='', imported=None, errors=None, **extra):
        result = _i517_result_before(message, imported, errors, **extra)
        if isinstance(result, dict):
            result['version'] = 'i517'
            result['catalog_scope'] = 'shared'
            result['server_persisted'] = True
            result['duplicate_prevention'] = 'normalized-catalog-identity'
            result['import_allowed_for_authenticated_users'] = True
            result['removal_admin_only'] = True
        return result
    globals()['_i505_custom_basemap_result'] = _i517_custom_basemap_result
    globals()['_i506_result'] = _i517_custom_basemap_result

    try:
        if TAK_MAP_CUSTOM_BASEMAPS_FILE.exists():
            _i517_save_custom_basemaps(_i517_load_custom_basemaps_before())
    except Exception as _i517_catalog_upgrade_exc:
        try: print('TAK Map i517 basemap catalog upgrade warning:', _i517_catalog_upgrade_exc)
        except Exception: pass

    _i517_post_before = Handler.do_POST
    def _i517_post(self):
        path = urlparse(self.path).path
        mutation = path in ('/api/tak-map/custom-basemap-upload','/api/tak-map/custom-basemap-import-gateway')
        removal = path in ('/api/tak-map/custom-basemap-delete','/api/tak-map/custom-basemap-clear','/api/tak-map/custom-basemap-bulk-delete')
        if removal:
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session() or {}
            if not bool(sess.get('is_admin')):
                return self._send_json({'ok':False,'version':'i517','error':'Removing shared imported basemaps requires an administrator account.','admin_required':True},403)
        if mutation:
            sess = self._tak_map_session() or {}
            _I517_IMPORT_CONTEXT.username = str(sess.get('username') or (sess.get('profile') or {}).get('username') or '')
        try:
            return _i517_post_before(self)
        finally:
            if mutation:
                _I517_IMPORT_CONTEXT.username = ''
    Handler.do_POST = _i517_post

    _i517_config_before = tak_map_config
    def tak_map_config():
        cfg = _i517_config_before()
        if not isinstance(cfg, dict):
            return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i517'
        ots = dict(cfg.get('ots_integration') or {})
        ots.update({'version':'i517','login_vertical_centered':True,'login_dynamic_viewport_centering':True})
        cfg['ots_integration'] = ots
        comp = dict(cfg.get('composite_basemaps') or {})
        comp.update({
            'version':'i517',
            'shared_server_catalog':True,
            'catalog_scope':'all-authenticated-users',
            'import_permission':'authenticated-user',
            'remove_permission':'administrator-only',
            'duplicate_prevention':'normalized-source-catalog-and-composition-identity',
            'startup_catalog_hydration':True,
            'persists_across_browser_reload':True,
            'persists_across_service_restart':True,
            'persists_across_upgrade':True,
            'favorites':False,
            'personal_basemaps':False,
        })
        cfg['composite_basemaps'] = comp
        management = dict(cfg.get('basemap_management') or {})
        management.update({
            'version':'i517',
            'shared_catalog':True,
            'any_authenticated_user_can_import':True,
            'admin_only_remove':True,
            'duplicate_prevention':True,
            'favorites':False,
            'personal_basemaps':False,
        })
        cfg['basemap_management'] = management
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _I517_BASEMAP_UI = r'''<style id="takMapSharedBasemapCatalogStyleV517">
html.tak-map-basemap-nonadmin-v517 .tak-bm-remove-v506,
html.tak-map-basemap-nonadmin-v517 #basemapManagerBulkV506,
html.tak-map-basemap-nonadmin-v517 .tak-custom-basemap-delete-v505{display:none!important}
</style><script id="takMapSharedBasemapCatalogV517">
(function(w,d){'use strict';const V='i517';let admin=false,hydrating=false;function cfg(){try{return (typeof config!=='undefined'&&config)||w.config||{}}catch(_){return w.config||{}}}function apply(j){if(!(j&&Array.isArray(j.basemaps)))return false;try{if(typeof config!=='undefined'&&config)config.basemaps=j.basemaps}catch(_){}try{w.config=cfg();w.config.basemaps=j.basemaps}catch(_){}try{w.renderBasemaps&&w.renderBasemaps()}catch(_){}try{w.TakMapBasemapManagementV506&&w.TakMapBasemapManagementV506.render&&w.TakMapBasemapManagementV506.render()}catch(_){}return true}async function hydrate(){if(hydrating)return;hydrating=true;try{const r=await fetch('/api/tak-map/custom-basemaps',{credentials:'same-origin',cache:'no-store'}),j=await r.json();if(r.ok&&j.ok)apply(j)}catch(_){}finally{hydrating=false}}async function role(){try{const r=await fetch('/api/tak-map/ots/session',{credentials:'same-origin',cache:'no-store'}),j=await r.json();admin=!!(r.ok&&j&&j.is_admin)}catch(_){admin=false}d.documentElement.classList.toggle('tak-map-basemap-nonadmin-v517',!admin);d.documentElement.classList.toggle('tak-map-basemap-admin-v517',admin)}function version(){try{d.documentElement.dataset.takMapIteration=V;d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(el=>{el.textContent=V;el.setAttribute('data-iteration',V)})}catch(_){}}function install(){version();role();hydrate()}w.TakMapSharedBasemapCatalogV517=Object.freeze({version:V,hydrate,role,diagnostics:()=>({version:V,sharedCatalog:true,serverPersisted:true,admin,duplicatePrevention:true,favorites:false,personalBasemaps:false})});if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',install,{once:true});else install();[350,1100,2600].forEach(ms=>setTimeout(install,ms));d.addEventListener('visibilitychange',()=>{if(!d.hidden)hydrate()});
})(window,document);
</script>'''

    def _i517_patch_main_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i517', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i517', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i517', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i517\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i517\2', html)
        if 'id="takMapSharedBasemapCatalogV517"' not in html:
            html = html.replace('</body></html>', _I517_BASEMAP_UI + '</body></html>')
        return html
    TAK_MAP_HTML = _i517_patch_main_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML

    TAK_MAP_LOGIN_HTML = TAK_MAP_LOGIN_HTML.replace(
        'html,body{min-height:100%;margin:0}body{',
        'html,body{width:100%;min-height:100%;margin:0}body{min-height:100vh;min-height:100dvh;'
    ).replace(
        'display:grid;place-items:center;padding:24px}.shell{',
        'display:grid;align-items:center;justify-items:center;padding:24px}.shell{align-self:center;margin:auto 0;'
    )
    LOGIN_HTML = TAK_MAP_LOGIN_HTML

    TAK_MAP_ITERATION = 'i517'
except Exception as _i517_exc:
    try: print('TAK Map i517 shared basemap catalog/login centering patch failed:', _i517_exc)
    except Exception: pass
# --- end TAK Map i517 vertically centered login and shared persistent basemap catalog ---


