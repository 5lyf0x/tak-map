    _i563_delete_before = _tak_data_sync_delete_record
    def _tak_data_sync_delete_record(obj, server_host=''):
        mission = _i555_text((obj or {}).get('mission_name'))
        target = _i555_text((obj or {}).get('mission_delete_target'))
        value = _i555_text((obj or {}).get('mission_delete_value'))
