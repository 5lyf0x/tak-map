            parts = [unquote(part) for part in parsed.path.split('/') if part]
        except Exception:
            return {'mission':'','tail':[],'guid':'','is_mission_api':False}
        if len(parts) < 3 or parts[:3] != ['Marti','api','missions']:
            return {'mission':'','tail':[],'guid':'','is_mission_api':False}
        rest = parts[3:]
        if not rest:
            return {'mission':'','tail':[],'guid':'','is_mission_api':True,'scope':'list'}
        if rest[0] == 'guid':
            return {'mission':'','guid':rest[1] if len(rest)>1 else '', 'tail':rest[2:], 'is_mission_api':True, 'scope':'guid'}
        if rest[0] in ('all','invitations'):
            return {'mission':'','tail':rest[1:], 'guid':'', 'is_mission_api':True, 'scope':rest[0]}
        return {'mission':rest[0], 'tail':rest[1:], 'guid':'', 'is_mission_api':True, 'scope':'mission'}

    def _i564_query_value(path, *names):
        try:
            query = parse_qs(urlparse(str(path or '')).query, keep_blank_values=True)
        except Exception:
            query = {}
        folded = {str(k).casefold():v for k,v in query.items()}
        for name in names:
            values = folded.get(str(name).casefold()) or []
            if values and _i555_text(values[0]):
                return _i555_text(values[0])
        return ''

    def _i564_current_creator_uid(path=''):
        try:
