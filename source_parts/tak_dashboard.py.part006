    def _i564_patch_html(html):
        if not isinstance(html, str): return html
        html = re.sub(r'1\.3\.0-i563','1.3.0-i564',html)
        html = re.sub(r'TAKDashboard/i563','TAKDashboard/i564',html)
        html = re.sub(r'TAK-Map/1\.3\.0 i563','TAK-Map/1.3.0 i564',html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i564\2',html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i564\2',html)
        # Remove browser-native fallback from the active Data Sync delete delegate.
        html = re.sub(
            r"async function deleteDataSyncItem\(idx,ev\)\{.*?\}function drawDataSyncObjects",
            "async function deleteDataSyncItem(idx,ev){if(ev&&ev.stopPropagation)ev.stopPropagation();const controller=window.TakMapDeleteControllerI564||window.TakMapContextSidebarI564;if(controller&&typeof controller.deleteDataSyncItem==='function')return controller.deleteDataSyncItem(idx,ev);return false}function drawDataSyncObjects",
            html,count=1,flags=re.S)
        html = re.sub(r'<script[^>]+(?:tak-map-icon-registry-i\d+\.js|tak-map-popup-localdata-i\d+\.js|tak-map-context-sidebar-i\d+\.js)[^>]*></script>\s*','',html,flags=re.I)
        if 'takMapStartupLoaderI541' not in html and '/assets/runtime/tak-map-startup-i553.js' not in html: return html
        scripts='\n'.join([
            '<script id="takMapIconRegistryI564" defer src="/assets/runtime/tak-map-icon-registry-i564.js?v=1.3.0-i564"></script>',
            '<script id="takMapPopupLocalDataI564" defer src="/assets/runtime/tak-map-popup-localdata-i564.js?v=1.3.0-i564"></script>',
            '<script id="takMapContextSidebarI564" defer src="/assets/runtime/tak-map-context-sidebar-i564.js?v=1.3.0-i564"></script>',
        ])
        return html.replace('</body>',scripts+'\n</body>',1) if '</body>' in html else html+scripts

