    _i566_apply_symbol_before=_i537_apply_symbol
    def _i537_apply_symbol(obj,*raw_values):
        candidates=(obj,)+raw_values
        for candidate in candidates:
            if not isinstance(candidate,dict): continue
            custom=_i566_authoritative_custom_path(candidate)
            if custom and isinstance(obj,dict):
                # The legacy marker normalizer strips MissionUID.details. Carry
