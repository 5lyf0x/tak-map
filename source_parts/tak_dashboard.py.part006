    def _i568_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i568_clone(value):
        try:
            if '_i567_clone_json_value' in globals():
                return _i567_clone_json_value(value)
        except Exception:
            pass
        try:
            return json.loads(json.dumps(value, ensure_ascii=False))
        except Exception:
            return value

    def _i568_iso(epoch=0):
        try:
            return datetime.fromtimestamp(float(epoch), timezone.utc).isoformat()
        except Exception:
            return ''

    def _i568_identity(sess):
        sess = sess if isinstance(sess, dict) else {}
        profile = sess.get('profile') if isinstance(sess.get('profile'), dict) else {}
        return {
            'username': _i568_text(profile.get('username') or sess.get('username')).lower(),
            'callsign': _i568_text(sess.get('callsign') or profile.get('callsign')),
            'tak_uid': _i568_text(sess.get('tak_uid') or profile.get('tak_uid')),
            'auth_mode': _i568_text(sess.get('auth_mode')),
        }

    def _i568_state_key(cfg, sess):
        ident = _i568_identity(sess)
        server = _i568_text((cfg or {}).get('api_url') or (cfg or {}).get('base_url') or (cfg or {}).get('marti_url')).lower()
        raw = '\x1f'.join((ident.get('auth_mode') or '', ident.get('username') or '', server))
        return hashlib.sha256(raw.encode('utf-8', 'ignore')).hexdigest()[:48]

    def _i568_snapshot_path(key):
        return _I568_SNAPSHOT_ROOT / (str(key) + '.json')

    def _i568_default_state(key):
        return {
            'key': key,
            'snapshot': None,
            'last_success_epoch': 0.0,
            'last_attempt_started_epoch': 0.0,
            'last_attempt_completed_epoch': 0.0,
            'last_attempt_duration_seconds': 0.0,
            'last_error': '',
            'last_reason': '',
            'in_flight': False,
            'generation': 0,
            'endpoint_timings': [],
            'acquisition_summary': {},
        }

    def _i568_load_persisted_state(key):
        state = _i568_default_state(key)
        try:
            raw = load_json_file(_i568_snapshot_path(key), {})
            if isinstance(raw, dict) and isinstance(raw.get('snapshot'), dict):
                state['snapshot'] = raw.get('snapshot')
                state['last_success_epoch'] = float(raw.get('last_success_epoch') or 0)
                state['generation'] = int(raw.get('generation') or 0)
                state['endpoint_timings'] = list(raw.get('endpoint_timings') or [])[:120]
                state['acquisition_summary'] = dict(raw.get('acquisition_summary') or {})
        except Exception:
            pass
        return state

    def _i568_state(key):
        with _I568_STATE_LOCK:
            state = _I568_STATES.get(key)
            if state is None:
                state = _i568_load_persisted_state(key)
                _I568_STATES[key] = state
            return state

    def _i568_persist_success(state):
        try:
            _I568_SNAPSHOT_ROOT.mkdir(parents=True, exist_ok=True)
            atomic_write_json(_i568_snapshot_path(state['key']), {
                'version': 'i568',
                'last_success_epoch': state.get('last_success_epoch') or 0,
                'generation': state.get('generation') or 0,
                'endpoint_timings': list(state.get('endpoint_timings') or [])[:120],
                'acquisition_summary': dict(state.get('acquisition_summary') or {}),
                'snapshot': state.get('snapshot'),
            })
        except Exception as exc:
            state['snapshot_persist_warning'] = _i568_text(exc)

    def _i568_set_context(token, sess):
        identity = _i568_identity(sess)
        if '_I529_REQUEST_CONTEXT' in globals():
            _I529_REQUEST_CONTEXT.session_token = _i568_text(token)
            _I529_REQUEST_CONTEXT.auth_mode = identity.get('auth_mode') or ''
        if '_I512_REQUEST_CONTEXT' in globals():
            _I512_REQUEST_CONTEXT.identity = {
                'username': identity.get('username'),
                'callsign': identity.get('callsign'),
                'tak_uid': identity.get('tak_uid'),
            }
            _I512_REQUEST_CONTEXT.session_token = _i568_text(token)
        if '_I547_REQUEST_CONTEXT' in globals():
            # Manual i568 refreshes are already fresh parallel acquisitions. Do
            # not invoke the older serial forced /cot loop afterward.
            _I547_REQUEST_CONTEXT.force = False
            _I547_REQUEST_CONTEXT.reason = 'i568-background-worker'

    def _i568_clear_context():
        if '_I529_REQUEST_CONTEXT' in globals():
            _I529_REQUEST_CONTEXT.session_token = ''
            _I529_REQUEST_CONTEXT.auth_mode = ''
        if '_I512_REQUEST_CONTEXT' in globals():
            _I512_REQUEST_CONTEXT.identity = {}
            _I512_REQUEST_CONTEXT.session_token = ''
        if '_I547_REQUEST_CONTEXT' in globals():
            _I547_REQUEST_CONTEXT.force = False
            _I547_REQUEST_CONTEXT.reason = ''
        _I568_REQUEST_CONTEXT.responses = None

    def _i568_call(cfg, sess, url, label, timeout):
        started = time.monotonic()
        result = _i568_request_json_before(cfg, sess, url, timeout=max(1, int(timeout)))
        duration = round(time.monotonic() - started, 4)
        return url, result, {
            'endpoint': label,
            'url_path': urlparse(url).path,
            'ok': bool(isinstance(result, dict) and result.get('ok')),
            'status': int((result or {}).get('status') or 0) if isinstance(result, dict) else 0,
            'duration_seconds': duration,
            'error': _i568_text((result or {}).get('error'))[:300] if isinstance(result, dict) else 'invalid-result',
        }

    def _i568_run_parallel(tasks, cfg, sess, deadline, max_workers):
        responses = {}
        timings = []
        if not tasks:
            return responses, timings
        executor = ThreadPoolExecutor(max_workers=max(1, min(int(max_workers), len(tasks))))
        future_map = {}
        try:
            for task in tasks:
                url, label, timeout = task
                future_map[executor.submit(_i568_call, cfg, sess, url, label, timeout)] = task
            remaining = max(0.0, deadline - time.monotonic())
            done, pending = _i568_wait(list(future_map), timeout=remaining)
            for future in done:
                task = future_map[future]
                try:
                    url, result, timing = future.result()
                except Exception as exc:
                    url = task[0]
                    result = {'ok': False, 'status': 0, 'body': None, 'error': _i568_text(exc)}
                    timing = {'endpoint': task[1], 'url_path': urlparse(url).path, 'ok': False, 'status': 0, 'duration_seconds': None, 'error': _i568_text(exc)[:300]}
                responses[url] = result
                timings.append(timing)
            for future in pending:
                url, label, _timeout = future_map[future]
                future.cancel()
                responses[url] = {'ok': False, 'status': 0, 'body': None, 'error': 'Overall i568 refresh deadline reached before this endpoint completed.'}
                timings.append({'endpoint': label, 'url_path': urlparse(url).path, 'ok': False, 'status': 0, 'duration_seconds': None, 'error': 'overall-refresh-deadline'})
        finally:
            executor.shutdown(wait=False, cancel_futures=True)
        return responses, timings

    def _i568_parallel_acquisition(cfg, sess):
        started = time.monotonic()
        deadline = started + _I568_OVERALL_REFRESH_DEADLINE_SECONDS
        api = _i568_text((cfg or {}).get('api_url') or (cfg or {}).get('base_url')).rstrip('/')
        marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')
        discovery_tasks = []
        if api:
            discovery_tasks.append((api + '/api/missions', 'discovery:ots-api', _I568_DISCOVERY_TIMEOUT_SECONDS))
        if marti:
            discovery_tasks.append((marti + '/Marti/api/missions', 'discovery:marti', _I568_DISCOVERY_TIMEOUT_SECONDS))
        responses, timings = _i568_run_parallel(discovery_tasks, cfg, sess, deadline, 2)
        mission_names = []
        for url, _label, _timeout in discovery_tasks:
            result = responses.get(url) or {}
            if result.get('ok'):
                for name in _i512_mission_names(result.get('body')):
                    if name not in mission_names:
                        mission_names.append(name)
        mission_names = mission_names[:20]
        mission_tasks = []
        for mission in mission_names:
            q = quote(mission, safe='')
            for suffix, kind in (('', 'detail'), ('/contents', 'contents'), ('/cot', 'cot')):
                if marti:
                    mission_tasks.append((marti + '/Marti/api/missions/' + q + suffix, 'mission:' + mission + ':' + kind, _I568_ENDPOINT_TIMEOUT_SECONDS))
        mission_responses, mission_timings = _i568_run_parallel(mission_tasks, cfg, sess, deadline, _I568_MAX_WORKERS)
        responses.update(mission_responses)
        timings.extend(mission_timings)
        discovery_ok = any(bool((responses.get(url) or {}).get('ok')) for url, _label, _timeout in discovery_tasks)
        completed = sum(1 for row in timings if row.get('ok'))
        return {
            'responses': responses,
            'mission_names': mission_names,
            'timings': sorted(timings, key=lambda row: (str(row.get('endpoint') or ''))),
            'summary': {
                'version': 'i568',
                'discovery_ok': discovery_ok,
                'discovery_endpoint_count': len(discovery_tasks),
                'mission_count': len(mission_names),
                'mission_endpoint_count': len(mission_tasks),
                'successful_endpoint_count': completed,
                'failed_endpoint_count': max(0, len(timings) - completed),
                'max_workers': _I568_MAX_WORKERS,
                'per_endpoint_timeout_seconds': _I568_ENDPOINT_TIMEOUT_SECONDS,
                'overall_deadline_seconds': _I568_OVERALL_REFRESH_DEADLINE_SECONDS,
                'duration_seconds': round(time.monotonic() - started, 4),
            },
        }

    def _i568_result_body(result):
        if not isinstance(result, dict):
            return None
        return result.get('body')

    def _i568_walk_dicts(value, limit=20000):
        rows = []
        stack = [value]
        seen = set()
        while stack and len(rows) < int(limit):
            current = stack.pop()
            if isinstance(current, dict):
                ident = id(current)
                if ident in seen:
                    continue
                seen.add(ident)
                rows.append(current)
                for nested in current.values():
                    if isinstance(nested, (dict, list, tuple)):
                        stack.append(nested)
            elif isinstance(current, (list, tuple)):
                stack.extend(current)
        return rows

    def _i568_row_uid(row):
        if not isinstance(row, dict):
            return ''
        for source in (row, row.get('properties'), row.get('details')):
            if not isinstance(source, dict):
                continue
            for key in ('event_uid', 'cot_uid', 'cotUid', 'uid', 'data', 'data_uid', 'id'):
                value = _i568_text(source.get(key))
                if value:
                    return value
        return ''

    def _i568_seed_scope_cache(cfg, sess, acquired):
        if not bool((acquired.get('summary') or {}).get('discovery_ok')):
            return False
        if '_I539_SCOPE_CACHE' not in globals() or '_I539_SCOPE_LOCK' not in globals() or '_i539_identity_key' not in globals():
            return False
        mission_names = list(acquired.get('mission_names') or [])
        status = 0
        errors = []
        for row in list(acquired.get('timings') or []):
            if str(row.get('endpoint') or '').startswith('discovery:'):
                status = max(status, int(row.get('status') or 0))
                if row.get('error'):
                    errors.append(_i568_text(row.get('error')))
        profile = (sess or {}).get('profile') if isinstance((sess or {}).get('profile'), dict) else {}
        record = {
            'ok': True,
            'state': 'ok',
            'missions': list(dict.fromkeys(_i568_text(name) for name in mission_names if _i568_text(name))),
            'cached': False,
            'status': status or 200,
            'error': '',
            'duration_ms': int(float((acquired.get('summary') or {}).get('duration_seconds') or 0) * 1000),
            'identity_mode': 'per-user-background-mission-worker-i568',
            'certificate_cn': _i568_text((sess or {}).get('certificate_cn') or profile.get('certificate_cn')),
            'client_uid': _i568_text((sess or {}).get('tak_uid') or profile.get('tak_uid')),
            'time': time.time(),
            'source': 'i568-bounded-parallel-discovery',
        }
        key = _i539_identity_key(sess or {}, cfg or {})
        with _I539_SCOPE_LOCK:
            _I539_SCOPE_CACHE[key] = dict(record)
        return True

    def _i568_seed_enrichment_cache(cfg, sess, acquired):
        if '_I545_ENRICH_CACHE' not in globals() or '_I545_ENRICH_LOCK' not in globals() or '_i545_cache_key' not in globals() or '_i545_extract_events' not in globals():
            return False
        marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')
        names = list(acquired.get('mission_names') or [])
        responses = acquired.get('responses') if isinstance(acquired.get('responses'), dict) else {}
        combined = {}
        rows = []
        any_ok = False
        for mission in names:
            path = '/Marti/api/missions/' + quote(_i568_text(mission), safe='') + '/cot'
            url = marti + path if marti else ''
            result = responses.get(url) if url else None
            ok = bool(isinstance(result, dict) and result.get('ok'))
            any_ok = any_ok or ok
            body = _i568_result_body(result)
            events = _i545_extract_events(body if not isinstance(body, str) else None, body if isinstance(body, str) else '') if ok else {}
            rows.append({
                'mission': _i568_text(mission),
                'path': path,
                'ok': ok,
                'status': int((result or {}).get('status') or 0) if isinstance(result, dict) else 0,
                'error': _i568_text((result or {}).get('error')) if isinstance(result, dict) else 'request-missing',
                'event_count': len(events),
                'query_strategy': 'i568-bounded-parallel-user-scope',
            })
            for uid, event in dict(events or {}).items():
                candidate = dict(event or {})
                candidate['mission_name'] = _i568_text(mission)
                current = combined.get(uid)
                replace = current is None
                if not replace and '_i547_event_rank' in globals():
                    try:
                        replace = _i547_event_rank(candidate) > _i547_event_rank(current)
                    except Exception:
                        replace = False
                if replace:
                    combined[uid] = candidate
        requested = tuple(sorted({_i568_text(name).casefold() for name in names if _i568_text(name)}))
        record = {
            'ok': any_ok,
            'time': time.time(),
            'requested': requested,
            'events': combined,
            'missions': rows,
            'event_count': len(combined),
            'error': '' if any_ok else '; '.join(_i568_text(row.get('error')) for row in rows if row.get('error'))[:1000],
            'refresh_mode_i568': 'bounded-parallel-background-worker',
        }
        key = _i545_cache_key(cfg or {}, sess or {})
        with _I545_ENRICH_LOCK:
            _I545_ENRICH_CACHE[key] = record
        return True

    def _i568_seed_remote_mission_data(base, cfg, acquired):
        out = _i568_clone(base) if isinstance(base, dict) else {}
        if not isinstance(out, dict):
            out = {}
        names = list(acquired.get('mission_names') or [])
        responses = acquired.get('responses') if isinstance(acquired.get('responses'), dict) else {}
        marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')

        missions = list(out.get('missions') or [])
        known_missions = set()
        for row in missions:
            if isinstance(row, dict):
                name = _i568_text(row.get('name') or row.get('mission_name') or row.get('missionName'))
            else:
                name = _i568_text(row)
            if name:
                known_missions.add(name.casefold())
        for name in names:
            if _i568_text(name).casefold() not in known_missions:
                missions.append({'name': _i568_text(name), 'source': 'Mission API i568 background worker'})
                known_missions.add(_i568_text(name).casefold())
        out['missions'] = missions

        objects = list(out.get('objects') or [])
        object_keys = set()
        for row in objects:
            uid = _i568_row_uid(row)
            mission = _i568_text((row or {}).get('mission') or (row or {}).get('mission_name')) if isinstance(row, dict) else ''
            if uid:
                object_keys.add((mission.casefold(), uid.casefold()))

        raw_rows = list(out.get('mission_uids') or [])
        raw_keys = set()
        for row in raw_rows:
            uid = _i568_row_uid(row)
            mission = _i568_text((row or {}).get('mission') or (row or {}).get('mission_name')) if isinstance(row, dict) else ''
            if uid:
                raw_keys.add((mission.casefold(), uid.casefold()))

        content_rows = list(out.get('mission_content') or [])
        content_keys = set()
        for row in content_rows:
            if not isinstance(row, dict):
                continue
            mission = _i568_text(row.get('mission') or row.get('mission_name'))
            ident = _i568_text(row.get('hash') or row.get('data') or row.get('uid') or row.get('filename') or row.get('name'))
            if ident:
                content_keys.add((mission.casefold(), ident.casefold()))

        for mission in names:
            q = quote(_i568_text(mission), safe='')
            for suffix in ('', '/contents', '/cot'):
                url = marti + '/Marti/api/missions/' + q + suffix if marti else ''
                result = responses.get(url) if url else None
                if not (isinstance(result, dict) and result.get('ok')):
                    continue
                body = _i568_result_body(result)
                try:
                    projected = _i512_mission_api_objects(body, _i568_text(mission))
                except Exception:
                    projected = []
                for row in projected:
                    if not isinstance(row, dict):
                        continue
                    candidate = _i568_clone(row)
                    candidate['mission'] = _i568_text(mission)
                    candidate['mission_name'] = _i568_text(mission)
                    candidate['source'] = 'Mission API i568 background worker'
                    uid = _i568_row_uid(candidate)
                    key = (_i568_text(mission).casefold(), uid.casefold()) if uid else None
                    if key and key in object_keys:
                        continue
                    if key:
                        object_keys.add(key)
                    objects.append(candidate)
                for nested in _i568_walk_dicts(body):
                    candidate = _i568_clone(nested)
                    if not isinstance(candidate, dict):
                        continue
                    candidate.setdefault('mission', _i568_text(mission))
                    candidate.setdefault('mission_name', _i568_text(mission))
                    candidate.setdefault('source', 'Mission API i568 background worker')
                    uid = _i568_row_uid(candidate)
                    if uid:
                        key = (_i568_text(mission).casefold(), uid.casefold())
                        if key not in raw_keys:
                            raw_keys.add(key)
                            raw_rows.append(candidate)
                    if suffix == '/contents':
                        ident = _i568_text(candidate.get('hash') or candidate.get('data') or candidate.get('uid') or candidate.get('filename') or candidate.get('name'))
                        key = (_i568_text(mission).casefold(), ident.casefold()) if ident else None
                        if key and key not in content_keys:
                            content_keys.add(key)
                            content_rows.append(candidate)

        out['objects'] = objects
        out['mission_uids'] = raw_rows
        out['mission_content'] = content_rows
        out['data_sync_remote_seed_i568'] = {
            'version': 'i568',
            'mission_count': len(names),
            'objects_after_seed': len(objects),
            'mission_uids_after_seed': len(raw_rows),
            'mission_content_after_seed': len(content_rows),
            'per_user_authenticated_source': True,
        }
        return out

    def _i512_request_json(cfg, sess, url, timeout=10):
        responses = getattr(_I568_REQUEST_CONTEXT, 'responses', None)
        if isinstance(responses, dict) and url in responses:
            return _i568_clone(responses[url])
        # The old implementation could block each serial endpoint for ten
        # seconds. Any residual caller receives the i568 short deadline.
        return _i568_request_json_before(cfg, sess, url, timeout=min(max(1, int(timeout or 1)), _I568_ENDPOINT_TIMEOUT_SECONDS))
    globals()['_i512_request_json'] = _i512_request_json

    def _i568_build_snapshot(cfg, sess, token, reason):
        acquired = _i568_parallel_acquisition(cfg, sess)
        if not acquired['summary'].get('discovery_ok'):
            errors = [row.get('error') for row in acquired.get('timings') or [] if row.get('error')]
            raise RuntimeError('OpenTAKServer Mission discovery did not complete successfully. ' + '; '.join(errors[:4]))
        # Feed the bounded, per-user acquisition into the existing scope and CoT
        # enrichment caches so older layers never launch their own serial probes.
        _i568_seed_scope_cache(cfg, sess, acquired)
        _i568_seed_enrichment_cache(cfg, sess, acquired)
        _I568_REQUEST_CONTEXT.responses = acquired.get('responses') or {}
        base = _i568_seed_remote_mission_data(tak_map_data_sync(), cfg, acquired)
        result = _i568_augment_before(base, cfg, sess)
        if not isinstance(result, dict):
            raise RuntimeError('Data Sync augmentation returned an invalid response.')
        result = _i568_clone(result)
        result['ok'] = bool(result.get('ok', True))
        result['version'] = 'i568'
        result['data_sync_background_worker_i568'] = {
            'version': 'i568',
            'acquisition': dict(acquired.get('summary') or {}),
            'endpoint_timings': list(acquired.get('timings') or [])[:120],
            'serial_browser_route_acquisition': False,
            'last_known_good_preserved': True,
        }
        return result, acquired

    def _i568_refresh_worker(key, cfg, sess, token, reason, generation):
        started_epoch = time.time()
        started_mono = time.monotonic()
        _i568_set_context(token, sess)
        try:
            result, acquired = _i568_build_snapshot(cfg, sess, token, reason)
            completed_epoch = time.time()
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                # A newer generation may have been scheduled while this one was
                # running. Never let an older result overwrite it.
                if int(state.get('generation') or 0) == int(generation):
                    state['snapshot'] = result
                    state['last_success_epoch'] = completed_epoch
                    state['last_attempt_completed_epoch'] = completed_epoch
                    state['last_attempt_duration_seconds'] = round(time.monotonic() - started_mono, 4)
                    state['last_error'] = ''
                    state['endpoint_timings'] = list(acquired.get('timings') or [])[:120]
                    state['acquisition_summary'] = dict(acquired.get('summary') or {})
                    _i568_persist_success(state)
        except Exception as exc:
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                if int(state.get('generation') or 0) == int(generation):
                    state['last_attempt_completed_epoch'] = time.time()
                    state['last_attempt_duration_seconds'] = round(time.monotonic() - started_mono, 4)
                    state['last_error'] = _i568_text(exc)[:1200]
        finally:
            _i568_clear_context()
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                if int(state.get('generation') or 0) == int(generation):
                    state['in_flight'] = False
                    state['last_attempt_completed_epoch'] = state.get('last_attempt_completed_epoch') or time.time()
                    state['last_attempt_duration_seconds'] = state.get('last_attempt_duration_seconds') or round(time.monotonic() - started_mono, 4)

    def _i568_schedule_refresh(key, cfg, sess, token, reason, force=False):
        now = time.time()
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            if state.get('in_flight'):
                return False, 'already-running'
            last_attempt = float(state.get('last_attempt_started_epoch') or 0)
            if not force and last_attempt and now - last_attempt < _I568_RETRY_COOLDOWN_SECONDS and not state.get('snapshot'):
                return False, 'retry-cooldown'
            state['generation'] = int(state.get('generation') or 0) + 1
            generation = state['generation']
            state['in_flight'] = True
            state['last_attempt_started_epoch'] = now
            state['last_reason'] = _i568_text(reason) or ('manual' if force else 'automatic')
        thread = threading.Thread(
            target=_i568_refresh_worker,
            args=(key, _i568_clone(cfg), _i568_clone(sess), _i568_text(token), _i568_text(reason), generation),
            name='tak-map-i568-data-sync-' + key[:8],
            daemon=True,
        )
        thread.start()
        return True, 'scheduled'

    def _i568_response_payload(state):
        now = time.time()
        with _I568_STATE_LOCK:
            snapshot = _i568_clone(state.get('snapshot')) if isinstance(state.get('snapshot'), dict) else None
            last_success = float(state.get('last_success_epoch') or 0)
            in_flight = bool(state.get('in_flight'))
            last_error = _i568_text(state.get('last_error'))
            diag = {
                'version': 'i568',
                'snapshot_available': bool(snapshot),
                'refreshing': in_flight,
                'last_success_at': _i568_iso(last_success),
                'last_success_age_seconds': round(max(0.0, now - last_success), 3) if last_success else None,
                'last_attempt_started_at': _i568_iso(state.get('last_attempt_started_epoch') or 0),
                'last_attempt_completed_at': _i568_iso(state.get('last_attempt_completed_epoch') or 0),
                'last_attempt_duration_seconds': state.get('last_attempt_duration_seconds') or 0,
                'last_error': last_error,
                'last_reason': state.get('last_reason') or '',
                'generation': int(state.get('generation') or 0),
                'automatic_poll_seconds': _I568_SNAPSHOT_MAX_AGE_SECONDS,
                'parallel_max_workers': _I568_MAX_WORKERS,
                'per_endpoint_timeout_seconds': _I568_ENDPOINT_TIMEOUT_SECONDS,
                'overall_refresh_deadline_seconds': _I568_OVERALL_REFRESH_DEADLINE_SECONDS,
                'acquisition_summary': dict(state.get('acquisition_summary') or {}),
                'endpoint_timings': list(state.get('endpoint_timings') or [])[:120],
                'last_known_good_preserved': True,
                'browser_route_blocks_on_ots': False,
            }
        if snapshot:
            payload = snapshot
            if in_flight:
                diag['state'] = 'refreshing-last-known-good'
                diag['message'] = 'Refreshing OTS missions in the background. Showing the last successful snapshot.'
            elif last_error:
                diag['state'] = 'stale-last-known-good'
                diag['message'] = 'Showing the last successful Data Sync snapshot. The latest OTS refresh failed.'
            else:
                diag['state'] = 'ready'
                diag['message'] = 'Data Sync snapshot ready.'
            payload['data_sync_background_i568'] = diag
            payload['refreshing'] = in_flight
            payload['stale'] = bool(last_error)
            payload['version'] = 'i568'
            return payload
        message = 'Initial OTS refresh in progress'
        if last_error and not in_flight:
            message = 'Initial OTS refresh is retrying after a temporary OpenTAKServer error'
        diag['state'] = 'initial-refresh-in-progress'
        diag['message'] = message
        return {
            'ok': True,
            'version': 'i568',
            'objects': [],
            'missions': [],
            'mission_content': [],
            'mission_uids': [],
            'refreshing': True,
            'initial_ots_refresh_in_progress': True,
            'message': message,
            'data_sync_background_i568': diag,
        }

    _i568_get_before = Handler.do_GET
    def _i568_do_get(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if path == '/mil2525/atak-compatibility-aliases-i553.json':
            shared = _I568_SHARED_MIL_ROOT / 'atak-compatibility-aliases-i553.json'
            packaged = _I568_ROOT / 'assets' / 'mil2525' / 'atak-compatibility-aliases-i553.json'
            selected = shared if shared.is_file() else packaged
            return _i541_send_file(self, selected, 'application/json; charset=utf-8', 'i568-active-atak-alias-catalog')
        runtime = {
            '/assets/runtime/tak-map-icon-registry-i568.js': (_I568_ROOT / 'assets' / 'tak-map-icon-registry-i568.js', 'application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-popup-localdata-i568.js': (_I568_ROOT / 'assets' / 'tak-map-popup-localdata-i568.js', 'application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-context-sidebar-i568.js': (_I568_ROOT / 'assets' / 'tak-map-context-sidebar-i568.js', 'application/javascript; charset=utf-8'),
        }.get(path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i568-background-data-sync')
        if path == '/api/tak-map/data-sync':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session()
            if '_i512_forced_change' in globals() and _i512_forced_change(sess):
                return self._send_json({'ok': False, 'password_change_required': True, 'error': 'Change the default local administrator password first.'}, 428)
            cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
            auth_mode = _i568_text((sess or {}).get('auth_mode'))
            if not auth_mode.startswith('ots-'):
                try:
                    token = self._tak_map_token() if callable(getattr(self, '_tak_map_token', None)) else ''
                    _i568_set_context(token, sess or {})
                    payload = _i568_augment_before(tak_map_data_sync(), cfg or {}, sess or {})
                    payload = _i568_clone(payload) if isinstance(payload, dict) else {'ok': True, 'objects': [], 'missions': []}
                    payload['version'] = 'i568'
                    payload['data_sync_background_i568'] = {'version': 'i568', 'state': 'not-applicable-local-session', 'snapshot_available': True, 'refreshing': False, 'browser_route_blocks_on_ots': False}
                    return self._send_json(payload)
                finally:
                    _i568_clear_context()
            query = parse_qs(parsed.query or '')
            force = _i568_text((query.get('force') or ['0'])[0]).casefold() in ('1', 'true', 'yes', 'on')
            reason = _i568_text((query.get('reason') or [''])[0]) or ('manual' if force else 'poll')
            token = self._tak_map_token() if callable(getattr(self, '_tak_map_token', None)) else ''
            key = _i568_state_key(cfg or {}, sess or {})
            state = _i568_state(key)
            with _I568_STATE_LOCK:
                last_success = float(state.get('last_success_epoch') or 0)
                stale = not last_success or (time.time() - last_success >= _I568_SNAPSHOT_MAX_AGE_SECONDS)
            if force or stale:
                _i568_schedule_refresh(key, cfg or {}, sess or {}, token, reason, force=force)
            return self._send_json(_i568_response_payload(state))
        return _i568_get_before(self)
    Handler.do_GET = _i568_do_get

    _i568_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i568_config_before() or {})
        cfg['tak_map_iteration'] = 'i568'
        cfg['version'] = '1.3.0-i568'
        cfg['data_sync_background_i568'] = {
            'version': 'i568',
            'per_user_worker': True,
            'last_known_good_snapshot': True,
            'initial_refresh_message': 'Initial OTS refresh in progress',
            'automatic_poll_seconds': _I568_SNAPSHOT_MAX_AGE_SECONDS,
            'manual_refresh_schedules_worker': True,
            'parallel_max_workers': _I568_MAX_WORKERS,
            'per_endpoint_timeout_seconds': _I568_ENDPOINT_TIMEOUT_SECONDS,
            'overall_refresh_deadline_seconds': _I568_OVERALL_REFRESH_DEADLINE_SECONDS,
            'serial_browser_route_acquisition': False,
        }
        control = dict(cfg.get('data_sync_control') or {})
        control.update({'version': 'i568', 'automatic_poll_seconds': 300, 'browser_request_timeout_seconds': 12, 'last_known_good_preserved': True, 'initial_refresh_explicit': True})
        cfg['data_sync_control'] = control
        startup = dict(cfg.get('startup_architecture_i567') or cfg.get('startup_architecture_i566') or {})
        startup.update({
            'package_version': 'i568',
            'data_sync_poll_seconds': 300,
            'data_sync_background_worker': True,
            'icon_registry_runtime': '/assets/runtime/tak-map-icon-registry-i568.js',
            'popup_localdata_runtime': '/assets/runtime/tak-map-popup-localdata-i568.js',
            'context_sidebar_runtime': '/assets/runtime/tak-map-context-sidebar-i568.js',
        })
        cfg['startup_architecture_i568'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i568_patch_html(html):
        if not isinstance(html, str):
            return html
        html = re.sub(r'1\.3\.0-i567', '1.3.0-i568', html)
        html = re.sub(r'TAKDashboard/i567', 'TAKDashboard/i568', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i567', 'TAK-Map/1.3.0 i568', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i568\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i568\2', html)
        html = re.sub(r'tak-map-icon-registry-i\d+\.js', 'tak-map-icon-registry-i568.js', html)
        html = re.sub(r'tak-map-popup-localdata-i\d+\.js', 'tak-map-popup-localdata-i568.js', html)
        html = re.sub(r'tak-map-context-sidebar-i\d+\.js', 'tak-map-context-sidebar-i568.js', html)
        html = re.sub(r'v=1\.3\.0-i567', 'v=1.3.0-i568', html)
        html = html.replace('takMapIconRegistryI567', 'takMapIconRegistryI568')
        html = html.replace('takMapPopupLocalDataI567', 'takMapPopupLocalDataI568')
        html = html.replace('takMapContextSidebarI567', 'takMapContextSidebarI568')
        return html
    TAK_MAP_HTML = _i568_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i568_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i568'
except Exception as _i568_exc:
    try:
        print('TAK Map i568 background Data Sync patch failed:', _i568_exc)
    except Exception:
        pass
# --- end TAK Map i568 background per-user OTS Mission snapshots ---


# --- TAK Map i569 per-user authenticated background Mission worker correction ---
try:
    # i568 accidentally bypassed the current ATAK/per-user Mission client by
    # capturing the old generic i512 web/API requester. It also established
    # threading.local identity only in the parent worker thread, which is not
    # inherited by ThreadPoolExecutor children. The corrected worker calls the
    # current centralized Mission client from inside each child with the signed-
    # in user's request context explicitly installed for that task.
    _i569_mission_request = _ots_mission_api_request

    def _i569_parsed_result(result):
        out = dict(result or {}) if isinstance(result, dict) else {
            'ok': False, 'status': 0, 'error': 'Invalid Mission API result.'
        }
        parsed = out.get('json')
        if not isinstance(parsed, (dict, list)):
            body = out.get('body')
            if isinstance(body, (dict, list)):
                parsed = body
            elif isinstance(body, str) and body.strip():
                try:
                    parsed = json.loads(body)
                except Exception:
                    parsed = body
            else:
                parsed = body
        # Existing i512/i568 projection helpers expect the parsed representation
        # in body. Preserve the raw text separately for diagnostics and XML paths.
        if isinstance(out.get('body'), str):
            out['raw_body'] = out.get('body')
        out['body'] = parsed
        if isinstance(parsed, (dict, list)):
            out['json'] = parsed
        out['identity_mode'] = _i568_text(out.get('identity_mode') or 'per-user-enrolled-marti-certificate')
        out['data_sync_worker_i569'] = True
        return out

    def _i569_call(cfg, sess, token, url, path, label, timeout):
        started = time.monotonic()
        _i568_set_context(token, sess)
        try:
            result = _i569_mission_request(
                path,
                method='GET',
                body=None,
                headers={'Accept':'application/json,*/*'},
                public_host=_i568_text(urlparse(url).hostname),
                timeout=max(1, int(timeout)),
            )
            result = _i569_parsed_result(result)
        except Exception as exc:
            result = {'ok':False,'status':0,'body':None,'json':{},'error':_i568_text(exc),
                      'identity_mode':'per-user-enrolled-marti-certificate','data_sync_worker_i569':True}
        finally:
            _i568_clear_context()
        duration = round(time.monotonic() - started, 4)
        return url, result, {
            'endpoint': label,
            'url_path': path,
            'ok': bool(result.get('ok')),
            'status': int(result.get('status') or 0),
            'duration_seconds': duration,
            'error': _i568_text(result.get('error'))[:300],
            'identity_mode': _i568_text(result.get('identity_mode')),
            'user_agent_family': _i568_text(result.get('user_agent_family')),
            'mission_token_used': bool(result.get('mission_token_used')),
        }

    def _i569_run_parallel(tasks, cfg, sess, token, deadline, max_workers):
        responses, timings = {}, []
        if not tasks:
            return responses, timings
        executor = ThreadPoolExecutor(max_workers=max(1, min(int(max_workers), len(tasks))))
        future_map = {}
        try:
            for task in tasks:
                url, path, label, timeout = task
                future = executor.submit(_i569_call, cfg, sess, token, url, path, label, timeout)
                future_map[future] = task
            remaining = max(0.0, deadline - time.monotonic())
            done, pending = _i568_wait(list(future_map), timeout=remaining)
            for future in done:
                task = future_map[future]
                try:
                    url, result, timing = future.result()
                except Exception as exc:
                    url, path, label, _timeout = task
                    result = {'ok':False,'status':0,'body':None,'json':{},'error':_i568_text(exc),
                              'identity_mode':'per-user-enrolled-marti-certificate','data_sync_worker_i569':True}
                    timing = {'endpoint':label,'url_path':path,'ok':False,'status':0,
                              'duration_seconds':None,'error':_i568_text(exc)[:300],
                              'identity_mode':'per-user-enrolled-marti-certificate'}
                responses[url] = result
                timings.append(timing)
            for future in pending:
                url, path, label, _timeout = future_map[future]
                future.cancel()
                responses[url] = {'ok':False,'status':0,'body':None,'json':{},
                                  'error':'Overall i569 refresh deadline reached before this endpoint completed.',
                                  'identity_mode':'per-user-enrolled-marti-certificate','data_sync_worker_i569':True}
                timings.append({'endpoint':label,'url_path':path,'ok':False,'status':0,
                                'duration_seconds':None,'error':'overall-refresh-deadline',
                                'identity_mode':'per-user-enrolled-marti-certificate'})
        finally:
            executor.shutdown(wait=False, cancel_futures=True)
        return responses, timings

    def _i568_parallel_acquisition(cfg, sess):
        started = time.monotonic()
        deadline = started + _I568_OVERALL_REFRESH_DEADLINE_SECONDS
        marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')
        api = _i568_text((cfg or {}).get('api_url') or (cfg or {}).get('base_url')).rstrip('/')
        token = _i568_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', '')) if '_I529_REQUEST_CONTEXT' in globals() else ''
        if not marti:
            return {'responses':{},'mission_names':[],'timings':[], 'summary':{
                'version':'i569','discovery_ok':False,'mission_count':0,
                'error':'OpenTAKServer Marti URL is not configured.',
                'duration_seconds':round(time.monotonic()-started,4)}}

        discovery_path = '/Marti/api/missions'
        discovery_url = marti + discovery_path
        responses, timings = _i569_run_parallel(
            [(discovery_url, discovery_path, 'discovery:marti-per-user', _I568_DISCOVERY_TIMEOUT_SECONDS)],
            cfg, sess, token, deadline, 1)
        discovery = responses.get(discovery_url) or {}
        mission_names = []
        if discovery.get('ok'):
            for name in _i512_mission_names(_i568_result_body(discovery)):
                if name not in mission_names:
                    mission_names.append(name)
        mission_names = mission_names[:20]

        # Older augmentation still probes the web/API discovery URL. Alias the
        # authoritative certificate-scoped Marti result so it cannot launch a
        # second generic/shared-credential request.
        if api:
            responses[api + '/api/missions'] = _i568_clone(discovery)

        tasks = []
        for mission in mission_names:
            q = quote(mission, safe='')
            for suffix, kind in (('', 'detail'), ('/contents', 'contents'), ('/cot', 'cot')):
                path = '/Marti/api/missions/' + q + suffix
                tasks.append((marti + path, path, 'mission:' + mission + ':' + kind, _I568_ENDPOINT_TIMEOUT_SECONDS))
        mission_responses, mission_timings = _i569_run_parallel(
            tasks, cfg, sess, token, deadline, _I568_MAX_WORKERS)
        responses.update(mission_responses)
        timings.extend(mission_timings)

        discovery_ok = bool(discovery.get('ok'))
        completed = sum(1 for row in timings if row.get('ok'))
        auth_failures = [row for row in timings if int(row.get('status') or 0) in (401,403,428)]
        return {
            'responses':responses,
            'mission_names':mission_names,
            'timings':sorted(timings,key=lambda row:str(row.get('endpoint') or '')),
            'summary':{
                'version':'i569','discovery_ok':discovery_ok,
                'authoritative_discovery':'/Marti/api/missions?passwordProtected=true',
                'per_user_certificate':True,'atak_client_profile':True,
                'mission_count':len(mission_names),'mission_endpoint_count':len(tasks),
                'successful_endpoint_count':completed,
                'failed_endpoint_count':max(0,len(timings)-completed),
                'authentication_failure_count':len(auth_failures),
                'max_workers':_I568_MAX_WORKERS,
                'per_endpoint_timeout_seconds':_I568_ENDPOINT_TIMEOUT_SECONDS,
                'overall_deadline_seconds':_I568_OVERALL_REFRESH_DEADLINE_SECONDS,
                'duration_seconds':round(time.monotonic()-started,4),
            },
        }
    globals()['_i568_parallel_acquisition'] = _i568_parallel_acquisition

    def _i568_result_body(result):
        if not isinstance(result, dict):
            return None
        parsed = result.get('json')
        if isinstance(parsed, (dict, list)):
            return parsed
        body = result.get('body')
        if isinstance(body, (dict, list)):
            return body
        if isinstance(body, str) and body.strip():
            try:
                return json.loads(body)
            except Exception:
                return body
        return body
    globals()['_i568_result_body'] = _i568_result_body

    _i569_build_snapshot_before = _i568_build_snapshot
    def _i568_build_snapshot(cfg, sess, token, reason):
        result, acquired = _i569_build_snapshot_before(cfg, sess, token, reason)
        summary = dict(acquired.get('summary') or {})
        # A certificate/token/authentication failure must never be promoted as a
        # successful empty snapshot. Preserve the prior LKG and surface the cause.
        if summary.get('authentication_failure_count') and not summary.get('mission_count'):
            raise RuntimeError('Per-user OpenTAKServer Mission authentication failed; the previous Data Sync snapshot was preserved.')
        result = _i568_clone(result)
        result['version'] = 'i569'
        result['data_sync_background_worker_i569'] = {
            'version':'i569','per_user_certificate':True,'atak_client_profile':True,
            'thread_context_installed_per_request':True,'parsed_json_response_adapter':True,
            'authoritative_discovery':'/Marti/api/missions?passwordProtected=true',
            'acquisition':summary,
        }
        return result, acquired
    globals()['_i568_build_snapshot'] = _i568_build_snapshot

    _i569_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i569_config_before() or {})
        cfg['tak_map_iteration'] = 'i569'
        cfg['version'] = '1.3.0-i569'
        cfg['data_sync_background_i569'] = {
            'version':'i569','per_user_certificate':True,'atak_mission_client':True,
            'thread_context_installed_per_request':True,
            'parsed_json_response_adapter':True,
            'authoritative_discovery':'/Marti/api/missions?passwordProtected=true',
            'shared_service_fallback':False,
            'password_protected_discovery_enabled':True,
            'missionuid_discovery_authoritative':True,
            'network_get_contents_calls':0,
            'optional_cot_enrichment':True,
            'ots_contract':'OpenTAKServer-1.7.11.post10',
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config
    TAK_MAP_ITERATION = 'i569'
except Exception as _i569_exc:
    try: print('TAK Map i569 per-user background Mission worker correction failed:', _i569_exc)
    except Exception: pass
# --- end TAK Map i569 per-user authenticated background Mission worker correction ---



# --- TAK Map i569 exact OpenTAKServer 1.7.11 Mission contract correction ---
try:
    # Live validation against the installed OpenTAKServer 1.7.11.post10 source
    # and the user's certificate-authenticated server established the exact
    # discovery contract:
    #   GET /Marti/api/missions?passwordProtected=true
    # returns the complete mission rows, including uids and contents. The bare
    # list endpoint intentionally omits password-protected missions. There is no
    # GET /contents endpoint; protected /cot requires a mission subscription
    # token and may require the mission password. MissionUID discovery remains
    # authoritative even when optional CoT enrichment cannot be acquired.
    _I569_DISCOVERY_PATH = '/Marti/api/missions?passwordProtected=true'
    _I569_OTS_CONTRACT = 'OpenTAKServer-1.7.11.post10'

    def _i569_mission_rows(payload):
        if not isinstance(payload, dict):
            return []
        data = payload.get('data')
        if not isinstance(data, list):
            return []
        rows = []
        seen = set()
        for value in data:
            if not isinstance(value, dict):
                continue
            name = _i568_text(value.get('name') or value.get('mission_name') or value.get('missionName'))
            if not name or name.casefold() in seen:
                continue
            seen.add(name.casefold())
            row = _i568_clone(value)
            row['name'] = name
            rows.append(row)
        return rows[:20]

    def _i569_result(payload, status=200, ok=True, error='', **extra):
        result = {
            'ok': bool(ok),
            'status': int(status or 0),
            'body': _i568_clone(payload),
            'json': _i568_clone(payload),
            'error': _i568_text(error),
            'identity_mode': 'per-user-enrolled-marti-certificate',
            'data_sync_worker_i569': True,
            'shared_service_fallback': False,
        }
        result.update(extra)
        return result

    def _i569_mission_payload(row):
        return {
            'version': 3,
            'type': 'Mission',
            'data': [_i568_clone(row)],
        }

    def _i569_contents_payload(row):
        contents = row.get('contents') if isinstance(row, dict) and isinstance(row.get('contents'), list) else []
        return {
            'version': 3,
            'type': 'MissionContent',
            'data': _i568_clone(contents),
        }

    def _i569_password_protected(row):
        return bool(isinstance(row, dict) and (row.get('passwordProtected') is True or row.get('password_protected') is True))

    def _i568_parallel_acquisition(cfg, sess):
        started = time.monotonic()
        deadline = started + _I568_OVERALL_REFRESH_DEADLINE_SECONDS
        marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')
        api = _i568_text((cfg or {}).get('api_url') or (cfg or {}).get('base_url')).rstrip('/')
        token = _i568_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', '')) if '_I529_REQUEST_CONTEXT' in globals() else ''
        if not marti:
            return {
                'responses': {}, 'mission_names': [], 'mission_rows': [], 'timings': [],
                'summary': {
                    'version': 'i569', 'discovery_ok': False, 'mission_count': 0,
                    'error': 'OpenTAKServer Marti URL is not configured.',
                    'duration_seconds': round(time.monotonic() - started, 4),
                },
            }

        discovery_url = marti + _I569_DISCOVERY_PATH
        responses, timings = _i569_run_parallel(
            [(discovery_url, _I569_DISCOVERY_PATH, 'discovery:marti-per-user-include-password-protected', _I568_DISCOVERY_TIMEOUT_SECONDS)],
            cfg, sess, token, deadline, 1,
        )
        discovery = responses.get(discovery_url) or {}
        discovery_payload = _i568_result_body(discovery)
        mission_rows = _i569_mission_rows(discovery_payload) if discovery.get('ok') else []
        mission_names = [_i568_text(row.get('name')) for row in mission_rows if _i568_text(row.get('name'))]

        # Alias the authoritative result into every older discovery key so no
        # legacy layer can launch a second generic or password-filtered request.
        responses[marti + '/Marti/api/missions'] = _i568_clone(discovery)
        if api:
            responses[api + '/api/missions'] = _i568_clone(discovery)

        cot_tasks = []
        protected_skipped = 0
        discovery_uid_count = 0
        discovery_content_count = 0
        for row in mission_rows:
            mission = _i568_text(row.get('name'))
            q = quote(mission, safe='')
            detail_url = marti + '/Marti/api/missions/' + q
            contents_url = detail_url + '/contents'
            cot_url = detail_url + '/cot'

            # In-memory compatibility responses allow the pre-i569 projection
            # pipeline to consume the discovery payload without issuing network
            # GETs to nonexistent or redundant endpoints.
            responses[detail_url] = _i569_result(
                _i569_mission_payload(row),
                source='i569-discovery-row-alias',
                network_request=False,
            )
            responses[contents_url] = _i569_result(
                _i569_contents_payload(row),
                source='i569-discovery-contents-alias',
                network_request=False,
                endpoint_not_called=True,
            )

            uids = row.get('uids') if isinstance(row.get('uids'), list) else []
            contents = row.get('contents') if isinstance(row.get('contents'), list) else []
            discovery_uid_count += len(uids)
            discovery_content_count += len(contents)

            if _i569_password_protected(row):
                protected_skipped += 1
                responses[cot_url] = _i569_result(
                    None,
                    status=423,
                    ok=False,
                    error='Optional Mission CoT enrichment was skipped because this mission is password-protected and no exportable mission password is required for MissionUID discovery.',
                    source='i569-password-protected-cot-skipped',
                    network_request=False,
                    optional_enrichment=True,
                    password_protected=True,
                )
                timings.append({
                    'endpoint': 'mission:' + mission + ':cot',
                    'url_path': '/Marti/api/missions/' + q + '/cot',
                    'ok': True,
                    'status': 0,
                    'duration_seconds': 0.0,
                    'error': '',
                    'skipped': True,
                    'skip_reason': 'password-protected-missionuid-discovery-authoritative',
                    'identity_mode': 'per-user-enrolled-marti-certificate',
                })
            else:
                cot_tasks.append((
                    cot_url,
                    '/Marti/api/missions/' + q + '/cot',
                    'mission:' + mission + ':cot',
                    _I568_ENDPOINT_TIMEOUT_SECONDS,
                ))

        cot_responses, cot_timings = _i569_run_parallel(
            cot_tasks, cfg, sess, token, deadline, _I568_MAX_WORKERS,
        )
        responses.update(cot_responses)
        timings.extend(cot_timings)

        discovery_ok = bool(discovery.get('ok'))
        actual_timings = [row for row in timings if not row.get('skipped')]
        completed = sum(1 for row in actual_timings if row.get('ok'))
        auth_failures = [row for row in actual_timings if int(row.get('status') or 0) in (401, 403, 428)]
        return {
            'responses': responses,
            'mission_names': mission_names,
            'mission_rows': mission_rows,
            'timings': sorted(timings, key=lambda row: str(row.get('endpoint') or '')),
            'summary': {
                'version': 'i569',
                'ots_contract': _I569_OTS_CONTRACT,
                'discovery_ok': discovery_ok,
                'authoritative_discovery': _I569_DISCOVERY_PATH,
                'password_protected_discovery_enabled': True,
                'per_user_certificate': True,
                'atak_client_profile': True,
                'mission_count': len(mission_names),
                'password_protected_mission_count': sum(1 for row in mission_rows if _i569_password_protected(row)),
                'discovery_mission_uid_count': discovery_uid_count,
                'discovery_content_count': discovery_content_count,
                'mission_endpoint_count': len(cot_tasks),
                'cot_enrichment_attempted_count': len(cot_tasks),
                'cot_enrichment_skipped_password_protected_count': protected_skipped,
                'network_get_contents_calls': 0,
                'successful_endpoint_count': completed,
                'failed_endpoint_count': max(0, len(actual_timings) - completed),
                'authentication_failure_count': len(auth_failures),
                'max_workers': _I568_MAX_WORKERS,
                'per_endpoint_timeout_seconds': _I568_ENDPOINT_TIMEOUT_SECONDS,
                'overall_deadline_seconds': _I568_OVERALL_REFRESH_DEADLINE_SECONDS,
                'duration_seconds': round(time.monotonic() - started, 4),
            },
        }
    globals()['_i568_parallel_acquisition'] = _i568_parallel_acquisition

    def _i569_candidate_uid(row):
        return _i568_row_uid(row) if isinstance(row, dict) else ''

    def _i568_seed_remote_mission_data(base, cfg, acquired):
        out = _i568_clone(base) if isinstance(base, dict) else {}
        if not isinstance(out, dict):
            out = {}
        mission_rows = list(acquired.get('mission_rows') or [])
        responses = acquired.get('responses') if isinstance(acquired.get('responses'), dict) else {}
        marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')

        missions = list(out.get('missions') or [])
        mission_keys = set()
        for value in missions:
            if isinstance(value, dict):
                name = _i568_text(value.get('name') or value.get('mission_name') or value.get('missionName'))
            else:
                name = _i568_text(value)
            if name:
                mission_keys.add(name.casefold())

        objects = list(out.get('objects') or [])
        object_keys = set()
        for value in objects:
            uid = _i569_candidate_uid(value)
            mission = _i568_text((value or {}).get('mission') or (value or {}).get('mission_name')) if isinstance(value, dict) else ''
            if uid:
                object_keys.add((mission.casefold(), uid.casefold()))

        raw_rows = list(out.get('mission_uids') or [])
        raw_keys = set()
        for value in raw_rows:
            uid = _i569_candidate_uid(value)
            mission = _i568_text((value or {}).get('mission') or (value or {}).get('mission_name')) if isinstance(value, dict) else ''
            if uid:
                raw_keys.add((mission.casefold(), uid.casefold()))

        content_rows = list(out.get('mission_content') or [])
        content_keys = set()
        for value in content_rows:
            if not isinstance(value, dict):
                continue
            mission = _i568_text(value.get('mission') or value.get('mission_name'))
            nested = value.get('data') if isinstance(value.get('data'), dict) else {}
            ident = _i568_text(value.get('hash') or nested.get('hash') or value.get('uid') or nested.get('uid') or value.get('filename') or nested.get('name'))
            if ident:
                content_keys.add((mission.casefold(), ident.casefold()))

        for mission_row in mission_rows:
            if not isinstance(mission_row, dict):
                continue
            mission = _i568_text(mission_row.get('name'))
            if not mission:
                continue
            if mission.casefold() not in mission_keys:
                mission_copy = _i568_clone(mission_row)
                mission_copy['source'] = 'OpenTAKServer Mission discovery i569'
                missions.append(mission_copy)
                mission_keys.add(mission.casefold())

            for raw in list(mission_row.get('uids') or []):
                if not isinstance(raw, dict):
                    continue
                candidate = _i568_clone(raw)
                candidate['mission'] = mission
                candidate['mission_name'] = mission
                candidate['source'] = 'OpenTAKServer MissionUID discovery i569'
                candidate['kind'] = 'datasync'
                uid = _i569_candidate_uid(candidate)
                raw_key = (mission.casefold(), uid.casefold()) if uid else None
                if raw_key and raw_key not in raw_keys:
                    raw_keys.add(raw_key)
                    raw_rows.append(_i568_clone(candidate))

                try:
                    marker = _normalize_tak_marker(candidate, 'mission_uids', 'datasync')
                except Exception:
                    marker = None
                if isinstance(marker, dict):
                    marker = _i568_clone(marker)
                    marker['mission'] = mission
                    marker['mission_name'] = mission
                    marker['source'] = 'OpenTAKServer MissionUID discovery i569'
                    marker['kind'] = 'datasync'
                    marker['is_mission_object'] = True
                    marker_uid = _i569_candidate_uid(marker) or uid
                    object_key = (mission.casefold(), marker_uid.casefold()) if marker_uid else None
                    point_or_shape = marker.get('lat') is not None or marker.get('geometry') or marker.get('coords')
                    if point_or_shape and (not object_key or object_key not in object_keys):
                        if object_key:
                            object_keys.add(object_key)
                        objects.append(marker)

            for content in list(mission_row.get('contents') or []):
                if not isinstance(content, dict):
                    continue
                candidate = _i568_clone(content)
                candidate['mission'] = mission
                candidate['mission_name'] = mission
                candidate['source'] = 'OpenTAKServer Mission content discovery i569'
                nested = candidate.get('data') if isinstance(candidate.get('data'), dict) else {}
                ident = _i568_text(candidate.get('hash') or nested.get('hash') or candidate.get('uid') or nested.get('uid') or candidate.get('filename') or nested.get('name'))
                content_key = (mission.casefold(), ident.casefold()) if ident else None
                if content_key and content_key in content_keys:
                    continue
                if content_key:
                    content_keys.add(content_key)
                content_rows.append(candidate)

            # Optional /cot responses only enrich already-discovered objects. They
            # are never required to make MissionUID rows visible.
            cot_url = marti + '/Marti/api/missions/' + quote(mission, safe='') + '/cot' if marti else ''
            cot_result = responses.get(cot_url) if cot_url else None
            if isinstance(cot_result, dict) and cot_result.get('ok'):
                body = _i568_result_body(cot_result)
                try:
                    projected = _i512_mission_api_objects(body, mission)
                except Exception:
                    projected = []
                for marker in projected:
                    if not isinstance(marker, dict):
                        continue
                    marker = _i568_clone(marker)
                    marker['mission'] = mission
                    marker['mission_name'] = mission
                    marker['source'] = 'OpenTAKServer Mission /cot enrichment i569'
                    marker_uid = _i569_candidate_uid(marker)
                    object_key = (mission.casefold(), marker_uid.casefold()) if marker_uid else None
                    if object_key and object_key in object_keys:
                        continue
                    if object_key:
                        object_keys.add(object_key)
                    objects.append(marker)

        out['missions'] = missions
        out['objects'] = objects
        out['mission_uids'] = raw_rows
        out['mission_content'] = content_rows
        out['data_sync_remote_seed_i569'] = {
            'version': 'i569',
            'ots_contract': _I569_OTS_CONTRACT,
            'source': _I569_DISCOVERY_PATH,
            'mission_count': len(mission_rows),
            'objects_after_seed': len(objects),
            'mission_uids_after_seed': len(raw_rows),
            'mission_content_after_seed': len(content_rows),
            'missionuid_discovery_authoritative': True,
            'network_get_contents_calls': 0,
            'password_protected_missions_supported': True,
            'per_user_authenticated_source': True,
        }
        return out
    globals()['_i568_seed_remote_mission_data'] = _i568_seed_remote_mission_data

    def _i568_seed_enrichment_cache(cfg, sess, acquired):
        if '_I545_ENRICH_CACHE' not in globals() or '_I545_ENRICH_LOCK' not in globals() or '_i545_cache_key' not in globals() or '_i545_extract_events' not in globals():
            return False
        marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')
        mission_rows = list(acquired.get('mission_rows') or [])
        responses = acquired.get('responses') if isinstance(acquired.get('responses'), dict) else {}
        combined = {}
        rows = []
        for mission_row in mission_rows:
            mission = _i568_text(mission_row.get('name')) if isinstance(mission_row, dict) else ''
            if not mission:
                continue
            path = '/Marti/api/missions/' + quote(mission, safe='') + '/cot'
            result = responses.get(marti + path) if marti else None
            protected = _i569_password_protected(mission_row)
            ok = bool(isinstance(result, dict) and result.get('ok'))
            body = _i568_result_body(result)
            events = _i545_extract_events(body if not isinstance(body, str) else None, body if isinstance(body, str) else '') if ok else {}
            rows.append({
                'mission': mission,
                'path': path,
                'ok': bool(ok or protected),
                'status': int((result or {}).get('status') or 0) if isinstance(result, dict) else 0,
                'error': '' if protected else (_i568_text((result or {}).get('error')) if isinstance(result, dict) else 'request-missing'),
                'event_count': len(events),
                'query_strategy': 'i569-optional-cot-missionuid-authoritative',
                'password_protected': protected,
                'cot_skipped': bool(protected and not ok),
            })
            for uid, event in dict(events or {}).items():
                candidate = dict(event or {})
                candidate['mission_name'] = mission
                current = combined.get(uid)
                replace = current is None
                if not replace and '_i547_event_rank' in globals():
                    try:
                        replace = _i547_event_rank(candidate) > _i547_event_rank(current)
                    except Exception:
                        replace = False
                if replace:
                    combined[uid] = candidate
        requested = tuple(sorted({_i568_text(row.get('name')).casefold() for row in mission_rows if isinstance(row, dict) and _i568_text(row.get('name'))}))
        record = {
            # The enrichment phase is complete even when a password-protected
            # mission intentionally uses its authoritative MissionUID rows only.
            'ok': True,
            'time': time.time(),
            'requested': requested,
            'events': combined,
            'missions': rows,
            'event_count': len(combined),
            'error': '',
            'refresh_mode_i569': 'optional-cot-missionuid-discovery-authoritative',
        }
        key = _i545_cache_key(cfg or {}, sess or {})
        with _I545_ENRICH_LOCK:
            _I545_ENRICH_CACHE[key] = record
        return True
    globals()['_i568_seed_enrichment_cache'] = _i568_seed_enrichment_cache

    # Do not let the failed i568 empty snapshot survive the upgrade and postpone
    # the corrected discovery for five minutes. Preserve nonempty older snapshots
    # as a display-only LKG while forcing an immediate i569 refresh.
    _i569_load_persisted_before = _i568_load_persisted_state
    def _i568_load_persisted_state(key):
        state = _i569_load_persisted_before(key)
        snapshot = state.get('snapshot') if isinstance(state.get('snapshot'), dict) else None
        if snapshot and not isinstance(snapshot.get('data_sync_background_worker_i569'), dict):
            has_data = bool(snapshot.get('objects') or snapshot.get('mission_uids') or snapshot.get('missions'))
            if has_data:
                state['last_success_epoch'] = 0.0
                state['last_error'] = 'Refreshing a preserved pre-i569 snapshot with the corrected OpenTAKServer Mission contract.'
            else:
                state['snapshot'] = None
                state['last_success_epoch'] = 0.0
                state['last_error'] = 'Discarded the failed empty i568 snapshot; initial i569 OTS refresh is in progress.'
        return state
    globals()['_i568_load_persisted_state'] = _i568_load_persisted_state

    def _i568_persist_success(state):
        try:
            _I568_SNAPSHOT_ROOT.mkdir(parents=True, exist_ok=True)
            atomic_write_json(_i568_snapshot_path(state['key']), {
                'version': 'i569',
                'ots_contract': _I569_OTS_CONTRACT,
                'last_success_epoch': state.get('last_success_epoch') or 0,
                'generation': state.get('generation') or 0,
                'endpoint_timings': list(state.get('endpoint_timings') or [])[:120],
                'acquisition_summary': dict(state.get('acquisition_summary') or {}),
                'snapshot': state.get('snapshot'),
            })
        except Exception as exc:
            state['snapshot_persist_warning'] = _i568_text(exc)
    globals()['_i568_persist_success'] = _i568_persist_success
except Exception as _i569_contract_exc:
    try:
        print('TAK Map i569 exact OpenTAKServer Mission contract correction failed:', _i569_contract_exc)
    except Exception:
        pass
# --- end TAK Map i569 exact OpenTAKServer 1.7.11 Mission contract correction ---


# --- TAK Map i569 package/runtime promotion and background response diagnostics ---
try:
    _I569_ROOT = Path(__file__).resolve().parent

    # Keep the stable i568 snapshot schema for upgrade compatibility, while
    # exposing the current i569 worker state to the browser and diagnostics.
    _i569_response_payload_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i569_response_payload_before(state)
        if not isinstance(payload, dict):
            return payload
        payload = _i568_clone(payload)
        payload['version'] = 'i569'
        diag = dict(payload.get('data_sync_background_i568') or {})
        if diag:
            diag['version'] = 'i569'
            diag['per_user_certificate'] = True
            diag['atak_mission_client'] = True
            diag['thread_context_installed_per_request'] = True
            diag['parsed_json_response_adapter'] = True
            diag['authoritative_discovery'] = '/Marti/api/missions?passwordProtected=true'
            diag['password_protected_discovery_enabled'] = True
            diag['missionuid_discovery_authoritative'] = True
            diag['network_get_contents_calls'] = 0
            payload['data_sync_background_i568'] = dict(diag)
            payload['data_sync_background_i569'] = dict(diag)
        if isinstance(payload.get('data_sync_background_worker_i569'), dict):
            worker = dict(payload['data_sync_background_worker_i569'])
            worker['version'] = 'i569'
            payload['data_sync_background_worker_i569'] = worker
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i569_get_before = Handler.do_GET
    def _i569_do_get(self):
        path = urlparse(self.path).path
        runtime = {
            '/assets/runtime/tak-map-icon-registry-i569.js': (_I569_ROOT / 'assets' / 'tak-map-icon-registry-i569.js', 'application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-popup-localdata-i569.js': (_I569_ROOT / 'assets' / 'tak-map-popup-localdata-i569.js', 'application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-context-sidebar-i569.js': (_I569_ROOT / 'assets' / 'tak-map-context-sidebar-i569.js', 'application/javascript; charset=utf-8'),
        }.get(path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i569-per-user-mission-worker')
        return _i569_get_before(self)
    Handler.do_GET = _i569_do_get

    _i569_package_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i569_package_config_before() or {})
        cfg['tak_map_iteration'] = 'i569'
        cfg['version'] = '1.3.0-i569'
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version':'i569',
            'automatic_poll_seconds':300,
            'browser_request_timeout_seconds':12,
            'background_worker':True,
            'per_user_certificate':True,
            'atak_mission_client':True,
            'thread_context_installed_per_request':True,
            'parsed_json_response_adapter':True,
            'authoritative_discovery':'/Marti/api/missions?passwordProtected=true',
            'password_protected_discovery_enabled':True,
            'missionuid_discovery_authoritative':True,
            'network_get_contents_calls':0,
            'optional_cot_enrichment':True,
            'ots_contract':'OpenTAKServer-1.7.11.post10',
        })
        cfg['data_sync_control'] = control
        startup = dict(cfg.get('startup_architecture_i568') or cfg.get('startup_architecture_i567') or {})
        startup.update({
            'package_version':'i569',
            'icon_registry_runtime':'/assets/runtime/tak-map-icon-registry-i569.js',
            'popup_localdata_runtime':'/assets/runtime/tak-map-popup-localdata-i569.js',
            'context_sidebar_runtime':'/assets/runtime/tak-map-context-sidebar-i569.js',
        })
        cfg['startup_architecture_i569'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i569_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i568', '1.3.0-i569', html)
        html = re.sub(r'TAKDashboard/i568', 'TAKDashboard/i569', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i568', 'TAK-Map/1.3.0 i569', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i569\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i569\2', html)
        html = re.sub(r'tak-map-icon-registry-i\d+\.js', 'tak-map-icon-registry-i569.js', html)
        html = re.sub(r'tak-map-popup-localdata-i\d+\.js', 'tak-map-popup-localdata-i569.js', html)
        html = re.sub(r'tak-map-context-sidebar-i\d+\.js', 'tak-map-context-sidebar-i569.js', html)
        html = re.sub(r'v=1\.3\.0-i568', 'v=1.3.0-i569', html)
        return html

    TAK_MAP_HTML = _i569_patch_html(TAK_MAP_HTML)
    TAK_MAP_LOGIN_HTML = _i569_patch_html(TAK_MAP_LOGIN_HTML)
    TAK_MAP_ITERATION = 'i569'
except Exception as _i569_package_exc:
    try: print('TAK Map i569 package/runtime promotion failed:', _i569_package_exc)
    except Exception: pass
# --- end TAK Map i569 package/runtime promotion and background response diagnostics ---

# --- TAK Map i570 phased per-mission Data Sync and nonblocking point workflow ---
try:
    from concurrent.futures import as_completed as _i570_as_completed

    _I570_ROOT = Path(__file__).resolve().parent
    _I570_MAX_MISSIONS = 100
    _I570_COT_TIMEOUT_SECONDS = 4
    _I570_COT_OVERALL_SECONDS = 14
    _I570_READBACK_DEADLINE_SECONDS = 8
    _I570_READBACK_ATTEMPTS = 4
    _I570_CONFIRM_CACHE_SECONDS = 45
    _I570_CONFIRM_LOCK = threading.RLock()
    _I570_CONFIRM_CACHE = {}

    def _i570_context_session():
        identity = {}
        try:
            identity = dict(getattr(_I512_REQUEST_CONTEXT, 'identity', {}) or {})
        except Exception:
            identity = {}
        auth_mode = ''
        token = ''
        try:
            auth_mode = _i568_text(getattr(_I529_REQUEST_CONTEXT, 'auth_mode', ''))
            token = _i568_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', ''))
        except Exception:
            pass
        return {
            'auth_mode': auth_mode,
            'username': _i568_text(identity.get('username')).lower(),
            'callsign': _i568_text(identity.get('callsign')),
            'tak_uid': _i568_text(identity.get('tak_uid')),
            'profile': dict(identity),
            '_i570_token': token,
        }

    def _i570_context_state_key(cfg=None, sess=None):
        cfg = cfg if isinstance(cfg, dict) else (_i509_load_ots_config() if '_i509_load_ots_config' in globals() else {})
        sess = sess if isinstance(sess, dict) else _i570_context_session()
        return _i568_state_key(cfg or {}, sess or {})

    def _i570_object_key(row):
        if not isinstance(row, dict):
            return ('', '')
        mission = _i568_text(row.get('mission') or row.get('mission_name') or row.get('missionName')).casefold()
        uid = _i555_object_uid(row) if '_i555_object_uid' in globals() else _i568_row_uid(row)
        return mission, _i568_text(uid).casefold()

    def _i570_merge_dict_nonempty(old, new):
        out = _i568_clone(old) if isinstance(old, dict) else {}
        for key, value in (new or {}).items():
            if isinstance(value, dict) and isinstance(out.get(key), dict):
                out[key] = _i570_merge_dict_nonempty(out.get(key), value)
            elif value not in (None, '', [], {}):
                out[key] = _i568_clone(value)
            elif key not in out:
                out[key] = _i568_clone(value)
        return out

    def _i570_merge_snapshot_lkg(snapshot, previous):
        if not isinstance(snapshot, dict) or not isinstance(previous, dict):
            return snapshot
        out = _i568_clone(snapshot)
        current_rows = list(out.get('objects') or [])
        current_membership = set()
        for row in list(out.get('mission_uids') or []) + current_rows:
            key = _i570_object_key(row)
            if key[0] and key[1]:
                current_membership.add(key)
        old_by_key = {}
        for row in list(previous.get('objects') or []):
            key = _i570_object_key(row)
            if key[0] and key[1]:
                old_by_key[key] = row
        merged = []
        seen = set()
        for row in current_rows:
            key = _i570_object_key(row)
            if key in old_by_key:
                row = _i570_merge_dict_nonempty(old_by_key[key], row)
            merged.append(row)
            if key[0] and key[1]:
                seen.add(key)
        # A discovery row can be structurally incomplete even though MissionUID
        # still proves membership. Preserve the exact-UID prior enriched row.
        for key in current_membership:
            if key not in seen and key in old_by_key:
                merged.append(_i568_clone(old_by_key[key]))
        out['objects'] = merged
        out['data_sync_lkg_merge_i570'] = {
            'version': 'i570',
            'exact_uid_membership_only': True,
            'previous_enriched_rows_available': len(old_by_key),
            'current_membership_count': len(current_membership),
            'objects_after_merge': len(merged),
        }
        return out

    # Increase the deployment ceiling while retaining one bounded discovery call.
    _i570_mission_rows_before = _i569_mission_rows
    def _i569_mission_rows(payload):
        if not isinstance(payload, dict):
            return []
        data = payload.get('data')
        if not isinstance(data, list):
            return []
        rows, seen = [], set()
        for value in data:
            if not isinstance(value, dict):
                continue
            name = _i568_text(value.get('name') or value.get('mission_name') or value.get('missionName'))
            if not name or name.casefold() in seen:
                continue
            seen.add(name.casefold())
            row = _i568_clone(value)
            row['name'] = name
            rows.append(row)
            if len(rows) >= _I570_MAX_MISSIONS:
                break
        return rows
    globals()['_i569_mission_rows'] = _i569_mission_rows

    # Phase 1 performs only authoritative discovery. Mission /cot is no longer
    # part of the first publish boundary.
    def _i568_parallel_acquisition(cfg, sess):
        started = time.monotonic()
        marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')
        api = _i568_text((cfg or {}).get('api_url') or (cfg or {}).get('base_url')).rstrip('/')
        token = _i568_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', '')) if '_I529_REQUEST_CONTEXT' in globals() else ''
        if not marti:
            return {'responses': {}, 'mission_names': [], 'mission_rows': [], 'timings': [], 'summary': {
                'version': 'i570', 'phase': 'discovery', 'discovery_ok': False, 'mission_count': 0,
                'error': 'OpenTAKServer Marti URL is not configured.',
                'duration_seconds': round(time.monotonic() - started, 4)}}
        discovery_url = marti + _I569_DISCOVERY_PATH
        deadline = time.monotonic() + _I568_DISCOVERY_TIMEOUT_SECONDS + 0.5
        responses, timings = _i569_run_parallel(
            [(discovery_url, _I569_DISCOVERY_PATH, 'discovery:marti-per-user-include-password-protected', _I568_DISCOVERY_TIMEOUT_SECONDS)],
            cfg, sess, token, deadline, 1)
        discovery = responses.get(discovery_url) or {}
        payload = _i568_result_body(discovery)
        mission_rows = _i569_mission_rows(payload) if discovery.get('ok') else []
        mission_names = [_i568_text(row.get('name')) for row in mission_rows if _i568_text(row.get('name'))]
        responses[marti + '/Marti/api/missions'] = _i568_clone(discovery)
        if api:
            responses[api + '/api/missions'] = _i568_clone(discovery)
        uid_count = 0
        content_count = 0
        protected_count = 0
        for row in mission_rows:
            mission = _i568_text(row.get('name'))
            q = quote(mission, safe='')
            detail_url = marti + '/Marti/api/missions/' + q
            contents_url = detail_url + '/contents'
            cot_url = detail_url + '/cot'
            responses[detail_url] = _i569_result(_i569_mission_payload(row), source='i570-discovery-row-alias', network_request=False)
            responses[contents_url] = _i569_result(_i569_contents_payload(row), source='i570-discovery-contents-alias', network_request=False, endpoint_not_called=True)
            uid_count += len(row.get('uids') or []) if isinstance(row.get('uids'), list) else 0
            content_count += len(row.get('contents') or []) if isinstance(row.get('contents'), list) else 0
            if _i569_password_protected(row):
                protected_count += 1
                responses[cot_url] = _i569_result(None, status=423, ok=False,
                    error='Optional CoT enrichment is unavailable for this password-protected mission.',
                    source='i570-password-protected-cot-skipped', network_request=False,
                    optional_enrichment=True, password_protected=True)
        return {
            'responses': responses,
            'mission_names': mission_names,
            'mission_rows': mission_rows,
            'timings': timings,
            'summary': {
                'version': 'i570', 'phase': 'discovery', 'discovery_ok': bool(discovery.get('ok')),
                'authoritative_discovery': _I569_DISCOVERY_PATH,
                'mission_count': len(mission_names),
                'password_protected_mission_count': protected_count,
                'discovery_mission_uid_count': uid_count,
                'discovery_content_count': content_count,
                'cot_enrichment_attempted_count': 0,
                'cot_enrichment_pending_count': max(0, len(mission_names) - protected_count),
                'network_get_contents_calls': 0,
                'per_user_certificate': True,
                'incremental_publish': True,
                'duration_seconds': round(time.monotonic() - started, 4),
            },
        }
    globals()['_i568_parallel_acquisition'] = _i568_parallel_acquisition

    def _i570_build_from_acquired(cfg, sess, acquired, previous=None, phase='enrichment'):
        _i568_seed_scope_cache(cfg, sess, acquired)
        _i568_seed_enrichment_cache(cfg, sess, acquired)
        _I568_REQUEST_CONTEXT.responses = acquired.get('responses') or {}
        base = _i568_seed_remote_mission_data(tak_map_data_sync(), cfg, acquired)
        result = _i568_augment_before(base, cfg, sess)
        if not isinstance(result, dict):
            raise RuntimeError('Data Sync augmentation returned an invalid response.')
        result = _i568_clone(result)
        result['ok'] = bool(result.get('ok', True))
        result['version'] = 'i570'
        if previous:
            result = _i570_merge_snapshot_lkg(result, previous)
        result['data_sync_background_worker_i570'] = {
            'version': 'i570', 'phase': phase,
            'per_user_certificate': True,
            'incremental_per_mission_publish': True,
            'single_mission_fast_path': True,
            'acquisition': dict(acquired.get('summary') or {}),
            'endpoint_timings': list(acquired.get('timings') or [])[:240],
        }
        return result

    def _i570_publish_state(key, generation, snapshot, acquired, phase, keep_in_flight=True, error=''):
        now = time.time()
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            if int(state.get('generation') or 0) != int(generation):
                return False
            state['snapshot'] = snapshot
            state['last_success_epoch'] = now
            state['last_attempt_completed_epoch'] = now
            state['last_error'] = _i568_text(error)[:1200]
            state['endpoint_timings'] = list(acquired.get('timings') or [])[:240]
            state['acquisition_summary'] = dict(acquired.get('summary') or {})
            state['acquisition_summary']['phase'] = phase
            state['in_flight'] = bool(keep_in_flight)
            _i568_persist_success(state)
        return True

    def _i568_refresh_worker(key, cfg, sess, token, reason, generation):
        started_mono = time.monotonic()
        _i568_set_context(token, sess)
        try:
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                previous = _i568_clone(state.get('snapshot')) if isinstance(state.get('snapshot'), dict) else None
            discovery, acquired = _i568_build_snapshot(cfg, sess, token, reason)
            discovery = _i570_merge_snapshot_lkg(discovery, previous) if previous else discovery
            summary = dict(acquired.get('summary') or {})
            mission_rows = list(acquired.get('mission_rows') or [])
            pending_rows = [row for row in mission_rows if isinstance(row, dict) and not _i569_password_protected(row)]
            summary.update({
                'version': 'i570', 'phase': 'discovery-published',
                'cot_enrichment_pending_count': len(pending_rows),
                'incremental_publish': True,
            })
            acquired['summary'] = summary
            _i570_publish_state(key, generation, discovery, acquired, 'discovery-published', keep_in_flight=bool(pending_rows))
            if not pending_rows:
                return

            marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')
            deadline = time.monotonic() + _I570_COT_OVERALL_SECONDS
            executor = ThreadPoolExecutor(max_workers=max(1, min(_I568_MAX_WORKERS, len(pending_rows))))
            future_map = {}
            completed = 0
            succeeded = 0
            failed = 0
            mission_status = {}
            try:
                for row in pending_rows:
                    mission = _i568_text(row.get('name'))
                    path = '/Marti/api/missions/' + quote(mission, safe='') + '/cot'
                    url = marti + path
                    future_map[executor.submit(_i569_call, cfg, sess, token, url, path, 'mission:' + mission + ':cot', _I570_COT_TIMEOUT_SECONDS)] = (mission, url)
                timeout = max(0.0, deadline - time.monotonic())
                try:
                    iterator = _i570_as_completed(list(future_map), timeout=timeout)
                    for future in iterator:
                        mission, url = future_map[future]
                        completed += 1
                        try:
                            returned_url, result, timing = future.result()
                        except Exception as exc:
                            returned_url = url
                            result = {'ok': False, 'status': 0, 'body': None, 'json': {}, 'error': _i568_text(exc)}
                            timing = {'endpoint': 'mission:' + mission + ':cot', 'url_path': urlparse(url).path,
                                      'ok': False, 'status': 0, 'duration_seconds': None, 'error': _i568_text(exc)[:300]}
                        acquired['responses'][returned_url] = result
                        acquired.setdefault('timings', []).append(timing)
                        if result.get('ok'):
                            succeeded += 1
                            mission_status[mission] = {'state': 'ready', 'ok': True, 'duration_seconds': timing.get('duration_seconds')}
                            current_summary = dict(acquired.get('summary') or {})
                            current_summary.update({
                                'version': 'i570', 'phase': 'mission-enrichment-published',
                                'cot_enrichment_completed_count': completed,
                                'cot_enrichment_success_count': succeeded,
                                'cot_enrichment_failure_count': failed,
                                'cot_enrichment_pending_count': max(0, len(pending_rows) - completed),
                                'mission_status': _i568_clone(mission_status),
                                'last_published_mission': mission,
                            })
                            acquired['summary'] = current_summary
                            enriched = _i570_build_from_acquired(cfg, sess, acquired, previous=discovery, phase='mission-enrichment-published')
                            _i570_publish_state(key, generation, enriched, acquired, 'mission-enrichment-published', keep_in_flight=completed < len(pending_rows))
                            discovery = enriched
                        else:
                            failed += 1
                            mission_status[mission] = {'state': 'last-known-good', 'ok': False,
                                'status': int(result.get('status') or 0), 'error': _i568_text(result.get('error'))[:300]}
                except TimeoutError:
                    pass
                for future, (mission, url) in future_map.items():
                    if future.done():
                        continue
                    future.cancel()
                    failed += 1
                    mission_status[mission] = {'state': 'last-known-good', 'ok': False, 'error': 'enrichment-deadline'}
                    acquired.setdefault('timings', []).append({'endpoint': 'mission:' + mission + ':cot', 'url_path': urlparse(url).path,
                        'ok': False, 'status': 0, 'duration_seconds': None, 'error': 'enrichment-deadline'})
            finally:
                executor.shutdown(wait=False, cancel_futures=True)

            final_summary = dict(acquired.get('summary') or {})
            final_summary.update({
                'version': 'i570', 'phase': 'ready',
                'cot_enrichment_completed_count': completed,
                'cot_enrichment_success_count': succeeded,
                'cot_enrichment_failure_count': failed,
                'cot_enrichment_pending_count': 0,
                'mission_status': _i568_clone(mission_status),
                'duration_seconds': round(time.monotonic() - started_mono, 4),
            })
            acquired['summary'] = final_summary
            warning = '' if not failed else f'{failed} mission CoT enrichment request(s) failed; exact-UID last-known-good data was preserved.'
            _i570_publish_state(key, generation, discovery, acquired, 'ready', keep_in_flight=False, error=warning)
        except Exception as exc:
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                if int(state.get('generation') or 0) == int(generation):
                    state['last_attempt_completed_epoch'] = time.time()
                    state['last_attempt_duration_seconds'] = round(time.monotonic() - started_mono, 4)
                    state['last_error'] = _i568_text(exc)[:1200]
                    state['in_flight'] = False
        finally:
            _i568_clear_context()
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                if int(state.get('generation') or 0) == int(generation):
                    state['last_attempt_duration_seconds'] = round(time.monotonic() - started_mono, 4)
                    if state.get('in_flight') and not (state.get('acquisition_summary') or {}).get('cot_enrichment_pending_count'):
                        state['in_flight'] = False
    globals()['_i568_refresh_worker'] = _i568_refresh_worker

    def _i570_snapshot_find(uid, mission=''):
        uid_folded = _i568_text(uid).casefold()
        mission_folded = _i568_text(mission).casefold()
        if not uid_folded:
            return None
        cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
        sess = _i570_context_session()
        key = _i570_context_state_key(cfg, sess)
        now = time.time()
        with _I570_CONFIRM_LOCK:
            cached = _I570_CONFIRM_CACHE.get((key, mission_folded, uid_folded))
            if cached and now - float(cached.get('time') or 0) <= _I570_CONFIRM_CACHE_SECONDS:
                return _i568_clone(cached.get('row'))
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            snapshot = _i568_clone(state.get('snapshot')) if isinstance(state.get('snapshot'), dict) else None
        for row in list((snapshot or {}).get('objects') or []):
            if not isinstance(row, dict):
                continue
            candidate = _i555_object_uid(row)
            if not candidate or candidate.casefold() != uid_folded:
                continue
            row_mission = _i555_object_mission(row)
            if mission_folded and row_mission and row_mission.casefold() != mission_folded:
                continue
            lat, lon = _i555_object_lat_lon(row)
            if lat is None or lon is None:
                continue
            return row
        return None

    def _i555_find_point(uid, mission='', force=False):
        # force is intentionally ignored: point detail/edit reads never run a
        # full synchronous Data Sync acquisition in i570.
        return _i570_snapshot_find(uid, mission)
    globals()['_i555_find_point'] = _i555_find_point

    def _i570_cache_confirmed_row(mission, uid, row):
        if not isinstance(row, dict):
            return
        key = _i570_context_state_key()
        cache_key = (key, _i568_text(mission).casefold(), _i568_text(uid).casefold())
        with _I570_CONFIRM_LOCK:
            _I570_CONFIRM_CACHE[cache_key] = {'time': time.time(), 'row': _i568_clone(row)}
            stale = [k for k, v in _I570_CONFIRM_CACHE.items() if time.time() - float((v or {}).get('time') or 0) > _I570_CONFIRM_CACHE_SECONDS]
            for stale_key in stale:
                _I570_CONFIRM_CACHE.pop(stale_key, None)

    def _i570_readback_row(result, mission, uid):
        if not isinstance(result, dict) or not result.get('ok'):
            return None
        parsed = _i569_parsed_result(result)
        payload = _i568_result_body(parsed)
        # OTS Mission /cot commonly returns XML in raw body while the generic
        # response adapter also exposes an empty JSON object. Preserve and scan
        # the raw body instead of allowing the empty JSON value to hide it.
        raw_body = result.get('body')
        if raw_body in (None, '', {}, [] ) and isinstance(parsed, dict):
            raw_body = parsed.get('body')
        candidates = []
        try:
            candidates.extend(_i512_mission_api_objects(payload, mission))
        except Exception:
            pass
        try:
            events = _i545_extract_events(payload if isinstance(payload, (dict, list)) else None,
                                           raw_body if isinstance(raw_body, str) else (payload if isinstance(payload, str) else ''))
            event = {}
            for event_key, event_value in dict(events or {}).items():
                if _i568_text(event_key).casefold() == _i568_text(uid).casefold():
                    event = dict(event_value or {})
                    break
            if event:
                event['mission'] = mission
                event['mission_name'] = mission
                event['source'] = 'Mission /cot save read-back i570'
                event['kind'] = 'datasync'
                current = _i570_snapshot_find(uid, mission)
                if current and callable(globals().get('_i545_merge_event')):
                    try:
                        event, _applied, _reason = _i545_merge_event(current, event)
                    except Exception:
                        pass
                marker = _normalize_tak_marker(event, 'mission_api', 'datasync')
                if isinstance(marker, dict):
                    marker.update({'mission': mission, 'mission_name': mission, 'source': 'Mission /cot save read-back i570', 'kind': 'datasync', 'is_mission_object': True})
                    candidates.append(marker)
        except Exception:
            pass
        exact = []
        for row in candidates:
            if not isinstance(row, dict):
                continue
            if _i555_object_uid(row).casefold() != _i568_text(uid).casefold():
                continue
            if callable(globals().get('_i563_delete_event')) and _i563_delete_event(row):
                continue
            exact.append(row)
        if not exact:
            return None
        try:
            exact.sort(key=lambda row: _i547_event_rank(row), reverse=True)
        except Exception:
            pass
        return exact[0]

    def _i528_confirm_readback(mission, uid, creator_uid, server_host=''):
        mission_q = quote(_i568_text(mission), safe='')
        event_uid = _i568_text(uid)
        primary_path = f'/Marti/api/missions/{mission_q}/cot'
        fallback_path = primary_path + '?creatorUid=' + quote(_i568_text(creator_uid), safe='') if _i568_text(creator_uid) else ''
        history = []
        deadline = time.monotonic() + _I570_READBACK_DEADLINE_SECONDS
        fallback_used = False
        for attempt in range(1, _I570_READBACK_ATTEMPTS + 1):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            path = primary_path
            timeout = max(1, min(3, int(remaining + 0.999)))
            result = _ots_mission_api_request(path, method='GET', public_host=server_host, timeout=timeout)
            row = _i570_readback_row(result, mission, event_uid)
            history.append({'attempt': attempt, 'path': path, 'strategy': 'authenticated-user-scope-no-creatorUid',
                'status': int((result or {}).get('status') or 0) if isinstance(result, dict) else 0,
                'ok': bool(isinstance(result, dict) and result.get('ok')), 'exact_uid_present': bool(row),
                'error': _i568_text((result or {}).get('error'))[:300] if isinstance(result, dict) else 'invalid-result'})
            if row:
                _i570_cache_confirmed_row(mission, event_uid, row)
                return {'ok': True, 'source': 'mission-api-get-cot-exact-uid-i570', 'event_uid': event_uid,
                    'path': path, 'attempts': history, 'readback_row_cached': True,
                    'creator_uid_filter_primary': False, 'creator_uid_fallback_used': fallback_used,
                    'mission_uid_row_alone_counts_as_readback': False}
            status = int((result or {}).get('status') or 0) if isinstance(result, dict) else 0
            # Compatibility fallback is used only when the unfiltered endpoint is
            # rejected, never merely because the exact UID has not propagated yet.
            if attempt == 1 and fallback_path and not bool((result or {}).get('ok')) and status in (400, 404, 405, 406, 415, 422):
                remaining = deadline - time.monotonic()
                if remaining > 0:
                    fallback_used = True
                    fallback = _ots_mission_api_request(fallback_path, method='GET', public_host=server_host,
                                                        timeout=max(1, min(3, int(remaining + 0.999))))
                    fallback_row = _i570_readback_row(fallback, mission, event_uid)
                    history.append({'attempt': attempt, 'path': fallback_path, 'strategy': 'compatibility-creatorUid-fallback',
                        'status': int((fallback or {}).get('status') or 0) if isinstance(fallback, dict) else 0,
                        'ok': bool(isinstance(fallback, dict) and fallback.get('ok')), 'exact_uid_present': bool(fallback_row),
                        'error': _i568_text((fallback or {}).get('error'))[:300] if isinstance(fallback, dict) else 'invalid-result'})
                    if fallback_row:
                        _i570_cache_confirmed_row(mission, event_uid, fallback_row)
                        return {'ok': True, 'source': 'mission-api-get-cot-exact-uid-i570', 'event_uid': event_uid,
                            'path': fallback_path, 'attempts': history, 'readback_row_cached': True,
                            'creator_uid_filter_primary': False, 'creator_uid_fallback_used': True,
                            'mission_uid_row_alone_counts_as_readback': False}
            if attempt < _I570_READBACK_ATTEMPTS and deadline - time.monotonic() > 0.35:
                time.sleep(0.35)
        return {'ok': False, 'source': 'mission-api-get-cot-exact-uid-i570', 'event_uid': event_uid,
            'path': primary_path, 'attempts': history, 'creator_uid_filter_primary': False,
            'creator_uid_fallback_used': fallback_used, 'mission_uid_row_alone_counts_as_readback': False,
            'error': 'The exact point UID was not returned by the authenticated Mission GET /cot read-back within the bounded confirmation window. Local Data was retained.'}
    globals()['_i528_confirm_readback'] = _i528_confirm_readback

    _i570_save_before = _i555_save_point
    def _i555_save_point(payload):
        reply, status = _i570_save_before(payload)
        if status == 200 and isinstance(reply, dict) and reply.get('ok'):
            try:
                cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
                sess = _i570_context_session()
                key = _i570_context_state_key(cfg, sess)
                _i568_schedule_refresh(key, cfg or {}, sess or {}, sess.get('_i570_token') or '', 'i570-post-save-mission-refresh', force=True)
            except Exception as exc:
                reply = dict(reply)
                reply['background_refresh_warning_i570'] = _i568_text(exc)
            reply = dict(reply)
            reply['version'] = 'i570'
            reply['point_returned_from_bounded_readback'] = True
            reply['full_snapshot_refresh_background'] = True
        return reply, status
    globals()['_i555_save_point'] = _i555_save_point

    _i570_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i570_response_before(state)
        if not isinstance(payload, dict):
            return payload
        payload = _i568_clone(payload)
        payload['version'] = 'i570'
        diag = dict(payload.get('data_sync_background_i569') or payload.get('data_sync_background_i568') or {})
        diag.update({
            'version': 'i570',
            'incremental_per_mission_publish': True,
            'single_mission_fast_path': True,
            'discovery_publish_precedes_optional_cot': True,
            'point_detail_snapshot_only': True,
            'bounded_unfiltered_save_readback': True,
        })
        payload['data_sync_background_i570'] = diag
        payload['data_sync_background_i569'] = dict(diag)
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i570_get_before = Handler.do_GET
    def _i570_do_get(self):
        parsed = urlparse(self.path)
        runtime = {
            '/assets/runtime/tak-map-icon-registry-i570.js': (_I570_ROOT / 'assets' / 'tak-map-icon-registry-i570.js', 'application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-popup-localdata-i570.js': (_I570_ROOT / 'assets' / 'tak-map-popup-localdata-i570.js', 'application/javascript; charset=utf-8'),
            '/assets/runtime/tak-map-context-sidebar-i570.js': (_I570_ROOT / 'assets' / 'tak-map-context-sidebar-i570.js', 'application/javascript; charset=utf-8'),
        }.get(parsed.path)
        if runtime:
            return _i541_send_file(self, runtime[0], runtime[1], 'i570-phased-data-sync')
        if parsed.path in ('/api/tak-map/data-sync-point-i555', '/api/tak-map/data-sync-point-i556'):
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            _i555_set_request_context(self)
            try:
                query = parse_qs(parsed.query or '')
                uid = _i568_text((query.get('uid') or [''])[0])
                mission = _i568_text((query.get('mission') or [''])[0])
                row = _i570_snapshot_find(uid, mission)
                if row:
                    return self._send_json({'ok': True, 'version': 'i570', 'point': _i555_point_public(row),
                        'source': 'per-user-background-snapshot-i570'})
                cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
                sess = self._tak_map_session() or {}
                key = _i568_state_key(cfg or {}, sess or {})
                state = _i568_state(key)
                with _I568_STATE_LOCK:
                    refreshing = bool(state.get('in_flight'))
                    available = isinstance(state.get('snapshot'), dict)
                status = 202 if refreshing and not available else 404
                return self._send_json({'ok': False, 'version': 'i570',
                    'error': 'Data Sync point snapshot is still refreshing.' if status == 202 else 'Data Sync point not found.',
                    'refreshing': refreshing, 'snapshot_available': available}, status)
            finally:
                _i555_clear_request_context()
        return _i570_get_before(self)
    Handler.do_GET = _i570_do_get

    _i570_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i570_config_before() or {})
        cfg['tak_map_iteration'] = 'i570'
        cfg['version'] = '1.3.0-i570'
        cfg['data_sync_background_i570'] = {
            'version': 'i570',
            'discovery_publish_precedes_optional_cot': True,
            'incremental_per_mission_publish': True,
            'single_mission_fast_path': True,
            'multi_mission_bounded_workers': _I568_MAX_WORKERS,
            'max_missions': _I570_MAX_MISSIONS,
            'per_mission_timeout_seconds': _I570_COT_TIMEOUT_SECONDS,
            'overall_enrichment_deadline_seconds': _I570_COT_OVERALL_SECONDS,
            'exact_uid_lkg_preserved': True,
            'point_detail_snapshot_only': True,
            'save_readback_primary_unfiltered': True,
            'save_readback_deadline_seconds': _I570_READBACK_DEADLINE_SECONDS,
        }
        control = dict(cfg.get('data_sync_control') or {})
        control.update({'version': 'i570', 'browser_followup_fast': True, 'point_detail_snapshot_only': True,
                        'save_readback_primary_unfiltered': True})
        cfg['data_sync_control'] = control
        startup = dict(cfg.get('startup_architecture_i569') or cfg.get('startup_architecture_i568') or {})
        startup.update({'package_version': 'i570',
            'icon_registry_runtime': '/assets/runtime/tak-map-icon-registry-i570.js',
            'popup_localdata_runtime': '/assets/runtime/tak-map-popup-localdata-i570.js',
            'context_sidebar_runtime': '/assets/runtime/tak-map-context-sidebar-i570.js'})
        cfg['startup_architecture_i570'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i570_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i570', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i570', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i570', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i570\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i570\2', html)
        html = re.sub(r'tak-map-icon-registry-i\d+\.js', 'tak-map-icon-registry-i570.js', html)
        html = re.sub(r'tak-map-popup-localdata-i\d+\.js', 'tak-map-popup-localdata-i570.js', html)
        html = re.sub(r'tak-map-context-sidebar-i\d+\.js', 'tak-map-context-sidebar-i570.js', html)
        html = re.sub(r'v=1\.3\.0-i\d+', 'v=1.3.0-i570', html)
        return html

    TAK_MAP_HTML = _i570_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i570_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = 'i570'
except Exception as _i570_exc:
    try: print('TAK Map i570 phased Data Sync patch failed:', _i570_exc)
    except Exception: pass
# --- end TAK Map i570 phased per-mission Data Sync and nonblocking point workflow ---


