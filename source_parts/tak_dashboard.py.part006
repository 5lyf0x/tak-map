    def _i565_patch_html(html):
        if not isinstance(html,str): return html
        html=re.sub(r'1\.3\.0-i564','1.3.0-i565',html)
        html=re.sub(r'TAKDashboard/i564','TAKDashboard/i565',html)
        html=re.sub(r'TAK-Map/1\.3\.0 i564','TAK-Map/1.3.0 i565',html)
        html=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i565\2',html)
        html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i565\2',html)
        html=re.sub(r'<script[^>]+(?:tak-map-icon-registry-i\d+\.js|tak-map-popup-localdata-i\d+\.js|tak-map-context-sidebar-i\d+\.js)[^>]*></script>\s*','',html,flags=re.I)
        if 'takMapStartupLoaderI541' not in html and '/assets/runtime/tak-map-startup-i553.js' not in html:
            return html
        anchor='</body>'
        scripts=(
            '<script id="takMapIconRegistryI565" defer src="/assets/runtime/tak-map-icon-registry-i565.js?v=1.3.0-i565"></script>'
            '<script id="takMapPopupLocalDataI565" defer src="/assets/runtime/tak-map-popup-localdata-i565.js?v=1.3.0-i565"></script>'
            '<script id="takMapContextSidebarI565" defer src="/assets/runtime/tak-map-context-sidebar-i565.js?v=1.3.0-i565"></script>'
        )
        return html.replace(anchor,scripts+anchor)
