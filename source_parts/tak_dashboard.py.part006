        'false_color': {'label': 'False Color · Vegetation', 'group': 'Visual Composites', 'description': 'Near-infrared vegetation composite.'},
        'swir': {'label': 'SWIR Composite', 'group': 'Visual Composites', 'description': 'Short-wave infrared moisture and burn composite.'},
        'ndvi': {'label': 'NDVI', 'group': 'Vegetation', 'description': 'Vegetation vigor and coverage.'},
        'ndre': {'label': 'NDRE', 'group': 'Vegetation', 'description': 'Red-edge chlorophyll and crop-stress index.'},
        'ndmi': {'label': 'NDMI / NDII', 'group': 'Water / Moisture', 'description': 'Vegetation and canopy moisture.'},
        'ndwi': {'label': 'NDWI', 'group': 'Water / Moisture', 'description': 'Open-water index.'},
        'mndwi': {'label': 'MNDWI', 'group': 'Water / Moisture', 'description': 'Modified water index with stronger built-up suppression.'},
        'nbr': {'label': 'NBR / Burn Scar', 'group': 'Fire / Burn', 'description': 'Burned-area and burn-severity index.'},
        'ndsi': {'label': 'NDSI', 'group': 'Snow / Ice', 'description': 'Snow and ice index.'},
        'ndbi': {'label': 'NDBI', 'group': 'Urban / Soil', 'description': 'Built-up area index.'},
        'bare_soil': {'label': 'Bare Soil', 'group': 'Urban / Soil', 'description': 'Bare Soil Index.'},
        'scl': {'label': 'Scene Classification', 'group': 'Quality / Masking', 'description': 'Sentinel-2 L2A scene classes.'},
        'cloud_mask': {'label': 'Cloud Mask', 'group': 'Quality / Masking', 'description': 'Cloud, cirrus, and cloud-shadow mask.'},
        'cloud_probability': {'label': 'Cloud Probability', 'group': 'Quality / Masking', 'description': 'Cloud probability from 0 to 100 percent.'},
    }

    _I535_EVALSCRIPTS = {
        'true_color': r'''//VERSION=3
function clamp01(v){return Math.max(0,Math.min(1,v));}
function setup(){return {input:[{bands:["B02","B03","B04","dataMask"]}],output:{bands:4}};}
function evaluatePixel(s){return [clamp01(2.8*s.B04),clamp01(2.8*s.B03),clamp01(2.8*s.B02),s.dataMask];}''',
        'false_color': r'''//VERSION=3
function clamp01(v){return Math.max(0,Math.min(1,v));}
function setup(){return {input:[{bands:["B03","B04","B08","dataMask"]}],output:{bands:4}};}
function evaluatePixel(s){return [clamp01(2.5*s.B08),clamp01(2.5*s.B04),clamp01(2.5*s.B03),s.dataMask];}''',
        'swir': r'''//VERSION=3
function clamp01(v){return Math.max(0,Math.min(1,v));}
function setup(){return {input:[{bands:["B04","B08","B12","dataMask"]}],output:{bands:4}};}
function evaluatePixel(s){return [clamp01(2.7*s.B12),clamp01(2.7*s.B08),clamp01(2.7*s.B04),s.dataMask];}''',
        'ndvi': r'''//VERSION=3
function idx(a,b){return (a-b)/(a+b+0.000001);} function c(v){if(v<-0.1)return[0.20,0.12,0.08];if(v<0.1)return[0.56,0.38,0.20];if(v<0.3)return[0.86,0.76,0.32];if(v<0.5)return[0.48,0.72,0.24];if(v<0.7)return[0.16,0.52,0.16];return[0.02,0.28,0.08];}
function setup(){return {input:[{bands:["B04","B08","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let x=c(idx(s.B08,s.B04));return[x[0],x[1],x[2],s.dataMask];}''',
        'ndre': r'''//VERSION=3
function idx(a,b){return (a-b)/(a+b+0.000001);} function c(v){if(v<0)return[0.35,0.18,0.12];if(v<0.15)return[0.83,0.67,0.25];if(v<0.3)return[0.58,0.76,0.25];if(v<0.5)return[0.22,0.58,0.18];return[0.02,0.30,0.09];}
function setup(){return {input:[{bands:["B05","B8A","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let x=c(idx(s.B8A,s.B05));return[x[0],x[1],x[2],s.dataMask];}''',
        'ndmi': r'''//VERSION=3
function idx(a,b){return (a-b)/(a+b+0.000001);} function c(v){if(v<-0.3)return[0.45,0.22,0.10];if(v<0)return[0.82,0.65,0.30];if(v<0.2)return[0.56,0.78,0.55];if(v<0.4)return[0.22,0.62,0.72];return[0.05,0.24,0.62];}
function setup(){return {input:[{bands:["B08","B11","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let x=c(idx(s.B08,s.B11));return[x[0],x[1],x[2],s.dataMask];}''',
        'ndwi': r'''//VERSION=3
function idx(a,b){return (a-b)/(a+b+0.000001);} function c(v){if(v<0)return[0.55,0.42,0.25];if(v<0.1)return[0.62,0.76,0.64];if(v<0.3)return[0.30,0.70,0.80];return[0.03,0.30,0.78];}
function setup(){return {input:[{bands:["B03","B08","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let x=c(idx(s.B03,s.B08));return[x[0],x[1],x[2],s.dataMask];}''',
        'mndwi': r'''//VERSION=3
function idx(a,b){return (a-b)/(a+b+0.000001);} function c(v){if(v<0)return[0.63,0.50,0.30];if(v<0.1)return[0.55,0.77,0.70];if(v<0.3)return[0.20,0.70,0.86];return[0.00,0.26,0.72];}
function setup(){return {input:[{bands:["B03","B11","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let x=c(idx(s.B03,s.B11));return[x[0],x[1],x[2],s.dataMask];}''',
        'nbr': r'''//VERSION=3
function idx(a,b){return (a-b)/(a+b+0.000001);} function c(v){if(v<-0.3)return[0.35,0.00,0.05];if(v<0)return[0.75,0.12,0.08];if(v<0.2)return[0.95,0.55,0.14];if(v<0.45)return[0.72,0.78,0.32];return[0.10,0.48,0.16];}
function setup(){return {input:[{bands:["B08","B12","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let x=c(idx(s.B08,s.B12));return[x[0],x[1],x[2],s.dataMask];}''',
        'ndsi': r'''//VERSION=3
function idx(a,b){return (a-b)/(a+b+0.000001);} function c(v){if(v<0)return[0.32,0.32,0.28];if(v<0.2)return[0.35,0.65,0.70];if(v<0.4)return[0.65,0.86,0.92];return[0.95,0.98,1.00];}
function setup(){return {input:[{bands:["B03","B11","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let x=c(idx(s.B03,s.B11));return[x[0],x[1],x[2],s.dataMask];}''',
        'ndbi': r'''//VERSION=3
function idx(a,b){return (a-b)/(a+b+0.000001);} function c(v){if(v<-0.2)return[0.12,0.42,0.58];if(v<0)return[0.35,0.65,0.48];if(v<0.2)return[0.85,0.73,0.43];if(v<0.4)return[0.82,0.35,0.18];return[0.55,0.08,0.08];}
function setup(){return {input:[{bands:["B08","B11","dataMask"]}],output:{bands:4}};} function evaluatePixel(s){let x=c(idx(s.B11,s.B08));return[x[0],x[1],x[2],s.dataMask];}''',
