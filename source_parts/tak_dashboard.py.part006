            creator = _i528_strict_creator()
            if isinstance(creator, dict) and creator.get('ok'):
                return _i555_text(creator.get('uid'))
        except Exception:
            pass
        return ''

    def _i564_cache_mission_token(mission, creator_uid, token, source='atak-response'):
