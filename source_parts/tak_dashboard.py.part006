            'current_decision_applied_to_top_level_and_properties': True,
            'reviewed_aliases_apply_without_atak_resync': True,
            'construction_upgrade_correction': True,
            'howitzer_upgrade_correction': True,
        })
        cfg['data_sync_control'] = control
        mil = dict(cfg.get('milstd2525c') or {})
        mil.update({
            'version': 'i552',
            'reviewed_atak_alias_catalog': 'atak-compatibility-aliases-i552.json',
            'reviewed_sidc_aliases': len(_I552_ALIAS_BY_SIDC),
            'reviewed_cot_type_aliases': len(_I552_ALIAS_BY_COT),
