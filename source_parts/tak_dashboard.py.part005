    _I504_VIEWSHED_SYMMETRIC_CLEANUP = r"""function cleanupViewshedMaskV504(classData,width,height){
 const w=Math.max(0,Number(width)||0),h=Math.max(0,Number(height)||0),input=classData instanceof Uint8ClampedArray?classData:new Uint8ClampedArray(classData||[]);
 if(!w||!h||input.length!==w*h)return {classData:input,changed:0,toVisible:0,toBlocked:0,candidates:0,passes:0,nearRadius:0,maxRayWidth:3};
 let src=new Uint8ClampedArray(input),changed=0,toVisible=0,toBlocked=0,candidates=0,passes=0;
 const cx=(w-1)/2,cy=(h-1)/2,maxRadius=Math.max(1,Math.min(w,h)/2),nearRadius=Math.max(6,Math.round(maxRadius*.04)),maxRayWidth=3;
 function clsAt(a,x,y){x=Math.round(x);y=Math.round(y);return x>=0&&y>=0&&x<w&&y<h?a[y*w+x]:0}
 function sideProfile(a,x,y,tx,ty,sign,own){let same=0,lastX=NaN,lastY=NaN;for(let step=1;step<=maxRayWidth+2;step++){const xx=Math.round(x+tx*step*sign),yy=Math.round(y+ty*step*sign);if(xx===lastX&&yy===lastY)continue;lastX=xx;lastY=yy;const c=clsAt(a,xx,yy);if(c===own){same++;if(same>maxRayWidth)return {same,boundary:own}}else return {same,boundary:c}}return {same,boundary:0}}
 function radialSupport(a,x,y,ux,uy,own){let support=0;for(const sign of [-1,1]){let found=false,lastX=NaN,lastY=NaN;for(let step=1;step<=3;step++){const xx=Math.round(x+ux*step*sign),yy=Math.round(y+uy*step*sign);if(xx===lastX&&yy===lastY)continue;lastX=xx;lastY=yy;if(clsAt(a,xx,yy)===own){found=true;break}}if(found)support++}return support}
 const minRadialSpan=Math.max(6,Math.round(maxRadius*.05)),neighbors=[-1,1,-w,w,-w-1,-w+1,w-1,w+1];
 for(let pass=0;pass<2;pass++){
  const out=new Uint8ClampedArray(src),flip=new Uint8Array(w*h),visited=new Uint8Array(w*h),queue=new Int32Array(w*h);let passChanged=0;
  for(let y=1;y<h-1;y++)for(let x=1;x<w-1;x++){
   const idx=y*w+x,own=src[idx];if(own!==1&&own!==2)continue;
   const dx=x-cx,dy=y-cy,r=Math.hypot(dx,dy);if(r<=nearRadius||r>=maxRadius-.75)continue;
   const ux=dx/r,uy=dy/r,tx=-uy,ty=ux,other=own===1?2:1;
