    def _i461_patch_html(html):
        if not isinstance(html, str):
            return html

        # Advance only the deterministic i460 runtime owner to i461.
        replacements = (
            ('takMapRuntimeMonitorV460','takMapRuntimeMonitorV461'),
            ('takMapAdsbWorkerI460','takMapAdsbWorkerI461'),
            ('__TakMapRuntimeV460','__TakMapRuntimeV461'),
            ('TakMapRuntimeMarkV460','TakMapRuntimeMarkV461'),
            ('TakMapLiveStatusV460','TakMapLiveStatusV461'),
            ('TakMapAdsbWorkerV460','TakMapAdsbWorkerV461'),
            ('takMapRuntimeErrorV460','takMapRuntimeErrorV461'),
            ('tak-map-adsb-v460.js','tak-map-adsb-v461.js'),
            ('runtime-loader-v460','runtime-loader-v461'),
            ("const V='v460'","const V='v461'"),
            ('TAK Map i460 module','TAK Map i461 module'),
            ('1.3.0-i460','1.3.0-i461'),
        )
        for old,new in replacements:
            html = html.replace(old,new)

        # Include the focused UI subsystem in the consolidated diagnostics.
        html = html.replace(
            "replay:replay,liveStatus:w.TakMapLiveStatusV461.diagnostics()",
            "replay:replay,ui:(w.TakMapUiFixesV461&&w.TakMapUiFixesV461.diagnostics?w.TakMapUiFixesV461.diagnostics():null),liveStatus:w.TakMapLiveStatusV461.diagnostics()"
        )

        # Correct the two defects in the legacy hover/pin helper that can leave
        # temporary popups open: popup entry must set hover=true, and delayed
        # layer close must honor that popup-hover state.
        html = html.replace(
            "el.addEventListener('mouseenter',function(){try{layer._takPopupHover=false}catch(_){}})",
            "el.addEventListener('mouseenter',function(){try{layer._takPopupHover=true}catch(_){}})"
        )
        html = html.replace(
            "if(!layer.__v353Hovering&&!layer.__v353PopupPinned&&!layer._takPopupPinned&&!popupEditActive(layer))closeLayerPopup(layer,true)",
            "if(!layer.__v353Hovering&&!layer._takPopupHover&&!layer.__v353PopupPinned&&!layer._takPopupPinned&&!popupEditActive(layer))closeLayerPopup(layer,true)"
        )

        # First render should reflect the new defaults before the settings API
        # loads; saved settings still replace these values during initialization.
        html = _i461_re.sub(
            r'(<input[^>]+id=["\']adsbRadiusMiles["\'][^>]+value=["\'])5(["\'])',
            r'\g<1>10\2', html, count=1, flags=_i461_re.I
        )
        html = html.replace(
            '<option value="follow_map_center">Follow Map Center</option>',
            '<option value="follow_map_center" selected>Follow Map Center</option>',
            1
        )
        html = html.replace(
            '<option value="manual" selected>Manual</option>',
            '<option value="manual">Manual</option>',
            1
        )

        html = _i461_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i461\2', html)
        html = _i461_re.sub(r'(<span class="release-main">)[^<]+(</span>)', r'\g<1>1.3.0\2', html)
        html = html.replace('TAK-Map/1.3.0 i460','TAK-Map/1.3.0 i461').replace('TAKDashboard/i460','TAKDashboard/i461')

        if 'id="takMapUiFixesV461"' not in html:
            if '</body></html>' in html:
                html = html.replace('</body></html>', _i461_ui_script + '</body></html>', 1)
            elif '</body>' in html:
                html = html.replace('</body>', _i461_ui_script + '</body>', 1)
            else:
                html += _i461_ui_script
        return html

    TAK_MAP_HTML = _i461_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    try:
        TAK_MAP_LOGIN_HTML = _i461_re.sub(r'(?:i|v)460', 'i461', TAK_MAP_LOGIN_HTML)
        LOGIN_HTML = _i461_re.sub(r'(?:i|v)460', 'i461', LOGIN_HTML)
    except Exception:
        pass
except Exception as _i461_exc:
    try:
        print('TAK Map i461 UI/defaults patch failed:', _i461_exc)
    except Exception:
        pass
# --- end TAK Map i461 UI/defaults patch ---



# --- TAK Map i462 reliability, popup, wheel zoom, and online tile cache patch ---
try:
    import re as _i462_re

    _i462_prev_default_adsb_settings = _default_adsb_settings
    def _default_adsb_settings():
        out=dict(_i462_prev_default_adsb_settings() or {})
        if 'TAK_DASH_ADSB_RADIUS_MILES' not in os.environ:
            out['radius_miles']=10
        if 'TAK_DASH_ADSB_CENTER_SOURCE' not in os.environ:
            out['center_source']='follow_map_center'
        out.setdefault('settings_version',462)
        return out

    _i462_prev_load_adsb_settings = _load_adsb_settings
    def _load_adsb_settings():
        d=dict(_i462_prev_load_adsb_settings() or {})
        raw={}
        try:
            if TAK_MAP_ADSB_SETTINGS_FILE.exists():
                value=json.loads(TAK_MAP_ADSB_SETTINGS_FILE.read_text())
                if isinstance(value,dict): raw=value
        except Exception:
            raw={}
        explicit=bool(raw.get('center_source_explicit')) or int(raw.get('settings_version') or 0)>=462
        raw_source=str(raw.get('center_source') or '').strip()
        if explicit:
            source=raw_source if raw_source in ('manual','map_center','follow_map_center') else 'follow_map_center'
        else:
            source=raw_source if raw_source in ('map_center','follow_map_center') else 'follow_map_center'
        d['center_source']=source
        if 'radius_miles' not in raw and 'TAK_DASH_ADSB_RADIUS_MILES' not in os.environ:
            d['radius_miles']=10
        d['settings_version']=max(462,int(raw.get('settings_version') or 0))
        d['center_source_explicit']=bool(raw.get('center_source_explicit'))
        return d

    def _save_adsb_settings(payload, session=None, *args, **kwargs):
        payload=payload or {}
        cur=_load_adsb_settings()
        out={}
        try: out['radius_miles']=max(1,min(250,int(round(float(payload.get('radius_miles',cur.get('radius_miles') or 10))))))
        except Exception: out['radius_miles']=int(cur.get('radius_miles') or 10)
        try: out['update_interval_seconds']=max(1,min(300,int(round(float(payload.get('update_interval_seconds',payload.get('update_interval',cur.get('update_interval_seconds') or 5)))))))
        except Exception: out['update_interval_seconds']=int(cur.get('update_interval_seconds') or 5)
        source=str(payload.get('center_source',cur.get('center_source') or 'follow_map_center')).strip()
        if source not in ('manual','map_center','follow_map_center'): source='follow_map_center'
        out['center_source']=source
        out['center_source_explicit']=True
        out['settings_version']=462
        out['center_lat']=_coerce_float(payload.get('center_lat',cur.get('center_lat')))
        out['center_lon']=_coerce_float(payload.get('center_lon',cur.get('center_lon')))
        if out['center_lat'] is not None and not (-90<=out['center_lat']<=90): out['center_lat']=None
        if out['center_lon'] is not None and not (-180<=out['center_lon']<=180): out['center_lon']=None
        try: out['category_filters']=_v270_filter_map(payload.get('category_filters') if 'category_filters' in payload else cur.get('category_filters'))
        except Exception: out['category_filters']=dict(cur.get('category_filters') or {'civil':True,'military':True,'govt':True,'unknown':True})
        out['stale_seconds']=60
        out['source_mode']=str(cur.get('source_mode') or 'airplanes_live_direct')
        out['updated']=datetime.now(timezone.utc).isoformat()
        TAK_MAP_ADSB_SETTINGS_FILE.parent.mkdir(parents=True,exist_ok=True)
        atomic_write_json(TAK_MAP_ADSB_SETTINGS_FILE,out)
        return {'ok':True,'settings':_load_adsb_settings(),'message':'ADS-B settings saved.','source':'airplanes.live'}

    _i462_prev_tak_map_adsb=tak_map_adsb
    def tak_map_adsb(query_settings=None):
        result=_i462_prev_tak_map_adsb(query_settings)
        if isinstance(result,dict):
            result['tak_map_iteration']='i462'
            result['settings']=_load_adsb_settings()
        return result

    TAK_MAP_TILE_CACHE_DIR=DATA_DIR/'tak_map_tile_cache'
    TAK_MAP_TILE_CACHE_MAX_BYTES=max(256*1024*1024,int(os.environ.get('TAK_MAP_TILE_CACHE_MAX_BYTES',str(10*1024*1024*1024)) or 0))
    TAK_MAP_TILE_CACHE_TTL_SECONDS=max(3600,int(os.environ.get('TAK_MAP_TILE_CACHE_TTL_SECONDS',str(30*86400)) or 0))
    TAK_MAP_TILE_CACHE_LOCK=threading.RLock()
    TAK_MAP_TILE_KEY_LOCKS={}
    TAK_MAP_TILE_KEY_LOCK_LAST={}
    TAK_MAP_TILE_CACHE_STATS={'hits':0,'misses':0,'stores':0,'errors':0,'stale_served':0,'interactive_requests':0,'bytes':None,'last_prune':0,'evictions':0,'policy_skips':0,'key_locks':0}

    def _i462_tile_paths(provider,z,x,y):
        safe=re.sub(r'[^A-Za-z0-9_.-]+','-',str(provider or '')).strip('-_.')[:80]
        base=TAK_MAP_TILE_CACHE_DIR/safe/str(int(z))/str(int(x))
        return base/(str(int(y))+'.tile'), base/(str(int(y))+'.json')

    def _i462_tile_lock(key):
        now=time.time()
        with TAK_MAP_TILE_CACHE_LOCK:
            lock=TAK_MAP_TILE_KEY_LOCKS.get(key)
            if lock is None:
                lock=threading.Lock();TAK_MAP_TILE_KEY_LOCKS[key]=lock
            TAK_MAP_TILE_KEY_LOCK_LAST[key]=now
            if len(TAK_MAP_TILE_KEY_LOCKS)>4096:
                for stale_key,last_used in list(TAK_MAP_TILE_KEY_LOCK_LAST.items()):
                    stale_lock=TAK_MAP_TILE_KEY_LOCKS.get(stale_key)
                    if stale_key!=key and now-float(last_used or 0)>300 and stale_lock is not None and not stale_lock.locked():
                        TAK_MAP_TILE_KEY_LOCKS.pop(stale_key,None);TAK_MAP_TILE_KEY_LOCK_LAST.pop(stale_key,None)
                        if len(TAK_MAP_TILE_KEY_LOCKS)<=3072: break
            return lock

    def _i462_upstream_ttl(headers):
        cc=str(headers.get('Cache-Control') or '').lower()
        if 'no-store' in cc or 'private' in cc: return 0
        m=re.search(r'(?:s-maxage|max-age)\s*=\s*(\d+)',cc)
        if m:
            try: return max(60,min(TAK_MAP_TILE_CACHE_TTL_SECONDS,int(m.group(1))))
            except Exception: pass
        return TAK_MAP_TILE_CACHE_TTL_SECONDS

    def _i462_cached_tile(provider,z,x,y,allow_stale=False):
        data_path,meta_path=_i462_tile_paths(provider,z,x,y)
        if not data_path.exists() or not meta_path.exists(): return None
        try:
            meta=json.loads(meta_path.read_text())
            stale=time.time()>float(meta.get('expires_at') or 0)
            if stale and not allow_stale: return None
            data=data_path.read_bytes()
            if not data: return None
            try: os.utime(data_path,None)
            except Exception: pass
            return data,str(meta.get('content_type') or 'image/png'),meta,stale
        except Exception:
            return None

    def _i462_cache_size_scan():
        total=0
        try:
            for fp in TAK_MAP_TILE_CACHE_DIR.rglob('*.tile'):
                try: total+=fp.stat().st_size
                except Exception: pass
        except Exception: pass
        with TAK_MAP_TILE_CACHE_LOCK: TAK_MAP_TILE_CACHE_STATS['bytes']=total
        return total

    def _i462_prune_tile_cache(force=False):
        now=time.time()
        with TAK_MAP_TILE_CACHE_LOCK:
            if not force and now-float(TAK_MAP_TILE_CACHE_STATS.get('last_prune') or 0)<300: return
            TAK_MAP_TILE_CACHE_STATS['last_prune']=now
        total=_i462_cache_size_scan()
        if total<=TAK_MAP_TILE_CACHE_MAX_BYTES: return
        rows=[]
        try:
            for fp in TAK_MAP_TILE_CACHE_DIR.rglob('*.tile'):
                try: rows.append((fp.stat().st_mtime,fp.stat().st_size,fp))
                except Exception: pass
        except Exception: return
        rows.sort(key=lambda v:v[0])
        target=int(TAK_MAP_TILE_CACHE_MAX_BYTES*.90);evicted=0
        for _,size,fp in rows:
            if total<=target: break
            try:
                fp.unlink(missing_ok=True);fp.with_suffix('.json').unlink(missing_ok=True);total-=size;evicted+=1
            except Exception: pass
        with TAK_MAP_TILE_CACHE_LOCK:
            TAK_MAP_TILE_CACHE_STATS['bytes']=max(0,total);TAK_MAP_TILE_CACHE_STATS['evictions']+=evicted

    def _i462_tile_status():
        if TAK_MAP_TILE_CACHE_STATS.get('bytes') is None: _i462_cache_size_scan()
        try: load1=float(os.getloadavg()[0])
        except Exception: load1=0.0
        cpus=max(1,os.cpu_count() or 1)
        with TAK_MAP_TILE_CACHE_LOCK:
            TAK_MAP_TILE_CACHE_STATS['key_locks']=len(TAK_MAP_TILE_KEY_LOCKS)
            current=dict(TAK_MAP_TILE_CACHE_STATS)
        current.update({'ok':True,'version':'i462','directory':str(TAK_MAP_TILE_CACHE_DIR),'max_bytes':TAK_MAP_TILE_CACHE_MAX_BYTES,'ttl_seconds':TAK_MAP_TILE_CACHE_TTL_SECONDS,'load1':load1,'cpu_count':cpus,'provider_policy':'Cache only successful image tiles; honor upstream no-store/private directives.'})
        return current

    def tak_map_online_tile(provider,z,x,y):
        provider=str(provider or '').strip();z=int(z);x=int(x);y=int(y)
        b=_live_basemap_by_id(provider)
        if not b: return None,'text/plain','Unknown online basemap.','miss'
        maxz=int(b.get('maxZoom') or 22);n=1<<z if 0<=z<=24 else 0
        if not n or z>maxz or x<0 or y<0 or x>=n or y>=n: return None,'text/plain','Invalid tile coordinate.','miss'
        key=(provider,z,x,y)
        with TAK_MAP_TILE_CACHE_LOCK: TAK_MAP_TILE_CACHE_STATS['interactive_requests']+=1
        cached=_i462_cached_tile(provider,z,x,y,False)
        if cached:
            with TAK_MAP_TILE_CACHE_LOCK: TAK_MAP_TILE_CACHE_STATS['hits']+=1
            return cached[0],cached[1],'','hit'
        with TAK_MAP_TILE_CACHE_LOCK: TAK_MAP_TILE_CACHE_STATS['misses']+=1
        stale=_i462_cached_tile(provider,z,x,y,True)
        with _i462_tile_lock(key):
            cached=_i462_cached_tile(provider,z,x,y,False)
            if cached:
                with TAK_MAP_TILE_CACHE_LOCK: TAK_MAP_TILE_CACHE_STATS['hits']+=1
                return cached[0],cached[1],'','hit-after-wait'
            url=_tile_url(b.get('url') or '',z,x,y)
            if not url.startswith(('https://','http://')): return None,'text/plain','Unsupported online basemap URL.','error'
            try:
                req=Request(url,headers={'User-Agent':'TAKMap/1.3.0-i462 online-tile-cache','Accept':'image/avif,image/webp,image/apng,image/png,image/jpeg,*/*;q=0.8'})
                with urlopen(req,timeout=12) as resp:
                    status=int(getattr(resp,'status',200) or 200);data=resp.read(8*1024*1024);ctype=str(resp.headers.get('Content-Type') or 'image/png').split(';')[0].strip().lower();ttl=_i462_upstream_ttl(resp.headers)
                if status!=200 or not ctype.startswith('image/') or len(data)<128: raise RuntimeError('Upstream returned an invalid or placeholder tile.')
                if ttl>0:
                    data_path,meta_path=_i462_tile_paths(provider,z,x,y);data_path.parent.mkdir(parents=True,exist_ok=True)
                    tmp=data_path.with_suffix('.tmp-'+secrets.token_hex(4));tmp.write_bytes(data);os.replace(tmp,data_path)
                    atomic_write_json(meta_path,{'provider':provider,'z':z,'x':x,'y':y,'content_type':ctype,'stored_at':time.time(),'expires_at':time.time()+ttl,'source_url':url})
                    with TAK_MAP_TILE_CACHE_LOCK:
                        TAK_MAP_TILE_CACHE_STATS['stores']+=1
                        if TAK_MAP_TILE_CACHE_STATS.get('bytes') is not None: TAK_MAP_TILE_CACHE_STATS['bytes']+=len(data)
                        stores=TAK_MAP_TILE_CACHE_STATS['stores']
                    if (TAK_MAP_TILE_CACHE_STATS.get('bytes') or 0)>TAK_MAP_TILE_CACHE_MAX_BYTES or stores%64==0: threading.Thread(target=_i462_prune_tile_cache,daemon=True).start()
                    return data,ctype,'','stored'
                with TAK_MAP_TILE_CACHE_LOCK: TAK_MAP_TILE_CACHE_STATS['policy_skips']+=1
                return data,ctype,'','policy-no-store'
            except Exception as e:
                with TAK_MAP_TILE_CACHE_LOCK: TAK_MAP_TILE_CACHE_STATS['errors']+=1
                if stale:
                    with TAK_MAP_TILE_CACHE_LOCK: TAK_MAP_TILE_CACHE_STATS['stale_served']+=1
                    return stale[0],stale[1],str(e),'stale'
                return None,'text/plain',str(e),'error'

    _i462_prev_tak_map_config=tak_map_config
    def tak_map_config():
        cfg=_i462_prev_tak_map_config()
        if not isinstance(cfg,dict): return cfg
        rows=[]
        for original in list(cfg.get('basemaps') or []):
            b=dict(original);bid=str(b.get('id') or '')
            if b.get('type')=='xyz' and _live_basemap_by_id(bid):
                b['source_url']=b.get('url') or ''
                b['url']='/api/tak-map/online-tile/'+quote(bid,safe='')+'/{z}/{x}/{y}'
                b['online_tile_cache']=True
            rows.append(b)
        cfg['basemaps']=rows
        cfg['online_tile_cache']={'enabled':True,'max_bytes':TAK_MAP_TILE_CACHE_MAX_BYTES,'ttl_seconds':TAK_MAP_TILE_CACHE_TTL_SECONDS}
        cfg['adsb']=dict(cfg.get('adsb') or {});cfg['adsb']['settings']=_load_adsb_settings();cfg['tak_map_iteration']='i462'
        return cfg

    _i462_prev_get=Handler.do_GET
    def _i462_get(self):
        parsed=urlparse(self.path)
        if parsed.path=='/assets/runtime/tak-map-adsb-v462.js':
            fp=Path(__file__).resolve().parent/'assets'/'tak-map-adsb-v462.js'
            if not fp.exists(): self.send_response(404);self.send_header('Cache-Control','no-store');self.end_headers();return
            body=fp.read_bytes();self.send_response(200);self.send_header('Content-Type','application/javascript; charset=utf-8');self.send_header('Cache-Control','no-store, max-age=0');self.send_header('X-TAK-Map-Module','i462');self.send_header('Content-Length',str(len(body)));self.end_headers()
            if getattr(self,'command','GET')!='HEAD': self.wfile.write(body)
            return
        if parsed.path=='/api/tak-map/tile-cache-status':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            return self._send_json(_i462_tile_status())
        m=_i462_re.match(r'^/api/tak-map/online-tile/([^/]+)/(\d+)/(\d+)/(\d+)$',parsed.path)
        if m:
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            data,ctype,err,state=tak_map_online_tile(unquote(m.group(1)),int(m.group(2)),int(m.group(3)),int(m.group(4)))
            if not data:
                self.send_response(502 if state=='error' else 404);self.send_header('Content-Type','text/plain; charset=utf-8');self.send_header('Cache-Control','no-store');self.send_header('X-TAK-Tile-Cache',state);self.end_headers()
                if getattr(self,'command','GET')!='HEAD': self.wfile.write(str(err or 'Tile unavailable').encode())
                return
            self.send_response(200);self.send_header('Content-Type',ctype);self.send_header('Cache-Control','no-store' if state=='policy-no-store' else ('public, max-age=60' if state=='stale' else 'public, max-age=3600'));self.send_header('X-TAK-Tile-Cache',state);self.send_header('Content-Length',str(len(data)));self.end_headers()
            if getattr(self,'command','GET')!='HEAD': self.wfile.write(data)
            return
        return _i462_prev_get(self)
    Handler.do_GET=_i462_get

