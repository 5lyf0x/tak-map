        old_shape = "layer=L.polygon(pts,{color:'#ffb000',weight:2,fillOpacity:.18}).bindPopup(layerPopupForObject(o,cat)).addTo(group)"
        new_shape = "layer=L.polygon(pts,{color:'#ffb000',weight:2,fillOpacity:.18,bubblingMouseEvents:false}).bindPopup(layerPopupForObject(o,cat),{autoPan:false,keepInView:false,autoClose:false,closeOnClick:false}).addTo(group)"
        if old_route in html:
