    def _i500_patch_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('tak-map-object-lifecycle-v491.js?v=1.3.0-i499', 'tak-map-object-lifecycle-v491.js?v=1.3.0-i500')
        html = html.replace('tak-map-geofencing-v491.js?v=1.3.0-i499', 'tak-map-geofencing-v491.js?v=1.3.0-i500')
        html = html.replace('tak-map-adsb-v491.js?v=1.3.0-i499', 'tak-map-adsb-v491.js?v=1.3.0-i500')
        html = html.replace('1.3.0-i499', '1.3.0-i500').replace('TAKDashboard/i499', 'TAKDashboard/i500').replace('TAK-Map/1.3.0 i499', 'TAK-Map/1.3.0 i500')
        html = _i491_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i500\2', html)
        if 'takMapRouteUiV500' not in html:
            html = html.replace('</body>', _I500_ROUTE_UI+'\n</body>', 1) if '</body>' in html else html+_I500_ROUTE_UI
        return html

    TAK_MAP_HTML = _i500_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
except Exception as _i500_exc:
    try:
        print('TAK Map i500 route UI patch failed:', _i500_exc)
    except Exception:
        pass
# --- end TAK Map i500 themed route save/view/edit patch ---

