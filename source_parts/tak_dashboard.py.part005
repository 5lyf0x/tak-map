  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}
  function setVersion(){try{d.documentElement.dataset.takMapIteration=V;qa('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  function normSource(v){v=String(v||'streamed').toLowerCase();return v==='local'?'local':'streamed'}
  function sourceIsLocal(){return normSource(w.terrain3DElevationSource||localStorage.getItem('takMapTerrainElevationSource'))==='local'}
  function currentViewer(){try{return (typeof terrain3DViewer!=='undefined'&&terrain3DViewer)||w.terrain3DViewer||null}catch(_){return w.terrain3DViewer||null}}
  function status(msg,bad){try{if(typeof w.terrainStatus==='function')w.terrainStatus(msg,!!bad);else{const el=$('terrain3dStatus');if(el)el.textContent=msg||''}}catch(_){} }
  function sourceChip(text){try{const chip=$('terrain3dSourceChip');if(chip)chip.textContent=text}catch(_){} }
  function meshChip(text,bad){try{let chip=$('terrain3dLocalMeshChip');const panel=q('.terrain3d-controls');if(panel&&!chip){chip=d.createElement('div');chip.id='terrain3dLocalMeshChip';chip.className='terrain3d-local-mesh-chip';panel.appendChild(chip)}if(chip){chip.textContent=text||'';chip.classList.toggle('bad',!!bad)}}catch(_){} }
  function setUiSource(v){v=normSource(v);try{w.terrain3DElevationSource=v;localStorage.setItem('takMapTerrainElevationSource',v)}catch(_){}try{const sel=$('terrain3dElevationSource');if(sel&&sel.value!==v)sel.value=v}catch(_){}sourceChip(v==='local'?'Elevation lookup: Local DEM':'Elevation lookup: Streamed');try{const panel=q('.terrain3d-controls');if(panel)panel.classList.toggle('local-elevation-active',v==='local')}catch(_){} }
  function state(){w.takLocalElevation=w.takLocalElevation||{loaded:false,loading:null,tiles:new Map(),meta:[],pendingFiles:[]};if(!(w.takLocalElevation.tiles instanceof Map))w.takLocalElevation.tiles=new Map();if(!Array.isArray(w.takLocalElevation.meta))w.takLocalElevation.meta=[];return w.takLocalElevation}
  function tileArray(t){try{if(!t)return null;let b=t.buffer||t.data||t.values||t.elevations||t.heights||t.samples;if(b instanceof Float32Array)return b;if(b instanceof Float64Array||b instanceof Int16Array||b instanceof Uint16Array||b instanceof Int32Array||b instanceof Uint32Array||b instanceof Array)return Float32Array.from(b);if(b instanceof ArrayBuffer)return new Float32Array(b);if(ArrayBuffer.isView(b))return new Float32Array(b.buffer,b.byteOffset,Math.floor(b.byteLength/4));return null}catch(_){return null}}
  function addTileToState(t,source){try{if(!t||!t.id)return false;const arr=tileArray(t), width=Number(t.width||t.size), height=Number(t.height||t.size);if(!arr||!(width>1&&height>1))return false;t.__v402SourceDb=source||t.__v402SourceDb||'';const st=state();st.tiles.set(String(t.id),t);if(Number.isFinite(Number(t.lat0))&&Number.isFinite(Number(t.lon0)))st.tiles.set('v402|'+String(t.id),t);return true}catch(_){return false}}
  function isDecodedTile(t){try{return !!(t&&tileArray(t)&&Number(t.width||t.size)>1&&Number(t.height||t.size)>1)}catch(_){return false}}
  function tileList(){try{const vals=Array.from((state().tiles||new Map()).values());const seen=new Set(),out=[];vals.forEach(function(t){try{if(!isDecodedTile(t))return;const id=String(t.id||t.name||out.length);if(seen.has(id))return;seen.add(id);out.push(t)}catch(_){}});return out}catch(_){return []}}
  async function knownDbNames(){try{const names=new Set(DB_NAMES);if(indexedDB&&typeof indexedDB.databases==='function'){const dbs=await indexedDB.databases();(dbs||[]).forEach(function(x){const n=String(x&&x.name||'');if(/tak.*local.*elev|local.*elev|elevation/i.test(n))names.add(n)})}return Array.from(names).filter(Boolean)}catch(_){return DB_NAMES.slice()}}
  function openDbReadOnly(name){return new Promise(function(resolve){try{const req=indexedDB.open(name);req.onupgradeneeded=function(){try{req.transaction.abort()}catch(_){}};req.onsuccess=function(){resolve(req.result)};req.onerror=function(){resolve(null)};req.onblocked=function(){resolve(null)}}catch(_){resolve(null)}})}
  function readStore(db,store){return new Promise(function(resolve){const out=[];try{const tx=db.transaction([store],'readonly');const req=tx.objectStore(store).openCursor();req.onsuccess=function(e){const cur=e.target.result;if(cur){out.push(cur.value);cur.continue()}else resolve(out)};req.onerror=function(){resolve(out)};tx.oncomplete=function(){}}catch(_){resolve(out)}})}
  async function loadFromIndexedDb(){let added=0, scanned=[];try{const names=await knownDbNames();for(const name of names){const db=await openDbReadOnly(name);if(!db)continue;try{const stores=Array.from(db.objectStoreNames||[]);for(const store of stores){if(!/tile|raster|elev|dem/i.test(store))continue;const rows=await readStore(db,store);scanned.push({db:name,store:store,rows:rows.length});rows.forEach(function(t){if(addTileToState(t,name+'/'+store))added++})}}catch(_){ }try{db.close()}catch(_){}}const st=state();const tiles=tileList();st.meta=tiles.map(function(t){return {id:t.id,name:t.name,type:t.type||t.sourceType||'Elevation',sourceType:t.sourceType||'',lat0:t.lat0,lon0:t.lon0,lat1:t.lat1,lon1:t.lon1,width:t.width||t.size,height:t.height||t.size,size:t.size||Math.max(Number(t.width)||0,Number(t.height)||0),bytes:t.bytes||0,imported:t.imported||0}});st.loaded=true;st.loading=null;w.__v402LastIndexedDbScan={ts:Date.now(),added:added,tiles:tiles.length,scanned:scanned};return tiles}catch(e){w.__v402LastIndexedDbScan={ts:Date.now(),error:String(e&&e.message||e),added:added,scanned:scanned};return tileList()}}
  async function loadDecodedTiles(force){try{if(typeof w.loadLocalElevationTiles==='function')await w.loadLocalElevationTiles()}catch(e){try{console.warn('v402 local elevation base load failed',e)}catch(_){}}try{const now=Date.now();if(force||!tileList().length||now-lastInventoryLoad>30000){lastInventoryLoad=now;await loadFromIndexedDb()}}catch(e){try{console.warn('v402 IndexedDB local elevation load failed',e)}catch(_){}}try{await ensureProj4()}catch(_){}return tileList()}
  function bboxOf(t){try{let west=Number(t.lon0),east=Number(t.lon1),south=Number(t.lat0),north=Number(t.lat1);if(![west,east,south,north].every(Number.isFinite)&&Array.isArray(t.bbox)&&t.bbox.length>=4){west=Number(t.bbox[0]);south=Number(t.bbox[1]);east=Number(t.bbox[2]);north=Number(t.bbox[3])}if(![west,east,south,north].every(Number.isFinite))return null;west=Math.max(-180,Math.min(180,west));east=Math.max(-180,Math.min(180,east));south=Math.max(-90,Math.min(90,south));north=Math.max(-90,Math.min(90,north));const w0=Math.min(west,east),e0=Math.max(west,east),s0=Math.min(south,north),n0=Math.max(south,north);if(!(e0>w0&&n0>s0))return null;return {west:w0,east:e0,south:s0,north:n0}}catch(_){return null}}
  function pointInBbox(lat,lon,b){lat=Number(lat);lon=Number(lon);if(!b||!Number.isFinite(lat)||!Number.isFinite(lon))return false;const pad=0.000003;return lat>=b.south-pad&&lat<=b.north+pad&&lon>=b.west-pad&&lon<=b.east+pad}
  function tilesForPoint(lat,lon,tiles){return (tiles||tileList()).filter(function(t){return pointInBbox(lat,lon,bboxOf(t))})}
  function loadScriptOnce(src,globalName){return new Promise(function(resolve,reject){try{if(globalName&&w[globalName])return resolve();const old=d.querySelector('script[src="'+src+'"]');if(old){let tries=0;(function wait(){if(!globalName||w[globalName])return resolve();if(++tries>160)return reject(new Error(globalName+' did not become available'));setTimeout(wait,50)})();return}const s=d.createElement('script');s.src=src;s.onload=function(){resolve()};s.onerror=function(){reject(new Error('Could not load '+src))};d.head.appendChild(s)}catch(e){reject(e)}})}
  async function ensureProj4(){try{const needs=tileList().some(function(t){return String(t.crsMode||'').toLowerCase()==='projected'&&t.proj4String});if(needs&&!w.proj4)await loadScriptOnce('/assets/vendor/proj4.js','proj4')}catch(e){try{console.warn('v402 projected local DEM support unavailable',e)}catch(_){}}}
  function invertAffine(A){try{if(!Array.isArray(A)||A.length<6)return null;const a=Number(A[0]),b=Number(A[1]),c=Number(A[2]),d0=Number(A[3]),e=Number(A[4]),f=Number(A[5]);const det=a*e-b*d0;if(!Number.isFinite(det)||Math.abs(det)<1e-24)return null;return [e/det,-b/det,(b*f-e*c)/det,-d0/det,a/det,(d0*c-a*f)/det]}catch(_){return null}}
  function sourceXY(t,lat,lon){try{lat=Number(lat);lon=Number(lon);if(!Number.isFinite(lat)||!Number.isFinite(lon))return null;if(String(t.crsMode||'geographic').toLowerCase()==='projected'&&t.proj4String&&w.proj4){let xy=null;try{xy=w.proj4('EPSG:4326',t.proj4String,[lon,lat])}catch(_){try{xy=w.proj4('WGS84',t.proj4String,[lon,lat])}catch(__){xy=null}}if(!xy)return null;const x=Number(xy[0]),y=Number(xy[1]);return Number.isFinite(x)&&Number.isFinite(y)?[x,y]:null}return [lon,lat]}catch(_){return null}}
  function cleanHeight(v,noData){const n=Number(v);if(!Number.isFinite(n))return NaN;if(noData!=null&&String(noData)!==''&&Number.isFinite(Number(noData))&&Math.abs(n-Number(noData))<1e-6)return NaN;if(n<-12000||n>100000)return NaN;return n}
  function sampleTile(t,lat,lon){try{const arr=tileArray(t);const width=Number(t.width||t.size),height=Number(t.height||t.size);if(!arr||!(width>1&&height>1))return null;const b=bboxOf(t);if(b&&!pointInBbox(lat,lon,b))return null;let col,row;const xy=sourceXY(t,lat,lon);if(!xy)return null;const inv=(Array.isArray(t.invAffine)&&t.invAffine.length>=6)?t.invAffine:invertAffine(t.affine);if(inv){const x=Number(xy[0]),y=Number(xy[1]);col=inv[0]*x+inv[1]*y+inv[2];row=inv[3]*x+inv[4]*y+inv[5]}else if(String(t.crsMode||'geographic').toLowerCase()==='projected'&&t.proj4String&&w.proj4){const x=Number(xy[0]),y=Number(xy[1]);const xMin=Number(t.xMin),xMax=Number(t.xMax),yMin=Number(t.yMin),yMax=Number(t.yMax);if(![x,y,xMin,xMax,yMin,yMax].every(Number.isFinite)||x<xMin||x>xMax||y<yMin||y>yMax)return null;col=(x-xMin)/(xMax-xMin)*(width-1);row=(yMax-y)/(yMax-yMin)*(height-1)}else{if(!b)return null;col=(Number(lon)-b.west)/(b.east-b.west)*(width-1);row=(b.north-Number(lat))/(b.north-b.south)*(height-1)}if(!Number.isFinite(col)||!Number.isFinite(row)||col<0||row<0||col>width-1||row>height-1)return null;const x0=Math.floor(col),y0=Math.floor(row),x1=Math.min(width-1,x0+1),y1=Math.min(height-1,y0+1);const tx=col-x0,ty=row-y0;function val(x,y){return cleanHeight(arr[y*width+x],t.noData)}const v00=val(x0,y0),v10=val(x1,y0),v01=val(x0,y1),v11=val(x1,y1);const vs=[v00,v10,v01,v11].filter(Number.isFinite);if(!vs.length)return null;if(vs.length<4)return vs.reduce(function(a,b){return a+b},0)/vs.length;const a=v00*(1-tx)+v10*tx,b2=v01*(1-tx)+v11*tx,out=a*(1-ty)+b2*ty;return Number.isFinite(out)?out:null}catch(_){return null}}
