.replay-search-i621{display:grid;gap:6px;padding:8px;border:1px solid rgba(169,121,255,.24);border-radius:10px;background:rgba(169,121,255,.045)}.replay-search-head-i621{display:flex;align-items:center;justify-content:space-between;gap:8px}.replay-search-head-i621 b{font-size:.72rem;color:#e4d8ff}.replay-search-head-i621 span{font-size:.61rem;color:#899aa6}.replay-search-row-i621{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px}.replay-search-row-i621 input{min-width:0;width:100%;height:31px;border:1px solid #354556;border-radius:8px;background:#091018;color:#e9f0f5;padding:5px 8px;font-size:.72rem;outline:none}.replay-search-row-i621 input:focus{border-color:rgba(169,121,255,.72);box-shadow:0 0 0 2px rgba(169,121,255,.10)}.replay-search-row-i621 button,.replay-search-nav-i621 button{border:1px solid #465769;border-radius:8px;background:#1d2833;color:#edf3f7;font-weight:850;cursor:pointer}.replay-search-row-i621 button{height:31px;padding:0 10px;font-size:.68rem}.replay-search-row-i621 button:hover:not(:disabled),.replay-search-nav-i621 button:hover:not(:disabled){border-color:#a979ff}.replay-search-row-i621 input:disabled,.replay-search-row-i621 button:disabled,.replay-search-nav-i621 button:disabled{opacity:.42;cursor:not-allowed}.replay-search-status-i621{min-height:15px;color:#9fb1bc;font-size:.63rem;line-height:1.3}.replay-search-status-i621.bad{color:#ffad9f}.replay-search-results-i621{display:grid;gap:5px;max-height:250px;overflow:auto}.replay-search-result-i621{width:100%;text-align:left;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035);color:#e9f0f5;padding:7px 8px;cursor:pointer}.replay-search-result-i621:hover,.replay-search-result-i621.active{border-color:rgba(169,121,255,.58);background:rgba(169,121,255,.10)}.replay-search-result-top-i621{display:flex;justify-content:space-between;gap:8px;align-items:center}.replay-search-result-top-i621 b{font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white