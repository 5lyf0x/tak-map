function buildUidTracks(){replay.tracksByUid.clear();for(const e of replay.events){if(!replay.tracksByUid.has(e.uid))replay.tracksByUid.set(e.uid,[]);replay.tracksByUid.get(e.uid).push(e)}for(const [uid,list] of replay.tracksByUid){list.sort((a,b)=>a.ms-b.ms);const clean=[];let segmentId=0;for(const e of list){const p=clean[clean.length-1];if(p&&p.ms===e.ms&&Math.abs(p.lat-e.lat)<1e-10&&Math.abs(p.lon-e.lon)<1e-10){e.segmentId=p.segmentId;clean[clean.length-1]=e;continue}if(p){const staleEnd=Number.isFinite(p.staleMs)?p.staleMs:(p.ms+90000);if(e.ms>staleEnd)segmentId++}e.segmentId=segmentId;clean.push(e)}replay.tracksByUid.set(uid,clean)}}
