            '/assets/runtime/tak-map-gateway-data-v475.js':'tak-map-gateway-data-v475.js',
            '/assets/runtime/tak-map-sidebar-performance-v475.js':'tak-map-sidebar-performance-v475.js',
        }
        if parsed.path in assets:
