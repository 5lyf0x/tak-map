        html=re.sub(r'<script id="v307ViewshedOpenPatch">.*?</script>','',html,count=1,flags=re.S)
        html=re.sub(r'<script id="v349ViewshedButtonOwnerPatch">.*?</script>','',html,count=1,flags=re.S)
        html=re.sub(
            r"function boot\(\)\{addCss\(\);setIteration\(\);bindViewshed\(\);.*?scheduleViewshedClamp\(false\)\}",
            "function boot(){addCss();setIteration()}",html,count=1,flags=re.S
        )
        html=re.sub(
            r"function boot\(\)\{addCss\(\);setIteration\(\);fixSidebarProduct\(\);bindViewshed\(\);(.*?)patchLeafletAdsbHitbox\(\);hardenExistingAdsbIcons\(\);\}",
            r"function boot(){addCss();setIteration();fixSidebarProduct();\1patchLeafletAdsbHitbox();hardenExistingAdsbIcons();}",html,count=1,flags=re.S
        )
        html=re.sub(
            r"setInterval\(\(\)=>\{setIteration\(\);fixSidebarProduct\(\);hardenExistingAdsbIcons\(\);if\(q\('#viewshedModule\.active'\)\)placeViewshed\(\);(.*?)\},2500\);",
            r"setInterval(()=>{setIteration();fixSidebarProduct();hardenExistingAdsbIcons();\1},2500);",html,count=1,flags=re.S
        )
        loader='<script id="takMapViewshedWindowLoaderV487" src="/assets/runtime/tak-map-viewshed-window-v491.js?v=1.3.0-i491"></script>'
        if 'takMapViewshedWindowLoaderV487' not in html:
            html=html.replace('</body>',loader+'\n</body>',1) if '</body>' in html else html+loader
        return html
    TAK_MAP_HTML=_i491_viewshed_patch_html(TAK_MAP_HTML); INDEX_HTML=TAK_MAP_HTML
