        _html = _re_v414.sub(r"tak-map-v\d+", "tak-map-v414", _html)
        _html = _re_v414.sub(r"(<span[^>]*class=[\"'][^\"']*iteration-(?:chip|marker)[^\"']*[\"'][^>]*>)v\d+(</span>)", r"\1v414\2", _html, flags=_re_v414.I)
        _html = _re_v414.sub(r"(<div[^>]*class=[\"'][^\"']*iteration-marker[^\"']*[\"'][^>]*>)v\d+(</div>)", r"\1v414\2", _html, flags=_re_v414.I)
        _html = _re_v414.sub(r"(<[^>]+data-iteration=[\"'])v\d+([\"'][^>]*>)", r"\1v414\2", _html, flags=_re_v414.I)
        _html = _re_v414.sub(r"(<span[^>]*class=[\"'][^\"']*release-main[^\"']*[\"'][^>]*>)\d+\.\d+\.\d+(</span>)", r"\g<1>1.2.0\g<2>", _html, flags=_re_v414.I)
        _html = _re_v414.sub(r"(<[^>]+data-release=[\"'])\d+\.\d+\.\d+([\"'][^>]*>)", r"\g<1>1.2.0\g<2>", _html, flags=_re_v414.I)
        return _html

    def _tak_v414_add(_html):
        if not isinstance(_html, str):
            return _html
        _html = _re_v414.sub(r"<script[^>]*id=[\"']v413ReleaseVersionPatch[\"'][\s\S]*?</script>", "", _html, flags=_re_v414.I)
        _html = _re_v414.sub(r"<script[^>]*id=[\"']v414AdsbCollapseFixPatch[\"'][\s\S]*?</script>", "", _html, flags=_re_v414.I)
        _html = _tak_v414_versions(_html)
        if 'id="v414AdsbCollapseFixPatch"' not in _html:
            _html = _html.replace('</body>', _v414_script + '\n</body>', 1) if '</body>' in _html else _html + _v414_script
        return _tak_v414_versions(_html)

    for _nm in ("TAK_MAP_HTML","TAK_MAP_LOGIN_HTML","LOGIN_HTML","INDEX_HTML"):
        if _nm in globals():
            globals()[_nm] = _tak_v414_add(globals()[_nm])
    if "_html" in globals():
        globals()["_html"] = _tak_v414_add(globals()["_html"])
except Exception as _e_v414:
    try:
        print("v414 ADS-B collapse fix patch failed", _e_v414)
    except Exception:
        pass
# --- end TAK Map v414 patch ---


# --- TAK Map v415 TAK Gateway Replay Mode integration ---
try:
    import ssl as _ssl_v415
    import urllib.request as _urlreq_v415
    import urllib.error as _urlerr_v415
    import gzip as _gzip_v415

    TAK_MAP_REPLAY_API_URL = os.environ.get('TAK_MAP_REPLAY_API_URL','https://127.0.0.1:9443/api/replay/v1').strip().rstrip('/')
    TAK_MAP_REPLAY_CLIENT_CERT = os.environ.get('TAK_MAP_REPLAY_CLIENT_CERT','/etc/tak-map/replay-client.crt').strip()
    TAK_MAP_REPLAY_CLIENT_KEY = os.environ.get('TAK_MAP_REPLAY_CLIENT_KEY','/etc/tak-map/replay-client.key').strip()
    TAK_MAP_REPLAY_CA_CERT = os.environ.get('TAK_MAP_REPLAY_CA_CERT','/etc/tak-map/replay-ca.crt').strip()
    TAK_MAP_REPLAY_VERIFY_TLS = os.environ.get('TAK_MAP_REPLAY_VERIFY_TLS','true').strip().lower() not in ('0','false','no','off')
    TAK_MAP_REPLAY_TIMEOUT = max(2, min(300, int(os.environ.get('TAK_MAP_REPLAY_TIMEOUT','120') or 120)))

    def _tak_v415_replay_config_status():
        cert=Path(TAK_MAP_REPLAY_CLIENT_CERT)
        key=Path(TAK_MAP_REPLAY_CLIENT_KEY)
        ca=Path(TAK_MAP_REPLAY_CA_CERT)
        configured=bool(TAK_MAP_REPLAY_API_URL and cert.is_file() and key.is_file())
        return {
            'ok':True,
            'configured':configured,
            'api_url':TAK_MAP_REPLAY_API_URL,
            'client_cert_present':cert.is_file(),
            'client_key_present':key.is_file(),
            'ca_cert_present':ca.is_file(),
            'verify_tls':TAK_MAP_REPLAY_VERIFY_TLS,
            'timeout_seconds':TAK_MAP_REPLAY_TIMEOUT,
            'write_back':False,
            'mode':'server-side-proxy',
            'version':'v415',
        }

    def _tak_v415_replay_ssl_context():
        if TAK_MAP_REPLAY_VERIFY_TLS:
            cafile=TAK_MAP_REPLAY_CA_CERT if Path(TAK_MAP_REPLAY_CA_CERT).is_file() else None
            ctx=_ssl_v415.create_default_context(cafile=cafile)
        else:
            ctx=_ssl_v415._create_unverified_context()
        cert=Path(TAK_MAP_REPLAY_CLIENT_CERT)
        key=Path(TAK_MAP_REPLAY_CLIENT_KEY)
        if not cert.is_file() or not key.is_file():
            raise FileNotFoundError('Replay client certificate/key are not configured. See /etc/tak-map.env and docs/REPLAY-MODE.md.')
        ctx.load_cert_chain(str(cert),str(key))
        return ctx

    def _tak_v415_replay_proxy(handler, endpoint, query=''):
        endpoint=str(endpoint or '').strip('/')
        allowed={'health','capabilities','periods','manifest','events','chunk','search','state'}
        if endpoint not in allowed:
            return handler._send_json({'ok':False,'error':'Unsupported Replay API endpoint.'},404)
        try:
            status=_tak_v415_replay_config_status()
            if not status.get('configured'):
                return handler._send_json({'ok':False,'configured':False,'error':status.get('configuration_error') or 'Replay API is not configured.','config':status},503)
            url=TAK_MAP_REPLAY_API_URL+'/'+endpoint
            if query:
                url += '?' + query
            req=_urlreq_v415.Request(url,headers={'Accept':'application/json, application/x-ndjson','User-Agent':'TAK-Map/1.3.0-v441-Replay'})
            with _urlreq_v415.urlopen(req,context=_tak_v415_replay_ssl_context(),timeout=TAK_MAP_REPLAY_TIMEOUT) as resp:
                body=resp.read()
                code=int(getattr(resp,'status',200) or 200)
                ctype=str(resp.headers.get('Content-Type') or 'application/octet-stream')
                cenc=str(resp.headers.get('Content-Encoding') or '')
                if endpoint=='chunk':
                    handler.send_response(code)
                    handler.send_header('Content-Type',ctype)
                    if cenc: handler.send_header('Content-Encoding',cenc)
                    handler.send_header('Cache-Control','no-store')
                    handler.send_header('Content-Length',str(len(body)))
                    for h in ('X-TAKGW-Chunk-ID','X-TAKGW-Chunk-Start','X-TAKGW-Chunk-End','X-TAKGW-Sources'):
                        v=resp.headers.get(h)
                        if v: handler.send_header(h,v)
                    handler.end_headers(); handler.wfile.write(body); return
                try:
                    data=json.loads(body.decode('utf-8','replace'))
                except Exception:
                    return handler._send_json({'ok':False,'error':'Replay API returned invalid JSON.','status':code,'content_type':ctype},502)
                return handler._send_json(data,code)
        except _urlerr_v415.HTTPError as exc:
            try: detail=json.loads(exc.read().decode('utf-8','replace'))
            except Exception: detail={'ok':False,'error':str(exc)}
            return handler._send_json(detail,int(exc.code or 502))
        except Exception as exc:
            return handler._send_json({'ok':False,'error':'Replay API proxy failed: '+str(exc),'configured':_tak_v415_replay_config_status().get('configured',False)},502)

    _v415_prev_get=Handler.do_GET
    def _v415_get(self):
        parsed=urlparse(self.path)
        if parsed.path=='/api/tak-map/replay/config':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            return self._send_json(_tak_v415_replay_config_status())
        m=re.match(r'^/api/tak-map/replay/(health|capabilities|periods|manifest|events|chunk|search|state)$',parsed.path)
        if m:
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            return _tak_v415_replay_proxy(self,m.group(1),parsed.query or '')
        return _v415_prev_get(self)
    Handler.do_GET=_v415_get

    _v415_script=r'''<script id="v415ReplayModeIntegrationPatch">
(function(){
'use strict';
const V='i442',RELEASE='1.3.0',d=document,w=window;
const replay={mode:'live',map:null,layer:null,trailLayer:null,events:[],index:0,currentMs:0,startMs:0,endMs:0,periodEndMs:0,eventEndMs:0,loadedFromMs:0,loadedUntilMs:0,playing:false,buffering:false,resumeAfterBuffer:false,loading:false,loadComplete:false,loadToken:0,seekGeneration:0,seeking:false,seenRecords:new Set(),speed:1,timer:null,raf:null,lastFrameAt:0,lastUiAt:0,playAnchorReal:0,playAnchorReplay:0,lastHeadingSecond:-1,markers:new Map(),latest:new Map(),tracked:new Map(),followUid:'',period:null,config:null,sources:new Set(),selectedSources:new Set(),tracksByUid:new Map(),fetchOriginal:null,liveState:null,base:null,baseId:'',activePopupUid:'',activePopup:null};
const replayPopupDiag={clicks:0,openAttempts:0,opens:0,closes:0,rebinds:0,handlerBinds:0,mapCloses:0,forcedResets:0,lastClickUid:'',lastOpenUid:'',lastCloseUid:'',lastCloseSource:'',lastError:''};
const replaySearchI621={results:[],selectedIndex:-1,occurrenceIndex:0,busy:false,requestToken:0,lastQuery:''};
const replayJumpI624={busy:false,editing:false,lastTargetMs:0,lastSource:''};
function $(id){return d.getElementById(id)}
function q(s,r){return (r||d).querySelector(s)}
function qa(s,r){return Array.from((r||d).querySelectorAll(s))}
function setReplayMenuStack(wrap,open){if(!wrap)return;wrap.classList.toggle('menu-open-v436',!!open);const field=wrap.closest('.replay-select-field-v433');if(field){field.classList.remove('period-menu-open-v436','speed-menu-open-v436');if(open)field.classList.add(wrap.classList.contains('period-select-v436')?'period-menu-open-v436':'speed-menu-open-v436')}}function closeReplayCustomMenus(except){qa('.replay-custom-menu-v434.open').forEach(m=>{if(m!==except){m.classList.remove('open');const b=m.previousElementSibling;if(b)b.setAttribute('aria-expanded','false');setReplayMenuStack(m.closest('.replay-select-wrap-v433'),false)}})}
function refreshReplayCustomSelect(id){const sel=$(id);if(!sel)return;const wrap=sel.closest('.replay-select-wrap-v433');if(!wrap)return;wrap.classList.add('custom-v434',id==='replayPeriodV415'?'period-select-v436':'speed-select-v436');let trigger=wrap.querySelector('.replay-custom-trigger-v434'),menu=wrap.querySelector('.replay-custom-menu-v434');if(!trigger){trigger=d.createElement('button');trigger.type='button';trigger.className='replay-custom-trigger-v434';trigger.setAttribute('aria-haspopup','listbox');trigger.setAttribute('aria-expanded','false');wrap.appendChild(trigger);menu=d.createElement('div');menu.className='replay-custom-menu-v434';menu.setAttribute('role','listbox');wrap.appendChild(menu);trigger.onclick=e=>{e.preventDefault();e.stopPropagation();const opening=!menu.classList.contains('open');closeReplayCustomMenus(menu);menu.classList.toggle('open',opening);setReplayMenuStack(wrap,opening);trigger.setAttribute('aria-expanded',opening?'true':'false');if(opening){const a=menu.querySelector('.active');if(a)a.focus({preventScroll:true})}};trigger.onkeydown=e=>{if(e.key==='ArrowDown'||e.key==='Enter'||e.key===' '){e.preventDefault();if(!menu.classList.contains('open'))trigger.click();else{const a=menu.querySelector('.active')||menu.querySelector('button');if(a)a.focus()}}else if(e.key==='Escape'){menu.classList.remove('open');setReplayMenuStack(wrap,false);trigger.setAttribute('aria-expanded','false')}}}
const opts=[...sel.options];const chosen=opts[sel.selectedIndex]||opts[0];trigger.textContent=chosen?chosen.textContent:'';trigger.disabled=!!sel.disabled;menu.innerHTML='';opts.forEach((o,i)=>{const b=d.createElement('button');b.type='button';b.className='replay-custom-option-v434'+(i===sel.selectedIndex?' active':'');b.textContent=o.textContent;b.disabled=!!o.disabled;b.setAttribute('role','option');b.setAttribute('aria-selected',i===sel.selectedIndex?'true':'false');b.onclick=e=>{e.preventDefault();e.stopPropagation();if(b.disabled)return;sel.selectedIndex=i;trigger.textContent=o.textContent;menu.classList.remove('open');setReplayMenuStack(wrap,false);trigger.setAttribute('aria-expanded','false');sel.dispatchEvent(new Event('change',{bubbles:true}));refreshReplayCustomSelect(id);trigger.focus()};b.onkeydown=e=>{const items=[...menu.querySelectorAll('button:not([disabled])')],n=items.indexOf(b);if(e.key==='ArrowDown'){e.preventDefault();items[Math.min(items.length-1,n+1)]?.focus()}else if(e.key==='ArrowUp'){e.preventDefault();items[Math.max(0,n-1)]?.focus()}else if(e.key==='Escape'){e.preventDefault();menu.classList.remove('open');setReplayMenuStack(wrap,false);trigger.setAttribute('aria-expanded','false');trigger.focus()}};menu.appendChild(b)})}
function initReplayCustomSelects(){refreshReplayCustomSelect('replayPeriodV415');refreshReplayCustomSelect('replaySpeedV415');if(!d.documentElement.dataset.replayCustomSelectV434){d.documentElement.dataset.replayCustomSelectV434='1';d.addEventListener('click',()=>closeReplayCustomMenus());d.addEventListener('keydown',e=>{if(e.key==='Escape')closeReplayCustomMenus()})}}
function esc(s){return String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c))}
function fmtTime(ms){if(!Number.isFinite(ms))return'—';return new Date(ms).toLocaleString([],{year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit'})}
function fmtPeriodDate(ms){if(!Number.isFinite(ms))return'—';try{return new Intl.DateTimeFormat(undefined,{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(ms))}catch(_){const x=new Date(ms);return String(x.getMonth()+1).padStart(2,'0')+'/'+String(x.getDate()).padStart(2,'0')+'/'+x.getFullYear()}}
function fmtPeriodTime(ms){if(!Number.isFinite(ms))return'—';try{return new Intl.DateTimeFormat(undefined,{hour:'numeric',minute:'2-digit'}).format(new Date(ms))}catch(_){return new Date(ms).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}}
function fmtDuration(sec){sec=Math.max(0,Math.round(Number(sec)||0));const h=Math.floor(sec/3600),m=Math.floor((sec%3600)/60),s=sec%60;return(h?h+'h ':'')+(m?m+'m ':'')+s+'s'}
function setStatus(text,good,normalWeight){const el=$('replayApiStatusV415');if(el){el.textContent=text;el.className='replay-api-status-v415 '+(good?'ok':'bad')+(normalWeight?' normal-weight':'')}}
function sourceLabel(s){return({eud_pli:'EUD PLI',adsb:'ADS-B',ais:'AIS',usgs:'USGS',nws:'NWS',nifc:'NIFC',firms:'NASA FIRMS',nhc:'NHC'})[s]||s||'Gateway'}
function setReplayPlayIcon(paused){const b=$('replayPlayV415');if(!b)return;b.setAttribute('aria-label',paused?'Play':'Pause');b.innerHTML=paused?'<span class="replay-icon-v433 replay-play-icon-v433"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>':'<span class="replay-icon-v433 replay-pause-icon-v433"><svg viewBox="0 0 24 24"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg></span>'}
function addCss(){if($('v415ReplayStyle'))return;const st=d.createElement('style');st.id='v415ReplayStyle';st.textContent=`
#replayMapV415{position:fixed;inset:86px 0 0 396px;z-index:22;background:#071018;display:none}.replay-mode-v415 #map{display:none!important}.replay-mode-v415 #replayMapV415{display:block}.replay-mode-v415 .floating-map-toolbar{display:none!important}.replay-mode-v415 #mapStatusBanner,.replay-mode-v415 #statusDropdown{display:none!important}
