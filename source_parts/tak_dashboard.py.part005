.replay-mode-toggle-v415{display:inline-flex;align-items:center;gap:11px}.replay-mode-toggle-v415 input{position:absolute;opacity:0;pointer-events:none;width:1px;height:1px}.replay-industrial-v415{width:108px;height:36px;position:relative;display:inline-block;cursor:pointer}.replay-industrial-v415 .rail{position:absolute;inset:0;border-radius:8px;background:repeating-linear-gradient(135deg,rgba(255,255,255,.045) 0 2px,transparent 2px 6px),linear-gradient(180deg,#1b2531,#0b0f15);border:1px solid rgba(255,255,255,.14);box-shadow:inset 0 2px 8px rgba(0,0,0,.8),0 9px 18px rgba(0,0,0,.45)}.replay-industrial-v415 .rail:before,.replay-industrial-v415 .rail:after{position:absolute;top:10px;font-size:9px;font-weight:900;letter-spacing:.08em}.replay-industrial-v415 .rail:before{content:'LIVE';left:8px;color:rgba(255,208,176,.85)}.replay-industrial-v415 .rail:after{content:'REPLAY';right:8px;color:rgba(221,197,255,.68)}.replay-industrial-v415 .block{position:absolute;top:4px;left:5px;width:44px;height:28px;border-radius:6px;background:linear-gradient(180deg,#596474,#222a36 54%,#111822);border:1px solid rgba(255,255,255,.2);box-shadow:0 5px 12px rgba(0,0,0,.65),inset 0 1px 0 rgba(255,255,255,.18);transition:transform .18s ease}.replay-industrial-v415 .block:after{content:'';position:absolute;left:11px;right:11px;top:7px;bottom:7px;border-left:1px solid rgba(255,255,255,.22);border-right:1px solid rgba(255,255,255,.22)}.replay-mode-toggle-v415 input:checked~.replay-industrial-v415 .block{transform:translateX(54px)}
