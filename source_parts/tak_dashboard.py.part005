        for old,new in replacements:html=html.replace(old,new)
        html=_i475_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i475\2',html)
        html=html.replace('<div class="panel"><h2>External Sources</h2><div id="externalRows"></div></div>','')
        if 'id="gatewayDataPanelV475"' not in html:
            marker='<div class="panel"><h2>Data Sync</h2>'
            if marker in html:html=html.replace(marker,gateway_card+marker,1)
        # Ensure the retired panel cannot survive an alternate formatting path.
        html=_i475_re.sub(r'<div class="panel"><h2>External Sources</h2><div id="externalRows"></div></div>','',html,count=1)
        loader='<script id="takMapGatewayDataLoaderV475" src="/assets/runtime/tak-map-gateway-data-v475.js?v=1.3.0-i475"></script>'
        if 'takMapGatewayDataLoaderV475' not in html:
            html=html.replace('</body>',loader+'\n</body>',1) if '</body>' in html else html+loader
        perf_loader='<script id="takMapSidebarPerformanceLoaderV475" src="/assets/runtime/tak-map-sidebar-performance-v475.js?v=1.3.0-i475"></script>'
        if 'takMapSidebarPerformanceLoaderV475' not in html:
            html=html.replace('</body>',perf_loader+'\n</body>',1) if '</body>' in html else html+perf_loader
        return html

    TAK_MAP_HTML=_i475_patch_html(TAK_MAP_HTML);INDEX_HTML=TAK_MAP_HTML
    try:
        TAK_MAP_LOGIN_HTML=TAK_MAP_LOGIN_HTML.replace('i466','i475')
        LOGIN_HTML=LOGIN_HTML.replace('i466','i475')
    except Exception:pass
except Exception as _i475_exc:
    try:print('TAK Map i475 Gateway Data patch failed:',_i475_exc)
    except Exception:pass
# --- end TAK Map i475 Gateway Data integration ---


# --- TAK Map i475 Gateway Data resilience, popups, micro-labels, whole zoom ---
try:
    import time as _time_i475
    import socket as _socket_i475
    import http.client as _http_client_i475
    import threading as _threading_i475

    # Preserve the already-installed i475 baseline wrappers before layering
    # startup resilience and whole-zoom support. Unique alias names avoid
    # rebinding closure globals used by the baseline Handler wrapper.
    _i475_base_gateway_data_config=_i475_gateway_data_config
    _i475_resilience_prev_config=tak_map_config
    _i475_resilience_prev_get=Handler.do_GET

    _i475_gateway_ssl_cache={'key':None,'ctx':None,'builds':0,'reuses':0}
    _i475_gateway_ssl_lock=_threading_i475.Lock()

    def _i475_file_signature(path_value):
        try:
            p=Path(path_value)
            st=p.stat()
            return (str(p),int(st.st_mtime_ns),int(st.st_size))
        except Exception:
            return (str(path_value),'missing',0)

    def _i475_gateway_ssl_context():
        cache_key=(
            bool(TAK_MAP_REPLAY_VERIFY_TLS),
            _i475_file_signature(TAK_MAP_REPLAY_CLIENT_CERT),
            _i475_file_signature(TAK_MAP_REPLAY_CLIENT_KEY),
            _i475_file_signature(TAK_MAP_REPLAY_CA_CERT),
        )
        with _i475_gateway_ssl_lock:
            if _i475_gateway_ssl_cache.get('ctx') is not None and _i475_gateway_ssl_cache.get('key')==cache_key:
                _i475_gateway_ssl_cache['reuses']+=1
                return _i475_gateway_ssl_cache['ctx'],True
            ctx=_tak_v415_replay_ssl_context()
            _i475_gateway_ssl_cache.update({'key':cache_key,'ctx':ctx,'builds':_i475_gateway_ssl_cache.get('builds',0)+1})
            return ctx,False

    def _i475_gateway_error_parts(exc):
        reason=getattr(exc,'reason',None)
        detail=str(reason if reason is not None else exc)
        name=type(reason if reason is not None else exc).__name__
        return name,detail

    def _i475_gateway_transient(exc):
        if isinstance(exc,_urlerr_v415.HTTPError):
            return int(getattr(exc,'code',0) or 0) in (502,503,504)
        reason=getattr(exc,'reason',exc)
        if isinstance(reason,(_socket_i475.timeout,TimeoutError,ConnectionError,ConnectionRefusedError,ConnectionResetError,BrokenPipeError,_http_client_i475.RemoteDisconnected)):
            return True
        text=str(reason).lower()
        return any(token in text for token in ('timed out','timeout','connection refused','connection reset','remote end closed','remote disconnected','temporarily unavailable','urlopen error'))

    def _i475_gateway_data_config():
        out=dict(_i475_base_gateway_data_config() or {})
        out.update({
            'version':'i475',
            'startup_retry_delays_seconds':[1.5,3,6],
            'backend_transient_retry':True,
            'ssl_context_cached':True,
            'ssl_context_builds':int(_i475_gateway_ssl_cache.get('builds',0)),
            'ssl_context_reuses':int(_i475_gateway_ssl_cache.get('reuses',0)),
        })
        return out

    def _i475_gateway_data_proxy(handler,endpoint,query=''):
        endpoint=str(endpoint or '').strip('/')
        if endpoint not in {'health','capabilities','snapshot'}:
            return handler._send_json({'ok':False,'error':'Unsupported Gateway Data endpoint.'},404)
        cfg=_i475_gateway_data_config()
        if not cfg.get('configured'):
            return handler._send_json({'ok':False,'configured':False,'error':cfg.get('configuration_error') or 'Gateway Data API is not configured.','config':cfg},503)
        url=cfg['api_url'].rstrip('/')+'/'+endpoint
        if query:url+='?'+query
        last_exc=None
        for attempt in range(1,3):
            try:
                ctx,reused=_i475_gateway_ssl_context()
                req=_urlreq_v415.Request(url,headers={'Accept':'application/json','User-Agent':'TAK-Map/1.3.0-i475 Gateway-Data'})
                with _urlreq_v415.urlopen(req,context=ctx,timeout=TAK_MAP_GATEWAY_DATA_TIMEOUT) as resp:
                    body=resp.read(32*1024*1024)
                    code=int(getattr(resp,'status',200) or 200)
                    try:data=json.loads(body.decode('utf-8','replace'))
                    except Exception:return handler._send_json({'ok':False,'error':'Gateway Data API returned invalid JSON.','error_class':'InvalidJSON','status':code},502)
                    if isinstance(data,dict):
                        data['_tak_map_proxy']={
                            'version':'i475','attempts':attempt,'ssl_context_reused':bool(reused),
                            'ssl_context_builds':int(_i475_gateway_ssl_cache.get('builds',0)),
                            'ssl_context_reuses':int(_i475_gateway_ssl_cache.get('reuses',0)),
                        }
                    return handler._send_json(data,code)
            except _urlerr_v415.HTTPError as exc:
                last_exc=exc
                if attempt==1 and _i475_gateway_transient(exc):
                    _time_i475.sleep(.6)
                    continue
                try:detail=json.loads(exc.read().decode('utf-8','replace'))
                except Exception:detail={'ok':False,'error':str(exc)}
                if isinstance(detail,dict):
                    name,text=_i475_gateway_error_parts(exc)
                    detail.setdefault('error_class',name);detail.setdefault('error_detail',text)
                return handler._send_json(detail,int(exc.code or 502))
            except Exception as exc:
                last_exc=exc
                if attempt==1 and _i475_gateway_transient(exc):
                    _time_i475.sleep(.6)
                    continue
                break
        name,detail=_i475_gateway_error_parts(last_exc or RuntimeError('unknown Gateway Data proxy error'))
        return handler._send_json({
            'ok':False,
            'error':'Gateway Data API proxy failed: '+detail,
            'error_class':name,
            'error_detail':detail,
            'configured':cfg.get('configured',False),
            'attempts':2,
        },502)

    def tak_map_config():
        cfg=_i475_resilience_prev_config()
        if isinstance(cfg,dict):
            cfg['tak_map_iteration']='i475'
            gd=dict(cfg.get('gateway_data') or {})
            gd.update({
                'version':'i475','poll_interval_seconds':300,'manual_refresh':True,
                'startup_retries':True,'popup_mode':'click-only-no-autopan',
                'micro_labels':True,'micro_label_min_zoom':8,'ais_micro_labels':False,
                'whole_number_zoom':True,
                'canonical_object_popups':True,'themed_popup_scrollbars':True,
                'header_enable_toggles':['adsb','gateway_data','satellite_tracking'],
                'satellite_update_stepper_themed':True,
            })
            cfg['gateway_data']=gd
        return cfg

    def _i475_resilience_get(self):
        parsed=urlparse(self.path)
        assets={
            '/assets/runtime/tak-map-adsb-v475.js':'tak-map-adsb-v475.js',
            '/assets/runtime/tak-map-live-interpolation-v475.js':'tak-map-live-interpolation-v475.js',
            '/assets/runtime/tak-map-local-elevation-boundary-v475.js':'tak-map-local-elevation-boundary-v475.js',
            '/assets/runtime/tak-map-gateway-data-v475.js':'tak-map-gateway-data-v475.js',
            '/assets/runtime/tak-map-sidebar-performance-v475.js':'tak-map-sidebar-performance-v475.js',
            '/assets/runtime/tak-map-whole-zoom-v475.js':'tak-map-whole-zoom-v475.js',
            '/assets/runtime/tak-map-card-controls-v475.js':'tak-map-card-controls-v475.js',
        }
        if parsed.path in assets:
            fp=Path(__file__).resolve().parent/'assets'/assets[parsed.path]
            if not fp.exists():
                self.send_response(404);self.send_header('Cache-Control','no-store');self.end_headers();return
            body=fp.read_bytes();self.send_response(200)
            self.send_header('Content-Type','application/javascript; charset=utf-8')
            self.send_header('Cache-Control','no-store, max-age=0')
            self.send_header('X-TAK-Map-Module','i475')
            self.send_header('Content-Length',str(len(body)));self.end_headers()
            if getattr(self,'command','GET')!='HEAD':self.wfile.write(body)
            return
        if parsed.path=='/api/tak-map/gateway-data/config':
            if not self._tak_map_auth_ok():return self._require_tak_map_login()
            return self._send_json(_i475_gateway_data_config())
        m=_i475_re.match(r'^/api/tak-map/gateway-data/(health|capabilities|snapshot)$',parsed.path)
        if m:
            if not self._tak_map_auth_ok():return self._require_tak_map_login()
            return _i475_gateway_data_proxy(self,m.group(1),parsed.query or '')
        return _i475_resilience_prev_get(self)
    Handler.do_GET=_i475_resilience_get

    def _i475_patch_html(html):
        if not isinstance(html,str):return html
        replacements=(
            ('V475','V475'),('v475','v475'),('i475','i475'),
            ('1.3.0-i475','1.3.0-i475'),('TAKDashboard/i475','TAKDashboard/i475'),
            ('TAK-Map/1.3.0 i475','TAK-Map/1.3.0 i475'),
        )
        for old,new in replacements:html=html.replace(old,new)
        # Remove the historical half-step zoom override from the final rendered page.
        html=html.replace('m.options.zoomSnap=.5;m.options.zoomDelta=.5','m.options.zoomSnap=1;m.options.zoomDelta=1')
        html=html.replace('zoomSnap:.5','zoomSnap:1').replace('zoomDelta:.5','zoomDelta:1')
        html=_i475_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i475\2',html)
        loader='<script id="takMapWholeZoomLoaderV475" src="/assets/runtime/tak-map-whole-zoom-v475.js?v=1.3.0-i475"></script>'
        if 'takMapWholeZoomLoaderV475' not in html:
            html=html.replace('</body>',loader+'\n</body>',1) if '</body>' in html else html+loader
        controls='<script id="takMapCardControlsLoaderV475" src="/assets/runtime/tak-map-card-controls-v475.js?v=1.3.0-i475"></script>'
        if 'takMapCardControlsLoaderV475' not in html:
            html=html.replace('</body>',controls+'\n</body>',1) if '</body>' in html else html+controls
        return html

    TAK_MAP_HTML=_i475_patch_html(TAK_MAP_HTML);INDEX_HTML=TAK_MAP_HTML
    try:
        TAK_MAP_LOGIN_HTML=TAK_MAP_LOGIN_HTML.replace('i475','i475').replace('v475','v475')
        LOGIN_HTML=LOGIN_HTML.replace('i475','i475').replace('v475','v475')
    except Exception:pass
except Exception as _i475_exc:
    try:print('TAK Map i475 patch failed:',_i475_exc)
    except Exception:pass
# --- end TAK Map i475 patch ---






# --- TAK Map i491 card ownership, Data Sync control/single-flight, Selection Delete ---
try:
    import re as _i491_re

    _i491_prev_config=tak_map_config
    _i491_prev_adsb=tak_map_adsb
    _i491_prev_status=_i475_tile_status
    _i491_prev_get=Handler.do_GET

    _I476_DS_LOCK=threading.Lock()
    _I476_DS_SERVER_STATE={
        'in_flight':False,'last_good':None,'last_good_at':0.0,'last_started_at':0.0,
        'last_completed_at':0.0,'last_duration_ms':0,'requests':0,'network_runs':0,
        'coalesced':0,'cache_hits':0,'last_error':'','last_ok':False,
    }
    _i491_base_data_sync=tak_map_data_sync

    def _i491_ds_copy(value):
        if not isinstance(value,dict):return value
        out=dict(value)
        try:
            out['_tak_map_data_sync_singleflight_i491']={
                'version':'i491','single_flight':True,
                'requests':int(_I476_DS_SERVER_STATE.get('requests',0)),
                'network_runs':int(_I476_DS_SERVER_STATE.get('network_runs',0)),
                'coalesced':int(_I476_DS_SERVER_STATE.get('coalesced',0)),
                'cache_hits':int(_I476_DS_SERVER_STATE.get('cache_hits',0)),
                'in_flight':bool(_I476_DS_SERVER_STATE.get('in_flight')),
                'last_duration_ms':int(_I476_DS_SERVER_STATE.get('last_duration_ms',0)),
                'last_good_at':float(_I476_DS_SERVER_STATE.get('last_good_at',0.0)),
            }
        except Exception:pass
        return out

    def tak_map_data_sync():
        now=time.time()
        with _I476_DS_LOCK:
            _I476_DS_SERVER_STATE['requests']+=1
            cached=_I476_DS_SERVER_STATE.get('last_good')
            age=now-float(_I476_DS_SERVER_STATE.get('last_good_at',0.0) or 0.0)
            if _I476_DS_SERVER_STATE.get('in_flight'):
                _I476_DS_SERVER_STATE['coalesced']+=1
                if isinstance(cached,dict):
                    out=_i491_ds_copy(cached);out['_tak_map_data_sync_singleflight_i491']['served']='coalesced-last-good';return out
                return {'ok':True,'busy':True,'objects':[],'missions':[],'mission_content':[],'mission_uids':[],
                        '_tak_map_data_sync_singleflight_i491':{'version':'i491','single_flight':True,'served':'coalesced-busy-empty','in_flight':True}}
            if isinstance(cached,dict) and age<1.5:
                _I476_DS_SERVER_STATE['cache_hits']+=1
                out=_i491_ds_copy(cached);out['_tak_map_data_sync_singleflight_i491']['served']='short-cache';return out
            _I476_DS_SERVER_STATE['in_flight']=True
            _I476_DS_SERVER_STATE['last_started_at']=now
            _I476_DS_SERVER_STATE['network_runs']+=1
        started=time.monotonic()
        try:
            out=_i491_base_data_sync()
            if not isinstance(out,dict):out={'ok':True,'objects':[],'missions':[],'raw':out}
            with _I476_DS_LOCK:
                _I476_DS_SERVER_STATE['last_ok']=bool(out.get('ok',True))
                _I476_DS_SERVER_STATE['last_error']=''
                if out.get('ok',True):
                    _I476_DS_SERVER_STATE['last_good']=out
                    _I476_DS_SERVER_STATE['last_good_at']=time.time()
            return _i491_ds_copy(out)
        except Exception as exc:
            with _I476_DS_LOCK:
                _I476_DS_SERVER_STATE['last_ok']=False
                _I476_DS_SERVER_STATE['last_error']=str(exc)
                cached=_I476_DS_SERVER_STATE.get('last_good')
            if isinstance(cached,dict):
                out=_i491_ds_copy(cached);out['stale']=True;out['data_sync_error']=str(exc);out['_tak_map_data_sync_singleflight_i491']['served']='error-last-good';return out
            return {'ok':True,'available':False,'objects':[],'missions':[],'mission_content':[],'mission_uids':[],
                    'data_sync_error':str(exc),'_tak_map_data_sync_singleflight_i491':{'version':'i491','single_flight':True,'served':'error-empty'}}
        finally:
            with _I476_DS_LOCK:
                _I476_DS_SERVER_STATE['in_flight']=False
                _I476_DS_SERVER_STATE['last_completed_at']=time.time()
                _I476_DS_SERVER_STATE['last_duration_ms']=int((time.monotonic()-started)*1000)
    globals()['tak_map_data_sync']=tak_map_data_sync

    def tak_map_config():
        cfg=_i491_prev_config()
        if isinstance(cfg,dict):
            cfg['tak_map_iteration']='i491'
            gd=dict(cfg.get('gateway_data') or {});gd['version']='i491';gd['header_enable_toggles']=['adsb','gateway_data','satellite_tracking','data_sync'];cfg['gateway_data']=gd
            boundary=dict(cfg.get('local_elevation_boundary') or {});boundary['version']='i491';cfg['local_elevation_boundary']=boundary
            cfg['data_sync_control']={
                'version':'i491','header_toggle':True,'persisted_enabled_state':True,
                'client_single_flight':True,'server_single_flight':True,'legacy_sweeps_suppressed':True,
                'last_good_retained':True,'transient_backoff':True,'disabled_network_suppression':True,
            }
            cfg['selection_tool']={'version':'i491','actions':['fit','export','delete','clear'],'hide_removed':True,'orange_selection':True,'fill_opacity':0.24,'freehand_preview_fill_opacity':0.12,'targeted_delete_only':True,'broad_refresh_after_delete':False,'themed_delete_dialog':True,'native_delete_confirm':False,'enriched_delete_details':True,'unified_local_data_and_data_sync_dialog':True,'clear_after_action':True};cfg['header_counts']={'version':'i491','local_data':'X ITEMS','gateway_data':'X ITEMS','adsb':'X AIRCRAFT','data_sync':'X MIS, X ITEMS','visible_when_collapsed':True,'uniform_chip_typography':True,'local_data_chip_style_owner':True,'content_sized_chips':True,'data_sync_authoritative_owner':True,'data_sync_duplicate_ownership_deduped':True,'dom_write_only_on_change':True};cfg['sidebar_order']={'version':'i491','satellite_tracking_after':'Offline Maps','satellite_tracking_before':'Tools','persistent_reorder_owner':True};adsb=dict(cfg.get('adsb') or {});adsb['altitude_filter']={'version':'i491','modes':['all','above','below'],'canonical_unit':'meters','locale_default':True,'user_unit_override':True,'unknown_altitude_excluded_when_active':True,'apply_on_mode_change':True,'apply_on_input':True,'clear_input_removes_filter':True,'separate_apply_action':False};adsb['settings_layout']={'version':'i491','filter_and_altitude_same_row':True,'center_source_and_lat_lon_same_row':True,'responsive_stack_only_when_narrow':True};adsb['type_filter_design']={'version':'i491','design':'4A Compact Identification Badge','columns':2,'order':['civil','govt','military','unknown'],'secondary_text':False,'colors':{'civil':'#51d88a','govt':'#b56cff','military':'#5aa9ff','unknown':'#9aa6af'}};cfg['adsb']=adsb
        return cfg

