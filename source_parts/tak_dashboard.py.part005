async function fetchReplayWindow(startMs,endMs,depth){const limit=1000;const q='start='+encodeURIComponent(new Date(startMs).toISOString())+'&end='+encodeURIComponent(new Date(endMs).toISOString())+'&limit='+limit;const j=await api('/api/tak-map/replay/events?'+q);const rows=Array.isArray(j.events)?j.events:[];if(rows.length>=limit&&depth<16&&endMs-startMs>250){const mid=Math.floor((startMs+endMs)/2);const left=await fetchReplayWindow(startMs,mid,depth+1);const right=await fetchReplayWindow(mid,endMs,depth+1);return left.concat(right)}return rows}
function replayRecordKey(r){return String(r.sha256||'')||[r.uid||'',r.recorded_at||'',r.cot_type||'',r.source||'',r.cot||''].join('|')}
function updateBufferUi(){const selected=!!replay.period,span=Math.max(1,replay.periodEndMs-replay.startMs),loaded=selected?Math.max(0,Math.min(span,replay.loadedUntilMs-replay.startMs)):0,pct=selected?Math.round(loaded*100/span):0;const host=$('replayBufferV427'),txt=$('replayBufferTextV427'),num=$('replayBufferPctV427'),fill=$('replayBufferFillV427');if(host)host.classList.toggle('buffering',!!replay.buffering||!!replay.seeking);if(txt)txt.textContent=!selected?'Pending period selection.':(replay.seeking?'Reconstructing Replay state…':(replay.loadComplete?'Timeline fully loaded':'Buffering playback...'));if(num)num.textContent=pct+'%';if(fill)fill.style.width=pct+'%'}
function mergeReplayRows(rows){let changed=false;for(const r of rows||[]){const k=replayRecordKey(r);if(replay.seenRecords.has(k))continue;replay.seenRecords.add(k);const e=parseRecord(r);if(e){replay.events.push(e);changed=true}}if(!changed)return false;replay.events.sort((a,b)=>a.ms-b.ms||String(a.uid).localeCompare(String(b.uid)));if(replay.events.length)replay.eventEndMs=replay.events[replay.events.length-1].ms;replay.endMs=replay.periodEndMs||replay.endMs||replay.eventEndMs;const begin=$('replayBeginV415'),end=$('replayEndV415');if(begin&&Number.isFinite(replay.startMs))begin.textContent=new Date(replay.startMs).toLocaleTimeString();if(end&&Number.isFinite(replay.periodEndMs))end.textContent=new Date(replay.periodEndMs).toLocaleTimeString();buildUidTracks();buildSourceChecks(true);return true}
async function loadReplayBackground(token,cursor){const span=5*60*1000;if(token!==replay.loadToken||replay.seeking)return;replay.loading=true;try{while(token===replay.loadToken&&!replay.seeking&&cursor<replay.periodEndMs){const end=Math.min(replay.periodEndMs,cursor+span);const rows=await fetchReplayWindow(cursor,end,0);if(token!==replay.loadToken||replay.seeking)return;mergeReplayRows(rows);replay.loadedUntilMs=Math.max(Number(replay.loadedUntilMs)||replay.startMs,end);cursor=end;updateBufferUi();if(replay.events.length>500000)throw new Error('Replay period exceeds the 500,000-event safety limit. Select a shorter period.');if(replay.buffering&&replay.resumeAfterBuffer&&replay.loadedUntilMs-replay.currentMs>=30000){replay.buffering=false;replay.resumeAfterBuffer=false;updateBufferUi();play()}await new Promise(r=>setTimeout(r,0))}if(token===replay.loadToken&&!replay.seeking&&cursor>=replay.periodEndMs){replay.loadComplete=true;replay.loading=false;replay.loadedUntilMs=replay.periodEndMs;updateBufferUi();setStatus('Timeline fully loaded',true)}}catch(e){if(token===replay.loadToken&&!replay.seeking){replay.loading=false;setStatus('Replay loading stopped: '+e.message,false)}}}
async function loadSelectedPeriod(){pause();clearReplay();const opt=$('replayPeriodV415').selectedOptions[0];if(!opt||!opt.value)return;const token=++replay.loadToken;replay.period=JSON.parse(opt.dataset.period||'{}');updateReplaySearchAvailabilityI621();const rs=$('replaySearchStatusI621');if(rs)rs.textContent='Ready to search the entire selected recording.';replay.startMs=Date.parse(replay.period.start_utc);replay.periodEndMs=Date.parse(replay.period.end_utc);replay.endMs=replay.periodEndMs;replay.eventEndMs=0;replay.loadedFromMs=replay.startMs;replay.loadedUntilMs=replay.startMs;replay.currentMs=replay.startMs;replay.seekGeneration++;replay.seeking=false;resetReplayJumpI624(false);syncReplayJumpFieldsI624(replay.currentMs,true);const cpState=String(replay.maintenance?.state_checkpoints?.state||'');if(cpState&&cpState!=='ready'){const js=$('replayJumpStatusI624');if(js){js.classList.remove('bad');js.textContent='Replay state index preparing… Ordinary playback is available now.'}}replay.seenRecords=new Set();replay.loadComplete=false;replay.loading=true;replay.buffering=false;replay.resumeAfterBuffer=false;$('replayBeginV415').textContent=new Date(replay.startMs).toLocaleTimeString();$('replayEndV415').textContent=new Date(replay.periodEndMs).toLocaleTimeString();setStatus('Loading initial Replay buffer…',true);updateBufferUi();const initialEnd=Math.min(replay.periodEndMs,replay.startMs+5*60*1000);let cursor=replay.startMs;while(token===replay.loadToken&&cursor<initialEnd){const end=Math.min(initialEnd,cursor+60*1000);const rows=await fetchReplayWindow(cursor,end,0);if(token!==replay.loadToken)return;mergeReplayRows(rows);replay.loadedUntilMs=end;cursor=end;updateBufferUi()}if(token!==replay.loadToken)return;buildUidTracks();buildSourceChecks();seekTo(replay.startMs);setStatus('Initial buffer is ready for playback.',true,true);void loadReplayBackground(token,initialEnd)}
function parseRecord(r){try{const x=new DOMParser().parseFromString(String(r.cot||''),'application/xml');if(x.querySelector('parsererror'))return null;const ev=x.documentElement,p=x.querySelector('point');if(!p)return null;const lat=Number(p.getAttribute('lat')),lon=Number(p.getAttribute('lon'));if(!Number.isFinite(lat)||!Number.isFinite(lon)||Math.abs(lat)>90||Math.abs(lon)>180)return null;const uid=String(r.uid||ev.getAttribute('uid')||'').trim();if(!uid||/^GeoChat\./i.test(uid))return null;const contact=x.querySelector('contact'),track=x.querySelector('track'),adsb=x.querySelector('takgateway_adsb');const first=(...vals)=>{for(const v of vals){const t=String(v??'').trim();if(t)return t}return''};const meta=(...names)=>{for(const n of names){const v=adsb?.getAttribute(n);if(v!=null&&String(v).trim())return String(v).trim();const rv=r&&r[n];if(rv!=null&&String(rv).trim())return String(rv).trim()}return''};const cotType=r.cot_type||ev.getAttribute('type')||'';const source=r.source||'gateway';const callsign=first(contact?.getAttribute('callsign'),r.callsign,r.sender_callsign,uid);const ownerOperator=meta('owner_operator','operator','ownOp','owner');const aircraftType=meta('aircraft_type','t','type');const aircraftModel=meta('aircraft_desc','model','desc','description');let altitudeFt=Number(meta('altitude_ft'));if(!Number.isFinite(altitudeFt)){const hae=Number(p.getAttribute('hae'));altitudeFt=Number.isFinite(hae)&&Math.abs(hae)<1000000?hae*3.28084:NaN}let speedMph=Number(meta('groundspeed_mph','speed_mph'));if(!Number.isFinite(speedMph)){const mps=Number(track?.getAttribute('speed'));speedMph=Number.isFinite(mps)?mps*2.236936:NaN}const courseDeg=Number(track?.getAttribute('course'));const dbFlags=Number(meta('dbFlags','dbflags'))||0;const category=first(meta('category','category_class','aircraft_class'),adsb?'aircraft':'');const description=first(aircraftModel,aircraftType,meta('description'));const aircraftBlob=[cotType,source,uid,callsign,aircraftType,aircraftMode