            html=html.replace(old,new)
        html=_i465_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i465\2',html)
        helper=r'''<script id="takMapDirectTileLayerV465">
(function(w){'use strict';
function fill(t,c){return String(t||'').replace('{z}',c.z).replace('{x}',c.x).replace('{y}',c.y)}
w.takMapCreateOnlineLayerV465=function(b){
  const layer=L.tileLayer(b.url,{minZoom:b.minZoom||0,maxZoom:b.maxZoom||19,attribution:b.attribution||'',errorTileUrl:''});
  layer.on('tileerror',function(ev){try{const tile=ev&&ev.tile,c=ev&&ev.coords;if(!tile||!c||!b.tile_proxy_url||tile.dataset.takProxyFallbackV465==='1')return;tile.dataset.takProxyFallbackV465='1';tile.src=fill(b.tile_proxy_url,c)}catch(_){}});
  return layer;
};
})(window);
</script>'''
        if 'takMapDirectTileLayerV465' not in html:
            html=html.replace('</body>',helper+'\n</body>',1) if '</body>' in html else html+helper
        original="baseLayer=L.tileLayer(b.url,{minZoom:b.minZoom||0,maxZoom:b.maxZoom||19,attribution:b.attribution||'',errorTileUrl:''}).addTo(map);"
        replacement="baseLayer=(window.takMapCreateOnlineLayerV465?window.takMapCreateOnlineLayerV465(b):L.tileLayer(b.url,{minZoom:b.minZoom||0,maxZoom:b.maxZoom||19,attribution:b.attribution||'',errorTileUrl:''})).addTo(map);"
        html=html.replace(original,replacement)
        return html

