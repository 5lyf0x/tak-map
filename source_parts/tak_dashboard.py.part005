try:
    import re as _i491_adsb_re

    _i491_adsb_prev_config=tak_map_config
    def tak_map_config():
        cfg=_i491_adsb_prev_config()
        if not isinstance(cfg,dict): return cfg
        adsb=cfg.setdefault('adsb',{})
        adsb['visibility_and_interpolation']={
            'version':'i491',
            'filters_remove_visuals_immediately':True,
            'altitude_uses_newest_valid_value':True,
            'non_distance_filters_keep_ingestion':True,
            'non_distance_filters_keep_virtual_interpolation':True,
            'distance_filter_stops_interpolation':True,
            'restore_at_current_interpolated_position':True,
            'master_disable_stops_all_ingestion':True,
            'master_reenable_starts_from_current_snapshot':True,
            'stale_motion_replay_on_reenable':False,
        }
        return cfg

    def _i491_adsb_visibility_patch_html(html):
        if not isinstance(html,str): return html
        renderer=r"""function renderAircraft(input){const layer=ensureLayer();if(!layer)return [];const allRows=normalizeList(input),rows=filtered(allRows);ADSB.lastList=allRows.slice();ADSB.lastGoodAt=Date.now();window.lastAircraft=allRows.slice();ADSB.data.clear();allRows.forEach(function(a){ADSB.data.set(idOf(a),a)});const seen=new Set();rows.forEach(function(a){const id=idOf(a);seen.add(id);let mk=ADSB.markers.get(id);const ll=[a.lat,a.lon];if(!mk){mk=L.marker(ll,{icon:iconFor(a),zIndexOffset:900,interactive:true,riseOnHover:true}).addTo(layer);ADSB.markers.set(id,mk);mk.on('popupopen',function(){setTimeout(syncButtons,20)});}else{mk.setLatLng(ll);const el=mk.getElement&&mk.getElement();const img=el&&el.querySelector&&el.querySelector('img');const lab=el&&el.querySelector&&el.querySelector('.aircraft-label');const want=iconPath(a);if(img){try{if(!(String(img.getAttribute('src')||'').endsWith(want)))img.src=want;img.style.transform='rotate('+((n(a.track_deg??a.track??a.heading)||0))+'deg)'}catch(_){}}else{try{mk.setIcon(iconFor(a))}catch(_){}}if(lab)lab.textContent=titleOf(a,id)}try{mk._takAdsbAircraft=a;mk._takAdsbId=id;if(!mk.isPopupOpen()){mk.bindPopup(popupHtml(a),{className:'adsb-v309-popup adsb-object-popup',autoPan:false,closeButton:false,autoClose:false,closeOnClick:false});try{if(mk.__v463LifecycleBound&&mk._openPopup)mk.off('click',mk._openPopup,mk)}catch(_){}}else mk.setPopupContent(popupHtml(a))}catch(_){}if(ADSB.tracking.id===id)addTrackPoint(a)});ADSB.markers.forEach(function(mk,id){if(seen.has(id))return;try{const interp=window.TakMapLiveInterpolationV476||window.TakMapLiveInterpolationV477;interp&&interp.cancel&&interp.cancel(mk)}catch(_){}try{layer.removeLayer(mk)}catch(_){}ADSB.markers.delete(id);if(ADSB.tracking.id===id){try{clearTrackVisual()}catch(_){}ADSB.tracking.id=null;ADSB.tracking.meta=null;ADSB.tracking.points=[]}});publishMaps();updateStatus(rows.length);syncButtons();return rows}"""
        pattern=r"function renderAircraft\(input\)\{const layer=ensureLayer\(\);if\(!layer\)return \[\];.*?publishMaps\(\);updateStatus\(rows.length\);syncButtons\(\);return rows\}"
        html,count=_i491_adsb_re.subn(pattern,renderer,html,count=1,flags=_i491_adsb_re.S)
        if count!=1:
            raise RuntimeError('i491 active ADS-B renderer replacement count '+str(count))
        redraw=r"""function redrawAdsbFiltered(){try{const api=window.TakMapAdsbWorkerV477||window.TakMapAdsbWorkerV476;if(api&&typeof api.refreshVisibility==='function')return api.refreshVisibility();window.__takMapAdsbExplicitClear=true;window.__adsbForceClear=true;window.__takMapAllowExternalAdsbDraw=true;if(typeof window.drawAircraft==='function')window.drawAircraft(window.lastAircraft||[]);else if(typeof drawAircraft==='function')drawAircraft(window.lastAircraft||[])}catch(e){console.warn('i491 ADS-B redraw failed',e)}finally{setTimeout(function(){window.__takMapAdsbExplicitClear=false;window.__adsbForceClear=false;window.__takMapAllowExternalAdsbDraw=false},120)}}"""
        html,count=_i491_adsb_re.subn(r"function redrawAdsbFiltered\(\)\{try\{window\.__takMapAdsbExplicitClear=true;.*?\}\s*(?=function bindAdsbAutosave)",redraw+'\n  ',html,count=1,flags=_i491_adsb_re.S)
        if count!=1:
            raise RuntimeError('i491 ADS-B redraw replacement count '+str(count))
        html=html.replace("setInterval(()=>{if(state.live.adsb_aircraft)refreshAdsb()},30000);","/* i491 dedicated ADS-B worker owns polling cadence */")
        return html

    TAK_MAP_HTML=_i491_adsb_visibility_patch_html(TAK_MAP_HTML); INDEX_HTML=TAK_MAP_HTML
except Exception as _i491_adsb_visibility_exc:
    try: print('TAK Map i491 ADS-B visibility/interpolation patch failed:',_i491_adsb_visibility_exc)
    except Exception: pass
# --- end TAK Map i491 authoritative ADS-B visibility/interpolation ownership ---

# --- TAK Map i491 geofencing engine, persistence, and protected geometry ---
try:
    TAK_MAP_GEOFENCE_FILE=TAK_MAP_OFFLINE_DIR/'geofences.json'
    _TAK_MAP_GEOFENCE_LOCK=threading.RLock()
    _TAK_MAP_GEOFENCE_ALLOWED_SOURCES=('eud','adsb','local','datasync','gateway','satellite')
    _TAK_MAP_GEOFENCE_ALT_MODES=('none','min','max','band')

    def _tak_gf_text(value,limit=160):
        value=str(value or '').strip()
        return value[:limit]

    def _tak_gf_number(value):
        try:
            value=float(value)
            return value if math.isfinite(value) else None
        except Exception:
            return None

    def _tak_gf_geometry(value,kind):
        value=value if isinstance(value,dict) else {}
        gtype=str(value.get('type') or '').strip().lower()
        if kind=='route':
            rows=[]
            for p in value.get('coordinates') or []:
                if not isinstance(p,(list,tuple)) or len(p)<2: continue
                lon=_tak_gf_number(p[0]); lat=_tak_gf_number(p[1])
                if lon is None or lat is None or abs(lat)>90 or abs(lon)>180: continue
                rows.append([lon,lat])
            if len(rows)<2: raise ValueError('A route geofence requires at least two valid route points.')
            return {'type':'route','coordinates':rows}
        if gtype=='circle':
            center=value.get('center') or []
            if not isinstance(center,(list,tuple)) or len(center)<2: raise ValueError('A circle geofence requires a valid center.')
            lon=_tak_gf_number(center[0]); lat=_tak_gf_number(center[1]); radius=_tak_gf_number(value.get('radius_m'))
            if lon is None or lat is None or abs(lat)>90 or abs(lon)>180 or radius is None or radius<=0: raise ValueError('A circle geofence requires a valid center and radius.')
            return {'type':'circle','center':[lon,lat],'radius_m':max(.5,min(radius,20000000.0))}
        rows=[]
        for p in value.get('coordinates') or []:
            if not isinstance(p,(list,tuple)) or len(p)<2: continue
            lon=_tak_gf_number(p[0]); lat=_tak_gf_number(p[1])
            if lon is None or lat is None or abs(lat)>90 or abs(lon)>180: continue
            rows.append([lon,lat])
        if len(rows)<3: raise ValueError('An area geofence requires at least three valid vertices.')
        if rows[0]!=rows[-1]: rows.append(list(rows[0]))
        return {'type':'polygon','coordinates':rows}

    def _tak_gf_normalize(raw,existing=None):
        raw=raw if isinstance(raw,dict) else {}
        existing=existing if isinstance(existing,dict) else {}
        kind='route' if str(raw.get('kind') or existing.get('kind') or '').lower()=='route' else 'shape'
        target_id=_tak_gf_text(raw.get('target_id') or existing.get('target_id'),240)
        if not target_id or not (target_id.startswith('local:') or target_id.startswith('datasync:')):
            raise ValueError('Geofences require a canonical Local Data or Data Sync shape/route identity.')
        monitored=[]
        for item in raw.get('monitored') or existing.get('monitored') or []:
            item=str(item or '').strip().lower()
            if item in _TAK_MAP_GEOFENCE_ALLOWED_SOURCES and item not in monitored: monitored.append(item)
        if not monitored: raise ValueError('Select at least one object class to monitor.')
        incoming=raw.get('triggers') if isinstance(raw.get('triggers'),dict) else existing.get('triggers') or {}
        triggers={'enter':kind=='shape' and bool(incoming.get('enter')),'exit':kind=='shape' and bool(incoming.get('exit')),'dwell':kind=='shape' and bool(incoming.get('dwell')),'cross':kind=='route'}
        if kind=='shape' and not any((triggers['enter'],triggers['exit'],triggers['dwell'])): raise ValueError('Select Enter, Exit, or Dwell for an area geofence.')
        dwell=_tak_gf_number(raw.get('dwell_minutes') if 'dwell_minutes' in raw else existing.get('dwell_minutes'))
        dwell=max(1.0,min(10080.0,dwell or 1.0))
        alt=raw.get('altitude') if isinstance(raw.get('altitude'),dict) else existing.get('altitude') or {}
        mode=str(alt.get('mode') or 'none').strip().lower()
        if mode not in _TAK_MAP_GEOFENCE_ALT_MODES: mode='none'
        min_ft=_tak_gf_number(alt.get('min_ft')); max_ft=_tak_gf_number(alt.get('max_ft'))
        if mode=='band' and min_ft is not None and max_ft is not None and min_ft>max_ft: raise ValueError('Minimum altitude must not exceed maximum altitude.')
        now=datetime.now(timezone.utc).isoformat()
        return {
            'id':_tak_gf_text(raw.get('id') or existing.get('id') or ('gf-'+uuid.uuid4().hex),120),
            'name':_tak_gf_text(raw.get('name') or existing.get('name') or 'Geofence',80),
            'target_id':target_id,
            'target_source':_tak_gf_text(raw.get('target_source') or existing.get('target_source') or ('datasync' if target_id.startswith('datasync:') else 'local'),32),
            'target_name':_tak_gf_text(raw.get('target_name') or existing.get('target_name') or 'Map object',120),
            'kind':kind,
            'geometry':_tak_gf_geometry(raw.get('geometry') or existing.get('geometry'),kind),
            'monitored':monitored,
            'triggers':triggers,
            'dwell_minutes':dwell,
            'altitude':{'mode':mode,'min_ft':min_ft,'max_ft':max_ft},
            'enabled':bool(raw.get('enabled',existing.get('enabled',True))),
            'created_at':_tak_gf_text(existing.get('created_at') or raw.get('created_at') or now,80),
            'updated_at':now,
        }

    def _tak_gf_load():
        with _TAK_MAP_GEOFENCE_LOCK:
            payload=load_json_file(TAK_MAP_GEOFENCE_FILE,{'fences':[]})
            raw_rows=payload.get('fences') if isinstance(payload,dict) else []
            rows=[]; changed=False; seen=set()
            for raw in raw_rows or []:
                try:
                    row=_tak_gf_normalize(raw,raw)
                    if row['id'] in seen: changed=True; continue
                    seen.add(row['id']); rows.append(row)
                except Exception:
                    changed=True
            if changed:
                TAK_MAP_OFFLINE_DIR.mkdir(parents=True,exist_ok=True)
                atomic_write_json(TAK_MAP_GEOFENCE_FILE,{'version':'i491','fences':rows})
            return rows

    def _tak_gf_save(rows):
        with _TAK_MAP_GEOFENCE_LOCK:
            TAK_MAP_OFFLINE_DIR.mkdir(parents=True,exist_ok=True)
            atomic_write_json(TAK_MAP_GEOFENCE_FILE,{'version':'i491','fences':rows})

    def tak_map_geofences():
        rows=_tak_gf_load()
        return {'ok':True,'fences':rows,'rules':{'confirmation_seconds':2,'rearm_seconds':10,'one_event_per_crossing':True,'stale_exit_events':False}}
    globals()['tak_map_geofences']=tak_map_geofences

    def tak_map_geofence_update(payload):
        payload=payload if isinstance(payload,dict) else {}
        action=str(payload.get('action') or '').strip().lower()
        with _TAK_MAP_GEOFENCE_LOCK:
            rows=_tak_gf_load(); by_id={row['id']:row for row in rows}
            if action=='upsert':
                raw=payload.get('fence') if isinstance(payload.get('fence'),dict) else {}
                fid=_tak_gf_text(raw.get('id'),120)
                row=_tak_gf_normalize(raw,by_id.get(fid))
                by_id[row['id']]=row
                ordered=[by_id[r['id']] for r in rows if r['id'] in by_id and r['id']!=row['id']]+[row]
                _tak_gf_save(ordered)
                return {'ok':True,'fence':row,'fences':ordered}
            if action=='remove':
                fid=_tak_gf_text(payload.get('id'),120)
                if not fid: return {'ok':False,'error':'A geofence ID is required.'}
                existed=fid in by_id
                out=[r for r in rows if r['id']!=fid]
                if existed: _tak_gf_save(out)
                return {'ok':True,'removed':existed,'id':fid,'fences':out}
            return {'ok':False,'error':'Unsupported geofence action.'}
    globals()['tak_map_geofence_update']=tak_map_geofence_update

    def _tak_gf_protected_ids():
        return {str(row.get('target_id') or '') for row in _tak_gf_load() if row.get('target_id')}

    def _tak_gf_local_canonical(value):
        raw=str(value or '').strip()
        if raw.startswith('local:'): return raw
        if raw.startswith('local-'): return 'local:'+raw
        try:
            rows=_selected_local_data_features([raw])
            if rows:
                value=str(rows[0].get('canonical_id') or rows[0].get('object_id') or '')
                if value.startswith('local:'): return value
                if value.startswith('local-'): return 'local:'+value
        except Exception: pass
        return ''

    _i491_gf_prev_local_delete=tak_map_local_data_delete
    def tak_map_local_data_delete(ids):
        requested=[str(v or '').strip() for v in (ids or []) if str(v or '').strip()]
        protected=_tak_gf_protected_ids(); blocked=[]; allowed=[]
        for raw in requested:
            canonical=_tak_gf_local_canonical(raw)
            if canonical and canonical in protected: blocked.append(canonical)
            else: allowed.append(raw)
        if allowed:
            result=_i491_gf_prev_local_delete(allowed)
        else:
            result={'ok':True,'deleted':False,'deleted_count':0,'deleted_ids':[],'not_found_ids':[],'unsupported_ids':[],'failed_ids':[],'imports':tak_map_imported().get('imports',[])}
        result=dict(result or {})
        if blocked:
            failed=list(dict.fromkeys((result.get('failed_ids') or [])+blocked))
            result.update({'ok':False,'partial':bool(result.get('deleted_ids')),'failed_ids':failed,'error':'Remove the geofence before deleting its shape or route.','protected_by_geofence':blocked})
            results=list(result.get('results') or [])
            results.extend({'object_id':x,'status':'protected_by_geofence','error':'Remove the geofence before deleting this object.'} for x in blocked)
            result['results']=results
        return result
    globals()['tak_map_local_data_delete']=tak_map_local_data_delete

    _i491_gf_prev_object_delete=tak_map_object_delete
    def tak_map_object_delete(object_ids,server_host=''):
        requested=[str(v or '').strip() for v in (object_ids or []) if str(v or '').strip()]
        protected=_tak_gf_protected_ids(); blocked=[v for v in requested if v in protected]; allowed=[v for v in requested if v not in protected]
        if allowed:
            result=_i491_gf_prev_object_delete(allowed,server_host)
        else:
            result={'ok':True,'deleted':False,'deleted_ids':[],'not_found_ids':[],'unsupported_ids':[],'failed_ids':[],'results':[],'imports':tak_map_imported().get('imports',[])}
        result=dict(result or {})
        if blocked:
            result['failed_ids']=list(dict.fromkeys((result.get('failed_ids') or [])+blocked))
            result['results']=list(result.get('results') or [])+[{'object_id':x,'status':'protected_by_geofence','error':'Remove the geofence before deleting this object.'} for x in blocked]
            result['protected_by_geofence']=blocked
            result['partial']=bool(result.get('deleted_ids'))
            result['ok']=False
            result['error']='Remove the geofence before deleting its shape or route.'
        return result
    globals()['tak_map_object_delete']=tak_map_object_delete

    _i491_gf_prev_get=Handler.do_GET
    _i491_gf_prev_post=Handler.do_POST
    _i491_gf_prev_config=tak_map_config

    def tak_map_config():
        cfg=_i491_gf_prev_config()
        if isinstance(cfg,dict):
            cfg=dict(cfg)
            cfg['tak_map_iteration']='i491'
            cfg['geofencing']={
                'version':'i491','supported_geometry':['circle','rectangle','polygon','route'],
                'monitored_sources':list(_TAK_MAP_GEOFENCE_ALLOWED_SOURCES),
                'area_triggers':['enter','exit','dwell'],'route_triggers':['cross'],
                'dwell_minutes_user_configurable':True,'enter_exit_simultaneous':True,
                'aircraft_altitude_source':'adsb','aircraft_altitude_modes':['min','max','band'],
                'boundary_confirmation_seconds':2,'rearm_seconds':10,'one_event_per_crossing':True,
                'stale_exit_events':False,'protected_geometry':True,'duplicate_action':False,
                'recording_creation_supported':True,'sidebar_design':'Option A Operational Rows',
                'event_window_design':'Option C Dense Trigger Chips','collapse_control':'minus_plus',
                'event_window_draggable':True,'event_window_default':'lower_right_above_scale',
                'event_window_session_position':True,'alert_sound':True,'pulsing_red_object_glow':True,
                'native_browser_controls':False,
            }
            cfg.setdefault('adsb',{})['type_filter_selected_accent']='light_gray'
        return cfg
    globals()['tak_map_config']=tak_map_config

    def _i491_gf_get(self):
        parsed=urlparse(self.path)
        if parsed.path=='/assets/runtime/tak-map-geofencing-v491.js':
            fp=Path(__file__).resolve().parent/'assets'/'tak-map-geofencing-v491.js'
            if not fp.exists():
                self.send_response(404); self.send_header('Cache-Control','no-store'); self.end_headers(); return
            body=fp.read_bytes(); self.send_response(200); self.send_header('Content-Type','application/javascript; charset=utf-8'); self.send_header('Cache-Control','no-store, max-age=0'); self.send_header('X-TAK-Map-Module','i493-geofencing'); self.send_header('Content-Length',str(len(body))); self.end_headers()
            if getattr(self,'command','GET')!='HEAD': self.wfile.write(body)
            return
        if parsed.path=='/api/tak-map/geofences':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            return self._send_json(tak_map_geofences())
        return _i491_gf_prev_get(self)
    Handler.do_GET=_i491_gf_get

    def _i491_gf_post(self):
        parsed=urlparse(self.path)
        if parsed.path=='/api/tak-map/geofences':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            try:
                result=tak_map_geofence_update(_read_json_body(self))
                return self._send_json(result,200 if result.get('ok') else 400)
            except Exception as exc:
                return self._send_json({'ok':False,'error':str(exc)},400)
        return _i491_gf_prev_post(self)
    Handler.do_POST=_i491_gf_post

    def _i491_gf_patch_html(html):
        if not isinstance(html,str): return html
        marker="const m=leaflet().marker([p.lat,p.lon],{icon:satIcon(r),zIndexOffset:250,autoPan:false}).bindPopup(popupHtml(r,p),{autoPan:false,closeButton:true,className:'tak-object-popup sat-object-popup'}).addTo(state.layer);"
        tagged=marker+"m._takSatelliteId=String(r.__key||r.__name||'');"
        if marker in html and '_takSatelliteId=String(r.__key' not in html: html=html.replace(marker,tagged,1)
        diag="w.getTakMapSatelliteDiagnosticsV409=function(){"
        snapshot="w.getTakMapSatelliteSnapshotV491=function(){const now=new Date();return visibleRecordsWithPrefs().map(function(r){const p=positionFor(r,now);if(!p)return null;return {id:String(r.__key||r.__name||''),name:String(r.__name||r.__key||'Satellite'),lat:p.lat,lon:p.lon,altitude_km:p.altKm,updated_at:now.toISOString(),source:'satellite'};}).filter(Boolean)};"
        if diag in html and 'getTakMapSatelliteSnapshotV491' not in html: html=html.replace(diag,snapshot+diag,1)
        loader='<script id="takMapGeofencingLoaderV491" src="/assets/runtime/tak-map-geofencing-v491.js?v=1.3.0-i491"></script>'
        if 'takMapGeofencingLoaderV491' not in html:
            html=html.replace('</body>',loader+'\n</body>',1) if '</body>' in html else html+loader
        return html
    TAK_MAP_HTML=_i491_gf_patch_html(TAK_MAP_HTML); INDEX_HTML=TAK_MAP_HTML
except Exception as _i491_geofencing_exc:
    try: print('TAK Map i491 geofencing patch failed:',_i491_geofencing_exc)
    except Exception: pass
# --- end TAK Map i491 geofencing patch ---

