# --- TAK Map i509 generic OpenTAKServer connection and per-user login foundation ---
try:
    from http.cookies import SimpleCookie as _i509_SimpleCookie
    from urllib.parse import urljoin as _i509_urljoin

    TAK_MAP_OTS_CONFIG_FILE = DATA_DIR / 'ots_connection.json'
    TAK_MAP_OTS_TRUST_DIR = DATA_DIR / 'ots_trust'

    def _i509_bool(value, default=False):
        if isinstance(value, bool):
            return value
        if value is None:
            return bool(default)
        return str(value).strip().lower() in ('1','true','yes','on','enabled')

    def _i509_clean_port(value, default):
        try:
            port=int(value)
            return port if 1 <= port <= 65535 else int(default)
        except Exception:
            return int(default)

    def _i509_origin(value, default_scheme='https'):
        raw=str(value or '').strip()
        if not raw:
            return ''
        if '://' not in raw:
            raw=default_scheme+'://'+raw
        p=urlparse(raw)
        if p.scheme not in ('http','https') or not p.hostname:
            raise ValueError('A valid HTTP or HTTPS OpenTAKServer address is required.')
        host=p.hostname
        if ':' in host and not host.startswith('['):
            host='['+host+']'
        port=(':'+str(p.port)) if p.port else ''
        return f'{p.scheme}://{host}{port}'

    def _i509_default_ots_config():
        return {
            'version':'i510',
            'enabled':False,
            'login_enabled':False,
            'display_name':'OpenTAKServer',
            'base_url':'',
            'api_url':'',
            'marti_url':'',
            'enrollment_url':'',
            'cot_host':'',
            'cot_port':8089,
            'ca_cert_path':'',
            'verify_tls':True,
            'oauth_path':'/oauth/token',
            'api_login_path':'/api/login',
            'truststore_path':'/api/truststore',
            'client_cert_path':'',
            'client_key_path':'',
            'configured_at':'',
            'last_discovery':{},
        }

    def _i509_normalize_ots_config(payload=None, current=None):
        cfg=_i509_default_ots_config()
        # Persist only the documented non-secret connection fields. This prevents
        # credentials accidentally supplied to a setup/test endpoint from being
        # copied into ots_connection.json by a later save operation.
        allowed=set(cfg)
        for source in (current,payload):
            if isinstance(source,dict):
                for key in allowed:
                    if key in source: cfg[key]=source[key]
        base=_i509_origin(cfg.get('base_url') or cfg.get('api_url') or '') if (cfg.get('base_url') or cfg.get('api_url')) else ''
        cfg['base_url']=base
        host=urlparse(base).hostname if base else str(cfg.get('cot_host') or '').strip()
        cfg['api_url']=_i509_origin(cfg.get('api_url') or base) if (cfg.get('api_url') or base) else ''
        cfg['marti_url']=_i509_origin(cfg.get('marti_url') or (f'https://{host}:8443' if host else '')) if (cfg.get('marti_url') or host) else ''
        cfg['enrollment_url']=_i509_origin(cfg.get('enrollment_url') or (f'https://{host}:8446' if host else '')) if (cfg.get('enrollment_url') or host) else ''
        cfg['cot_host']=str(cfg.get('cot_host') or host or '').strip()
        cfg['cot_port']=_i509_clean_port(cfg.get('cot_port'),8089)
        cfg['enabled']=_i509_bool(cfg.get('enabled'))
        cfg['login_enabled']=_i509_bool(cfg.get('login_enabled'))
        cfg['verify_tls']=_i509_bool(cfg.get('verify_tls'),True)
        cfg['display_name']=str(cfg.get('display_name') or 'OpenTAKServer').strip()[:80] or 'OpenTAKServer'
        for key,default in (('oauth_path','/oauth/token'),('api_login_path','/api/login'),('truststore_path','/api/truststore')):
            val=str(cfg.get(key) or default).strip()
            if not val.startswith('/'): val='/'+val
            cfg[key]=val
        for key in ('ca_cert_path','client_cert_path','client_key_path'):
            cfg[key]=str(cfg.get(key) or '').strip()
        cfg['version']='i510'
        return cfg

    def _i509_load_ots_config():
        raw=load_json_file(TAK_MAP_OTS_CONFIG_FILE,{})
        try: return _i509_normalize_ots_config(raw if isinstance(raw,dict) else {})
        except Exception: return _i509_default_ots_config()

    def _i509_public_ots_config(cfg=None):
        cfg=dict(cfg or _i509_load_ots_config())
        cfg['client_key_configured']=bool(str(cfg.get('client_key_path') or '').strip())
        cfg.pop('client_key_path',None)
        cfg['ca_readable']=bool(cfg.get('ca_cert_path') and Path(cfg['ca_cert_path']).expanduser().is_file())
        cfg['client_cert_readable']=bool(cfg.get('client_cert_path') and Path(cfg['client_cert_path']).expanduser().is_file())
        cfg['configured']=bool(cfg.get('base_url'))
        ld=cfg.get('last_discovery')
        if not isinstance(ld,dict): cfg['last_discovery']={}
        return cfg

    def _i509_validate_login_activation(cfg):
        if not (cfg.get('enabled') and cfg.get('login_enabled')):
            return
        base=urlparse(str(cfg.get('base_url') or ''))
        if base.scheme!='https':
            raise ValueError('OpenTAKServer-backed login requires an HTTPS Web/API address.')
        if not cfg.get('verify_tls'):
            raise ValueError('OpenTAKServer-backed login requires strict TLS verification.')
        web=_i509_cert_probe(base.hostname,base.port or 443,cfg)
        if not web.get('strict_tls_ok'):
            raise ValueError('OpenTAKServer-backed login cannot be enabled until the Web/API certificate chain is trusted: '+str(web.get('strict_tls_error') or web.get('error') or 'TLS validation failed.'))
        if not web.get('hostname_match'):
            raise ValueError('OpenTAKServer-backed login cannot be enabled because the Web/API hostname is not present in the certificate SAN/CN.')
        cot=_i509_cert_probe(cfg.get('cot_host'),cfg.get('cot_port'),cfg)
        if not cot.get('strict_tls_ok'):
            raise ValueError('OpenTAKServer-backed login cannot be enabled until the SSL CoT certificate chain is trusted: '+str(cot.get('strict_tls_error') or cot.get('error') or 'TLS validation failed.'))
        if not cot.get('hostname_match'):
            raise ValueError('OpenTAKServer-backed login cannot be enabled because the SSL CoT hostname is not present in the certificate SAN/CN.')

    def _i509_save_ots_config(payload):
        current=_i509_load_ots_config()
        cfg=_i509_normalize_ots_config(payload,current)
        _i509_validate_login_activation(cfg)
        cfg['configured_at']=datetime.now(timezone.utc).isoformat()
        TAK_MAP_OTS_CONFIG_FILE.parent.mkdir(parents=True,exist_ok=True)
        atomic_write_json(TAK_MAP_OTS_CONFIG_FILE,cfg)
        try: os.chmod(TAK_MAP_OTS_CONFIG_FILE,0o600)
        except Exception: pass
        return cfg

    def _i509_ssl_context(cfg, unverified=False):
        if unverified or not _i509_bool(cfg.get('verify_tls'),True):
            return ssl._create_unverified_context()
        ca=str(cfg.get('ca_cert_path') or '').strip()
        if ca:
            return ssl.create_default_context(cafile=str(Path(ca).expanduser()))
        return ssl.create_default_context()

    def _i509_decode_pem_cert(pem):
        path=''
        try:
            fd,path=tempfile.mkstemp(prefix='tak-map-ots-cert-',suffix='.pem')
            os.write(fd,pem.encode('utf-8') if isinstance(pem,str) else pem)
            os.close(fd)
            return ssl._ssl._test_decode_cert(path)
        except Exception:
            return {}
        finally:
            if path:
                try: os.unlink(path)
                except Exception: pass

    def _i509_cert_probe(host,port,cfg):
        result={'ok':False,'host':host,'port':int(port),'strict_tls_ok':False,'subject':{},'issuer':{},'sans':[],'not_before':'','not_after':'','hostname_match':False,'error':''}
        if not host:
            result['error']='No host configured.'; return result
        try:
            pem=ssl.get_server_certificate((host,int(port)),timeout=8)
            decoded=_i509_decode_pem_cert(pem)
            result['subject']={k:v for group in decoded.get('subject',[]) for k,v in group}
            result['issuer']={k:v for group in decoded.get('issuer',[]) for k,v in group}
            result['sans']=[{'type':str(k),'value':str(v)} for k,v in decoded.get('subjectAltName',[])]
            result['not_before']=str(decoded.get('notBefore') or '')
            result['not_after']=str(decoded.get('notAfter') or '')
            try:
                h=str(host or '').strip().lower().rstrip('.')
                matched=False
                try:
                    hip=ipaddress.ip_address(h)
                except Exception:
                    hip=None
                for sk,sv in decoded.get('subjectAltName',[]):
                    kind=str(sk or '').lower(); value=str(sv or '').strip().lower().rstrip('.')
                    if hip is not None and kind in ('ip address','ip'):
                        try:
                            if ipaddress.ip_address(value)==hip: matched=True; break
                        except Exception: pass
                    if hip is None and kind=='dns':
                        if value==h: matched=True; break
                        if value.startswith('*.') and h.endswith(value[1:]) and h.count('.')==value.count('.'):
                            matched=True; break
                if not decoded.get('subjectAltName') and hip is None:
                    cn=str(result.get('subject',{}).get('commonName') or '').lower().rstrip('.')
                    matched=(cn==h)
                result['hostname_match']=bool(matched)
                if not matched: result['hostname_error']='Configured host is not present in the certificate SAN/CN.'
            except Exception as e:
                result['hostname_error']=str(e)
            result['ok']=True
        except Exception as e:
            result['error']='Certificate read failed: '+str(e)
            return result
        try:
            context=_i509_ssl_context(cfg)
            with socket.create_connection((host,int(port)),timeout=8) as raw:
                with context.wrap_socket(raw,server_hostname=host) as tls:
                    result['strict_tls_ok']=True
                    result['tls_version']=tls.version() or ''
                    result['cipher']=(tls.cipher() or ('','',''))[0]
        except Exception as e:
            result['strict_tls_error']=str(e)
        return result

    def _i509_http_request(url,cfg,method='GET',data=None,headers=None,timeout=8):
        out={'url':url,'status':0,'ok':False,'reachable':False,'headers':{},'body':'','error':''}
        hdr={'Accept':'application/json, text/plain, */*','User-Agent':'TAK-Map/i510 OTS Connector'}
        hdr.update(headers or {})
        try:
            req=Request(url,data=data,headers=hdr,method=method)
            with urlopen(req,timeout=timeout,context=_i509_ssl_context(cfg)) as resp:
                body=resp.read(262144)
                out.update({'status':int(getattr(resp,'status',200) or 200),'reachable':True,'headers':dict(resp.headers.items()),'body':body.decode('utf-8','replace')})
        except HTTPError as e:
            try: body=e.read(262144)
            except Exception: body=b''
            out.update({'status':int(getattr(e,'code',0) or 0),'reachable':True,'headers':dict(e.headers.items()) if e.headers else {},'body':body.decode('utf-8','replace'),'error':'HTTP '+str(getattr(e,'code',''))})
        except Exception as e:
            out['error']=str(e)
        out['ok']=200 <= int(out.get('status') or 0) < 300
        out['body_preview']=str(out.get('body') or '')[:1200]
        out.pop('body',None)
        return out

    def _i509_endpoint_class(probe):
        status=int((probe or {}).get('status') or 0)
        if 200 <= status < 300: return 'available'
        if status in (400,401,403,405): return 'available-auth-or-method-required'
        if status==404: return 'not-found'
        return 'unreachable' if not (probe or {}).get('reachable') else 'unexpected-response'

    def _i509_local_ots_version():
        helper="""import importlib.metadata as m\nfor n in ('opentakserver','OpenTAKServer'):\n try:\n  print(m.version(n));break\n except Exception: pass\n"""
        for py in _candidate_ots_venv_python_paths():
            try:
                r=subprocess.run([str(py),'-c',helper],capture_output=True,text=True,timeout=6)
                val=(r.stdout or '').strip().splitlines()
                if val: return val[-1].strip()
            except Exception: pass
        return ''

    def _i509_discover_ots(payload=None):
        cfg=_i509_normalize_ots_config(payload or {},_i509_load_ots_config())
        if not cfg.get('base_url'):
            raise ValueError('Enter the OpenTAKServer web/API address first.')
        base=cfg['base_url'].rstrip('/')
        api=cfg['api_url'].rstrip('/')
        marti=cfg['marti_url'].rstrip('/')
        enroll=cfg['enrollment_url'].rstrip('/')
        urls={
            'web':base+'/',
            'health':base+'/api/health',
            'status':base+'/api/status',
            'truststore':base+cfg['truststore_path'],
            'oauth_token':base+cfg['oauth_path'],
            'api_login':base+cfg['api_login_path'],
            'groups':api+'/api/groups',
            'missions':api+'/api/missions',
            'marti_root':marti+'/',
            'marti_version':marti+'/Marti/api/version/config',
            'marti_contacts':marti+'/Marti/api/contacts/all',
            'marti_groups':marti+'/Marti/api/groups',
            'marti_missions':marti+'/Marti/api/missions',
            'enrollment':enroll+'/',
        }
        probes={}
        def one(item):
            key,url=item
            method='GET'
            return key,_i509_http_request(url,cfg,method=method,timeout=7)
        with ThreadPoolExecutor(max_workers=8) as ex:
            for key,res in ex.map(one,urls.items()): probes[key]=res
        parsed=urlparse(base)
        cert=_i509_cert_probe(parsed.hostname,parsed.port or (443 if parsed.scheme=='https' else 80),cfg) if parsed.scheme=='https' else {'ok':True,'strict_tls_ok':False,'hostname_match':False,'note':'HTTP endpoint; TLS not used.'}
        cot=_i509_cert_probe(cfg.get('cot_host'),cfg.get('cot_port'),cfg)
        capabilities={k:_i509_endpoint_class(probes.get(k)) for k in ('truststore','oauth_token','api_login','groups','missions','marti_contacts','marti_groups','marti_missions','enrollment')}
        result={
            'ok':bool(probes.get('web',{}).get('reachable') and cot.get('ok')),
            'version':'i510',
            'config':_i509_public_ots_config(cfg),
            'endpoints':probes,
            'certificate':cert,
            'cot_tls':cot,
            'capabilities':capabilities,
            'detected_ots_version':_i509_local_ots_version(),
            'summary':{
                'web_reachable':bool(probes.get('web',{}).get('reachable')),
                'strict_web_tls':bool(cert.get('strict_tls_ok')),
                'hostname_match':bool(cert.get('hostname_match')),
                'cot_tls_reachable':bool(cot.get('ok')),
                'truststore_available':capabilities.get('truststore','').startswith('available'),
                'oauth_available':capabilities.get('oauth_token','').startswith('available'),
                'api_login_available':capabilities.get('api_login','').startswith('available'),
                'marti_available':bool(probes.get('marti_root',{}).get('reachable')),
                'enrollment_available':bool(probes.get('enrollment',{}).get('reachable')),
            },
            'tested_at':datetime.now(timezone.utc).isoformat(),
        }
        return result

    def _i509_extract_token(data):
        if isinstance(data,str):
            value=data.strip().strip('"').strip("'")
            return value if value and (' ' not in value) else ''
        if not isinstance(data,dict): return ''
        for key in ('access_token','authentication_token','token','jwt','id_token'):
            val=data.get(key)
            if val: return str(val)
        for key in ('response','user','data'):
            val=data.get(key)
            token=_i509_extract_token(val)
            if token: return token
        return ''

    def _i509_authenticate_remote(cfg,username,password,otp=''):
        username=sanitize_ots_username(username)
        password=str(password or '')
        otp=str(otp or '').strip()
        if not username or not password:
            return {'ok':False,'error':'Username and password are required.'}
        base=cfg['base_url'].rstrip('/')
        attempts=[]
        payload={'username':username,'password':password}
        if otp:
            payload.update({'otp':otp,'totp':otp,'tf_code':otp,'code':otp})

        def request_login(url, body, headers):
            raw={'url':url,'status':0,'headers':{},'set_cookies':[],'body':'','error':''}
            try:
                req=Request(url,data=body,headers={**headers,'Accept':'application/json','User-Agent':'TAK-Map/i510'},method='POST')
                with urlopen(req,timeout=10,context=_i509_ssl_context(cfg)) as resp:
                    data=resp.read(262144).decode('utf-8','replace')
                    raw.update({'status':int(getattr(resp,'status',200) or 200),'headers':dict(resp.headers.items()),'set_cookies':list(resp.headers.get_all('Set-Cookie') or []),'body':data})
            except HTTPError as e:
                try: data=e.read(262144).decode('utf-8','replace')
                except Exception: data=''
                raw.update({'status':int(getattr(e,'code',0) or 0),'headers':dict(e.headers.items()) if e.headers else {},'set_cookies':list(e.headers.get_all('Set-Cookie') or []) if e.headers else [],'body':data,'error':'HTTP '+str(getattr(e,'code',''))})
            except Exception as e:
                raw['error']=str(e)
            return raw

        # OpenTAKServer exposes /oauth/token for TAKX/CloudTAK. Accept both
        # documented JSON/form requests and JSON or raw-JWT response shapes.
        path=cfg.get('oauth_path') or '/oauth/token'
        url=base+path
        for body,h in ((json.dumps(payload).encode(),{'Content-Type':'application/json'}),(urlencode(payload).encode(),{'Content-Type':'application/x-www-form-urlencoded'})):
            raw=request_login(url,body,h)
            attempts.append({'endpoint':path,'status':raw['status'],'error':raw['error']})
            if 200 <= raw['status'] < 300:
                try: obj=json.loads(raw['body'] or '{}')
                except Exception: obj=raw['body']
                token=_i509_extract_token(obj)
                if token:
                    return {'ok':True,'username':username,'auth_method':'oauth-token','token':token,'token_header':'Authorization','token_prefix':'Bearer ','cookies':'','csrf_token':'','attempts':attempts}

        # Flask-Security's documented token flow is POST /api/login with the
        # include_auth_token query parameter. Its token is sent later in the
        # Authentication-Token header rather than as an OAuth bearer token.
        path=cfg.get('api_login_path') or '/api/login'
        token_url=base+path+('&' if '?' in path else '?')+'include_auth_token='
        for body,h in ((json.dumps(payload).encode(),{'Content-Type':'application/json'}),(urlencode(payload).encode(),{'Content-Type':'application/x-www-form-urlencoded'})):
            raw=request_login(token_url,body,h)
            attempts.append({'endpoint':path+'?include_auth_token','status':raw['status'],'error':raw['error']})
            if 200 <= raw['status'] < 300:
                try: obj=json.loads(raw['body'] or '{}')
                except Exception: obj={}
                token=_i509_extract_token(obj)
                if token:
                    return {'ok':True,'username':username,'auth_method':'api-auth-token','token':token,'token_header':'Authentication-Token','token_prefix':'','cookies':'','csrf_token':'','attempts':attempts}

        # Compatibility fallback for deployments that expose only Flask session
        # authentication. Obtain a CSRF token/cookie first, then post credentials.
        login_url=base+path
        cookies=''; csrf=''
        try:
            req=Request(login_url,headers={'Accept':'application/json','User-Agent':'TAK-Map/i510'},method='GET')
            with urlopen(req,timeout=10,context=_i509_ssl_context(cfg)) as resp:
                first=resp.read(262144).decode('utf-8','replace')
                cookies='; '.join(v.split(';',1)[0] for v in (resp.headers.get_all('Set-Cookie') or []))
                try: obj=json.loads(first or '{}')
                except Exception: obj={}
                csrf=str(((obj.get('response') or {}).get('csrf_token') if isinstance(obj,dict) else '') or '')
        except Exception as e:
            attempts.append({'endpoint':path+' GET csrf','status':0,'error':str(e)})
        if csrf or cookies:
            headers={'Content-Type':'application/json','Referer':base+'/' }
            if csrf: headers['X-XSRF-TOKEN']=csrf
            if cookies: headers['Cookie']=cookies
            raw=request_login(login_url,json.dumps(payload).encode(),headers)
            attempts.append({'endpoint':path+' session','status':raw['status'],'error':raw['error']})
            if 200 <= raw['status'] < 300:
                all_cookies=[*([cookies] if cookies else []),*(v.split(';',1)[0] for v in raw.get('set_cookies',[]))]
                cookies='; '.join(dict.fromkeys(v for v in all_cookies if v))
                try: obj=json.loads(raw['body'] or '{}')
                except Exception: obj={}
                returned_csrf=str(((obj.get('response') or {}).get('csrf_token') if isinstance(obj,dict) else '') or '')
                return {'ok':True,'username':username,'auth_method':'api-session','token':'','token_header':'','token_prefix':'','cookies':cookies,'csrf_token':returned_csrf or csrf,'attempts':attempts}
        return {'ok':False,'error':'OpenTAKServer rejected the credentials or no supported login endpoint completed authentication.','attempts':attempts}

    def _i509_user_capabilities(cfg,auth):
        base=cfg['api_url'].rstrip('/')
        marti=cfg['marti_url'].rstrip('/')
        headers={}
        if auth.get('token'):
            header=str(auth.get('token_header') or 'Authorization')
            headers[header]=str(auth.get('token_prefix') or '')+auth['token']
        if auth.get('cookies'): headers['Cookie']=auth['cookies']
        if auth.get('csrf_token'):
            headers['X-XSRF-TOKEN']=auth['csrf_token']; headers['Referer']=cfg['base_url'].rstrip('/')+'/'
        urls={'me':base+'/api/me','groups':base+'/api/groups','missions':base+'/api/missions','contacts':marti+'/Marti/api/contacts/all','marti_groups':marti+'/Marti/api/groups','marti_missions':marti+'/Marti/api/missions'}
        out={}
        for key,url in urls.items():
            p=_i509_http_request(url,cfg,headers=headers,timeout=8)
            out[key]={'status':p.get('status'), 'state':_i509_endpoint_class(p), 'preview':p.get('body_preview','')[:320]}
        return out

    def _i509_auth_test(payload):
        cfg=_i509_normalize_ots_config(payload or {},_i509_load_ots_config())
        auth=_i509_authenticate_remote(cfg,payload.get('username',''),payload.get('password',''),payload.get('otp',''))
        if not auth.get('ok'): return auth
        public={k:v for k,v in auth.items() if k not in ('token','cookies','csrf_token')}
        public['capabilities']=_i509_user_capabilities(cfg,auth)
        public['cot_tls']=_i509_cert_probe(cfg.get('cot_host'),cfg.get('cot_port'),cfg)
        public['cot_auth_prototype']={'ready':bool(public['cot_tls'].get('strict_tls_ok')),'credential_mode':'username-password-in-memory plus enrolled client certificate when required','private_key_persisted_in_browser':False}
        return public

    def _i509_pkcs12_certificates(blob,passwords):
        certs=[]
        fd,path=tempfile.mkstemp(prefix='tak-map-ots-trust-',suffix='.p12')
        try:
            with os.fdopen(fd,'wb') as f: f.write(blob)
            for password in passwords:
                try:
                    r=subprocess.run(['openssl','pkcs12','-in',path,'-nokeys','-passin','fd:0'],input=(str(password)+'\n').encode(),capture_output=True,timeout=15)
                except Exception:
                    continue
                if r.returncode==0:
                    text=(r.stdout or b'').decode('utf-8','ignore')
                    certs.extend(re.findall(r'-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----',text,re.S))
                    if certs: break
        finally:
            try: os.unlink(path)
            except Exception: pass
        return certs

    def _i509_install_truststore(payload):
        cfg=_i509_normalize_ots_config(payload or {},_i509_load_ots_config())
        url=cfg['base_url'].rstrip('/')+cfg['truststore_path']
        # Bootstrap download is intentionally unverified; the operator must compare
        # the displayed fingerprint/SAN before enabling strict trust.
        req=Request(url,headers={'User-Agent':'TAK-Map/i510','Accept':'*/*'})
        with urlopen(req,timeout=12,context=ssl._create_unverified_context()) as resp:
            body=resp.read(8*1024*1024)
        certs=[]; pkcs12_blobs=[]
        text=body.decode('utf-8','ignore')
        certs.extend(re.findall(r'-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----',text,re.S))
        if not certs and body[:2]==b'PK':
            try:
                with zipfile.ZipFile(io.BytesIO(body)) as z:
                    for name in z.namelist():
                        lower=name.lower()
                        if lower.endswith(('.crt','.cer','.pem')):
                            raw=z.read(name).decode('utf-8','ignore')
                            certs.extend(re.findall(r'-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----',raw,re.S))
                        elif lower.endswith(('.p12','.pfx')):
                            pkcs12_blobs.append(z.read(name))
            except Exception: pass
        if not certs and not pkcs12_blobs:
            pkcs12_blobs.append(body)
        if not certs:
            requested=str((payload or {}).get('truststore_password') or '')
            passwords=[]
            for value in (requested,'atakatak',''):
                if value not in passwords: passwords.append(value)
            for blob in pkcs12_blobs:
                certs.extend(_i509_pkcs12_certificates(blob,passwords))
                if certs: break
        if not certs:
            raise ValueError('The truststore was downloaded, but its public CA certificates could not be extracted. Enter the truststore password (the OpenTAKServer default is atakatak), or export the public CA as PEM and enter its path manually.')
        TAK_MAP_OTS_TRUST_DIR.mkdir(parents=True,exist_ok=True)
        path=TAK_MAP_OTS_TRUST_DIR/'opentakserver-ca-chain.crt'
        bundle='\n'.join(certs)+'\n'
        tmp=path.with_suffix('.tmp')
        tmp.write_text(bundle); os.chmod(tmp,0o640); tmp.replace(path)
        identities=[]
        for pem in certs:
            decoded=_i509_decode_pem_cert(pem)
            der=b''
            try: der=ssl.PEM_cert_to_DER_cert(pem)
            except Exception: pass
            identities.append({
                'subject':{k:v for group in decoded.get('subject',[]) for k,v in group},
                'issuer':{k:v for group in decoded.get('issuer',[]) for k,v in group},
                'not_before':str(decoded.get('notBefore') or ''),
                'not_after':str(decoded.get('notAfter') or ''),
                'sha256':hashlib.sha256(der if isinstance(der,bytes) else der.encode('latin1')).hexdigest() if der else '',
            })
        cfg['ca_cert_path']=str(path)
        saved=_i509_save_ots_config(cfg)
        return {'ok':True,'path':str(path),'certificates':len(certs),'certificate_identities':identities,'config':_i509_public_ots_config(saved),'message':'OpenTAKServer public CA chain installed. Verify the displayed subject, issuer, and SHA-256 fingerprint before enabling normal-user login.'}

    def _i509_create_session(username,password,auth_mode='ots-user',is_admin=False,auth=None):
        cleanup_tak_map_sessions(); token=secrets.token_urlsafe(32)
        auth=auth or {}
        with TAK_MAP_SESSIONS_LOCK:
            TAK_MAP_SESSIONS[token]={
                'username':str(username or ''), 'password':str(password or ''),
                'auth_mode':auth_mode, 'is_admin':bool(is_admin),
                'ots_token':str(auth.get('token') or ''), 'ots_token_header':str(auth.get('token_header') or ''),
                'ots_token_prefix':str(auth.get('token_prefix') or ''), 'ots_cookies':str(auth.get('cookies') or ''),
                'ots_csrf_token':str(auth.get('csrf_token') or ''), 'ots_auth_method':str(auth.get('auth_method') or ''),
                'created':time.time(), 'expires':time.time()+TAK_MAP_SESSION_TTL_SECONDS,
            }
        return token

    def _i509_session_public(sess):
        sess=sess or {}
        return {'ok':bool(sess),'username':sess.get('username',''),'auth_mode':sess.get('auth_mode','legacy'),'is_admin':bool(sess.get('is_admin')),'ots_authenticated':str(sess.get('auth_mode','')).startswith('ots-'),'expires_in':TAK_MAP_SESSION_TTL_SECONDS}

    def _i509_require_config_admin(handler):
        sess=handler._tak_map_session()
        if not sess or not sess.get('is_admin'):
            handler._send_json({'ok':False,'error':'Configure OTS requires the Local Recovery administrator login.','admin_required':True},403)
            return None
        return sess

    _i509_original_handle_login=Handler._handle_tak_map_login
    def _i509_handle_tak_map_login(self):
        if not self._is_secure_request() and not ALLOW_INSECURE_UPLOAD_AUTH:
            return self._send_json({'ok':False,'error':'TAK Map login requires HTTPS.'},403)
        f=self._read_form(); mode=str(f.get('mode') or '').strip().lower()
        username=sanitize_ots_username(f.get('username','')); password=str(f.get('password') or ''); otp=str(f.get('otp') or '')
        cfg=_i509_load_ots_config()
        use_recovery=(mode in ('recovery','local-admin','admin')) or not (cfg.get('enabled') and cfg.get('login_enabled'))
        if use_recovery:
            try: ok,msg=authenticate_opentak_admin(username,password)
            except Exception as e: return self._send_json({'ok':False,'error':'Local Recovery authentication error: '+str(e),'admin_required':True},500)
            if not ok: return self._send_json({'ok':False,'error':msg,'admin_required':True},403)
            token=_i509_create_session(username,password,'local-recovery',True,{'auth_method':'local-ots-admin-verification'})
            return self._send_json({'ok':True,'username':username,'auth_mode':'local-recovery','is_admin':True,'expires_in':TAK_MAP_SESSION_TTL_SECONDS},200,headers={'Set-Cookie':self._tak_map_session_cookie(token)})
        auth=_i509_authenticate_remote(cfg,username,password,otp)
        if not auth.get('ok'):
            return self._send_json({'ok':False,'error':auth.get('error') or 'OpenTAKServer login failed.','attempts':auth.get('attempts',[])},401)
        token=_i509_create_session(username,password,'ots-user',False,auth)
        return self._send_json({'ok':True,'username':username,'auth_mode':'ots-user','is_admin':False,'expires_in':TAK_MAP_SESSION_TTL_SECONDS},200,headers={'Set-Cookie':self._tak_map_session_cookie(token)})
    Handler._handle_tak_map_login=_i509_handle_tak_map_login

    _i509_prev_get=Handler.do_GET
    def _i509_do_get(self):
        parsed=urlparse(self.path)
        if parsed.path=='/api/tak-map/ots/public-status':
            cfg=_i509_public_ots_config()
            return self._send_json({'ok':True,'version':'i510','enabled':bool(cfg.get('enabled')),'login_enabled':bool(cfg.get('login_enabled')),'configured':bool(cfg.get('configured')),'display_name':cfg.get('display_name')})
        if parsed.path=='/api/tak-map/ots/session':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            return self._send_json(_i509_session_public(self._tak_map_session()))
        if parsed.path=='/api/tak-map/ots/config':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            if not _i509_require_config_admin(self): return
            return self._send_json({'ok':True,'version':'i510','config':_i509_public_ots_config()})
        if parsed.path.startswith('/api/tak-map/tak-client/'):
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            if not _i509_require_config_admin(self): return
        return _i509_prev_get(self)
    Handler.do_GET=_i509_do_get

    _i509_prev_post=Handler.do_POST
    def _i509_do_post(self):
        parsed=urlparse(self.path)
        if parsed.path=='/api/tak-map/login': return self._handle_tak_map_login()
        if parsed.path.startswith('/api/tak-map/tak-client/'):
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            if not _i509_require_config_admin(self): return
        if parsed.path.startswith('/api/tak-map/ots/'):
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            if not _i509_require_config_admin(self): return
            payload=_read_json_body(self)
            try:
                if parsed.path=='/api/tak-map/ots/discover': return self._send_json(_i509_discover_ots(payload))
                if parsed.path=='/api/tak-map/ots/save':
                    cfg=_i509_save_ots_config(payload)
                    return self._send_json({'ok':True,'version':'i510','config':_i509_public_ots_config(cfg),'message':'OpenTAKServer connection configuration saved.'})
                if parsed.path=='/api/tak-map/ots/auth-test': return self._send_json(_i509_auth_test(payload))
                if parsed.path=='/api/tak-map/ots/install-truststore': return self._send_json(_i509_install_truststore(payload))
            except Exception as e:
                return self._send_json({'ok':False,'error':str(e)},400)
            return self._send_json({'ok':False,'error':'Unknown Configure OTS action.'},404)
        return _i509_prev_post(self)
    Handler.do_POST=_i509_do_post

    _i509_prev_config=tak_map_config
    def tak_map_config():
        cfg=_i509_prev_config()
        if isinstance(cfg,dict):
            cfg=dict(cfg); cfg['tak_map_iteration']='i510'
            cfg['ots_integration']={'version':'i510','configured':bool(_i509_load_ots_config().get('base_url')),'normal_user_login':bool(_i509_load_ots_config().get('enabled') and _i509_load_ots_config().get('login_enabled')),'local_recovery_login':True,'chat_ui':False,'per_user_session_foundation':True}
        return cfg
    globals()['tak_map_config']=tak_map_config

    _I509_OTS_UI=r'''<script id="takMapConfigureOtsV509">
(function(w,d){'use strict';const V='i510',by=id=>d.getElementById(id),esc=s=>String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));let legacyOpen=null,lastDiscovery=null;
function css(){if(by('otsStyleV509'))return;const s=d.createElement('style');s.id='otsStyleV509';s.textContent=`.ots-backdrop-v509{position:fixed;inset:0;z-index:6900;display:none;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,.68)}.ots-backdrop-v509.active{display:flex}.ots-modal-v509{width:min(980px,calc(100vw - 24px));max-height:calc(100vh - 30px);overflow:auto;border:1px solid rgba(66,211,255,.3);border-radius:18px;background:linear-gradient(180deg,#111b25,#070b10);box-shadow:0 24px 80px rgba(0,0,0,.64);padding:15px}.ots-head-v509{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;border-bottom:1px solid rgba(255,255,255,.1);padding-bottom:11px;margin-bottom:12px}.ots-head-v509 h2{margin:0;font-size:1rem;letter-spacing:.08em;text-transform:uppercase}.ots-grid-v509{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:12px}.ots-card-v509{border:1px solid rgba(255,255,255,.1);border-radius:13px;background:rgba(255,255,255,.035);padding:12px}.ots-fields-v509{display:grid;grid-template-columns:1fr 1fr;gap:9px}.ots-fields-v509 .wide{grid-column:1/-1}.ots-card-v509 label{display:block;color:#9fb1b9;font-size:.75rem;font-weight:850}.ots-card-v509 input,.ots-card-v509 select{width:100%;margin-top:4px;background:#071018;color:#edf4f7;border:1px solid #314454;border-radius:9px;padding:8px}.ots-check-v509{display:flex!important;align-items:center;gap:8px;margin:8px 0}.ots-check-v509 input{width:auto;margin:0}.ots-actions-v509{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.ots-primary-v509{border-color:rgba(66,211,255,.5)!important;background:rgba(66,211,255,.12)!important}.ots-output-v509{white-space:pre-wrap;min-height:120px;max-height:340px;overflow:auto;background:#05090d;border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:10px;font-size:.73rem;line-height:1.38}.ots-status-v509{display:grid;gap:7px}.ots-line-v509{display:grid;grid-template-columns:145px 1fr;gap:7px;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.07);font-size:.76rem}.ots-ok-v509{color:#8ff0b8}.ots-warn-v509{color:#ffd58a}.ots-bad-v509{color:#ffaaa4}.ots-advanced-v509{margin-top:10px;border-top:1px solid rgba(255,255,255,.08);padding-top:8px}.ots-auth-v509{display:grid;grid-template-columns:1fr 1fr 120px;gap:7px;margin-top:10px}.ots-auth-v509 input{margin-top:0}.ots-note-v509{font-size:.76rem;color:#9fb1b9;line-height:1.4;margin-top:8px}@media(max-width:760px){.ots-grid-v509,.ots-fields-v509,.ots-auth-v509{grid-template-columns:1fr}.ots-fields-v509 .wide{grid-column:auto}}`;d.head.appendChild(s)}
function modal(){css();if(by('otsModalV509'))return;d.body.insertAdjacentHTML('beforeend',`<div id="otsModalV509" class="ots-backdrop-v509" aria-hidden="true"><section class="ots-modal-v509" role="dialog" aria-modal="true"><header class="ots-head-v509"><div><h2>Configure OTS</h2><div class="muted">Connect this TAK Map installation to any compatible OpenTAKServer deployment.</div></div><button type="button" id="otsCloseV509">Close</button></header><div class="ots-grid-v509"><div class="ots-card-v509"><div class="ots-fields-v509"><label>Display name<input id="otsDisplayV509" value="OpenTAKServer"></label><label class="wide">Web / API address<input id="otsBaseV509" placeholder="https://opentakserver"></label><label class="wide">API address<input id="otsApiV509" placeholder="Defaults to Web / API address"></label><label>Marti HTTPS address<input id="otsMartiV509" placeholder="https://host:8443"></label><label>Enrollment address<input id="otsEnrollV509" placeholder="https://host:8446"></label><label>SSL CoT host<input id="otsCotHostV509" placeholder="opentakserver"></label><label>SSL CoT port<input id="otsCotPortV509" type="number" min="1" max="65535" value="8089"></label><label class="wide">Public CA certificate path<input id="otsCaV509" placeholder="/var/lib/tak-map/ots_trust/opentakserver-ca-chain.crt"></label><label class="wide">Truststore password (not saved)<input id="otsTrustPassV509" type="password" placeholder="Default: atakatak" autocomplete="new-password"></label></div><label class="ots-check-v509"><input id="otsVerifyV509" type="checkbox" checked> Require valid TLS chain and hostname</label><label class="ots-check-v509"><input id="otsEnabledV509" type="checkbox"> Enable OpenTAKServer integration</label><label class="ots-check-v509"><input id="otsLoginEnabledV509" type="checkbox"> Use OpenTAKServer accounts for normal TAK Map login</label><div class="ots-actions-v509"><button id="otsDiscoverV509" class="layer-button ots-primary-v509">Discover & Test</button><button id="otsTrustV509" class="layer-button">Download Public CA</button><button id="otsSaveV509" class="layer-button">Save Configuration</button></div><div class="ots-auth-v509"><input id="otsTestUserV509" placeholder="Test username"><input id="otsTestPassV509" type="password" placeholder="Password (not saved)"><input id="otsTestOtpV509" placeholder="2FA code"><button id="otsAuthV509" class="layer-button">Test User Login</button></div><div class="ots-note-v509">Passwords and user tokens are never written to disk. Full chat is not included in this foundation build.</div><details class="ots-advanced-v509"><summary>Advanced service identity / legacy TAK Client setup</summary><p class="ots-note-v509">Publishing features that still use the TAK Map service identity remain available here.</p><button id="otsLegacyClientV509" class="layer-button">Open Service Identity Setup</button></details><pre id="otsOutputV509" class="ots-output-v509">Ready.</pre></div><aside class="ots-card-v509"><b>Compatibility Status</b><div id="otsStatusV509" class="ots-status-v509 muted">No discovery has run.</div></aside></div></section></div>`);by('otsCloseV509').onclick=close;by('otsModalV509').onclick=e=>{if(e.target===by('otsModalV509'))close()};by('otsDiscoverV509').onclick=discover;by('otsSaveV509').onclick=save;by('otsAuthV509').onclick=authTest;by('otsTrustV509').onclick=trust;by('otsLegacyClientV509').onclick=()=>{close();if(legacyOpen)legacyOpen()}}
function values(){return {display_name:by('otsDisplayV509').value,base_url:by('otsBaseV509').value,api_url:by('otsApiV509').value,marti_url:by('otsMartiV509').value,enrollment_url:by('otsEnrollV509').value,cot_host:by('otsCotHostV509').value,cot_port:Number(by('otsCotPortV509').value||8089),ca_cert_path:by('otsCaV509').value,truststore_password:by('otsTrustPassV509').value,verify_tls:by('otsVerifyV509').checked,enabled:by('otsEnabledV509').checked,login_enabled:by('otsLoginEnabledV509').checked}}
function fill(c){c=c||{};by('otsDisplayV509').value=c.display_name||'OpenTAKServer';by('otsBaseV509').value=c.base_url||'';by('otsApiV509').value=c.api_url||'';by('otsMartiV509').value=c.marti_url||'';by('otsEnrollV509').value=c.enrollment_url||'';by('otsCotHostV509').value=c.cot_host||'';by('otsCotPortV509').value=c.cot_port||8089;by('otsCaV509').value=c.ca_cert_path||'';by('otsVerifyV509').checked=c.verify_tls!==false;by('otsEnabledV509').checked=!!c.enabled;by('otsLoginEnabledV509').checked=!!c.login_enabled}
function output(t,bad){const e=by('otsOutputV509');e.textContent=String(t||'');e.classList.toggle('ots-bad-v509',!!bad)}
function render(j){lastDiscovery=j;const s=j.summary||{},cert=j.certificate||{},cot=j.cot_tls||{},caps=j.capabilities||{};const row=(a,b,cls='')=>`<div class="ots-line-v509"><b>${esc(a)}</b><span class="${cls}">${esc(b)}</span></div>`;const problem=j.primary_problem||'';by('otsStatusV509').innerHTML=(problem?row('Primary issue',problem,'ots-bad-v509'):'')+row('Web endpoint',s.web_reachable?'Reachable':'Unavailable',s.web_reachable?'ots-ok-v509':'ots-bad-v509')+row('TLS validation',s.strict_web_tls?'Valid':(cert.strict_tls_error||'Not validated'),s.strict_web_tls?'ots-ok-v509':'ots-warn-v509')+row('Hostname/SAN',s.hostname_match?'Match':(cert.hostname_error||'No match'),s.hostname_match?'ots-ok-v509':'ots-warn-v509')+row('SSL CoT',s.cot_tls_reachable?'Reachable':'Unavailable',s.cot_tls_reachable?'ots-ok-v509':'ots-bad-v509')+row('Enrollment',s.enrollment_available?'Detected':'Not detected',s.enrollment_available?'ots-ok-v509':'ots-warn-v509')+row('OAuth login',caps.oauth_token||'Unknown')+row('Groups',caps.groups||caps.marti_groups||'Unknown')+row('Missions',caps.missions||caps.marti_missions||'Unknown')+row('Contacts',caps.marti_contacts||'Unknown')+row('OTS version',j.detected_ots_version||'Remote version not disclosed');const lead=j.ok?'Discovery complete.':'Discovery incomplete: '+(problem||'Review the detailed checks below.');output(lead+'\n\n'+JSON.stringify(j,null,2),!j.ok)}
async function api(path,payload){const r=await fetch(path,{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload||{})});const j=await r.json().catch(()=>({ok:false,error:'Invalid server response'}));if(!r.ok||j.ok===false)throw new Error(j.error||('HTTP '+r.status));return j}
async function load(){modal();try{const r=await fetch('/api/tak-map/ots/config',{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||('HTTP '+r.status));fill(j.config);if(j.config.last_discovery&&Object.keys(j.config.last_discovery).length)render(j.config.last_discovery);else output('Configuration loaded. Run Discover & Test.')}catch(e){output('Configure OTS requires Local Recovery administrator access.\n'+e,true)}}
async function discover(){try{output('Discovering OpenTAKServer endpoints...');const r=await fetch('/api/tak-map/ots/discover',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json'},body:JSON.stringify(values())});const j=await r.json().catch(()=>null);if(!r.ok)throw new Error((j&&j.error)||('HTTP '+r.status));if(!j||typeof j!=='object')throw new Error('Invalid server response');render(j)}catch(e){output('Discovery request failed: '+String(e&&e.message||e),true)}}
async function save(){try{output('Saving...');const p=values();if(lastDiscovery)p.last_discovery=lastDiscovery;const j=await api('/api/tak-map/ots/save',p);fill(j.config);output(j.message||'Saved.')}catch(e){output('Save failed: '+e,true)}}
async function authTest(){try{output('Testing user authentication...');const p={...values(),username:by('otsTestUserV509').value,password:by('otsTestPassV509').value,otp:by('otsTestOtpV509').value};const j=await api('/api/tak-map/ots/auth-test',p);by('otsTestPassV509').value='';output(JSON.stringify(j,null,2),false)}catch(e){by('otsTestPassV509').value='';output('Authentication test failed: '+e,true)}}
async function trust(){if(!confirm('Download the public CA from the configured OpenTAKServer without prior TLS verification? Compare the displayed certificate identity before enabling login.'))return;try{output('Downloading and extracting the public CA...');const j=await api('/api/tak-map/ots/install-truststore',values());fill(j.config);by('otsTrustPassV509').value='';if(j.discovery)render(j.discovery);const extraction=j.extraction||{};const details=[j.message,j.path,'Extraction mode: '+(extraction.mode||'PEM'),'Certificates installed: '+String(j.certificates||0),JSON.stringify(j.certificate_identities||[],null,2)];if(j.discovery)details.push('Strict discovery: '+(j.discovery.ok?'complete':(j.discovery.primary_problem||'incomplete')));output(details.join('\n'),!!(j.discovery&&j.discovery.ok===false))}catch(e){by('otsTrustPassV509').value='';output('CA installation failed: '+String(e&&e.message||e),true)}}
function open(){modal();by('otsModalV509').classList.add('active');by('otsModalV509').setAttribute('aria-hidden','false');load()}
function close(){const m=by('otsModalV509');if(m){m.classList.remove('active');m.setAttribute('aria-hidden','true')}}
function install(){try{localStorage.setItem('takMapTakClientSetupDismissed','1')}catch(_){};const rem=by('takClientReminder');if(rem){rem.classList.remove('active');rem.style.display='none'}const b=by('takClientSetupBtn');if(b){b.textContent='Configure OTS';b.title='Configure OpenTAKServer';b.onclick=e=>{e.preventDefault();open()}}if(!legacyOpen&&typeof w.openTakClientSetup==='function'&&w.openTakClientSetup!==open)legacyOpen=w.openTakClientSetup;w.openConfigureOTS=open;w.closeConfigureOTS=close;w.openTakClientSetup=open;fetch('/api/tak-map/ots/session',{cache:'no-store'}).then(r=>r.json()).then(j=>{if(b&&!j.is_admin)b.style.display='none'}).catch(()=>{})}
if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',()=>setTimeout(install,180),{once:true});else setTimeout(install,180);[700,1600,3200].forEach(ms=>setTimeout(install,ms));w.TakMapOtsFoundationV509=Object.freeze({version:V,open,discover,values});
})(window,document);
</script>'''

    _I509_LOGIN_UI=r'''<script id="takMapOtsLoginV509">
(function(d){'use strict';function boot(){const old=d.getElementById('takMapLoginForm');if(!old)return;const form=old.cloneNode(true);old.replaceWith(form);const sub=form.querySelector('.sub'),err=d.getElementById('takMapError'),btn=d.getElementById('takMapLoginButton');let recovery=false,configured=false,displayName='OpenTAKServer';const controls=d.createElement('div');controls.innerHTML='<label id="otsOtpLabelV509" style="display:none">2FA code<input id="otsOtpV509" autocomplete="one-time-code" inputmode="numeric"></label><button id="otsRecoveryV509" type="button" style="margin-top:10px;background:transparent;border-color:rgba(255,255,255,.18);color:#aebdc6">Local Recovery Login</button><div id="otsLoginStateV509" style="margin-top:9px;color:#91a4af;font-size:.78rem"></div>';btn.insertAdjacentElement('afterend',controls);const state=d.getElementById('otsLoginStateV509'),toggle=d.getElementById('otsRecoveryV509');function mode(){const otpLabel=d.getElementById('otsOtpLabelV509');if(otpLabel)otpLabel.style.display=recovery?'none':'block';if(recovery){sub.textContent='Local recovery: OpenTAKServer administrator verification';toggle.textContent=configured?'Use OpenTAKServer User Login':'Recovery login is currently required';state.textContent='Recovery sessions can configure OTS and administer TAK Map.'}else{sub.textContent='Sign in with your OpenTAKServer account';toggle.textContent='Local Recovery Login';state.textContent='Connected to '+displayName+'. Your OpenTAKServer identity will be used for future contacts, missions, groups, and chat.'}}toggle.onclick=()=>{if(!configured)return;recovery=!recovery;mode()};fetch('/api/tak-map/ots/public-status',{cache:'no-store'}).then(r=>r.json()).then(j=>{configured=!!(j.enabled&&j.login_enabled);displayName=j.display_name||'OpenTAKServer';recovery=!configured;mode()}).catch(()=>{recovery=true;mode()});form.addEventListener('submit',async e=>{e.preventDefault();err.style.display='none';btn.disabled=true;btn.textContent='Checking...';try{const body=new URLSearchParams({username:d.getElementById('username').value,password:d.getElementById('password').value,otp:(d.getElementById('otsOtpV509')||{}).value||'',mode:recovery?'recovery':'ots'});const r=await fetch('/api/tak-map/login',{method:'POST',body});const j=await r.json().catch(()=>({error:'Login failed. Server did not return JSON.'}));if(!r.ok||!j.ok)throw new Error(j.error||('HTTP '+r.status));location.href='/tak-map'}catch(e2){err.textContent=String(e2.message||e2);err.style.display='block';btn.disabled=false;btn.textContent='Enter TAK Map'}})}if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})(document);
</script>'''

    def _i509_patch_version(html):
        if not isinstance(html,str): return html
        html=html.replace('1.3.0-i508','1.3.0-i510').replace('TAKDashboard/i508','TAKDashboard/i510').replace('TAK-Map/1.3.0 i508','TAK-Map/1.3.0 i510')
        html=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i510\2',html)
        html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i510\2',html)
        return html
    def _i509_patch_html(html,login=False):
        html=_i509_patch_version(html)
        if not isinstance(html,str): return html
        addon=_I509_LOGIN_UI if login else _I509_OTS_UI
        marker='takMapOtsLoginV509' if login else 'takMapConfigureOtsV509'
        if marker not in html: html=html.replace('</body></html>',addon+'</body></html>')
        return html
    TAK_MAP_HTML=_i509_patch_html(TAK_MAP_HTML,False); INDEX_HTML=TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML=_i509_patch_html(TAK_MAP_LOGIN_HTML,True); LOGIN_HTML=_i509_patch_version(LOGIN_HTML)
except Exception as _i509_exc:
    try: print('TAK Map i509 OTS foundation patch failed:',_i509_exc)
    except Exception: pass
# --- end TAK Map i509 generic OpenTAKServer foundation ---


# --- TAK Map i510 Configure OTS truststore and partial-discovery correction ---
try:
    import grp as _i510_grp

    def _i510_clean_openssl_error(raw):
        text=(raw or b'').decode('utf-8','replace') if isinstance(raw,(bytes,bytearray)) else str(raw or '')
        text=' '.join(line.strip() for line in text.splitlines() if line.strip())
        return text[:1600]

    def _i510_pem_blocks(text):
        return re.findall(r'-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----',str(text or ''),re.S)

    def _i510_cert_is_ca(pem):
        fd,path=tempfile.mkstemp(prefix='tak-map-ots-ca-check-',suffix='.pem')
        try:
            with os.fdopen(fd,'w') as f: f.write(str(pem).strip()+'\n')
            r=subprocess.run(['openssl','x509','-in',path,'-noout','-text'],capture_output=True,timeout=12)
            if r.returncode!=0:
                return False,_i510_clean_openssl_error(r.stderr or r.stdout)
            normalized=''.join((r.stdout or b'').decode('utf-8','ignore').upper().split())
            return 'CA:TRUE' in normalized,''
        except Exception as e:
            return False,str(e)
        finally:
            try: os.unlink(path)
            except Exception: pass

    def _i510_pkcs12_certificates_detailed(blob,passwords):
        certs=[]; attempts=[]
        fd,path=tempfile.mkstemp(prefix='tak-map-ots-trust-',suffix='.p12')
        try:
            with os.fdopen(fd,'wb') as f: f.write(blob)
            for password_index,password in enumerate(passwords):
                label='provided' if password_index==0 and str(password) else ('default' if str(password)=='atakatak' else 'empty')
                for legacy in (False,True):
                    cmd=['openssl','pkcs12']+(['-legacy'] if legacy else [])+['-in',path,'-nokeys','-passin','fd:0']
                    try:
                        r=subprocess.run(cmd,input=(str(password)+'\n').encode(),capture_output=True,timeout=20)
                        error=_i510_clean_openssl_error(r.stderr)
                    except Exception as e:
                        r=None; error=str(e)
                    attempts.append({'mode':'legacy' if legacy else 'standard','password_source':label,'returncode':None if r is None else r.returncode,'error':error})
                    if r is not None and r.returncode==0:
                        found=_i510_pem_blocks((r.stdout or b'').decode('utf-8','ignore'))
                        if found:
                            certs.extend(found)
                            return certs,{'mode':'pkcs12-legacy' if legacy else 'pkcs12-standard','used_legacy':legacy,'attempts':attempts}
        finally:
            try: os.unlink(path)
            except Exception: pass
        return certs,{'mode':'pkcs12-failed','used_legacy':False,'attempts':attempts}

    def _i509_pkcs12_certificates(blob,passwords):
        certs,_details=_i510_pkcs12_certificates_detailed(blob,passwords)
        return certs

    _i510_discover_original=_i509_discover_ots
    def _i509_discover_ots(payload=None):
        result=_i510_discover_original(payload)
        result['version']='i510'
        s=result.get('summary') or {}; cert=result.get('certificate') or {}; cot=result.get('cot_tls') or {}
        problem=''
        if cert.get('ok') and not s.get('strict_web_tls'):
            problem='Web/API TLS validation failed: '+str(cert.get('strict_tls_error') or cert.get('error') or 'the CA chain is not trusted.')
        elif not s.get('web_reachable'):
            problem='Web/API endpoint is not reachable: '+str((result.get('endpoints') or {}).get('web',{}).get('error') or 'connection failed.')
        elif not s.get('hostname_match'):
            problem='Web/API hostname does not match the certificate SAN/CN.'
        elif not s.get('cot_tls_reachable'):
            problem='SSL CoT endpoint is not reachable: '+str(cot.get('error') or 'connection failed.')
        elif not cot.get('strict_tls_ok'):
            problem='SSL CoT TLS validation failed: '+str(cot.get('strict_tls_error') or 'the CA chain is not trusted.')
        elif not cot.get('hostname_match'):
            problem='SSL CoT hostname does not match the certificate SAN/CN.'
        result['primary_problem']=problem
        result['ok']=not bool(problem)
        return result

    def _i510_unique_ca_certificates(certs):
        out=[]; seen=set(); rejected=[]
        for pem in certs:
            try:
                der=ssl.PEM_cert_to_DER_cert(pem)
                raw=der if isinstance(der,bytes) else der.encode('latin1')
                digest=hashlib.sha256(raw).hexdigest()
            except Exception as e:
                rejected.append('Invalid PEM certificate: '+str(e)); continue
            if digest in seen: continue
            is_ca,error=_i510_cert_is_ca(pem)
            if not is_ca:
                rejected.append(error or 'Certificate did not contain CA:TRUE.'); continue
            seen.add(digest); out.append(str(pem).strip())
        return out,rejected

    def _i510_atomic_write_ca(path,bundle):
        path=Path(path)
        path.parent.mkdir(parents=True,exist_ok=True)
        try: os.chmod(path.parent,0o750)
        except Exception: pass
        fd,tmp_name=tempfile.mkstemp(prefix=path.name+'.',suffix='.tmp',dir=str(path.parent))
        tmp=Path(tmp_name)
        try:
            with os.fdopen(fd,'w') as f:
                f.write(bundle)
                f.flush(); os.fsync(f.fileno())
            os.chmod(tmp,0o640)
            os.replace(tmp,path)
            try:
                gid=_i510_grp.getgrnam('takmap').gr_gid
                os.chown(path,0,gid)
            except Exception:
                pass
            os.chmod(path,0o640)
        finally:
            try:
                if tmp.exists(): tmp.unlink()
            except Exception: pass

    def _i509_install_truststore(payload):
        cfg=_i509_normalize_ots_config(payload or {},_i509_load_ots_config())
        if not cfg.get('base_url'):
            raise ValueError('Enter the OpenTAKServer Web/API address first.')
        url=cfg['base_url'].rstrip('/')+cfg['truststore_path']
        req=Request(url,headers={'User-Agent':'TAK-Map/i510','Accept':'*/*'})
        try:
            with urlopen(req,timeout=15,context=ssl._create_unverified_context()) as resp:
                body=resp.read(16*1024*1024)
        except Exception as e:
            raise ValueError('Public truststore download failed: '+str(e))
        if not body:
            raise ValueError('OpenTAKServer returned an empty truststore response.')
        certs=[]; pkcs12_blobs=[]; extraction={'mode':'unknown','used_legacy':False,'attempts':[]}
        text=body.decode('utf-8','ignore')
        certs.extend(_i510_pem_blocks(text))
        if certs:
            extraction={'mode':'pem','used_legacy':False,'attempts':[]}
        elif body[:2]==b'PK':
            try:
                with zipfile.ZipFile(io.BytesIO(body)) as z:
                    for name in z.namelist():
                        lower=name.lower()
                        if lower.endswith(('.crt','.cer','.pem')):
                            certs.extend(_i510_pem_blocks(z.read(name).decode('utf-8','ignore')))
                        elif lower.endswith(('.p12','.pfx')):
                            pkcs12_blobs.append(z.read(name))
                extraction={'mode':'zip','used_legacy':False,'attempts':[]}
            except Exception as e:
                raise ValueError('The downloaded truststore ZIP could not be read: '+str(e))
        if not certs and not pkcs12_blobs:
            pkcs12_blobs.append(body)
        if not certs:
            requested=str((payload or {}).get('truststore_password') or '')
            passwords=[]
            for value in (requested,'atakatak',''):
                if value not in passwords: passwords.append(value)
            all_attempts=[]
            for blob in pkcs12_blobs:
                found,details=_i510_pkcs12_certificates_detailed(blob,passwords)
                all_attempts.extend(details.get('attempts') or [])
                if found:
                    certs.extend(found); extraction=details; break
            if not certs:
                last_error=''
                for attempt in reversed(all_attempts):
                    if attempt.get('error'):
                        last_error=attempt['error']; break
                suffix=(' OpenSSL reported: '+last_error) if last_error else ''
                raise ValueError('The truststore was downloaded, but its public CA certificates could not be extracted with either standard or OpenSSL 3 legacy PKCS#12 support.'+suffix)
        ca_certs,rejected=_i510_unique_ca_certificates(certs)
        if not ca_certs:
            detail=(' '+rejected[-1]) if rejected else ''
            raise ValueError('Certificates were extracted, but no valid CA:TRUE certificate was found.'+detail)
        path=TAK_MAP_OTS_TRUST_DIR/'opentakserver-ca-chain.crt'
        bundle='\n'.join(ca_certs)+'\n'
        _i510_atomic_write_ca(path,bundle)
        identities=[]
        for pem in ca_certs:
            decoded=_i509_decode_pem_cert(pem)
            der=ssl.PEM_cert_to_DER_cert(pem)
            raw=der if isinstance(der,bytes) else der.encode('latin1')
            identities.append({'subject':{k:v for group in decoded.get('subject',[]) for k,v in group},'issuer':{k:v for group in decoded.get('issuer',[]) for k,v in group},'not_before':str(decoded.get('notBefore') or ''),'not_after':str(decoded.get('notAfter') or ''),'sha256':hashlib.sha256(raw).hexdigest(),'is_ca':True})
        cfg['ca_cert_path']=str(path)
        saved=_i509_save_ots_config(cfg)
        discovery=_i509_discover_ots(saved)
        saved_with_discovery=dict(saved); saved_with_discovery['last_discovery']=discovery
        saved=_i509_save_ots_config(saved_with_discovery)
        return {'ok':True,'version':'i510','path':str(path),'certificates':len(ca_certs),'certificate_identities':identities,'extraction':extraction,'discovery':discovery,'config':_i509_public_ots_config(saved),'message':'OpenTAKServer public CA chain installed and strict discovery reran automatically.'}

    _i510_prev_config=tak_map_config
    def tak_map_config():
        cfg=_i510_prev_config()
        if isinstance(cfg,dict):
            cfg=dict(cfg); cfg['tak_map_iteration']='i510'
            ots=dict(cfg.get('ots_integration') or {}); ots['version']='i510'; ots['truststore_legacy_fallback']=True; ots['partial_discovery_rendering']=True; cfg['ots_integration']=ots
        return cfg
    globals()['tak_map_config']=tak_map_config

    def _i510_patch_html_version(html):
        if not isinstance(html,str): return html
        html=html.replace('1.3.0-i509','1.3.0-i510').replace('TAKDashboard/i509','TAKDashboard/i510').replace('TAK-Map/1.3.0 i509','TAK-Map/1.3.0 i510')
        html=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i510\2',html)
        html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i510\2',html)
        return html
    TAK_MAP_HTML=_i510_patch_html_version(TAK_MAP_HTML); INDEX_HTML=TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML=_i510_patch_html_version(TAK_MAP_LOGIN_HTML); LOGIN_HTML=_i510_patch_html_version(LOGIN_HTML)
except Exception as _i510_exc:
    try: print('TAK Map i510 Configure OTS correction failed:',_i510_exc)
    except Exception: pass
# --- end TAK Map i510 Configure OTS truststore and discovery correction ---

# --- TAK Map i511 OTS identity, permissions, and account-menu refinement ---
try:
    _i511_default_ots_config_before = _i509_default_ots_config
    def _i509_default_ots_config():
        cfg = dict(_i511_default_ots_config_before())
        cfg['version'] = 'i511'
        cfg.setdefault('last_admin_validation', {})
        return cfg

    _i511_normalize_ots_config_before = _i509_normalize_ots_config
    def _i509_normalize_ots_config(payload=None, current=None):
        cfg = dict(_i511_normalize_ots_config_before(payload, current))
        cfg['version'] = 'i511'
        validation = cfg.get('last_admin_validation')
        if not isinstance(validation, dict):
            validation = {}
        cfg['last_admin_validation'] = {
            'username': str(validation.get('username') or '')[:160],
            'display_identity': str(validation.get('display_identity') or '')[:160],
            'base_url': str(validation.get('base_url') or '')[:1024],
            'validated_at': str(validation.get('validated_at') or '')[:80],
            'role_names': [str(x)[:120] for x in list(validation.get('role_names') or [])[:32]],
        }
        return cfg

    def _i511_auth_headers(cfg, auth):
        headers = {'Accept': 'application/json', 'User-Agent': 'TAK-Map/i511 OTS Identity'}
        if auth.get('token'):
            header = str(auth.get('token_header') or 'Authorization')
            headers[header] = str(auth.get('token_prefix') or '') + str(auth.get('token') or '')
        if auth.get('cookies'):
            headers['Cookie'] = str(auth.get('cookies') or '')
        if auth.get('csrf_token'):
            headers['X-XSRF-TOKEN'] = str(auth.get('csrf_token') or '')
            headers['Referer'] = str(cfg.get('base_url') or '').rstrip('/') + '/'
        return headers

    def _i511_safe_list(value, keys=()):
        if value is None:
            return []
        rows = value if isinstance(value, list) else [value]
        out = []
        for item in rows:
            if isinstance(item, dict):
                row = {}
                for key in keys:
                    if key in item and item.get(key) is not None:
                        val = item.get(key)
                        if isinstance(val, (str, int, float, bool)):
                            row[key] = val
                        elif isinstance(val, list):
                            row[key] = [str(x)[:160] for x in val[:64] if isinstance(x, (str, int, float, bool))]
                if row:
                    out.append(row)
            elif isinstance(item, (str, int, float, bool)):
                out.append(str(item)[:160])
        return out

    def _i511_permission_names(value):
        out = []
        def add(v):
            text = str(v or '').strip()
            if text and text.lower() not in {x.lower() for x in out}:
                out.append(text[:160])
        if isinstance(value, dict):
            for key, enabled in value.items():
                if enabled not in (False, None, 0, '0', 'false', 'False'):
                    add(key)
        elif isinstance(value, list):
            for item in value:
                if isinstance(item, dict):
                    add(item.get('name') or item.get('permission') or item.get('id'))
                else:
                    add(item)
        elif isinstance(value, str):
            for item in re.split(r'[,;\n]+', value):
                add(item)
        elif value is not None:
            add(value)
        return out

    def _i511_parse_time(value):
        text = str(value or '').strip()
        if not text:
            return 0.0
        try:
            parsed = datetime.fromisoformat(text.replace('Z', '+00:00'))
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=timezone.utc)
            return parsed.timestamp()
        except Exception:
            return 0.0

    def _i511_profile_from_me(raw, fallback_username=''):
        data = raw if isinstance(raw, dict) else {}
        # Accept common Flask-Security/OTS wrapper shapes while deliberately
        # ignoring any token returned by /api/me.
        for key in ('response', 'user', 'data'):
            nested = data.get(key)
            if isinstance(nested, dict) and any(k in nested for k in ('username', 'roles', 'euds', 'groups')):
                data = nested
                break
        username = sanitize_ots_username(data.get('username') or fallback_username)
        roles = []
        permissions = []
        for role in (data.get('roles') or []):
            if isinstance(role, dict):
                name = str(role.get('name') or role.get('role') or '').strip()
                description = str(role.get('description') or '').strip()
                perms = _i511_permission_names(role.get('permissions'))
            else:
                name = str(role or '').strip(); description = ''; perms = []
            if name:
                roles.append({'name': name[:120], 'description': description[:300], 'permissions': perms})
            for perm in perms:
                if perm.lower() not in {x.lower() for x in permissions}:
                    permissions.append(perm)
        role_names = [str(r.get('name') or '') for r in roles]
        explicit_admin = bool(data.get('is_admin') is True or data.get('administrator') is True)
        is_admin = explicit_admin or any(name.strip().lower() in ('administrator', 'admin') for name in role_names)
        euds = []
        for item in (data.get('euds') or []):
            if not isinstance(item, dict):
                continue
            team = item.get('team')
            if isinstance(team, dict): team = team.get('name') or team.get('id')
            team_role = item.get('team_role')
            if isinstance(team_role, dict): team_role = team_role.get('name') or team_role.get('id')
            euds.append({
                'uid': str(item.get('uid') or item.get('device_uid') or '')[:240],
                'callsign': str(item.get('callsign') or '')[:160],
                'last_event_time': str(item.get('last_event_time') or item.get('last_seen') or '')[:100],
                'last_status': str(item.get('last_status') or item.get('status') or '')[:80],
                'team': str(team or item.get('team_id') or '')[:120],
                'team_role': str(team_role or item.get('role') or '')[:120],
            })
        live_words = ('online', 'connected', 'active', 'current')
        ranked = sorted(euds, key=lambda e: (
            1 if str(e.get('last_status') or '').strip().lower() in live_words else 0,
            _i511_parse_time(e.get('last_event_time')),
            1 if e.get('callsign') else 0,
        ), reverse=True)
        chosen = next((e for e in ranked if e.get('callsign')), {})
        callsign = str(chosen.get('callsign') or '')
        groups = _i511_safe_list(data.get('groups'), ('id', 'name', 'description'))
        memberships = _i511_safe_list(data.get('group_memberships'), ('id', 'group_id', 'group_name', 'name', 'direction', 'read', 'write', 'active'))
        return {
            'username': username,
            'user_id': data.get('id') if isinstance(data.get('id'), (str, int)) else '',
            'active': data.get('active') is not False,
            'callsign': callsign,
            'display_identity': callsign or username,
            'identity_source': 'OpenTAKServer',
            'connection_state': 'Authenticated',
            'is_admin': bool(is_admin),
            'roles': roles,
            'role_names': role_names,
            'permissions': permissions,
            'groups': groups,
            'group_memberships': memberships,
            'euds': euds,
            'team': str(chosen.get('team') or ''),
            'team_role': str(chosen.get('team_role') or ''),
        }

    def _i511_fetch_profile(cfg, auth, fallback_username=''):
        base = str(cfg.get('api_url') or cfg.get('base_url') or '').rstrip('/')
        if not base:
            return {'ok': False, 'error': 'OpenTAKServer API address is not configured.'}
        url = base + '/api/me'
        try:
            req = Request(url, headers=_i511_auth_headers(cfg, auth), method='GET')
            with urlopen(req, timeout=10, context=_i509_ssl_context(cfg)) as resp:
                body = resp.read(524288).decode('utf-8', 'replace')
                status = int(getattr(resp, 'status', 200) or 200)
        except HTTPError as e:
            try: body = e.read(262144).decode('utf-8', 'replace')
            except Exception: body = ''
            return {'ok': False, 'status': int(getattr(e, 'code', 0) or 0), 'error': 'OpenTAKServer /api/me returned HTTP ' + str(getattr(e, 'code', '')), 'body_preview': body[:240]}
        except Exception as e:
            return {'ok': False, 'status': 0, 'error': str(e)}
        if not 200 <= status < 300:
            return {'ok': False, 'status': status, 'error': 'OpenTAKServer /api/me returned HTTP ' + str(status)}
        try:
            obj = json.loads(body or '{}')
        except Exception:
            return {'ok': False, 'status': status, 'error': 'OpenTAKServer /api/me did not return JSON.'}
        profile = _i511_profile_from_me(obj, fallback_username)
        if not profile.get('username'):
            return {'ok': False, 'status': status, 'error': 'OpenTAKServer /api/me did not identify a username.'}
        return {'ok': True, 'status': status, 'profile': profile}

    def _i511_safe_capabilities(cfg, auth):
        base = str(cfg.get('api_url') or cfg.get('base_url') or '').rstrip('/')
        marti = str(cfg.get('marti_url') or '').rstrip('/')
        headers = _i511_auth_headers(cfg, auth)
        urls = {
            'me': base + '/api/me',
            'groups': base + '/api/groups',
            'missions': base + '/api/missions',
            'contacts': marti + '/Marti/api/contacts/all',
            'marti_groups': marti + '/Marti/api/groups',
            'marti_missions': marti + '/Marti/api/missions',
        }
        out = {}
        for key, url in urls.items():
            probe = _i509_http_request(url, cfg, headers=headers, timeout=8)
            out[key] = {'status': probe.get('status'), 'state': _i509_endpoint_class(probe)}
        return out

    def _i511_write_ots_config(cfg):
        TAK_MAP_OTS_CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        atomic_write_json(TAK_MAP_OTS_CONFIG_FILE, cfg)
        try: os.chmod(TAK_MAP_OTS_CONFIG_FILE, 0o600)
        except Exception: pass

    _i511_save_ots_config_before = _i509_save_ots_config
    def _i509_save_ots_config(payload):
        current = _i509_load_ots_config()
        candidate = _i509_normalize_ots_config(payload, current)
        activating = bool(candidate.get('enabled') and candidate.get('login_enabled'))
        already_active_same_server = bool(
            current.get('enabled') and current.get('login_enabled') and
            str(current.get('base_url') or '').rstrip('/') == str(candidate.get('base_url') or '').rstrip('/')
        )
        if activating and not already_active_same_server:
            validation = candidate.get('last_admin_validation') or {}
            if str(validation.get('base_url') or '').rstrip('/') != str(candidate.get('base_url') or '').rstrip('/'):
                raise ValueError('Validate an OpenTAKServer administrator account before enabling end-user login.')
        return _i511_save_ots_config_before(candidate)

