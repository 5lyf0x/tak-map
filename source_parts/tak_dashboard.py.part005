        return _v402_versions(_html)

    for _nm in ('TAK_MAP_HTML','TAK_MAP_LOGIN_HTML','LOGIN_HTML','INDEX_HTML'):
        if _nm in globals():
            globals()[_nm] = _tak_v402_add(globals()[_nm])
    if '_html' in globals():
        globals()['_html'] = _tak_v402_add(globals()['_html'])
except Exception as _e_v402:
    try:
        print('v402 Terrain Mode local DEM stable refresh patch failed', _e_v402)
    except Exception:
        pass
# --- end TAK Map v402 patch ---



