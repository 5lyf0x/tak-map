try:
    _i501_prev_config = tak_map_config
    def tak_map_config():
        cfg = _i501_prev_config()
        if isinstance(cfg, dict):
            cfg = dict(cfg)
            cfg['tak_map_iteration'] = 'i501'
            route_ui = dict(cfg.get('route_ui') or {})
            route_ui.update({
                'version':'i501',
                'save_upload_adapter':'/api/tak-map/import',
                'public_upload_adapter':'takMapUploadGeoJsonV501',
                'color_picker':'TakMapToolUxV486 shared swatch picker',
                'color_picker_closes_after_selection':True,
                'production_function_visibility_tested':True,
            })
            cfg['route_ui'] = route_ui
            geofencing = dict(cfg.get('geofencing') or {})
            geofencing.update({
                'version':'i501',
                'coordinate_truth':'reported-lat-lon',
                'adsb_coordinate_snapshot':'rawSnapshot',
                'visual_marker_geometry_ignored':True,
                'icon_bounds_ignored':True,
                'label_bounds_ignored':True,
                'rotation_ignored':True,
                'interpolation_affects_geofence':False,
                'movement_segment_source':'previous-and-current-reported-coordinates',
            })
            cfg['geofencing'] = geofencing
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _I501_ROUTE_SAVE_FIX = r'''<script id="takMapRouteSaveFixV501">
(function(w,d){
