    _I503_VIEWSHED_SPOKE_CLEANUP = r'''function cleanupViewshedMaskV503(classData,width,height){
 const w=Math.max(0,Number(width)||0),h=Math.max(0,Number(height)||0),input=classData instanceof Uint8ClampedArray?classData:new Uint8ClampedArray(classData||[]);
 if(!w||!h||input.length!==w*h)return {classData:input,changed:0,componentsRemoved:0,candidates:0,nearRadius:0,minRadialSpan:0};
 const src=new Uint8ClampedArray(input),out=new Uint8ClampedArray(src),cx=(w-1)/2,cy=(h-1)/2,maxRadius=Math.max(1,Math.min(w,h)/2);
 const nearRadius=Math.max(5,Math.round(maxRadius*.035)),minRadialSpan=Math.max(6,Math.round(maxRadius*.06)),candidate=new Uint8Array(w*h),visited=new Uint8Array(w*h);
 function sampleVisible(fx,fy){const x=Math.round(fx),y=Math.round(fy);return x>=0&&y>=0&&x<w&&y<h&&src[y*w+x]===1}
 let candidateCount=0;
 for(let y=1;y<h-1;y++)for(let x=1;x<w-1;x++){
  const idx=y*w+x;if(src[idx]!==1)continue;
