    _v407_script = r"""<script id="v407AdsbPopupWidthPatch">
(function(){
  'use strict';
  const V='v407', w=window, d=document;
  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}
  function setVersion(){try{d.documentElement.dataset.takMapIteration=V;qa('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  function ensureStyle(){
    try{
      let st=d.getElementById('v407AdsbPopupWidthStyle');
      if(!st){st=d.createElement('style');st.id='v407AdsbPopupWidthStyle';(d.head||d.documentElement).appendChild(st)}
      st.textContent=`
        .leaflet-popup-content-wrapper {
          max-width: none !important;
        }
        .leaflet-popup-content {
          width: auto !important;
          min-width: min(360px, calc(92vw - 48px)) !important;
          max-width: min(92vw, 460px) !important;
          margin: 10px 12px !important;
          box-sizing: border-box !important;
        }
        .leaflet-popup-content * {
          box-sizing: border-box !important;
        }
        .leaflet-popup-content table,
        .leaflet-popup-content tbody,
        .leaflet-popup-content tr,
        .leaflet-popup-content td,
        .leaflet-popup-content th {
          max-width: 100% !important;
        }
        .leaflet-popup-content button,
        .leaflet-popup-content .btn,
        .leaflet-popup-content [role="button"] {
          white-space: nowrap !important;
          max-width: 100% !important;
        }
      `;
      return true;
    }catch(e){try{console.warn('v407 ADS-B popup width style failed',e)}catch(_){ }return false;}
  }
  function popupDiagnostics(){
    const popup=d.querySelector('.leaflet-popup');
    if(!popup)return {version:V,ok:false,error:'No Leaflet popup is currently open.',stylePresent:!!d.getElementById('v407AdsbPopupWidthStyle')};
    const contentWrapper=popup.querySelector('.leaflet-popup-content-wrapper');
    const content=popup.querySelector('.leaflet-popup-content');
    const items=[popup,contentWrapper,content].filter(Boolean).concat(qa('*',popup).filter(function(el){
      try{return /ads|aircraft|track|icao|callsign|alt|speed|heading/i.test(String(el.className||'')+' '+String(el.textContent||''))}catch(_){return false}
    })).slice(0,40);
    const rows=items.map(function(el,i){
      const r=el.getBoundingClientRect();const cs=getComputedStyle(el);
      return {i:i,tag:el.tagName.toLowerCase(),id:el.id||'',className:String(el.className||''),text:String(el.textContent||'').trim().replace(/\s+/g,' ').slice(0,80),rectWidth:Math.round(r.width),clientWidth:el.clientWidth,scrollWidth:el.scrollWidth,display:cs.display,position:cs.position,width:cs.width,maxWidth:cs.maxWidth,overflow:cs.overflow,boxSizing:cs.boxSizing};
    });
    const overflowing=[];qa('*',popup).forEach(function(el,i){try{if(el.scrollWidth>el.clientWidth+2||el.scrollHeight>el.clientHeight+2){overflowing.push({i:i,tag:el.tagName.toLowerCase(),id:el.id||'',className:String(el.className||''),text:String(el.textContent||'').trim().replace(/\s+/g,' ').slice(0,100),clientWidth:el.clientWidth,scrollWidth:el.scrollWidth,overflowX:el.scrollWidth>el.clientWidth+2,overflowY:el.scrollHeight>el.clientHeight+2});}}catch(_){}});
    return {version:V,ok:true,stylePresent:!!d.getElementById('v407AdsbPopupWidthStyle'),popupRows:rows,overflowingElements:overflowing.slice(0,30)};
  }
  function boot(){setVersion();ensureStyle()}
  w.getTakMapAdsbPopupDiagnosticsV407=popupDiagnostics;
  w.applyTakMapAdsbPopupWidthPatchV407=ensureStyle;
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,50)},{once:true});else setTimeout(boot,50);
  [200,800,1600,3200].forEach(function(ms){setTimeout(boot,ms)});
})();
</script>"""

