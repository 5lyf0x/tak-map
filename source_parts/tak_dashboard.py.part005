    _I499_SESSION_CLIENT = r'''<script id="takMapSessionV499">
(function(w,d){
'use strict';
if(w.TakMapSessionV499)return;
const S={version:'i499',expired:false,reason:'',expiredAt:0,redirectTimer:0,fetchWrapped:false};
function pathFor(input){try{return new URL(typeof input==='string'?input:(input&&input.url)||'',w.location.href).pathname}catch(_){return''}}
function protectedRequest(input){const p=pathFor(input);return p.startsWith('/api/tak-map/')&&p!=='/api/tak-map/login'}
function esc(v){return String(v==null?'':v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]))}
function overlay(reason){try{let el=d.getElementById('takMapSessionExpiredV499');if(el)return el;el=d.createElement('div');el.id='takMapSessionExpiredV499';el.setAttribute('role','alertdialog');el.setAttribute('aria-modal','true');el.innerHTML='<div><b>TAK Map session expired</b><span>'+esc(reason||'Authentication is required.')+'</span><small>Returning to the login screen…</small></div>';d.body&&d.body.appendChild(el);return el}catch(_){return null}}
function expire(reason){if(S.expired)return false;S.expired=true;S.reason=String(reason||'Your login session expired or the TAK Map service restarted.');S.expiredAt=Date.now();try{d.body&&d.body.classList.add('tak-map-auth-required-v499')}catch(_){}try{w.dispatchEvent(new CustomEvent('takmap:auth-required',{detail:{reason:S.reason,source:'session-v499'}}))}catch(_){}overlay(S.reason);S.redirectTimer=w.setTimeout(function(){try{w.location.replace('/tak-map/login?reason=session-expired')}catch(_){w.location.href='/tak-map/login?reason=session-expired'}},850);return true}
const original=w.fetch.bind(w);w.fetch=async function(input,init){const response=await original(input,init);if(protectedRequest(input)&&response.status===401)expire('Your login session expired or the TAK Map service restarted. Please log in again.');return response};S.fetchWrapped=true;
const style=d.createElement('style');style.id='takMapSessionV499Style';style.textContent='#takMapSessionExpiredV499{position:fixed;inset:0;z-index:100000;display:flex;align-items:center;justify-content:center;background:rgba(2,5,8,.72);backdrop-filter:blur(4px)}#takMapSessionExpiredV499>div{width:min(470px,calc(100vw - 32px));border:1px solid rgba(255,111,46,.72);border-radius:16px;background:linear-gradient(180deg,rgba(25,34,43,.98),rgba(8,13,18,.99));box-shadow:0 20px 70px rgba(0,0,0,.68),0 0 26px rgba(255,111,46,.18);padding:20px;color:#eef5f7;text-align:center}#takMapSessionExpiredV499 b{display:block;font-size:1.05rem;text-transform:uppercase;letter-spacing:.07em;color:#fff}#takMapSessionExpiredV499 span{display:block;margin-top:9px;color:#ffd8c5;font-weight:750;line-height:1.4}#takMapSessionExpiredV499 small{display:block;margin-top:10px;color:#9fb0ba}';d.head&&d.head.appendChild(style);
w.TakMapSessionV499=Object.freeze({version:'i499',expire,diagnostics:()=>Object.assign({},S)});
