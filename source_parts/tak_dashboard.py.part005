    def _tak_v415_versions(_html):
        if not isinstance(_html,str): return _html
        # Public release remains v1.3.0; internal/UI iteration is i442.
        _html=_re_v414.sub(r"TAK-Map/\d+\.\d+\.\d+\s+[vi]\d+","TAK-Map/1.3.0 i442",_html)
        _html=_re_v414.sub(r"TAKDashboard/[vi]\d+","TAKDashboard/i442",_html)
        # Package/archive naming intentionally remains vxxx.
        _html=_re_v414.sub(r"tak-map-v\d+","tak-map-v442",_html)
        _html=_re_v414.sub(r"(<span[^>]*class=[\"'][^\"']*iteration-(?:chip|marker)[^\"']*[\"'][^>]*>)[vi]\d+(</span>)",r"\1i442\2",_html,flags=_re_v414.I)
        _html=_re_v414.sub(r"(<div[^>]*class=[\"'][^\"']*iteration-marker[^\"']*[\"'][^>]*>)[vi]\d+(</div>)",r"\1i442\2",_html,flags=_re_v414.I)
        _html=_re_v414.sub(r"(<[^>]+data-iteration=[\"'])[vi]\d+([\"'][^>]*>)",r"\1i442\2",_html,flags=_re_v414.I)
        _html=_re_v414.sub(r"(<span[^>]*class=[\"'][^\"']*release-main[^\"']*[\"'][^>]*>)\d+\.\d+\.\d+(</span>)",r"\g<1>1.3.0\g<2>",_html,flags=_re_v414.I)
        _html=_re_v414.sub(r"(<[^>]+data-release=[\"'])\d+\.\d+\.\d+([\"'][^>]*>)",r"\g<1>1.3.0\g<2>",_html,flags=_re_v414.I)
        # Version is shown only in the sidebar footer. Remove any header badge
        # injected by older packages before the response reaches the browser.
        _html=_re_v414.sub(r"<span[^>]*(?:id=[\"']takMapHeaderRelease[^\"']*[\"']|class=[\"'][^\"']*tak-map-header-release[^\"']*[\"'])[^>]*>[\s\S]*?</span>","",_html,flags=_re_v414.I)
        return _html
    def _tak_v415_add(_html):
        if not isinstance(_html,str): return _html
        _html=re.sub(r'<script[^>]*id=["\']v415ReplayModeIntegrationPatch["\'][\s\S]*?</script>','',_html,flags=re.I)
        _html=_tak_v415_versions(_html)
        if 'id="v415ReplayModeIntegrationPatch"' not in _html:
            _html=_html.replace('</body>',_v415_script+'\n</body>',1) if '</body>' in _html else _html+_v415_script
        return _tak_v415_versions(_html)
    for _nm in ('TAK_MAP_HTML','TAK_MAP_LOGIN_HTML','LOGIN_HTML','INDEX_HTML'):
        if _nm in globals(): globals()[_nm]=_tak_v415_add(globals()[_nm])
    if '_html' in globals(): globals()['_html']=_tak_v415_add(globals()['_html'])
except Exception as _e_v415:
    try: print('v415 Replay Mode integration patch failed',_e_v415)
    except Exception: pass
# --- end TAK Map v415 Replay Mode integration ---



# --- TAK Map i460 Gateway-authoritative replay and ADS-B runtime module ---
try:
    import re as _i460_re
    import threading as _i460_threading

    # Airplanes.live single-flight fetch. Network I/O stays outside the cache lock
    # so concurrent browser requests share one upstream request without serializing
    # behind a long critical section.
    _ADSB_AIRPLANES_INFLIGHT = globals().get('_ADSB_AIRPLANES_INFLIGHT') or {}

    def _v270_airplanes_fetch(settings):
        url=_v270_airplanes_url(settings)
        if not url:
            return None, {'source':'airplanes.live','ok':False,'error':'ADS-B center not set. Use Map Center or enter lat/lon.'}
        key=url
        now_ts=time.time()
        leader=False
        with _ADSB_AIRPLANES_LOCK:
            cached_data=_ADSB_AIRPLANES_CACHE.get('data')
            cached_key=_ADSB_AIRPLANES_CACHE.get('key')
            cached_age=now_ts-float(_ADSB_AIRPLANES_CACHE.get('ts') or 0.0)
            if cached_key==key and cached_data is not None and cached_age < 1.0:
                return cached_data, {'source':'airplanes.live','url':url,'ok':True,'cached':True,'single_flight':True,'cache_age_seconds':round(cached_age,3)}
            flight=_ADSB_AIRPLANES_INFLIGHT.get(key)
            if flight is None:
                flight={'event':_i460_threading.Event(),'data':None,'note':None,'started':time.time()}
                _ADSB_AIRPLANES_INFLIGHT[key]=flight
                leader=True
        if leader:
            try:
                data=_v270_json_url(url,timeout=10)
                note={'source':'airplanes.live','url':url,'ok':True,'cached':False,'single_flight':True,'request_seconds':round(time.time()-flight['started'],3)}
                with _ADSB_AIRPLANES_LOCK:
                    _ADSB_AIRPLANES_CACHE.update({'key':key,'ts':time.time(),'data':data})
                    flight['data']=data; flight['note']=note
            except Exception as exc:
                with _ADSB_AIRPLANES_LOCK:
                    stale=_ADSB_AIRPLANES_CACHE.get('data') if _ADSB_AIRPLANES_CACHE.get('key')==key else None
                    age=time.time()-float(_ADSB_AIRPLANES_CACHE.get('ts') or 0.0)
                    flight['data']=stale
                    flight['note']={'source':'airplanes.live','url':url,'ok':False,'cached':bool(stale),'stale_cache':bool(stale),'cache_age_seconds':round(max(0,age),3),'single_flight':True,'error':str(exc)[:240]}
            finally:
                with _ADSB_AIRPLANES_LOCK:
                    _ADSB_AIRPLANES_INFLIGHT.pop(key,None)
                    flight['event'].set()
            return flight.get('data'), flight.get('note') or {'source':'airplanes.live','url':url,'ok':False,'error':'ADS-B request failed.'}
        if not flight['event'].wait(12.0):
            return None, {'source':'airplanes.live','url':url,'ok':False,'single_flight':True,'error':'Timed out waiting for shared ADS-B request.'}
        return flight.get('data'), flight.get('note') or {'source':'airplanes.live','url':url,'ok':False,'single_flight':True,'error':'Shared ADS-B request failed.'}

    _i460_prev_tak_map_adsb=tak_map_adsb
    def tak_map_adsb(query_settings=None):
        result=_i460_prev_tak_map_adsb(query_settings)
        if not isinstance(result,dict):
            result={'aircraft':[],'sources':[]}
        sources=result.get('sources') or []
        failures=[s for s in sources if isinstance(s,dict) and s.get('ok') is False]
        result['ok']=not failures
        result['version']='i460'
        result['preserve_last_good']=bool(failures)
        if failures:
            result['error']='; '.join(str(x.get('error') or x.get('source') or 'ADS-B source failed') for x in failures[:3])
        result['count']=len(result.get('aircraft') or [])
        return result

    # The only i460 runtime module is ADS-B. Browser-local operational recording,
    # IndexedDB retention, local playback, and Black Box export are intentionally
    # absent; historical playback remains the TAK Gateway Replay API integration.
    _i460_prev_get=Handler.do_GET
    def _i460_get(self):
        parsed=urlparse(self.path)
        m=_i460_re.match(r'^/assets/runtime/(tak-map-adsb-v460\.js)$',parsed.path)
        if m:
            name=m.group(1); fp=Path(__file__).resolve().parent/'assets'/name
            if not fp.exists():
                self.send_response(404);self.send_header('Cache-Control','no-store');self.end_headers();return
            body=fp.read_bytes();self.send_response(200);self.send_header('Content-Type','application/javascript; charset=utf-8');self.send_header('Cache-Control','no-store, max-age=0');self.send_header('X-TAK-Map-Module','i460');self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body);return
        return _i460_prev_get(self)
    Handler.do_GET=_i460_get

    _i460_runtime_scripts='''<script id="takMapRuntimeMonitorV460">
(function(w,d){
'use strict';
const V='v460',R=w.__TakMapRuntimeV460=w.__TakMapRuntimeV460||{version:V,loadedAt:Date.now(),modules:{}};
R.version=V;R.loaderLoadedAt=Date.now();R.modules=R.modules||{};
function mark(name,status,error){const m=R.modules[name]=R.modules[name]||{version:V};m.routeLoaded=status!=='error';m.routeStatus=status;m.routeAt=Date.now();if(error)m.error=String(error)}
w.TakMapRuntimeMarkV460=mark;
function one(name,api){const m=R.modules[name]||{};let diag=null;try{diag=api&&typeof api.diagnostics==='function'?api.diagnostics():null}catch(e){m.error=String(e&&e.message||e)}return {version:m.version||V,routeStatus:m.routeStatus||'pending',loaded:!!m.loaded,initialized:!!m.initialized,error:m.error||'',diagnostics:diag}}
