`;d.head.appendChild(st)}const box=d.createElement('div');box.id='replaySearchI621';box.className='replay-search-i621';box.innerHTML=`<div class="replay-search-head-i621"><b>Search recording</b><span>Entire selected period</span></div><div class="replay-search-row-i621"><input id="replaySearchInputI621" type="search" autocomplete="off" spellcheck="false" placeholder="Flight, ICAO, tail, EUD, vessel…" disabled><button id="replaySearchButtonI621" type="button" disabled>Search</button></div><div id="replaySearchStatusI621" class="replay-search-status-i621">Select a recorded period to search.</div><div id="replaySearchResultsI621" class="replay-search-results-i621"></div><div id="replaySearchNavI621" class="replay-search-nav-i621"><button id="replaySearchPrevI621" type="button" title="Previous appearance">‹</button><span id="replaySearchNavTextI621">—</span><button id="replaySearchNextI621" type="button" title="Next appearance">›</button></div>`;period.insertAdjacentElement('afterend',box);$('replaySearchButtonI621').onclick=runReplaySearchI621;$('replaySearchInputI621').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();runReplaySearchI621()}});$('replaySearchPrevI621').onclick=()=>stepReplaySearchOccurrenceI621(-1);$('replaySearchNextI621').onclick=()=>stepReplaySearchOccurrenceI621(1);updateReplaySearchAvailabilityI621()}
