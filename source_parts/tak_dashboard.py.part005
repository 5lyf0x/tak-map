mportant;stroke-linejoin:round!important}\n.leaflet-control.tak-area-zoom-control{background:transparent!important;background-color:transparent!important;border:0!important;box-shadow:none!important;filter:none!important}\n.leaflet-control.tak-area-zoom-control .tak-area-zoom-btn{background:transparent!important;background-color:transparent!important;box-shadow:none!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}\n.leaflet-control.tak-area-zoom-control .tak-area-zoom-btn:hover,.leaflet-control.tak-area-zoom-control .tak-area-zoom-btn.active{background:rgba(255,111,46,.12)!important;background-color:rgba(255,111,46,.12)!important;box-shadow:0 0 14px rgba(255,111,46,.18)!important}\n`;d.head.appendChild(st)}\nfunction boot(){installCss();ensureAdsbSteppers();ensureAdsbDefaults();bindMapCenter();bindPopupLifecycle();const panel=q(\'.panel[data-collapse-key="adsbSettings"] .panel-body\');if(panel&&w.MutationObserver&&!S.observer){let pending=0;S.observer=new MutationObserver(function(){clearTimeout(pending);pending=setTimeout(function(){ensureAdsbSteppers();ensureAdsbDefaults()},30)});S.observer.observe(panel,{childList:true,subtree:true})}}\nd.addEventListener(\'pointermove\',pointerSweep,true);d.addEventListener(\'mouseout\',function(ev){if(!ev.relatedTarget)closeAllTemporary()},true);w.addEventListener(\'blur\',closeAllTemporary);d.addEventListener(\'visibilitychange\',function(){if(d.hidden)closeAllTemporary()});\nw.TakMapUiFixesV461={syncMapCenter,ensureAdsbSteppers,closeTemporaryPopups:closeAllTemporary,diagnostics:function(){const radius=$(\'adsbRadiusMiles\'),source=$(\'adsbCenterSource\'),combo=$(\'adsbCenterLatLon\'),zoom=q(\'.tak-area-zoom-btn\');return {version:V,stepperCount:qa(\'.tak-adsb-stepper-v461\').length,nativeSteppersHidden:!!$(\'takMapUiStyleV461\'),radiusValue:radius&&radius.value,centerSource:source&&source.value,centerLatLon:combo&&combo.value,mapBound:S.mapBound,centerSyncs:S.centerSyncs,lastCenter:S.lastCenter