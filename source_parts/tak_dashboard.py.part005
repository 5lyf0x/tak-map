function syncColors(){for(const pair of [['viewshedVisibleColor','viewshedVisibleOpacity'],['viewshedBlockedColor','viewshedBlockedOpacity']]){const input=$(pair[0]),range=$(pair[1]);if(!input)continue;const color=String(input.value||'#46d16c');input.style.setProperty('--viewshed-swatch',color);input.style.backgroundColor=color;if(range)range.style.setProperty('--viewshed-track',color)}updateCount()}
