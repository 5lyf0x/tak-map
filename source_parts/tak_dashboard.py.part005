function clearReplay(){replay.loadToken++;replay.seekGeneration++;replay.seeking=false;replay.loading=false;replay.loadComplete=false;replay.buffering=false;replay.resumeAfterBuffer=false;replay.eventEndMs=0;replay.loadedFromMs=0;replay.events=[];replay.index=0;replay.latest.clear();try{for(const [uid,m] of replay.markers)forceCloseReplayPopup(m,uid,'clear-replay')}catch(_){}replay.activePopupUid='';replay.activePopup=null;replay.markers.clear();replay.tracked.clear();replay.followUid='';replay.sources.clear();replay.selectedSources.clear();replay.tracksByUid.clear();replay.seenRecords=new Set();try{replay.layer?.clearLayers();replay.trailLayer?.clearLayers()}catch(_){}resetReplaySearchI621(true);resetReplayJumpI624(true);updateCounts();updateBufferUi()}
