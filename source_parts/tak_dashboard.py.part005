function buildSourceChecks(preserve){const host=$('replaySourcesV417');if(!host)return;const old=new Set(replay.selectedSources),counts=new Map();for(const e of replay.events)counts.set(e.source,(counts.get(e.source)||0)+1);const sources=[...counts.keys()].sort((a,b)=>sourceLabel(a).localeCompare(sourceLabel(b)));replay.sources=new Set(sources);replay.selectedSources=new Set(sources.filter(s=>!preserve||old.has(s)||!old.size));host.innerHTML=sources.length?sources.map(s=>'<div class="replay-source-row-v417"><label><input type="checkbox" data-source="'+esc(s)+'" '+(replay.selectedSources.has(s)?'checked':'')+'><span>'+esc(sourceLabel(s))+'</span></label><span class="chip">'+counts.get(s)+'</span></div>').join(''):'<div class="muted">No source metadata was found in this period.</div>';qa('input[data-source]',host).forEach(cb=>cb.onchange=()=>{if(cb.checked)replay.selectedSources.add(cb.dataset.source);else replay.selectedSources.delete(cb.dataset.source);renderAt(replay.currentMs,true)})}
