# --- TAK Map v393 strict Mission/Data Sync current-content filter ---
try:
    import re as _re_v393
    def _v393_text(v):
        try:
            if v is None:
                return ''
            if isinstance(v, (dict, list, tuple, set)):
                try:
                    import json as _json_v393
                    return _json_v393.dumps(v, default=str, sort_keys=True)
                except Exception:
                    return str(v)
            return str(v)
        except Exception:
            return ''
    def _v393_norm(v):
        return _v393_text(v).strip().lower()
    def _v393_pkg_name(filename):
        try:
            f=_v393_text(filename).strip()
            if not f:
                return ''
            base=f.rsplit('/',1)[-1]
            base=_re_v393.sub(r'\.zip$', '', base, flags=_re_v393.I)
            base=_re_v393.sub(r'\s+-\s+TAK\s+Map\s+-\s+.*$', '', base, flags=_re_v393.I)
            base=_re_v393.sub(r'\s+-\s+\d{8}T\d{6}Z.*$', '', base, flags=_re_v393.I)
            return base.strip()
        except Exception:
            return ''
    def _v393_is_uuidish(v):
        s=_v393_text(v).strip().lower()
        return bool(_re_v393.match(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', s))
    def _v393_row_blob(row):
        try:
            if not isinstance(row, dict):
                return _v393_norm(row)
            vals=[]
            for k in ('source','_source','source_table','uid','id','cot_uid','hash','filename','name','callsign','title','type','cot_type','geometry','kind','submitter','creator_uid','keywords','properties'):
                if k in row:
                    vals.append(_v393_text(row.get(k)))
            return _v393_norm(' '.join(vals))
        except Exception:
            return ''
    def _v393_obj_keys(o):
        out=set()
        try:
            if not isinstance(o, dict):
                return out
            for k in ('uid','id','cot_uid','hash','filename','name','callsign','title'):
                v=_v393_norm(o.get(k))
                if v and len(v)>=3:
                    out.add(v)
            p=o.get('properties') if isinstance(o.get('properties'), dict) else {}
            for k in ('uid','id','cot_uid','hash','filename','name','callsign','title'):
                v=_v393_norm(p.get(k))
                if v and len(v)>=3:
                    out.add(v)
            fn=_v393_text(o.get('filename') or p.get('filename'))
            nm=_v393_pkg_name(fn)
            if nm:
                out.add(_v393_norm(nm))
        except Exception:
            pass
        return out
    def _v393_source(o):
        try:
            return _v393_norm((o or {}).get('source') or (o or {}).get('_source') or (o or {}).get('source_table'))
        except Exception:
            return ''
    def _v393_type(o):
        try:
            return _v393_norm((o or {}).get('type') or (o or {}).get('cot_type') or (o or {}).get('geometry') or (o or {}).get('kind'))
        except Exception:
            return ''
    def _v393_is_local_package_row(r):
        blob=_v393_row_blob(r)
        return bool(('missionpackage' in blob or '.zip' in blob) and ('tak-map' in blob or 'takmap' in blob or 'tak-dashboard' in blob or 'local-data' in blob))
    def _v393_shapeish_type(t):
        t=_v393_norm(t)
        return bool(t in ('shape','route','line','polygon','circle','rectangle','ellipse','freehand') or t.startswith('u-d-') or t.startswith('b-m-r'))
    if 'tak_map_data_sync' in globals() and not globals().get('_tak_v393_data_sync_wrapped'):
        _tak_v393_base_data_sync = globals()['tak_map_data_sync']
        def tak_map_data_sync():
            out=_tak_v393_base_data_sync()
            try:
                if not isinstance(out, dict):
                    return out
                objects=list(out.get('objects') or [])
                content_rows=[r for r in (out.get('mission_content') or []) if isinstance(r, dict)]
                # Build a strict stale key set from raw TAK Map/local-data mission packages and v391 orphan candidates.
                stale_keys=set()
                stale_names=set()
                stale_content_uids=set()
                stale_rows=[]
                for c in ((out.get('mission_orphan_shape_filter') or {}).get('candidates') or []):
                    if not isinstance(c, dict):
                        continue
                    if _v393_norm(c.get('source')) == 'mission_content' or _v393_is_local_package_row(c):
                        for k in ('uid','hash','filename','name','callsign'):
                            v=_v393_norm(c.get(k))
                            if v and len(v)>=3:
                                stale_keys.add(v)
                        nm=_v393_pkg_name(c.get('filename')) or _v393_text(c.get('name') or c.get('callsign'))
                        if nm:
                            stale_names.add(_v393_norm(nm)); stale_keys.add(_v393_norm(nm))
                        uid=_v393_norm(c.get('uid'))
                        if uid:
                            stale_content_uids.add(uid)
                # Any TAK Map local-data mission package whose package label is not an active mission_uid non-shape-control name is package history.
                mission_uid_active_names=set()
                mission_uid_active_uids=set()
                for r in (out.get('mission_uids') or []):
                    if not isinstance(r, dict):
                        continue
                    t=_v393_norm(r.get('cot_type') or r.get('type'))
                    nm=_v393_norm(r.get('callsign') or r.get('name') or r.get('title'))
                    uid=_v393_norm(r.get('uid') or r.get('id') or r.get('cot_uid'))
                    # Shape/control CoT rows from Mission UID are not reliable current membership on this OTS build.
                    if t.startswith('u-d-'):
                        continue
                    if nm: mission_uid_active_names.add(nm)
                    if uid: mission_uid_active_uids.add(uid)
                for r in content_rows:
                    if not _v393_is_local_package_row(r):
                        continue
                    nm=_v393_pkg_name(r.get('filename')) or _v393_text(r.get('name') or r.get('callsign'))
                    nml=_v393_norm(nm)
                    uid=_v393_norm(r.get('uid'))
                    # Mission package rows are historical unless a current non-shape Mission UID carries the same UID/name.
                    if (nml and nml in mission_uid_active_names) or (uid and uid in mission_uid_active_uids):
                        continue
                    stale_rows.append({'uid':_v393_text(r.get('uid'))[:160],'name':nm[:200],'filename':_v393_text(r.get('filename'))[:240],'hash':_v393_text(r.get('hash'))[:90],'reason':'TAK Map/local-data mission package row has no current non-shape Mission UID counterpart; treat as historical package content'})
                    for k in ('uid','hash','filename','name','callsign'):
                        v=_v393_norm(r.get(k))
