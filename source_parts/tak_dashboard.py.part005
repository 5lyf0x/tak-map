        old_route = "layer=L.polyline(pts,{color:(o.color||'#ff7a1a'),weight:3,opacity:.9,dashArray:dash}).bindPopup(layerPopupForObject(o,cat)).addTo(group);try{const hit=L.polyline(pts,{color:'#000',weight:16,opacity:0,interactive:true}).addTo(group);hit.bindPopup(layer.getPopup());hit.on('click',ev=>{try{L.DomEvent.stop(ev);layer.openPopup(ev.latlng)}catch(_){}});o.__hitLayer=hit}catch(_){}"
