function bindEudObserver(){const src=d.getElementById('eudStatus');if(!src||LS.eudObserved===src)return;if(LS.eudObserver)try{LS.eudObserver.disconnect()}catch(_){};LS.eudObserved=src;if(w.MutationObserver){LS.eudObserver=new MutationObserver(()=>syncEudCount());LS.eudObserver.observe(src,{childList:true,characterData:true,subtree:true})}syncEudCount()}
