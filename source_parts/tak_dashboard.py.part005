  function dehtml(s){return txt(s).replace(/<script[\s\S]*?<\/script>/gi,' ').replace(/<style[\s\S]*?<\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&quot;/g,'\"').replace(/&#39;/g,"'").replace(/\s+/g,' ').trim()}
  function getMap(){return w.takLeafletMap||w.map||(typeof map!=='undefined'?map:null)}
  function isTileLike(layer){try{return !!(layer&&((w.L&&w.L.TileLayer&&layer instanceof w.L.TileLayer)||(layer._url&&layer.getTileUrl)||layer._tiles||layer._container&&/leaflet-tile-pane/.test(txt(layer._container.className))))}catch(_){return false}}
  function shapeishRow(o){try{if(!o||typeof o!=='object')return false;const typ=lc(o.cot_type||o.type||o.event_type);const uid=lc(o.uid||o.id||o.cot_uid||o.event_uid);const cs=lc(o.callsign||o.name||o.title||o.filename);const kw=Array.isArray(o.keywords)?o.keywords.map(lc).join(' '):lc(o.keywords);const blob=[typ,uid,cs,kw,lc(o.creator_uid),lc(o.submitter)].join(' ');if(uid.indexOf('takmap-local-')===0||uid.indexOf('takmap-shape-')===0||uid.indexOf('takmap-draw-')===0)return true;if(/^u-d-/.test(typ)&&/(circle|ellipse|polygon|polyline|rectangle|square|freehand|shape|area|drawing|takmap|tak-map)/.test(blob))return true;if(blob.indexOf('local-data-shape')>=0||blob.indexOf('local-data')>=0&&blob.indexOf('tak-map')>=0)return true;if(/ - tak map - /.test(cs))return true;}catch(_){}return false}
  function stripPackageName(v){let s=txt(v).split('/').pop().replace(/\.zip$/i,'').trim();s=s.replace(/\s+-\s+TAK\s+Map\s+-\s+.*$/i,'').trim();s=s.replace(/-[a-f0-9]{8,64}$/i,'').trim();return s}
  function addTerm(set,v,kind){let s=txt(v).trim();if(!s)return;const low=s.toLowerCase();if(low.length>=4)set.add(low);const stripped=stripPackageName(s).toLowerCase();if(stripped&&stripped.length>=4)set.add(stripped);}
  function rowTerms(row){const set=new Set();try{if(!row||typeof row!=='object')return set;['uid','id','guid','cot_uid','event_uid','hash','sha256','callsign','name','title','label','filename'].forEach(k=>addTerm(set,row[k],k));const p=row.properties&&typeof row.properties==='object'?row.properties:{};['uid','id','guid','cot_uid','event_uid','hash','sha256','callsign','name','title','label','filename'].forEach(k=>addTerm(set,p[k],k));}catch(_){}return set;}
  function objBlob(o){try{return JSON.stringify(o||{}).toLowerCase()}catch(_){return lc(o)}}
  function activeHasTerm(ds, term){try{if(!term||term.length<4)return false;return (ds.objects||[]).some(o=>objBlob(o).indexOf(term)>=0)}catch(_){return false}}
  function orphanTerms(ds){const terms=new Set(), candidates=[];function addCand(row,source){try{if(!row||typeof row!=='object')return;const t=rowTerms(row);if(!t.size)return;let name=txt(row.callsign||row.name||row.title||stripPackageName(row.filename)||row.uid||row.id);const cand={source:source||'',name:name,uid:txt(row.uid||row.id||''),filename:txt(row.filename||''),terms:Array.from(t)};candidates.push(cand);t.forEach(x=>{if(!activeHasTerm(ds,x))terms.add(x)})}catch(_){}}
    try{((ds.mission_orphan_shape_filter&&ds.mission_orphan_shape_filter.candidates)||[]).forEach(r=>addCand(r,'mission_orphan_shape_filter'))}catch(_){}
