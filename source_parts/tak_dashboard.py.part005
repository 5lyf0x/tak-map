  async function refreshCotV403(){try{const r=await fetch('/api/tak-map/cot',{cache:'no-store',credentials:'same-origin'});const j=await r.json();try{lastTakMarkers=j.markers||[]}catch(_){w.lastTakMarkers=j.markers||[]}let eudCount=0;for(const m of (j.markers||[])){if(markerKind(m)==='eud')eudCount++}updateEudStatus(eudCount);try{if(typeof terrain3DActive!=='undefined'&&terrain3DActive){if(typeof refreshTerrain3DObjects==='function')refreshTerrain3DObjects(true,'cot-v403');return j}}catch(_){}const layer=getTakLayer();const mapp=getMap();if(layer&&typeof layer.clearLayers==='function')layer.clearLayers();try{if(typeof clearSearchSource==='function')clearSearchSource('tak')}catch(_){}if(!cotMasterOn()){try{if(mapp&&layer&&mapp.hasLayer&&mapp.removeLayer&&mapp.hasLayer(layer))mapp.removeLayer(layer)}catch(_){}try{if(typeof handleMapSearch==='function')handleMapSearch()}catch(_){}try{if(typeof refreshTerrain3DObjects==='function')refreshTerrain3DObjects(true,'cot-markers-hidden-v403')}catch(_){}return j}try{if(mapp&&layer&&mapp.addLayer&&mapp.hasLayer&&!mapp.hasLayer(layer))layer.addTo(mapp)}catch(_){}for(const obj of (j.markers||[])){const k=markerKind(obj);if(!shouldRenderCotMarker(obj))continue;if(obj.lat==null||obj.lon==null)continue;try{const popup=(k==='eud'||k==='webform'||k==='server_gps'||k==='server-gps')?basicMarkerPopupHtml(obj,k):pointPopupHtml(obj,'Point Markers');const mk=L.marker([obj.lat,obj.lon],{icon:takIcon(k,obj)}).bindPopup(popup).addTo(layer);try{stabilizeLayerPopup(mk)}catch(_){}try{addSearchItem('tak',k,obj.callsign||obj.uid||obj.id||k,obj.lat,obj.lon,mk,obj)}catch(_){}}catch(e){try{console.warn('v403 CoT marker draw skipped',e,obj)}catch(_){}}}try{if(typeof handleMapSearch==='function')handleMapSearch()}catch(_){}try{if(typeof refreshTerrain3DObjects==='function')refreshTerrain3DObjects(false,'cot-v403')}catch(_){}return j}catch(e){try{const el=$('eudStatus');if(el)el.textContent='error'}catch(_){}throw e}}
