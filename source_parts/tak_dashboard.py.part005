function updateReplayJumpAvailabilityI624(){const ready=replay.mode==='replay'&&!!replay.period&&!replayJumpI624.busy&&!replay.seeking;for(const id of ['replayJumpDateI624','replayJumpTimeI624','replayJumpGoI624','replayJumpBackI624','replayJumpForwardI624']){const el=$(id);if(el)el.disabled=!ready}for(const id of ['replayJumpDateWrapI624','replayJumpTimeWrapI624']){const el=$(id);if(el)el.classList.toggle('disabled',!ready)}}
function updateReplayJumpBoundsI624(){const date=$('replayJumpDateI624'),time=$('replayJumpTimeI624'),zone=$('replayJumpZoneI624'),b=replayPeriodBoundsI624();if(!date||!time||!Number.isFinite(b.start)||!Number.isFinite(b.end)||b.end<b.start){updateReplayJumpAvailabilityI624();return}const minDate=replayLocalDateI624(b.start),maxDate=replayLocalDateI624(b.end);date.min=minDate;date.max=maxDate;if(!date.value||date.value<minDate||date.value>maxDate)date.value=replayLocalDateI624(Math.max(b.start,Math.min(b.end,Number(replay.currentMs)||b.start)));time.min=date.value===minDate?replayLocalTimeI624(b.start):'00:00:00';time.max=date.value===maxDate?replayLocalTimeI624(b.end):'23:59:59';if(time.value&&time.value<time.min)time.value=time.min;if(time.value&&time.value>time.max)time.value=time.max;if(zone)zone.textContent=replayZoneLabelI624(Number(replay.currentMs)||b.start);updateReplayJumpAvailabilityI624()}
