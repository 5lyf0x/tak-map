    import re as _re_v394
    import datetime as _dt_v394

    def _v394_text(v):
        try:
            if v is None:
                return ''
            if isinstance(v, (dict, list, tuple, set)):
                try:
                    import json as _json_v394
                    return _json_v394.dumps(v, default=str, ensure_ascii=False)
                except Exception:
                    return str(v)
            return str(v)
        except Exception:
            return ''

    def _v394_lc(v):
        return _v394_text(v).strip().lower()

    def _v394_parse_dt(v):
        try:
            s=_v394_text(v).strip()
            if not s:
                return None
            s=s.replace('Z','+00:00')
            # PostgreSQL values usually arrive as naive ISO strings.  Keep comparison naive UTC-ish.
            d=None
            try:
                d=_dt_v394.datetime.fromisoformat(s)
            except Exception:
                try:
                    d=_dt_v394.datetime.strptime(s[:19], '%Y-%m-%dT%H:%M:%S')
                except Exception:
                    return None
            try:
                if d.tzinfo is not None:
                    d=d.astimezone(_dt_v394.timezone.utc).replace(tzinfo=None)
            except Exception:
                pass
            return d
        except Exception:
            return None

    def _v394_keyset(obj):
        keys=set()
        try:
            if not isinstance(obj, dict):
                return keys
            for k in ('uid','id','guid','cot_uid','event_uid','target_uid','data_uid','content_uid','hash','sha256','filename','name','title','callsign'):
                v=obj.get(k)
                if v not in (None,''):
                    keys.add(_v394_lc(v))
            p=obj.get('properties') if isinstance(obj.get('properties'), dict) else {}
            for k in ('uid','id','guid','cot_uid','event_uid','target_uid','data_uid','content_uid','hash','sha256','filename','name','title','callsign'):
                v=p.get(k)
                if v not in (None,''):
                    keys.add(_v394_lc(v))
        except Exception:
            pass
        return {k for k in keys if len(k)>=3}

    def _v394_label(obj):
        try:
            if not isinstance(obj, dict):
                return ''
            p=obj.get('properties') if isinstance(obj.get('properties'), dict) else {}
            for k in ('callsign','name','title','label','filename','uid','id'):
                v=obj.get(k)
                if v not in (None,''):
                    return _v394_text(v).strip()
            for k in ('callsign','name','title','label','filename','uid','id'):
                v=p.get(k)
                if v not in (None,''):
                    return _v394_text(v).strip()
        except Exception:
            pass
        return ''

    def _v394_obj_source(obj):
        try:
            if not isinstance(obj, dict):
                return ''
            p=obj.get('properties') if isinstance(obj.get('properties'), dict) else {}
            return _v394_lc(obj.get('source') or obj.get('source_table') or p.get('source') or p.get('source_table'))
        except Exception:
            return ''

    def _v394_is_mission_uid_object(obj):
        try:
            src=_v394_obj_source(obj)
            return 'mission_uids' in src or 'mission uid' in src or 'mission_uid' in src
        except Exception:
            return False

    def _v394_mission_name_set(out):
        names=set(); create_times=[]
        try:
            for m in out.get('missions') or []:
                if not isinstance(m, dict):
                    continue
                nm=_v394_lc(m.get('name') or m.get('mission_name') or m.get('missionName'))
                if nm:
                    names.add(nm)
                for k in ('create_time','createTime','created','created_at','timestamp','time'):
                    dt=_v394_parse_dt(m.get(k))
                    if dt:
                        create_times.append(dt)
                        break
        except Exception:
            pass
        return names, create_times

    def _v394_mission_uid_filter(out):
        diag={'version':'v394','mode':'strict-current-mission-uid-filter'}
        try:
            if not isinstance(out, dict):
                return out, diag
            objects=list(out.get('objects') or [])
            rows=list(out.get('mission_uids') or [])
            missions=set()
            create_times=[]
            missions, create_times = _v394_mission_name_set(out)
            # If the mission table does not tell us when the current mission was created, do not guess.
            mission_create=min(create_times) if create_times else None
            explicit_count=0; null_before=0; null_after=0; null_no_time=0; other_mission=0
            stale_keys=set(); stale_rows=[]; keep_names=set()
            for r in rows:
                if not isinstance(r, dict):
                    continue
                mn=_v394_lc(r.get('mission_name') or r.get('missionName') or r.get('mission'))
                ts=_v394_parse_dt(r.get('timestamp') or r.get('time') or r.get('created') or r.get('create_time') or r.get('created_at'))
                if mn and (not missions or mn in missions):
                    explicit_count += 1
                    nm=_v394_lc(r.get('callsign') or r.get('name') or r.get('title') or r.get('uid'))
                    if nm:
                        keep_names.add(nm)
                    continue
                if mn and missions and mn not in missions:
                    other_mission += 1
                    continue
                # Key heuristic for this OTS schema: mission_uids rows with null mission_name that predate
                # the mission create_time are accumulated/historical rows, not current ATAK-visible mission members.
                if mission_create and ts and ts < mission_create:
                    null_before += 1
                    keys=_v394_keyset(r)
                    stale_keys.update(keys)
                    if len(stale_rows) < 80:
                        stale_rows.append({'uid':_v394_text(r.get('uid'))[:160], 'callsign':_v394_text(r.get('callsign') or r.get('name'))[:160], 'cot_type':_v394_text(r.get('cot_type') or r.get('type'))[:80], 'mission_name':_v394_text(r.get('mission_name')), 'timestamp':_v394_text(r.get('timestamp') or r.get('time'))[:80], 'reason':'mission_uids row has null mission_name and predates current mission create_time'})
                elif ts:
                    null_after += 1
                else:
                    null_no_time += 1
            before=len(objects); kept=[]; removed=[]
            for obj in objects:
                try:
                    if _v394_is_mission_uid_object(obj) and stale_keys and (_v394_keyset(obj) & stale_keys):
                        if len(removed)<100:
                            removed.append({'uid':_v394_text(obj.get('uid') or obj.get('id'))[:160], 'name':_v394_label(obj)[:160], 'type':_v394_text(obj.get('type') or obj.get('cot_type'))[:80], 'source':_v394_text(obj.get('source') or obj.get('source_table'))[:160], 'reason':'mission_uid object matched a null-mission row older than current mission create_time'})
                        continue
                except Exception:
                    pass
                kept.append(obj)
            out['objects']=kept
            diag.update({
                'policy':'suppress mission_uids objects whose raw OTS row has null mission_name and timestamp before current mission create_time',
                'mission_names':sorted(list(missions))[:20],
                'mission_create_time': mission_create.isoformat() if mission_create else '',
                'mission_uid_rows_total':len(rows),
                'explicit_current_mission_uid_rows':explicit_count,
                'other_mission_uid_rows':other_mission,
                'null_mission_uid_rows_before_create':null_before,
                'null_mission_uid_rows_after_create':null_after,
                'null_mission_uid_rows_without_timestamp':null_no_time,
                'stale_key_count':len(stale_keys),
                'objects_before':before,
                'objects_after':len(kept),
                'removed_count':before-len(kept),
                'removed_sample':removed,
                'stale_uid_sample':stale_rows,
                'note':'The mission table did not contain a current UID manifest. v394 uses mission_name + mission create_time to avoid rendering pre-mission accumulated mission_uids rows that OTS still keeps.'
            })
        except Exception as e:
            diag['error']=str(e)
        return out, diag

    if 'tak_map_data_sync' in globals() and not globals().get('_tak_v394_data_sync_wrapped'):
        _tak_v394_base_data_sync = globals()['tak_map_data_sync']
        def tak_map_data_sync():
            out=_tak_v394_base_data_sync()
            try:
                out, diag = _v394_mission_uid_filter(out)
                if isinstance(out, dict):
                    out['mission_uid_strict_filter']=diag
            except Exception as _e:
                try:
                    out['mission_uid_strict_filter']={'version':'v394','error':str(_e)}
                except Exception:
                    pass
            return out
        globals()['tak_map_data_sync']=tak_map_data_sync
        globals()['_tak_v394_data_sync_wrapped']=True

    _v394_script = """<script id=\"v394StrictMissionUidFilterPatch\">
(function(){
  'use strict';
  const V='v394', d=document, w=window;
  function txt(v){try{return String(v==null?'':v)}catch(_){return ''}}
  function lc(v){return txt(v).toLowerCase().trim()}
  async function ds(reason){return fetch('/api/tak-map/data-sync?force=1&reason='+(reason||'v394-audit')+'&_='+Date.now(),{cache:'no-store',credentials:'same-origin'}).then(r=>r.json())}
  async function audit(){const j=await ds('v394-strict-mission-uid-audit');return {version:V,ok:!!j.ok,objectCount:(j.objects||[]).length,sources:j.sources||[],mission_uid_strict_filter:j.mission_uid_strict_filter||null,mission_content_strict_filter:j.mission_content_strict_filter||null,mission_orphan_shape_filter:j.mission_orphan_shape_filter||null,sampleObjects:(j.objects||[]).slice(0,60).map(o=>({name:o.name||o.callsign||o.title||null,uid:o.uid||o.id||o.cot_uid||null,type:o.type||o.cot_type||null,source:o.source||o._source||o.source_table||null}))};}
  async function hard(){try{if(typeof w.forceTakMapLayerHardRefreshV393==='function')await w.forceTakMapLayerHardRefreshV393()}catch(_){} try{await w.refreshCot()}catch(_){} try{await w.refreshDataSync(true,'v394-hard-refresh')}catch(_){} try{if(typeof w.sweepTakMapOrphanMissionLayersV392==='function')await w.sweepTakMapOrphanMissionLayersV392('v394-hard-refresh')}catch(_){} try{await w.refreshLocalData()}catch(_){} return {version:V,ok:true,audit:await audit().catch(e=>({error:String(e)}))};}
  async function trace(name){const needle=lc(name);const j=await ds('v394-trace').catch(e=>({error:String(e)}));let base=null;try{if(typeof w.getTakMapDeletionTraceV393==='function')base=await w.getTakMapDeletionTraceV393(name)}catch(e){base={error:String(e)}};function scan(rows){try{return (rows||[]).filter(r=>JSON.stringify(r).toLowerCase().indexOf(needle)>=0).slice(0,40)}catch(_){return []}}return {version:V,name:name||'',objectCount:(j.objects||[]).length,matchingObjects:scan(j.objects),matchingMissionUids:scan(j.mission_uids),mission_uid_strict_filter:j.mission_uid_strict_filter||null,baseV393:base,patches:{audit:typeof w.getDataSyncMissionUidStrictAuditV394==='function',hard:typeof w.forceTakMapLayerHardRefreshV394==='function'}};}
  function boot(){try{d.documentElement.dataset.takMapIteration=V;d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,100)},{once:true});else setTimeout(boot,100);
  [500,1500,3500,7000].forEach(ms=>setTimeout(boot,ms));
  w.getDataSyncMissionUidStrictAuditV394=audit;
  w.forceTakMapLayerHardRefreshV394=hard;
  w.getTakMapDeletionTraceV394=trace;
  w.__takDataSyncStrictMissionUidFilterV394={version:V,mode:'suppress-pre-mission-null-mission_uid-rows'};
})();
</script>"""

    def _tak_v394_add(_html):
        if not isinstance(_html, str):
            return _html
        _html = _re_v394.sub(r'<script[^>]*id=["\']v394StrictMissionUidFilterPatch["\'][\s\S]*?</script>', '', _html, flags=_re_v394.I)
        _html = _html.replace('tak-map-v393', 'tak-map-v394').replace('TAK-Map/1.2.0 v393', 'TAK-Map/1.2.0 v394')
        _html = _re_v394.sub(r'<span class="iteration-chip">v\d+</span>', '<span class="iteration-chip">v394</span>', _html)
        _html = _re_v394.sub(r'<div class="iteration-marker">v\d+</div>', '<div class="iteration-marker">v394</div>', _html)
        if 'id="v394StrictMissionUidFilterPatch"' not in _html:
            _html = _html.replace('</body>', _v394_script + '\n</body>', 1) if '</body>' in _html else _html + _v394_script
        return _html

    for _nm in ('TAK_MAP_HTML','INDEX_HTML'):
        if _nm in globals():
            globals()[_nm] = _tak_v394_add(globals()[_nm])
    if '_html' in globals():
        globals()['_html'] = _tak_v394_add(globals()['_html'])
except Exception as _e_v394:
    try:
        print('v394 strict Mission UID filter patch failed', _e_v394)
    except Exception:
        pass
# --- end TAK Map v394 patch ---



# --- TAK Map v395 TAKMAP local point/EUD ghost suppression ---
try:
    import re as _re_v395
    from datetime import datetime as _dt_v395

    def _v395_text(v):
        try:
            return str(v or '').strip()
        except Exception:
            return ''

    def _v395_lc(v):
        return _v395_text(v).lower()

    def _v395_row_get(row, names, default=''):
        try:
            g=globals().get('_row_ci_get')
            if callable(g):
                v=g(row, names, None)
                if v not in (None,''):
                    return v
        except Exception:
            pass
        try:
            low={str(k).lower():k for k in (row or {}).keys()}
            for n in names:
                k=low.get(str(n).lower())
                if k is not None and (row or {}).get(k) not in (None,''):
                    return (row or {}).get(k)
        except Exception:
            pass
        return default

    def _v395_parse(row):
        try:
            p=globals().get('_parse_cot_text_fields')
            if callable(p):
                return p(row) or {}
        except Exception:
            pass
        return {}

    def _v395_row_blob(row, extra=None):
        vals=[]
        try:
            if isinstance(row, dict):
                for k,v in row.items():
                    if isinstance(v, (dict,list,tuple)):
                        try: vals.append(json.dumps(v, default=str)[:6000])
                        except Exception: pass
                    else:
                        vals.append(_v395_text(v)[:6000])
        except Exception:
            pass
        try:
            if isinstance(extra, dict):
                vals.extend(_v395_text(v)[:6000] for v in extra.values())
        except Exception:
            pass
        return ' '.join(vals).lower()

    def _v395_uidish_values(row, parsed=None, obj=None):
        vals=[]
        try:
            parsed=parsed or {}
            for src in (row or {}, parsed or {}, obj or {}):
                if not isinstance(src, dict):
                    continue
                for k in ('uid','id','cot_uid','event_uid','clientuid','clientUid','client_uid','device_uid','target_uid'):
                    v=src.get(k)
                    if v not in (None,''):
                        vals.append(_v395_text(v))
        except Exception:
            pass
        return vals

    def _v395_is_takmap_local_uid(v):
        v=_v395_lc(v)
        return v.startswith(('takmap-local-','takmap-shape-','takmap-draw-'))

    def _v395_is_takmap_local_object(row=None, xml='', obj=None, parsed=None):
        """True for TAK Map-created local points/routes/shapes that leaked into OTS as live CoT/EUD rows.

        This is deliberately different from a real TAK client/EUD: it keys on event/local-object UIDs
        and package/local-data markers, not on the sender device UID alone.
        """
        try:
            row=row or {}
            parsed=parsed or _v395_parse(row)
            blob=' '.join([_v395_row_blob(row, parsed), _v395_text(xml).lower(), _v395_row_blob(obj or {})])
            uids=_v395_uidish_values(row, parsed, obj)
            if any(_v395_is_takmap_local_uid(u) for u in uids):
                return True
            if 'takmap-local-' in blob or 'takmap-shape-' in blob or 'takmap-draw-' in blob:
                return True
            # TAK Map package/local-data labels sometimes survive without the local UID in the normalized object.
            if ('tak map local point' in blob or 'tak-map local point' in blob or 'takmap local point' in blob):
                return True
            if ('local-data' in blob or 'local_data' in blob) and ('tak-map' in blob or 'tak map' in blob or 'takmap' in blob or 'tak-dashboard' in blob):
                return True
        except Exception:
            pass
        return False

    def _v395_obj_keyset(o):
        keys=set()
        try:
            if not isinstance(o, dict):
                return keys
            for k in ('uid','id','cot_uid','event_uid','hash','filename','name','callsign','title'):
                v=o.get(k)
                if v not in (None,''):
                    keys.add(_v395_lc(v))
            p=o.get('properties') if isinstance(o.get('properties'), dict) else {}
            for k in ('uid','id','cot_uid','event_uid','hash','filename','name','callsign','title'):
                v=p.get(k)
                if v not in (None,''):
                    keys.add(_v395_lc(v))
        except Exception:
            pass
        return {k for k in keys if len(k)>=3}

    def _v395_source(o):
        try:
            return _v395_lc((o or {}).get('source') or (o or {}).get('_source') or (o or {}).get('source_table'))
        except Exception:
            return ''

    def _v395_label(o):
        try:
            return _v395_text((o or {}).get('callsign') or (o or {}).get('name') or (o or {}).get('title') or (o or {}).get('uid') or (o or {}).get('id'))
        except Exception:
            return ''

    def _v395_type(o):
        try:
            return _v395_lc((o or {}).get('type') or (o or {}).get('cot_type') or (o or {}).get('kind'))
        except Exception:
            return ''

    # Prevent TAKMAP local objects from normalizing into live CoT/EUD markers.
    if '_normalize_tak_marker' in globals() and not globals().get('_tak_v395_normalize_wrapped'):
        _tak_v395_base_normalize = globals()['_normalize_tak_marker']
        def _normalize_tak_marker(row, source_table='cot', default_kind='cot'):
            try:
                st=_v395_lc(source_table)
                dk=_v395_lc(default_kind)
                if (dk in ('cot','eud') or st in ('cot','euds','eud_stats','markers','points')) and _v395_is_takmap_local_object(row):
                    return None
            except Exception:
                pass
            return _tak_v395_base_normalize(row, source_table, default_kind)
        globals()['_normalize_tak_marker']=_normalize_tak_marker
        globals()['_tak_v395_normalize_wrapped']=True

    # Prevent TAKMAP local object CoT XML from being accepted as real EUD clients.
    if '_is_real_eud_candidate' in globals() and not globals().get('_tak_v395_real_eud_wrapped'):
        _tak_v395_base_real_eud = globals()['_is_real_eud_candidate']
        def _is_real_eud_candidate(e, xml=''):
            try:
                if _v395_is_takmap_local_object(e, xml=xml, obj=e):
                    return False
            except Exception:
                pass
            return _tak_v395_base_real_eud(e, xml)
        globals()['_is_real_eud_candidate']=_is_real_eud_candidate
        globals()['_tak_v395_real_eud_wrapped']=True

    def _v395_filter_live_markers(markers):
        kept=[]; removed=[]
        try:
            for m in markers or []:
                if _v395_is_takmap_local_object(obj=m):
                    if len(removed)<80:
                        removed.append({'uid':_v395_text(m.get('uid') or m.get('id'))[:160], 'callsign':_v395_text(m.get('callsign') or m.get('name'))[:160], 'type':_v395_text(m.get('type') or m.get('cot_type'))[:80], 'kind':_v395_text(m.get('kind'))[:40], 'source':_v395_text(m.get('source') or m.get('source_table'))[:160], 'reason':'TAKMAP local object must not render as live CoT/EUD'})
                    continue
                kept.append(m)
        except Exception:
            return markers or [], []
        return kept, removed

    if 'tak_map_cot_markers' in globals() and not globals().get('_tak_v395_cot_wrapped'):
        _tak_v395_base_cot = globals()['tak_map_cot_markers']
        def tak_map_cot_markers():
            out=_tak_v395_base_cot()
            try:
                if isinstance(out, dict):
                    before=len(out.get('markers') or [])
                    kept, removed=_v395_filter_live_markers(out.get('markers') or [])
                    out['markers']=kept
                    out['takmap_local_object_live_filter']={'version':'v395','mode':'suppress-takmap-local-points-from-live-cot-eud-layer','markers_before':before,'markers_after':len(kept),'removed_count':len(removed),'removed_sample':removed[:40]}
            except Exception as _e:
                try: out['takmap_local_object_live_filter']={'version':'v395','error':str(_e)}
                except Exception: pass
            return out
        globals()['tak_map_cot_markers']=tak_map_cot_markers
        globals()['_tak_v395_cot_wrapped']=True

    if 'tak_map_euds' in globals() and not globals().get('_tak_v395_euds_wrapped'):
        _tak_v395_base_euds = globals()['tak_map_euds']
        def tak_map_euds():
            out=_tak_v395_base_euds()
            try:
                if isinstance(out, dict):
                    before=len(out.get('euds') or [])
                    kept=[]; removed=[]
                    for e in out.get('euds') or []:
                        if _v395_is_takmap_local_object(obj=e):
                            if len(removed)<80:
                                removed.append({'uid':_v395_text(e.get('uid'))[:160], 'callsign':_v395_text(e.get('callsign'))[:160], 'client':_v395_text(e.get('client') or e.get('client_label'))[:120], 'source':_v395_text(e.get('source'))[:120], 'reason':'TAKMAP local object must not be listed as an EUD'})
                            continue
                        kept.append(e)
                    out['euds']=kept
                    out['takmap_local_eud_filter']={'version':'v395','mode':'suppress-takmap-local-points-from-eud-list','euds_before':before,'euds_after':len(kept),'removed_count':len(removed),'removed_sample':removed[:40]}
            except Exception as _e:
                try: out['takmap_local_eud_filter']={'version':'v395','error':str(_e)}
                except Exception: pass
            return out
        globals()['tak_map_euds']=tak_map_euds
        globals()['_tak_v395_euds_wrapped']=True

    # Also suppress TAKMAP-LOCAL mission_uids rows with no explicit mission_name from Data Sync rendering.
    # Those rows are the same local point/route CoT events OTS sometimes misclassifies as EUDs.
    if 'tak_map_data_sync' in globals() and not globals().get('_tak_v395_data_sync_wrapped'):
        _tak_v395_base_ds = globals()['tak_map_data_sync']
        def tak_map_data_sync():
            out=_tak_v395_base_ds()
            try:
                if not isinstance(out, dict):
                    return out
                rows=[r for r in (out.get('mission_uids') or []) if isinstance(r, dict)]
                stale_keys=set(); stale_rows=[]; explicit_current=set()
                for r in rows:
                    uid=_v395_lc(r.get('uid') or r.get('id') or r.get('cot_uid'))
                    mn=_v395_text(r.get('mission_name') or r.get('missionName') or r.get('mission')).strip()
                    if _v395_is_takmap_local_uid(uid) and mn:
                        explicit_current.add(uid)
                for r in rows:
                    uid=_v395_lc(r.get('uid') or r.get('id') or r.get('cot_uid'))
                    mn=_v395_text(r.get('mission_name') or r.get('missionName') or r.get('mission')).strip()
                    if not _v395_is_takmap_local_uid(uid):
                        continue
                    if mn:
                        continue
                    # Null-mission TAKMAP-LOCAL rows are not reliable Data Sync membership; they are local-object CoT ghosts.
                    ks=_v395_obj_keyset(r)
                    stale_keys.update(ks)
                    if len(stale_rows)<100:
                        stale_rows.append({'uid':_v395_text(r.get('uid'))[:160], 'callsign':_v395_text(r.get('callsign') or r.get('name'))[:160], 'cot_type':_v395_text(r.get('cot_type') or r.get('type'))[:80], 'mission_name':_v395_text(r.get('mission_name')), 'timestamp':_v395_text(r.get('timestamp') or r.get('time'))[:80], 'reason':'TAKMAP-LOCAL mission_uid row has no explicit mission_name; treat as live/local ghost rather than current Data Sync object'})
                objects=list(out.get('objects') or [])
                kept=[]; removed=[]
                for o in objects:
                    try:
                        src=_v395_source(o)
                        keys=_v395_obj_keyset(o)
                        uid=_v395_lc((o or {}).get('uid') or (o or {}).get('id') or (o or {}).get('cot_uid'))
                        mission=_v395_text((o or {}).get('mission') or (o or {}).get('mission_name')).strip()
                        if 'mission_uids' in src and stale_keys and (keys & stale_keys) and _v395_is_takmap_local_uid(uid) and not mission:
                            if len(removed)<100:
                                removed.append({'uid':_v395_text((o or {}).get('uid') or (o or {}).get('id'))[:160], 'name':_v395_label(o)[:160], 'type':_v395_text((o or {}).get('type') or (o or {}).get('cot_type'))[:80], 'source':_v395_text((o or {}).get('source'))[:160], 'reason':'TAKMAP-LOCAL null-mission UID object suppressed as EUD/live ghost'})
                            continue
                    except Exception:
                        pass
                    kept.append(o)
                out['objects']=kept
                out['takmap_local_eud_ghost_filter']={'version':'v395','mode':'suppress-takmap-local-null-mission-uids-from-datasync-and-live-eud-ghosts','objects_before':len(objects),'objects_after':len(kept),'removed_count':len(removed),'removed_sample':removed[:100],'stale_uid_row_count':len(stale_rows),'stale_uid_rows':stale_rows[:100],'explicit_current_takmap_local_uid_count':len(explicit_current),'note':'TAK Map local point/route CoT rows can be retained by OTS as null-mission mission_uids and/or classified as EUDs. v395 hides null-mission TAKMAP-LOCAL rows unless OTS explicitly attaches them to the current mission.'}
            except Exception as _e:
                try: out['takmap_local_eud_ghost_filter']={'version':'v395','error':str(_e)}
                except Exception: pass
            return out
        globals()['tak_map_data_sync']=tak_map_data_sync
        globals()['_tak_v395_data_sync_wrapped']=True

    _v395_script = """<script id=\"v395TakMapLocalEudGhostFilterPatch\">
(function(){
  'use strict';
  const V='v395', w=window, d=document;
  function txt(v){try{return String(v==null?'':v)}catch(_){return ''}}
  function lc(v){return txt(v).toLowerCase().trim()}
  function blob(o){try{return JSON.stringify(o||{}).toLowerCase()}catch(_){return lc(o)}}
  function isLocalGhost(o){const b=blob(o);if(/takmap-(local|shape|draw)-/.test(b))return true;if(/tak map local point|tak-map local point|takmap local point/.test(b))return true;if((b.includes('local-data')||b.includes('local_data'))&&(b.includes('tak-map')||b.includes('tak map')||b.includes('takmap')||b.includes('tak-dashboard')))return true;return false;}
  function filterCotJson(j){try{if(j&&Array.isArray(j.markers)){const before=j.markers.length, removed=[];j.markers=j.markers.filter(function(m){if(isLocalGhost(m)){if(removed.length<40)removed.push({uid:m.uid||m.id||'',callsign:m.callsign||m.name||'',type:m.type||m.cot_type||'',kind:m.kind||'',source:m.source||m.source_table||''});return false}return true});j.takmap_local_object_live_filter_client={version:V,markers_before:before,markers_after:j.markers.length,removed_count:removed.length,removed_sample:removed};}
    if(j&&Array.isArray(j.euds)){const before=j.euds.length, removed=[];j.euds=j.euds.filter(function(e){if(isLocalGhost(e)){if(removed.length<40)removed.push({uid:e.uid||'',callsign:e.callsign||'',client:e.client_label||e.client||'',source:e.source||''});return false}return true});j.takmap_local_eud_filter_client={version:V,euds_before:before,euds_after:j.euds.length,removed_count:removed.length,removed_sample:removed};}
  }catch(_){} return j;}
  function patchFetch(){try{if(w.__v395TakMapLocalGhostFetchPatched||typeof w.fetch!=='function')return;const old=w.fetch;w.fetch=function(input,init){const url=txt((input&&input.url)||input||'');const p=old.apply(this,arguments);if(url.indexOf('/api/tak-map/cot')<0&&url.indexOf('/api/tak-map/euds')<0)return p;return p.then(function(resp){try{return resp.clone().json().then(function(j){j=filterCotJson(j);return new Response(JSON.stringify(j),{status:resp.status,statusText:resp.statusText,headers:resp.headers});}).catch(function(){return resp});}catch(_){return resp;}})};w.__v395TakMapLocalGhostFetchPatched=true;}catch(e){try{console.warn('v395 fetch patch failed',e)}catch(_){}}}
  function patchRefresh(){try{if(!w.__v395RefreshCotPatched&&typeof w.refreshCot==='function'){const base=w.refreshCot;w.refreshCot=async function(){const out=await base.apply(this,arguments);try{if(Array.isArray(w.lastTakMarkers))w.lastTakMarkers=w.lastTakMarkers.filter(x=>!isLocalGhost(x));}catch(_){}return out};try{refreshCot=w.refreshCot}catch(_){}w.__v395RefreshCotPatched=true;}
  }catch(e){try{console.warn('v395 refresh patch failed',e)}catch(_){}}}
  async function getJson(path,reason){return fetch(path+(path.indexOf('?')>=0?'&':'?')+'reason='+(reason||V)+'&_='+Date.now(),{cache:'no-store',credentials:'same-origin'}).then(r=>r.json())}
  async function audit(){const ds=await getJson('/api/tak-map/data-sync','v395-audit').catch(e=>({error:String(e)}));const cot=await getJson('/api/tak-map/cot','v395-audit').catch(e=>({error:String(e)}));const euds=await getJson('/api/tak-map/euds','v395-audit').catch(e=>({error:String(e)}));return {version:V,ok:!(ds.error||cot.error||euds.error),objectCount:(ds.objects||[]).length,markerCount:(cot.markers||[]).length,eudCount:(euds.euds||[]).length,takmap_local_eud_ghost_filter:ds.takmap_local_eud_ghost_filter||null,takmap_local_object_live_filter:cot.takmap_local_object_live_filter||cot.takmap_local_object_live_filter_client||null,takmap_local_eud_filter:euds.takmap_local_eud_filter||euds.takmap_local_eud_filter_client||null,mission_uid_strict_filter:ds.mission_uid_strict_filter||null,mission_content_strict_filter:ds.mission_content_strict_filter||null,sources:{dataSync:ds.sources||[],cot:cot.sources||[],euds:euds.sources||[]}};}
  async function hard(){patchFetch();patchRefresh();try{if(typeof w.forceTakMapLayerHardRefreshV394==='function')await w.forceTakMapLayerHardRefreshV394()}catch(_){} try{if(typeof w.refreshCot==='function')await w.refreshCot()}catch(_){} try{if(typeof w.refreshDataSync==='function')await w.refreshDataSync(true,'v395-hard-refresh')}catch(_){} try{if(typeof w.refreshLocalData==='function')await w.refreshLocalData()}catch(_){} try{if(typeof w.sweepTakMapOrphanMissionLayersV392==='function')await w.sweepTakMapOrphanMissionLayersV392('v395-hard-refresh')}catch(_){} return {version:V,ok:true,audit:await audit().catch(e=>({error:String(e)}))};}
  async function trace(name){const needle=lc(name);const ds=await getJson('/api/tak-map/data-sync','v395-trace').catch(e=>({error:String(e)}));const cot=await getJson('/api/tak-map/cot','v395-trace').catch(e=>({error:String(e)}));const euds=await getJson('/api/tak-map/euds','v395-trace').catch(e=>({error:String(e)}));function scan(rows){try{return (rows||[]).filter(r=>JSON.stringify(r).toLowerCase().indexOf(needle)>=0||isLocalGhost(r)).slice(0,60)}catch(_){return []}}let base=null;try{if(typeof w.getTakMapDeletionTraceV394==='function')base=await w.getTakMapDeletionTraceV394(name)}catch(e){base={error:String(e)}}return {version:V,name:name||'',baseV394:base,matchingObjects:scan(ds.objects),matchingMissionUids:scan(ds.mission_uids),matchingCotMarkers:scan(cot.markers),matchingEuds:scan(euds.euds),filters:{dataSync:ds.takmap_local_eud_ghost_filter||null,cot:cot.takmap_local_object_live_filter||cot.takmap_local_object_live_filter_client||null,euds:euds.takmap_local_eud_filter||euds.takmap_local_eud_filter_client||null},patches:{fetch:!!w.__v395TakMapLocalGhostFetchPatched,refreshCot:!!w.__v395RefreshCotPatched}};}
  function boot(){try{d.documentElement.dataset.takMapIteration=V;d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} patchFetch();patchRefresh();}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,100)},{once:true});else setTimeout(boot,100);[500,1500,3500,7000].forEach(ms=>setTimeout(boot,ms));
  w.getTakMapLocalEudGhostAuditV395=audit;
  w.forceTakMapLayerHardRefreshV395=hard;
  w.getTakMapLocalEudGhostTraceV395=trace;
  w.__takMapLocalEudGhostFilterV395={version:V,mode:'suppress-takmap-local-points-routes-from-eud-and-live-cot-layers'};
})();
</script>"""

    def _tak_v395_add(_html):
        if not isinstance(_html, str):
            return _html
        _html = _re_v395.sub(r'<script[^>]*id=["\']v395TakMapLocalEudGhostFilterPatch["\'][\s\S]*?</script>', '', _html, flags=_re_v395.I)
        _html = _html.replace('tak-map-v394', 'tak-map-v395').replace('TAK-Map/1.2.0 v394', 'TAK-Map/1.2.0 v395')
        _html = _re_v395.sub(r'<span class="iteration-chip">v\d+</span>', '<span class="iteration-chip">v395</span>', _html)
        _html = _re_v395.sub(r'<div class="iteration-marker">v\d+</div>', '<div class="iteration-marker">v395</div>', _html)
        if 'id="v395TakMapLocalEudGhostFilterPatch"' not in _html:
            _html = _html.replace('</body>', _v395_script + '\n</body>', 1) if '</body>' in _html else _html + _v395_script
        return _html

    for _nm in ('TAK_MAP_HTML','INDEX_HTML'):
        if _nm in globals():
            globals()[_nm] = _tak_v395_add(globals()[_nm])
    if '_html' in globals():
        globals()['_html'] = _tak_v395_add(globals()['_html'])
except Exception as _e_v395:
    try:
        print('v395 TAKMAP local EUD ghost suppression patch failed', _e_v395)
    except Exception:
        pass
# --- end TAK Map v395 patch ---


# --- TAK Map v396 non-EUD point publish root fix ---
try:
    import re as _re_v396

    def _v396_text(v):
        try:
            return str(v if v is not None else '')
        except Exception:
            return ''

    def _v396_lc(v):
        return _v396_text(v).lower().strip()

    def _v396_versions(_html):
        if not isinstance(_html, str):
            return _html
        _html = _re_v396.sub(r"const\s+V\s*=\s*(['\"])v\d+\1", "const V='v396'", _html)
        _html = _re_v396.sub(r'TAK-Map/1\.1\.0\s+v\d+', 'TAK-Map/1.2.0 v396', _html)
        _html = _re_v396.sub(r'TAKDashboard/v\d+', 'TAKDashboard/v396', _html)
        _html = _re_v396.sub(r'tak-map-v\d+', 'tak-map-v399', _html)
        _html = _re_v396.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v396\2', _html, flags=_re_v396.I)
        _html = _re_v396.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v396\2', _html, flags=_re_v396.I)
        _html = _re_v396.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v396\2', _html, flags=_re_v396.I)
        return _html

    def _v396_feature_kind(f):
        try:
            return _local_data_feature_kind(f)
        except Exception:
            return _v396_lc((f or {}).get('kind') or (f or {}).get('geometry') or (f or {}).get('type')) or 'point'

    def _v396_point_features(features, kind=''):
        feats=list(features or [])
        if not feats:
            return []
        k=_v396_lc(kind)
        if k in ('route','routes','shape','shapes'):
            return []
        out=[]
        for f in feats:
            try:
                pts=_local_data_feature_points(f) or []
            except Exception:
                pts=[]
            if _v396_feature_kind(f) != 'point' or len(pts) != 1:
                return []
            out.append(f)
        return out

    def _v396_name_from_feature(f, fallback='Point'):
        try:
            return (_v331_name_from_feature(f, fallback) if callable(globals().get('_v331_name_from_feature')) else fallback)[:120]
        except Exception:
            return fallback

    def _v396_remarks_from_feature(f):
        try:
            return _v331_remarks_from_feature(f) if callable(globals().get('_v331_remarks_from_feature')) else ''
        except Exception:
            return ''

    def _v396_cot_type_for_point(f):
        try:
            props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
            for k in ('cot_type','atak_cot_type','type','sidc','mil2525_sidc'):
                v=_v396_text((f or {}).get(k) or props.get(k)).strip()
                if v and _re_v396.match(r'^[a-z]-', v, _re_v396.I) and not v.lower().startswith('u-d-'):
                    return v[:80]
        except Exception:
            pass
        try:
            v=_v331_cot_type_for_feature(f) if callable(globals().get('_v331_cot_type_for_feature')) else ''
            if v and not _v396_lc(v).startswith('u-d-'):
                return str(v)[:80]
        except Exception:
            pass
        return 'a-f-G-U-C'

    def _v396_stable_point_uid(f, idx, package_uid):
        # Root fix: never use TAKMAP-LOCAL-* for mission-published points.  OTS can retain those
        # rows as live/EUD-like mission_uids.  Use a mission-point namespace instead.
        try:
            pts=_local_data_feature_points(f) or []
            p=pts[0] if pts else [0,0]
        except Exception:
            p=[0,0]
        try:
            props=(f or {}).get('properties') if isinstance((f or {}).get('properties'), dict) else {}
            name=_v396_name_from_feature(f, 'Point')
            existing=_v396_text((f or {}).get('uid') or props.get('uid') or (f or {}).get('id') or props.get('id'))
            basis=json.dumps(json_safe({'existing':existing,'name':name,'lat':round(float(p[0]),7),'lon':round(float(p[1]),7),'idx':idx,'package_uid':package_uid}), sort_keys=True)
        except Exception:
            basis=_v396_text(f)[:4096] + str(idx) + _v396_text(package_uid)
        return 'TAKMAP-MISSION-POINT-' + hashlib.sha1(basis.encode('utf-8','ignore')).hexdigest()[:24]

    def _v396_safe_zip_component(value, fallback='point'):
        try:
            if callable(globals().get('_v335_safe_zip_component')):
                return _v335_safe_zip_component(value, fallback)
        except Exception:
            pass
        v=_re_v396.sub(r'[^A-Za-z0-9._:@+-]+','_', _v396_text(value)).strip('._-')
        return (v or fallback)[:96]

    def _v396_point_cot_event_for_feature(f, idx, package_uid, package_title='TAK Map Point'):
        pts=_local_data_feature_points(f) or []
        if len(pts) != 1:
            return {'ok':False,'error':'Point package event requires exactly one point.','uid':''}
        lat=float(pts[0][0]); lon=float(pts[0][1])
        now=datetime.now(timezone.utc)
        stale=now + timedelta(days=3650)
        uid=_v396_stable_point_uid(f, idx, package_uid)
        name=_v396_name_from_feature(f, 'Point')
        cot_type=_v396_cot_type_for_point(f)
        event=ET.Element('event', {
            'version':'2.0',
            'uid':uid,
            'type':cot_type,
            'how':'h-g-i-g-o',
            'time':_cot_time(now),
            'start':_cot_time(now),
            'stale':_cot_time(stale),
            'access':'Undefined'
        })
        ET.SubElement(event, 'point', {'lat':f'{lat:.7f}','lon':f'{lon:.7f}','hae':str(_coerce_float((f or {}).get('hae') or (f or {}).get('alt') or (f or {}).get('altitude')) or '0'),'ce':'9999999.0','le':'9999999.0'})
        detail=ET.SubElement(event, 'detail')
        ET.SubElement(detail, 'contact', {'callsign':name})
        ET.SubElement(detail, 'archive')
        ET.SubElement(detail, 'takmap_point', {'mode':'mission-package-only','live':'false','eud':'false','version':'v396','packageUid':str(package_uid)})
        ET.SubElement(detail, 'link', {'uid':str(package_uid), 'type':'b-f-t-r', 'relation':'p-p'})
        remarks=_v396_remarks_from_feature(f)
        mission_note='Created by TAK Map v396 as mission package point only; not a live EUD/contact.'
        ET.SubElement(detail, 'remarks').text='\n'.join([x for x in (remarks, mission_note) if x])[:3000]
        # Intentionally omit takv/precisionlocation/client metadata.  Those are useful for live EUDs,
        # but for saved point annotations they increase the chance that OTS treats the item as a device.
        xml='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(event, encoding='unicode', short_empty_elements=True)
        return {'ok':True,'uid':uid,'name':name,'cot_type':cot_type,'xml':xml,'lat':lat,'lon':lon}

    def _v396_package_validation(zip_path):
        try:
            if callable(globals().get('_v335_package_validation')):
                out=_v335_package_validation(zip_path)
            elif callable(globals().get('_v331_package_validation')):
                out=_v331_package_validation(zip_path)
            else:
                out={}
        except Exception as e:
            out={'error':str(e)}
        try:
            out['package_mode']='v396-non-eud-point-mission-package'
            out['live_cot_suppressed']=True
            out['mission_uid_association_skipped']=True
        except Exception:
            pass
        return out

    def _v396_build_point_mission_package(features, label, stamp):
        TAK_MAP_SEND_PACKAGE_DIR.mkdir(parents=True, exist_ok=True)
        feats=_v396_point_features(features, 'points')
        if not feats:
            return {'ok':False,'error':'No point-only Local Data selection was available for v396 point package publish.'}
        try:
            title=_v334_display_title_from_features(feats, 'Point') if callable(globals().get('_v334_display_title_from_features')) else (label or 'TAK Map Points')
            title=_v334_clean_package_title(title, 'Point') if callable(globals().get('_v334_clean_package_title')) else _v396_text(title).strip()
        except Exception:
            title=_v396_text(label or 'TAK Map Points').strip() or 'TAK Map Points'
        package_uid='takmap-point-package-' + stamp + '-' + hashlib.sha1((json.dumps(json_safe(feats), sort_keys=True)[:8192] + str(uuid.uuid4())).encode('utf-8','ignore')).hexdigest()[:14]
        package_title=f'{title} - TAK Map - {stamp}'
        safe_title=_safe_filename_label(package_title, 'zip')[:-4]
        zip_name=f'{safe_title}.zip'
        zip_id=_safe_offline_id('tak-point-dp-v396-' + hashlib.sha256((package_uid+zip_name).encode()).hexdigest()[:16])
        zip_path=TAK_MAP_SEND_PACKAGE_DIR/(zip_id + '.zip')
        cot_entries=[]; point_meta=[]
        for idx,f in enumerate(feats):
            built=_v396_point_cot_event_for_feature(f, idx, package_uid, package_title)
            if built.get('ok'):
                uid=built.get('uid') or ('TAKMAP-MISSION-POINT-' + uuid.uuid4().hex[:20])
                file_uid=_v396_safe_zip_component(uid, 'point-' + str(idx+1))
                entry=f'{file_uid}/{file_uid}.cot'
                cot_entries.append({'uid':uid,'entry':entry,'bytes':built.get('xml','').encode('utf-8'),'name':built.get('name') or 'Point','cot_type':built.get('cot_type') or ''})
                point_meta.append({k:built.get(k) for k in ('uid','name','cot_type','lat','lon')})
        if not cot_entries:
            return {'ok':False,'error':'No point CoT package entries could be built.'}
        root=ET.Element('MissionPackageManifest', {'version':'2'})
        cfg=ET.SubElement(root, 'Configuration')
        ET.SubElement(cfg, 'Parameter', {'name':'uid', 'value':package_uid})
        ET.SubElement(cfg, 'Parameter', {'name':'name', 'value':package_title})
        ET.SubElement(cfg, 'Parameter', {'name':'remarks', 'value':'TAK Map v396 point package. Mission/Data Sync content only; no live CoT/EUD publish.'})
        contents=ET.SubElement(root, 'Contents')
        for ce in cot_entries:
            c=ET.SubElement(contents, 'Content', {'ignore':'false','zipEntry':ce['entry']})
            ET.SubElement(c, 'Parameter', {'name':'uid','value':ce['uid']})
            ET.SubElement(c, 'Parameter', {'name':'name','value':ce['name']})
            ET.SubElement(c, 'Parameter', {'name':'contentType','value':'CoT Events'})
        manifest_text='<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
        with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
            def write_stable(name, data):
                info=zipfile.ZipInfo(name)
                info.date_time=(2024,1,1,0,0,0)
                info.compress_type=zipfile.ZIP_DEFLATED
                zf.writestr(info, data)
            write_stable('MANIFEST/manifest.xml', manifest_text.encode('utf-8'))
            for ce in cot_entries:
                write_stable(ce['entry'], ce['bytes'])
            write_stable('TAKMAP/v396-point-publish-policy.json', json.dumps({'version':'v396','mode':'mission-package-only-non-eud','package_uid':package_uid,'package_title':package_title,'point_count':len(cot_entries),'live_cot_suppressed':True,'mission_uid_association_skipped':True,'uid_namespace':'TAKMAP-MISSION-POINT','points':point_meta}, indent=2).encode('utf-8'))
        return {'ok':True,'path':str(zip_path),'package_name':zip_name,'package_display_name':package_title,'package_uid':package_uid,'sha256':hashlib.sha256(zip_path.read_bytes()).hexdigest(),'size_bytes':zip_path.stat().st_size,'feature_count':len(feats),'point_count':len(cot_entries),'cot_count':len(cot_entries),'uid_namespace':'TAKMAP-MISSION-POINT','live_cot_suppressed':True,'mission_uid_association_skipped':True,'package_mode':'v396-non-eud-point-mission-package','manifest_path':'MANIFEST/manifest.xml','points':point_meta,'validation':_v396_package_validation(zip_path)}

    def tak_map_publish_point_package_to_mission_v396(features, mission_name='', server_host='', preferred_creator_uid=''):
        feats=_v396_point_features(features, 'points')
        if not feats:
            return {'ok':False,'error':'No publishable point-only Local Data selection was found.','publish_mode':'mission-package-point-v396-no-live-cot'}
        stamp=datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        try:
            title=_v334_display_title_from_features(feats, 'Point') if callable(globals().get('_v334_display_title_from_features')) else ('Local Points' if len(feats)!=1 else _v396_name_from_feature(feats[0], 'Point'))
        except Exception:
            title='Local Points' if len(feats)!=1 else 'Point'
        label=f'{title} - TAK Map Point'
        pkg=_v396_build_point_mission_package(feats, label, stamp)
        if not pkg.get('ok'):
            return pkg
        content_label=pkg.get('package_display_name') or label
        res=tak_map_publish_package_to_mission(Path(pkg['path']), pkg.get('package_name') or 'TAK Map Point.zip', pkg.get('sha256') or '', mission_name, content_label, 'local-data-point-package-v396-no-live-cot', server_host, preferred_creator_uid or (_v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap'))
        if not isinstance(res, dict):
            res={'ok':False,'error':'Mission package publish returned a non-dictionary response.'}
        res['package']=pkg
        res['publish_mode']='mission-package-point-v396-no-live-cot'
        res['content_kind']='local-data-point-package-v396-no-live-cot'
        res['live_cot_suppressed']=True
        res['mission_uid_association_skipped']=True
        res['root_fix']='TAK Map points are now published as mission package content only, not as live CoT or direct Mission UID rows, so OTS should not classify them as EUDs.'
        res['non_package_publish']=False
        res['zip_package_created']=True
        res['zip_upload_skipped']=False
        res['point_count']=len(feats)
        if res.get('ok'):
            mission=str(res.get('mission') or mission_name or '').strip() or 'selected mission'
            res['message']='Published point package to Data Sync Mission: ' + mission + ' (non-EUD package-only mode).'
            res['user_message']=res['message']
            res['publish_succeeded']=True
            res['disable_publish_after_success']=True
            res['close_publish_modal_after_success']=True
            res['data_sync_refresh_recommended']=True
        try:
            diag=_write_send_diag('mission-point-package-publish-v396', res, None)
            if isinstance(diag, dict):
                res['diag_paths']=diag
        except Exception:
            pass
        return res

    _tak_v396_old_local_publish = globals().get('tak_map_local_data_mission_publish')
    def tak_map_local_data_mission_publish(ids, kind='', mission_name='', server_host=''):
        features=_selected_local_data_features(ids)
        if not features:
            return {'ok':False,'error':'No selected Local Data items were found.'}
        pts=_v396_point_features(features, kind)
        if pts and len(pts)==len(features):
            return tak_map_publish_point_package_to_mission_v396(pts, mission_name, server_host, _v331_tak_client_username('takmap') if callable(globals().get('_v331_tak_client_username')) else 'takmap')
        if callable(_tak_v396_old_local_publish):
            return _tak_v396_old_local_publish(ids, kind, mission_name, server_host)
        return {'ok':False,'error':'v396 fallback local publish function is unavailable.'}
    globals()['tak_map_local_data_mission_publish']=tak_map_local_data_mission_publish

    # Guard direct/legacy point publish helpers too.  They should never send TAK Map points as live CoT.
    def tak_map_publish_point_uids_to_mission_v340(features, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_point_package_to_mission_v396(features, mission_name, server_host, preferred_creator_uid)
    globals()['tak_map_publish_point_uids_to_mission_v340']=tak_map_publish_point_uids_to_mission_v340

    def tak_map_publish_point_uid_to_mission_v339(feature, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_point_package_to_mission_v396([feature], mission_name, server_host, preferred_creator_uid)
    globals()['tak_map_publish_point_uid_to_mission_v339']=tak_map_publish_point_uid_to_mission_v339

    def tak_map_publish_cot_to_mission(feature, mission_name='', server_host='', preferred_creator_uid=''):
        return tak_map_publish_point_package_to_mission_v396([feature], mission_name, server_host, preferred_creator_uid)
    globals()['tak_map_publish_cot_to_mission']=tak_map_publish_cot_to_mission

    # Add a small diagnostic note to Data Sync responses so the current point-publish policy is visible.
    if 'tak_map_data_sync' in globals() and not globals().get('_tak_v396_data_sync_policy_wrapped'):
        _tak_v396_base_ds=globals()['tak_map_data_sync']
        def tak_map_data_sync():
            out=_tak_v396_base_ds()
            try:
                if isinstance(out, dict):
                    out['point_publish_non_eud_policy_v396']={'version':'v396','mode':'mission-package-only-no-live-cot','uid_namespace':'TAKMAP-MISSION-POINT','live_cot_publish_disabled':True,'mission_uid_direct_association_disabled':True,'legacy_takmap_local_uid_for_points_disabled':True,'note':'New TAK Map point publishes use mission package content only. Existing TAKMAP-LOCAL ghosts are still handled by v395/v394 filters.'}
            except Exception:
                pass
            return out
        globals()['tak_map_data_sync']=tak_map_data_sync
        globals()['_tak_v396_data_sync_policy_wrapped']=True

    _v396_script = """<script id=\"v396NonEudPointPublishPatch\">
(function(){
  'use strict';
  const V='v396', w=window, d=document;
  function txt(v){try{return String(v==null?'':v)}catch(_){return ''}}
  function setVersion(){try{d.documentElement.dataset.takMapIteration=V;d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){}}
  async function json(path){return fetch(path+(path.indexOf('?')>=0?'&':'?')+'_='+Date.now(),{cache:'no-store',credentials:'same-origin'}).then(r=>r.json())}
  async function audit(){const ds=await json('/api/tak-map/data-sync?reason=v396-point-policy-audit').catch(e=>({error:String(e)}));return {version:V,ok:!ds.error,objectCount:(ds.objects||[]).length,point_publish_non_eud_policy_v396:ds.point_publish_non_eud_policy_v396||null,takmap_local_eud_ghost_filter:ds.takmap_local_eud_ghost_filter||null,mission_uid_strict_filter:ds.mission_uid_strict_filter||null,mission_content_strict_filter:ds.mission_content_strict_filter||null,sources:ds.sources||[]};}
  async function hard(){try{if(typeof w.forceTakMapLayerHardRefreshV395==='function')await w.forceTakMapLayerHardRefreshV395()}catch(_){} try{if(typeof w.refreshDataSync==='function')await w.refreshDataSync(true,'v396-hard-refresh')}catch(_){} try{if(typeof w.refreshCot==='function')await w.refreshCot()}catch(_){} try{if(typeof w.refreshLocalData==='function')await w.refreshLocalData()}catch(_){} return {version:V,ok:true,audit:await audit().catch(e=>({error:String(e)}))};}
  function publishPolicy(){return {version:V,mode:'mission-package-only-no-live-cot',uid_namespace:'TAKMAP-MISSION-POINT',live_cot_publish_disabled:true,mission_uid_direct_association_disabled:true,takmap_local_uid_for_new_points_disabled:true,keeps_v395_ghost_filter:true,note:'New TAK Map local point publishes are packaged as Data Sync/Mission content only; they are not sent on the live CoT/EUD path.'};}
  function boot(){setVersion();try{const st=d.createElement('style');st.id='v396PointPublishStyle';st.textContent='';if(!d.getElementById(st.id))d.head.appendChild(st)}catch(_){}}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,100)},{once:true});else setTimeout(boot,100);[500,1500,3500,7000].forEach(ms=>setTimeout(boot,ms));
  w.getTakMapPointPublishPolicyV396=publishPolicy;
  w.getTakMapNonEudPointPublishAuditV396=audit;
  w.forceTakMapLayerHardRefreshV396=hard;
  w.__takMapPointPublishNonEudV396=publishPolicy();
})();
</script>"""

    def _tak_v396_add(_html):
        if not isinstance(_html, str):
            return _html
        _html = _re_v396.sub(r'<script[^>]*id=["\']v396NonEudPointPublishPatch["\'][\s\S]*?</script>', '', _html, flags=_re_v396.I)
        _html = _v396_versions(_html)
        if 'id="v396NonEudPointPublishPatch"' not in _html:
            _html = _html.replace('</body>', _v396_script + '\n</body>', 1) if '</body>' in _html else _html + _v396_script
        return _v396_versions(_html)

    for _nm in ('TAK_MAP_HTML','TAK_MAP_LOGIN_HTML','LOGIN_HTML','INDEX_HTML'):
        if _nm in globals():
            globals()[_nm]=_tak_v396_add(globals()[_nm])
    if '_html' in globals():
        globals()['_html']=_tak_v396_add(globals()['_html'])
except Exception as _e_v396:
    try:
        print('v396 non-EUD point publish patch failed', _e_v396)
    except Exception:
        pass
# --- end TAK Map v396 patch ---



# --- TAK Map v402 Terrain Mode local DEM stable refresh + local raster reload patch ---
try:
    import re as _re_v402

    def _v402_versions(_html):
