    _I504_OLD_RENDER_TABS = "function renderTabs(){const box=field('viewshedTabs');if(!box)return;const st=window.v249Viewshed;box.innerHTML='';st.views.forEach((v,i)=>{const tab=document.createElement('div');tab.className='viewshed-tab'+(i===st.active?' active':'');tab.title='Click to rename/select';tab.textContent=v.name||('View '+(i+1));tab.onclick=()=>{st.active=i;renderViewshedUi();editViewshedTab(i)};box.appendChild(tab)});const add=document.createElement('div');add.className='viewshed-tab add';add.textContent='+';add.onclick=()=>{st.views.push(defaultView(st.views.length+1));st.active=st.views.length-1;renderViewshedUi();};box.appendChild(add)}"
