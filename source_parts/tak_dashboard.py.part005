function interpNumber(a,b,f){return Number.isFinite(a)&&Number.isFinite(b)?a+(b-a)*f:(Number.isFinite(a)?a:b)}
function interpHeading(a,b,f){if(!Number.isFinite(a))return b;if(!Number.isFinite(b))return a;const aa=((a%360)+360)%360,bb=((b%360)+360)%360;let delta=((bb-aa+540)%360)-180;return(aa+delta*f+360)%360}
