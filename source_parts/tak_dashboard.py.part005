    {id:'beidou',label:'BeiDou',group:'beidou',hint:'BeiDou operational'},
    {id:'sbas',label:'SBAS',group:'sbas',hint:'Satellite-based augmentation'},
    {id:'nnss',label:'NNSS',group:'nnss',hint:'Legacy navigation'},
    {id:'geo',label:'GEO',group:'geo',hint:'Geosynchronous'},
    {id:'intelsat',label:'Intelsat',group:'intelsat',hint:'Commercial GEO'},
    {id:'ses',label:'SES',group:'ses',hint:'Commercial GEO'},
    {id:'amateur',label:'Amateur radio',group:'amateur',hint:'Amateur radio satellites'},
    {id:'x-comm',label:'Experimental comms',group:'x-comm',hint:'Experimental communications'},
    {id:'other-comm',label:'Other comms',group:'other-comm',hint:'Other communications'},
    {id:'satnogs',label:'SatNOGS',group:'satnogs',hint:'SatNOGS related'},
    {id:'sarsat',label:'SARSAT',group:'sarsat',hint:'Search and rescue'},
    {id:'dmc',label:'DMC',group:'dmc',hint:'Disaster Monitoring Constellation'},
    {id:'tdrss',label:'TDRSS',group:'tdrss',hint:'Tracking/Data Relay'},
    {id:'argos',label:'ARGOS',group:'argos',hint:'ARGOS data collection'},
    {id:'military',label:'Military',group:'military',hint:'Military group'},
    {id:'radar',label:'Radar calibration',group:'radar',hint:'Radar calibration objects'},
    {id:'cubesat',label:'CubeSats',group:'cubesat',hint:'CubeSat group'},
    {id:'science',label:'Science',group:'science',hint:'Science satellites'},
    {id:'engineering',label:'Engineering',group:'engineering',hint:'Engineering satellites'},
    {id:'education',label:'Education',group:'education',hint:'Education satellites'},
    {id:'tle-new',label:'Recently launched',group:'tle-new',hint:'New/recent TLE objects'},
    {id:'last-30-days',label:'Launched last 30 days',group:'last-30-days',hint:'Recent launches'},
    {id:'local-upload',label:'Local upload',group:'local-upload',hint:'User-uploaded JSON/TLE data',local:true}
  ];
  const DEFAULT_PREFS={enabled:false,source:'streamed',labels:true,groundTracks:false,trackMinutes:90,updateSec:30,gov:false,private:false,enabledCats:{},categorySearch:'',observerSource:'follow_map_center',manualLat:'',manualLon:'',selectedEud:'',pushVisible:false,passPrediction:false};
  const state={prefs:Object.assign({},DEFAULT_PREFS),cache:{},satrecs:new Map(),layer:null,trackLayer:null,timer:null,lastRender:null,downloading:false,libLoaded:false};
  function $(id){try{return d.getElementById(id)}catch(_){return null}}
  function q(sel,root){try{return (root||d).querySelector(sel)}catch(_){return null}}
  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
  function setVersion(){try{d.documentElement.dataset.takMapIteration=V;qa('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  function loadPrefs(){try{const raw=localStorage.getItem('takMapSatellitePrefsV409');if(raw){const p=JSON.parse(raw);state.prefs=Object.assign({},DEFAULT_PREFS,p||{});state.prefs.enabledCats=Object.assign({},(p&&p.enabledCats)||{})}}catch(_){} }
  function savePrefs(){try{localStorage.setItem('takMapSatellitePrefsV409',JSON.stringify(state.prefs))}catch(_){} }
  function mapObj(){try{return (typeof map!=='undefined'&&map)||w.map||null}catch(_){return w.map||null}}
  function leaflet(){try{return (typeof L!=='undefined'&&L)||w.L||null}catch(_){return w.L||null}}
  function ensureLayers(){const m=mapObj(), L=leaflet();if(!m||!L)return false;if(!state.layer){state.layer=L.layerGroup().addTo(m);state.trackLayer=L.layerGroup().addTo(m)}return true}
  function clearLayers(){try{state.layer&&state.layer.clearLayers();state.trackLayer&&state.trackLayer.clearLayers();if(typeof clearSearchSource==='function')clearSearchSource('satellite')}catch(_){} }
  function status(msg,kind){const el=$('satStatusV409');if(el){el.textContent=msg||'';el.className='muted sat-status-v409 '+(kind||'')} }
  function fmtAge(ts){ts=Number(ts)||0;if(!ts)return 'never';const sec=Math.max(0,Math.round((Date.now()-ts)/1000));if(sec<90)return sec+'s ago';const min=Math.round(sec/60);if(min<90)return min+'m ago';const hr=Math.round(min/60);if(hr<48)return hr+'h ago';return Math.round(hr/24)+'d ago'}
  function normRec(r,cat){r=r||{};const out=Object.assign({},r);out.__category=cat.id;out.__categoryLabel=cat.label;out.__group=cat.group;out.__key=String(r.NORAD_CAT_ID||r.OBJECT_ID||r.satnum||r.SATNUM||r.name||r.OBJECT_NAME||Math.random()).trim();out.__name=String(r.OBJECT_NAME||r.name||r.NAME||r.TITLE||out.__key).trim();out.__class=classify(out,cat);return out}
  function classify(r,cat){const name=String((r&&r.OBJECT_NAME)||(r&&r.__name)||'').toUpperCase();const g=String((cat&&cat.group)||'');if(PRIVATE_GROUPS[g])return 'private';if(/STARLINK|ONEWEB|PLANET|FLOCK|SKYSAT|LEMUR|SPIRE|IRIDIUM|GLOBALSTAR|ORBCOMM|INTELSAT|SES-|O3B|KUIPER/.test(name))return 'private';return 'gov';}
  function catById(id){return CATEGORY_DEFS.find(function(c){return c.id===id})||CATEGORY_DEFS[0]}
  function catRecords(id){const e=state.cache[id];return (e&&Array.isArray(e.records))?e.records:[]}
  function catCount(id){return catRecords(id).length}
  function visibleRecordsWithPrefs(prefs){prefs=prefs||state.prefs;if(!prefs.enabled)return [];const seen={}, out=[];CATEGORY_DEFS.forEach(function(cat){if(!prefs.enabledCats[cat.id])return;const rows=catRecords(cat.id);for(const raw of rows){const r=raw.__category?raw:normRec(raw,cat);if((r.__class==='private'&&!prefs.private)||(r.__class!=='private'&&!prefs.gov))continue;const k=String(r.__key||'');if(k&&seen[k])continue;if(k)seen[k]=1;out.push(r)}});return out}
  function potentialCount(nextPrefs){return visibleRecordsWithPrefs(nextPrefs).length}
  function dbOpen(){return new Promise(function(resolve,reject){try{const req=indexedDB.open(STORE_DB,1);req.onupgradeneeded=function(ev){const db=ev.target.result;if(!db.objectStoreNames.contains(STORE_DATA))db.createObjectStore(STORE_DATA,{keyPath:'id'});};req.onsuccess=function(){resolve(req.result)};req.onerror=function(){reject(req.error||new Error('Satellite IndexedDB open failed'))}}catch(e){reject(e)}})}
  async function dbPut(entry){const db=await dbOpen();return new Promise(function(resolve,reject){try{const tx=db.transaction([STORE_DATA],'readwrite');tx.objectStore(STORE_DATA).put(entry);tx.oncomplete=function(){try{db.close()}catch(_){};resolve(true)};tx.onerror=function(){reject(tx.error||new Error('Satellite cache save failed'))}}catch(e){reject(e)}})}
  async function dbAll(){const db=await dbOpen();return new Promise(function(resolve,reject){try{const tx=db.transaction([STORE_DATA],'readonly');const req=tx.objectStore(STORE_DATA).getAll();req.onsuccess=function(){try{db.close()}catch(_){};resolve(req.result||[])};req.onerror=function(){reject(req.error||new Error('Satellite cache load failed'))}}catch(e){reject(e)}})}
  async function dbClear(){const db=await dbOpen();return new Promise(function(resolve,reject){try{const tx=db.transaction([STORE_DATA],'readwrite');tx.objectStore(STORE_DATA).clear();tx.oncomplete=function(){try{db.close()}catch(_){};resolve(true)};tx.onerror=function(){reject(tx.error||new Error('Satellite cache clear failed'))}}catch(e){reject(e)}})}
  async function loadCache(){try{const rows=await dbAll();state.cache={};rows.forEach(function(e){if(!e||!e.id)return;const cat=catById(e.id);e.records=(e.records||[]).map(function(r){return normRec(r,cat)});state.cache[e.id]=e});renderCategories();renderCacheSummary();return rows}catch(e){status('Satellite cache load failed: '+String(e&&e.message||e),'bad');return []}}
  function renderCacheSummary(){let cats=0,total=0,last=0;Object.keys(state.cache||{}).forEach(function(k){const e=state.cache[k];if(e&&Array.isArray(e.records)){cats++;total+=e.records.length;last=Math.max(last,Number(e.updatedAt)||0)}});const el=$('satCacheSummaryV409');if(el)el.textContent=cats+' cached categories · '+total+' records · updated '+fmtAge(last);const cnt=$('satVisibleCountV409');if(cnt)cnt.textContent=String(visibleRecordsWithPrefs().length)+' visible'}
  function ensureStyle(){if($('v409SatelliteStyle'))return;const st=d.createElement('style');st.id='v409SatelliteStyle';st.textContent=`
    .sat-v409-panel .sat-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}.sat-v409-panel .sat-grid label{display:grid;gap:3px;color:var(--muted);font-size:.72rem}.sat-v409-panel .sat-actions{display:flex;flex-wrap:wrap;gap:6px;margin:7px 0}.sat-v409-panel .sat-actions .layer-button{margin:0}.sat-v409-panel input[type="number"],.sat-v409-panel input[type="text"],.sat-v409-panel select{width:100%;background:#091018;border:1px solid #334553;border-radius:9px;color:var(--text);padding:6px 8px;font-size:.76rem}.sat-v409-list{max-height:235px;overflow:auto;border:1px solid rgba(255,255,255,.07);border-radius:12px;padding:4px;background:rgba(0,0,0,.12)}.sat-v409-row{display:grid;grid-template-columns:18px 1fr auto auto;gap:7px;align-items:center;padding:6px 5px;border-bottom:1px solid rgba(255,255,255,.05);font-size:.76rem}.sat-v409-row:last-child{border-bottom:0}.sat-v409-row b{font-size:.76rem}.sat-v409-row small{display:block;color:var(--muted);font-size:.66rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sat-v409-count{font-size:.69rem;color:#ffd0b0;border:1px solid rgba(255,111,46,.35);border-radius:999px;padding:2px 6px;white-space:nowrap}.sat-v409-mini{padding:3px 6px!important;border-radius:8px!important;font-size:.68rem!important}.sat-v409-subdetails{margin:6px 0;border-top:1px solid rgba(255,255,255,.06);padding-top:6px}.sat-v409-subdetails summary{cursor:pointer;color:#c8d2da;font-size:.72rem;text-transform:uppercase;letter-spacing:.07em;font-weight:900}.sat-status-v409{white-space:pre-wrap;margin-top:6px}.sat-status-v409.good{color:var(--good)}.sat-status-v409.warn{color:var(--warn)}.sat-status-v409.bad{color:var(--bad)}.tak-sat-marker{background:transparent;border:0}.tak-sat-wrap{display:flex;flex-direction:column;align-items:center;pointer-events:none}.tak-sat-dot{width:15px;height:15px;border-radius:50%;border:2px solid currentColor;background:rgba(6,10,14,.70);box-shadow:0 0 8px currentColor}.tak-sat-private{color:#ffcc66}.tak-sat-gov{color:#62b8ff}.tak-sat-label{margin-top:2px;max-width:110px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:rgba(5,8,12,.82);border:1px solid currentColor;border-radius:6px;padding:1px 5px;color:currentColor;font-size:10px;font-weight:900;text-shadow:0 1px 2px #000}.sat-dialog-v409{position:fixed;inset:0;z-index:3500;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.56);backdrop-filter:blur(4px)}.sat-dialog-card-v409{width:min(420px,calc(100vw - 34px));border:1px solid rgba(255,111,46,.48);border-radius:16px;background:linear-gradient(180deg,rgba(18,28,38,.98),rgba(6,10,14,.98));box-shadow:0 22px 60px rgba(0,0,0,.62);padding:14px}.sat-dialog-card-v409 h3{margin:0 0 8px;text-transform:uppercase;letter-spacing:.08em;font-size:.92rem}.sat-dialog-card-v409 p{color:#d9e3ea;font-size:.86rem;line-height:1.35}.sat-dialog-actions-v409{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}`;(d.head||d.documentElement).appendChild(st)}
  function ensurePanel(){if($('satelliteTrackingPanelV409'))return;const gateway=$('gatewayDataPanelV475');const offline=qa('.panel').find(function(p){return /^Offline Maps$/i.test((q('h2',p)?.textContent||'').trim())});const host=d.createElement('div');host.className='panel collapsible sat-v409-panel';host.id='satelliteTrackingPanelV409';host.setAttribute('data-collapse-key','satelliteTracking');host.innerHTML=`<h2 onclick="togglePanelCollapse(this)">Satellite Tracking <span class="panel-toggle">▾</span></h2><div class="panel-body"><div class="row"><label><input id="satEnableV409" type="checkbox"><span>Enable Satellite Tracking</span></label><span class="chip" id="satVisibleCountV409">0 visible</span></div><div class="sat-grid"><label>Data source<select id="satSourceV409"><option value="streamed">Streamed CelesTrak</option><option value="cached">Cached data</option><option value="local">Local upload</option></select></label><label>Update sec<input id="satUpdateSecV409" type="number" min="5" max="600" step="5" value="30"></label></div><div class="sat-actions"><button class="layer-button" id="satDownloadAllV409">Download/Update All</button><button class="layer-button" id="satDownloadEnabledV409">Update Enabled</button><button class="layer-button" id="satClearCacheV409">Clear Cache</button></div><input id="satUploadInputV409" type="file" accept=".json,.tle,.txt" multiple style="display:none"><div class="sat-actions"><button class="layer-button" id="satUploadBtnV409">Upload Local Data</button><button class="layer-button" id="satRefreshV409">Refresh Display</button></div><div id="satCacheSummaryV409" class="muted">No satellite cache loaded.</div><div class="subgroup-title">Display Filters</div><div class="row"><label><input id="satGovV409" type="checkbox"><span>Govt / Other</span></label><label><input id="satPrivateV409" type="checkbox"><span>Private / Commercial</span></label></div><div class="row"><label><input id="satLabelsV409" type="checkbox" checked><span>Labels</span></label><label><input id="satGroundTracksV409" type="checkbox"><span>Ground Tracks</span></label></div><div class="sat-grid"><label>Ground track min<input id="satTrackMinutesV409" type="number" min="10" max="360" step="10" value="90"></label><label>Category search<input id="satCategorySearchV409" type="text" placeholder="filter categories"></label></div><div class="subgroup-title">Categories <span class="chip" id="satCategoryEnabledCountV409">0 enabled</span></div><div id="satCategoryListV409" class="sat-v409-list"></div><details class="sat-v409-subdetails" open><summary>Push to EUDs</summary><div class="row"><label><input id="satPushVisibleV409" type="checkbox" disabled><span>Push visible satellites to EUDs</span></label><span class="chip">Queued v409</span></div><div class="muted">Future behavior is locked: what TAK Map displays is what gets sent to EUDs. CoT push remains off until implemented.</div></details><details class="sat-v409-subdetails"><summary>Observer / Pass Prediction</summary><div class="sat-grid"><label>Observer source<select id="satObserverSourceV409"><option value="selected_eud">Selected EUD</option><option value="follow_map_center">Follow Map Center</option><option value="manual">Manual Location</option><option value="map_center_once">One-time Map Center</option><option value="last_known">Last known observer</option></select></label><label>Selected EUD<select id="satSelectedEudV409"><option value="">No EUD selected</option></select></label><label>Manual lat<input id="satManualLatV409" type="text" inputmode="decimal" placeholder="34.000000"></label><label>Manual lon<input id="satManualLonV409" type="text" inputmode="decimal" placeholder="-118.000000"></label></div><div class="sat-actions"><button class="layer-button" id="satUseMapCenterObserverV409">Use Map Center</button><button class="layer-button" id="satPredictPassV409" disabled>Next Pass</button><span class="chip">Queued v410</span></div><div class="muted" id="satPassStatusV409">Pass prediction UI is present; calculation is queued for the pass-prediction package.</div></details><div id="satStatusV409" class="muted sat-status-v409">Ready.</div></div>`;if(gateway&&gateway.parentNode)gateway.insertAdjacentElement('afterend',host);else if(offline&&offline.parentNode)offline.insertAdjacentElement('afterend',host);else{const sb=$('sidebar');if(sb)sb.appendChild(host)} }
  function applyPrefsToUi(){const p=state.prefs;[['satEnableV409','enabled'],['satLabelsV409','labels'],['satGroundTracksV409','groundTracks'],['satGovV409','gov'],['satPrivateV409','private']].forEach(function(x){const el=$(x[0]);if(el)el.checked=!!p[x[1]]});const pairs=[['satSourceV409','source'],['satUpdateSecV409','updateSec'],['satTrackMinutesV409','trackMinutes'],['satCategorySearchV409','categorySearch'],['satObserverSourceV409','observerSource'],['satManualLatV409','manualLat'],['satManualLonV409','manualLon'],['satSelectedEudV409','selectedEud']];pairs.forEach(function(x){const el=$(x[0]);if(el)el.value=p[x[1]]==null?'':p[x[1]]});}
  function readPrefsFromUi(){const p=state.prefs;function b(id){const el=$(id);return !!(el&&el.checked)}function v(id){const el=$(id);return el?el.value:''}p.enabled=b('satEnableV409');p.labels=b('satLabelsV409');p.groundTracks=b('satGroundTracksV409');p.gov=b('satGovV409');p.private=b('satPrivateV409');p.source=v('satSourceV409')||'streamed';p.updateSec=Math.max(5,Number(v('satUpdateSecV409'))||30);p.trackMinutes=Math.max(10,Number(v('satTrackMinutesV409'))||90);p.categorySearch=v('satCategorySearchV409');p.observerSource=v('satObserverSourceV409')||'follow_map_center';p.manualLat=v('satManualLatV409');p.manualLon=v('satManualLonV409');p.selectedEud=v('satSelectedEudV409');savePrefs();}
  function renderCategories(){const box=$('satCategoryListV409');if(!box)return;const term=String(state.prefs.categorySearch||'').toLowerCase().trim();let shown=0,en=0;box.innerHTML=CATEGORY_DEFS.filter(function(cat){if(state.prefs.source==='local'&&!cat.local)return false;if(term&&!String(cat.label+' '+cat.group+' '+cat.hint).toLowerCase().includes(term))return false;return true}).map(function(cat){shown++;if(state.prefs.enabledCats[cat.id])en++;const e=state.cache[cat.id], total=catCount(cat.id);let priv=0;catRecords(cat.id).forEach(function(r){if((r.__class||classify(r,cat))==='private')priv++});const gov=Math.max(0,total-priv);const age=e?fmtAge(e.updatedAt):'not downloaded';return `<div class="sat-v409-row" data-sat-cat="${esc(cat.id)}"><input type="checkbox" class="sat-cat-toggle-v409" data-cat="${esc(cat.id)}" ${state.prefs.enabledCats[cat.id]?'checked':''}><div><b>${esc(cat.label)}</b><small>${esc(cat.hint)} · ${esc(age)} · G/O ${gov} · P ${priv}</small></div><span class="sat-v409-count">${total}</span><button class="layer-button sat-v409-mini sat-cat-update-v409" data-cat="${esc(cat.id)}">↻</button></div>`}).join('')||'<div class="muted" style="padding:8px">No categories match.</div>';const chip=$('satCategoryEnabledCountV409');if(chip)chip.textContent=en+' enabled';renderCacheSummary();}
  function confirmDialog(title,msg,okText){return new Promise(function(resolve){const overlay=d.createElement('div');overlay.className='sat-dialog-v409';overlay.innerHTML=`<div class="sat-dialog-card-v409"><h3>${esc(title)}</h3><p>${esc(msg)}</p><div class="sat-dialog-actions-v409"><button class="layer-button" data-no>Cancel</button><button class="layer-button primary" data-ok>${esc(okText||'Continue')}</button></div></div>`;d.body.appendChild(overlay);function done(v){try{overlay.remove()}catch(_){}resolve(v)}overlay.addEventListener('click',function(ev){if(ev.target===overlay||ev.target.closest('[data-no]'))done(false);if(ev.target.closest('[data-ok]'))done(true)},true)})}
  async function guardedToggle(mutator){readPrefsFromUi();const before=potentialCount(state.prefs);const next=JSON.parse(JSON.stringify(state.prefs));mutator(next);const after=potentialCount(next);if(after>100&&after>before){const ok=await confirmDialog('Satellite display warning',after+' satellites are about to be displayed. This may slow TAK Map on the Raspberry Pi or browser. Continue?','Display '+after);if(!ok){applyPrefsToUi();renderCategories();return false}}state.prefs=next;savePrefs();applyPrefsToUi();renderCategories();await renderSatellites('toggle');return true}
  async function fetchCategory(cat){if(cat.local)return state.cache[cat.id]||{id:cat.id,records:[]};const url='/api/tak-map/satellite/celestrak?group='+encodeURIComponent(cat.group);let j=null;try{const r=await fetch(url,{cache:'no-store'});j=await r.json();if(!r.ok||!j.ok)throw new Error((j&&j.error)||('HTTP '+r.status))}catch(e){const direct='https://celestrak.org/NORAD/elements/gp.php?GROUP='+encodeURIComponent(cat.group)+'&FORMAT=json';const r=await fetch(direct,{cache:'no-store'});j={ok:r.ok,records:await r.json()};if(!r.ok)throw new Error('CelesTrak HTTP '+r.status)}const rows=(Array.isArray(j.records)?j.records:[]).map(function(r){return normRec(r,cat)});const entry={id:cat.id,label:cat.label,group:cat.group,source:'CelesTrak GP JSON',updatedAt:Date.now(),records:rows};await dbPut(entry);state.cache[cat.id]=entry;return entry}
  async function downloadCats(cats){if(state.downloading)return;state.downloading=true;try{status('Downloading satellite data…','warn');let done=0,total=0;for(const cat of cats){try{status('Downloading '+cat.label+' ('+(done+1)+'/'+cats.length+')…','warn');const e=await fetchCategory(cat);total+=e.records.length;done++;renderCategories();await new Promise(function(r){setTimeout(r,40)})}catch(e){console.warn('Satellite category download failed',cat,e);status('Download failed for '+cat.label+': '+String(e&&e.message||e),'bad')}}status('Downloaded '+done+' categories · '+total+' satellite records. Categories remain disabled until selected.','good');renderCategories();await renderSatellites('download')}finally{state.downloading=false}}
  async function ensureSatelliteLib(){if(w.satellite&&w.satellite.json2satrec){state.libLoaded=true;return w.satellite}await new Promise(function(resolve,reject){try{const existing=d.querySelector('script[src="/assets/vendor/satellite-js.min.js"]');if(existing){existing.addEventListener('load',resolve,{once:true});existing.addEventListener('error',reject,{once:true});return}const s=d.createElement('script');s.src='/assets/vendor/satellite-js.min.js';s.onload=resolve;s.onerror=function(){reject(new Error('Bundled satellite-js did not load'))};d.head.appendChild(s)}catch(e){reject(e)}});if(!(w.satellite&&w.satellite.json2satrec))throw new Error('Bundled satellite-js missing expected API');state.libLoaded=true;return w.satellite}
  function satrecFor(r){const k=String(r.__key||'');if(k&&state.satrecs.has(k))return state.satrecs.get(k);const sat=w.satellite;let rec=null;if(r.TLE_LINE1&&r.TLE_LINE2)rec=sat.twoline2satrec(String(r.TLE_LINE1),String(r.TLE_LINE2));else rec=sat.json2satrec(r);if(k)state.satrecs.set(k,rec);return rec}
  function positionFor(r,date){try{const sat=w.satellite, sr=satrecFor(r);const pv=sat.propagate(sr,date);const pos=pv&&pv.position;if(!pos)return null;const gmst=sat.gstime(date);const gd=sat.eciToGeodetic(pos,gmst);const lat=sat.degreesLat(gd.latitude), lon=sat.degreesLong(gd.longitude), altKm=gd.height; if(!Number.isFinite(lat)||!Number.isFinite(lon))return null;return {lat:lat,lon:lon,altKm:altKm}}catch(_){return null}}
  function satIcon(r){const L=leaflet();if(!L)return null;const cls=r.__class==='private'?'tak-sat-private':'tak-sat-gov';const label=state.prefs.labels?`<div class="tak-sat-label">${esc(r.__name)}</div>`:'';return L.divIcon({className:'tak-sat-marker',html:`<div class="tak-sat-wrap ${cls}"><div class="tak-sat-dot"></div>${label}</div>`,iconSize:[28,28],iconAnchor:[14,14]})}
  function popupHtml(r,p){return `<div class="tak-object-popup sat-popup-v409"><b>${esc(r.__name)}</b><div class="kvp"><span>Class</span><b>${r.__class==='private'?'Private / Commercial':'Govt / Other'}</b></div><div class="kvp"><span>Category</span><b>${esc(r.__categoryLabel)}</b></div><div class="kvp"><span>NORAD</span><b>${esc(r.NORAD_CAT_ID||r.__key)}</b></div><div class="kvp"><span>Altitude</span><b>${Number.isFinite(p.altKm)?Math.round(p.altKm)+' km':'n/a'}</b></div><div class="kvp"><span>Updated</span><b>${new Date().toLocaleTimeString()}</b></div></div>`}
  function drawGroundTrack(r,now){const L=leaflet();if(!L||!state.trackLayer)return;const mins=Math.max(10,Number(state.prefs.trackMinutes)||90);let seg=[],prev=null;for(let m=-mins/2;m<=mins/2;m+=5){const p=positionFor(r,new Date(now.getTime()+m*60000));if(!p)continue;if(prev&&Math.abs(p.lon-prev.lon)>180){if(seg.length>1)L.polyline(seg,{color:r.__class==='private'?'#ffcc66':'#62b8ff',weight:1,opacity:.55,interactive:false}).addTo(state.trackLayer);seg=[]}seg.push([p.lat,p.lon]);prev=p}if(seg.length>1)L.polyline(seg,{color:r.__class==='private'?'#ffcc66':'#62b8ff',weight:1,opacity:.55,interactive:false}).addTo(state.trackLayer)}
  async function renderSatellites(reason){readPrefsFromUi();savePrefs();if(!ensureLayers())return;clearLayers();renderCacheSummary();if(!state.prefs.enabled){status('Satellite Tracking disabled.','');resetTimer();return}const visible=visibleRecordsWithPrefs();if(!visible.length){status('Satellite Tracking enabled · select Govt/Private and at least one cached category.','warn');resetTimer();return}try{await ensureSatelliteLib()}catch(e){status('Satellite engine unavailable: '+String(e&&e.message||e),'bad');return}const now=new Date();let ok=0,bad=0;const chunk=200;for(let i=0;i<visible.length;i++){const r=visible[i];const p=positionFor(r,now);if(!p){bad++;continue}try{const m=leaflet().marker([p.lat,p.lon],{icon:satIcon(r),zIndexOffset:250,autoPan:false}).bindPopup(popupHtml(r,p),{autoPan:false,closeButton:true,className:'tak-object-popup sat-object-popup'}).addTo(state.layer);if(typeof stabilizeLayerPopup==='function')stabilizeLayerPopup(m);if(typeof addSearchItem==='function')addSearchItem('satellite','Satellite '+(r.__class==='private'?'Private':'Govt/Other'),r.__name,p.lat,p.lon,m,r);if(state.prefs.groundTracks)drawGroundTrack(r,now);ok++}catch(e){bad++}if(i%chunk===chunk-1)await new Promise(function(res){setTimeout(res,0)})}state.lastRender={ts:Date.now(),reason:reason||'',visible:visible.length,rendered:ok,failed:bad,labels:state.prefs.labels,groundTracks:state.prefs.groundTracks};status('Satellite Tracking · rendered '+ok+' of '+visible.length+(bad?' · '+bad+' failed':'')+'.','good');renderCacheSummary();resetTimer();}
  function resetTimer(){try{if(state.timer)clearInterval(state.timer)}catch(_){}state.timer=null;if(state.prefs.enabled&&visibleRecordsWithPrefs().length){state.timer=setInterval(function(){renderSatellites('timer')},Math.max(5,Number(state.prefs.updateSec)||30)*1000)}}
  function parseTleText(txt){const lines=String(txt||'').split(/\r?\n/).map(function(s){return s.trim()}).filter(Boolean);const out=[];for(let i=0;i<lines.length;i++){if(/^1 /.test(lines[i])&&/^2 /.test(lines[i+1]||'')){const name=(i>0&&!/^1 |^2 /.test(lines[i-1]))?lines[i-1]:'SAT '+lines[i].slice(2,7);out.push({OBJECT_NAME:name,NORAD_CAT_ID:lines[i].slice(2,7).trim(),TLE_LINE1:lines[i],TLE_LINE2:lines[i+1],EPOCH:'',MEAN_MOTION:''});i++}}return out}
  async function uploadLocal(files){const cat=catById('local-upload');let records=[];for(const f of Array.from(files||[])){const txt=await f.text();try{const obj=JSON.parse(txt);if(Array.isArray(obj))records=records.concat(obj);else if(obj&&Array.isArray(obj.records))records=records.concat(obj.records);else if(obj&&obj.NORAD_CAT_ID)records.push(obj);else records=records.concat(parseTleText(txt))}catch(_){records=records.concat(parseTleText(txt))}}records=records.map(function(r){return normRec(r,cat)});const entry={id:cat.id,label:cat.label,group:cat.group,source:'Local Upload',updatedAt:Date.now(),records:records};await dbPut(entry);state.cache[cat.id]=entry;state.prefs.source='local';state.prefs.enabledCats[cat.id]=false;savePrefs();applyPrefsToUi();renderCategories();status('Loaded '+records.length+' local satellite records. Enable Local upload category to display.','good')}
function bindUi(){if(w.__takMapSatelliteV409Bound)return;w.__takMapSatelliteV409Bound=true;d.addEventListener('change',async function(ev){const t=ev.target;if(!t)return;if(t.classList&&t.classList.contains('sat-cat-toggle-v409')){const id=t.getAttribute('data-cat');await guardedToggle(function(p){p.enabledCats[id]=!!t.checked});return}if(['satEnableV409','satGovV409','satPrivateV409','satGroundTracksV409'].includes(t.id)){await guardedToggle(function(p){if(t.id==='satEnableV409')p.enabled=!!t.checked;if(t.id==='satGovV409')p.gov=!!t.checked;if(t.id==='satPrivateV409')p.private=!!t.checked;if(t.id==='satGroundTracksV409')p.groundTracks=!!t.checked});return}if(t.id&&/^sat/.test(t.id)){readPrefsFromUi();savePrefs();renderCategories();if(['satLabelsV409','satUpdateSecV409','satTrackMinutesV409','satSourceV409'].includes(t.id))await renderSatellites('setting')}});d.addEventListener('input',function(ev){const t=ev.target;if(t&&t.id==='satCategorySearchV409'){readPrefsFromUi();savePrefs();renderCategories()}});d.addEventListener('click',async function(ev){const b=ev.target&&ev.target.closest?ev.target.closest('button'):null;if(!b)return;if(b.classList.contains('sat-cat-update-v409')){const cat=catById(b.getAttribute('data-cat'));await downloadCats([cat]);return}if(b.id==='satDownloadAllV409'){await downloadCats(CATEGORY_DEFS.filter(function(c){return !c.local}));return}if(b.id==='satDownloadEnabledV409'){const cats=CATEGORY_DEFS.filter(function(c){return !c.local&&state.prefs.enabledCats[c.id]});if(!cats.length){status('No enabled CelesTrak categories selected.','warn');return}await downloadCats(cats);return}if(b.id==='satClearCacheV409'){if(await confirmDialog('Clear satellite cache','Remove all cached satellite records from this browser?','Clear Cache')){await dbClear();state.cache={};state.satrecs.clear();renderCategories();clearLayers();status('Satellite cache cleared.','good')}}if(b.id==='satUploadBtnV409'){$('satUploadInputV409')&&$('satUploadInputV409').click()}if(b.id==='satRefreshV409')await renderSatellites('manual');if(b.id==='satUseMapCenterObserverV409'){try{const m=mapObj();if(m){const c=m.getCenter();$('satManualLatV409').value=Number(c.lat).toFixed(6);$('satManualLonV409').value=Number(c.lng).toFixed(6);$('satObserverSourceV409').value='manual';readPrefsFromUi();savePrefs();}}catch(_){}}});const up=$('satUploadInputV409');if(up){up.addEventListener('change',async function(){if(up.files&&up.files.length){await uploadLocal(up.files);up.value='';await renderSatellites('upload')}})}}
  function boot(){setVersion();ensureStyle();ensurePanel();loadPrefs();applyPrefsToUi();bindUi();loadCache().then(function(){applyPrefsToUi();renderCategories();renderSatellites('boot')})}
  w.getTakMapSatelliteDiagnosticsV409=function(){return {version:V,prefs:state.prefs,cache:Object.keys(state.cache).map(function(k){return {id:k,count:catCount(k),updatedAt:state.cache[k].updatedAt,source:state.cache[k].source}}),visibleCount:visibleRecordsWithPrefs().length,lastRender:state.lastRender,libLoaded:state.libLoaded,layerCount:(state.layer&&state.layer.getLayers?state.layer.getLayers().length:null),trackLayerCount:(state.trackLayer&&state.trackLayer.getLayers?state.trackLayer.getLayers().length:null)}};
  w.refreshTakMapSatellitesV409=function(){return renderSatellites('console')};
  w.downloadTakMapSatelliteCategoryV409=function(id){return downloadCats([catById(id)])};
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,100)},{once:true});else setTimeout(boot,100);
  [500,1500,3000].forEach(function(ms){setTimeout(boot,ms)});

  // v408 console compatibility aliases retained for installs/tests that used the original v408 commands.
  w.getTakMapSatelliteDiagnosticsV408 = w.getTakMapSatelliteDiagnosticsV409;
  w.refreshTakMapSatellitesV408 = w.refreshTakMapSatellitesV409;
  w.downloadTakMapSatelliteCategoryV408 = w.downloadTakMapSatelliteCategoryV409;
})();
</script>'''

    def _tak_v409_add(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v409_versions(_html)
        _html = _re_v409.sub(r'<script[^>]*id=["\']v409SatelliteTrackingUiPatch["\'][\s\S]*?</script>', '', _html, flags=_re_v409.I)
        if 'id="v409SatelliteTrackingUiPatch"' not in _html:
            _html = _html.replace('</body>', _v409_script + '\n</body>', 1) if '</body>' in _html else _html + _v409_script
        return _v409_versions(_html)

    for _nm in ('TAK_MAP_HTML','TAK_MAP_LOGIN_HTML','LOGIN_HTML','INDEX_HTML'):
        if _nm in globals():
            globals()[_nm] = _tak_v409_add(globals()[_nm])
    if '_html' in globals():
        globals()['_html'] = _tak_v409_add(globals()['_html'])

    if 'Handler' in globals() and not getattr(Handler, '_tak_v409_satellite_proxy', False):
        _v409_old_do_GET = Handler.do_GET
        def _v409_do_GET(self):
            try:
                parsed = _urlparse_v409(self.path)
                if parsed.path == '/api/tak-map/satellite/celestrak':
                    try:
                        if not self._auth_ok():
                            return self._require_dashboard_login()
                    except Exception:
                        pass
                    qs = _parse_qs_v409(parsed.query or '')
                    group = (qs.get('group') or [''])[0]
                    if group not in _V409_SAT_GROUPS:
                        return self._send_json({'ok':False,'error':'Unsupported CelesTrak group','group':group},400)
                    url = 'https://celestrak.org/NORAD/elements/gp.php?GROUP=' + group + '&FORMAT=json'
                    req = _urllib_request_v409.Request(url, headers={'User-Agent':'TAK-Map/1.2.0 v409 satellite-tracking'})
                    try:
                        with _urllib_request_v409.urlopen(req, timeout=30) as resp:
                            raw = resp.read(50 * 1024 * 1024)
                    except Exception as e:
                        return self._send_json({'ok':False,'error':'CelesTrak fetch failed: ' + str(e),'group':group},502)
                    try:
                        records = _json_v409.loads(raw.decode('utf-8','replace'))
                    except Exception as e:
                        return self._send_json({'ok':False,'error':'CelesTrak JSON parse failed: ' + str(e),'group':group},502)
                    if not isinstance(records, list):
                        records = []
                    return self._send_json({'ok':True,'source':'CelesTrak GP JSON','group':group,'count':len(records),'records':records})
            except Exception as e:
                try:
                    return self._send_json({'ok':False,'error':'Satellite proxy error: '+str(e)},500)
                except Exception:
                    pass
            return _v409_old_do_GET(self)
        Handler.do_GET = _v409_do_GET
        Handler._tak_v409_satellite_proxy = True
except Exception as _e_v409:
    try:
        print('v409 satellite tracking UI/proxy patch failed', _e_v409)
    except Exception:
        pass
# --- end TAK Map v409 patch ---


# --- TAK Map v410 satellite popup restyle patch ---
try:
    import re as _re_v410
    _v410_script = '<script id="v410SatellitePopupRestylePatch">\n(function(){\n  \'use strict\';\n  const V=\'v410\', w=window, d=document;\n  function q(sel,root){try{return (root||d).querySelector(sel)}catch(_){return null}}\n  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}\n  function esc(s){return String(s==null?\'\':s).replace(/[&<>"\']/g,function(c){return {\'&\':\'&amp;\',\'<\':\'&lt;\',\'>\':\'&gt;\',\'"\':\'&quot;\',"\'":\'&#39;\'}[c]})}\n  function setVersion(){try{qa(\'.iteration-chip,.iteration-marker,[data-iteration]\').forEach(function(el){el.textContent=V; try{el.setAttribute(\'data-iteration\',V)}catch(_){}}); d.documentElement.dataset.takMapIteration=V}catch(_){} }\n  function popupField(label,value,wide){return \'<div class="adsb-v323-field \'+(wide?\'wide\':\'\')+\'"><b>\'+esc(label)+\'</b><span>\'+esc(value||\'—\')+\'</span></div>\'}\n  function rowsFromPopup(root){const out={}; qa(\'.kvp\',root).forEach(function(row){const k=(q(\'span\',row)?.textContent||\'\').trim(); const v=(q(\'b\',row)?.textContent||\'\').trim(); if(k) out[k]=v||\'—\';}); return out}\n  function popupTitle(root){try{const kids=Array.from(root.children||[]); for(const el of kids){if(el&&el.tagName===\'B\'){const t=(el.textContent||\'\').trim(); if(t) return t;}}}catch(_){} return (q(\'b\',root)?.textContent||\'Satellite\').trim()||\'Satellite\'}\n  function popupClassKey(cls){return /private/i.test(String(cls||\'\'))?\'private\':\'gov\'}\n  function transformSatPopup(root){\n    try{\n      if(!root || root.dataset.v410PopupStyled===\'1\') return false;\n      if(root.querySelector(\'.sat-v410-popup\')){root.dataset.v410PopupStyled=\'1\'; return true;}\n      const rows=rowsFromPopup(root);\n      const name=popupTitle(root);\n      const classText=rows[\'Class\']||\'Govt / Other\';\n      const category=rows[\'Category\']||\'—\';\n      const norad=rows[\'NORAD\']||\'—\';\n      const altitude=rows[\'Altitude\']||\'—\';\n      const updated=rows[\'Updated\']||\'—\';\n      const kind=popupClassKey(classText);\n      let grid=\'\';\n      grid+=popupField(\'Class\',classText);\n      grid+=popupField(\'NORAD\',norad);\n      grid+=popupField(\'Altitude\',altitude);\n      grid+=popupField(\'Updated\',updated);\n      grid+=popupField(\'Category\',category,true);\n      root.innerHTML=\'<div class="adsb-popup adsb-v323-popup sat-v410-popup sat-v410-\'+kind+\'"><div class="adsb-v323-bar sat-v410-bar"></div><div class="adsb-v323-inner"><div class="adsb-v323-title">\'+esc(name)+\'</div><div class="adsb-v323-sub">\'+esc(classText)+\' · \'+esc(category)+\'</div><div class="adsb-v323-grid">\'+grid+\'</div></div></div>\';\n      root.dataset.v410PopupStyled=\'1\';\n      root.classList.add(\'sat-popup-v410\');\n      const host=root.closest(\'.leaflet-popup\');\n      if(host) host.classList.add(\'adsb-object-popup\',\'sat-object-popup\',\'sat-popup-host-v410\');\n      return true;\n    }catch(_){return false;}\n  }\n  function scan(root){qa(\'.sat-popup-v409,.sat-popup-v410\',root||d).forEach(transformSatPopup)}\n  function installStyle(){\n    if(q(\'#v410SatellitePopupStyle\')) return;\n    const st=d.createElement(\'style\');\n    st.id=\'v410SatellitePopupStyle\';\n    st.textContent=`\n      .leaflet-popup.sat-popup-host-v410 .leaflet-popup-content-wrapper{overflow:hidden!important}\n      .sat-v410-popup{width:100%;box-sizing:border-box}\n      .sat-v410-popup.sat-v410-private .adsb-v323-bar{background:linear-gradient(90deg,#ffcc66,rgba(255,111,46,.86),rgba(255,204,102,.55))!important}\n      .sat-v410-popup.sat-v410-gov .adsb-v323-bar{background:linear-gradient(90deg,#62b8ff,rgba(35,134,255,.86),rgba(117,190,214,.76))!important}\n      .sat-v410-popup .adsb-v323-sub{padding-right:22px}\n      .sat-v410-popup .adsb-v323-grid{margin-top:10px}\n      .sat-v410-popup .adsb-v323-field span{color:#edf8fb!important}\n    `;\n    (d.head||d.documentElement).appendChild(st);\n  }\n  function bind(){\n    if(w.__takMapSatPopupV410Bound) return;\n    w.__takMapSatPopupV410Bound=true;\n    try{\n      const m=w.takLeafletMap||w.map;\n      if(m&&m.on) m.on(\'popupopen\',function(ev){setTimeout(function(){scan(ev&&ev.popup&&ev.popup.getElement&&ev.popup.getElement())},0)});\n    }catch(_){}\n    try{\n      const mo=new MutationObserver(function(muts){\n        let hit=false;\n        for(const mut of muts){\n          for(const n of Array.from(mut.addedNodes||[])){\n            if(n&&n.nodeType===1&&((n.matches&&n.matches(\'.leaflet-popup,.sat-popup-v409,.sat-popup-v410\'))||(n.querySelector&&n.querySelector(\'.sat-popup-v409,.sat-popup-v410\')))){hit=true; break;}\n          }\n          if(hit) break;\n        }\n        if(hit) setTimeout(function(){scan(d)},0);\n      });\n      mo.observe(d.body||d.documentElement,{childList:true,subtree:true});\n    }catch(_){}\n  }\n  w.getTakMapSatellitePopupDiagnosticsV410=function(){return {version:V,transformedCount:qa(\'.sat-v410-popup\').length,legacyCount:qa(\'.sat-popup-v409\').length,popupHostCount:qa(\'.leaflet-popup.sat-popup-host-v410\').length}};\n  function boot(){setVersion();installStyle();scan(d);bind()}\n  if(d.readyState===\'loading\') d.addEventListener(\'DOMContentLoaded\',function(){setTimeout(boot,80)},{once:true}); else setTimeout(boot,80);\n  [400,1200,2400,4200].forEach(function(ms){setTimeout(function(){setVersion();scan(d)},ms)});\n})();\n</script>'

    def _tak_v410_add(_html):
        if not isinstance(_html, str):
            return _html
        _html = _re_v410.sub('<script[^>]*id=(?:\\"|\')v410SatellitePopupRestylePatch(?:\\"|\')[\\\\s\\\\S]*?</script>', '', _html, flags=_re_v410.I)
        if 'id="v410SatellitePopupRestylePatch"' not in _html:
            _html = _html.replace('</body>', _v410_script + '\n</body>', 1) if '</body>' in _html else _html + _v410_script
        return _html

    for _nm in ('TAK_MAP_HTML','TAK_MAP_LOGIN_HTML','LOGIN_HTML','INDEX_HTML'):
        if _nm in globals():
