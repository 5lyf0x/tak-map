# --- TAK Map i461 UI/defaults patch ---
try:
    import re as _i461_re

    # New/unset ADS-B configurations default to Follow Map Center and a 10-mile
    # radius. Existing saved settings and explicit environment overrides remain
    # authoritative because the normal loader merges them after these defaults.
    _i461_prev_default_adsb_settings = _default_adsb_settings
    def _default_adsb_settings():
        out = dict(_i461_prev_default_adsb_settings() or {})
        if 'TAK_DASH_ADSB_RADIUS_MILES' not in os.environ:
            out['radius_miles'] = 10
        if 'TAK_DASH_ADSB_CENTER_SOURCE' not in os.environ:
            out['center_source'] = 'follow_map_center'
        return out

    _i461_prev_tak_map_adsb = tak_map_adsb
    def tak_map_adsb(query_settings=None):
        result = _i461_prev_tak_map_adsb(query_settings)
        if isinstance(result, dict):
            result['tak_map_iteration'] = 'i461'
        return result

    # Serve the current ADS-B runtime asset through the deterministic route.
    _i461_prev_get = Handler.do_GET
    def _i461_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/assets/runtime/tak-map-adsb-v461.js':
            fp = Path(__file__).resolve().parent / 'assets' / 'tak-map-adsb-v461.js'
            if not fp.exists():
                self.send_response(404)
                self.send_header('Cache-Control','no-store')
                self.end_headers()
                return
            body = fp.read_bytes()
            self.send_response(200)
            self.send_header('Content-Type','application/javascript; charset=utf-8')
            self.send_header('Cache-Control','no-store, max-age=0')
            self.send_header('X-TAK-Map-Module','i461')
            self.send_header('Content-Length',str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        return _i461_prev_get(self)
    Handler.do_GET = _i461_get

    _i461_ui_script = '<script id="takMapUiFixesV461">\n(function(w,d){\n\'use strict\';\nconst V=\'v461\';\nconst S=w.__TakMapUiV461=w.__TakMapUiV461||{version:V,steppers:0,centerSyncs:0,popupOpens:0,popupCloses:0,popupPinnedSkips:0,lastCenter:null,mapBound:false,observer:null};\nfunction $(id){try{return d.getElementById(id)}catch(_){return null}}\nfunction q(sel,root){try{return (root||d).querySelector(sel)}catch(_){return null}}\nfunction qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}\nfunction mapObj(){try{if(w.takLeafletMap&&w.takLeafletMap.getCenter)return w.takLeafletMap}catch(_){}try{if(w.map&&w.map.getCenter)return w.map}catch(_){}try{if(typeof map!==\'undefined\'&&map&&map.getCenter){w.map=map;return map}}catch(_){}return null}\nfunction dispatchValue(inp){try{inp.dispatchEvent(new Event(\'input\',{bubbles:true}));inp.dispatchEvent(new Event(\'change\',{bubbles:true}))}catch(_){} }\nfunction stepValue(inp,dir){try{if(dir>0&&typeof inp.stepUp===\'function\')inp.stepUp();else if(dir<0&&typeof inp.stepDown===\'function\')inp.stepDown();else{const st=Number(inp.step||1)||1,min=inp.min===\'\'?-Infinity:Number(inp.min),max=inp.max===\'\'?Infinity:Number(inp.max);let v=Number(inp.value);if(!Number.isFinite(v))v=0;inp.value=String(Math.max(min,Math.min(max,v+(dir>0?st:-st))))}dispatchValue(inp)}catch(_){} }\nfunction ensureStepper(inp){if(!inp)return null;let wrap=inp.closest&&inp.closest(\'.tak-stepper\');if(!wrap){wrap=d.createElement(\'span\');wrap.className=\'tak-stepper tak-adsb-stepper-v461\';inp.parentNode.insertBefore(wrap,inp);wrap.appendChild(inp)}else wrap.classList.add(\'tak-adsb-stepper-v461\');let controls=q(\'.tak-stepper-controls\',wrap);if(!controls){controls=d.createElement(\'span\');controls.className=\'tak-stepper-controls\';wrap.appendChild(controls)}controls.innerHTML=\'<button type="button" class="tak-step-up-v461" aria-label="Increase value" title="Increase"><svg viewBox="0 0 12 8" aria-hidden="tru