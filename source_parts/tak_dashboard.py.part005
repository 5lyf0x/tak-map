# --- TAK Map i464 airplanes.live snapshot, fast tile path, and interpolation assets ---
try:
    import collections as _i464_collections
    import queue as _i464_queue
    import threading as _i464_threading
    import time as _i464_time
    import re as _i464_re

    # airplanes.live is the sole ADS-B source.  A background collector owns
    # upstream I/O; browser requests only read a bounded last-good snapshot.
    _I464_ADSB_LOCK=_i464_threading.RLock()
    _I464_ADSB_WAKE=_i464_threading.Event()
    _I464_ADSB_UPDATED=_i464_threading.Event()
    _I464_ADSB_SNAPSHOTS=_i464_collections.OrderedDict()
    _I464_ADSB_STATE={
        'desired_key':'','desired_settings':None,'thread':None,'in_flight':False,
        'last_attempt_at':0.0,'last_success_at':0.0,'last_error':'','next_allowed_at':0.0,
        'consecutive_errors':0,'fetch_seconds':0.0,'raw_count':0,'position_change_at':0.0,
        'position_signature':'','source_now':None,'fetch_count':0,'last_client_at':0.0,
    }

    def _i464_adsb_settings(query_settings=None):
        st=dict(_load_adsb_settings() or {})
        if isinstance(query_settings,dict):
            la=_coerce_float(query_settings.get('center_lat'));lo=_coerce_float(query_settings.get('center_lon'))
            if la is not None and lo is not None and -90<=la<=90 and -180<=lo<=180:
                st['center_lat']=la;st['center_lon']=lo;st['has_center']=True
            if query_settings.get('radius_miles') is not None:
                try: st['radius_miles']=max(1,min(250,int(round(float(query_settings.get('radius_miles'))))))
                except Exception: pass
        return st

    def _i464_adsb_key(st):
        try:return '%.5f,%.5f/%d'%(float(st.get('center_lat')),float(st.get('center_lon')),int(st.get('radius_miles') or 10))
        except Exception:return 'no-center/%d'%int(st.get('radius_miles') or 10)

    def _i464_adsb_normalize(data,st):
        stale=_adsb_stale_seconds(st);by={}
        source_now=data.get('now') if isinstance(data,dict) else None
        raw=(data.get('aircraft') or []) if isinstance(data,dict) else []
        for item in raw:
            ac=_normalize_adsb_aircraft(item,'Airplanes.live') if isinstance(item,dict) else None
            if not ac: continue
            try:
                if ac.get('seen_seconds') is not None and float(ac.get('seen_seconds'))>stale: continue
            except Exception: pass
            if not _adsb_in_radius(ac,st): continue
            k=str(ac.get('id') or ac.get('callsign') or '').strip().lower()
            if not k: continue
            old=by.get(k)
            try:nr=float(ac.get('seen_seconds') or 999999)
            except Exception:nr=999999
            try:orank=float(old.get('seen_seconds') or 999999) if old else 999999
            except Exception:orank=999999
            if old is None or nr<orank: by[k]=ac
        rows=sorted(by.values(),key=lambda x:(str(x.get('category_class') or ''),str(x.get('callsign') or x.get('id') or '')))
        sig='|'.join('%s:%.5f,%.5f'%(str(x.get('id') or ''),float(x.get('lat')),float(x.get('lon'))) for x in rows)
        return rows,len(raw),source_now,stale,sig

    def _i464_adsb_store(key,st,rows,raw_count,source_now,stale,sig,note):
        now=_i464_time.time()
        with _I464_ADSB_LOCK:
            old=_I464_ADSB_SNAPSHOTS.get(key) or {}
            changed=sig!=str(old.get('position_signature') or '')
            snap={'key':key,'settings':dict(st),'aircraft':list(rows),'count':len(rows),'stored_at':now,
                  'stale_seconds':stale,'position_signature':sig,'position_change_at':now if changed else float(old.get('position_change_at') or now),
                  'source_now':source_now,'source_note':dict(note or {})}
            _I464_ADSB_SNAPSHOTS[key]=snap;_I464_ADSB_SNAPSHOTS.move_to_end(key)
            while len(_I464_ADSB_SNAPSHOTS)>4:_I464_ADSB_SNAPSHOTS.popitem(last=False)
            _I464_ADSB_STATE.update({'last_success_at':now,'last_error':'','next_allowed_at':0.0,'consecutive_errors':0,
                'raw_count':raw_count,'position_signature':sig,'position_change_at':snap['position_change_at'],'source_now':source_now})
            _I464_ADSB_UPDATED.set()

    def _i464_adsb_collect_once(st,key):
        url=_v270_airplanes_url(st)
        if not url: raise RuntimeError('ADS-B center not set. Use Follow Map Center or enter lat/lon.')
        started=_i464_time.time();data=_v270_json_url(url,timeout=6)
        rows,raw_count,source_now,stale,sig=_i464_adsb_normalize(data,st)
        elapsed=_i464_time.time()-started
        note={'source':'airplanes.live','ok':True,'url':url,'background':True,'request_seconds':round(elapsed,3),'raw_count':raw_count}
        with _I464_ADSB_LOCK:_I464_ADSB_STATE['fetch_seconds']=elapsed;_I464_ADSB_STATE['fetch_count']+=1
        _i464_adsb_store(key,st,rows,raw_count,source_now,stale,sig,note)

    def _i464_adsb_loop():
        while True:
            signaled=_I464_ADSB_WAKE.wait(5.0);_I464_ADSB_WAKE.clear()
            with _I464_ADSB_LOCK:
                st=dict(_I464_ADSB_STATE.get('desired_settings') or {});key=str(_I464_ADSB_STATE.get('desired_key') or '')
                next_allowed=float(_I464_ADSB_STATE.get('next_allowed_at') or 0.0)
            if not st or not key: continue
            now=_i464_time.time()
            with _I464_ADSB_LOCK:last_client=float(_I464_ADSB_STATE.get('last_client_at') or 0.0)
            if not signaled and now-last_client>12.0: continue
            if now<next_allowed: continue
            with _I464_ADSB_LOCK:_I464_ADSB_STATE['in_flight']=True;_I464_ADSB_STATE['last_attempt_at']=now
            try:_i464_adsb_collect_once(st,key)
            except Exception as exc:
                with _I464_ADSB_LOCK:
                    n=int(_I464_ADSB_STATE.get('consecutive_errors') or 0)+1;backoff=(5,10,20,30)[min(n-1,3)]
