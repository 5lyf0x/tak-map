function naturalHeight(panel){const old=panel.style.height;panel.style.height='auto';const h=Math.max(324,panel.scrollHeight||panel.getBoundingClientRect().height||324);panel.style.height=old;return h}
function bindResize(panel,grip){if(!grip||grip.dataset.viewshedResizeV504)return;grip.dataset.viewshedResizeV504='1';grip.addEventListener('pointerdown',e=>{const r=panel.getBoundingClientRect(),min=naturalHeight(panel);let state={edge:grip.dataset.viewshedResize,y:e.clientY,top:r.top,bottom:r.bottom,height:Math.max(r.height,min),min};panel.style.height=state.height+'px';panel.dataset.viewshedResizedV504='1';grip.classList.add('active');try{grip.setPointerCapture(e.pointerId)}catch(_){}e.preventDefault();e.stopPropagation();function move(ev){if(!state)return;if(state.edge==='top'){const height=Math.max(state.min,state.height+state.y-ev.clientY),top=state.bottom-height;panel.style.top=Math.max(6,top)+'px';panel.style.height=height+'px'}else panel.style.height=Math.max(state.min,state.height+ev.clientY-state.y)+'px';ev.preventDefault()}function done(ev){if(!state)return;state=null;grip.classList.remove('active');try{grip.releasePointerCapture(ev.pointerId)}catch(_){}S.resizes++;grip.removeEventListener('pointermove',move,true);grip.removeEventListener('pointerup',done,true);grip.removeEventListener('pointercancel',done,true)}grip.addEventListener('pointermove',move,true);grip.addEventListener('pointerup',done,true);grip.addEventListener('pointercancel',done,true)},true)}
function normalize(panel){if(!panel||S.normalizing)return false;S.normalizing=true;try{if(panel.dataset.viewshedUiV504==='1'){syncColors();return true}panel.dataset.viewshedUiV504='1';panel.classList.add('tak-viewshed-v504');const body=q('.viewshed-body',panel);if(body){body.style.setProperty('max-height','none','important');body.style.setProperty('overflow','visible','important');body.style.removeProperty('overflow-y')}if(!panel.dataset.viewshedResizedV504)panel.style.removeProperty('height');let chip=$('viewshedCountV504');if(!chip){chip=d.createElement('span');chip.id='viewshedCountV504';chip.className='viewshed-count-v504';const actions=q('.viewshed-head-actions',panel);actions&&actions.parentNode.insertBefore(chip,actions)}let top=q('.viewshed-resize-v504.top',panel),bottom=q('.viewshed-resize-v504.bottom',panel);if(!top){top=d.createElement('div');top.className='viewshed-resize-v504 top';top.dataset.viewshedResize='top';top.title='Resize height';panel.insertBefore(top,panel.firstChild)}if(!bottom){bottom=d.createElement('div');bottom.className='viewshed-resize-v504 bottom';bottom.dataset.viewshedResize='bottom';bottom.title='Resize height';panel.appendChild(bottom)}bindResize(panel,top);bindResize(panel,bottom);bindColorInput($('viewshedVisibleColor'));bindColorInput($('viewshedBlockedColor'));syncColors();if(panel.classList.contains('active')&&panel.dataset.viewshedUserPosition!=='1'&&typeof w.positionViewshedDefault==='function')setTimeout(()=>{try{if(panel.dataset.viewshedUserPosition!=='1')w.positionViewshedDefault(true)}catch(_){}},0);S.upgrades++;return true}finally{S.normalizing=false}}
