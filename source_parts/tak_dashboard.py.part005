async function upload(name,feature){
 const fc={type:'FeatureCollection',features:[feature]},blob=new Blob([JSON.stringify(fc,null,2)],{type:'application/geo+json'}),fd=new FormData();
 fd.append('files',new File([blob],safeName(name)+'.geojson',{type:'application/geo+json'}));
 const r=await w.fetch('/api/tak-map/import',{method:'POST',body:fd,cache:'no-store',credentials:'same-origin'});let j={};try{j=await r.json()}catch(_){}
 if(!r.ok||j.ok===false)throw new Error(j.error||('HTTP '+r.status));
 try{if(Array.isArray(j.imports)){w.lastImports=j.imports;try{lastImports=j.imports}catch(_){}}}catch(_){}
 try{if(typeof w.renderImportRows==='function')w.renderImportRows()}catch(_){}
 try{if(typeof w.refreshLocalData==='function')await w.refreshLocalData()}catch(_){}
 try{if(typeof w.drawImportedObjects==='function')w.drawImportedObjects()}catch(_){}
 try{const layer=w.importedLayer||(typeof importedLayer!=='undefined'?importedLayer:null),m=w.map||(typeof map!=='undefined'?map:null);if(layer&&m&&typeof m.hasLayer==='function'&&!m.hasLayer(layer)){layer.addTo(m);if(w.state)w.state.imported=true}}catch(_){}
 S.uploads++;S.lastName=String(name||'');S.lastError='';return j
}
w.takMapUploadGeoJsonV501=upload;
if(typeof w.v233UploadGeoJson!=='function')w.v233UploadGeoJson=upload;
const style=d.createElement('style');style.id='takMapRouteSaveFixV501Style';style.textContent='.tak-color-picker-v491{z-index:99650!important}';d.head.appendChild(style);
w.TakMapRouteSaveFixV501=Object.freeze({version:V,upload,diagnostics:()=>Object.assign({},S,{adapterInstalled:w.v233UploadGeoJson===upload||typeof w.v233UploadGeoJson==='function',pickerOpen:!!d.getElementById('takMapColorPickerV486')})});
})(window,document);
</script>'''

