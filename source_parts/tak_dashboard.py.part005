    def _tak_v402_add(_html):
        if not isinstance(_html, str):
            return _html
        _html = _v402_versions(_html)
        # Remove the v397/v398/v399 stroke-only patches that suppressed the actual local DEM terrain surface.
        _html = _re_v402.sub(r'<script[^>]*id=["\']v397LocalDemStrokeOnlyPatch["\'][\s\S]*?</script>', '', _html, flags=_re_v402.I)
