        _html = _re_v402.sub(r'(<span[^>]*class=["\'][^"\']*iteration-(?:chip|marker)[^"\']*["\'][^>]*>)v\d+(</span>)', r'\1v403\2', _html, flags=_re_v402.I)
        _html = _re_v402.sub(r'(<div[^>]*class=["\'][^"\']*iteration-marker[^"\']*["\'][^>]*>)v\d+(</div>)', r'\1v403\2', _html, flags=_re_v402.I)
        _html = _re_v402.sub(r'(<[^>]+data-iteration=["\'])v\d+(["\'][^>]*>)', r'\1v403\2', _html, flags=_re_v402.I)
        return _html

    _v402_script = r"""<script id="v402LocalDemSurfaceStrokePatch">
(function(){
  'use strict';
