# --- TAK Map v389 Data Sync Mission delete/tombstone suppression patch ---
try:
    import re as _re_v389
    import time as _time_v389

    def _v389_norm_key(v):
        try:
            s=str(v if v is not None else '').strip()
            if not s:
                return ''
            s=s.strip(' \t\r\n\"\'<>')
            if not s:
                return ''
            return s.lower()
        except Exception:
            return ''

    def _v389_add_key(out, v):
        k=_v389_norm_key(v)
        if k:
            out.add(k)

    def _v389_row_ts(row):
        try:
            for k in ('deleted_at','delete_time','removed_at','updated_at','updated','update_time','update_datetime','created_at','create_datetime','created','timestamp','time','start','date'):
                v=_row_ci_get(row, (k,), None) if callable(globals().get('_row_ci_get')) else (row or {}).get(k)
                ts=_parse_ts_epoch(v) if callable(globals().get('_parse_ts_epoch')) else None
                if ts is not None:
                    return ts
        except Exception:
            pass
        return None

    def _v389_obj_ts(obj):
        try:
            vals=[]
            if isinstance(obj, dict):
                vals.extend([obj.get(k) for k in ('updated','added','created','created_at','time','start','date')])
                p=obj.get('properties') if isinstance(obj.get('properties'), dict) else {}
                vals.extend([p.get(k) for k in ('updated','added','created','created_at','time','start','date')])
            for v in vals:
                ts=_parse_ts_epoch(v) if callable(globals().get('_parse_ts_epoch')) else None
                if ts is not None:
                    return ts
        except Exception:
            pass
        return None

    def _v389_text_values(row):
        try:
            if callable(globals().get('_row_text_values')):
                return list(_row_text_values(row))
        except Exception:
            pass
        vals=[]
        try:
            for v in (row or {}).values():
                if isinstance(v, (dict,list)):
                    try: vals.append(json.dumps(v, default=str)[:20000])
                    except Exception: pass
                elif v is not None:
                    vals.append(str(v)[:20000])
        except Exception:
            pass
        return vals

    def _v389_is_delete_row(row, source_key=''):
        if not isinstance(row, dict):
            return False
        src=str(source_key or '').lower()
        try:
            # Explicit boolean/flag fields first. Only treat active=false as delete
            # in mission-ish tables, not arbitrary external content tables.
            for k in ('deleted','is_deleted','removed','is_removed','tombstone','is_tombstone'):
                v=_row_ci_get(row, (k,), None) if callable(globals().get('_row_ci_get')) else row.get(k)
                if isinstance(v, bool) and v:
                    return True
                if str(v or '').strip().lower() in ('1','true','yes','y','on'):
                    return True
            for k in ('deleted_at','delete_time','removed_at','tombstone_at'):
                v=_row_ci_get(row, (k,), None) if callable(globals().get('_row_ci_get')) else row.get(k)
                if str(v or '').strip():
                    return True
            active=_row_ci_get(row, ('active','is_active','enabled'), None) if callable(globals().get('_row_ci_get')) else None
            if src.startswith('mission') and str(active or '').strip().lower() in ('0','false','no','n','off'):
                return True
            # Mission log/action fields are authoritative enough to detect deletion.
            action_blob=' '.join(str(_row_ci_get(row, (k,), '') or '') for k in ('action','operation','op','event','event_type','change_type','change','status','verb','method','type','log_type')).lower()
            if _re_v389.search(r'\b(delete|deleted|remove|removed|tombstone|detach|unshare|drop|purge|expire|expired)\b', action_blob):
                return True
            # ATAK/CoT delete/tombstone messages are often represented as t-x-d-d
            # or __delete detail blocks inside mission_logs/cot payload columns.
            for txt in _v389_text_values(row):
                low=str(txt or '').lower()
                if '<__delete' in low or '__delete' in low or 't-x-d-d' in low or '<delete' in low:
                    return True
                if ('missionchange' in low or 'mission' in src or 'mission' in low[:800]) and _re_v389.search(r'\b(delete|deleted|remove|removed|tombstone|detach|unshare|purge)\b', low[:6000]):
                    return True
        except Exception:
            pass
        return False

    def _v389_keys_from_row(row):
        out=set()
        if not isinstance(row, dict):
            return out
        try:
            for k in ('uid','cot_uid','event_uid','eventuid','target_uid','targetuid','data_uid','datauid','map_item_uid','item_uid','guid','id','mission_uid','content_uid','contentuid','resource_uid','resourceuid','hash','sha256','uid_hash','filename','name','title','callsign'):
                _v389_add_key(out, _row_ci_get(row, (k,), None) if callable(globals().get('_row_ci_get')) else row.get(k))
            for txt in _v389_text_values(row):
                t=str(txt or '')[:20000]
                # XML/JSON UID and target fields.
                for m in _re_v389.finditer(r'\b(?:uid|targetUid|target_uid|event_uid|cot_uid|data_uid|contentUid|content_uid|resourceUid|resource_uid|guid|id)\b\s*(?:=|:)\s*[\"\']?([^\"\'<>\s,;}]{3,200})', t, _re_v389.I):
                    _v389_add_key(out, m.group(1))
                for m in _re_v389.finditer(r'\b(?:hash|sha256)\b\s*(?:=|:)\s*[\"\']?([a-f0-9]{32,64})', t, _re_v389.I):
                    _v389_add_key(out, m.group(1))
                for m in _re_v389.finditer(r'\b([a-f0-9]{64})\b', t, _re_v389.I):
                    _v389_add_key(out, m.group(1))
                for m in _re_v389.finditer(r'\b(?:filename|name|title|callsign)\b\s*(?:=|:)\s*[\"\']([^\"\']{3,180})[\"\']', t, _re_v389.I):
                    _v389_add_key(out, m.group(1))
        except Exception:
            pass
        # Avoid extremely generic keys that could hide unrelated objects.
        return {k for k in out if len(k) >= 3 and k not in ('none','null','true','false','delete','deleted','removed','mission','content')}

    def _v389_keys_from_object(obj):
        out=set()
        if not isinstance(obj, dict):
            return out
        try:
            for k in ('uid','id','guid','cot_uid','event_uid','eventuid','target_uid','targetuid','data_uid','datauid','map_item_uid','item_uid','hash','sha256','filename','name','title','callsign'):
                _v389_add_key(out, obj.get(k))
            p=obj.get('properties') if isinstance(obj.get('properties'), dict) else {}
            for k in ('uid','id','guid','cot_uid','event_uid','eventuid','target_uid','targetuid','data_uid','datauid','map_item_uid','item_uid','hash','sha256','filename','name','title','callsign'):
                _v389_add_key(out, p.get(k))
            # Source row may be preserved under diagnostic keys in some parsers.
            for k in ('source_uid','source_id','source_hash'):
                _v389_add_key(out, obj.get(k)); _v389_add_key(out, p.get(k))
        except Exception:
            pass
        return {k for k in out if len(k) >= 3 and k not in ('none','null','true','false','mission','content')}

    def _v389_build_delete_index(rows_by_key):
        deleted={}
        samples=[]
        rows_checked=0
        try:
            for source_key, rows in (rows_by_key or {}).items():
                for row in rows or []:
                    if not isinstance(row, dict):
                        continue
                    rows_checked += 1
                    if not _v389_is_delete_row(row, source_key):
                        continue
                    keys=_v389_keys_from_row(row)
                    if not keys:
                        continue
                    ts=_v389_row_ts(row)
                    for k in keys:
                        old=deleted.get(k)
                        if old is None or (ts is not None and (old.get('ts') is None or ts > old.get('ts'))):
                            deleted[k]={'ts':ts,'source':str(source_key or ''),'keys_count':len(keys)}
                    if len(samples) < 12:
                        label=str(_row_ci_get(row, ('name','title','callsign','uid','guid','id','filename'), '') if callable(globals().get('_row_ci_get')) else '')
                        samples.append({'source':str(source_key or ''),'label':label[:160],'keys':sorted(list(keys))[:8],'ts':ts})
        except Exception:
            pass
        return deleted, {'rows_checked':rows_checked,'delete_events':len(samples),'sample_delete_events':samples}

    def _v389_apply_delete_filter(objects, delete_index):
        kept=[]; removed=[]
        try:
            for o in objects or []:
                keys=_v389_keys_from_object(o)
                hits=[k for k in keys if k in delete_index]
                if not hits:
                    kept.append(o); continue
                obj_ts=_v389_obj_ts(o)
                hit=sorted(hits, key=lambda k: (delete_index.get(k,{}).get('ts') or 0), reverse=True)[0]
                del_ts=(delete_index.get(hit) or {}).get('ts')
                # If there is a newer active object event after a delete, show it.
                # Otherwise suppress deleted/tombstoned Mission/Data Sync objects.
                suppress = (obj_ts is None or del_ts is None or del_ts >= (obj_ts - 2))
                if suppress:
                    if len(removed) < 40:
                        removed.append({'name':str(o.get('callsign') or o.get('name') or o.get('uid') or o.get('id') or '')[:160], 'uid':str(o.get('uid') or o.get('id') or '')[:160], 'matched_key':hit, 'object_ts':obj_ts, 'delete_ts':del_ts, 'source':str(o.get('source') or '')[:160]})
                    continue
                kept.append(o)
        except Exception:
            return objects or [], []
        return kept, removed

    if 'tak_map_data_sync' in globals() and not globals().get('_tak_v389_data_sync_wrapped'):
        _tak_v389_base_data_sync = globals()['tak_map_data_sync']
        def tak_map_data_sync():
            out=_tak_v389_base_data_sync()
            try:
                if not isinstance(out, dict):
                    return out
                rows_by_key={}
                for k in ('missions','mission_content','mission_logs','mission_roles','mission_uids','mission_content_mission','packages'):
                    rows_by_key[k]=out.get(k) or []
                delete_index, diag=_v389_build_delete_index(rows_by_key)
                before=len(out.get('objects') or [])
                kept, removed=_v389_apply_delete_filter(out.get('objects') or [], delete_index)
                out['objects']=kept
                out['mission_deletion_filter']={
                    'version':'v389',
                    'mode':'mission-delete-tombstone-suppression',
                    'objects_before':before,
                    'objects_after':len(kept),
                    'removed_count':len(removed),
                    'removed_sample':removed[:20],
                    'deleted_key_count':len(delete_index),
                    'rows_checked':diag.get('rows_checked'),
                    'sample_delete_events':diag.get('sample_delete_events') or []
                }
            except Exception as _e:
                try:
                    out['mission_deletion_filter']={'version':'v389','error':str(_e)}
                except Exception:
                    pass
            return out
        globals()['tak_map_data_sync']=tak_map_data_sync
        globals()['_tak_v389_data_sync_wrapped']=True

    _v389_script = """<script id=\"v389DataSyncMissionDeleteSuppressionPatch\">
(function(){
  try{
    const V='v389';
    document.documentElement.dataset.takMapIteration=V;
    document.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}});
    window.__takDataSyncMissionDeleteV389={version:V,mode:'mission-delete-tombstone-suppression'};
    window.getDataSyncMissionDeleteAuditV389=function(){return fetch('/api/tak-map/data-sync?force=1&reason=v389-audit&_='+Date.now(),{cache:'no-store',credentials:'same-origin'}).then(function(r){return r.json()}).then(function(j){return {version:V,ok:j&&j.ok,objectCount:(j.objects||[]).length,mission_deletion_filter:j.mission_deletion_filter||null,sources:j.sources||[]};});};
  }catch(e){try{console.warn('v389 Data Sync delete audit marker failed',e)}catch(_){}}
})();
</script>"""

    def _tak_v389_add(_html):
        if not isinstance(_html, str):
            return _html
        _html = _re_v389.sub(r'<script[^>]*id=["\']v389DataSyncMissionDeleteSuppressionPatch["\'][\s\S]*?</script>', '', _html, flags=_re_v389.I)
        _html = _html.replace('tak-map-v388', 'tak-map-v389').replace('TAK-Map/1.2.0 v388', 'TAK-Map/1.2.0 v389')
        _html = _re_v389.sub(r'<span class="iteration-chip">v\d+</span>', '<span class="iteration-chip">v389</span>', _html)
        _html = _re_v389.sub(r'<div class="iteration-marker">v\d+</div>', '<div class="iteration-marker">v389</div>', _html)
        if 'id="v389DataSyncMissionDeleteSuppressionPatch"' not in _html:
            if '</body>' in _html:
                _html = _html.replace('</body>', _v389_script + '\n</body>', 1)
            else:
                _html += _v389_script
        return _html
    for _nm in ('TAK_MAP_HTML','INDEX_HTML'):
        if _nm in globals():
            globals()[_nm] = _tak_v389_add(globals()[_nm])
    if '_html' in globals():
        globals()['_html'] = _tak_v389_add(globals()['_html'])
except Exception as _e_v389:
    try:
        print('v389 Data Sync Mission delete suppression patch failed', _e_v389)
    except Exception:
        pass
# --- end TAK Map v389 patch ---


# --- TAK Map v390 CoT/Data Sync hard reconcile + shape-control ghost suppression ---
try:
    import re as _re_v390

    def _v390_text(v):
        try:
            return str(v or '').strip()
        except Exception:
            return ''

    def _v390_lc(v):
        return _v390_text(v).lower()

    def _v390_marker_is_shape_control(row):
        try:
            if not isinstance(row, dict):
                return False
            g=globals().get('_row_ci_get')
            def get(names):
                try:
                    if callable(g):
                        return g(row, names, '')
                except Exception:
                    pass
                for k in names:
                    if k in row:
                        return row.get(k)
                return ''
            typ=_v390_lc(get(('type','cot_type','event_type','category')))
            uid=_v390_lc(get(('uid','id','cot_uid','event_uid','clientuid','clientUid','client_uid')))
            cs=_v390_lc(get(('callsign','call_sign','name','title')))
            src=_v390_lc(get(('source','source_table','kind','category','geometry')))
            blob=' '.join([typ,uid,cs,src])
            shape_types={'u-d-f','u-d-r','u-d-c','u-d-c-c','u-d-s','u-d-p','u-d-a'}
            if typ in shape_types:
                if uid.startswith('takmap-local-') or uid.startswith('takmap-shape-') or uid.startswith('takmap-draw-'):
                    return True
                if _re_v390.search(r'\b(circle|ellipse|polygon|polyline|rectangle|square|freehand|shape|area|drawing)\b', blob):
                    return True
                if 'tak map' in blob or 'takmap' in blob or 'local-data-shape' in blob:
                    return True
            # ATAK/Tak Map shape center/control points sometimes arrive as generic friendly points
            # with TAKMAP-LOCAL UIDs and a shape-ish callsign even when a parser dropped cot_type.
            if uid.startswith(('takmap-local-','takmap-shape-','takmap-draw-')) and _re_v390.search(r'\b(circle|ellipse|polygon|rectangle|square|freehand|shape)\b', cs):
                return True
        except Exception:
            pass
        return False

    def _v390_filter_shape_control_markers(markers):
        kept=[]; removed=[]
        try:
            for m in markers or []:
                if _v390_marker_is_shape_control(m):
                    if len(removed)<50:
                        removed.append({'uid':_v390_text(m.get('uid') or m.get('id'))[:160], 'callsign':_v390_text(m.get('callsign') or m.get('name'))[:160], 'type':_v390_text(m.get('type') or m.get('cot_type'))[:80], 'source':_v390_text(m.get('source') or m.get('source_table'))[:160]})
                    continue
                kept.append(m)
        except Exception:
            return markers or [], []
        return kept, removed

    if 'tak_map_cot_markers' in globals() and not globals().get('_tak_v390_cot_markers_wrapped'):
        _tak_v390_base_cot_markers = globals()['tak_map_cot_markers']
        def tak_map_cot_markers():
            out=_tak_v390_base_cot_markers()
            try:
                if isinstance(out, dict):
                    before=len(out.get('markers') or [])
                    kept, removed=_v390_filter_shape_control_markers(out.get('markers') or [])
                    out['markers']=kept
                    out['cot_shape_control_filter']={'version':'v390','mode':'server-side-live-cot-shape-control-suppression','markers_before':before,'markers_after':len(kept),'removed_count':len(removed),'removed_sample':removed[:20]}
            except Exception as _e:
                try: out['cot_shape_control_filter']={'version':'v390','error':str(_e)}
                except Exception: pass
            return out
        globals()['tak_map_cot_markers']=tak_map_cot_markers
        globals()['_tak_v390_cot_markers_wrapped']=True

    def _v390_keyset(obj):
        keys=set()
        try:
            if not isinstance(obj, dict):
                return keys
            for k in ('uid','id','guid','cot_uid','event_uid','hash','sha256','filename','name','title','callsign'):
                v=obj.get(k)
                if v not in (None,''):
                    keys.add(str(v).strip().lower())
            p=obj.get('properties') if isinstance(obj.get('properties'), dict) else {}
            for k in ('uid','id','guid','cot_uid','event_uid','hash','sha256','filename','name','title','callsign'):
                v=p.get(k)
                if v not in (None,''):
                    keys.add(str(v).strip().lower())
        except Exception:
            pass
        return {k for k in keys if len(k)>=3}

    if 'tak_map_data_sync' in globals() and not globals().get('_tak_v390_data_sync_wrapped'):
        _tak_v390_base_data_sync = globals()['tak_map_data_sync']
        def tak_map_data_sync():
            out=_tak_v390_base_data_sync()
            try:
                if not isinstance(out, dict):
                    return out
                obj_keys=set()
                obj_names=[]
                for o in out.get('objects') or []:
                    obj_keys.update(_v390_keyset(o))
                    nm=_v390_text(o.get('callsign') or o.get('name') or o.get('uid') or o.get('id'))
                    if nm and len(obj_names)<25: obj_names.append(nm)
                orphan_uids=[]
                shape_control_uids=[]
                for r in out.get('mission_uids') or []:
                    k=_v390_keyset(r)
                    name=_v390_text(r.get('callsign') or r.get('name') or r.get('uid'))
                    if _v390_marker_is_shape_control(r) and len(shape_control_uids)<25:
                        shape_control_uids.append({'uid':_v390_text(r.get('uid'))[:160], 'callsign':name[:160], 'cot_type':_v390_text(r.get('cot_type') or r.get('type'))[:80], 'timestamp':_v390_text(r.get('timestamp') or r.get('time'))[:80]})
                    if k and not (k & obj_keys) and len(orphan_uids)<25:
                        orphan_uids.append({'uid':_v390_text(r.get('uid'))[:160], 'callsign':name[:160], 'cot_type':_v390_text(r.get('cot_type') or r.get('type'))[:80], 'timestamp':_v390_text(r.get('timestamp') or r.get('time'))[:80]})
                takmap_packages=[]
                for r in out.get('mission_content') or []:
                    blob=' '.join(_v390_text(x) for x in (r.get('filename'), r.get('uid'), r.get('hash'), r.get('submitter'), r.get('creator_uid'), r.get('keywords'))).lower()
                    if ('tak-map' in blob or 'takmap' in blob or 'local-data-shape' in blob) and len(takmap_packages)<25:
                        takmap_packages.append({'id':r.get('id'), 'uid':_v390_text(r.get('uid'))[:160], 'filename':_v390_text(r.get('filename'))[:200], 'hash':_v390_text(r.get('hash'))[:80], 'submission_time':_v390_text(r.get('submission_time') or r.get('created_at') or r.get('timestamp'))[:80]})
                out['mission_render_reconcile']={'version':'v390','mode':'diagnose-raw-mission-rows-vs-rendered-objects','objects_count':len(out.get('objects') or []),'object_key_count':len(obj_keys),'mission_uid_count':len(out.get('mission_uids') or []),'mission_content_count':len(out.get('mission_content') or []),'orphan_mission_uid_sample':orphan_uids,'shape_control_mission_uid_sample':shape_control_uids,'takmap_mission_package_sample':takmap_packages,'note':'Rows here are raw OTS mission tables. Only rows in objects are rendered by the Data Sync layer; shape-control rows are also suppressed from live CoT markers in v390.'}
            except Exception as _e:
                try: out['mission_render_reconcile']={'version':'v390','error':str(_e)}
                except Exception: pass
            return out
        globals()['tak_map_data_sync']=tak_map_data_sync
        globals()['_tak_v390_data_sync_wrapped']=True

    _v390_script = """<script id=\"v390DataSyncCotHardReconcilePatch\">
(function(){
  'use strict';
  const V='v390', d=document, w=window;
  function txt(v){try{return String(v==null?'':v)}catch(_){return ''}}
  function lc(v){return txt(v).trim().toLowerCase()}
  function isShapeControl(o){try{if(!o||typeof o!=='object')return false;const typ=lc(o.type||o.cot_type||o.event_type||o.category), uid=lc(o.uid||o.id||o.cot_uid||o.event_uid), cs=lc(o.callsign||o.name||o.title), src=lc(o.source||o.source_table||o.kind||o.geometry);const blob=[typ,uid,cs,src].join(' ');const shapeTypes=['u-d-f','u-d-r','u-d-c','u-d-c-c','u-d-s','u-d-p','u-d-a'];if(shapeTypes.indexOf(typ)>=0){if(uid.indexOf('takmap-local-')===0||uid.indexOf('takmap-shape-')===0||uid.indexOf('takmap-draw-')===0)return true;if(/\b(circle|ellipse|polygon|polyline|rectangle|square|freehand|shape|area|drawing)\b/.test(blob))return true;if(blob.indexOf('tak map')>=0||blob.indexOf('takmap')>=0||blob.indexOf('local-data-shape')>=0)return true;}if((uid.indexOf('takmap-local-')===0||uid.indexOf('takmap-shape-')===0||uid.indexOf('takmap-draw-')===0)&&/\b(circle|ellipse|polygon|rectangle|square|freehand|shape)\b/.test(cs))return true;}catch(_){}return false;}
  function filterCotJson(j){try{if(Array.isArray(j))return j.filter(x=>!isShapeControl(x));if(j&&typeof j==='object'){['markers','objects','items','cot','events','euds'].forEach(function(k){if(Array.isArray(j[k]))j[k]=j[k].filter(x=>!isShapeControl(x));});}return j;}catch(_){return j}}
  function patchFetch(){try{if(w.__v390CotFetchPatched||typeof w.fetch!=='function')return;const old=w.fetch;w.fetch=function(input,init){const url=txt((input&&input.url)||input||'');const p=old.apply(this,arguments);if(url.indexOf('/api/tak-map/cot')<0&&url.indexOf('/api/tak-map/euds')<0)return p;return p.then(function(resp){try{return resp.clone().json().then(function(j){j=filterCotJson(j);return new Response(JSON.stringify(j),{status:resp.status,statusText:resp.statusText,headers:resp.headers});}).catch(function(){return resp});}catch(_){return resp;}})};w.__v390CotFetchPatched=true;}catch(e){try{console.warn('v390 cot fetch patch failed',e)}catch(_){}}}
  function hardClearGroups(){try{if(w.dataSyncLayer&&w.dataSyncLayer.clearLayers)w.dataSyncLayer.clearLayers();}catch(_){} try{if(w.takMarkerLayer&&w.takMarkerLayer.clearLayers)w.takMarkerLayer.clearLayers();}catch(_){} }
  function patchRefreshers(){try{if(!w.__v390RefreshCotPatched&&typeof w.refreshCot==='function'){const base=w.refreshCot;w.refreshCot=async function(){try{const out=await base.apply(this,arguments);try{if(Array.isArray(w.lastTakMarkers))w.lastTakMarkers=w.lastTakMarkers.filter(x=>!isShapeControl(x));}catch(_){}return out;}catch(e){throw e}};try{refreshCot=w.refreshCot}catch(_){} w.__v390RefreshCotPatched=true;}
    if(!w.__v390DrawDataSyncPatched&&typeof w.drawDataSyncObjects==='function'){const baseDraw=w.drawDataSyncObjects;w.drawDataSyncObjects=function(items){try{if(w.dataSyncLayer&&w.dataSyncLayer.clearLayers)w.dataSyncLayer.clearLayers();}catch(_){} return baseDraw.call(this,Array.isArray(items)?items:[]);};try{drawDataSyncObjects=w.drawDataSyncObjects}catch(_){} w.__v390DrawDataSyncPatched=true;}
  }catch(e){try{console.warn('v390 refresher patch failed',e)}catch(_){}}}
  function layerInfo(layer, groupName, needle){let s='';try{s+=txt(layer&&layer.options&&layer.options.title)+' ';}catch(_){}try{const p=layer&&layer.getPopup&&layer.getPopup();const c=p&&p.getContent&&p.getContent();s+=txt(c)+' ';}catch(_){}try{if(layer&&layer.feature)s+=JSON.stringify(layer.feature)+' ';}catch(_){}try{if(layer&&layer._takMeta)s+=JSON.stringify(layer._takMeta)+' ';}catch(_){}const hit=!needle||s.toLowerCase().indexOf(needle)>=0;return hit?{group:groupName||'', text:s.replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').trim().slice(0,600), hasPopup:!!(layer&&layer.getPopup&&layer.getPopup()), leafletId:layer&&layer._leaflet_id||null}:null;}
  function scanGroup(g,name,needle,out){try{if(!g||!g.eachLayer)return;g.eachLayer(function(l){const x=layerInfo(l,name,needle);if(x)out.push(x);try{if(l.eachLayer)scanGroup(l,name+':child',needle,out)}catch(_){}})}catch(_){} }
  async function trace(name){const needle=lc(name);const ds=await fetch('/api/tak-map/data-sync?force=1&reason=v390-trace&_='+Date.now(),{cache:'no-store',credentials:'same-origin'}).then(r=>r.json()).catch(e=>({ok:false,error:String(e)}));const cot=await fetch('/api/tak-map/cot?reason=v390-trace&_='+Date.now(),{cache:'no-store',credentials:'same-origin'}).then(r=>r.json()).catch(e=>({ok:false,error:String(e)}));const scanRows=(rows)=>{try{return (rows||[]).filter(r=>JSON.stringify(r).toLowerCase().indexOf(needle)>=0).slice(0,20)}catch(_){return []}};const layers=[];scanGroup(w.dataSyncLayer,'dataSyncLayer',needle,layers);scanGroup(w.takMarkerLayer,'takMarkerLayer',needle,layers);scanGroup(w.importedLayer,'importedLayer',needle,layers);try{if(w.map&&w.map.eachLayer)w.map.eachLayer(function(l){const x=layerInfo(l,'map',needle);if(x)layers.push(x);});}catch(_){}return {version:V,name:name||'',dataSync:{objectCount:(ds.objects||[]).length,matchingObjects:scanRows(ds.objects),matchingMissionContent:scanRows(ds.mission_content),matchingMissionUids:scanRows(ds.mission_uids),mission_deletion_filter:ds.mission_deletion_filter||null,mission_render_reconcile:ds.mission_render_reconcile||null},cot:{markerCount:(cot.markers||[]).length,matchingMarkers:scanRows(cot.markers),cot_shape_control_filter:cot.cot_shape_control_filter||null},renderedLayerMatches:layers.slice(0,80),patches:{fetch:!!w.__v390CotFetchPatched,refreshCot:!!w.__v390RefreshCotPatched,drawDataSync:!!w.__v390DrawDataSyncPatched}};}
  function boot(){try{d.documentElement.dataset.takMapIteration=V;d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}});}catch(_){} patchFetch();patchRefreshers();}
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',function(){setTimeout(boot,100)},{once:true});else setTimeout(boot,100);
  [400,1000,2200,5000].forEach(ms=>setTimeout(boot,ms));
  w.getTakMapDeletionTraceV390=trace;
