w.TakMapLiveStatusV460={refresh:refreshLiveStatus,diagnostics:()=>({version:V,refreshes:LS.refreshes,networkRefreshes:LS.networkRefreshes,eudSyncs:LS.eudSyncs,lastEudCount:LS.lastEudCount,lastRefreshAt:LS.lastRefreshAt,lastReason:LS.lastReason||'',replayHidden:LS.replayHidden,nonTakPresent:!!d.getElementById('bannerNonTakItem'),barHidden:!!(d.getElementById('mapStatusBanner')&&d.getElementById('mapStatusBanner').hidden),fallbackSeconds:5})};
w.TakMapDiagnostics=function(){let replay=null;try{replay=typeof w.getTakMapReplayDiagnosticsV415==='function'?w.getTakMapReplayDiagnosticsV415():null}catch(_){}return {version:V,loaderLoadedAt:R.loaderLoadedAt,adsb:one('adsb',w.TakMapAdsbWorkerV460),recording:{browserLocal:false,owner:'TAK Gateway',operationalBlackBoxRemoved:true},replay:replay,liveStatus:w.TakMapLiveStatusV460.diagnostics(),legacyAdsbDiagnosticsActive:typeof w.TakMapAdsbDiagnostics==='function'&&!(w.TakMapAdsbWorkerV460&&w.TakMapAdsbDiagnostics===w.TakMapAdsbWorkerV460.diagnostics)}};
