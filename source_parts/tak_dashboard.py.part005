  function setChip(msg,bad){try{let chip=$('terrain3dLocalMeshChip');const panel=d.querySelector('.terrain3d-controls');if(panel&&!chip){chip=d.createElement('div');chip.id='terrain3dLocalMeshChip';chip.className='terrain3d-local-mesh-chip';panel.appendChild(chip)}if(chip){chip.textContent=msg||'';chip.classList.toggle('bad',!!bad)}}catch(_){} }
  function patchStatus(){try{if(w.__takMapV405StatusPatched)return;w.__takMapV405StatusPatched=true;const old=w.terrainStatus||(typeof terrainStatus==='function'?terrainStatus:null);if(typeof old==='function'){const fn=function(msg,bad){try{if(/Local DEM (mesh|terrain surface)/i.test(String(msg||'')))msg=String(msg||'').replace(/Local DEM (?:mesh|terrain surface)/i,'Local DEM coverage').replace(/coverage area(?:s)?/i,'coverage area').replace(/stable refresh/i,'stroke only');}catch(_){}return old.call(this,msg,bad)};w.terrainStatus=fn;try{eval('terrainStatus=window.terrainStatus')}catch(_){}}}catch(_){}}
  function boot(){setVersion();patchPrimitiveAdd();patchExportedMeshEntry();patchStatus();const r=neutralizeExisting();if((Number(r.removed)||0)>0||(Number(w.__takMapV405BlockedAdds)||0)>0)setChip('Local DEM loaded · coverage stroke only',false)}
  function diagnostics(){let primCount=null, taggedVisible=0, taggedTotal=0;try{const prims=collection();if(prims){primCount=Number(prims.length)||0;for(let i=0;i<primCount;i++){let p=null;try{p=prims.get(i)}catch(_){}if(isLocalDemVisualPrimitive(p)){taggedTotal++;if(p&&p.show!==false)taggedVisible++;}}}}catch(_){}return {version:V,source:String(w.terrain3DElevationSource||localStorage.getItem('takMapTerrainElevationSource')||''),coverageStrokeOnly:true,localDemVisualFillHidden:true,primitiveAddPatched:!!(w.Cesium&&w.Cesium.PrimitiveCollection&&w.Cesium.PrimitiveCollection.prototype&&w.Cesium.PrimitiveCollection.prototype.__takMapBaseAddBeforeV405Transparent),blockedAdds:Number(w.__takMapV405BlockedAdds)||0,lastNeutralize:w.__takMapV405LastNeutralize||null,taggedVisiblePrimitives:taggedVisible,taggedTotalPrimitives:taggedTotal,primitiveCount:primCount,boundaryEntities:(w.__v402LocalTerrainBounds||[]).length,decodedTiles:(function(){try{return Array.from(((w.takLocalElevation||{}).tiles||new Map()).values()).length}catch(_){return null}})()};}
