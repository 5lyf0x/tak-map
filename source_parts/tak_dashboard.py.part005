<script id="takMapAdsbWorkerI460" src="/assets/runtime/tak-map-adsb-v460.js?v=1.3.0-i460" defer onload="TakMapRuntimeMarkV460('adsb','loaded')" onerror="TakMapRuntimeMarkV460('adsb','error','runtime asset failed to load')"></script>'''

    def _i460_patch_html(html):
        if not isinstance(html,str):return html
        # Remove all prior deterministic runtime loaders and all browser-local
        # Black Box module tags before installing the ADS-B-only i460 loader.
        html=_i460_re.sub(r'<script[^>]*id=["\']takMapRuntimeMonitorV(?:456|458|459|460)["\'][\s\S]*?</script>\s*','',html,flags=_i460_re.I)
        html=_i460_re.sub(r'<script[^>]*id=["\']takMap(?:AdsbWorkerI(?:456|458|459|460)|BlackboxV\d+)["\'][^>]*></script>\s*','',html,flags=_i460_re.I)
        html=html.replace('<span class="status-item status-dropdown-trigger" id="bannerNonTakItem" onclick="toggleStatusDropdown(\'nontak\',event)"><span class="status-dot unknown" id="bannerNonTakDot"></span>Non-TAK Sensor: <b id="bannerNonTak">0</b></span>','')
        html=_i460_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i460\2',html)
        html=_i460_re.sub(r'(<span class="release-main">)[^<]+(</span>)',r'\g<1>1.3.0\2',html)
        html=html.replace('TAK-Map/1.3.0 i456','TAK-Map/1.3.0 i460').replace('TAK-Map/1.3.0 i458','TAK-Map/1.3.0 i460').replace('TAK-Map/1.3.0 i459','TAK-Map/1.3.0 i460').replace('TAKDashboard/i456','TAKDashboard/i460').replace('TAKDashboard/i458','TAKDashboard/i460').replace('TAKDashboard/i459','TAKDashboard/i460')
        if '</body></html>' in html:return html.replace('</body></html>',_i460_runtime_scripts+'</body></html>')
        if '</body>' in html:return html.replace('</body>',_i460_runtime_scripts+'</body>',1)
        return html+_i460_runtime_scripts
    TAK_MAP_HTML=_i460_patch_html(TAK_MAP_HTML)
    try:TAK_MAP_LOGIN_HTML=_i460_re.sub(r'(?:i|v)(?:456|458|459)','i460',TAK_MAP_LOGIN_HTML)
    except Exception:pass
except Exception as _i460_exc:
    try:print('TAK Map i460 ADS-B/runtime patch failed:',_i460_exc)
    except Exception:pass
