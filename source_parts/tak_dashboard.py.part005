   const localWidth=1+left.same+right.same;
   if(localWidth>maxRayWidth||left.boundary!==other||right.boundary!==other)continue;
   if(radialSupport(src,x,y,ux,uy,own)<1)continue;
   flip[idx]=other;candidates++;
  }
  for(let seed=0;seed<flip.length;seed++){
   if(!flip[seed]||visited[seed])continue;const target=flip[seed],members=[];let qh=0,qt=0,minR=Infinity,maxR=0;queue[qt++]=seed;visited[seed]=1;
   while(qh<qt){const idx=queue[qh++],x=idx%w,y=(idx/w)|0,r=Math.hypot(x-cx,y-cy);members.push(idx);if(r<minR)minR=r;if(r>maxR)maxR=r;for(const off of neighbors){const ni=idx+off;if(ni<0||ni>=flip.length||visited[ni]||flip[ni]!==target)continue;const nx=ni%w,ny=(ni/w)|0;if(Math.abs(nx-x)>1||Math.abs(ny-y)>1)continue;visited[ni]=1;queue[qt++]=ni}}
   if(maxR-minR<minRadialSpan||members.length<minRadialSpan)continue;
   for(const idx of members){const before=src[idx],after=target;out[idx]=after;passChanged++;if(before===2&&after===1)toVisible++;else if(before===1&&after===2)toBlocked++}
  }
  src=out;changed+=passChanged;passes++;if(!passChanged)break;
 }
 return {classData:src,changed,toVisible,toBlocked,candidates,passes,nearRadius,maxRayWidth}
}
