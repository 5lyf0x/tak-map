            if isinstance(cfg.get('local_elevation_boundary'),dict):cfg['local_elevation_boundary']['version']='i475'
            cfg['gateway_data']={
                'version':'i475','configured':_i475_gateway_data_config().get('configured',False),
                'poll_interval_seconds':300,'manual_refresh':True,
                'existing_replay_mtls':True,'additional_login':False,
                'live_hidden_during_replay':True,'popup_mode':'click-only',
                'sources':['usgs_earthquakes','nws_alerts','nifc_fire_perimeters','nasa_firms','nhc_tropical','ais_vessels'],
            }
