        _html = _re_v402.sub(r'<script[^>]*id=["\']v399LocalDemDetectClearStrokePatch["\'][\s\S]*?</script>', '', _html, flags=_re_v402.I)
        _html = _re_v402.sub(r'<script[^>]*id=["\']v400LocalDemSurfaceStrokePatch["\'][\s\S]*?</script>', '', _html, flags=_re_v402.I)
        _html = _re_v402.sub(r'<script[^>]*id=["\']v402LocalDemSurfaceStrokePatch["\'][\s\S]*?</script>', '', _html, flags=_re_v402.I)
        if 'id="v402LocalDemSurfaceStrokePatch"' not in _html:
