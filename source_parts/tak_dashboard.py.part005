# --- TAK Map i475 Gateway Data integration over existing Replay mTLS ---
try:
    import re as _i475_re

    def _i475_gateway_data_api_url():
        explicit=os.environ.get('TAK_MAP_GATEWAY_DATA_API_URL','').strip().rstrip('/')
        if explicit:return explicit
        base=str(TAK_MAP_REPLAY_API_URL or '').rstrip('/')
        if base.endswith('/api/replay/v1'):
            return base[:-len('/api/replay/v1')]+'/api/external-sources/v1'
        return base+'/api/external-sources/v1' if base else ''

    TAK_MAP_GATEWAY_DATA_API_URL=_i475_gateway_data_api_url()
    TAK_MAP_GATEWAY_DATA_TIMEOUT=max(3,min(60,int(os.environ.get('TAK_MAP_GATEWAY_DATA_TIMEOUT','20') or 20)))

    def _i475_gateway_data_config():
        replay=_tak_v415_replay_config_status()
        return {
            'ok':True,'configured':bool(replay.get('configured') and TAK_MAP_GATEWAY_DATA_API_URL),
            'api_url':TAK_MAP_GATEWAY_DATA_API_URL,'poll_interval_seconds':300,
            'manual_refresh_reads_gateway_snapshot':True,'forces_upstream_refresh':False,
            'auth':'existing-replay-client-certificate','additional_login':False,
            'client_cert_present':replay.get('client_cert_present',False),
            'client_key_present':replay.get('client_key_present',False),
            'ca_cert_present':replay.get('ca_cert_present',False),
            'verify_tls':replay.get('verify_tls',True),'version':'i475',
        }

    def _i475_gateway_data_proxy(handler,endpoint,query=''):
        endpoint=str(endpoint or '').strip('/')
        if endpoint not in {'health','capabilities','snapshot'}:
            return handler._send_json({'ok':False,'error':'Unsupported Gateway Data endpoint.'},404)
        cfg=_i475_gateway_data_config()
        if not cfg.get('configured'):
            return handler._send_json({'ok':False,'configured':False,'error':cfg.get('configuration_error') or 'Gateway Data API is not configured.','config':cfg},503)
        url=cfg['api_url'].rstrip('/')+'/'+endpoint
        if query:url+='?'+query
        try:
            req=_urlreq_v415.Request(url,headers={'Accept':'application/json','User-Agent':'TAK-Map/1.3.0-i475 Gateway-Data'})
            with _urlreq_v415.urlopen(req,context=_tak_v415_replay_ssl_context(),timeout=TAK_MAP_GATEWAY_DATA_TIMEOUT) as resp:
                body=resp.read(32*1024*1024)
                code=int(getattr(resp,'status',200) or 200)
                try:data=json.loads(body.decode('utf-8','replace'))
                except Exception:return handler._send_json({'ok':False,'error':'Gateway Data API returned invalid JSON.','status':code},502)
                return handler._send_json(data,code)
        except _urlerr_v415.HTTPError as exc:
            try:detail=json.loads(exc.read().decode('utf-8','replace'))
            except Exception:detail={'ok':False,'error':str(exc)}
            return handler._send_json(detail,int(exc.code or 502))
        except Exception as exc:
            return handler._send_json({'ok':False,'error':'Gateway Data API proxy failed: '+str(exc),'configured':cfg.get('configured',False)},502)

    _i475_prev_adsb=tak_map_adsb
    def tak_map_adsb(query_settings=None):
        out=_i475_prev_adsb(query_settings)
        if isinstance(out,dict):out['version']='i475'
        return out

    _i475_prev_status=_i466_tile_status
    def _i475_tile_status():
        out=dict(_i475_prev_status() or {})
        out['version']='i475'
        return out

    _i475_prev_config=tak_map_config
