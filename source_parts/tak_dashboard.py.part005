  function neutralizeExisting(){let removed=0, hidden=0, seen=0;try{const prims=collection();if(prims){let len=Number(prims.length)||0;for(let i=len-1;i>=0;i--){let p=null;try{p=(typeof prims.get==='function')?prims.get(i):null}catch(_){}if(!p||!isLocalDemVisualPrimitive(p))continue;seen++;try{p.show=false;hidden++}catch(_){}if(removeFromCollection(prims,p))removed++;}}}catch(e){try{console.warn('v405 local DEM visual neutralize failed',e)}catch(_){}}try{const arrays=[w._v320LocalMeshPrimitives,w._v319LocalMeshPrimitives,w._v296LocalMeshPrimitives,w.__v402LocalTerrainSurfacePrimitives,w.__v401LocalTerrainSurfacePrimitives];arrays.forEach(function(arr){try{(arr||[]).forEach(function(p){if(isLocalDemVisualPrimitive(p)){seen++;try{p.show=false;hidden++}catch(_){}removeFromCollection(collection(),p)&&removed++;}})}catch(_){}})}catch(_){}clearTaggedArrays();try{const v=viewer();v&&v.scene&&v.scene.requestRender&&v.scene.requestRender()}catch(_){}w.__takMapV405LastNeutralize={ts:Date.now(),removed:removed,hidden:hidden,seen:seen};return w.__takMapV405LastNeutralize}
  function patchPrimitiveAdd(){try{const Cesium=w.Cesium;if(!Cesium||!Cesium.PrimitiveCollection||!Cesium.PrimitiveCollection.prototype||typeof Cesium.PrimitiveCollection.prototype.add!=='function')return false;const proto=Cesium.PrimitiveCollection.prototype;if(!proto.__takMapBaseAddBeforeV405Transparent){proto.__takMapBaseAddBeforeV405Transparent=proto.add;proto.add=function(primitive){try{if(isLocalDemVisualPrimitive(primitive)){w.__takMapV405BlockedAdds=(Number(w.__takMapV405BlockedAdds)||0)+1;try{primitive.show=false}catch(_){}try{console.debug&&console.debug('v405 hid local DEM visual fill primitive:',primitive)}catch(_){}return primitive;}}catch(_){}return proto.__takMapBaseAddBeforeV405Transparent.apply(this,arguments)};}return true}catch(e){try{console.warn('v405 primitive add patch failed',e)}catch(_){ }return false}}
