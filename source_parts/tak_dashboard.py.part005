.replay-confirm-v415{display:none;position:fixed;inset:0;z-index:5000;background:rgba(4,8,12,.76);place-items:center}.replay-confirm-card-v415{width:min(470px,92vw);background:linear-gradient(180deg,#111923,#090e14);border:1px solid rgba(255,255,255,.14);border-left:4px solid #ff6f2e;border-radius:14px;padding:18px;box-shadow:0 24px 60px rgba(0,0,0,.6)}.replay-confirm-card-v415 h3{margin:0 0 8px}.replay-confirm-card-v415 p{color:#b7c5ce;line-height:1.45}.replay-confirm-actions-v415{display:flex;justify-content:flex-end;gap:8px}.replay-confirm-actions-v415 button{border:1px solid #354556;background:#1d2833;color:#e9f0f5;border-radius:9px;padding:8px 12px;font-weight:850}.replay-confirm-actions-v415 .primary{border-color:#ff6f2e;background:rgba(255,111,46,.12)}
