  function removeLiveTakMenu(){try{ensureStyle();stashLiveRows();qa('#sidebar .panel').forEach(function(panel){try{const h=panel.querySelector('h2');const txt=(h&&h.textContent||'').trim().toLowerCase();if(txt==='live tak'){const rows=panel.querySelector('#liveRows');if(rows){rows.classList.add('tak-v404-live-rows-stash');rows.setAttribute('aria-hidden','true');rows.style.display='none';(d.getElementById('sidebar')||d.body||d.documentElement).appendChild(rows)}panel.classList.add('tak-v404-live-tak-hidden');panel.setAttribute('aria-hidden','true');panel.remove();}}catch(_){}})}catch(e){try{console.warn('v404 Live TAK menu removal failed',e)}catch(_){}}}
