wshedUi();try{window.syncViewshedUiV504&&window.syncViewshedUiV504()}catch(_){}};box.appendChild(add);updateCount()}"""

    def _i504_patch_html(html):
        if not isinstance(html, str):
            return html
        html = html.replace('1.3.0-i503', '1.3.0-i504').replace('TAKDashboard/i503', 'TAKDashboard/i504').replace('TAK-Map/1.3.0 i503', 'TAK-Map/1.3.0 i504')
        html = _i491_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i504\2', html)
        if 'TakMapViewshedMaskV504' not in html and 'function cleanupViewshedMaskV503' in html:
            html = html.replace('function cleanupViewshedMaskV503', _I504_VIEWSHED_SYMMETRIC_CLEANUP + 'function cleanupViewshedMaskV503', 1)
        v503_marker = "if(!r._maskCleanupV503){const smoothed=cleanupViewshedMaskV503(r.classData,r.width,r.height);r.classData=smoothed.classData;r._maskCleanupV503={version:'i503',changed:smoothed.changed,componentsRemoved:smoothed.componentsRemoved,candidates:smoothed.candidates,nearRadius:smoothed.nearRadius,minRadialSpan:smoothed.minRadialSpan}};"
        if '_maskCleanupV504' not in html and v503_marker in html:
            v504_call = v503_marker + "if(!r._maskCleanupV504){const symmetric=cleanupViewshedMaskV504(r.classData,r.width,r.height);r.classData=symmetric.classData;r._maskCleanupV504={version:'i504',changed:symmetric.changed,toVisible:symmetric.toVisible,toBlocked:symmetric.toBlocked,candidates:symmetric.candidates,passes:symmetric.passes,nearRadius:symmetric.nearRadius,maxRayWidth:symmetric.maxRayWidth}};"
            html = html.replace(v503_marker, v504_call, 1)
        if _I504_OLD_RENDER_TABS in html:
            html = html.replace(_I504_OLD_RENDER_TABS, _I504_NEW_RENDER_TABS, 1)
        if 'id="takMapViewshedUiV504"' not in html:
            html = html.replace('</body></html>', _I504_VIEWSHED_UI + '</body></html>')
        return html

    TAK_MAP_HTML = _i504_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
except Exception as _i504_exc:
    try:
        print('TAK Map i504 patch failed:', _i504_exc)
    except Exception:
        pass
# --- end TAK Map i504 symmetric Viewshed smoothing and Geofence-style floating window ---



# --- TAK Map i505 server-persisted TAK Gateway composite basemaps ---
try:
    import urllib.request as _i505_urlreq
    import urllib.error as _i505_urlerr

    TAK_MAP_CUSTOM_BASEMAPS_FILE = TAK_MAP_OFFLINE_DIR / 'custom_basemaps.json'
    TAK_MAP_CUSTOM_BASEMAP_LIMIT = max(1, min(200, int(os.environ.get('TAK_MAP_CUSTOM_BASEMAP_LIMIT','80') or 80)))
    TAK_MAP_CUSTOM_BASEMAP_XML_LIMIT = max(4096, min(2 * 1024 * 1024, int(os.environ.get('TAK_MAP_CUSTOM_BASEMAP_XML_LIMIT','524288') or 524288)))
    TAK_MAP_GATEWAY_BASEMAP_TIMEOUT = max(3, min(60, int(os.environ.get('TAK_MAP_GATEWAY_BASEMAP_TIMEOUT','20') or 20)))

    def _i505_gateway_asset_base():
        explicit = str(os.environ.get('TAK_MAP_GATEWAY_BASEMAP_URL','') or '').strip().rstrip('/')
        if explicit:
            parsed = urlparse(explicit)
            if parsed.scheme in ('http','https') and parsed.hostname:
                return explicit
            return ''
        try:
            configured_api = str(os.environ.get('TAK_MAP_GATEWAY_DATA_API_URL','') or globals().get('TAK_MAP_GATEWAY_DATA_API_URL','') or TAK_MAP_REPLAY_API_URL or '')
            replay = urlparse(configured_api)
            if not replay.hostname:
                return ''
            host = replay.hostname
            if ':' in host and not host.startswith('['):
                host = '[' + host + ']'
            port = int(os.environ.get('TAK_MAP_GATEWAY_BASEMAP_PORT','8090') or 8090)
            scheme = str(os.environ.get('TAK_MAP_GATEWAY_BASEMAP_SCHEME','http') or 'http').strip().lower()
            if scheme not in ('http','https'):
                scheme = 'http'
            return f'{scheme}://{host}:{port}'
        except Exception:
            return ''

    def _i505_xml_text(root, *names):
        wanted = {str(x).lower() for x in names}
        for node in root.iter():
            tag = str(node.tag or '').split('}',1)[-1].lower()
            if tag in wanted:
                return str(node.text or '').strip()
        return ''

    def _i505_normalize_template(url):
        value = str(url or '').strip()
        value = (value.replace('{$z}','{z}').replace('{$x}','{x}').replace('{$y}','{y}').replace('{$s}','{s}')
                      .replace('${z}','{z}').replace('${x}','{x}').replace('${y}','{y}').replace('${s}','{s}'))
        parsed = urlparse(value)
        if parsed.scheme not in ('http','https') or not parsed.netloc:
            raise ValueError('Basemap tile URL must use HTTP or HTTPS.')
        if parsed.username or parsed.password:
            raise ValueError('Credentials embedded in basemap URLs are not supported.')
        if not all(token in value for token in ('{z}','{x}','{y}')):
            raise ValueError('Basemap tile URL must contain z, x, and y tile placeholders.')
        return value

    def _i505_safe_int(value, default, lo=0, hi=30):
        try:
            return max(lo, min(hi, int(str(value).strip())))
        except Exception:
            return default

    def _i505_bool(value, default=False):
        text = str(value or '').strip().lower()
        if not text:
            return bool(default)
        return text in ('1','true','yes','on')

    def _i505_basemap_id(label, upstream):
        digest = hashlib.sha256((str(label)+'\0'+str(upstream)).encode('utf-8','replace')).hexdigest()[:16]
        return 'custom_xml_' + digest

    def _i505_is_gateway_composite(upstream, source_kind=''):
        u = str(upstream or '').lower()
        return (str(source_kind or '').lower() == 'tak-gateway'
                or '/weather/noaa/composite/' in u
                or ('/tiles/' in u and 'radar' in u)
                or '/basemaps/composite/' in u)

    def _i505_parse_basemap_xml(raw, filename='', source_kind='manual'):
        if isinstance(raw, str):
            blob = raw.encode('utf-8')
        else:
            blob = bytes(raw or b'')
        if not blob:
            raise ValueError('Basemap XML is empty.')
        if len(blob) > TAK_MAP_CUSTOM_BASEMAP_XML_LIMIT:
            raise ValueError('Basemap XML exceeds the configured size limit.')
        try:
            root = ET.fromstring(blob)
        except Exception as exc:
            raise ValueError('Invalid basemap XML: ' + str(exc))
        root_name = str(root.tag or '').split('}',1)[-1].lower()
        if root_name not in ('custommapsource','mapsource','custommap'):
            raise ValueError('Expected an ATAK/MOBAC customMapSource XML file.')
        label = (_i505_xml_text(root,'name','title') or Path(str(filename or 'Custom basemap')).stem or 'Custom basemap').strip()[:120]
        upstream = _i505_normalize_template(_i505_xml_text(root,'url','serverUrl','tileUrl'))
        tile_type = (_i505_xml_text(root,'tileType','format') or 'PNG').strip().lower()
        if tile_type == 'jpeg':
            tile_type = 'jpg'
        if tile_type not in ('png','jpg','webp'):
            tile_type = 'png'
        min_zoom = _i505_safe_int(_i505_xml_text(root,'minZoom'),0)
        max_zoom = _i505_safe_int(_i505_xml_text(root,'maxZoom'),19)
        if max_zoom < min_zoom:
            min_zoom,max_zoom = max_zoom,min_zoom
        tile_update = (_i505_xml_text(root,'tileUpdate') or 'None').strip()[:80]
        ignore_errors = _i505_bool(_i505_xml_text(root,'ignoreErrors'),True)
        background = (_i505_xml_text(root,'backgroundColor') or '#000000').strip()[:32]
        source_kind = 'tak-gateway' if _i505_is_gateway_composite(upstream,source_kind) else 'manual'
        bid = _i505_basemap_id(label,upstream)
        return {
            'id':bid,
            'label':label,
            'group':'TAK Gateway Composite' if source_kind == 'tak-gateway' else 'Custom',
            'type':'xyz',
            'upstream_url':upstream,
            'attribution':('TAK Gateway · ' if source_kind == 'tak-gateway' else '') + label,
            'minZoom':min_zoom,
            'maxZoom':max_zoom,
            'tileType':tile_type,
            'tileUpdate':tile_update,
            'ignoreErrors':ignore_errors,
            'backgroundColor':background,
            'source_kind':source_kind,
            'source_xml_name':Path(str(filename or (label+'.xml'))).name[:180],
            'imported_at':datetime.now(timezone.utc).isoformat(),
            'imported_basemap':True,
            'proxy_mode':'single-upstream-request-byte-forward-no-local-cache',
        }

    def _i505_load_custom_basemaps():
        data = load_json_file(TAK_MAP_CUSTOM_BASEMAPS_FILE, {'basemaps':[]})
        rows = data.get('basemaps') if isinstance(data,dict) else []
        if not isinstance(rows,list):
            return []
        clean=[]
        for row in rows:
            if not isinstance(row,dict):
                continue
            try:
                upstream=_i505_normalize_template(row.get('upstream_url') or '')
            except Exception:
                continue
            item=dict(row)
            item['upstream_url']=upstream
            item['id']=str(item.get('id') or _i505_basemap_id(item.get('label'),upstream))
            item['label']=str(item.get('label') or item['id'])[:120]
            item['source_kind']='tak-gateway' if _i505_is_gateway_composite(upstream,item.get('source_kind')) else 'manual'
            item['group']='TAK Gateway Composite' if item['source_kind']=='tak-gateway' else 'Custom'
            item['minZoom']=_i505_safe_int(item.get('minZoom'),0)
            item['maxZoom']=_i505_safe_int(item.get('maxZoom'),19)
            item['tileType']=str(item.get('tileType') or 'png').lower()
            if item['tileType'] not in ('png','jpg','webp'): item['tileType']='png'
            item['imported_basemap']=True
            item['proxy_mode']='single-upstream-request-byte-forward-no-local-cache'
            clean.append(item)
        return clean[-TAK_MAP_CUSTOM_BASEMAP_LIMIT:]

    def _i505_save_custom_basemaps(rows):
        TAK_MAP_OFFLINE_DIR.mkdir(parents=True, exist_ok=True)
        final=list(rows or [])[-TAK_MAP_CUSTOM_BASEMAP_LIMIT:]
        atomic_write_json(TAK_MAP_CUSTOM_BASEMAPS_FILE, {'version':'i505','basemaps':final,'updated':datetime.now(timezone.utc).isoformat()})
        return final

    def _i505_upsert_custom_basemaps(incoming):
        rows=_i505_load_custom_basemaps()
        by_id={str(x.get('id')):dict(x) for x in rows}
        for item in incoming or []:
            if not isinstance(item,dict): continue
            by_id[str(item.get('id'))]=dict(item)
        return _i505_save_custom_basemaps(list(by_id.values()))

    def _i505_public_basemap(row):
        item=dict(row)
        item.pop('upstream_url',None)
        ext=str(item.get('tileType') or 'png').lower()
        if ext not in ('png','jpg','webp'): ext='png'
        item['url']='/api/tak-map/custom-basemap-tile/'+quote(str(item.get('id') or ''),safe='')+'/{z}/{x}/{y}.'+ext
        item['importedBasemap']=True
        item['serverPersisted']=True
        return item

    def _i505_public_custom_basemaps():
        return [_i505_public_basemap(x) for x in _i505_load_custom_basemaps()]

    def _i505_custom_basemap_result(message='', imported=None, errors=None):
        custom=_i505_public_custom_basemaps()
        return {'ok':not bool(errors and not imported),'version':'i505','message':message,'imported':imported or [],'errors':errors or [],'custom_basemaps':custom,'basemaps':tak_map_config().get('basemaps') or [],'storage':str(TAK_MAP_CUSTOM_BASEMAPS_FILE)}

    def _i505_import_uploaded_xml(handler):
        try:
            ctype=str(handler.headers.get('Content-Type') or '')
            if 'multipart/form-data' not in ctype.lower():
                return handler._send_json({'ok':False,'error':'Expected multipart/form-data basemap XML upload.'},400)
            n=int(handler.headers.get('Content-Length','0') or 0)
            if n<=0:
                return handler._send_json({'ok':False,'error':'No basemap XML upload body received.'},400)
            if n > TAK_MAP_CUSTOM_BASEMAP_XML_LIMIT * 20:
                return handler._send_json({'ok':False,'error':'Basemap XML upload is too large.'},413)
            uploaded=_parse_multipart_files(ctype,handler.rfile.read(n))
            if not uploaded:
                return handler._send_json({'ok':False,'error':'No XML files were found in the upload.'},400)
            imported=[];errors=[]
            for filename,blob in uploaded[:20]:
                try:
                    imported.append(_i505_parse_basemap_xml(blob,filename,'manual'))
                except Exception as exc:
                    errors.append({'name':filename,'error':str(exc)[:240]})
            if imported:
                _i505_upsert_custom_basemaps(imported)
            code=200 if imported else 400
            return handler._send_json(_i505_custom_basemap_result('Imported '+str(len(imported))+' basemap XML file(s).',imported,errors),code)
        except Exception as exc:
            return handler._send_json({'ok':False,'error':'Basemap XML import failed: '+str(exc)},500)

    def _i505_fetch_gateway_xml(url):
        req=_i505_urlreq.Request(url,headers={'Accept':'application/xml,text/xml','User-Agent':'TAK-Map/1.3.0-i506 Gateway-Basemap-Import'})
        with _i505_urlreq.urlopen(req,timeout=TAK_MAP_GATEWAY_BASEMAP_TIMEOUT) as resp:
            body=resp.read(TAK_MAP_CUSTOM_BASEMAP_XML_LIMIT+1)
            if len(body)>TAK_MAP_CUSTOM_BASEMAP_XML_LIMIT:
                raise ValueError('Gateway basemap XML exceeds the configured size limit.')
            return body

    def _i505_import_gateway_basemaps():
        base=_i505_gateway_asset_base()
        if not base:
            return {'ok':False,'error':'TAK Gateway basemap address is not configured. Set TAK_MAP_GATEWAY_BASEMAP_URL or configure the existing Gateway Replay address.'}
        ids=('tg-imagery-radar','tg-street-radar')
        imported=[];errors=[]
        for bid in ids:
            url=base+'/basemaps/xml/'+bid+'.xml'
            try:
                imported.append(_i505_parse_basemap_xml(_i505_fetch_gateway_xml(url),bid+'.xml','tak-gateway'))
            except Exception as exc:
                errors.append({'id':bid,'url':url,'error':str(exc)[:240]})
        if imported:
            _i505_upsert_custom_basemaps(imported)
        result=_i505_custom_basemap_result('Imported '+str(len(imported))+' TAK Gateway composite basemap(s).',imported,errors)
        result['gateway_base_url']=base
        if not imported:
            result['ok']=False
            result['error']='Could not import TAK Gateway composite basemap XMLs.'
        return result

    def _i505_delete_custom_basemap(basemap_id):
        bid=str(basemap_id or '').strip()
        rows=_i505_load_custom_basemaps()
        kept=[x for x in rows if str(x.get('id') or '')!=bid]
        if len(kept)==len(rows):
            return {'ok':False,'error':'Imported basemap not found.'}
        _i505_save_custom_basemaps(kept)
        return _i505_custom_basemap_result('Imported basemap removed.')

    def _i505_clear_custom_basemaps():
        _i505_save_custom_basemaps([])
        return _i505_custom_basemap_result('All imported basemaps removed.')

    def _i505_expand_tile_url(template,z,x,y):
        return (str(template or '').replace('{z}',str(int(z))).replace('{x}',str(int(x))).replace('{y}',str(int(y))).replace('{s}','a')
                .replace('{$z}',str(int(z))).replace('{$x}',str(int(x))).replace('{$y}',str(int(y))).replace('{$s}','a'))

    def _i505_upstream_tile(upstream,request_headers=None):
        headers={'Accept':'image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8','User-Agent':'TAK-Map/1.3.0-i506 composite-basemap-proxy'}
        request_headers=request_headers or {}
        for key in ('If-None-Match','If-Modified-Since'):
            value=request_headers.get(key)
            if value: headers[key]=value
        req=_i505_urlreq.Request(upstream,headers=headers)
        try:
            with _i505_urlreq.urlopen(req,timeout=TAK_MAP_GATEWAY_BASEMAP_TIMEOUT) as resp:
                body=resp.read()
                return int(getattr(resp,'status',200) or 200),body,{k:str(resp.headers.get(k) or '') for k in ('Content-Type','Cache-Control','Expires','ETag','Last-Modified','Vary')}
        except _i505_urlerr.HTTPError as exc:
            if int(exc.code or 500)==304:
                return 304,b'',{k:str(exc.headers.get(k) or '') for k in ('Content-Type','Cache-Control','Expires','ETag','Last-Modified','Vary')}
            try: body=exc.read()
            except Exception: body=b''
            return int(exc.code or 502),body,{k:str(exc.headers.get(k) or '') for k in ('Content-Type','Cache-Control','Expires','ETag','Last-Modified','Vary')}

    def _i505_proxy_custom_tile(handler,basemap_id,z,x,y):
        row=next((b for b in _i505_load_custom_basemaps() if str(b.get('id') or '')==str(basemap_id or '')),None)
        if not row:
            return handler._send_json({'ok':False,'error':'Imported basemap not found.'},404)
        try:
            z=int(z);x=int(x);y=int(y)
            if z<0 or z>30 or x<0 or y<0 or x>=2**z or y>=2**z:
                return handler._send_json({'ok':False,'error':'Invalid tile coordinates.'},400)
            upstream=_i505_expand_tile_url(row.get('upstream_url'),z,x,y)
            status,body,headers=_i505_upstream_tile(upstream,handler.headers)
            handler.send_response(status)
            ctype=headers.get('Content-Type') or ('image/jpeg' if row.get('tileType')=='jpg' else 'image/webp' if row.get('tileType')=='webp' else 'image/png')
            handler.send_header('Content-Type',ctype)
            for key in ('Cache-Control','Expires','ETag','Last-Modified','Vary'):
                value=headers.get(key)
                if value: handler.send_header(key,value)
            if not headers.get('Cache-Control'):
                handler.send_header('Cache-Control','no-cache')
            handler.send_header('X-TAK-Map-Composite-Proxy','single-upstream-request-no-local-cache')
            handler.send_header('Content-Length',str(len(body)))
            handler.end_headers()
            if body: handler.wfile.write(body)
            return
        except Exception as exc:
            return handler._send_json({'ok':False,'error':'Composite basemap tile proxy failed: '+str(exc)},502)

    _i505_prev_config=tak_map_config
    def tak_map_config():
        cfg=_i505_prev_config()
        if not isinstance(cfg,dict): return cfg
        cfg=dict(cfg)
        cfg['tak_map_iteration']='i505'
        custom=_i505_public_custom_basemaps()
        existing=[b for b in list(cfg.get('basemaps') or []) if not bool((b or {}).get('importedBasemap')) and not str((b or {}).get('id') or '').startswith('custom_xml_')]
        all_maps=existing+custom
        prefs=_load_tak_map_prefs()
        saved=str((prefs or {}).get('last_basemap') or '').strip()
        if saved and any(str(b.get('id') or '')==saved for b in all_maps):
            all_maps=_tak_map_prefer_basemap_first(all_maps,saved)
            cfg['default_basemap']=saved;cfg['last_basemap']=saved;cfg['last_basemap_source']='saved-preference'
        cfg['basemaps']=all_maps
        cfg['custom_basemaps']=custom
        cfg['composite_basemaps']={
            'version':'i505','server_persisted':True,'storage':str(TAK_MAP_CUSTOM_BASEMAPS_FILE),
            'gateway_base_url':_i505_gateway_asset_base(),'gateway_import_ids':['tg-imagery-radar','tg-street-radar'],
            'group':'TAK Gateway Composite','atak_placeholder_normalization':True,
            'single_upstream_tile_request':True,'client_side_composition':False,'additional_gateway_composition':False,
            'tak_map_tile_cache':False,'upstream_cache_headers_preserved':True,
            'proxy_mode':'single-upstream-request-byte-forward-no-local-cache',
        }
        return cfg
    globals()['tak_map_config']=tak_map_config

    _i505_prev_get=Handler.do_GET
    def _i505_get(self):
        parsed=urlparse(self.path)
        m=re.match(r'^/api/tak-map/custom-basemap-tile/([^/]+)/(\d+)/(\d+)/(\d+)(?:\.(?:png|jpg|jpeg|webp))?$',parsed.path)
        if m:
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            return _i505_proxy_custom_tile(self,unquote(m.group(1)),m.group(2),m.group(3),m.group(4))
        if parsed.path=='/api/tak-map/custom-basemaps':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            return self._send_json(_i505_custom_basemap_result('Imported basemaps loaded.'))
        return _i505_prev_get(self)
    Handler.do_GET=_i505_get

    _i505_prev_post=Handler.do_POST
    def _i505_post(self):
        parsed=urlparse(self.path)
        if parsed.path.startswith('/api/tak-map/custom-basemap') and not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        if parsed.path=='/api/tak-map/custom-basemap-upload':
            return _i505_import_uploaded_xml(self)
        if parsed.path=='/api/tak-map/custom-basemap-import-gateway':
            result=_i505_import_gateway_basemaps()
            return self._send_json(result,200 if result.get('ok') else 502)
        if parsed.path=='/api/tak-map/custom-basemap-delete':
            payload=_read_json_body(self)
            result=_i505_delete_custom_basemap(payload.get('id'))
            return self._send_json(result,200 if result.get('ok') else 404)
        if parsed.path=='/api/tak-map/custom-basemap-clear':
            return self._send_json(_i505_clear_custom_basemaps())
        return _i505_prev_post(self)
    Handler.do_POST=_i505_post

    _I505_BASEMAP_UI=r'''<style id="takMapCompositeBasemapStyleV505">
.basemap-button-row:has(#customBasemapRowsV505){grid-template-columns:repeat(2,minmax(0,1fr))!important}#customBasemapRowsV505{grid-column:1/-1;display:grid;gap:5px;margin-top:1px}.tak-custom-basemap-row-v505{display:grid;grid-template-columns:minmax(0,1fr) 25px;gap:6px;align-items:center;padding:5px 6px;border:1px solid rgba(255,255,255,.08);border-radius:7px;background:rgba(255,255,255,.025)}.tak-custom-basemap-name-v505{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#b9c7ce;font-size:.62rem;font-weight:800}.tak-custom-basemap-name-v505 small{display:block;color:#70818b;font-size:.51rem;font-weight:700}.tak-custom-basemap-delete-v505{width:25px;height:25px;padding:0;border:1px solid rgba(239,81,77,.22);border-radius:6px;background:rgba(239,81,77,.07);color:#d98783;font-weight:950;cursor:pointer}.tak-custom-basemap-delete-v505:hover{border-color:rgba(239,81,77,.55);color:#ff8e88;background:rgba(239,81,77,.15)}
</style><script id="takMapCompositeBasemapsV505">
(function(w,d){'use strict';const V='i505';let busy=false;const $=id=>d.getElementById(id);function cfg(){try{return (typeof config!=='undefined'&&config)||w.config||{}}catch(_){return w.config||{}}}function activeId(){try{return (typeof activeBasemap!=='undefined'&&activeBasemap)||w.activeBasemap||''}catch(_){return w.activeBasemap||''}}function status(msg,ok){const el=$('customBasemapStatus');if(el){el.textContent=String(msg||'');el.classList.toggle('danger',ok===false)}try{w.customBasemapImportStatus=String(msg||'')}catch(_){}}
function imported(){return ((cfg().basemaps)||[]).filter(b=>b&&b.importedBasemap)}
function renderRows(){let host=$('customBasemapRowsV505');if(!host){const st=$('customBasemapStatus');if(st&&st.parentElement){host=d.createElement('div');host.id='customBasemapRowsV505';st.insertAdjacentElement('afterend',host)}}if(!host)return;const rows=imported();host.innerHTML='';for(const b of rows){const row=d.createElement('div');row.className='tak-custom-basemap-row-v505';const name=d.createElement('div');name.className='tak-custom-basemap-name-v505';name.textContent=String(b.label||b.id||'Imported basemap');const meta=d.createElement('small');meta.textContent=(String(b.group||'Custom')+' · z'+Number(b.minZoom||0)+'–'+Number(b.maxZoom||19));name.appendChild(meta);const del=d.createElement('button');del.type='button';del.className='tak-custom-basemap-delete-v505';del.textContent='×';del.title='Remove '+String(b.label||'basemap');del.setAttribute('aria-label',del.title);del.onclick=()=>removeOne(b.id);row.append(name,del);host.appendChild(row)}}
async function applyResponse(r){let j={};try{j=await r.json()}catch(_){throw new Error('Basemap service returned an invalid response.')}if(!r.ok||!j.ok)throw new Error(j.error||((j.errors||[])[0]&&j.errors[0].error)||('HTTP '+r.status));if(Array.isArray(j.basemaps)){try{if(typeof config!=='undefined'&&config)config.basemaps=j.basemaps}catch(_){}try{w.config=cfg();w.config.basemaps=j.basemaps}catch(_){}}try{w.renderBasemaps&&w.renderBasemaps()}catch(_){}renderRows();status(j.message||'Basemaps updated.',true);return j}
async function upload(){const input=$('basemapXmlInput'),files=[...(input&&input.files||[])];if(!files.length)return;if(busy)return;busy=true;status('Importing basemap XML…',true);try{const fd=new FormData();for(const f of files)fd.append('files',f,f.name);await applyResponse(await fetch('/api/tak-map/custom-basemap-upload',{method:'POST',body:fd,credentials:'same-origin'}));if(input)input.value=''}catch(e){status('Basemap import failed: '+String(e.message||e),false)}finally{busy=false}}
async function importGateway(){if(busy)return;busy=true;status('Importing TAK Gateway composites…',true);try{await applyResponse(await fetch('/api/tak-map/custom-basemap-import-gateway',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}',credentials:'same-origin'}))}catch(e){status('Gateway import failed: '+String(e.message||e),false)}finally{busy=false}}
async function removeOne(id){if(busy)return;busy=true;try{const was=activeId()===id;await applyResponse(await fetch('/api/tak-map/custom-basemap-delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id}),credentials:'same-origin'}));if(was&&cfg().default_basemap&&w.setBasemap)w.setBasemap(cfg().default_basemap)}catch(e){status('Remove failed: '+String(e.message||e),false)}finally{busy=false}}
async function clearAll(){if(busy)return;if(!confirm('Remove all imported basemaps from TAK Map?'))return;busy=true;try{const was=imported().some(b=>b.id===activeId());await applyResponse(await fetch('/api/tak-map/custom-basemap-clear',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}',credentials:'same-origin'}));if(was&&cfg().default_basemap&&w.setBasemap)w.setBasemap(cfg().default_basemap)}catch(e){status('Clear failed: '+String(e.message||e),false)}finally{busy=false}}
function install(){try{localStorage.removeItem('takMapCustomBasemaps')}catch(_){}try{w.loadCustomBasemaps=()=>[];w.saveCustomBasemaps=()=>{};w.applyCustomBasemaps=()=>{};loadCustomBasemaps=w.loadCustomBasemaps;saveCustomBasemaps=w.saveCustomBasemaps;applyCustomBasemaps=w.applyCustomBasemaps}catch(_){}w.importBasemapXmlFiles=upload;w.importTakGatewayBasemapsV505=importGateway;w.clearCustomBasemaps=clearAll;try{importBasemapXmlFiles=upload;clearCustomBasemaps=clearAll}catch(_){}const add=$('basemapXmlInput');if(add)add.onchange=upload;const old=w.renderBasemaps;if(typeof old==='function'&&!old.__v505){const wrapped=function(){const value=old.apply(this,arguments);renderRows();return value};wrapped.__v505=true;w.renderBasemaps=wrapped;try{renderBasemaps=wrapped}catch(_){}}renderRows()}
w.TakMapCompositeBasemapsV505=Object.freeze({version:V,install,render:renderRows,importGateway,remove:removeOne,diagnostics:()=>({version:V,serverPersisted:true,imported:imported().length,clientComposition:false,localTileCache:false})});install();if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',install,{once:true});[300,900,2200].forEach(ms=>setTimeout(install,ms));
})(window,document);
</script>'''

    def _i505_patch_html(html):
        if not isinstance(html,str): return html
        html=html.replace('1.3.0-i504','1.3.0-i505').replace('TAKDashboard/i504','TAKDashboard/i505').replace('TAK-Map/1.3.0 i504','TAK-Map/1.3.0 i505')
        html=_i491_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i505\2',html)
        old='<button class="layer-button" onclick="triggerBasemapXmlImport()">Add Basemap</button><button class="layer-button" onclick="clearCustomBasemaps()">Clear Custom</button>'
        new='<button class="layer-button" onclick="triggerBasemapXmlImport()">Add Basemap</button><button class="layer-button" onclick="importTakGatewayBasemapsV505()">Import Gateway</button><button class="layer-button" onclick="clearCustomBasemaps()">Clear Custom</button>'
        if old in html: html=html.replace(old,new,1)
        status_tag='<small id="customBasemapStatus" class="basemap-import-status"></small>'
        if 'id="customBasemapRowsV505"' not in html and status_tag in html: html=html.replace(status_tag,status_tag+'<div id="customBasemapRowsV505"></div>',1)
        html=html.replace("const order=['Offline Maps','Imagery','Topo / Terrain','Street / Reference','Basemaps'];","const order=['Offline Maps','TAK Gateway Composite','Imagery','Topo / Terrain','Street / Reference','Custom','Basemaps'];",1)
        if 'id="takMapCompositeBasemapsV505"' not in html: html=html.replace('</body></html>',_I505_BASEMAP_UI+'</body></html>')
        return html

    TAK_MAP_HTML=_i505_patch_html(TAK_MAP_HTML);INDEX_HTML=TAK_MAP_HTML
except Exception as _i505_exc:
    try: print('TAK Map i505 composite basemap patch failed:',_i505_exc)
    except Exception: pass
# --- end TAK Map i505 server-persisted TAK Gateway composite basemaps ---

# --- TAK Map i506 catalog-driven composite basemaps and compact manager ---
try:
    from urllib.parse import urljoin as _i506_urljoin

    TAK_MAP_GATEWAY_CATALOG_LIMIT = max(4096, min(2 * 1024 * 1024, int(os.environ.get('TAK_MAP_GATEWAY_CATALOG_LIMIT','524288') or 524288)))
    _I506_GATEWAY_CATALOG_PATHS = (
        '/basemaps/catalog.json',
        '/basemaps/catalog',
        '/basemaps/manifest.json',
        '/basemaps/index.json',
        '/api/basemaps/catalog',
    )
    _I506_GATEWAY_FALLBACK_GROUPS = (
        ('noaa-imagery', ('tg-imagery-radar','tg-img-noaa','tg-imagery-noaa','tg-esri-img-noaa','tg-esri-imagery-noaa','tg-img-radar')),
        ('noaa-street', ('tg-street-radar','tg-strt-noaa','tg-street-noaa','tg-esri-strt-noaa','tg-esri-street-noaa','tg-strt-radar')),
        ('rainviewer-imagery', ('tg-imagery-rainviewer','tg-img-rainviewer','tg-rainviewer-img','tg-rainviewer-imagery','tg-rainviewer-esri-img','tg-rainviewer-esri-imagery','tg-esri-img-rainviewer','tg-esri-imagery-rainviewer')),
        ('rainviewer-street', ('tg-street-rainviewer','tg-strt-rainviewer','tg-rainviewer-strt','tg-rainviewer-street','tg-rainviewer-esri-strt','tg-rainviewer-esri-street','tg-esri-strt-rainviewer','tg-esri-street-rainviewer')),
        ('imerg-imagery', ('tg-imagery-imerg','tg-img-imerg','tg-imerg-img','tg-imerg-imagery','tg-imerg-esri-img','tg-imerg-esri-imagery','tg-esri-img-imerg','tg-esri-imagery-imerg','tg-imagery-nasa-imerg','tg-img-nasa-imerg','tg-nasa-imerg-esri-img')),
        ('imerg-street', ('tg-street-imerg','tg-strt-imerg','tg-imerg-strt','tg-imerg-street','tg-imerg-esri-strt','tg-imerg-esri-street','tg-esri-strt-imerg','tg-esri-street-imerg','tg-street-nasa-imerg','tg-strt-nasa-imerg','tg-nasa-imerg-esri-street')),
        ('goes18-imagery', ('tg-imagery-goes18','tg-imagery-goes-18','tg-img-goes18','tg-img-goes-18','tg-goes18-img','tg-goes-18-img','tg-goes18-esri-img','tg-goes-18-esri-img','tg-esri-img-goes18','tg-imagery-goes18-pacific','tg-imagery-goes-18-pacific','tg-goes18-pacific-esri-img')),
        ('goes18-street', ('tg-street-goes18','tg-street-goes-18','tg-strt-goes18','tg-strt-goes-18','tg-goes18-strt','tg-goes-18-strt','tg-goes18-esri-street','tg-goes-18-esri-street','tg-esri-strt-goes18','tg-street-goes18-pacific','tg-street-goes-18-pacific','tg-goes18-pacific-esri-street')),
        ('goes19-imagery', ('tg-imagery-goes19','tg-imagery-goes-19','tg-img-goes19','tg-img-goes-19','tg-goes19-img','tg-goes-19-img','tg-goes19-esri-img','tg-goes-19-esri-img','tg-esri-img-goes19','tg-imagery-goes19-atlantic','tg-imagery-goes-19-atlantic','tg-goes19-atlantic-esri-img')),
        ('goes19-street', ('tg-street-goes19','tg-street-goes-19','tg-strt-goes19','tg-strt-goes-19','tg-goes19-strt','tg-goes-19-strt','tg-goes19-esri-street','tg-goes-19-esri-street','tg-esri-strt-goes19','tg-street-goes19-atlantic','tg-street-goes-19-atlantic','tg-goes19-atlantic-esri-street')),
    )

    def _i506_gateway_family(*values):
        text=' '.join(str(v or '') for v in values).lower().replace('_','-')
        kind='street' if any(x in text for x in ('street','strt','road')) else 'imagery' if any(x in text for x in ('imagery','img','satellite')) else ''
        provider=''
        if 'rainviewer' in text: provider='rainviewer'
        elif 'imerg' in text: provider='imerg'
        elif 'goes-18' in text or 'goes18' in text: provider='goes18'
        elif 'goes-19' in text or 'goes19' in text: provider='goes19'
        elif 'noaa' in text or 'radar' in text: provider='noaa'
        return (provider+'-'+kind).strip('-') if provider else ''

    def _i506_management_source(row):
        text=' '.join(str((row or {}).get(k) or '') for k in ('label','gateway_catalog_id','source_xml_name','upstream_url')).lower()
        if 'rainviewer' in text: return 'RainViewer'
        if 'imerg' in text: return 'NASA IMERG'
        if 'goes-18' in text or 'goes18' in text: return 'GOES-18 Pacific'
        if 'goes-19' in text or 'goes19' in text: return 'GOES-19 Atlantic'
        if 'noaa' in text or 'radar' in text: return 'NOAA Radar'
        return 'TAK Gateway' if str((row or {}).get('source_kind') or '')=='tak-gateway' else 'Custom XML'

    _i506_original_save_custom_basemaps = _i505_save_custom_basemaps
    def _i506_save_custom_basemaps(rows):
        TAK_MAP_OFFLINE_DIR.mkdir(parents=True, exist_ok=True)
        final=list(rows or [])[-TAK_MAP_CUSTOM_BASEMAP_LIMIT:]
        atomic_write_json(TAK_MAP_CUSTOM_BASEMAPS_FILE, {'version':'i506','basemaps':final,'updated':datetime.now(timezone.utc).isoformat()})
        return final
    _i505_save_custom_basemaps = _i506_save_custom_basemaps

    _i506_original_public_basemap = _i505_public_basemap
    def _i506_public_basemap(row):
        item=_i506_original_public_basemap(row)
        item['managementSource']=_i506_management_source(row)
        item['managementType']='gateway' if str((row or {}).get('source_kind') or '')=='tak-gateway' else 'custom'
        if (row or {}).get('gateway_catalog_id'):
            item['gatewayCatalogId']=str((row or {}).get('gateway_catalog_id'))
        return item
    _i505_public_basemap = _i506_public_basemap

    def _i506_result(message='', imported=None, errors=None, **extra):
        custom=_i505_public_custom_basemaps()
        result={'ok':not bool(errors and not imported),'version':'i506','message':message,'imported':imported or [],'errors':errors or [],'custom_basemaps':custom,'basemaps':tak_map_config().get('basemaps') or [],'storage':str(TAK_MAP_CUSTOM_BASEMAPS_FILE)}
        result.update(extra)
        return result
    _i505_custom_basemap_result = _i506_result

    def _i506_fetch_gateway_json(url):
        req=_i505_urlreq.Request(url,headers={'Accept':'application/json','User-Agent':'TAK-Map/1.3.0-i506 Gateway-Basemap-Catalog'})
        with _i505_urlreq.urlopen(req,timeout=TAK_MAP_GATEWAY_BASEMAP_TIMEOUT) as resp:
            body=resp.read(TAK_MAP_GATEWAY_CATALOG_LIMIT+1)
            if len(body)>TAK_MAP_GATEWAY_CATALOG_LIMIT:
                raise ValueError('Gateway basemap catalog exceeds the configured size limit.')
            return json.loads(body.decode('utf-8','replace') or '{}')

    def _i506_catalog_rows(payload):
        if isinstance(payload,list): return payload
        if not isinstance(payload,dict): return []
        for key in ('basemaps','items','rows','sources','catalog','maps'):
            rows=payload.get(key)
            if isinstance(rows,list): return rows
        return []

    def _i506_catalog_candidates(base,payload):
        out=[];seen=set();base_parsed=urlparse(base)
        for raw in _i506_catalog_rows(payload):
            if isinstance(raw,str):
                row={'id':raw,'name':raw}
            elif isinstance(raw,dict):
                row=raw
            else:
                continue
            bid=str(row.get('id') or row.get('basemap_id') or row.get('xml_id') or row.get('slug') or '').strip()
            name=str(row.get('name') or row.get('label') or row.get('title') or bid).strip()
            group=str(row.get('group') or row.get('category') or row.get('type') or '').strip()
            hay=(bid+' '+name+' '+group).lower()
            if not (bid.lower().startswith('tg-') or name.lower().startswith('tg-') or 'composite' in hay or any(p in hay for p in ('rainviewer','imerg','goes-18','goes18','goes-19','goes19'))):
                continue
            xml_ref=str(row.get('xml_url') or row.get('xmlUrl') or row.get('href') or row.get('url') or '').strip()
            if xml_ref:
                xml_url=_i506_urljoin(base.rstrip('/')+'/',xml_ref)
                parsed=urlparse(xml_url)
                if parsed.hostname!=base_parsed.hostname or parsed.port!=base_parsed.port:
                    xml_url=''
            else:
                xml_url=''
            if not xml_url and bid:
                xml_url=base.rstrip('/')+'/basemaps/xml/'+quote(bid,safe='')+'.xml'
            if not bid or not xml_url or bid in seen: continue
            seen.add(bid);out.append({'id':bid,'name':name,'xml_url':xml_url,'group':group})
        return out

    def _i506_parse_gateway_xml(blob,xml_id,xml_url='',catalog_source='fallback'):
        item=_i505_parse_basemap_xml(blob,xml_id+'.xml','tak-gateway')
        item['gateway_catalog_id']=str(xml_id or '')[:160]
        item['gateway_catalog_source']=str(catalog_source or '')[:200]
        item['gateway_xml_url']=str(xml_url or '')[:500]
        item['management_source']=_i506_management_source(item)
        return item

    def _i506_import_gateway_basemaps():
        base=_i505_gateway_asset_base()
        if not base:
            return {'ok':False,'version':'i506','error':'TAK Gateway basemap address is not configured. Set TAK_MAP_GATEWAY_BASEMAP_URL or configure the existing Gateway Replay address.'}
        imported=[];warnings=[];catalog_source='';catalog_entries=0;attempted_ids=[]
        imported_hashes=set();families=set()

        for path in _I506_GATEWAY_CATALOG_PATHS:
            url=base.rstrip('/')+path
            try:
                payload=_i506_fetch_gateway_json(url)
                candidates=_i506_catalog_candidates(base,payload)
                if not candidates:
                    continue
                catalog_source=url;catalog_entries=len(candidates)
                for candidate in candidates:
                    bid=candidate['id'];attempted_ids.append(bid)
                    try:
                        item=_i506_parse_gateway_xml(_i505_fetch_gateway_xml(candidate['xml_url']),bid,candidate['xml_url'],url)
                        if item['id'] not in imported_hashes:
                            imported_hashes.add(item['id']);imported.append(item)
                        family=_i506_gateway_family(bid,candidate.get('name'),item.get('label'),item.get('upstream_url'))
                        if family: families.add(family)
                    except Exception as exc:
                        warnings.append({'id':bid,'url':candidate['xml_url'],'error':str(exc)[:240]})
                break
            except Exception:
                continue

        for family,aliases in _I506_GATEWAY_FALLBACK_GROUPS:
            if family in families: continue
            last_error=''
            for bid in aliases:
                if bid in attempted_ids: continue
                attempted_ids.append(bid)
                url=base.rstrip('/')+'/basemaps/xml/'+quote(bid,safe='')+'.xml'
                try:
                    item=_i506_parse_gateway_xml(_i505_fetch_gateway_xml(url),bid,url,'known-id-fallback')
                    if item['id'] not in imported_hashes:
                        imported_hashes.add(item['id']);imported.append(item)
                    families.add(family);last_error='';break
                except Exception as exc:
                    last_error=str(exc)[:240]
            if last_error:
                warnings.append({'family':family,'error':'No hosted XML was found for this composite family.'})

        if imported:
            _i505_upsert_custom_basemaps(imported)
        unavailable=sum(1 for w in warnings if w.get('family'))
        message='Imported or refreshed '+str(len(imported))+' TAK Gateway composite basemap(s).'
        if unavailable:
            message+=' '+str(unavailable)+' known composite family/families were unavailable on this Gateway.'
        result=_i506_result(message,imported,[] if imported else warnings,
            warnings=warnings if imported else [],gateway_base_url=base,catalog_source=catalog_source,
            catalog_entries=catalog_entries,attempted_ids=attempted_ids,composite_families=sorted(families))
        if not imported:
            result['ok']=False;result['error']='Could not import any TAK Gateway composite basemap XMLs.'
        return result
    _i505_import_gateway_basemaps = _i506_import_gateway_basemaps

    def _i506_bulk_delete(scope):
        scope=str(scope or '').strip().lower()
        rows=_i505_load_custom_basemaps()
        if scope in ('gateway','tak-gateway','composite'):
            removed=[x for x in rows if str(x.get('source_kind') or '')=='tak-gateway']
            kept=[x for x in rows if str(x.get('source_kind') or '')!='tak-gateway']
            label='TAK Gateway composite import'
        elif scope in ('custom','manual','xml'):
            removed=[x for x in rows if str(x.get('source_kind') or '')!='tak-gateway']
            kept=[x for x in rows if str(x.get('source_kind') or '')=='tak-gateway']
            label='custom XML basemap'
        elif scope in ('all',''):
            removed=rows;kept=[];label='imported basemap'
        else:
            return {'ok':False,'version':'i506','error':'Unknown basemap removal scope.'}
        _i506_save_custom_basemaps(kept)
        count=len(removed)
        return _i506_result('Removed '+str(count)+' '+label+('s' if count!=1 else '')+'.',removed=[],errors=[],removed_ids=[str(x.get('id') or '') for x in removed],removed_count=count,scope=scope or 'all')

    _i506_prev_config=tak_map_config
    def tak_map_config():
        cfg=_i506_prev_config()
        if not isinstance(cfg,dict): return cfg
        cfg=dict(cfg);cfg['tak_map_iteration']='i506'
        meta=dict(cfg.get('composite_basemaps') or {})
        meta.update({
            'version':'i506','gateway_import_mode':'catalog-first-with-known-id-fallback',
            'gateway_catalog_paths':list(_I506_GATEWAY_CATALOG_PATHS),
            'gateway_composite_families':['NOAA Radar','RainViewer','NASA IMERG','GOES-18 Pacific','GOES-19 Atlantic'],
            'gateway_street_and_imagery_variants':True,'future_catalog_additions_auto_discovered':True,
            'management_dialog':True,'inline_management_rows':False,'search_and_grouped_removal':True,
            'bulk_remove_with_confirmation':True,'active_basemap_fallback':True,
        })
        cfg['composite_basemaps']=meta
        cfg['basemap_management']={
            'version':'i506','dialog':'tak-map-themed','groups':['TAK Gateway Composite','Custom XML'],
            'search':True,'individual_remove':True,'bulk_remove':True,'refresh_gateway_catalog':True,
            'card_summary_only':True,'active_basemap_fallback':True,
        }
        cfg['usgs_shaded_relief_control']={
            'version':'i506','control':'themed-push-button','off_color':'dark-gray','on_color':'silver',
            'aria_pressed':True,'existing_layer_functionality_preserved':True,'opacity_slider_preserved':True,
        }
        return cfg
    globals()['tak_map_config']=tak_map_config

    _i506_prev_post=Handler.do_POST
    def _i506_post(self):
        parsed=urlparse(self.path)
        if parsed.path=='/api/tak-map/custom-basemap-bulk-delete':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            payload=_read_json_body(self)
            result=_i506_bulk_delete(payload.get('scope'))
            return self._send_json(result,200 if result.get('ok') else 400)
        return _i506_prev_post(self)
    Handler.do_POST=_i506_post

    _I506_BASEMAP_UI=r'''<style id="takMapBasemapManagementStyleV506">
#customBasemapRowsV505{display:none!important}.basemap-button-row:has(#customBasemapRowsV505){grid-template-columns:repeat(2,minmax(0,1fr))!important}.tak-basemap-summary-v506{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 8px;border:1px solid rgba(255,255,255,.08);border-radius:9px;background:#0c141b}.tak-basemap-summary-v506 b{display:block;color:#d7e1e5;font-size:.62rem}.tak-basemap-summary-v506 small{display:block;margin-top:2px;color:#72838d;font-size:.51rem}.tak-basemap-summary-v506 button{border:0;background:transparent;color:#ffad87;font-size:.56rem;font-weight:950;cursor:pointer}.tak-relief-controls-v506{display:grid!important;grid-template-columns:1fr!important;gap:6px!important;align-items:stretch!important}.tak-relief-toggle-v506{width:100%;min-height:31px;border:1px solid #354754;border-radius:9px;background:linear-gradient(180deg,#202b33,#111920);color:#b8c5cb;font-size:.66rem;font-weight:950;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.035)}.tak-relief-toggle-v506[aria-pressed="true"]{border-color:rgba(226,234,238,.62);background:linear-gradient(180deg,#dce4e8,#aeb9c0);color:#172129;box-shadow:inset 0 1px 0 rgba(255,255,255,.75),0 2px 9px rgba(0,0,0,.25);text-shadow:0 1px 0 rgba(255,255,255,.45)}#reliefOverlayToggle{display:none!important}.tak-relief-controls-v506 .tak-relief-slider-row-v442{width:100%!important}
