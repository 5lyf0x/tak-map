    def _i465_patch_html(html):
        if not isinstance(html,str):return html
        for old,new in (('runtime-loader-v464','runtime-loader-v465'),('tak-map-adsb-v464.js','tak-map-adsb-v465.js'),
                        ('TakMapAdsbWorkerV464','TakMapAdsbWorkerV465'),('__TakMapRuntimeV464','__TakMapRuntimeV465'),
