4;font-size:.56rem;font-weight:950;cursor:pointer;white-space:nowrap}.tak-bm-tool-v506.danger{border-color:rgba(239,81,77,.35);color:#ffaaa5;background:rgba(239,81,77,.08)}.tak-bm-bulk-v506{position:absolute;right:0;top:40px;z-index:3;width:225px;display:none;padding:6px;border:1px solid rgba(255,255,255,.14);border-radius:10px;background:#091118;box-shadow:0 15px 34px rgba(0,0,0,.52)}.tak-bm-bulk-v506.open{display:grid;gap:5px}.tak-bm-bulk-v506 button{min-height:34px;padding:7px 9px;border:1px solid rgba(255,255,255,.08);border-radius:8px;background:#111a22;color:#cbd6db;text-align:left;font-size:.54rem;font-weight:900;cursor:pointer}.tak-bm-body-v506{min-height:0;overflow:auto;padding:10px 12px 13px;scrollbar-width:thin;scrollbar-color:rgba(255,111,46,.48) transparent}.tak-bm-section-v506{margin-bottom:12px}.tak-bm-section-head-v506{display:flex;justify-content:space-between;gap:8px;margin-bottom:6px;padding:0 2px;color:#98a9b1;font-size:.56rem;font-weight:950;letter-spacing:.07em;text-transform:uppercase}.tak-bm-rows-v506{display:grid;gap:6px}.tak-bm-row-v506{min-height:52px;display:grid;grid-template-columns:minmax(0,1fr) 118px 80px 34px;align-items:center;gap:8px;padding:7px 8px 7px 10px;border:1px solid rgba(255,255,255,.085);border-radius:10px;background:#101820}.tak-bm-row-v506.active{border-color:rgba(255,111,46,.46);box-shadow:inset 3px 0 0 #ff6f2e}.tak-bm-name-v506{min-width:0}.tak-bm-name-v506 b,.tak-bm-name-v506 small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tak-bm-name-v506 b{color:#dce5e9;font-size:.62rem}.tak-bm-name-v506 small{margin-top:2px;color:#71838d;font-size:.51rem}.tak-bm-source-v506{display:inline-block;padding:3px 6px;border:1px solid rgba(75,177,255,.28);border-radius:999px;background:#0b141b;color:#a9d9ff;font-size:.51rem;font-weight:850;white-space:nowrap}.tak-bm-source-v506.custom{border-color:rgba(185,132,255,.28);color:#d2b9ff}.tak-bm-zoom-v506{color:#9baab2;font-size:.51rem;font-weight:850}.tak-bm-remove-v506{width:29px;height:29px;display:grid;place-items:center;border:1px solid rgba(239,81,77,.34);border-radius:8px;background:rgba(239,81,77,.09);color:#ff8781;font-size:15px;font-weight:950;cursor:pointer}.tak-bm-empty-v506{display:none;padding:24px 16px;text-align:center;border:1px dashed rgba(255,255,255,.12);border-radius:10px;color:#73858e;font-size:.62rem}.tak-bm-empty-v506.show{display:block}.tak-bm-foot-v506{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 12px;border-top:1px solid rgba(255,255,255,.085);color:#73858e;background:rgba(255,255,255,.015);font-size:.52rem}.tak-bm-done-v506{height:31px;min-width:90px;border:1px solid rgba(226,234,238,.55);border-radius:9px;background:linear-gradient(180deg,#dce4e8,#aeb9c0);color:#162029;font-size:.56rem;font-weight:950;cursor:pointer}.tak-bm-confirm-v506{position:absolute;inset:0;z-index:5;display:none;place-items:center;padding:18px;background:rgba(0,0,0,.62)}.tak-bm-confirm-v506.open{display:grid}.tak-bm-confirm-card-v506{width:min(410px,calc(100% - 24px));padding:14px;border:1px solid rgba(255,255,255,.15);border-radius:12px;background:#0a1219;box-shadow:0 18px 45px rgba(0,0,0,.55)}.tak-bm-confirm-card-v506 h4{margin:0;color:#eef3f5;font-size:.7rem}.tak-bm-confirm-card-v506 p{margin:8px 0 13px;color:#8ea0a9;font-size:.58rem;line-height:1.45}.tak-bm-confirm-actions-v506{display:flex;justify-content:flex-end;gap:7px}.tak-bm-confirm-actions-v506 button{height:31px;padding:0 12px;border-radius:8px;font-size:.56rem;font-weight:950;cursor:pointer}.tak-bm-cancel-v506{border:1px solid #3b4e5a;background:#14212a;color:#d4dde1}.tak-bm-approve-v506{border:1px solid rgba(239,81,77,.58);background:rgba(239,81,77,.14);color:#ffaaa5}@media(max-width:720px){.tak-bm-toolbar-v506{grid-template-columns:1fr}.tak-bm-actions-v506{display:grid;grid-template-columns:1fr 1fr}.tak-bm-row-v506{grid-template-columns:minmax(0,1fr) 80px 34px}.tak-bm-source-v506{display:none}}
</style>
<div id="basemapManagerBackdropV506" class="tak-basemap-manager-backdrop-v506" aria-hidden="true"><section class="tak-basemap-manager-v506" role="dialog" aria-modal="true" aria-labelledby="basemapManagerTitleV506"><header class="tak-bm-head-v506"><div class="tak-bm-title-v506"><span class="dot"></span><b id="basemapManagerTitleV506">Manage Basemaps</b><span id="basemapManagerCountV506" class="tak-bm-count-v506">0 IMPORTED</span></div><button id="basemapManagerCloseV506" class="tak-bm-close-v506" type="button" aria-label="Close">×</button></header><div class="tak-bm-toolbar-v506"><input id="basemapManagerSearchV506" class="tak-bm-search-v506" placeholder="Search imported basemaps…" autocomplete="off"><div class="tak-bm-actions-v506"><button id="basemapManagerRefreshV506" class="tak-bm-tool-v506" type="button">Refresh Gateway Catalog</button><button id="basemapManagerBulkV506" class="tak-bm-tool-v506 danger" type="button">Bulk Remove ▾</button><div id="basemapManagerBulkMenuV506" class="tak-bm-bulk-v506"><button type="button" data-scope="gateway">Remove All Gateway Imports</button><button type="button" data-scope="custom">Remove All Custom XML</button></div></div></div><div class="tak-bm-body-v506"><section id="basemapGatewaySectionV506" class="tak-bm-section-v506"><div class="tak-bm-section-head-v506"><span>TAK Gateway Composite</span><span id="basemapGatewayCountV506">0 basemaps</span></div><div id="basemapGatewayRowsV506" class="tak-bm-rows-v506"></div></section><section id="basemapCustomSectionV506" class="tak-bm-section-v506"><div class="tak-bm-section-head-v506"><span>Custom XML</span><span id="basemapCustomCountV506">0 basemaps</span></div><div id="basemapCustomRowsV506" class="tak-bm-rows-v506"></div></section><div id="basemapManagerEmptyV506" class="tak-bm-empty-v506">No imported basemaps match this search.</div></div><footer class="tak-bm-foot-v506"><span id="basemapManagerFootV506">Imported definitions are stored on the TAK Map server.</span><button id="basemapManagerDoneV506" class="tak-bm-done-v506" type="button">Done</button></footer><div id="basemapManagerConfirmV506" class="tak-bm-confirm-v506"><div class="tak-bm-confirm-card-v506"><h4 id="basemapConfirmTitleV506">Remove basemap?</h4><p id="basemapConfirmTextV506"></p><div class="tak-bm-confirm-actions-v506"><button id="basemapConfirmCancelV506" class="tak-bm-cancel-v506" type="button">Cancel</button><button id="basemapConfirmApproveV506" class="tak-bm-approve-v506" type="button">Remove</button></div></div></div></section></div>
<script id="takMapBasemapManagementV506">
(function(w,d){'use strict';const V='i506',$=id=>d.getElementById(id);let busy=false,pending=null,wrapped=false;function cfg(){try{return (typeof config!=='undefined'&&config)||w.config||{}}catch(_){return w.config||{}}}function active(){try{return (typeof activeBasemap!=='undefined'&&activeBasemap)||w.activeBasemap||''}catch(_){return w.activeBasemap||''}}function imported(){return (cfg().basemaps||[]).filter(b=>b&&b.importedBasemap)}function groups(){const rows=imported();return {gateway:rows.filter(b=>b.managementType==='gateway'||b.source_kind==='tak-gateway'||b.group==='TAK Gateway Composite'),custom:rows.filter(b=>!(b.managementType==='gateway'||b.source_kind==='tak-gateway'||b.group==='TAK Gateway Composite'))}}function setStatus(msg,ok){const el=$('customBasemapStatus');if(el){el.textContent=String(msg||'');el.classList.toggle('danger',ok===false)}const foot=$('basemapManagerFootV506');if(foot&&msg)foot.textContent=String(msg)}function fallbackId(){const rows=(cfg().basemaps||[]).filter(b=>b&&!b.importedBasemap);for(const id of ['esri_topo','osm','openstreetmap','esri_street','esri_imagery'])if(rows.some(b=>b.id===id))return id;const def=String(cfg().default_basemap||'');if(rows.some(b=>b.id===def))return def;return rows[0]&&rows[0].id||''}function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function syncSummary(){const g=groups(),total=g.gateway.length+g.custom.length;const main=$('basemapSummaryMainV506'),sub=$('basemapSummarySubV506');if(main)main.textContent=total+' imported basemap'+(total===1?'':'s');if(sub)sub.textContent=g.gateway.length+' TAK Gateway Composite · '+g.custom.length+' Custom XML';const chip=$('basemapManagerCountV506');if(chip)chip.textContent=total+' IMPORTED';const gc=$('basemapGatewayCountV506');if(gc)gc.textContent=g.gateway.length+' basemap'+(g.gateway.length===1?'':'s');const cc=$('basemapCustomCountV506');if(cc)cc.textContent=g.custom.length+' basemap'+(g.custom.length===1?'':'s')}function row(b,type){const r=d.createElement('div');r.className='tak-bm-row-v506'+(active()===b.id?' active':'');r.dataset.search=(String(b.label||'')+' '+String(b.managementSource||'')+' '+String(b.group||'')).toLowerCase();const name=d.createElement('div');name.className='tak-bm-name-v506';name.innerHTML='<b>'+esc(b.label||b.id||'Imported basemap')+'</b><small>'+esc((type==='gateway'?'TAK Gateway Composite':'Custom XML')+' · z'+Number(b.minZoom||0)+'–'+Number(b.maxZoom||19))+'</small>';const source=d.createElement('span');source.className='tak-bm-source-v506'+(type==='custom'?' custom':'');source.textContent=b.managementSource||(type==='gateway'?'TAK Gateway':'Custom XML');const zoom=d.createElement('span');zoom.className='tak-bm-zoom-v506';zoom.textContent='z'+Number(b.minZoom||0)+'–'+Number(b.maxZoom||19);const del=d.createElement('button');del.type='button';del.className='tak-bm-remove-v506';del.textContent='×';del.title='Remove '+String(b.label||'basemap');del.setAttribute('aria-label',del.title);del.onclick=()=>confirmRemove([b.id],'Remove basemap?','Remove “'+String(b.label||b.id)+'” from TAK Map? This removes the saved definition only and does not alter TAK Gateway.','single');r.append(name,source,zoom,del);return r}function applySearch(){const q=String($('basemapManagerSearchV506')?.value||'').trim().toLowerCase();let visible=0;for(const r of d.querySelectorAll('.tak-bm-row-v506')){const show=!q||r.dataset.search.includes(q);r.style.display=show?'grid':'none';if(show)visible++}for(const pair of [['basemapGatewaySectionV506','basemapGatewayRowsV506'],['basemapCustomSectionV506','basemapCustomRowsV506']]){const sec=$(pair[0]),host=$(pair[1]);if(sec&&host)sec.style.display=[...host.children].some(x=>x.style.display!=='none')?'block':'none'}$('basemapManagerEmptyV506')?.classList.toggle('show',visible===0)}function render(){syncSummary();const g=groups(),gh=$('basemapGatewayRowsV506'),ch=$('basemapCustomRowsV506');if(gh){gh.innerHTML='';g.gateway.forEach(b=>gh.appendChild(row(b,'gateway')))}if(ch){ch.innerHTML='';g.custom.forEach(b=>ch.appendChild(row(b,'custom')))}applySearch()}async function parseResponse(resp){let j={};try{j=await resp.json()}catch(_){throw new Error('Basemap service returned an invalid response.')}if(!resp.ok||!j.ok)throw new Error(j.error||((j.errors||[])[0]&&j.errors[0].error)||('HTTP '+resp.status));if(Array.isArray(j.basemaps)){try{if(typeof config!=='undefined'&&config)config.basemaps=j.basemaps}catch(_){}w.config=cfg();w.config.basemaps=j.basemaps}try{w.renderBasemaps&&w.renderBasemaps()}catch(_){}render();setStatus(j.message||'Basemaps updated.',true);return j}async function request(url,opt,removedIds){if(busy)return;busy=true;const oldActive=active();try{const j=await parseResponse(await fetch(url,Object.assign({credentials:'same-origin'},opt||{})));if((removedIds||[]).includes(oldActive)){const fb=fallbackId();if(fb&&w.setBasemap)w.setBasemap(fb)}return j}catch(e){setStatus(String(e.message||e),false);throw e}finally{busy=false}}async function importGateway(){setStatus('Refreshing TAK Gateway composite catalog…',true);try{return await request('/api/tak-map/custom-basemap-import-gateway',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'})}catch(_){}}async function upload(){const input=$('basemapXmlInput'),files=[...(input&&input.files||[])];if(!files.length||busy)return;const fd=new FormData();files.forEach(f=>fd.append('files',f,f.name));setStatus('Importing basemap XML…',true);try{await request('/api/tak-map/custom-basemap-upload',{method:'POST',body:fd});input.value=''}catch(_){}}async function refreshDefinitions(){try{await request('/api/tak-map/custom-basemaps',{method:'GET'})}catch(_){}}function confirmRemove(ids,title,text,scope){pending={ids:ids||[],scope:scope||''};$('basemapConfirmTitleV506').textContent=title;$('basemapConfirmTextV506').textContent=text;$('basemapConfirmApproveV506').textContent=(scope==='single'?'Remove':'Remove All');$('basemapManagerConfirmV506').classList.add('open')}async function approve(){if(!pending)return;const p=pending;pending=null;$('basemapManagerConfirmV506').classList.remove('open');try{if(p.scope==='single')await request('/api/tak-map/custom-basemap-delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:p.ids[0]})},p.ids);else await request('/api/tak-map/custom-basemap-bulk-delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({scope:p.scope})},p.ids)}catch(_){}}function open(){const el=$('basemapManagerBackdropV506');if(!el)return;el.classList.add('open');el.setAttribute('aria-hidden','false');$('basemapManagerSearchV506').value='';render();refreshDefinitions();setTimeout(()=>$('basemapManagerSearchV506')?.focus(),40)}function close(){const el=$('basemapManagerBackdropV506');if(el){el.classList.remove('open');el.setAttribute('aria-hidden','true')}$('basemapManagerBulkMenuV506')?.classList.remove('open');$('basemapManagerConfirmV506')?.classList.remove('open');pending=null}function installRelief(){const cb=$('reliefOverlayToggle'),btn=$('reliefOverlayButtonV506');if(!cb||!btn)return;function sync(){const on=!!cb.checked;btn.setAttribute('aria-pressed',on?'true':'false');btn.title=on?'USGS Shaded Relief is on':'USGS Shaded Relief is off'}w.toggleReliefButtonV506=function(){const on=!cb.checked;cb.checked=on;try{w.toggleReliefOverlay(on)}catch(_){try{toggleReliefOverlay(on)}catch(__){}}sync()};if(!w.__takReliefWrappedV506&&typeof w.toggleReliefOverlay==='function'){w.__takReliefWrappedV506=true;const old=w.toggleReliefOverlay;const wrap=function(on){const out=old.call(this,on);cb.checked=!!on;sync();return out};w.toggleReliefOverlay=wrap;try{toggleReliefOverlay=wrap}catch(_){}}sync()}function install(){if(!wrapped&&typeof w.renderBasemaps==='function'){wrapped=true;const old=w.renderBasemaps;w.renderBasemaps=function(){const out=old.apply(this,arguments);render();return out};try{renderBasemaps=w.renderBasemaps}catch(_){}}w.importBasemapXmlFiles=upload;w.importTakGatewayBasemapsV506=importGateway;w.importTakGatewayBasemapsV505=importGateway;w.openBasemapManagerV506=open;const input=$('basemapXmlInput');if(input)input.onchange=upload;$('basemapManagerCloseV506').onclick=close;$('basemapManagerDoneV506').onclick=close;$('basemapManagerSearchV506').oninput=applySearch;$('basemapManagerRefreshV506').onclick=importGateway;$('basemapManagerBulkV506').onclick=e=>{e.stopPropagation();$('basemapManagerBulkMenuV506').classList.toggle('open')};$('basemapManagerBulkMenuV506').onclick=e=>{const b=e.target.closest('[data-scope]');if(!b)return;const scope=b.dataset.scope,g=groups(),ids=(scope==='gateway'?g.gateway:g.custom).map(x=>x.id);$('basemapManagerBulkMenuV506').classList.remove('open');if(!ids.length){setStatus('No '+(scope==='gateway'?'Gateway imports':'custom XML basemaps')+' to remove.',true);return}confirmRemove(ids,'Remove all '+(scope==='gateway'?'Gateway imports':'Custom XML basemaps')+'?','This removes '+ids.length+' saved definition'+(ids.length===1?'':'s')+' from TAK Map. Hosted Gateway XMLs and tiles are not deleted.',scope)};$('basemapConfirmCancelV506').onclick=()=>{$('basemapManagerConfirmV506').classList.remove('open');pending=null};$('basemapConfirmApproveV506').onclick=approve;$('basemapManagerBackdropV506').onclick=e=>{if(e.target===$('basemapManagerBackdropV506'))close()};d.addEventListener('click',e=>{if(!e.target.closest('.tak-bm-actions-v506'))$('basemapManagerBulkMenuV506')?.classList.remove('open')});d.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('basemapManagerBackdropV506')?.classList.contains('open'))close()});installRelief();render()}w.TakMapBasemapManagementV506=Object.freeze({version:V,install,open,render,importGateway,diagnostics:()=>({version:V,imported:imported().length,manager:true,inlineRows:false,reliefButton:true,catalogFirst:true,clientComposition:false,localTileCache:false})});if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',install,{once:true});else install();[250,800,1800].forEach(ms=>setTimeout(install,ms));
})(window,document);
</script>'''

    def _i506_patch_html(html):
        if not isinstance(html,str): return html
        html=html.replace('1.3.0-i505','1.3.0-i506').replace('TAKDashboard/i505','TAKDashboard/i506').replace('TAK-Map/1.3.0 i505','TAK-Map/1.3.0 i506')
        html=_i491_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i506\2',html)
        old_relief='<div class="relief-controls"><label><input type="checkbox" id="reliefOverlayToggle" onchange="toggleReliefOverlay(this.checked)"> USGS Shaded Relief</label><input id="reliefOpacity" type="range" min="0" max="100" value="35" oninput="setReliefOpacity(this.value)"></div>'
        new_relief='<div class="relief-controls tak-relief-controls-v506"><input type="checkbox" id="reliefOverlayToggle" aria-hidden="true"><button id="reliefOverlayButtonV506" class="tak-relief-toggle-v506" type="button" aria-pressed="false" onclick="toggleReliefButtonV506()">USGS Shaded Relief</button><input id="reliefOpacity" type="range" min="0" max="100" value="35" oninput="setReliefOpacity(this.value)"></div>'
        if old_relief in html: html=html.replace(old_relief,new_relief,1)
        old_buttons='<button class="layer-button" onclick="triggerBasemapXmlImport()">Add Basemap</button><button class="layer-button" onclick="importTakGatewayBasemapsV505()">Import Gateway</button><button class="layer-button" onclick="clearCustomBasemaps()">Clear Custom</button>'
        new_buttons='<button class="layer-button" onclick="triggerBasemapXmlImport()">Add Basemap</button><button class="layer-button" onclick="importTakGatewayBasemapsV506()">Import Gateway</button><button class="layer-button" onclick="openBasemapManagerV506()">Manage Basemaps</button>'
        if old_buttons in html: html=html.replace(old_buttons,new_buttons,1)
        rows='<div id="customBasemapRowsV505"></div>'
        summary='<div id="basemapSummaryV506" class="tak-basemap-summary-v506"><div><b id="basemapSummaryMainV506">0 imported basemaps</b><small id="basemapSummarySubV506">0 TAK Gateway Composite · 0 Custom XML</small></div><button type="button" onclick="openBasemapManagerV506()">Manage</button></div>'+rows
        if 'id="basemapSummaryV506"' not in html and rows in html: html=html.replace(rows,summary,1)
        if 'id="takMapBasemapManagementV506"' not in html: html=html.replace('</body></html>',_I506_BASEMAP_UI+'</body></html>')
        return html

    TAK_MAP_HTML=_i506_patch_html(TAK_MAP_HTML);INDEX_HTML=TAK_MAP_HTML
except Exception as _i506_exc:
    try: print('TAK Map i506 basemap manager/catalog patch failed:',_i506_exc)
    except Exception: pass
# --- end TAK Map i506 catalog-driven composite basemaps and compact manager ---

# --- TAK Map i507 direct TAK Gateway HTTPS basemap delivery and service enrollment ---
try:
    import ssl as _i507_ssl

    TAK_MAP_GATEWAY_CA_CERT = str(os.environ.get('TAK_MAP_GATEWAY_CA_CERT', os.environ.get('TAK_MAP_REPLAY_CA_CERT','/etc/tak-map/gateway-ca.crt')) or '').strip()
    TAK_MAP_GATEWAY_DIRECT_BASEMAPS = str(os.environ.get('TAK_MAP_GATEWAY_DIRECT_BASEMAPS','false') or 'false').strip().lower() not in ('0','false','no','off')
    TAK_MAP_GATEWAY_BASEMAP_CATALOG_URL = str(os.environ.get('TAK_MAP_GATEWAY_BASEMAP_CATALOG_URL','') or '').strip()

    def _i507_gateway_public_ssl_context():
        ca = Path(TAK_MAP_GATEWAY_CA_CERT)
        if ca.is_file():
            return _i507_ssl.create_default_context(cafile=str(ca))
        return _i507_ssl.create_default_context()

    def _i507_save_custom_basemaps(rows):
        TAK_MAP_OFFLINE_DIR.mkdir(parents=True, exist_ok=True)
        final=list(rows or [])[-TAK_MAP_CUSTOM_BASEMAP_LIMIT:]
        atomic_write_json(TAK_MAP_CUSTOM_BASEMAPS_FILE, {
            'version':'i507',
            'basemaps':final,
            'updated':datetime.now(timezone.utc).isoformat(),
        })
        return final
    globals()['_i505_save_custom_basemaps'] = _i507_save_custom_basemaps
    globals()['_i506_save_custom_basemaps'] = _i507_save_custom_basemaps

    def _i507_result(message='', imported=None, errors=None, **extra):
        custom=_i505_public_custom_basemaps()
        result={
            'ok':not bool(errors and not imported),
            'version':'i507',
            'message':message,
            'imported':imported or [],
            'errors':errors or [],
            'custom_basemaps':custom,
            'basemaps':tak_map_config().get('basemaps') or [],
            'storage':str(TAK_MAP_CUSTOM_BASEMAPS_FILE),
        }
        result.update(extra)
        return result
    globals()['_i506_result'] = _i507_result
    globals()['_i505_custom_basemap_result'] = _i507_result

    def _i507_direct_gateway_url(upstream):
        value = _i505_normalize_template(upstream)
        if not TAK_MAP_GATEWAY_DIRECT_BASEMAPS:
            return value
        base = _i505_gateway_asset_base().rstrip('/')
        if not base:
            return value
        parsed = urlparse(value)
        path = parsed.path or ''
        # Gateway XML generated before i158 may still contain the legacy
        # http://gateway:8090 origin. Preserve only the tile path/query and move
        # it to the enrolled secure Gateway origin.
        if path.startswith('/tiles/') or path.startswith('/basemaps/'):
            return base + path + (('?' + parsed.query) if parsed.query else '')
        return value

    _i507_prev_public_basemap = _i505_public_basemap
    def _i505_public_basemap(row):
        source_kind = str((row or {}).get('source_kind') or '').strip().lower()
        if source_kind != 'tak-gateway' or not TAK_MAP_GATEWAY_DIRECT_BASEMAPS:
            return _i507_prev_public_basemap(row)
        # Start with the i506 public representation so management grouping,
        # IDs, labels, zooms, opacity, and import metadata remain unchanged.
        item = _i507_prev_public_basemap(row)
        direct = _i507_direct_gateway_url((row or {}).get('upstream_url') or '')
        item['url'] = direct
        item['directGateway'] = True
        item['directBrowserRequest'] = True
        item['clientCertificateRequired'] = False
        item['serverCertificateTrustRequired'] = True
        item['proxy_mode'] = 'direct-browser-to-tak-gateway-https'
        return item
    globals()['_i505_public_basemap'] = _i505_public_basemap

    def _i505_fetch_gateway_xml(url):
        req=_i505_urlreq.Request(url,headers={'Accept':'application/xml,text/xml','User-Agent':'TAK-Map/1.3.0-i507 Gateway-Basemap-Import'})
        with _i505_urlreq.urlopen(req,context=_i507_gateway_public_ssl_context(),timeout=TAK_MAP_GATEWAY_BASEMAP_TIMEOUT) as resp:
            body=resp.read(TAK_MAP_CUSTOM_BASEMAP_XML_LIMIT+1)
            if len(body)>TAK_MAP_CUSTOM_BASEMAP_XML_LIMIT:
                raise ValueError('Gateway basemap XML exceeds the configured size limit.')
            return body
    globals()['_i505_fetch_gateway_xml'] = _i505_fetch_gateway_xml

    def _i506_fetch_gateway_json(url):
        req=_i505_urlreq.Request(url,headers={'Accept':'application/json','User-Agent':'TAK-Map/1.3.0-i507 Gateway-Basemap-Catalog'})
        with _i505_urlreq.urlopen(req,context=_i507_gateway_public_ssl_context(),timeout=TAK_MAP_GATEWAY_BASEMAP_TIMEOUT) as resp:
            body=resp.read(TAK_MAP_GATEWAY_CATALOG_LIMIT+1)
            if len(body)>TAK_MAP_GATEWAY_CATALOG_LIMIT:
                raise ValueError('Gateway basemap catalog exceeds the configured size limit.')
            return json.loads(body.decode('utf-8','replace') or '{}')
    globals()['_i506_fetch_gateway_json'] = _i506_fetch_gateway_json

    _i507_prev_config = tak_map_config
    def tak_map_config():
        cfg = _i507_prev_config()
        if not isinstance(cfg,dict): return cfg
        cfg = dict(cfg)
        cfg['tak_map_iteration'] = 'i507'
        meta = dict(cfg.get('composite_basemaps') or {})
        meta.update({
            'version':'i507',
            'gateway_base_url':_i505_gateway_asset_base(),
            'gateway_catalog_url':TAK_MAP_GATEWAY_BASEMAP_CATALOG_URL or (_i505_gateway_asset_base().rstrip('/')+'/basemaps/catalog' if _i505_gateway_asset_base() else ''),
            'delivery_path':'browser-direct-to-tak-gateway' if TAK_MAP_GATEWAY_DIRECT_BASEMAPS else 'tak-map-python-compatibility-proxy',
            'direct_browser_requests':bool(TAK_MAP_GATEWAY_DIRECT_BASEMAPS),
            'tak_map_python_tile_proxy_for_gateway':not bool(TAK_MAP_GATEWAY_DIRECT_BASEMAPS),
            'tak_map_nginx_tile_relay_for_gateway':False,
            'browser_client_certificate_required':False,
            'gateway_server_certificate_trust_required':True,
            'manual_custom_xml_proxy_preserved':True,
            'service_identity_role':'tak-map-service',
            'future_capability_manifest':True,
            'proxy_mode':'direct-browser-to-tak-gateway-https' if TAK_MAP_GATEWAY_DIRECT_BASEMAPS else 'single-upstream-request-byte-forward-no-local-cache',
            'single_upstream_tile_request':True,
            'client_side_composition':False,
            'additional_gateway_composition':False,
            'tak_map_tile_cache':False,
        })
        cfg['composite_basemaps'] = meta
        cfg['tak_map_enrollment'] = {
            'version':'i507',
            'role':'tak-map-service',
            'manifest':str(os.environ.get('TAK_MAP_ENROLLMENT_MANIFEST','/etc/tak-map/enrollment.json')),
            'service_client_cert':str(os.environ.get('TAK_MAP_SERVICE_CLIENT_CERT',TAK_MAP_REPLAY_CLIENT_CERT)),
            'gateway_ca_cert':TAK_MAP_GATEWAY_CA_CERT,
            'replay_api':TAK_MAP_REPLAY_API_URL,
            'gateway_data_api':str(globals().get('TAK_MAP_GATEWAY_DATA_API_URL','')),
            'gateway_base_url':_i505_gateway_asset_base(),
            'direct_basemaps':TAK_MAP_GATEWAY_DIRECT_BASEMAPS,
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _I507_DIRECT_GATEWAY_UI = r'''<script id="takMapDirectGatewayBasemapsV507">
(function(w,d){'use strict';const V='i507';function diag(){let c={};try{c=(typeof config!=='undefined'&&config)||w.config||{}}catch(_){c=w.config||{}}const m=c.composite_basemaps||{};return {version:V,deliveryPath:m.delivery_path||'',directBrowserRequests:!!m.direct_browser_requests,takMapPythonProxy:!!m.tak_map_python_tile_proxy_for_gateway,browserClientCertificateRequired:!!m.browser_client_certificate_required,gatewayServerCertificateTrustRequired:m.gateway_server_certificate_trust_required!==false,gatewayBaseUrl:m.gateway_base_url||''}}w.TakMapDirectGatewayBasemapsV507=Object.freeze({version:V,diagnostics:diag});try{d.documentElement.dataset.takMapIteration=V}catch(_){}})(window,document);
</script>'''

    def _i507_patch_html(html):
        if not isinstance(html,str): return html
        html=html.replace('1.3.0-i506','1.3.0-i507').replace('TAKDashboard/i506','TAKDashboard/i507').replace('TAK-Map/1.3.0 i506','TAK-Map/1.3.0 i507')
        html=_i491_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i507\2',html)
        if 'id="takMapDirectGatewayBasemapsV507"' not in html:
            html=html.replace('</body></html>',_I507_DIRECT_GATEWAY_UI+'</body></html>')
        return html

    TAK_MAP_HTML=_i507_patch_html(TAK_MAP_HTML);INDEX_HTML=TAK_MAP_HTML
    try:
        TAK_MAP_LOGIN_HTML=_i507_patch_html(TAK_MAP_LOGIN_HTML)
        LOGIN_HTML=_i507_patch_html(LOGIN_HTML)
    except Exception: pass
except Exception as _i507_exc:
    try: print('TAK Map i507 direct Gateway basemap/enrollment patch failed:',_i507_exc)
    except Exception: pass
# --- end TAK Map i507 direct TAK Gateway HTTPS basemap delivery and service enrollment ---

# --- TAK Map i508 split-layer Gateway composite basemap performance ---
try:
    from urllib.parse import urljoin as _i508_urljoin

    _I508_CATALOG_COMPOSITION = {}
    _i508_prev_catalog_candidates = _i506_catalog_candidates
    def _i506_catalog_candidates(base, payload):
        candidates = _i508_prev_catalog_candidates(base, payload)
        raw_by_id = {}
        for raw in _i506_catalog_rows(payload):
            if not isinstance(raw, dict):
                continue
            bid = str(raw.get('id') or raw.get('basemap_id') or raw.get('xml_id') or raw.get('slug') or '').strip()
            if bid:
                raw_by_id[bid] = raw
        for candidate in candidates:
            raw = raw_by_id.get(str(candidate.get('id') or '')) or {}
            comp = raw.get('client_composition') or raw.get('clientComposition')
            if not isinstance(comp, dict) or not comp.get('enabled'):
                continue
            normalized = dict(comp)
            for key in ('base_url','overlay_url'):
                value = str(normalized.get(key) or '').strip()
                if value:
                    normalized[key] = _i508_urljoin(base.rstrip('/')+'/', value)
            candidate['client_composition'] = normalized
            _I508_CATALOG_COMPOSITION[str(candidate.get('id') or '')] = normalized
        return candidates
    globals()['_i506_catalog_candidates'] = _i506_catalog_candidates

    _i508_prev_parse_gateway_xml = _i506_parse_gateway_xml
    def _i506_parse_gateway_xml(blob, xml_id, xml_url='', catalog_source='fallback'):
        item = _i508_prev_parse_gateway_xml(blob, xml_id, xml_url, catalog_source)
        comp = _I508_CATALOG_COMPOSITION.get(str(xml_id or ''))
        if isinstance(comp, dict):
            item['client_composition'] = dict(comp)
        return item
    globals()['_i506_parse_gateway_xml'] = _i506_parse_gateway_xml

    def _i508_gateway_composition(row):
        row = row or {}
        stored = row.get('client_composition')
        if isinstance(stored, dict) and stored.get('enabled'):
            comp = dict(stored)
            if comp.get('overlay_url'):
                comp['overlay_url'] = _i507_direct_gateway_url(comp.get('overlay_url'))
            return comp
        text = ' '.join(str(row.get(k) or '') for k in ('gateway_catalog_id','label','source_xml_name','upstream_url')).lower().replace('_','-')
        source = ''
        if 'rainviewer' in text: source = 'rainviewer'
        elif 'imerg' in text: source = 'imerg'
        elif 'goes-18' in text or 'goes18' in text: source = 'goes18'
        elif 'goes-19' in text or 'goes19' in text: source = 'goes19'
        elif 'noaa' in text or 'radar' in text: source = 'noaa'
        if not source:
            return {}
        kind = 'street' if any(word in text for word in ('street','strt','road')) else 'imagery'
        base_url = ('https://services.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}'
                    if kind == 'street' else
                    'https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}')
        gateway = _i505_gateway_asset_base().rstrip('/')
        if not gateway:
            return {}
        return {
            'enabled': True,
            'base_url': base_url,
            'overlay_url': gateway + '/tiles/overlay-' + source + '/{z}/{x}/{y}.png',
            'overlay_opacity': 0.68 if source.startswith('goes') else 0.90,
            'overlay_source': source,
            'base_kind': kind,
            'tile_size': 256,
            'max_native_zoom': 22,
            'freshness_seconds': 600,
        }

    _i508_prev_public_basemap = _i505_public_basemap
    def _i505_public_basemap(row):
        item = _i508_prev_public_basemap(row)
        if str((row or {}).get('source_kind') or '').strip().lower() != 'tak-gateway' or not TAK_MAP_GATEWAY_DIRECT_BASEMAPS:
            return item
        comp = _i508_gateway_composition(row)
        if not comp:
            return item
        item['clientComposition'] = True
        item['baseUrl'] = str(comp.get('base_url') or '')
        item['overlayUrl'] = str(comp.get('overlay_url') or '')
        item['overlayOpacity'] = float(comp.get('overlay_opacity') or 0.90)
        item['overlaySource'] = str(comp.get('overlay_source') or '')
        item['overlayTileSize'] = int(comp.get('tile_size') or 256)
        item['overlayMaxNativeZoom'] = int(comp.get('max_native_zoom') or item.get('maxZoom') or 22)
        item['overlayFreshnessSeconds'] = int(comp.get('freshness_seconds') or 600)
        item['clientCompositionMode'] = 'direct-base-plus-gateway-transparent-overlay'
        item['serverCompositeUrl'] = item.get('url')
        item['takMapPythonProxy'] = False
        return item
    globals()['_i505_public_basemap'] = _i505_public_basemap

    _i508_prev_save = _i505_save_custom_basemaps
    def _i508_save_custom_basemaps(rows):
        TAK_MAP_OFFLINE_DIR.mkdir(parents=True, exist_ok=True)
        final = list(rows or [])[-TAK_MAP_CUSTOM_BASEMAP_LIMIT:]
        atomic_write_json(TAK_MAP_CUSTOM_BASEMAPS_FILE, {
            'version':'i508', 'basemaps':final, 'updated':datetime.now(timezone.utc).isoformat(),
        })
        return final
    globals()['_i505_save_custom_basemaps'] = _i508_save_custom_basemaps
    globals()['_i506_save_custom_basemaps'] = _i508_save_custom_basemaps

    _i508_prev_result = _i507_result
    def _i508_result(message='', imported=None, errors=None, **extra):
        result = _i508_prev_result(message, imported, errors, **extra)
        if isinstance(result, dict): result['version'] = 'i508'
        return result
    globals()['_i506_result'] = _i508_result
    globals()['_i505_custom_basemap_result'] = _i508_result

    _i508_prev_config = tak_map_config
    def tak_map_config():
        cfg = _i508_prev_config()
        if not isinstance(cfg, dict): return cfg
        cfg = dict(cfg); cfg['tak_map_iteration'] = 'i508'
        # Rebuild imported rows through the newest public conversion so already
        # enrolled/imported i507 definitions gain split-layer metadata without
        # requiring the operator to delete and re-import them.
        rebuilt = []
        persisted = {str(row.get('id') or ''): row for row in _i505_load_custom_basemaps()}
        for item in list(cfg.get('basemaps') or []):
            rid = str((item or {}).get('id') or '')
            raw = persisted.get(rid)
            rebuilt.append(_i505_public_basemap(raw) if raw else item)
        cfg['basemaps'] = rebuilt
        meta = dict(cfg.get('composite_basemaps') or {})
        meta.update({
            'version':'i508',
            'delivery_path':'browser-direct-base-provider-plus-gateway-overlay',
            'direct_browser_requests':True,
            'tak_map_python_tile_proxy_for_gateway':False,
            'tak_map_nginx_tile_relay_for_gateway':False,
            'client_side_composition':True,
            'server_side_composition_for_tak_map':False,
            'server_composite_compatibility_for_atak':True,
            'dynamic_overlay_freshness_seconds':600,
            'base_cache_seconds':30*24*60*60,
            'gateway_transparent_overlay_endpoint':True,
            'leaflet_applies_overlay_opacity':True,
            'http2_gateway_transport':True,
        })
        cfg['composite_basemaps'] = meta
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _I508_SPLIT_LAYER_UI = r'''<script id="takMapSplitCompositeBasemapsV508">
(function(w,d){'use strict';const V='i508';
function fill(t,c){return String(t||'').replace('{z}',c.z).replace('{x}',c.x).replace('{y}',c.y)}
function options(b,url,overlay){const o={minZoom:Number(b.minZoom||0),maxZoom:Number(b.maxZoom||22),attribution:overlay?'':(b.attribution||''),errorTileUrl:'',updateWhenIdle:false,keepBuffer:4};if(overlay){o.opacity=Math.max(0,Math.min(1,Number(b.overlayOpacity||.9)));o.tileSize=Number(b.overlayTileSize||256);o.maxNativeZoom=Number(b.overlayMaxNativeZoom||b.maxZoom||22);o.crossOrigin=true;o.zIndex=220}return o}
function create(b){if(!(b&&b.clientComposition&&b.baseUrl&&b.overlayUrl)){return w.__takMapCreateOnlineLayerBeforeV508?w.__takMapCreateOnlineLayerBeforeV508(b):L.tileLayer(b.url,options(b,b.url,false))}const base=L.tileLayer(b.baseUrl,options(b,b.baseUrl,false));const overlay=L.tileLayer(b.overlayUrl,options(b,b.overlayUrl,true));overlay.on('tileerror',function(ev){try{const tile=ev&&ev.tile,c=ev&&ev.coords;if(!tile||!c||!b.serverCompositeUrl||tile.dataset.takCompositeFallbackV508==='1')return;tile.dataset.takCompositeFallbackV508='1';tile.src=fill(b.serverCompositeUrl,c)}catch(_){}});const group=L.layerGroup([base,overlay]);group._takMapCompositeV508={base,overlay,source:b.overlaySource||'',mode:'direct-base-plus-gateway-overlay',serverCompositeFallback:!!b.serverCompositeUrl};group.on('add',function(){try{base.bringToBack();overlay.bringToFront()}catch(_){}});return group}
function install(){if(!w.__takMapCreateOnlineLayerBeforeV508)w.__takMapCreateOnlineLayerBeforeV508=w.takMapCreateOnlineLayerV476||w.takMapCreateOnlineLayerV465;w.takMapCreateOnlineLayerV476=create;w.takMapCreateOnlineLayerV465=create;try{takMapCreateOnlineLayerV476=create}catch(_){}try{takMapCreateOnlineLayerV465=create}catch(_){}try{d.documentElement.dataset.takMapIteration=V}catch(_){}}
function diagnostics(){let c={};try{c=(typeof config!=='undefined'&&config)||w.config||{}}catch(_){c=w.config||{}}const rows=(c.basemaps||[]).filter(x=>x&&x.clientComposition);return {version:V,clientComposition:true,composites:rows.length,directBaseProvider:true,directGatewayOverlay:true,takMapPythonProxy:false,activeComposite:!!(w.baseLayer&&w.baseLayer._takMapCompositeV508)}}
w.TakMapCompositePerformanceV508=Object.freeze({version:V,install,create,diagnostics});install();if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',install,{once:true});[250,900,1800].forEach(ms=>setTimeout(install,ms));
})(window,document);
</script>'''

    def _i508_patch_html(html):
        if not isinstance(html, str): return html
        html = html.replace('1.3.0-i507','1.3.0-i508').replace('TAKDashboard/i507','TAKDashboard/i508').replace('TAK-Map/1.3.0 i507','TAK-Map/1.3.0 i508')
        html = _i491_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i508\2', html)
        if 'id="takMapSplitCompositeBasemapsV508"' not in html:
            html = html.replace('</body></html>', _I508_SPLIT_LAYER_UI + '</body></html>')
        return html

    TAK_MAP_HTML = _i508_patch_html(TAK_MAP_HTML); INDEX_HTML = TAK_MAP_HTML
    try:
        TAK_MAP_LOGIN_HTML = _i508_patch_html(TAK_MAP_LOGIN_HTML); LOGIN_HTML = _i508_patch_html(LOGIN_HTML)
    except Exception: pass
except Exception as _i508_exc:
    try: print('TAK Map i508 composite performance patch failed:', _i508_exc)
    except Exception: pass
