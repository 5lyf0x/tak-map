                        name=_v393_norm((o or {}).get('name') or (o or {}).get('callsign') or (o or {}).get('title'))
                        uid=_v393_norm((o or {}).get('uid') or (o or {}).get('id') or (o or {}).get('cot_uid'))
                        is_mc=('mission_content' in src)
                        # v393: stop rendering historical TAK Map missionpackage rows as live Data Sync objects.
                        reason=''
                        if is_mc and (keys & stale_keys):
                            reason='mission_content object matched a historical TAK Map/local-data mission package key'
                        elif is_mc and _v393_shapeish_type(typ) and (_v393_is_uuidish(name) or uid in stale_content_uids):
                            reason='mission_content shape/route object is package-derived history, not current Mission UID state'
                        elif is_mc and _v393_shapeish_type(typ) and any(k in stale_content_uids for k in keys):
                            reason='mission_content object UID matches historical content row'
                        if reason:
                            removed.append({'uid':_v393_text((o or {}).get('uid') or (o or {}).get('id'))[:160], 'name':_v393_text((o or {}).get('name') or (o or {}).get('callsign') or (o or {}).get('title'))[:200], 'type':_v393_text((o or {}).get('type') or (o or {}).get('geometry'))[:80], 'source':_v393_text((o or {}).get('source'))[:200], 'reason':reason})
                            continue
                    except Exception as _inner:
                        pass
                    kept.append(o)
                out['objects']=kept
                out['mission_content_strict_filter']={
                    'version':'v393',
                    'mode':'strict-current-mission-content-filter',
                    'objects_before':len(objects),
                    'objects_after':len(kept),
                    'removed_count':len(removed),
                    'removed_sample':removed[:120],
                    'stale_key_count':len(stale_keys),
                    'stale_content_rows':stale_rows[:120],
                    'stale_content_row_count':len(stale_rows),
                    'active_non_shape_mission_uid_name_count':len(mission_uid_active_names),
                    'note':'OTS keeps TAK Map/local-data missionpackage rows after ATAK deletion. v393 treats those package rows as historical unless a current non-shape mission_uid row confirms the same UID/name.'
                }
            except Exception as _e:
                try:
                    out['mission_content_strict_filter']={'version':'v393','error':str(_e)}
                except Exception:
                    pass
            return out
        globals()['tak_map_data_sync']=tak_map_data_sync
        globals()['_tak_v393_data_sync_wrapped']=True

    _v393_script = """<script id=\"v393StrictMissionContentFilterPatch\">
(function(){
  'use strict';
  const V='v393', w=window, d=document;
  function txt(v){try{return String(v==null?'':v)}catch(_){return ''}}
  function lc(v){return txt(v).trim().toLowerCase()}
  async function ds(reason){return fetch('/api/tak-map/data-sync?force=1&reason='+(encodeURIComponent(reason||'v393'))+'&_='+Date.now(),{cache:'no-store',credentials:'same-origin'}).then(r=>r.json())}
  async function audit(){const j=await ds('v393-audit');return {version:V,ok:!!j.ok,objectCount:(j.objects||[]).length,mission_content_strict_filter:j.mission_content_strict_filter||null,mission_orphan_shape_filter:j.mission_orphan_shape_filter||null,mission_deletion_filter:j.mission_deletion_filter||null,sources:j.sources||[]};}
  async function hardRefresh(){let before=null;try{before=await audit()}catch(_){ }try{if(typeof w.forceTakMapLayerHardRefreshV392==='function')await w.forceTakMapLayerHardRefreshV392()}catch(_){ }try{if(typeof w.refreshDataSync==='function')await w.refreshDataSync(true,'v393-hard-refresh')}catch(_){ }try{if(typeof w.refreshCot==='function')await w.refreshCot()}catch(_){ }try{if(typeof w.sweepTakMapOrphanMissionLayersV392==='function')await w.sweepTakMapOrphanMissionLayersV392('v393-after-strict-filter')}catch(_){ }let after=null;try{after=await audit()}catch(_){ }return {version:V,ok:true,before,after,lastV392Sweep:w.__takV392LastSweep||null};}
  async function trace(name){const needle=lc(name);const j=await ds('v393-trace');const scan=(rows)=>{try{return (rows||[]).filter(r=>JSON.stringify(r).toLowerCase().indexOf(needle)>=0).slice(0,80)}catch(_){return []}};let base=null;try{if(typeof w.getTakMapDeletionTraceV392==='function')base=await w.getTakMapDeletionTraceV392(name)}catch(e){base={error:String(e)}}return {version:V,name:name||'',baseV392:base,matchingObjects:scan(j.objects),matchingMissionContent:scan(j.mission_content),matchingMissionUids:scan(j.mission_uids),mission_content_strict_filter:j.mission_content_strict_filter||null};}
  function boot(){try{d.documentElement.dataset.takMapIteration=V;d.querySelectorAll('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
