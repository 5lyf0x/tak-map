                'top_level_keys':list(state.get('top_level_keys') or []),'normalization_rejections':state.get('normalization_rejections') or 0,
                'source_now':state.get('source_now'),'pooled_https':bool(_I465_ADSB_POOL),
                'position_change_age_seconds':round(max(0,now-float(snap.get('position_change_at') or now)),3)}
        return {'ok':True,'version':'i465','source_mode':'airplanes_live_pooled_background_snapshot','aircraft':rows,'count':len(rows),
                'sources':[source],'stale_seconds':snap.get('stale_seconds') or _adsb_stale_seconds(st),'settings':st,
                'snapshot_ready':bool(snap),'snapshot_key':snap.get('key') or '','requested_snapshot_key':requested_key,
                'fallback_snapshot':bool(fallback_key),'fallback_snapshot_key':fallback_key,
                'snapshot_age_seconds':source['snapshot_age_seconds'],'collector_in_flight':bool(state.get('in_flight')),
                'preserve_last_good':bool(fallback_key or (state.get('last_error') and rows))}

    # Restore direct upstream URLs for the visible basemap. The authenticated
    # on-demand tile-cache endpoint remains available for compatibility.
    _i465_prev_config=tak_map_config
    def tak_map_config():
        cfg=_i465_prev_config()
        if isinstance(cfg,dict):
            cfg['tak_map_iteration']='i465'
            cfg['adsb']=dict(cfg.get('adsb') or {});cfg['adsb']['settings']=_load_adsb_settings();cfg['adsb']['source_mode']='airplanes_live_pooled_background_snapshot'
            for b in cfg.get('basemaps') or []:
                src=str(b.get('source_url') or '')
                if src.startswith(('https://','http://')):
                    b['url']=src;b['interactive_url_mode']='direct-upstream'
            cache=dict(cfg.get('online_tile_cache') or {})
            cache.update({'interactive_mode':'direct-upstream',
                          'foreground_uses_python_proxy':False,
                          'pooled_upstream_connections':bool(_I464_TILE_POOL)})
            cfg['online_tile_cache']=cache
        return cfg

