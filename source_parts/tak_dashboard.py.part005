        old_clear = "function clearPinnedPopup(){try{const lyr=window._takPinnedPopupLayer;if(lyr){lyr._takPopupPinned=false;if(!popupEditActiveInLayer(lyr)&&lyr.closePopup)lyr.closePopup()}window._takPinnedPopupLayer=null}catch(e){}}"
        new_clear = "function takMapObjectPopupClickEvent(ev){try{const oe=ev&&ev.originalEvent;if(oe&&(oe.__takMapObjectPopupClick||oe._stopped))return true;const src=ev&&(ev.propagatedFrom||ev.sourceTarget);if(src&&src!==map&&src.getPopup&&src.getPopup())return true;if(Date.now()<=Number(window.__takMapObjectPopupClickUntil||0))return true}catch(_){ }return false}function clearPinnedPopup(ev){try{if(takMapObjectPopupClickEvent(ev))return false;const lyr=window._takPinnedPopupLayer;if(lyr){for(const k of ['_takPopupPinned','__v463Pinned','__v461Pinned','__v353PopupPinned'])try{lyr[k]=false}catch(_){ }const p=lyr.getPopup&&lyr.getPopup();if(p)p.__v463Pinned=false;if(!popupEditActiveInLayer(lyr)&&lyr.closePopup)lyr.closePopup()}window._takPinnedPopupLayer=null;return true}catch(e){return false}}"
