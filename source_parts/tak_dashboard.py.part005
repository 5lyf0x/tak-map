    try{(ds.mission_content||[]).forEach(r=>{if(shapeishRow(r))addCand(r,'mission_content')})}catch(_){}
    try{(ds.packages||[]).forEach(r=>{if(shapeishRow(r))addCand(r,'packages')})}catch(_){}
