  while(qh<qt){const idx=queue[qh++],x=idx%w,y=(idx/w)|0,dx=x-cx,dy=y-cy,r=Math.hypot(dx,dy);members.push(idx);if(r<minR)minR=r;if(r>maxR)maxR=r;if(r>0){sumUx+=dx/r;sumUy+=dy/r}
   for(const off of neighbors){const ni=idx+off;if(ni<0||ni>=candidate.length||visited[ni]||!candidate[ni])continue;const nx=ni%w,ny=(ni/w)|0;if(Math.abs(nx-x)>1||Math.abs(ny-y)>1)continue;visited[ni]=1;queue[qt++]=ni}
