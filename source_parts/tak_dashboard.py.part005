`;d.head.appendChild(st)}const box=d.createElement('div');box.id='replayJumpI624';box.className='replay-jump-i624';box.innerHTML=`<div class="replay-jump-head-i624"><b>Jump to date / time</b><span id="replayJumpZoneI624">Replay time</span></div><div class="replay-jump-fields-i624"><span id="replayJumpDateWrapI624" class="replay-jump-input-wrap-i624 disabled"><input id="replayJumpDateI624" type="date" disabled></span><span id="replayJumpTimeWrapI624" class="replay-jump-input-wrap-i624 disabled"><input id="replayJumpTimeI624" type="time" step="1" disabled></span><button id="replayJumpGoI624" type="button" disabled>Go</button></div><div class="replay-jump-step-i624"><button id="replayJumpBackI624" type="button" disabled>−1 min</button><button id="replayJumpForwardI624" type="button" disabled>+1 min</button></div><div id="replayJumpStatusI624" class="replay-jump-status-i624">Select a recorded period to jump.</div>`;period.insertAdjacentElement('afterend',box);const date=$('replayJumpDateI624'),time=$('replayJumpTimeI624');for(const el of [date,time]){el.addEventListener('focus',()=>{replayJumpI624.editing=true});el.addEventListener('blur',()=>{replayJumpI624.editing=false});el.addEventListener('change',()=>{updateReplayJumpBoundsI624();const st=$('replayJumpStatusI624');if(st){st.classList.remove('bad');st.textContent='Ready to jump within the selected recording.'}})}$('replayJumpGoI624').onclick=()=>goReplayJumpI624();$('replayJumpBackI624').onclick=()=>stepReplayJumpI624(-1);$('replayJumpForwardI624').onclick=()=>stepReplayJumpI624(1);resetReplayJumpI624(true)}
