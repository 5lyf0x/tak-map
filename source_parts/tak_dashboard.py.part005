# --- TAK Map v411 Satellite Tracking UI cleanup patch ---
try:
    import re as _re_v411
    _v411_script = r"""<script id="v411SatelliteUiCleanupPatch">
(function(){
  'use strict';
  const V='v411', w=window, d=document;
  const COLLAPSE_KEY='takMapSatellitePanelCollapsedV411';
  function $(id){try{return d.getElementById(id)}catch(_){return null}}
  function q(sel,root){try{return (root||d).querySelector(sel)}catch(_){return null}}
  function qa(sel,root){try{return Array.from((root||d).querySelectorAll(sel))}catch(_){return []}}
  function normText(el){return String((el&&el.textContent)||'').replace(/\s+/g,' ').trim()}
  function setVersion(){try{d.documentElement.dataset.takMapIteration=V;qa('.iteration-chip,.iteration-marker,[data-iteration]').forEach(function(el){el.textContent=V;try{el.setAttribute('data-iteration',V)}catch(_){}})}catch(_){} }
  function panelByTitle(rx){return qa('.sidebar .panel').find(function(p){const h=q('h2',p);return h&&rx.test(normText(h))})||null}
  function satPanel(){return $('satelliteTrackingPanelV409')||$('satelliteTrackingPanelV408')||panelByTitle(/^Satellite Tracking\b/i)}
  function addCss(){
    if($('v411SatelliteUiCleanupStyle')) return;
    const st=d.createElement('style');
    st.id='v411SatelliteUiCleanupStyle';
    st.textContent=`
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup{--sat-row-font:.705rem;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup .row label span,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup .row label span{font-size:var(--sat-row-font)!important;line-height:1.18!important;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup #satCacheSummaryV409,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup #satCacheSummaryV408{display:block;border-bottom:1px solid rgba(255,255,255,.105);padding-bottom:8px;margin-bottom:8px;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup .subgroup-title,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup .subgroup-title{margin-top:7px;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup .sat-v409-list,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup .sat-v408-list{max-height:245px;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup .sat-v409-row,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup .sat-v408-row{grid-template-columns:18px minmax(0,1fr) minmax(52px,auto) 30px!important;gap:6px!important;align-items:center!important;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup .sat-v409-row small,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup .sat-v408-row small{display:none!important;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup .sat-v409-row b,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup .sat-v408-row b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:.735rem!important;line-height:1.16!important;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup .sat-v409-count,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup .sat-v408-count{justify-self:end!important;text-align:right!important;min-width:44px!important;font-size:.675rem!important;padding:2px 6px!important;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup .sat-v409-mini,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup .sat-v408-mini{justify-self:end!important;min-width:26px!important;padding:2px 6px!important;}
      #satelliteTrackingPanelV409.sat-v411-ui-cleanup details .muted,
      #satelliteTrackingPanelV408.sat-v411-ui-cleanup details .muted{font-size:.68rem;line-height:1.25;}
    `;
    (d.head||d.documentElement).appendChild(st);
  }
  function updateToggleIcon(p){try{const t=q('.panel-toggle',p);if(t)t.textContent=p.classList.contains('collapsed')?'▸':'▾'}catch(_){} }
  function applyCollapse(p){
    try{
      let raw=localStorage.getItem(COLLAPSE_KEY);
      if(raw===null){
        p.classList.add('collapsed');
        localStorage.setItem(COLLAPSE_KEY,'1');
      }else{
        p.classList.toggle('collapsed',raw==='1');
      }
      updateToggleIcon(p);
    }catch(_){try{p.classList.add('collapsed');updateToggleIcon(p)}catch(__){}}
  }
  function bindCollapseMemory(p){
    if(!p||p.dataset.v411CollapseMemory==='1') return;
    p.dataset.v411CollapseMemory='1';
    const h=q('h2',p);
    if(h){
      h.addEventListener('click',function(){
        setTimeout(function(){
          try{localStorage.setItem(COLLAPSE_KEY,p.classList.contains('collapsed')?'1':'0');updateToggleIcon(p)}catch(_){}
        },45);
      },false);
    }
  }
  function moveBelowAdsb(p){
    try{
