/* i442 public UI refinements */
.tak-relief-slider-row-v442{display:grid;grid-template-columns:minmax(0,1fr) 52px;gap:10px;align-items:center;margin-top:9px}
.tak-relief-value-v442{display:inline-flex;align-items:center;justify-content:center;min-width:52px;height:28px;border:1px solid rgba(255,111,46,.40);border-radius:8px;background:rgba(255,111,46,.08);color:#ffd2bc;font-size:.72rem;font-weight:950;letter-spacing:.03em}
#reliefOpacity.tak-tactical-rail-v442{-webkit-appearance:none;appearance:none;width:100%;height:22px;margin:0;background:transparent;cursor:pointer;outline:none}
#reliefOpacity.tak-tactical-rail-v442::-webkit-slider-runnable-track{height:12px;border:1px solid #3a4b58;background:linear-gradient(90deg,var(--accent) 0 var(--tak-relief-pct),transparent var(--tak-relief-pct) 100%),repeating-linear-gradient(90deg,rgba(255,255,255,.10) 0 1px,transparent 1px 18px),linear-gradient(180deg,#263540,#111820);clip-path:polygon(6px 0,calc(100% - 6px) 0,100% 6px,100% calc(100% - 6px),calc(100% - 6px) 100%,6px 100%,0 calc(100% - 6px),0 6px);box-shadow:inset 0 1px 2px rgba(255,255,255,.08),inset 0 -2px 3px rgba(0,0,0,.60)}
#reliefOpacity.tak-tactical-rail-v442::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:16px;height:22px;margin-top:-6px;border:1px solid #ffb083;background:linear-gradient(180deg,#ff9256,#c64718);clip-path:polygon(4px 0,12px 0,16px 4px,16px 18px,12px 22px,4px 22px,0 18px,0 4px);box-shadow:0 0 0 2px rgba(4,8,12,.85),0 0 13px rgba(255,111,46,.45)}
#reliefOpacity.tak-tactical-rail-v442::-moz-range-track{height:12px;border:1px solid #3a4b58;background:repeating-linear-gradient(90deg,rgba(255,255,255,.10) 0 1px,transparent 1px 18px),linear-gradient(180deg,#263540,#111820)}
#reliefOpacity.tak-tactical-rail-v442::-moz-range-progress{height:12px;background:var(--accent)}
#reliefOpacity.tak-tactical-rail-v442::-moz-range-thumb{width:16px;height:22px;border:1px solid #ffb083;border-radius:3px;background:#df581f;box-shadow:0 0 0 2px rgba(4,8,12,.85),0 0 13px rgba(255,111,46,.45)}
.tak-offline-stepper-v442{display:grid;grid-template-columns:34px minmax(58px,1fr) 34px;align-items:stretch;width:142px;height:38px;border:1px solid #354653;border-radius:8px;overflow:hidden;background:#0a1016;box-shadow:inset 0 1px 2px rgba(255,255,255,.035),0 5px 13px rgba(0,0,0,.20)}
.tak-offline-stepper-v442 button{display:grid;place-items:center;min-width:34px;margin:0;padding:0;border:0;border-radius:0;background:linear-gradient(180deg,#1c2a35,#111a22);color:#f1f5f7;font-size:1rem;font-weight:950;line-height:1;cursor:pointer}
.tak-offline-stepper-v442 button:hover{background:linear-gradient(180deg,#7d3519,#3e1c10);color:#fff}
.tak-offline-stepper-v442 button:active{background:#a74218}
.tak-offline-stepper-v442 input[type=number]{min-width:0!important;width:100%!important;height:100%!important;margin:0!important;padding:0 6px!important;border:0!important;border-left:1px solid #354653!important;border-right:1px solid #354653!important;border-radius:0!important;background:#0b1218!important;color:#ffd3bd!important;text-align:center!important;font-size:.88rem!important;font-weight:950!important;outline:none!important;-moz-appearance:textfield!important;appearance:textfield!important}
.tak-offline-stepper-v442 input[type=number]::-webkit-inner-spin-button,.tak-offline-stepper-v442 input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none!important;margin:0!important}
@media(max-width:760px){.tak-relief-slider-row-v442{grid-template-columns:minmax(0,1fr) 48px}.tak-offline-stepper-v442{width:132px}}

@media(max-width:900px){#replayMapV415{left:340px}}@media(max-width:760px){.replay-banner-v415{white-space:normal;font-size:.66rem;line-height:1.25}}
`;d.head.appendChild(st)}
function sidebar(){return $('sidebar')||q('.sidebar')}
function enforceVersionUiV442(){try{
  qa('#takMapHeaderReleaseV441,[id^="takMapHeaderRelease"],.tak-map-header-release-v441,.tak-map-header-release-v442').forEach(el=>el.remove());
  const panel=q('#sidebar .version-panel')||q('.version-panel');
  if(panel){
    const release=q('.release-main,[data-release]',panel),iteration=q('.iteration-chip,.iteration-marker,[data-iteration]',panel);
    if(release){if(release.textContent!==RELEASE)release.textContent=RELEASE;if(release.getAttribute('data-release')!==RELEASE)release.setAttribute('data-release',RELEASE)}
    if(iteration){if(iteration.textContent!==V)iteration.textContent=V;if(iteration.getAttribute('data-iteration')!==V)iteration.setAttribute('data-iteration',V)}
  }
  d.documentElement.dataset.takMapIteration=V;
  d.documentElement.dataset.takMapRelease=RELEASE;
}catch(_){}}
function installVersionGuardV442(){try{
  if(w.__takVersionGuardV442){enforceVersionUiV442();return}
  w.__takVersionGuardV442=true;
  const start=()=>{enforceVersionUiV442();if(!w.MutationObserver)return;const mo=new MutationObserver(()=>requestAnimationFrame(enforceVersionUiV442));mo.observe(d.body,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['data-release','data-iteration']});w.__takVersionObserverV442=mo};
  if(d.body)start();else d.addEventListener('DOMContentLoaded',start,{once:true});
}catch(_){}}
function updateReliefRailV442(){try{const input=$('reliefOpacity');if(!input)return;const min=Number(input.min||0),max=Number(input.max||100),value=Number(input.value||0),pct=max>min?Math.max(0,Math.min(100,((value-min)/(max-min))*100)):0;input.style.setProperty('--tak-relief-pct',pct+'%');const chip=$('reliefOpacityValueV442');if(chip)chip.textContent=Math.round(value)+'%'}catch(_){}}
