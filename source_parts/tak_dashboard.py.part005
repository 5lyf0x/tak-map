            ('tak-map-whole-zoom-v475.js','tak-map-whole-zoom-v491.js'),('TakMapWholeZoomV475','TakMapWholeZoomV476'),('takMapWholeZoomLoaderV475','takMapWholeZoomLoaderV476'),
            ('tak-map-card-controls-v475.js','tak-map-card-controls-v491.js'),('TakMapCardControlsV475','TakMapCardControlsV476'),('takMapCardControlsLoaderV475','takMapCardControlsLoaderV476'),
            ('takMapDirectTileLayerV475','takMapDirectTileLayerV476'),('takMapCreateOnlineLayerV475','takMapCreateOnlineLayerV476'),('takProxyFallbackV475','takProxyFallbackV476'),
            ('__TakMapRuntimeV475','__TakMapRuntimeV476'),('TakMapRuntimeMarkV475','TakMapRuntimeMarkV476'),('takMapRuntimeMonitorV475','takMapRuntimeMonitorV476'),('takMapRuntimeErrorV475','takMapRuntimeErrorV476'),
            ('1.3.0-i475','1.3.0-i491'),('TAKDashboard/i475','TAKDashboard/i491'),('TAK-Map/1.3.0 i475','TAK-Map/1.3.0 i491'),
        )
        for old,new in replacements:html=html.replace(old,new)
        html=_i491_re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i491\2',html)
        html=html.replace('<div class="panel collapsible" data-collapse-key="adsbSettings">','<div class="panel" data-collapse-key="adsbSettings" data-manual-collapse="true" data-skip-auto-collapsible="true" data-collapsible-ready="1">',1)
        html=html.replace('<div class="panel"><h2>Data Sync</h2>','<div id="dataSyncPanelV476" class="panel" data-collapse-key="dataSync" data-manual-collapse="true" data-skip-auto-collapsible="true" data-collapsible-ready="1"><h2>Data Sync</h2>',1)
        ds='<script id="takMapDataSyncLoaderV476" src="/assets/runtime/tak-map-data-sync-v491.js?v=1.3.0-i491"></script>'
        controls='<script id="takMapCardControlsLoaderV476" src="/assets/runtime/tak-map-card-controls-v491.js?v=1.3.0-i491"></script>'
        if 'takMapDataSyncLoaderV476' not in html:
            if controls in html:html=html.replace(controls,ds+'\n'+controls,1)
            else:html=html.replace('</body>',ds+'\n</body>',1) if '</body>' in html else html+ds
        # Retire the v411 card-order owner that continually moved Satellite Tracking
        # below ADS-B. Keep the legacy cleanup module, but make its ordering rule
        # agree with i491: Offline Maps -> Satellite Tracking -> Tools.
        satellite_order_owner=r'''function moveBelowAdsb(p){
    try{
      const offline=panelByTitle(/^Offline Maps\b/i),tools=panelByTitle(/^Tools\b/i);
      const parent=offline&&offline.parentNode;
      if(parent&&tools&&tools.parentNode===parent&&p&&(p.parentNode!==parent||offline.nextElementSibling!==p)){
        offline.insertAdjacentElement('afterend',p);
      }
    }catch(_){}
  }
  function cleanupCategoryRows'''
        html, satellite_order_replacements=_i491_re.subn(
            r'function moveBelowAdsb\(p\)\{.*?\n  \}\n  function cleanupCategoryRows',
            lambda _match:satellite_order_owner,
            html,
            count=1,
            flags=_i491_re.S,
        )
        if satellite_order_replacements!=1:
            raise RuntimeError('i491 Satellite order owner patch did not match generated page')
        return html

    TAK_MAP_HTML=_i491_patch_html(TAK_MAP_HTML);INDEX_HTML=TAK_MAP_HTML
    try:
        TAK_MAP_LOGIN_HTML=TAK_MAP_LOGIN_HTML.replace('i475','i491').replace('v475','v491')
        LOGIN_HTML=LOGIN_HTML.replace('i475','i491').replace('v475','v491')
    except Exception:pass
except Exception as _i491_exc:
    try:print('TAK Map i491 patch failed:',_i491_exc)
    except Exception:pass
# --- end TAK Map i491 patch ---

# --- TAK Map i491 canonical Local Data and Mission API object lifecycle ---
try:
    _TAK_OBJECT_LIFECYCLE_VERSION='i491'
    _TAK_LOCAL_OBJECT_LOCK=threading.RLock()
    _tak_object_prev_imported=tak_map_imported
    _tak_object_prev_upload=handle_tak_map_import_upload
    _tak_object_prev_data_sync=tak_map_data_sync
    _tak_object_prev_config=tak_map_config
    _tak_object_prev_popup_candidates=_popup_edit_key_candidates
    _tak_object_prev_get=Handler.do_GET
    _tak_object_prev_post=Handler.do_POST

    def _tak_object_kind(feature):
        try:
            return _local_data_feature_kind(feature)
        except Exception:
            value=str((feature or {}).get('kind') or (feature or {}).get('geometry') or (feature or {}).get('geometry_type') or (feature or {}).get('type') or '').lower()
            if any(token in value for token in ('route','track','line')): return 'route'
            if any(token in value for token in ('polygon','shape','area','rectangle','ellipse','circle','freehand')): return 'shape'
            return 'point'

    def _tak_new_local_object_id():
        return 'local-' + uuid.uuid4().hex

    def _tak_clean_local_object_id(value):
        value=str(value or '').strip()
        if value.startswith('local:'): value=value.split(':',1)[1]
        if value.startswith('import:'): value=value[7:]
        return value

    def _tak_existing_local_object_id(feature):
        if not isinstance(feature,dict): return ''
        for key in ('object_id','source_id','local_id','_local_id'):
            value=_tak_clean_local_object_id(feature.get(key))
            if value.startswith('local-') and len(value)>12:
                return value
        return ''

    def _tak_enrich_local_feature(feature, imp_id='', imp_name='', index=None, assign=True):
        item=dict(feature or {})
        object_id=_tak_existing_local_object_id(item)
        if not object_id and assign:
            object_id=_tak_new_local_object_id()
        if object_id:
            item['object_id']=object_id
            item['local_id']=object_id
            item['_local_id']=object_id
            item['source_kind']='local'
            item['source_id']=object_id
            item['canonical_id']='local:'+object_id
            item['object_kind']=_tak_object_kind(item)
        if imp_id:
            item['import_id']=str(imp_id)
        if imp_name:
            item['import_name']=str(imp_name)
            item.setdefault('source',str(imp_name))
        if index is not None:
            item['import_feature_index']=int(index)
            item.setdefault('legacy_local_id',str(imp_id)+':'+str(index))
        return item

    def _tak_migrate_local_data_ids(persist=True):
        """Assign persistent IDs to stored Local Data without changing geometry or labels."""
        with _TAK_LOCAL_OBJECT_LOCK:
            data=load_json_file(TAK_MAP_IMPORT_FILE, {'imports':[]})
            if not isinstance(data,dict): data={'imports':[]}
            imports=data.get('imports') if isinstance(data.get('imports'),list) else []
            changed=False; migrated=0; out=[]
            for raw_import in imports:
                if not isinstance(raw_import,dict):
                    continue
                imp=dict(raw_import)
                imp_id=str(imp.get('id') or imp.get('name') or secrets.token_hex(6))
                if not imp.get('id'):
                    imp['id']=imp_id; changed=True
                imp_name=str(imp.get('name') or imp_id)
                features=[]
                for index,raw_feature in enumerate(imp.get('features') or []):
                    before=_tak_existing_local_object_id(raw_feature)
                    feature=_tak_enrich_local_feature(raw_feature,imp_id,imp_name,index,assign=True)
                    stable_keys=('object_id','local_id','_local_id','source_kind','source_id','canonical_id','object_kind','legacy_local_id')
                    if not before:
                        migrated+=1
                    if not isinstance(raw_feature,dict) or any(raw_feature.get(key)!=feature.get(key) for key in stable_keys):
                        changed=True
                    # Persist only stable metadata. The current array index remains a compatibility alias,
                    # never the canonical identity.
                    features.append(feature)
                imp['features']=features
                imp['counts']=_import_summary(features)
                out.append(imp)
            if changed and persist:
                TAK_MAP_IMPORT_DIR.mkdir(parents=True,exist_ok=True)
                atomic_write_json(TAK_MAP_IMPORT_FILE,{'imports':out})
            return {'imports':out,'changed':changed,'migrated':migrated}

    def tak_map_imported():
        _tak_migrate_local_data_ids(True)
        result=_tak_object_prev_imported()
        if not isinstance(result,dict): return result
        enriched=[]
        for raw_import in result.get('imports') or []:
            if not isinstance(raw_import,dict): continue
            imp=dict(raw_import)
            # Live webform objects are not Local Data and must not receive deletable Local IDs.
            if str(imp.get('id') or '')=='webform-live' or str(imp.get('source') or '').lower()=='webform':
                enriched.append(imp); continue
            imp_id=str(imp.get('id') or imp.get('name') or '')
            imp_name=str(imp.get('name') or imp_id)
            imp['features']=[_tak_enrich_local_feature(feature,imp_id,imp_name,index,assign=True) for index,feature in enumerate(imp.get('features') or [])]
            imp['counts']=_import_summary(imp['features'])
            enriched.append(imp)
        result['imports']=enriched
        result['object_lifecycle']={'version':_TAK_OBJECT_LIFECYCLE_VERSION,'persistent_local_ids':True,'per_object_hide':False}
        return result
    globals()['tak_map_imported']=tak_map_imported

    def handle_tak_map_import_upload(handler):
        try:
            ctype=handler.headers.get('Content-Type','')
            if 'multipart/form-data' not in ctype.lower():
                return handler._send_json({'ok':False,'error':'Expected multipart/form-data upload.'},400)
            n=int(handler.headers.get('Content-Length','0') or '0')
            if n<=0: return handler._send_json({'ok':False,'error':'No upload body received.'},400)
            if n>90*1024*1024: return handler._send_json({'ok':False,'error':'Import upload is too large. Limit is 90 MB per request.'},413)
            uploaded=_parse_multipart_files(ctype,handler.rfile.read(n))
            if not uploaded: return handler._send_json({'ok':False,'error':'No files found in upload.'},400)
            with _TAK_LOCAL_OBJECT_LOCK:
                migrated=_tak_migrate_local_data_ids(False)
                imports=list(migrated.get('imports') or [])
                added=[]
                for filename,blob in uploaded:
                    imp_id=secrets.token_hex(6)
                    parsed=parse_map_file_bytes(filename,blob)
                    features=[_tak_enrich_local_feature(feature,imp_id,filename,index,assign=True) for index,feature in enumerate(parsed)]
                    imp={'id':imp_id,'name':filename,'uploaded':datetime.now(timezone.utc).isoformat(),'size_bytes':len(blob),'features':features,'counts':_import_summary(features)}
                    imports.append(imp); added.append(imp)
                # i682: never evict saved imports as a side effect of adding new data
                TAK_MAP_IMPORT_DIR.mkdir(parents=True,exist_ok=True)
                atomic_write_json(TAK_MAP_IMPORT_FILE,{'imports':imports})
            return handler._send_json({'ok':True,'added':added,'imports':imports,'object_lifecycle':{'version':_TAK_OBJECT_LIFECYCLE_VERSION,'persistent_local_ids':True}})
        except Exception as exc:
            return handler._send_json({'ok':False,'error':str(exc)},500)
    globals()['handle_tak_map_import_upload']=handle_tak_map_import_upload

    def _tak_local_indexes(imports):
        by_id={}; legacy={}
        for imp_index,imp in enumerate(imports or []):
            imp_id=str((imp or {}).get('id') or (imp or {}).get('name') or '')
            for feature_index,feature in enumerate((imp or {}).get('features') or []):
                object_id=_tak_existing_local_object_id(feature)
                if object_id:
                    by_id[object_id]=(imp_index,feature_index,feature)
                # Never remap a legacy array-position ID to the feature's current index.
                # The stored legacy_local_id is frozen at migration/creation time so a
                # deletion cannot make a stale ID target a different object.
                value=str((feature or {}).get('legacy_local_id') or '').strip()
                if value: legacy[value]=object_id
        return by_id,legacy

    def _tak_resolve_local_requests(requested,imports):
        by_id,legacy=_tak_local_indexes(imports)
        resolved=[]; not_found=[]; unsupported=[]
        for original in requested or []:
            raw=str(original or '').strip()
            if not raw: continue
            value=_tak_clean_local_object_id(raw)
            if value in by_id:
                resolved.append((raw,value)); continue
            if value in legacy and legacy.get(value):
                resolved.append((raw,legacy[value])); continue
            if raw.startswith('datasync:') or value.startswith('datasync-'):
                unsupported.append(raw)
            else:
                not_found.append(raw)
        # Preserve request order while deleting each object only once.
        seen=set(); clean=[]
        for pair in resolved:
            if pair[1] in seen: continue
            seen.add(pair[1]); clean.append(pair)
        return clean,not_found,unsupported

    def tak_map_local_data_delete(ids):
        requested=[str(value or '').strip() for value in (ids or []) if str(value or '').strip()]
        if not requested:
            return {'ok':False,'error':'No Local Data objects selected.','deleted':False,'deleted_ids':[],'not_found_ids':[],'unsupported_ids':[]}
        with _TAK_LOCAL_OBJECT_LOCK:
            migrated=_tak_migrate_local_data_ids(False)
            imports=list(migrated.get('imports') or [])
            resolved,not_found,unsupported=_tak_resolve_local_requests(requested,imports)
            delete_ids={object_id for _,object_id in resolved}
            out=[]; deleted=[]
            for imp in imports:
                cp=dict(imp); kept=[]
                for feature in cp.get('features') or []:
                    object_id=_tak_existing_local_object_id(feature)
                    if object_id and object_id in delete_ids:
                        deleted.append('local:'+object_id)
                        continue
                    kept.append(feature)
                cp['features']=kept; cp['counts']=_import_summary(kept)
                if kept: out.append(cp)
            if deleted:
                TAK_MAP_IMPORT_DIR.mkdir(parents=True,exist_ok=True)
                atomic_write_json(TAK_MAP_IMPORT_FILE,{'imports':out})
            response_imports=tak_map_imported().get('imports',[]) if deleted else tak_map_imported().get('imports',[])
        deleted=list(dict.fromkeys(deleted))
        return {'ok':True,'deleted':bool(deleted),'deleted_count':len(deleted),'deleted_ids':deleted,'not_found_ids':not_found,'unsupported_ids':unsupported,'failed_ids':[],'imports':response_imports,'object_lifecycle':{'version':_TAK_OBJECT_LIFECYCLE_VERSION,'targeted':True}}
    globals()['tak_map_local_data_delete']=tak_map_local_data_delete

    def _selected_local_data_features(ids):
        requested=[str(value or '').strip() for value in (ids or []) if str(value or '').strip()]
        if not requested: return []
        with _TAK_LOCAL_OBJECT_LOCK:
            migrated=_tak_migrate_local_data_ids(False)
            imports=list(migrated.get('imports') or [])
            resolved,_,_=_tak_resolve_local_requests(requested,imports)
            wanted={object_id for _,object_id in resolved}
            edits=_load_popup_edits(); out=[]
            for imp in imports:
                imp_id=str(imp.get('id') or imp.get('name') or '')
                imp_name=str(imp.get('name') or imp_id)
                for index,feature in enumerate(imp.get('features') or []):
                    object_id=_tak_existing_local_object_id(feature)
                    if not object_id or object_id not in wanted: continue
                    item=_tak_enrich_local_feature(feature,imp_id,imp_name,index,assign=False)
                    item=_apply_popup_edit(item,edits)
                    if item: out.append(item)
            return out
    globals()['_selected_local_data_features']=_selected_local_data_features

    def _popup_edit_key_candidates(obj):
        obj=obj or {}; stable=[]
        for key in ('canonical_id','object_id','source_id','local_id','_local_id'):
            value=str(obj.get(key) or '').strip()
            if not value: continue
            if key!='canonical_id' and value.startswith('local-'): value='local:'+value
            if value not in stable: stable.append(value)
        # Keep old keys only for reading existing popup edits; new clients write canonical keys.
        for value in _tak_object_prev_popup_candidates(obj):
            if value not in stable: stable.append(value)
        return stable
    globals()['_popup_edit_key_candidates']=_popup_edit_key_candidates

    def _tak_row_value(row,names,default=''):
        try: return _row_ci_get(row,tuple(names),default)
        except Exception:
            lower={str(key).lower():value for key,value in (row or {}).items()}
            for name in names:
                if str(name).lower() in lower: return lower[str(name).lower()]
            return default

    def _tak_mission_name_maps(data):
        by_id={}; names=set()
        for row in data.get('missions') or []:
            if not isinstance(row,dict): continue
            name=str(_tak_row_value(row,('name','mission_name','missionName','title'),'') or '').strip()
            ident=str(_tak_row_value(row,('id','mission_id','missionId','guid'),'') or '').strip()
            if name: names.add(name)
            if ident and name: by_id[ident]=name
        return by_id,names

    def _tak_resolve_mission_name(row,mission_by_id):
        name=str(_tak_row_value(row,('mission_name','missionName','mission','name'),'') or '').strip()
        if name: return name
        ident=str(_tak_row_value(row,('mission_id','missionId','missionid'),'') or '').strip()
        return mission_by_id.get(ident,'')

    def _tak_data_sync_ownership(data):
        mission_by_id,_=_tak_mission_name_maps(data)
        uid_missions={}; content_missions={}; content_alias={}
        for row in data.get('mission_uids') or []:
            if not isinstance(row,dict): continue
            uid=str(_tak_row_value(row,('uid','cot_uid','cotUid','data_uid'),'') or '').strip()
            mission=_tak_resolve_mission_name(row,mission_by_id)
            if uid and mission: uid_missions.setdefault(uid,set()).add(mission)
        for row in data.get('mission_content') or []:
            if not isinstance(row,dict): continue
            content_id=str(_tak_row_value(row,('id','content_id','contentId'),'') or '').strip()
            hash_value=str(_tak_row_value(row,('hash','sha256','content_hash','contentHash'),'') or '').strip()
            aliases=[]
            for key in ('name','filename','uid','guid','id'):
                value=str(_tak_row_value(row,(key,), '') or '').strip()
                if value: aliases.append(value)
            if content_id and hash_value: content_alias[content_id]=hash_value
            for alias in aliases:
                if hash_value: content_alias[alias]=hash_value
            mission=_tak_resolve_mission_name(row,mission_by_id)
            if mission and hash_value: content_missions.setdefault(hash_value,set()).add(mission)
        for row in data.get('mission_content_mission') or []:
            if not isinstance(row,dict): continue
            mission=_tak_resolve_mission_name(row,mission_by_id)
            reference=str(_tak_row_value(row,('hash','content_hash','contentHash','content_id','contentId','mission_content_id','missionContentId'),'') or '').strip()
            hash_value=content_alias.get(reference,reference)
            if mission and hash_value: content_missions.setdefault(hash_value,set()).add(mission)
        return uid_missions,content_missions,content_alias

    def _tak_data_sync_object_hash(obj,content_alias):
        for key in ('hash','sha256','content_hash','contentHash'):
            value=str((obj or {}).get(key) or '').strip()
            if value: return content_alias.get(value,value)
        props=(obj or {}).get('properties') if isinstance((obj or {}).get('properties'),dict) else {}
        for key in ('hash','sha256','content_hash','contentHash'):
            value=str(props.get(key) or '').strip()
            if value: return content_alias.get(value,value)
        for key in ('id','filename','name'):
            value=str((obj or {}).get(key) or '').strip()
            if value in content_alias: return content_alias[value]
        return ''

    def _tak_enrich_data_sync_result(result):
        if not isinstance(result,dict): return result
        uid_missions,content_missions,content_alias=_tak_data_sync_ownership(result)
        enriched=[]
        for raw in result.get('objects') or []:
            if not isinstance(raw,dict): continue
            obj=dict(raw); uid=str(obj.get('uid') or '').strip(); hash_value=_tak_data_sync_object_hash(obj,content_alias)
            explicit_mission=str(obj.get('mission_name') or obj.get('mission') or '').strip()
            uid_choices=sorted(uid_missions.get(uid) or []) if uid else []
            hash_choices=sorted(content_missions.get(hash_value) or []) if hash_value else []
            mission=''; target_kind=''; target_value=''; ownership_error=''

            def resolve_exact_mission(explicit,choices,label):
                if explicit:
                    if choices and explicit not in choices:
                        return '', label+' ownership does not match the object mission '+explicit+'.'
                    return explicit,''
                if len(choices)==1:
                    return choices[0],''
                if len(choices)>1:
                    return '',label+' is associated with multiple missions ('+', '.join(choices)+'); exact mission ownership is required for deletion.'
                return '',label+' has no Mission API association.'

            if uid:
                mission,ownership_error=resolve_exact_mission(explicit_mission,uid_choices,'UID '+uid)
                if mission:
                    target_kind='uid'; target_value=uid
            if not target_value and hash_value:
                hash_mission,hash_error=resolve_exact_mission(explicit_mission,hash_choices,'Content hash '+hash_value)
                if hash_mission:
                    mission=hash_mission; target_kind='hash'; target_value=hash_value; ownership_error=''
                elif not ownership_error:
                    ownership_error=hash_error

            stable_seed='uid:'+uid if uid else ('hash:'+hash_value if hash_value else '')
            if stable_seed:
                # Canonical identity is the source UID/hash, independent of mission membership.
                # Mission association is a deletion target, not the object's identity.
                digest=hashlib.sha256(stable_seed.encode('utf-8','replace')).hexdigest()[:24]
                object_id='datasync-'+digest
                obj['object_id']=object_id; obj['source_id']=target_value or uid or hash_value
                obj['source_kind']='datasync'; obj['canonical_id']='datasync:'+object_id
                obj['object_kind']=_tak_object_kind(obj)
            else:
                obj.pop('object_id',None); obj.pop('canonical_id',None)
            supported=bool(mission and target_kind and target_value)
            obj['mission_names']=sorted(set(uid_choices+hash_choices+([explicit_mission] if explicit_mission else [])))
            obj['mission_name']=mission
            obj['mission_delete_target']=target_kind if supported else ''
            obj['mission_delete_value']=target_value if supported else ''
            obj['delete_supported']=supported
            if not supported:
                obj['delete_unavailable_reason']=ownership_error or 'Mission API ownership could not be resolved to exactly one mission plus UID or content hash.'
            enriched.append(obj)
        result=dict(result); result['objects']=enriched
        result['object_lifecycle']={'version':_TAK_OBJECT_LIFECYCLE_VERSION,'canonical_data_sync':True,'mission_api_delete':True,'per_object_hide':False}
        return result

    def tak_map_data_sync():
        return _tak_enrich_data_sync_result(_tak_object_prev_data_sync())
    globals()['tak_map_data_sync']=tak_map_data_sync

    def tak_map_config():
        result=_tak_object_prev_config()
        if isinstance(result,dict):
            result=dict(result)
            result['object_lifecycle']={
                'version':_TAK_OBJECT_LIFECYCLE_VERSION,
                'persistent_local_ids':True,
                'canonical_data_sync_ids':True,
                'mission_api_delete':True,
                'server_confirmed_delete_only':True,
                'per_object_hide':False,
                'future_visibility_scope':['points','routes','shapes'],
            }
        return result
    globals()['tak_map_config']=tak_map_config

    def _tak_fresh_data_sync_result():
        base=globals().get('_i491_base_data_sync')
        if callable(base):
            return _tak_enrich_data_sync_result(base())
        return _tak_enrich_data_sync_result(_tak_object_prev_data_sync())

    def _tak_data_sync_delete_record(obj,server_host=''):
        object_id=str((obj or {}).get('object_id') or '').strip()
        canonical='datasync:'+object_id if object_id else ''
        mission=str((obj or {}).get('mission_name') or '').strip()
        target=str((obj or {}).get('mission_delete_target') or '').strip()
        value=str((obj or {}).get('mission_delete_value') or '').strip()
        if not (canonical and mission and target in ('uid','hash') and value):
            return {'object_id':canonical,'status':'unsupported','error':str((obj or {}).get('delete_unavailable_reason') or 'No Mission API-owned deletion identity is available.')}
        creator=_mission_publish_creator_uid()
        if not creator.get('ok'):
            return {'object_id':canonical,'status':'failed','error':creator.get('error') or 'No Mission API creator UID available.'}
        creator_uid=str(creator.get('uid') or '').strip()
        query='creatorUid='+quote(creator_uid,safe='')+'&'+target+'='+quote(value,safe='')
        path='/Marti/api/missions/'+quote(mission,safe='')+'/contents?'+query
        response=_ots_mission_api_request(path,method='DELETE',body=None,headers={'User-Agent':'iTAK/2.9.1 TAK-Map-ObjectLifecycle','Content-Length':'0'},public_host=server_host,timeout=25)
        if response.get('ok'):
            return {'object_id':canonical,'status':'deleted','mission':mission,'target':target,'value':value,'http_status':response.get('status')}
        return {'object_id':canonical,'status':'failed','mission':mission,'target':target,'value':value,'http_status':response.get('status'),'error':response.get('error') or 'Mission API deletion failed.','attempts':response.get('attempts') or []}

    def _tak_invalidate_data_sync_cache():
        try:
            lock=globals().get('_I476_DS_LOCK'); state=globals().get('_I476_DS_SERVER_STATE')
            if lock and isinstance(state,dict):
                with lock:
                    state['last_good']=None; state['last_good_at']=0.0
        except Exception: pass

    def tak_map_object_delete(object_ids,server_host=''):
        requested=[str(value or '').strip() for value in (object_ids or []) if str(value or '').strip()]
        if not requested:
            return {'ok':False,'error':'No canonical object IDs selected.','deleted_ids':[],'not_found_ids':[],'unsupported_ids':[],'failed_ids':[],'results':[]}
        local_requested=[]; datasync_requested=[]; immediately_unsupported=[]
        for value in requested:
            cleaned=_tak_clean_local_object_id(value)
            if value.startswith('local:') or cleaned.startswith('local-') or (':' in cleaned and not value.startswith('datasync:')):
                local_requested.append(value)
            elif value.startswith('datasync:') or value.startswith('datasync-'):
                datasync_requested.append(value)
            else:
                immediately_unsupported.append(value)
        results=[]; deleted=[]; not_found=[]; unsupported=list(immediately_unsupported); failed=[]
        imports=None
        if local_requested:
            local_result=tak_map_local_data_delete(local_requested)
            imports=local_result.get('imports')
            for value in local_result.get('deleted_ids') or []:
                deleted.append(value); results.append({'object_id':value,'status':'deleted','source':'local'})
            for value in local_result.get('not_found_ids') or []:
                not_found.append(value); results.append({'object_id':value,'status':'not_found','source':'local'})
            for value in local_result.get('unsupported_ids') or []:
                unsupported.append(value); results.append({'object_id':value,'status':'unsupported','source':'local'})
        if datasync_requested:
            try:
                snapshot=_tak_fresh_data_sync_result()
                by_id={str(obj.get('canonical_id') or ''):obj for obj in snapshot.get('objects') or [] if isinstance(obj,dict) and obj.get('canonical_id')}
                for requested_id in datasync_requested:
                    canonical=requested_id if requested_id.startswith('datasync:') else 'datasync:'+requested_id
                    obj=by_id.get(canonical)
                    if not obj:
                        not_found.append(requested_id); results.append({'object_id':requested_id,'status':'not_found','source':'datasync'}); continue
                    result=_tak_data_sync_delete_record(obj,server_host)
                    results.append(result)
                    if result.get('status')=='deleted': deleted.append(canonical)
                    elif result.get('status')=='unsupported': unsupported.append(canonical)
                    else: failed.append(canonical)
                _tak_invalidate_data_sync_cache()
            except Exception as exc:
                for requested_id in datasync_requested:
                    failed.append(requested_id); results.append({'object_id':requested_id,'status':'failed','source':'datasync','error':str(exc)})
        for value in immediately_unsupported:
            results.append({'object_id':value,'status':'unsupported','error':'The object does not expose a canonical Local Data or Data Sync identity.'})
        deleted=list(dict.fromkeys(deleted)); not_found=list(dict.fromkeys(not_found)); unsupported=list(dict.fromkeys(unsupported)); failed=list(dict.fromkeys(failed))
        return {'ok':not bool(failed),'partial':bool((not_found or unsupported or failed) and deleted),'deleted':bool(deleted),'deleted_ids':deleted,'not_found_ids':not_found,'unsupported_ids':unsupported,'failed_ids':failed,'results':results,'imports':imports,'object_lifecycle':{'version':_TAK_OBJECT_LIFECYCLE_VERSION,'transactional':True,'server_confirmed_only':True}}
    globals()['tak_map_object_delete']=tak_map_object_delete

    def _tak_object_get(self):
        parsed=urlparse(self.path)
        if parsed.path=='/assets/runtime/tak-map-object-lifecycle-v491.js':
            fp=Path(__file__).resolve().parent/'assets'/'tak-map-object-lifecycle-v491.js'
            if not fp.exists():
                self.send_response(404); self.send_header('Cache-Control','no-store'); self.end_headers(); return
            body=fp.read_bytes(); self.send_response(200); self.send_header('Content-Type','application/javascript; charset=utf-8'); self.send_header('Cache-Control','no-store, max-age=0'); self.send_header('X-TAK-Map-Module','i492-object-lifecycle'); self.send_header('Content-Length',str(len(body))); self.end_headers()
            if getattr(self,'command','GET')!='HEAD': self.wfile.write(body)
            return
        return _tak_object_prev_get(self)
    Handler.do_GET=_tak_object_get

    def _tak_object_post(self):
        parsed=urlparse(self.path)
        if parsed.path=='/api/tak-map/object-delete':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            payload=_read_json_body(self)
            return self._send_json(tak_map_object_delete(payload.get('object_ids') or payload.get('ids') or [],payload.get('serverHost') or ''))
        return _tak_object_prev_post(self)
    Handler.do_POST=_tak_object_post

    def _tak_object_patch_html(html):
        if not isinstance(html,str): return html
        html=re.sub(r'<button id="toolClearHidden"[^>]*>.*?</button>','',html,count=1,flags=re.S)
        # Replace the baked v280 delete handlers in the final generated HTML itself.
        # Patching only window functions after load was not sufficient because the
        # baked page can retain and invoke its original native-confirm handlers.
        _ds_delegate="async function deleteDataSyncItem(idx,ev){if(ev&&ev.stopPropagation)ev.stopPropagation();const lifecycle=window.TakMapObjectLifecycleV486;if(lifecycle&&typeof lifecycle.deleteDataSyncItem==='function')return lifecycle.deleteDataSyncItem(idx,ev);alert('The TAK Map delete dialog is not ready. Reload TAK Map and try again.');return false}"
        html=re.sub(r"async function deleteDataSyncItem\(idx,ev\)\{.*?\}function drawDataSyncObjects",_ds_delegate+'function drawDataSyncObjects',html,count=1,flags=re.S)
        _local_delegate="async function localDataAction(kind,action){if(action==='delete'){const lifecycle=window.TakMapObjectLifecycleV486;if(lifecycle&&typeof lifecycle.localDataAction==='function')return lifecycle.localDataAction(kind,action);alert('The TAK Map delete dialog is not ready. Reload TAK Map and try again.');return false}const ids=selectedLocal(kind);if(!ids.length){alert('Select one or more '+localTypeLabel(kind,2)+' first.');return false}if(action==='goto'){centerSelectedLocal(kind,ids);return true}if(action==='export'){downloadLocalData(kind,ids);return true}if(action==='publish'){openLocalDataPublish(kind,ids);return true}return false}"
        html=re.sub(r"async function localDataAction\(kind,action\)\{.*?\}\nfunction renderLocalActions",_local_delegate+'\nfunction renderLocalActions',html,count=1,flags=re.S)
        _local_actions="function renderLocalActions(kind,items){const ids=selectedLocal(kind);if(!ids.length)return'';return `<div class=\"local-actions ${kind}\"><div class=\"local-actions-top\"><span id=\"localActionCount_${kind}\" class=\"muted local-selected-count\">${esc(localSelectedLabel(kind,ids.length))}</span></div><div class=\"local-action-buttons\"><button class=\"layer-button\" onclick=\"localDataAction('${kind}','goto')\">Go To</button><button class=\"layer-button\" onclick=\"localDataAction('${kind}','publish')\">Publish</button><button class=\"layer-button\" onclick=\"localDataAction('${kind}','export')\">Export</button><button class=\"layer-button\" data-tak-delete-source=\"local\" data-tak-delete-kind=\"${kind}\" onclick=\"return localDataAction('${kind}','delete')\">Delete</button></div></div>`}"
        html=re.sub(r"function renderLocalActions\(kind,items\)\{.*?\}\nfunction renderLocalSection",_local_actions+'\nfunction renderLocalSection',html,count=1,flags=re.S)
        html=html.replace('<button class="layer-button" onclick="deleteDataSyncItem(${idx},event)">Delete</button>','<button class="layer-button" data-tak-delete-source="datasync" data-tak-delete-index="${idx}" onclick="return deleteDataSyncItem(${idx},event)">Delete</button>')
        loader='<script id="takMapObjectLifecycleLoaderV486" src="/assets/runtime/tak-map-object-lifecycle-v491.js?v=1.3.0-i491"></script>'
        if 'takMapObjectLifecycleLoaderV486' not in html:
            html=html.replace('</body>',loader+'\n</body>',1) if '</body>' in html else html+loader
        return html
    TAK_MAP_HTML=_tak_object_patch_html(TAK_MAP_HTML); INDEX_HTML=TAK_MAP_HTML
except Exception as _tak_object_lifecycle_exc:
    try: print('TAK Map object lifecycle development patch failed:',_tak_object_lifecycle_exc)
    except Exception: pass
# --- end TAK Map i491 canonical object lifecycle patch ---


