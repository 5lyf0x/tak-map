# --- TAK Map i682: authoritative persisted Local Data, readback and safe API responses ---
# Release implementation: complete catalog preservation and non-destructive reload semantics.
# The canonical imports.json is the source of truth, not a browser cache or a
# stale read of the Data Sync service. Never interpret a failed read as [] here.
_I682_LOCAL_LOAD_BEFORE = load_json_file
_I682_LOCAL_ATOMIC_BEFORE = atomic_write_json
def _i682_marker_path():
    # Derive per catalog, including restored paths and test catalogs.
    return Path(TAK_MAP_IMPORT_FILE).parent / 'local-data-catalog-seen-i682.json'
_I682_LOCAL_MAX_FEATURES_PER_UPLOAD = 100000


def _i682_validate_catalog(document):
    if not isinstance(document, dict) or not isinstance(document.get('imports'), list):
        raise ValueError('Invalid Local Data catalog: expected imports array')
    for index, item in enumerate(document['imports']):
        if not isinstance(item, dict) or not isinstance(item.get('features'), list):
            raise ValueError('Invalid Local Data import record at index %s' % index)
        for feature in item['features']:
            if not isinstance(feature, dict):
                raise ValueError('Invalid Local Data feature at import index %s' % index)
    return document


def _i682_catalog_path_matches(path):
    return Path(path) == Path(TAK_MAP_IMPORT_FILE)


def _i682_note_existing_catalog():
    if _i682_marker_path().exists():
        return
    try:
        _I682_LOCAL_ATOMIC_BEFORE(_i682_marker_path(), {'initialized': True})
    except OSError:
        # A marker is advisory; never make valid user data unavailable because
        # a marker could not be created.
        pass


def load_json_file(path, default):
    if not _i682_catalog_path_matches(path):
        return _I682_LOCAL_LOAD_BEFORE(path, default)
    canonical = Path(path)
    if not canonical.is_file():
        if _i682_marker_path().exists():
            raise FileNotFoundError('Previously initialized Local Data catalog is missing: ' + str(canonical))
        return {'imports': []}
    try:
        document = _i682_validate_catalog(json.loads(canonical.read_text(encoding='utf-8')))
    except (OSError, ValueError, TypeError, UnicodeError) as exc:
        raise RuntimeError('Cannot load saved Local Data; preserving disk state: ' + str(exc)) from exc
    _i682_note_existing_catalog()
    return document


def _i682_canonical_digest(value):
    return hashlib.sha256(json_complete_dumps(value, ensure_ascii=False, sort_keys=True,
                                  separators=(',', ':')).encode('utf-8')).hexdigest()


def _i682_store_catalog(imports, retained=None):
    """Transactional write and exact readback of the entire, untruncated catalog.

    `retained` is used by append-only upload to prove every previous import is
    bytewise-equivalent at the JSON data level, including ALL route vertices.
    """
    proposed = _i682_validate_catalog({'imports': imports})
    if retained is not None:
        if len(proposed['imports']) < len(retained):
            raise RuntimeError('Local Data write would silently evict a prior import')
        for old, new in zip(retained, proposed['imports']):
            if _i682_canonical_digest(old) != _i682_canonical_digest(new):
                raise RuntimeError('Local Data write would modify an unrelated saved import')
    _I682_LOCAL_ATOMIC_BEFORE(TAK_MAP_IMPORT_FILE, proposed)
    saved = load_json_file(TAK_MAP_IMPORT_FILE, {'imports': []})
    if _i682_canonical_digest(saved) != _i682_canonical_digest(proposed):
        raise IOError('Local Data readback integrity check failed')
    return saved


def _i682_multipart_upload(handler):
    try:
        ctype = handler.headers.get('Content-Type', '')
        if 'multipart/form-data' not in ctype.lower():
            return handler._send_json({'ok': False, 'error': 'Expected multipart/form-data'}, 400)
        length = int(handler.headers.get('Content-Length', '0') or '0')
        if not 0 < length <= 90 * 1024 * 1024:
            return handler._send_json({'ok': False, 'error': 'Invalid upload size (maximum 90 MiB)'}, 413)
        uploaded = _parse_multipart_files(ctype, handler.rfile.read(length))
        if not uploaded:
            return handler._send_json({'ok': False, 'error': 'No files found in upload'}, 400)
        # Parse every file before any state mutation: malformed or over-limit
        # uploads must never partially erase a previously saved collection.
        parsed_files = []
        for filename, blob in uploaded:
            features = parse_map_file_bytes(filename, blob)
            if not features or (len(features) == 1 and features[0].get('kind') == 'other'
                                and 'Unsupported' in str(features[0].get('properties', {}).get('error', ''))):
                return handler._send_json({'ok': False, 'error': 'No supported map objects in ' + filename}, 422)
            if len(features) > _I682_LOCAL_MAX_FEATURES_PER_UPLOAD:
                return handler._send_json({'ok': False, 'error': 'Too many objects in ' + filename +
                    '; import was rejected without truncation or changing saved data'}, 413)
            parsed_files.append((filename, blob, features))
        with _TAK_LOCAL_OBJECT_LOCK:
            migrated = _tak_migrate_local_data_ids(False)
            old_imports = list(migrated['imports'])
            imports = list(old_imports)
            added = []
            for filename, blob, features in parsed_files:
                imp_id = secrets.token_hex(6)
                enriched = [_tak_enrich_local_feature(f, imp_id, filename, idx, assign=True)
                            for idx, f in enumerate(features)]
                imported = {'id': imp_id, 'name': filename,
                    'uploaded': datetime.now(timezone.utc).isoformat(),
                    'size_bytes': len(blob), 'features': enriched,
                    'counts': _import_summary(enriched)}
                imports.append(imported)
                added.append(imported)
            # Readback before acknowledging success; old objects must be identical.
            persisted = _i682_store_catalog(imports, retained=old_imports)
        return handler._send_json({'ok': True, 'added': added,
            'imports': persisted['imports'], 'object_lifecycle': {
                'version': 'i682', 'persistent_local_ids': True,
                'complete_geometry': True, 'catalog_verified': True}})
    except Exception as exc:
        return handler._send_json({'ok': False, 'error': 'Local Data upload failed: ' + str(exc)[:400]}, 500)

handle_tak_map_import_upload = _i682_multipart_upload


def _i682_delete_local_data(ids):
    requested = [str(x or '').strip() for x in (ids or []) if str(x or '').strip()]
    if not requested:
        return {'ok': False, 'error': 'No Local Data objects selected', 'deleted_ids': []}
    with _TAK_LOCAL_OBJECT_LOCK:
        migrated = _tak_migrate_local_data_ids(False)
        before = list(migrated['imports'])
        resolved, not_found, unsupported = _tak_resolve_local_requests(requested, before)
        targets = {object_id for _, object_id in resolved}
        keep_imports = []
        deleted = []
        for imp in before:
            kept = []
            for feature in imp['features']:
                oid = _tak_existing_local_object_id(feature)
                if oid and oid in targets:
                    deleted.append('local:' + oid)
                else:
                    kept.append(feature)
            if kept:
                cp = dict(imp)
                cp['features'] = kept
                cp['counts'] = _import_summary(kept)
                keep_imports.append(cp)
        if deleted:
            persisted = _i682_store_catalog(keep_imports)
            survivors = { _tak_existing_local_object_id(f) for imp in persisted['imports']
                          for f in imp['features'] }
            if any(value[6:] in survivors for value in deleted):
                raise RuntimeError('Deleted Local Data object is still present after readback')
        return {'ok': True, 'deleted': bool(deleted),
            'deleted_count': len(set(deleted)), 'deleted_ids': list(dict.fromkeys(deleted)),
            'not_found_ids': not_found, 'unsupported_ids': unsupported,
            'failed_ids': [], 'refresh_required': True,
            'object_lifecycle': {'version': 'i682', 'targeted': True,
                                 'catalog_verified': bool(deleted)}}

tak_map_local_data_delete = _i682_delete_local_data

# Avoid embedding the whole collection in mutation responses: prior builds could
# change a file on disk, then emit HTTP 500 serializing its enormous presentation
# payload, causing the UI to falsely report that a successful deletion failed.
_I682_OBJECT_DELETE_BEFORE = tak_map_object_delete

def tak_map_object_delete(object_ids, server_host=''):
    outcome = _I682_OBJECT_DELETE_BEFORE(object_ids, server_host)
    if isinstance(outcome, dict):
        outcome = dict(outcome)
        outcome.pop('imports', None)
        outcome['refresh_required'] = True
    return outcome

_I682_ROUTE_UPDATE_BEFORE = _i659_update_route

def _i659_update_route(payload):
    outcome, status = _I682_ROUTE_UPDATE_BEFORE(payload)
    if isinstance(outcome, dict):
        outcome = dict(outcome)
        outcome.pop('imports', None)
        if outcome.get('ok'):
            outcome['refresh_required'] = True
            outcome['catalog_verified'] = True
    return outcome, status

# Produce an explicit 503 for an unreadable Local Data catalog, not a misleading
# successful response containing zero objects. Keep the preceding auth behavior.
_I682_GET_BEFORE = Handler.do_GET

def _i682_get(self):
    if urlparse(self.path).path in ('/api/tak-map/imported', '/api/tak-map/import'):
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        try:
            result = tak_map_imported()
        except Exception as exc:
            return self._send_json({'ok': False, 'error': 'Saved Local Data could not be read: '+str(exc)[:220]}, 503)
        return self._send_json(result)
    return _I682_GET_BEFORE(self)

Handler.do_GET = _i682_get

