# --- TAK Map i594 discoverable locked-Mission metadata and protected-content gate ---
try:
    _I594_VERSION = 'i594'
    _I594_PACKAGE_VERSION = '1.3.0-i594'

    def _i594_locked_descriptor(row):
        mission = _i591_mission_name(row)
        if not mission and isinstance(row, dict):
            mission = _i591_text(row.get('mission'))
        return {
            'name': mission,
            'mission': mission,
            'passwordProtected': True,
            'password_protected': True,
            'protected': True,
            'locked': True,
            'unlocked': False,
            'metadata_only': True,
            'locked_descriptor_i594': True,
            'source': 'ots-mission-name-discovery-i594',
        }

    def _i594_access_rows(state, sess=None):
        rows = []
        for row in _i591_access_rows(state, sess):
            item = dict(row or {})
            item['version'] = _I594_VERSION
            item['mission_name_visible_while_locked'] = True
            item['protected_contents_withheld_while_locked'] = bool(item.get('locked'))
            rows.append(item)
        return rows

    def _i594_locked_payload(state, sess=None, locked_rows=None):
        locked_rows = list(locked_rows or _i591_locked_rows(state, sess))
        names, _uids = _i591_mark_locked_state(state, locked_rows, sess)
        access_rows = _i594_access_rows(state, sess)
        descriptors = [_i594_locked_descriptor(row) for row in access_rows if row.get('locked') and _i591_text(row.get('mission'))]
        return {
            'ok': True,
            'version': _I594_VERSION,
            'partial': True,
            'locked': True,
            'requires_mission_password': True,
            'mission_password_required': True,
            'objects': [],
            'missions': descriptors,
            'mission_content': [],
            'mission_uids': [],
            'mission_logs': [],
            'mission_roles': [],
            'packages': [],
            'sources': [],
            'message': 'Protected Mission names are visible. Enter the password from Edit before TAK Map downloads or displays Mission contents.',
            'warnings': ['One or more protected Missions are locked. Mission names remain visible, but protected contents are withheld.'],
            'mission_access_i594': access_rows,
            'mission_access_i591': access_rows,
            'mission_access_i576': access_rows,
            'data_sync_security_i594': {
                'version': _I594_VERSION,
                'backend_gate': True,
                'locked': True,
                'locked_mission_count': len(names),
                'mission_names_visible': True,
                'mission_contents_visible': False,
                'mission_api_content_requests_started': False,
                'postgresql_queries_started': False,
                'cached_locked_contents_returned': False,
                'browser_cache_eligible': True,
                'per_user_per_mission': True,
            },
        }

    def _i594_filter_security_view(payload, state, sess=None):
        if not isinstance(payload, dict):
            return payload, 200
        locked_rows = _i591_locked_rows(state, sess)
        access_rows = _i594_access_rows(state, sess)
        if not locked_rows:
            _i591_clear_locked_state(state)
            out = _i568_clone(payload)
            out['version'] = _I594_VERSION
            out['mission_access_i594'] = access_rows
            out['mission_access_i591'] = access_rows
            out['mission_access_i576'] = access_rows
            out['data_sync_security_i594'] = {
                'version': _I594_VERSION,
                'backend_gate': True,
                'locked': False,
                'mission_names_visible': True,
                'protected_contents_withheld_until_unlock': True,
                'per_user_per_mission': True,
            }
            return out, 200

        locked_names = {_i591_text(row.get('mission')).casefold() for row in locked_rows}
        names, locked_uids = _i591_mark_locked_state(state, locked_rows, sess)
        out = _i568_clone(payload)

        # Preserve only a sanitized name/lock descriptor for each locked Mission.
        # All Mission contents, UIDs, packages, logs, roles, and map objects remain
        # unavailable until OpenTAKServer accepts the per-user Mission password.
        kept_missions = []
        seen_missions = set()
        for row in list(out.get('missions') or []):
            mission = _i591_mission_name(row)
            folded = mission.casefold()
            if not mission or folded in locked_names:
                continue
            if folded in seen_missions:
                continue
            seen_missions.add(folded)
            kept_missions.append(row)
        for row in access_rows:
            mission = _i591_text(row.get('mission'))
            folded = mission.casefold()
            if not mission or not row.get('locked') or folded in seen_missions:
                continue
            seen_missions.add(folded)
            kept_missions.append(_i594_locked_descriptor(row))
        out['missions'] = kept_missions

        for key in ('mission_content', 'mission_uids', 'mission_logs', 'mission_roles', 'packages', 'objects'):
            rows = out.get(key)
            if not isinstance(rows, list):
                out[key] = [] if key in ('mission_content', 'mission_uids', 'packages', 'objects') else rows
                continue
            kept = []
            for row in rows:
                mission = _i591_mission_name(row).casefold()
                uid = _i591_uid(row).casefold()
                if (mission and mission in locked_names) or (uid and uid in locked_uids):
                    continue
                if isinstance(row, dict) and locked_names and not mission and (
                    row.get('is_mission_object') or row.get('mission_uid') or row.get('mission_name') or row.get('missionName')
                ):
                    continue
                kept.append(row)
            out[key] = kept

        out['mission_access_i594'] = access_rows
        out['mission_access_i591'] = access_rows
        out['mission_access_i576'] = access_rows
        out['partial'] = True
        out['locked'] = True
        out['requires_mission_password'] = True
        out['mission_password_required'] = True
        out['ok'] = True
        out['version'] = _I594_VERSION
        warnings = list(out.get('warnings') or []) if isinstance(out.get('warnings'), list) else []
        warning = 'One or more protected Missions are locked. Mission names remain visible, but protected contents are withheld.'
        if warning not in warnings:
            warnings.append(warning)
        out['warnings'] = warnings
        out['data_sync_security_i594'] = {
            'version': _I594_VERSION,
            'backend_gate': True,
            'locked': True,
            'locked_mission_count': len(names),
            'mission_names_visible': True,
            'protected_contents_withheld': True,
            'cached_locked_contents_removed': True,
            'per_user_per_mission': True,
        }
        return out, 200

    # Replace the i591 all-or-nothing 423 payload with a 200 response containing
    # only sanitized locked-Mission descriptors. Existing i591 callers resolve
    # these names dynamically, so replacing the globals updates the active route.
    _i591_locked_payload = _i594_locked_payload
    _i591_filter_security_view = _i594_filter_security_view
    globals()['_i591_locked_payload'] = _i591_locked_payload
    globals()['_i591_filter_security_view'] = _i591_filter_security_view

    def _i594_result(payload, status=200, ok=True, error='', **extra):
        try:
            return _i569_result(payload, status=status, ok=ok, error=error, **extra)
        except Exception:
            result = {
                'ok': bool(ok), 'status': int(status or 0),
                'body': _i568_clone(payload), 'json': _i568_clone(payload),
                'error': _i591_text(error),
                'identity_mode': 'per-user-enrolled-marti-certificate',
                'data_sync_worker_i594': True,
            }
            result.update(extra)
            return result

    # Discover the complete Mission name list with the authenticated per-user
    # client certificate, but immediately sanitize locked protected rows. The OTS
    # list endpoint may include UIDs and contents; none of those fields enter the
    # worker response, persisted snapshot, or browser payload until password
    # validation succeeds for that specific Mission.
    def _i568_parallel_acquisition(cfg, sess):
        started = time.monotonic()
        marti = _i591_text((cfg or {}).get('marti_url')).rstrip('/')
        api = _i591_text((cfg or {}).get('api_url') or (cfg or {}).get('base_url')).rstrip('/')
        token = _i591_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', '')) if '_I529_REQUEST_CONTEXT' in globals() else ''
        if not marti:
            return _i591_acquisition_before(cfg, sess)

        deadline = time.monotonic() + _I568_OVERALL_REFRESH_DEADLINE_SECONDS
        protected_path = _I569_DISCOVERY_PATH
        bare_path = '/Marti/api/missions'
        protected_url = marti + protected_path
        bare_url = marti + bare_path
        responses, timings = _i569_run_parallel([
            (protected_url, protected_path, 'discovery:marti-per-user-mission-names-i594', _I568_DISCOVERY_TIMEOUT_SECONDS),
            (bare_url, bare_path, 'discovery:marti-per-user-unprotected-i594', _I568_DISCOVERY_TIMEOUT_SECONDS),
        ], cfg, sess, token, deadline, 2)

        protected_result = responses.get(protected_url) or {}
        bare_result = responses.get(bare_url) or {}
        full_rows = _i569_mission_rows(_i568_result_body(protected_result)) if protected_result.get('ok') else []
        bare_rows = _i569_mission_rows(_i568_result_body(bare_result)) if bare_result.get('ok') else []
        bare_by_name = {_i591_mission_name(row).casefold(): row for row in bare_rows if _i591_mission_name(row)}
        full_by_name = {_i591_mission_name(row).casefold(): row for row in full_rows if _i591_mission_name(row)}

        ordered_names = []
        for row in full_rows + bare_rows:
            mission = _i591_mission_name(row)
            if mission and mission.casefold() not in {x.casefold() for x in ordered_names}:
                ordered_names.append(mission)
        # Preserve previously discovered protected names if a temporary metadata
        # discovery response is incomplete, but mark them as locked metadata only.
        for item in _i591_load_index(sess).values():
            mission = _i591_text(item.get('mission'))
            if item.get('protected') and mission and mission.casefold() not in {x.casefold() for x in ordered_names}:
                ordered_names.append(mission)

        mission_rows = []
        locked_names = []
        authorized_protected = 0
        authentication_failures = 0
        creator_uid = _i572_creator_uid()

        for mission in ordered_names[:100]:
            folded = mission.casefold()
            raw_full = full_by_name.get(folded)
            raw_bare = bare_by_name.get(folded)
            explicit_protected = _i591_row_protected(raw_full) if isinstance(raw_full, dict) else False
            # OpenTAKServer's bare list excludes protected Missions. A row found
            # only in the include-protected list is therefore protected even if
            # an older server omits the explicit boolean flag.
            protected = bool(explicit_protected or (raw_full is not None and raw_bare is None))
            q = quote(mission, safe='')
            detail_url = marti + '/Marti/api/missions/' + q
            contents_url = detail_url + '/contents'
            cot_url = detail_url + '/cot'

            if not protected:
                row = _i568_clone(raw_bare or raw_full or {'name': mission})
                row['name'] = mission
                row['passwordProtected'] = False
                mission_rows.append(row)
                _i591_remember_mission(mission, False, sess)
                responses[detail_url] = _i594_result(_i569_mission_payload(row), source='i594-unprotected-discovery-row-alias', network_request=False)
                responses[contents_url] = _i594_result(_i569_contents_payload(row), source='i594-unprotected-discovery-contents-alias', network_request=False)
                continue

            _i591_remember_mission(mission, True, sess)
            stored = _i572_load_password(mission, sess)
            subscription = None
            if stored.get('ok') and creator_uid:
                subscription = _i572_subscribe_with_password(mission, creator_uid, stored.get('password'))
            if not (subscription and subscription.get('ok')):
                if stored.get('ok'):
                    authentication_failures += 1
                if subscription and subscription.get('invalid_password'):
                    try:
                        _i572_remove_password(mission, sess)
                    except Exception:
                        pass
                    try:
                        _i564_invalidate_mission_token(mission, creator_uid)
                    except Exception:
                        pass
                _i591_invalidate_validation(mission, sess)
                descriptor = _i594_locked_descriptor({'mission': mission})
                mission_rows.append(descriptor)
                locked_names.append(mission)
                responses[detail_url] = _i594_result(_i569_mission_payload(descriptor), source='i594-locked-name-only-detail-alias', network_request=False, metadata_only=True)
                responses[contents_url] = _i594_result({'version': 3, 'type': 'MissionContent', 'data': []}, source='i594-locked-empty-contents-alias', network_request=False, metadata_only=True)
                responses[cot_url] = _i594_result(None, status=423, ok=False, error='Mission password required before protected CoT retrieval.', source='i594-locked-cot-skipped', network_request=False, metadata_only=True)
                continue

            _i591_mark_validated(mission, sess, subscription.get('token'), 'discoverable-protected-subscription-i594')
            detail = _ots_mission_api_request('/Marti/api/missions/' + q, method='GET', token=subscription.get('token'), timeout=8)
            detail_rows = _i569_mission_rows(_i568_result_body(detail)) if detail.get('ok') else []
            detail_row = detail_rows[0] if detail_rows else None

            # i595: OpenTAKServer's authorized single-Mission detail response may
            # omit the authoritative discovery row's embedded `uids` and
            # `contents` collections. Start with the complete include-protected
            # discovery record, overlay authorized detail metadata, and preserve
            # discovery-owned content collections. The complete row exists only
            # inside this authorized branch; locked browser payloads still receive
            # the sanitized name/lock descriptor created above.
            discovery_row = _i568_clone(raw_full) if isinstance(raw_full, dict) else {}
            row = discovery_row
            if isinstance(detail_row, dict):
                for merge_key, merge_value in detail_row.items():
                    if merge_key in ('uids', 'contents') and isinstance(discovery_row.get(merge_key), list):
                        continue
                    row[merge_key] = _i568_clone(merge_value)
            for content_key in ('uids', 'contents'):
                if isinstance(discovery_row.get(content_key), list):
                    row[content_key] = _i568_clone(discovery_row.get(content_key))
                elif isinstance((detail_row or {}).get(content_key), list):
                    row[content_key] = _i568_clone((detail_row or {}).get(content_key))
            if not row:
                row = {'name': mission}
            row['name'] = mission
            row['passwordProtected'] = True
            row['authorized_discovery_merge_i595'] = True
            mission_rows.append(row)

            # Feed the merged authorized row into the normal Data Sync parser.
            # Returning the raw detail response here would lose discovery UIDs
            # before snapshot construction on OTS versions that omit them.
            responses[detail_url] = _i594_result(
                _i569_mission_payload(row),
                source='i595-authorized-protected-detail-merged',
                network_request=bool(detail.get('ok')),
                upstream_status=int(detail.get('status') or 0),
            )
            responses[contents_url] = _i594_result(_i569_contents_payload(row), source='i595-authorized-protected-contents-alias', network_request=False)
            responses[cot_url] = _ots_mission_api_request('/Marti/api/missions/' + q + '/cot', method='GET', token=subscription.get('token'), timeout=8)
            authorized_protected += 1

        # Set the thread-local gate before tak_map_data_sync() considers the local
        # PostgreSQL source. This prevents locally available locked Mission rows
        # from bypassing the password boundary during the same worker cycle.
        _I591_CONTEXT.locked_missions = list(locked_names)

        aggregate = {'version': 3, 'type': 'Mission', 'data': _i568_clone(mission_rows)}
        safe_discovery = _i594_result(aggregate, source='i594-sanitized-mission-name-discovery', network_request=bool(protected_result.get('ok') or bare_result.get('ok')), locked_descriptor_count=len(locked_names))
        responses[protected_url] = _i568_clone(safe_discovery)
        responses[bare_url] = _i568_clone(safe_discovery)
        if api:
            responses[api + '/api/missions'] = _i568_clone(safe_discovery)

        discovery_ok = bool(protected_result.get('ok') or bare_result.get('ok'))
        return {
            'responses': responses,
            'mission_names': [mission for mission in ordered_names[:100]],
            'mission_rows': mission_rows,
            'timings': sorted(timings, key=lambda row: str(row.get('endpoint') or '')),
            'summary': {
                'version': _I594_VERSION,
                'phase': 'sanitized-name-discovery-and-authorized-content',
                'discovery_ok': discovery_ok,
                'authoritative_discovery': _I569_DISCOVERY_PATH,
                'mission_count': len(mission_rows),
                'locked_protected_mission_count': len(locked_names),
                'authorized_protected_mission_count': authorized_protected,
                'authentication_failure_count': authentication_failures,
                'mission_names_visible_before_password': True,
                'locked_descriptor_fields': ['name', 'mission', 'passwordProtected', 'password_protected', 'protected', 'locked', 'unlocked', 'metadata_only', 'locked_descriptor_i594', 'source'],
                'locked_contents_exposed': False,
                'network_get_contents_calls': 0,
                'per_user_certificate': True,
                'mission_password_gate_before_contents': True,
                'duration_seconds': round(time.monotonic() - started, 4),
            },
        }
    globals()['_i568_parallel_acquisition'] = _i568_parallel_acquisition

    # Bypass i591's pre-discovery "all locked" abort. The i594 acquisition above
    # performs only sanitized name discovery for locked Missions and sets the
    # PostgreSQL gate before any local Mission data can be queried.
    def _i568_build_snapshot(cfg, sess, token, reason):
        key = _i568_state_key(cfg or {}, sess or {})
        state = _i568_state(key)
        _I591_CONTEXT.locked_missions = []
        try:
            result, acquired = _i591_build_before(cfg, sess, token, reason)
            result, _status = _i594_filter_security_view(result, state, sess)
            if isinstance(result, dict):
                result['version'] = _I594_VERSION
                result['discoverable_locked_missions_i594'] = {
                    'version': _I594_VERSION,
                    'mission_names_visible_before_password': True,
                    'protected_contents_withheld_until_password_validation': True,
                    'locked_mission_count': len([row for row in _i594_access_rows(state, sess) if row.get('locked')]),
                }
            return result, acquired
        finally:
            _I591_CONTEXT.locked_missions = []
    globals()['_i568_build_snapshot'] = _i568_build_snapshot

    # Always permit the background worker to refresh Mission-name metadata while
    # Missions are locked. Content acquisition remains blocked per Mission.
    def _i568_schedule_refresh(key, cfg, sess, token, reason, force=False):
        state = _i568_state(key)
        locked = _i591_locked_rows(state, sess)
        if locked:
            _i591_mark_locked_state(state, locked, sess)
        return _i591_schedule_before(key, cfg, sess, token, reason, force)
    globals()['_i568_schedule_refresh'] = _i568_schedule_refresh

    _i594_get_before = Handler.do_GET
    def _i594_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/data-sync':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session()
            auth_mode = _i591_text((sess or {}).get('auth_mode'))
            if not auth_mode.startswith('ots-'):
                return _i594_get_before(self)
            _i555_set_request_context(self)
            try:
                cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
                token = self._tak_map_token() if callable(getattr(self, '_tak_map_token', None)) else ''
                key = _i568_state_key(cfg or {}, sess or {})
                state = _i568_state(key)
                for item in list(_i591_index_snapshot(state, sess).values()):
                    mission = _i591_text(item.get('mission'))
                    if not mission or not bool(item.get('protected')):
                        continue
                    if _i572_load_password(mission, sess).get('ok') and not _i591_is_validated(mission, sess):
                        _i591_validate_stored_password(mission, sess)
                query = parse_qs(parsed.query or '')
                force = _i591_text((query.get('force') or ['0'])[0]).casefold() in ('1', 'true', 'yes', 'on')
                reason = _i591_text((query.get('reason') or [''])[0]) or ('manual' if force else 'poll')
                with _I568_STATE_LOCK:
                    last_success = float(state.get('last_success_epoch') or 0)
                    stale = not last_success or (time.time() - last_success >= _I568_SNAPSHOT_MAX_AGE_SECONDS)
                if force or stale:
                    _i568_schedule_refresh(key, cfg or {}, sess or {}, token, reason, force=force)
                payload = _i568_response_payload(state)
                payload, status = _i594_filter_security_view(payload, state, sess)
                return self._send_json(payload, status)
            finally:
                _i555_clear_request_context()
        return _i594_get_before(self)
    Handler.do_GET = _i594_do_get

    _i594_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i594_config_before() or {})
        cfg['version'] = _I594_PACKAGE_VERSION
        cfg['tak_map_iteration'] = _I594_VERSION
        cfg['discoverable_locked_missions_i594'] = {
            'version': _I594_VERSION,
            'ots_discovered_mission_names_visible_before_password': True,
            'operator_never_types_mission_name': True,
            'edit_button_uses_discovered_mission_name': True,
            'locked_descriptor_is_name_and_lock_state_only': True,
            'protected_contents_withheld_until_ots_password_validation': True,
            'multiple_locked_missions_supported': True,
            'mixed_locked_and_unlocked_missions_supported': True,
            'locked_metadata_refresh_allowed': True,
            'http_locked_status_replaced_with_sanitized_200': True,
        }
        startup = dict(cfg.get('startup_architecture_i593') or cfg.get('startup_architecture_i592') or {})
        startup.update({'package_version': _I594_VERSION,
                        'startup_loader_cache_identity': _I594_PACKAGE_VERSION,
                        'manifest_cache_identity': _I594_PACKAGE_VERSION,
                        'data_sync_control_cache_identity': _I594_PACKAGE_VERSION})
        cfg['startup_architecture_i594'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i594_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+(?:-[A-Za-z0-9_-]+)?', _I594_PACKAGE_VERSION, html)
        html = re.sub(r'TAKDashboard/i\d+(?:-[A-Za-z0-9_-]+)?', 'TAKDashboard/i594', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i594', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i594\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i594\2', html)
        return html

    TAK_MAP_HTML = _i594_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i594_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I594_VERSION
except Exception as _i594_exc:
    try:
        print('TAK Map i594 discoverable locked-Mission patch failed:', _i594_exc)
    except Exception:
        pass
# --- end TAK Map i594 discoverable locked-Mission metadata and protected-content gate ---


