# --- TAK Map 1.4.0-i641 verified native Shape geometry editor ---
try:
    _I639_VERSION='i641'
    _I639_PACKAGE_VERSION='1.4.0-i641'

    def _i639_shape_number(value, name, minimum=None, maximum=None):
        try:
            number=float(value)
        except Exception:
            raise ValueError(f'Invalid {name}.')
        if not math.isfinite(number):
            raise ValueError(f'Invalid {name}.')
        if minimum is not None and number < minimum:
            raise ValueError(f'{name} is below the supported minimum.')
        if maximum is not None and number > maximum:
            raise ValueError(f'{name} is above the supported maximum.')
        return number

    def _i639_shape_point(value):
        if not isinstance(value,(list,tuple)) or len(value)<2:
            raise ValueError('Invalid shape vertex.')
        lat=_i639_shape_number(value[0],'latitude',-90.0,90.0)
        lon=_i639_shape_number(value[1],'longitude',-180.0,180.0)
        return [lat,lon]

    def _i639_same_point(a,b,tol=1e-9):
        return bool(a and b and abs(float(a[0])-float(b[0]))<=tol and abs(float(a[1])-float(b[1]))<=tol)

    def _i639_validate_shape_geometry(value):
        if not isinstance(value,dict):
            raise ValueError('Missing Shape geometry.')
        out=dict(value)
        kind=str(out.get('kind') or '').strip().lower()
        cot_type=str(out.get('cot_type') or '').strip().lower()
        allowed={'rectangle','polygon','freeform','circle','ellipse'}
        if kind not in allowed:
            raise ValueError('Unsupported Shape geometry type.')
        expected={
            'rectangle':{'u-d-r'},
            'polygon':{'u-d-p'},
            'freeform':{'u-d-f','u-d-f-m'},
            'circle':{'u-d-c-c','u-r-b-c-c'},
            'ellipse':{'u-d-c-e'},
        }
        if cot_type and cot_type not in expected[kind]:
            raise ValueError(f'Shape type mismatch for {kind}.')
        coords=[]
        for raw in out.get('coords') or []:
            p=_i639_shape_point(raw)
            if not coords or not _i639_same_point(coords[-1],p):
                coords.append(p)
        if len(coords)>1 and _i639_same_point(coords[0],coords[-1]):
            coords.pop()
        minimum=2 if kind=='freeform' else 3
        if kind in ('rectangle','polygon','freeform') and len(coords)<minimum:
            raise ValueError('Shape does not contain enough unique vertices.')
        if kind=='rectangle' and len(coords)!=4:
            raise ValueError('Rectangle requires exactly four unique corners.')
        if len(coords)>5000:
            raise ValueError('Shape contains too many editable vertices.')
        center=out.get('center')
        if isinstance(center,(list,tuple)) and len(center)>=2:
            center=_i639_shape_point(center)
        elif coords:
            center=[sum(p[0] for p in coords)/len(coords),sum(p[1] for p in coords)/len(coords)]
        else:
            raise ValueError('Shape center is missing.')
        if kind in ('circle','ellipse'):
            major=_i639_shape_number(out.get('major_m'),'major radius',0.01,20000000.0)
            minor=_i639_shape_number(out.get('minor_m') if out.get('minor_m') is not None else major,'minor radius',0.01,20000000.0)
            if kind=='circle': minor=major
            angle=_i639_shape_number(out.get('angle_deg') or 0.0,'rotation',-1000000.0,1000000.0)%360.0
            out['major_m']=major; out['minor_m']=minor; out['angle_deg']=angle
        out['coords']=coords
        out['center']=center
        out['kind']=kind
        out['cot_type']=cot_type
        out['uid']=str(out.get('uid') or '').strip()
        out['name']=str(out.get('name') or '').strip()[:512]
        out['notes']=str(out.get('notes') or '')[:10000]
        out['raw_cot_i636']=str(out.get('raw_cot_i636') or '')
        out['mission_names']=[str(x).strip() for x in (out.get('mission_names') or []) if str(x).strip()][:128]
        out['is_mission_object']=bool(out.get('is_mission_object'))
        return out

    def _i639_xml_parent_map(root):
        return {child:parent for parent in root.iter() for child in list(parent)}

    def _i639_xml_detail(root):
        detail=_i636_find_first(root,'detail') if callable(globals().get('_i636_find_first')) else None
        if detail is not None: return detail
        return ET.SubElement(root,'detail')

    def _i639_update_vertex_links(root, coords):
        parent_map=_i639_xml_parent_map(root)
        links=[]
        for node in root.iter():
            if _i636_local_name(node.tag)=='link' and str(node.attrib.get('point') or '').strip():
                links.append(node)
        # Preserve each existing link node and all of its unknown attributes/children
        # whenever possible. Only point geometry is changed.
        for idx,p in enumerate(coords):
            if idx < len(links):
                links[idx].attrib['point']=f'{p[0]:.7f},{p[1]:.7f},0.0'
                continue
            if links:
                template=links[-1]
                try:
                    node=ET.fromstring(ET.tostring(template,encoding='unicode'))
                    node.attrib['point']=f'{p[0]:.7f},{p[1]:.7f},0.0'
                    parent=parent_map.get(template) or _i639_xml_detail(root)
                    parent.insert(list(parent).index(template)+1,node)
                    links.append(node); parent_map[node]=parent
                    continue
                except Exception:
                    pass
            ET.SubElement(_i639_xml_detail(root),'link',{'point':f'{p[0]:.7f},{p[1]:.7f},0.0'})
        # Extra historical point links are topology, not metadata. Remove only the
        # surplus point links; unrelated link/detail nodes remain byte-semantically present.
        for node in links[len(coords):]:
            parent=parent_map.get(node)
            if parent is not None:
                try: parent.remove(node)
                except Exception: pass

    def _i639_patch_shape_raw_cot(geometry):
        geom=_i639_validate_shape_geometry(geometry)
        raw=geom.get('raw_cot_i636') or ''
        if not raw:
            raise ValueError('Mission Shape cannot be edited safely without its preserved raw CoT.')
        try:
            root=ET.fromstring(raw.encode('utf-8'))
        except Exception as exc:
            raise ValueError(f'Preserved Shape CoT is invalid: {exc}')
        uid=str(root.attrib.get('uid') or '').strip()
        cot_type=str(root.attrib.get('type') or '').strip().lower()
        if geom.get('uid') and uid and geom['uid']!=uid:
            raise ValueError('Shape UID changed during edit; save refused.')
        if geom.get('cot_type') and cot_type and geom['cot_type']!=cot_type:
            raise ValueError('Shape CoT type changed during edit; save refused.')
        if not uid:
            raise ValueError('Preserved Shape CoT is missing its UID.')
        now=datetime.now(timezone.utc); stale=now+timedelta(days=1)
        root.attrib['time']=_cot_time(now); root.attrib['start']=_cot_time(now); root.attrib['stale']=_cot_time(stale)
        point=_i636_find_first(root,'point')
        if point is None: point=ET.SubElement(root,'point')
        center=geom['center']; point.attrib['lat']=f'{center[0]:.7f}'; point.attrib['lon']=f'{center[1]:.7f}'
        point.attrib.setdefault('hae','0'); point.attrib.setdefault('ce','9999999.0'); point.attrib.setdefault('le','9999999.0')
        detail=_i639_xml_detail(root)
        name=geom.get('name') or ''
        if name:
            contact=_i636_find_first(root,'contact')
            if contact is None: contact=ET.SubElement(detail,'contact')
            contact.attrib['callsign']=name
        remarks=_i636_find_first(root,'remarks')
        if remarks is None: remarks=ET.SubElement(detail,'remarks')
        remarks.text=geom.get('notes') or ''
        if geom['kind'] in ('circle','ellipse'):
            ellipse=_i636_find_first(root,'ellipse')
            if ellipse is None:
                raise ValueError('Native circle/ellipse CoT is missing its ellipse geometry node.')
            ellipse.attrib['major']=f"{geom['major_m']:.3f}"
            ellipse.attrib['minor']=f"{geom['minor_m']:.3f}"
            if geom['kind']=='ellipse': ellipse.attrib['angle']=f"{geom['angle_deg']:.3f}"
        else:
            _i639_update_vertex_links(root,geom['coords'])
        xml='<?xml version="1.0" encoding="UTF-8"?>\n'+ET.tostring(root,encoding='unicode',short_empty_elements=True)
        geom['uid']=uid; geom['cot_type']=cot_type or geom.get('cot_type') or ''
        geom['raw_cot_i636']=xml
        return geom,xml

    _i639_popup_update_before=tak_map_popup_edit_update
    def tak_map_popup_edit_update(payload):
        payload=payload if isinstance(payload,dict) else {}
