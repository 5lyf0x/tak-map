                token=use_token,timeout=20,
            )
            record=dict(result or {}); record.update({'method':'PUT','path':path,'body':{'uids':[_i643_text(uid)]},'token_used':bool(use_token),'token_source':source})
            attempts.append(record)
            status=int(record.get('status') or 0)
            if record.get('ok') or status==409:
                return {'ok':True,'status':status or 200,'mission':mission,'event_uid':uid,'method':'PUT','path':path,'association_endpoint':'mission-contents-uids','token_used':bool(use_token),'token_source':source,'already_associated':status==409,'attempts':attempts}
            # A token rejected by this OTS deployment is allowed to fall back to
            # the same authenticated per-user certificate with no Mission token.
            if use_token and status in (400,401,403):
