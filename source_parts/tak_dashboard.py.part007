            base=dict(base); base['edit']=edit; base['edits']=data; base['shape_geometry_i639']=geom
            base['shape_edit_i639']={'canonical_tak_geometry':True,'uid_preserved':True,'mission_membership_preserved':True,'server_cot_updated':bool(geom.get('is_mission_object')),'server_send':server_send or {},'persisted_overlay':True,'readback_contract':'data-sync-applies-persisted-shape-geometry','saved_uid':geom.get('uid') or '','saved_at':edit.get('updated') or ''}
            return base
        except Exception as exc:
            return {'ok':False,'error':str(exc)}
    globals()['tak_map_popup_edit_update']=tak_map_popup_edit_update

    _i639_apply_popup_before=_apply_popup_edit
    def _apply_popup_edit(obj, edits=None):
        original=obj
        out=_i639_apply_popup_before(obj,edits)
        if not isinstance(out,dict): return out
        source=edits if isinstance(edits,dict) else _load_popup_edits()
        items=source.get('items') if isinstance(source.get('items'),dict) else {}
        edit=None; key_used=''
        for key in _popup_edit_key_candidates(original if isinstance(original,dict) else out):
            candidate=items.get(key)
            if isinstance(candidate,dict) and isinstance(candidate.get('shape_geometry_i639'),dict):
                edit=candidate; key_used=key; break
        if edit is None:
            uid=str(out.get('uid') or out.get('cot_uid') or out.get('event_uid') or out.get('source_id') or out.get('id') or '').strip().casefold()
            if uid:
                for key,candidate in items.items():
                    if not isinstance(candidate,dict) or not isinstance(candidate.get('shape_geometry_i639'),dict): continue
                    if str(candidate['shape_geometry_i639'].get('uid') or '').strip().casefold()==uid:
                        edit=candidate; key_used=str(key); break
        if edit is None: return out
        try: geom=_i639_validate_shape_geometry(edit.get('shape_geometry_i639'))
        except Exception: return out
        out=dict(out)
        edit_name=str(edit.get('name') or geom.get('name') or '').strip()
        if edit_name: out['name']=edit_name; out['callsign']=edit_name
        if 'notes' in edit or geom.get('notes') is not None:
            edit_notes=str(edit.get('notes') if 'notes' in edit else geom.get('notes') or '')
            out['notes']=edit_notes; out['remarks']=edit_notes
        out['coords']=[list(p) for p in geom.get('coords') or []]
        center=geom.get('center') or []
        if len(center)>=2: out['lat']=float(center[0]); out['lon']=float(center[1])
        if geom.get('kind') in ('circle','ellipse'):
            out['major_m_i636']=float(geom.get('major_m'))
            out['minor_m_i636']=float(geom.get('minor_m'))
            out['angle_deg_i636']=float(geom.get('angle_deg') or 0.0)
        if geom.get('raw_cot_i636'): out['raw_cot_i636']=geom.get('raw_cot_i636')
        out['shape_edit_geometry_i639']=True
        out['popup_edit']=dict(out.get('popup_edit') or {},key=key_used,updated=edit.get('updated'))
        return out
    globals()['_apply_popup_edit']=_apply_popup_edit

