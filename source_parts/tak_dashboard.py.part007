    if isinstance(config,dict):
        config = dict(config)
        config.update({'version':_I001_PACKAGE, 'tak_map_iteration':_I001_ITERATION})
    return config

# Serialize all catalog read-modify-write operations against the rename/upsert path.
def _i001_catalog_locked(func):
    def guarded(*args, **kwargs):
        with _I001_OFFLINE_RECORD_LOCK:
            return func(*args, **kwargs)
    guarded.__name__=func.__name__
    guarded.__doc__=func.__doc__
    return guarded
handle_tak_map_offline_upload = _i001_catalog_locked(handle_tak_map_offline_upload)
tak_map_offline_delete = _i001_catalog_locked(tak_map_offline_delete)
tak_map_offline_eud_package = _i001_catalog_locked(tak_map_offline_eud_package)

# The i620 guard owns mutation interception; change its existing constants in the
# final HTML and every login HTML instead of installing a second guard.
def _i001_release_html(html):
    html = str(html)
    # The current i699 map may have dropped the i620 guard from the main page;
    # the login page can still contain its older i638 package variant.
    html = re.sub(
        r"const RELEASE='1\.4\.0',ITERATION='i\d+',PACKAGE='1\.4\.0-i\d+'",
        "const RELEASE='1.5.0',ITERATION='i002',PACKAGE='1.5.0-i002'", html)
    # Reuse the existing i665 footer authority, which was advanced to i699
    # in the prior release, avoiding a second competing MutationObserver.
    html = re.sub(
        r"(id=\"takMapReleaseAuthorityI665\"[^>]*>.*?const iteration=)'i\d+',version='1\.4\.0'",
        r"\g<1>'i002',version='1.5.0'", html, flags=re.S)
    html = re.sub(r'(<span class="release-main">)[^<]*(</span>)',r'\g<1>1.5.0\2',html)
    html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\g<1>i002\2',html)
    html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\g<1>i002\2',html)
    html = re.sub(r'([?&]v=)1\.4\.0-i\d+',r'\g<1>1.5.0-i002',html)
    html = re.sub(r'([?&]v=)1\.5\.0-i001',r'\g<1>1.5.0-i002',html)
    html = html.replace('tak-map-v1.4.0-i699.zip','tak-map-v1.5.0-i002.zip')
    return html

TAK_MAP_HTML = _i001_release_html(TAK_MAP_HTML)
INDEX_HTML = TAK_MAP_HTML
TAK_MAP_LOGIN_HTML = _i001_release_html(TAK_MAP_LOGIN_HTML)
LOGIN_HTML = TAK_MAP_LOGIN_HTML
TAK_MAP_ITERATION = _I001_ITERATION
# --- end TAK Map v1.5.0-i001 ---

# --- TAK Map v1.5.0-i003: faster read-only offline tile delivery ---
import tak_map_offline_perf_i003 as _offline_perf_i003
_I003_TILE_STORE = _offline_perf_i003.OfflineTileStore(
    max_per_map=int(os.environ.get('TAK_MAP_OFFLINE_POOL_PER_MAP','3')),
    max_global=int(os.environ.get('TAK_MAP_OFFLINE_POOL_GLOBAL','12')))
import atexit as _i003_atexit
_i003_atexit.register(_I003_TILE_STORE.invalidate)

_I003_PREVIOUS_SAVE = _save_offline_maps
def _save_offline_maps(maps):
    result = _I003_PREVIOUS_SAVE(maps)
    _I003_TILE_STORE.invalidate()
    return result

# Fully bounded catalog reads plus 12 global / 3 per-map read-only SQLite
# connections, with exclusive checkout across ephemeral HTTP request threads.
def _mbtiles_tile_bytes(map_id,z,x,y):
    r=_I003_TILE_STORE.fetch(TAK_MAP_OFFLINE_FILE,map_id,z,x,y)
    return r.data,r.ctype

_I003_PREVIOUS_GET = Handler.do_GET
_I003_PREVIOUS_POST = Handler.do_POST
_I003_TILE_PATH = re.compile(r'^/api/tak-map/offline-tile/([^/]+)/(\d+)/(\d+)/(\d+)\.(?:png|jpg|jpeg|webp)$')

def _i003_tile_http_get(self):
    found=_I003_TILE_PATH.fullmatch(urlparse(self.path).path)
    if found:
        if not self._tak_map_auth_ok(): return self._require_tak_map_login()
        mid,z,x,y=unquote(found.group(1)),*map(int,found.group(2,3,4))
        result=_I003_TILE_STORE.fetch(TAK_MAP_OFFLINE_FILE,mid,z,x,y)
        headers={'Cache-Control':'private, max-age=86400' if result.completed and result.data is not None else 'private, no-store',
                 'Vary':'Cookie','X-Content-Type-Options':'nosniff'}
        if result.data is None:
            status=503 if result.status=='error' else 404
            self.send_response(status)
            for k,v in headers.items():self.send_header(k,'private, no-store' if k=='Cache-Control' else v)
            self.send_header('X-TAK-Offline-Tile-Status',result.status)
            if status==503:self.send_header('Retry-After','1')
            self.send_header('Content-Length','0')
            self.end_headers();return
        self.send_response(200)
        self.send_header('Content-Type',result.ctype)
        self.send_header('Content-Length',str(len(result.data)))
        for k,v in headers.items():self.send_header(k,v)
        self.end_headers()
        if self.command != 'HEAD':self.wfile.write(result.data)
        if os.environ.get('TAK_MAP_OFFLINE_TILE_DIAGNOSTICS')=='1':
            stats=_I003_TILE_STORE.diagnostic_summary()
            if stats.get('requests',0)%100==0:
                print('TAK Map offline i003 metrics: '+str({k:stats.get(k) for k in
                      ('requests','catalog_parses','catalog_hits','sqlite_opens','pool_reuses','pool_timeouts','p50_ms','p95_ms','connections_open')}),flush=True)
        return
    return _I003_PREVIOUS_GET(self)

def _i003_tile_scheme_update(map_id,scheme):
    if not isinstance(map_id,str) or not map_id or len(map_id)>180:return {'ok':False,'error':'Invalid map ID.'},400
    if scheme not in ('tms','xyz'):return {'ok':False,'error':'Tile rows must be TMS or XYZ.'},400
    with _I001_OFFLINE_RECORD_LOCK:
        maps=_load_offline_maps()
        target=next((m for m in maps if str(m.get('id'))==map_id),None)
        if not target:return {'ok':False,'error':'Offline map not found.'},404
        if str(target.get('created_by') or '').lower()=='download':
            return {'ok':False,'error':'Downloaded TAK Map packs always use TMS tile rows.'},409
        target['tile_row_scheme']=scheme
        target['updated']=datetime.now(timezone.utc).isoformat()
        _save_offline_maps(maps)
        return {'ok':True,'map':dict(target),'maps':_load_offline_maps()},200

def _i003_tile_http_post(self):
    if urlparse(self.path).path=='/api/tak-map/offline-row-scheme-i003':
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        try:
            payload=_read_json_body(self)
            result,status=_i003_tile_scheme_update(payload.get('id'),payload.get('tile_row_scheme'))
            return self._send_json(result,status,headers={'Cache-Control':'no-store'})
        except Exception as exc:
            return self._send_json({'ok':False,'error':str(exc)},500)
    return _I003_PREVIOUS_POST(self)

Handler.do_GET=_i003_tile_http_get
Handler.do_POST=_i003_tile_http_post

# Existing installed packs need no migration. Dynamic generation query tokens
# change only when catalog content generation changes, including resume/replace.
def _i003_tile_generation(m):
    return str(m.get('updated') or m.get('uploaded') or m.get('id') or '1')
def _i003_decorate_entry(entry,m):
    entry=dict(entry)
    entry['minZoom']=0 if m.get('min_zoom') is None else int(m['min_zoom'])
    entry['maxZoom']=22  # map navigation can upscale last native level
    entry['minNativeZoom']=entry['minZoom']
    entry['maxNativeZoom']=int(m.get('max_zoom') if m.get('max_zoom') is not None else 22)
    entry['bounds']=m.get('bounds') or ''
    entry['tile_row_scheme']=m.get('tile_row_scheme') or 'tms'
    entry['url']=entry['url']+'?generation='+quote(_i003_tile_generation(m),safe='')
    return entry

