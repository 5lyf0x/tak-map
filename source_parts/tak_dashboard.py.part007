# --- TAK Map i662: native Command Slate Mesh UI and Mission lifecycle ---
_i662_prev_get=Handler.do_GET
def _i662_get(self):
    return _i662_prev_get(self)
Handler.do_GET=_i662_get
_i662_prev_post=Handler.do_POST
def _i662_post(self):
    path=urlparse(self.path).path
    if path not in ('/api/tak-map/mesh/control', '/api/tak-map/mesh/mission-create', '/api/tak-map/mesh/mission-invite'):
        return _i662_prev_post(self)
    if not (self._tak_map_auth_ok() and self._auth_ok() and self._is_secure_request()):
        return self._send_json({'ok':False,'error':'HTTPS TAK Map and Dashboard administrator sessions required.'},403)
    try:
        payload=_read_json_body(self)
        if path.endswith('/control'):
            result=TOKEN_MESH_I660.set_mesh_enabled(payload.get('enabled'))
            if not result['meshEnabled']:
                TOKEN_MESH_NETWORK_I660._close()  # no waiting for the periodic discovery cycle
            return self._send_json(result)
        if path.endswith('/mission-create'):
            return self._send_json(TOKEN_MESH_I660.create_mission(payload.get('name')))
        token=TOKEN_MESH_I660.mission_invite(payload.get('missionId'))
        mission=TOKEN_MESH_I660.mission_list()
        found=next((m for m in mission if m['mission']==payload.get('missionId')),None)
        if not found:raise ValueError('Mission binding not found')
        try:
            from token_mesh_i660 import mission_invite_png
            qr=base64.b64encode(mission_invite_png(found['name'],token)).decode('ascii')
        except (ValueError,OSError):qr=None
        return self._send_json({'ok':True,'invite':token,'missionName':found['name'],'qrPngBase64':qr})
    except (ValueError,TypeError,KeyError) as exc:
        return self._send_json({'ok':False,'error':str(exc)},400)
