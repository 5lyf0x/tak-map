_i665_runtime_version='''<script id="takMapReleaseAuthorityI665">(function(){'use strict';
 const iteration='i665',version='1.4.0';function set(){
 document.querySelectorAll('.iteration-chip,.iteration-marker').forEach(el=>{if(el.textContent.trim()!==iteration)el.textContent=iteration});
 document.querySelectorAll('.version-panel [data-tak-map-release]').forEach(el=>{if(el.textContent.trim()!==version+'-'+iteration)el.textContent=version+'-'+iteration});
 }if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',set);else set();
 setTimeout(set,500);setTimeout(set,1750);setInterval(set,5000);
 const guard=()=>{const marks=[...document.querySelectorAll('.iteration-chip,.iteration-marker')];for(const el of marks){const obs=new MutationObserver(()=>{if(el.textContent.trim()!==iteration)set()});obs.observe(el,{subtree:true,childList:true,characterData:true})}};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',guard);else guard();
})();</script>'''
