from road_search_i678 import RoadSearchIndex as _I678RoadSearchIndex
_I678_ROAD_NAMES = _I678RoadSearchIndex()
_i678_prev_get = Handler.do_GET
_i678_prev_post = Handler.do_POST

def _i678_get(self):
    path = urlparse(self.path).path
    if path in ('/assets/runtime/tak-map-route-input-i678.js','/assets/runtime/tak-map-road-search-i678.js'):
        if not _i651_authorize(self):return
        name=path.rsplit('/',1)[-1]
        payload=(Path(__file__).resolve().parent/'assets'/name).read_bytes()
        self.send_response(200)
        self.send_header('Content-Type','application/javascript; charset=utf-8')
        self.send_header('Cache-Control','private, no-store')
        self.send_header('Content-Length',str(len(payload)))
        self.end_headers()
        if self.command!='HEAD':self.wfile.write(payload)
        return
    if path == '/api/tak-map/roads/search-i678':
        if not _i651_authorize(self):return
        try:
            params = parse_qs(urlparse(self.path).query)
            region = str(params.get('region',['us-west'])[0])
            q = str(params.get('q',[''])[0])[:120]
            coords = None
            if 'lat' in params and 'lon' in params:
                lat=float(params['lat'][0]);lon=float(params['lon'][0])
                if not (-90 <= lat <= 90 and -180 <= lon <= 180):raise ValueError('Invalid search origin')
                coords=(lat,lon)
            return self._send_json({'ok':True,'results':_I678_ROAD_NAMES.query(q,region,coords),
                                     'index_ready':_I678_ROAD_NAMES._db(region).is_file()})
        except (ValueError,OSError) as exc:
            return self._send_json({'ok':False,'error':str(exc)[:200]},400)
    if path == '/api/tak-map/roads/index/status-i678':
        if not _i651_authorize(self):return
        return self._send_json({'ok':True,**_I678_ROAD_NAMES.status()})
    return _i678_prev_get(self)

def _i678_post(self):
    if urlparse(self.path).path != '/api/tak-map/roads/index/start-i678':
        return _i678_prev_post(self)
    if not _i651_authorize(self,admin=True,mutation=True):return
    try:
        data = _i651_json_input(self)
        return self._send_json({'ok':True,**_I678_ROAD_NAMES.start(data.get('region'))},202)
    except (ValueError,OSError) as exc:
        return self._send_json({'ok':False,'error':str(exc)[:240]},409)
Handler.do_GET = _i678_get
Handler.do_POST = _i678_post

