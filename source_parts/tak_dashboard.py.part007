# --- TAK Map staged optional Gateway Data / Replay client authentication ---
# Released as TAK Map v1.4.0-i644; i643 Shape module remains versioned i643.
# Replay transport/payload/period/search/chunk handling remains in the established
# v415 proxy. This layer changes only its configuration and TLS client identity.
try:
    def _tak_gateway_auth_mode(raw, allow_auto=False):
        value = str(raw or '').strip().lower().replace('_', '-')
        if value in ('certificate', 'client-certificate', 'mtls', 'm-tls'):
            return 'certificate'
        if value in ('none', 'no-cert', 'no-client-cert', 'certificate-free'):
            return 'none'
        if allow_auto and value == 'auto':
            return 'auto'
        raise ValueError('Unsupported TAK Gateway authentication mode: ' + repr(raw))

    def _tak_gateway_connection_profile(kind):
        is_replay = kind == 'replay'
        prefix = 'TAK_MAP_REPLAY_' if is_replay else 'TAK_MAP_GATEWAY_DATA_'
        endpoint = TAK_MAP_REPLAY_API_URL if is_replay else TAK_MAP_GATEWAY_DATA_API_URL
        raw_mode = os.environ.get(prefix + 'AUTH_MODE', 'certificate' if is_replay else 'auto')
        try:
            desired = _tak_gateway_auth_mode(raw_mode, allow_auto=not is_replay)
            mode_error = ''
        except ValueError as exc:
            desired = 'invalid'
            mode_error = str(exc)
        cert = os.environ.get(prefix + 'CLIENT_CERT', TAK_MAP_REPLAY_CLIENT_CERT).strip()
        key = os.environ.get(prefix + 'CLIENT_KEY', TAK_MAP_REPLAY_CLIENT_KEY).strip()
        ca = os.environ.get(prefix + 'CA_CERT', TAK_MAP_REPLAY_CA_CERT).strip()
        verify = TAK_MAP_REPLAY_VERIFY_TLS if is_replay else str(os.environ.get(prefix + 'VERIFY_TLS', 'true')).strip().lower() not in ('0','false','no','off')
        cert_present = bool(cert and Path(cert).is_file())
        key_present = bool(key and Path(key).is_file())
        ca_present = bool(ca and Path(ca).is_file())
        mode = ('certificate' if cert_present and key_present else 'none') if desired == 'auto' else desired
        if desired == 'auto' and not (cert_present and key_present):
            enrollment_manifest = os.environ.get('TAK_MAP_ENROLLMENT_MANIFEST', '/etc/tak-map/enrollment.json')
            if cert_present != key_present or Path(enrollment_manifest).is_file():
                mode_error = ('Gateway enrollment credentials are incomplete or missing; '
                              'use AUTH_MODE=none explicitly to allow certificate-free access.')
        parsed = urlparse(str(endpoint or ''))
        scheme = (parsed.scheme or '').lower()
        err = mode_error
        if not err and (not parsed.hostname or parsed.username or parsed.password or parsed.fragment or scheme not in ('http','https')):
            err = 'Invalid Gateway API URL. Use an http:// or https:// endpoint with no embedded credentials.'
        if not err and is_replay and scheme != 'https':
            err = 'Replay API requires HTTPS; certificate-free Replay is not available on port 8090.'
        if not err and mode == 'certificate' and scheme != 'https':
            err = 'Client certificate authentication requires HTTPS.'
        if not err and mode == 'certificate' and not (cert_present and key_present):
            err = 'Client certificate/key are not configured.'
        if not err and mode == 'none' and scheme == 'https' and not verify:
            err = 'Certificate-free HTTPS requires server TLS verification. Supply a trusted CA or use HTTP on a trusted LAN for Gateway Data.'
        return {
            'api_url': endpoint,
            'configured': not bool(err),
            'configuration_error': err,
            'auth_mode': mode,
            'auth_mode_setting': desired,
            'client_certificate_required': mode == 'certificate',
            'client_cert_present': cert_present,
            'client_key_present': key_present,
            'ca_cert_present': ca_present,
            'client_cert_path': cert,
            'client_key_path': key,
            'ca_cert_path': ca,
            'verify_tls': bool(verify),
            'transport': scheme,
            'read_only': True,
        }

    def _tak_gateway_transport_context(profile):
        if not profile['configured']:
            raise ValueError(profile['configuration_error'])
        if profile['transport'] == 'http':
            return None  # Client certificates are never sent over unencrypted HTTP.
        cafile = profile['ca_cert_path'] if profile['ca_cert_present'] else None
        if profile['verify_tls']:
            ctx = _ssl_v415.create_default_context(cafile=cafile)
        else:
            # Preserve historical certificate-mode operator setting only.
            ctx = _ssl_v415._create_unverified_context()
        if profile['auth_mode'] == 'certificate':
            ctx.load_cert_chain(profile['client_cert_path'], profile['client_key_path'])
        return ctx

    def _tak_v415_replay_config_status():
        p = _tak_gateway_connection_profile('replay')
        return {
            'ok': True, 'configured': p['configured'], 'api_url': p['api_url'],
            'client_cert_present': p['client_cert_present'],
            'client_key_present': p['client_key_present'],
            'ca_cert_present': p['ca_cert_present'],
            'verify_tls': p['verify_tls'],
            'timeout_seconds': TAK_MAP_REPLAY_TIMEOUT,
            'write_back': False, 'mode': 'server-side-proxy', 'version': 'v415',
            'auth_mode': p['auth_mode'], 'auth_mode_setting': p['auth_mode_setting'],
            'client_certificate_required': p['client_certificate_required'],
            'configuration_error': p['configuration_error'],
            'certificate_free_requires_gateway_policy': p['auth_mode'] == 'none',
            'https_required': True,
        }

    def _tak_v415_replay_ssl_context():
        return _tak_gateway_transport_context(_tak_gateway_connection_profile('replay'))

    def _i475_gateway_data_config():
        p = _tak_gateway_connection_profile('gateway_data')
        return {
            'ok': True, 'configured': p['configured'], 'api_url': p['api_url'],
            'poll_interval_seconds': 300,
            'manual_refresh_reads_gateway_snapshot': True, 'forces_upstream_refresh': False,
            'auth': 'client-certificate' if p['client_certificate_required'] else 'none',
            'auth_mode': p['auth_mode'], 'auth_mode_setting': p['auth_mode_setting'],
            'client_certificate_required': p['client_certificate_required'],
            'client_cert_present': p['client_cert_present'],
            'client_key_present': p['client_key_present'],
            'ca_cert_present': p['ca_cert_present'],
            'verify_tls': p['verify_tls'], 'transport': p['transport'],
            'configuration_error': p['configuration_error'],
            'additional_login': False, 'version': 'i475',
            'startup_retry_delays_seconds': [1.5, 3, 6],
            'backend_transient_retry': True,
            'ssl_context_cached': True,
            'ssl_context_builds': int(_i475_gateway_ssl_cache.get('builds', 0)),
            'ssl_context_reuses': int(_i475_gateway_ssl_cache.get('reuses', 0)),
        }

    def _i475_gateway_ssl_context():
        p = _tak_gateway_connection_profile('gateway_data')
        key = (
            p['api_url'], p['auth_mode'], p['verify_tls'],
            _i475_file_signature(p['ca_cert_path']),
            _i475_file_signature(p['client_cert_path']) if p['client_certificate_required'] else None,
            _i475_file_signature(p['client_key_path']) if p['client_certificate_required'] else None,
        )
        with _i475_gateway_ssl_lock:
            if _i475_gateway_ssl_cache.get('key') == key and _i475_gateway_ssl_cache.get('initialized'):
                _i475_gateway_ssl_cache['reuses'] += 1
                return _i475_gateway_ssl_cache['ctx'], True
            ctx = _tak_gateway_transport_context(p)
            _i475_gateway_ssl_cache.update({
                'key': key, 'ctx': ctx, 'initialized': True,
                'builds': _i475_gateway_ssl_cache.get('builds', 0) + 1,
            })
            return ctx, False

    # Existing runtime Config API and Replay UI consume these dynamic global
    # functions. Keep all live/replay geometry, indexing, seek, playback, CORS,
    # content encoding and original per-user TAK Map session access unchanged.
    _tak_gateway_previous_config = tak_map_config
    def tak_map_config():
        cfg = dict(_tak_gateway_previous_config() or {})
        p = _tak_gateway_connection_profile('gateway_data')
        gd = dict(cfg.get('gateway_data') or {})
        gd.update({
            'configured': p['configured'],
            'existing_replay_mtls': p['auth_mode'] == 'certificate',
            'auth_mode': p['auth_mode'],
            'auth_mode_setting': p['auth_mode_setting'],
            'client_certificate_required': p['client_certificate_required'],
            'configuration_error': p['configuration_error'],
        })
        cfg['gateway_data'] = gd
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _tak_gateway_auth_exc:
    # Do not pretend missing auth configuration is a successful connection.
    try: print('TAK Map Gateway authentication-mode initialization failed:', _tak_gateway_auth_exc)
    except Exception: pass
# --- end staged optional Gateway Data / Replay client authentication ---


# --- TAK Map i644 release identity: Gateway Data optional certificates / Replay parity ---
# Do not mutate i643 native Shape save metadata or historical public API names.
try:
    _I644_VERSION = 'i644'
    _I644_PACKAGE_VERSION = '1.4.0-i644'
    _i644_previous_config = tak_map_config
    def tak_map_config():
        cfg = dict(_i644_previous_config() or {})
        cfg['version'] = _I644_PACKAGE_VERSION
        cfg['tak_map_iteration'] = _I644_VERSION
        cfg['gateway_optional_client_certificates_i644'] = {
            'gateway_data_modes': ['auto', 'none', 'certificate'],
            'replay_modes': ['none', 'certificate'],
            'replay_default_auth': 'certificate',
            'replay_https_only': True,
            'replay_payload_protocol_unchanged': True,
            'separate_gateway_data_tls_context': True,
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config
    def _i644_release_html(html):
        html = str(html or '')
        # Fresh URLs prevent browsers from retaining the older runtime scripts.
        for asset in ('tak-map-context-sidebar-i572.js', 'tak-map-package-i580.js', 'tak-map-i636.js', 'tak-map-deferred-i553.json'):
            html = re.sub(r'(/assets/runtime/' + re.escape(asset) + r'\?v=)[^"\'<>\s]+', r'\g<1>' + _I644_PACKAGE_VERSION, html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\g<1>i644\2',html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\g<1>i644\2',html)
        return html
    TAK_MAP_HTML = _i644_release_html(TAK_MAP_HTML); INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i644_release_html(TAK_MAP_LOGIN_HTML); LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I644_VERSION
except Exception as _i644_exc:
    try: print('TAK Map i644 release identity initialization failed:', _i644_exc)
    except Exception: pass
# --- end TAK Map i644 release identity ---

# --- TAK Map i645 Gateway Data connection editor; i644 release remains untouched ---
try:
    import ipaddress as _i645_ipaddress
    _I645_GATEWAY_CONFIG_FILE=DATA_DIR/'gateway_data_connection.json'
    _i645_gateway_lock=threading.RLock()
    _i645_previous_profile=_tak_gateway_connection_profile

    def _i645_load_settings():
        data=load_json_file(_I645_GATEWAY_CONFIG_FILE,{})
        return data if isinstance(data,dict) and data.get('api_url') else {}

    def _i645_path(raw,label):
        value=str(raw or '').strip()
        if value and (len(value)>500 or '\x00' in value or not Path(value).is_absolute()):
            raise ValueError(label+' must be an absolute filesystem path or blank.')
        return value

    def _i645_parse_settings(data):
        if not isinstance(data,dict):raise ValueError('Expected JSON settings.')
        protocol=str(data.get('protocol') or '').lower().strip()
        if protocol not in ('http','https'):raise ValueError('Select HTTP or HTTPS.')
        host=str(data.get('host') or '').strip()
        if not host or len(host)>253 or any(ch.isspace() for ch in host):
            raise ValueError('Enter the TAK Gateway IP address or hostname.')
        if host.startswith('[') and host.endswith(']'):host=host[1:-1]
        if ':' in host:
            try:_i645_ipaddress.IPv6Address(host)
            except ValueError:raise ValueError('Invalid IPv6 address.')
            host='['+host+']'
        elif not re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?',host) or '..' in host:
            raise ValueError('Invalid Gateway hostname.')
        try:port=int(str(data.get('port') or ''))
        except (TypeError,ValueError):raise ValueError('Enter a valid TCP port.')
        if not 1<=port<=65535:raise ValueError('Port must be between 1 and 65535.')
        mode=str(data.get('auth_mode') or '').lower().strip()
        if mode not in ('auto','none','certificate'):raise ValueError('Invalid authentication mode.')
        verify=data.get('verify_tls',True)
        if not isinstance(verify,bool):raise ValueError('TLS verification must be boolean.')
        if mode=='certificate' and protocol!='https':raise ValueError('Client certificate mode requires HTTPS.')
        if mode=='auto' and protocol=='http':raise ValueError('Select No client certificate for HTTP.')
        if mode=='none' and protocol=='https' and not verify:raise ValueError('Certificate-free HTTPS requires server TLS verification.')
        return {'api_url':f'{protocol}://{host}:{port}/api/external-sources/v1',
                'auth_mode':mode,'verify_tls':verify,
                'ca_cert_path':_i645_path(data.get('ca_cert_path'),'CA certificate'),
                'client_cert_path':_i645_path(data.get('client_cert_path'),'Client certificate'),
                'client_key_path':_i645_path(data.get('client_key_path'),'Client key')}

    def _i645_profile(settings):
        base=_i645_previous_profile('gateway_data')
        if not settings:return base
        endpoint=str(settings.get('api_url') or '')
        parts=urlparse(endpoint);scheme=parts.scheme.lower()
        cert=settings.get('client_cert_path') or base['client_cert_path']
        key=settings.get('client_key_path') or base['client_key_path']
        ca=settings.get('ca_cert_path') or base['ca_cert_path']
        cert_ok=bool(cert and Path(cert).is_file())
        key_ok=bool(key and Path(key).is_file())
        ca_ok=bool(ca and Path(ca).is_file())
        desired=settings.get('auth_mode','none')
        mode=('certificate' if cert_ok and key_ok else 'none') if desired=='auto' else desired
        verify=bool(settings.get('verify_tls',True))
        error=''
        if not parts.hostname or parts.username or parts.password or parts.fragment or parts.query or parts.path!='/api/external-sources/v1' or scheme not in ('http','https'):
            error='Invalid Gateway Data API URL.'
        elif mode=='certificate' and scheme!='https':error='Client certificates require HTTPS.'
        elif mode=='certificate' and not(cert_ok and key_ok):error='Client certificate/key files are missing on the TAK Map host.'
        elif desired=='auto' and cert_ok!=key_ok:error='Automatic authentication found an incomplete keypair.'
        elif desired=='auto' and not(cert_ok and key_ok) and Path(os.environ.get('TAK_MAP_ENROLLMENT_MANIFEST','/etc/tak-map/enrollment.json')).is_file():
            error='Existing enrollment is incomplete. Choose No client certificate explicitly.'
        elif desired=='auto' and scheme=='http':error='Select No client certificate for HTTP.'
        elif mode=='none' and scheme=='https' and not verify:error='Certificate-free HTTPS requires server TLS verification.'
        return {**base,'api_url':endpoint,'configured':not bool(error),'configuration_error':error,
                'auth_mode':mode,'auth_mode_setting':desired,'client_certificate_required':mode=='certificate',
                'client_cert_path':cert,'client_key_path':key,'ca_cert_path':ca,
                'client_cert_present':cert_ok,'client_key_present':key_ok,'ca_cert_present':ca_ok,
                'verify_tls':verify,'transport':scheme}

    def _tak_gateway_connection_profile(kind):
        return _i645_profile(_i645_load_settings()) if kind=='gateway_data' else _i645_previous_profile(kind)
    globals()['_tak_gateway_connection_profile']=_tak_gateway_connection_profile

    def _i645_public_settings():
        saved=_i645_load_settings();p=_tak_gateway_connection_profile('gateway_data')
        parsed=urlparse(p.get('api_url') or '')
        return {'ok':True,'saved_override':bool(saved),'host':parsed.hostname or '',
                'protocol':parsed.scheme or 'http','port':parsed.port or (9443 if parsed.scheme=='https' else 8090),
                'auth_mode':p.get('auth_mode_setting') or 'auto','verify_tls':bool(p.get('verify_tls',True)),
                'ca_cert_path':saved.get('ca_cert_path',''),
                'client_cert_path':saved.get('client_cert_path',''),
                'client_key_path':saved.get('client_key_path',''),
                'client_cert_present':p.get('client_cert_present',False),
                'client_key_present':p.get('client_key_present',False),
                'ca_cert_present':p.get('ca_cert_present',False),
                'configured':p.get('configured',False),
                'configuration_error':p.get('configuration_error') or '',
                'api_url':p.get('api_url') or '',
                'gateway_policy_note':'Gateway Configure Security must allow access from this host.'}

    def _i645_test(settings):
        profile=_i645_profile(settings)
        if not profile['configured']:return {'ok':False,'error':profile['configuration_error']},400
        try:
            context=_tak_gateway_transport_context(profile)
            for endpoint in ('health','capabilities'):
                request=_urlreq_v415.Request(profile['api_url']+'/'+endpoint,headers={
                    'Accept':'application/json','User-Agent':'TAK-Map Gateway-Config Test'})
                with _urlreq_v415.urlopen(request,context=context,timeout=8) as resp:
                    raw=resp.read(1024*1024+1)
                    if len(raw)>1024*1024:raise ValueError(endpoint+' response exceeds 1 MB.')
                    data=json.loads(raw.decode('utf-8','replace'))
                    if not isinstance(data,dict) or data.get('ok') is False:
                        raise ValueError(str(data.get('error') if isinstance(data,dict) else 'Invalid Gateway response'))
            return {'ok':True,'message':'Gateway Data health and capabilities are reachable.','api_url':profile['api_url']},200
        except Exception as exc:
            return {'ok':False,'error':'Gateway connection test failed: '+str(exc)},502

    def _i645_same_origin(handler):
        origin=urlparse(handler.headers.get('Origin','').strip())
        return bool(origin.scheme in ('http','https') and origin.netloc.lower()==handler.headers.get('Host','').strip().lower())

    _i645_previous_get=Handler.do_GET
    def _i645_get(self):
        path=urlparse(self.path).path
        if path=='/assets/runtime/tak-map-gateway-config-i645.js':
            fp=Path(__file__).resolve().parent/'assets'/'tak-map-gateway-config-i645.js'
            if not fp.is_file():return self._send_json({'ok':False,'error':'Gateway configuration UI missing.'},404)
            body=fp.read_bytes();self.send_response(200)
            self.send_header('Content-Type','application/javascript; charset=utf-8')
            self.send_header('Cache-Control','no-store, max-age=0')
            self.send_header('Content-Length',str(len(body)));self.end_headers()
            if self.command!='HEAD':self.wfile.write(body)
            return
        if path=='/api/tak-map/gateway-data/settings':
            if not self._tak_map_auth_ok():return self._require_tak_map_login()
            if not _i540_is_admin(self._tak_map_session() or {}):
                return self._send_json({'ok':False,'error':'Administrator access required.'},403)
            return self._send_json(_i645_public_settings())
        return _i645_previous_get(self)
    Handler.do_GET=_i645_get

    _i645_previous_post=Handler.do_POST
    def _i645_post(self):
        path=urlparse(self.path).path
        if path not in ('/api/tak-map/gateway-data/settings','/api/tak-map/gateway-data/settings/test'):
            return _i645_previous_post(self)
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        if not _i540_is_admin(self._tak_map_session() or {}):
            return self._send_json({'ok':False,'error':'Administrator access required.'},403)
        if not _i645_same_origin(self):
            return self._send_json({'ok':False,'error':'Same-origin request required.'},403)
        if not self.headers.get('Content-Type','').lower().startswith('application/json'):
            return self._send_json({'ok':False,'error':'Expected JSON request.'},415)
        try:
            n=int(self.headers.get('Content-Length','0') or '0')
            if n<2 or n>8192:return self._send_json({'ok':False,'error':'Invalid request size.'},413)
            settings=_i645_parse_settings(_read_json_body(self))
        except (TypeError,ValueError) as exc:
            return self._send_json({'ok':False,'error':str(exc)},400)
        if path.endswith('/test'):
            result,status=_i645_test(settings)
            return self._send_json(result,status)
        profile=_i645_profile(settings)
        if not profile['configured']:
            return self._send_json({'ok':False,'error':profile['configuration_error']},400)
        try:
            with _i645_gateway_lock:
                # Create 0600 before writing, then replace atomically.
                import tempfile as _i645_tempfile
                DATA_DIR.mkdir(parents=True,exist_ok=True)
                fd,tmp=_i645_tempfile.mkstemp(prefix='gateway-connection-',suffix='.tmp',dir=str(DATA_DIR))
                try:
                    with os.fdopen(fd,'w',encoding='utf-8') as stream:
                        json.dump(settings,stream)
                    os.replace(tmp,_I645_GATEWAY_CONFIG_FILE)
                finally:
                    if os.path.exists(tmp):os.unlink(tmp)
                with _i475_gateway_ssl_lock:
                    _i475_gateway_ssl_cache['initialized']=False
                    _i475_gateway_ssl_cache['key']=None
                    _i475_gateway_ssl_cache['ctx']=None
            return self._send_json({'ok':True,'message':'Gateway Data settings saved.','replay_unchanged':True})
        except Exception as exc:
            return self._send_json({'ok':False,'error':'Unable to save Gateway settings: '+str(exc)},500)
    Handler.do_POST=_i645_post

    def _i645_add_config_ui(html):
        if not isinstance(html,str) or 'takMapGatewayConfigLoaderI645' in html:return html
        tag='<script id="takMapGatewayConfigLoaderI645" defer src="/assets/runtime/tak-map-gateway-config-i645.js?v=1.4.0-i650"></script>'
        return html.replace('</body>',tag+'\n</body>',1) if '</body>' in html else html+tag
    TAK_MAP_HTML=_i645_add_config_ui(TAK_MAP_HTML)
    _I645_VERSION='i650'
    _I645_PACKAGE_VERSION='1.4.0-i650'
    _i645_prior_config=tak_map_config
    def tak_map_config():
        cfg=dict(_i645_prior_config() or {})
        cfg['version']=_I645_PACKAGE_VERSION
        cfg['tak_map_iteration']=_I645_VERSION
        cfg['gateway_data_config_editor_i645']={
            'admin_only':True,'persisted_settings':True,'connection_test':True,
            'replay_settings_unchanged':True,
        }
        return cfg
    globals()['tak_map_config']=tak_map_config
    def _i645_release_html(html):
        html=str(html or '')
        for asset in ('tak-map-context-sidebar-i572.js','tak-map-package-i580.js','tak-map-i636.js','tak-map-deferred-i553.json'):
            html=re.sub(r'(/assets/runtime/'+re.escape(asset)+r'\?v=)[^"\'< >\s]+',r'\g<1>'+_I645_PACKAGE_VERSION,html)
        html=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\g<1>i650\2',html)
        html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\g<1>i650\2',html)
        return html
    TAK_MAP_HTML=_i645_release_html(TAK_MAP_HTML)
    INDEX_HTML=TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML=_i645_release_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML=TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION=_I645_VERSION
except Exception as _i645_config_exc:
    try:print('Gateway connection editor initialization failed:',_i645_config_exc)
    except Exception:pass
# --- end TAK Map i645 Gateway Data editor ---

# --- TAK Map i650: visible HTTPS certificate setup with protected generation ---
try:
    import hashlib as _i650_hashlib
    import ssl as _i650_ssl
    def _i650_ca_fingerprint():
        try:
            data=_i650_ssl.PEM_cert_to_DER_cert(CA_CERT_FILE.read_text(encoding='utf-8'))
            digest=_i650_hashlib.sha256(data).hexdigest().upper()
            return ':'.join(digest[i:i+2] for i in range(0,64,2))
        except (OSError,ValueError):return ''

    _i650_prev_get=Handler.do_GET
    def _i650_do_get(self):
        path=urlparse(self.path).path
        if path=='/assets/runtime/tak-map-cert-setup-i650.js':
            fp=Path(__file__).resolve().parent/'assets'/'tak-map-cert-setup-i650.js'
            if not fp.is_file():return self._send_json({'ok':False,'error':'Missing certificate UI asset.'},404)
            body=fp.read_bytes();self.send_response(200)
            self.send_header('Content-Type','application/javascript; charset=utf-8')
            self.send_header('Cache-Control','no-store, max-age=0')
            self.send_header('Content-Length',str(len(body)));self.end_headers()
            if self.command!='HEAD':self.wfile.write(body)
            return
        if path=='/api/tak-map/cert-setup/status':
            if not self._tak_map_auth_ok():return self._require_tak_map_login()
            info=dict(get_cert_status())
            info['is_admin']=bool(_i540_is_admin(self._tak_map_session() or {}))
            info['ca_fingerprint_sha256']=_i650_ca_fingerprint()
            return self._send_json(info)
        return _i650_prev_get(self)
    Handler.do_GET=_i650_do_get

    _i650_prev_post=Handler.do_POST
    def _i650_do_post(self):
        path=urlparse(self.path).path
        if path=='/api/cert-setup' and APP_ROLE=='map':
            return self._send_json({'ok':False,'error':'Legacy certificate generation endpoint retired; use the protected Cert Setup interface.'},410)
        if path!='/api/tak-map/cert-setup/generate':return _i650_prev_post(self)
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        if not _i540_is_admin(self._tak_map_session() or {}):
            return self._send_json({'ok':False,'error':'Administrator access required.'},403)
        if not _i645_same_origin(self):
            return self._send_json({'ok':False,'error':'Same-origin request required.'},403)
        if not self.headers.get('Content-Type','').lower().startswith('application/json'):
            return self._send_json({'ok':False,'error':'JSON required.'},415)
        try:
            n=int(self.headers.get('Content-Length','0') or '0')
            if n<2 or n>8192:return self._send_json({'ok':False,'error':'Invalid request length.'},413)
            payload=_read_json_body(self)
            phrase='REGENERATE' if CA_CERT_FILE.is_file() else 'GENERATE'
            if str(payload.get('confirmation','')).strip()!=phrase:
                return self._send_json({'ok':False,'error':'Explicit '+phrase+' confirmation required.'},400)
            extra=str(payload.get('extra_sans',''))
            if len(extra)>1000:return self._send_json({'ok':False,'error':'Additional names are too long.'},400)
        except (ValueError,TypeError,AttributeError) as e:
            return self._send_json({'ok':False,'error':'Invalid certificate request: '+str(e)},400)
        result=run_cmd(['sudo','/usr/local/sbin/tak-map-action','cert-setup',extra,''],60)
        ok=bool(result.get('ok'))
        return self._send_json({'ok':ok,'message':'Certificate setup completed.' if ok else 'Certificate setup failed.',
                                'error':(result.get('stderr') or result.get('error') or '')[:1000] if not ok else ''},
                               200 if ok else 502)
    Handler.do_POST=_i650_do_post

    _i650_tag='<script id="takMapCertSetupLoaderI650" defer src="/assets/runtime/tak-map-cert-setup-i650.js?v=1.4.0-i650"></script>'
    if 'takMapCertSetupLoaderI650' not in TAK_MAP_HTML:
        TAK_MAP_HTML=TAK_MAP_HTML.replace('</body>',_i650_tag+'\n</body>',1)
        INDEX_HTML=TAK_MAP_HTML
except Exception as _i650_exc:
