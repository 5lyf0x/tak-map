            result = _i568_clone(result)
            result['version'] = _I595_VERSION
            access = list(result.get('mission_access_i594') or result.get('mission_access_i591') or [])
            result['mission_access_i595'] = _i568_clone(access)
            result['protected_mission_content_merge_i595'] = {
