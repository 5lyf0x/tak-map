    def _i643_associate_shape_uid(mission, creator_uid, uid, token=''):
        """Use the live-validated TAK/OTS Mission contents UID workflow; never write Mission /cot."""
        mission_q=quote(_i643_text(mission),safe=''); creator_q=quote(_i643_text(creator_uid),safe='')
        path=f'/Marti/api/missions/{mission_q}/contents?creatorUid={creator_q}'
        body=json.dumps({'uids':[_i643_text(uid)]}).encode('utf-8')
        token_candidates=[]
