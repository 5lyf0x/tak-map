            if not isinstance(base,dict) or not base.get('ok'): return base
            data=_load_popup_edits(); items=data.get('items') if isinstance(data.get('items'),dict) else {}
            key=_i643_text(payload.get('key')); edit=dict(items.get(key) or {})
            edit['shape_geometry_i639']=geom
            edit['shape_geometry_confirmed_i643']=True
