TAK_MAP_HTML = TAK_MAP_HTML.replace(
    '/assets/runtime/tak-map-weather-i691.js?v=1.4.0-i691',
    '/assets/runtime/tak-map-weather-i692.js?v=1.4.0-i692')
TAK_MAP_HTML = TAK_MAP_HTML.replace("ITERATION='i691'", "ITERATION='i692'").replace("const iteration='i691'", "const iteration='i692'")
TAK_MAP_HTML = _weather_re_i691.sub(r'([?&]v=)1\.4\.0-i\d+', r'\g<1>1.4.0-i692', TAK_MAP_HTML)
TAK_MAP_HTML = _weather_re_i691.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\g<1>i692\2', TAK_MAP_HTML)
TAK_MAP_HTML = _weather_re_i691.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\g<1>i692\2', TAK_MAP_HTML)
TAK_MAP_HTML = TAK_MAP_HTML.replace('tak-map-v1.4.0-i691.zip', 'tak-map-v1.4.0-i692.zip')
INDEX_HTML = TAK_MAP_HTML
TAK_MAP_ITERATION = 'i692'
