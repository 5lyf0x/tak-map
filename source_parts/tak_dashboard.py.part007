        html=re.sub(r'/assets/runtime/tak-map-context-sidebar-i572\.js\?v=[^"\']+', '/assets/runtime/tak-map-context-sidebar-i572.js?v=1.4.0-i641', html)
        html=re.sub(r'/assets/runtime/tak-map-package-i580\.js\?v=[^"\']+', '/assets/runtime/tak-map-package-i580.js?v=1.4.0-i641', html)
        html=re.sub(r'/assets/runtime/tak-map-i636\.js\?v=[^"\']+', '/assets/runtime/tak-map-i636.js?v=1.4.0-i641', html)
        html=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i641\2',html)
        html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i641\2',html)
        return html
