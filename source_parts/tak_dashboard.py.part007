TAK_MAP_HTML=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\g<1>i690\2',TAK_MAP_HTML)
TAK_MAP_HTML=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\g<1>i690\2',TAK_MAP_HTML)
TAK_MAP_HTML=TAK_MAP_HTML.replace('tak-map-v1.4.0-i689.zip','tak-map-v1.4.0-i690.zip')
