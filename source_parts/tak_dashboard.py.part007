        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i629\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i629\2', html)
        return html

