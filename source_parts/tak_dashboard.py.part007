_I689_STATIC_ASSETS = {
    '/assets/runtime/tak-map-sidebar-order-i684.js': ('tak-map-sidebar-order-i684.js', 'application/javascript; charset=utf-8'),
    '/assets/runtime/tak-map-sidebar-uniform-i684.css': ('tak-map-sidebar-uniform-i684.css', 'text/css; charset=utf-8'),
    '/assets/tak-map-sidebar-order-i684.js': ('tak-map-sidebar-order-i684.js', 'application/javascript; charset=utf-8'),
    '/assets/tak-map-sidebar-uniform-i684.css': ('tak-map-sidebar-uniform-i684.css', 'text/css; charset=utf-8'),
    '/assets/runtime/tak-map-infrastructure-i689.js': ('tak-map-infrastructure-i689.js', 'application/javascript; charset=utf-8'),
    '/assets/runtime/tak-map-infrastructure-i689.css': ('tak-map-infrastructure-i689.css', 'text/css; charset=utf-8'),
}
_I689_GET_PREVIOUS = Handler.do_GET

def _i689_get(self):
    route=urlparse(self.path).path
    if route in _I689_STATIC_ASSETS:
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        name,mime=_I689_STATIC_ASSETS[route]
        path=Path(__file__).resolve().parent/'assets'/name
        if not path.is_file():
            self.send_response(404);self.send_header('Cache-Control','no-store')
            self.send_header('X-Content-Type-Options','nosniff');self.send_header('Content-Length','0')
            self.end_headers();return
        body=path.read_bytes()
        self.send_response(200);self.send_header('Content-Type',mime)
        self.send_header('Cache-Control','private, no-store')
        self.send_header('X-Content-Type-Options','nosniff')
        self.send_header('Content-Length',str(len(body)));self.end_headers()
        if self.command!='HEAD':self.wfile.write(body)
        return
    # Only this module's missing sidebar assets are terminal 404s; other
    # historical runtime assets must continue to their registered handlers.
    if route.startswith(('/assets/runtime/tak-map-sidebar-', '/assets/tak-map-sidebar-')) and route.endswith(('.js','.css')):
        self.send_response(404);self.send_header('Cache-Control','no-store')
        self.send_header('X-Content-Type-Options','nosniff');self.send_header('Content-Length','0')
        self.end_headers();return
    return _I689_GET_PREVIOUS(self)
Handler.do_GET=_i689_get

