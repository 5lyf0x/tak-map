        script = script.replace(old, new, 1)
        old = "<b>Callsign</b><span>${esc(val(e.callsign))}</span><b>Owner/operator</b>"
        new = "<b>Callsign</b><span>${esc(val(e.callsign))}</span>${emergencyRow}<b>Owner/operator</b>"
        if old not in script:
