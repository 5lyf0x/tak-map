# --- TAK Map i575 stable protected-Mission context, credential scope, and deletion preflight ---
try:
    _I575_ROOT = Path(__file__).resolve().parent
    _I575_REQUEST_CONTEXT = threading.local()
    _I575_MISSION_SECRET_ROOT = DATA_DIR / 'mission_unlock_users_i575'
    _I575_MISSION_SECRET_ROOT.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(_I575_MISSION_SECRET_ROOT, 0o700)
    except Exception:
        pass

    _i575_session_before = _i572_session
    _i575_store_before = _i572_store_password
    _i575_load_before = _i572_load_password
    _i575_remove_before = _i572_remove_password

    def _i575_session_from_handler(handler):
        try:
            sess = handler._tak_map_session() if handler._tak_map_auth_ok() else {}
            return dict(sess or {}) if isinstance(sess, dict) else {}
        except Exception:
            return {}

    def _i575_context_enter(handler):
        depth = int(getattr(_I575_REQUEST_CONTEXT, 'depth', 0) or 0)
        if depth == 0:
            _I575_REQUEST_CONTEXT.session = _i575_session_from_handler(handler)
            try:
                _i555_set_request_context(handler)
            except Exception:
                pass
        _I575_REQUEST_CONTEXT.depth = depth + 1
        return dict(getattr(_I575_REQUEST_CONTEXT, 'session', {}) or {})

    def _i575_context_exit():
        depth = max(0, int(getattr(_I575_REQUEST_CONTEXT, 'depth', 1) or 1) - 1)
        _I575_REQUEST_CONTEXT.depth = depth
        if depth == 0:
            try:
                _i555_clear_request_context()
            except Exception:
                pass
            _I575_REQUEST_CONTEXT.session = {}

    def _i572_session():
        sess = getattr(_I575_REQUEST_CONTEXT, 'session', None)
        if isinstance(sess, dict) and sess:
            return dict(sess)
        try:
            return dict(_i575_session_before() or {})
        except Exception:
            return {}
    globals()['_i572_session'] = _i572_session

    def _i575_user_ref(sess=None):
        sess = sess if isinstance(sess, dict) else _i572_session()
        profile = dict(sess.get('profile') or {}) if isinstance(sess.get('profile'), dict) else {}
        tak_uid = _i568_text(sess.get('tak_uid') or profile.get('tak_uid')).casefold()
        username = _i568_text(sess.get('username') or profile.get('username')).casefold()
        identity_key = _i568_text(profile.get('identity_key')).casefold()
        if tak_uid:
            return 'tak-uid:' + tak_uid
        if username:
            return 'ots-username:' + username
        if identity_key:
            return 'identity:' + identity_key
        return ''

    def _i575_scope(sess=None):
        ref = _i575_user_ref(sess)
        return hashlib.sha256(ref.encode('utf-8')).hexdigest()[:48] if ref else ''

    def _i575_record_path(mission, sess=None):
        scope = _i575_scope(sess)
        if not scope:
            return None
        return _I575_MISSION_SECRET_ROOT / scope / (_i572_mission_key(mission) + '.json')

    def _i575_store_canonical(mission, password, sess=None):
        mission = _i568_text(mission)
        password = str(password or '')
        sess = sess if isinstance(sess, dict) else _i572_session()
        user_ref = _i575_user_ref(sess)
        path = _i575_record_path(mission, sess)
        if not mission or not password or not user_ref or path is None:
            return {'ok': False, 'error': 'A stable authenticated user, Mission name, and password are required.'}
        record = {
            'version': 'i575',
            'mission_hash': _i572_mission_key(mission),
            'user_scope': _i575_scope(sess),
            'password_encrypted': _i535_encrypt(user_ref, password),
            'saved_at': datetime.now(timezone.utc).isoformat(),
        }
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(path.parent, 0o700)
        except Exception:
            pass
        _i529_atomic_write(path, json.dumps(record, separators=(',', ':')), 0o600, False)
        return {'ok': True, 'configured': True, 'storage_version': 'i575'}

    def _i575_load_canonical(mission, sess=None):
        mission = _i568_text(mission)
        sess = sess if isinstance(sess, dict) else _i572_session()
        user_ref = _i575_user_ref(sess)
        path = _i575_record_path(mission, sess)
        if not mission or not user_ref or path is None:
            return {'ok': False, 'configured': False, 'error': 'Mission is locked.'}
        try:
            record = json.loads(path.read_text(encoding='utf-8'))
            encrypted = _i568_text(record.get('password_encrypted')) if isinstance(record, dict) else ''
            if not encrypted:
                return {'ok': False, 'configured': False, 'error': 'Mission is locked.'}
            password = _i535_decrypt(user_ref, encrypted)
            if not password:
                return {'ok': False, 'configured': True, 'error': 'Stored Mission password could not be decrypted.'}
            return {'ok': True, 'configured': True, 'password': password, 'storage_version': 'i575'}
        except FileNotFoundError:
            return {'ok': False, 'configured': False, 'error': 'Mission is locked.'}
        except Exception:
            return {'ok': False, 'configured': True, 'error': 'Stored Mission password could not be read.'}

    def _i575_legacy_sessions(sess):
        sess = dict(sess or {}) if isinstance(sess, dict) else {}
        profile = dict(sess.get('profile') or {}) if isinstance(sess.get('profile'), dict) else {}
        username = _i568_text(sess.get('username') or profile.get('username')).lower()
        callsign = _i568_text(sess.get('callsign') or profile.get('callsign'))
        tak_uid = _i568_text(sess.get('tak_uid') or profile.get('tak_uid'))
        auth_mode = _i568_text(sess.get('auth_mode'))
        candidates = [sess]
        candidates.append({'auth_mode': auth_mode, 'username': username, 'callsign': callsign,
                           'tak_uid': tak_uid, 'profile': {'username': username, 'callsign': callsign, 'tak_uid': tak_uid}})
        out, seen = [], set()
        for row in candidates:
            key = json.dumps(row, sort_keys=True, default=str)
            if key not in seen:
                seen.add(key); out.append(row)
        return out

    def _i572_store_password(mission, password, sess=None):
        return _i575_store_canonical(mission, password, sess)
    globals()['_i572_store_password'] = _i572_store_password

    def _i572_load_password(mission, sess=None):
        sess = sess if isinstance(sess, dict) else _i572_session()
        current = _i575_load_canonical(mission, sess)
        if current.get('ok'):
            return current
        for legacy_sess in _i575_legacy_sessions(sess):
            try:
                legacy = _i575_load_before(mission, legacy_sess)
            except Exception:
                legacy = {'ok': False}
            if legacy.get('ok') and legacy.get('password'):
                migrated = _i575_store_canonical(mission, legacy.get('password'), sess)
                if migrated.get('ok'):
                    return {'ok': True, 'configured': True, 'password': legacy.get('password'),
                            'storage_version': 'i575', 'migrated_from': 'i572'}
                return legacy
        return current
    globals()['_i572_load_password'] = _i572_load_password

    def _i572_remove_password(mission, sess=None):
        sess = sess if isinstance(sess, dict) else _i572_session()
        path = _i575_record_path(mission, sess)
        if path is not None:
            try:
                path.unlink(missing_ok=True)
            except Exception:
                pass
        for legacy_sess in _i575_legacy_sessions(sess):
            try:
                _i575_remove_before(mission, legacy_sess)
            except Exception:
                pass
    globals()['_i572_remove_password'] = _i572_remove_password

    def _i575_truthy(value):
        if value is True:
            return True
        return _i568_text(value).casefold() in ('1', 'true', 'yes', 'on')

    _i575_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i575_response_before(state)
        if not isinstance(payload, dict):
            return payload
        payload = _i568_clone(payload)
        sess = _i572_session()
        access_by_mission = {}
        for row in list(payload.get('mission_access_i574') or payload.get('mission_access_i573') or payload.get('mission_access_i572') or []):
            if not isinstance(row, dict):
                continue
            mission = _i568_text(row.get('mission'))
            if mission:
                access_by_mission[mission.casefold()] = dict(row)
        for row in list(payload.get('missions') or []):
            if isinstance(row, str):
                mission = _i568_text(row); protected_hint = False
            elif isinstance(row, dict):
                mission = _i568_text(row.get('name') or row.get('mission_name') or row.get('missionName') or row.get('uid'))
                protected_hint = _i575_truthy(row.get('passwordProtected')) or _i575_truthy(row.get('password_protected'))
            else:
                mission = ''; protected_hint = False
            if not mission:
                continue
            cached = _i572_protected_status(mission, sess)
            protected = bool(protected_hint or cached.get('protected'))
            if protected:
                _i572_set_protected(mission, True, sess)
            info = dict(_i573_public_status(mission) or {})
            if protected and not info.get('protected'):
                info.update({'protected': True, 'password_protected': True,
                             'unlocked': _i572_unlocked(mission, sess),
                             'locked': not _i572_unlocked(mission, sess),
                             'credential_configured': bool(_i572_load_password(mission, sess).get('ok'))})
            info['version'] = 'i575'
            info['stable_user_scope'] = True
            access_by_mission[mission.casefold()] = info
        payload['version'] = 'i575'
        payload['mission_access_i575'] = list(access_by_mission.values())
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i575_delete_before = _tak_data_sync_delete_record
    def _tak_data_sync_delete_record(obj, server_host=''):
        obj = obj if isinstance(obj, dict) else {}
        object_id = _i555_text(obj.get('object_id'))
        canonical = 'datasync:' + object_id if object_id else ''
        mission = _i555_text(obj.get('mission_name'))
        target = _i555_text(obj.get('mission_delete_target'))
        value = _i555_text(obj.get('mission_delete_value'))
        if mission and target in ('uid', 'hash') and value:
            creator_fn = globals().get('_i528_strict_creator')
            creator = creator_fn() if callable(creator_fn) else {'ok': False, 'error': 'Per-user OpenTAKServer identity is unavailable.'}
            if not creator.get('ok'):
                return {'object_id': canonical, 'status': 'failed', 'mission': mission,
                        'error': _i568_text(creator.get('error')) or 'No authenticated TAK identity is available.',
                        'version': 'i575'}
            creator_uid = _i568_text(creator.get('uid'))
            token_result = _i564_mission_token(mission, creator_uid, server_host, force=False)
            if not token_result.get('ok'):
                status = int(token_result.get('status') or 0)
                locked = status == 428 or bool(token_result.get('mission_password_required'))
                error = ('Mission is locked. Use Edit beside ' + mission +
                         ' in the Data Sync Missions row to save its password before deleting.') if locked else _i568_text(token_result.get('error'))
                return {'object_id': canonical, 'status': 'failed', 'mission': mission, 'target': target,
                        'value': value, 'http_status': status, 'mission_password_required': locked,
                        'publication_attempted': False, 'error': error,
                        'credential_management': 'mission-row-edit-stable-i575', 'version': 'i575'}
        result = dict(_i575_delete_before(obj, server_host) or {})
        result['version'] = 'i575'
        return result
    globals()['_tak_data_sync_delete_record'] = _tak_data_sync_delete_record

    _i575_get_before = Handler.do_GET
    def _i575_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/assets/runtime/tak-map-data-sync-access-i575.js':
            return _i541_send_file(self, _I575_ROOT / 'assets' / 'tak-map-data-sync-access-i575.js',
                                   'application/javascript; charset=utf-8', 'i575-stable-mission-access')
        scoped = parsed.path in ('/api/tak-map/data-sync', '/api/tak-map/data-sync-mission-access-i573',
                                 '/api/tak-map/data-sync-point-i555', '/api/tak-map/data-sync-point-i556')
        if scoped and self._tak_map_auth_ok():
            _i575_context_enter(self)
            try:
                return _i575_get_before(self)
            finally:
                _i575_context_exit()
        return _i575_get_before(self)
    Handler.do_GET = _i575_do_get

    _i575_post_before = Handler.do_POST
    def _i575_do_post(self):
        parsed = urlparse(self.path)
        scoped = parsed.path in ('/api/tak-map/object-delete', '/api/tak-map/data-sync-mission-access-i573',
                                 '/api/tak-map/data-sync-point-i555', '/api/tak-map/data-sync-point-i556')
        if scoped and self._tak_map_auth_ok():
            _i575_context_enter(self)
            try:
                return _i575_post_before(self)
            finally:
                _i575_context_exit()
        return _i575_post_before(self)
    Handler.do_POST = _i575_do_post

    _i575_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i575_config_before() or {})
        cfg['tak_map_iteration'] = 'i575'
        cfg['version'] = '1.3.0-i575'
        cfg['protected_mission_access_i575'] = {
            'version': 'i575',
            'authenticated_response_context': True,
            'stable_user_identity_scope': True,
            'legacy_i572_credential_migration': True,
            'refresh_status_preserved': True,
            'delete_preflight_before_fence': True,
