def _i699_basemap_get(self):
    if urlparse(self.path).path == '/api/tak-map/basemap-stack-i699':
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        try:
            return self._send_json(_USER_BASEMAP_I699.read(self._tak_map_session()),200,
                                   headers={'Cache-Control':'no-store'})
        except Exception as exc:
            return self._send_json({'ok':False,'error':str(exc)},500)
    return _I699_PREVIOUS_GET(self)

def _i699_basemap_post(self):
    if urlparse(self.path).path == '/api/tak-map/offline-rename-i001':
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        try:
            payload=_read_json_body(self)
            result,status=tak_map_offline_rename_i001(payload.get('id'),payload.get('name'))
            return self._send_json(result,status,headers={'Cache-Control':'no-store'})
        except Exception as exc:
            return self._send_json({'ok':False,'error':str(exc)},500)
    if urlparse(self.path).path == '/api/tak-map/basemap-stack-i699':
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        try:
            payload=_read_json_body(self)
            if not isinstance(payload,dict):
                raise ValueError('Expected JSON preferences object')
            result=_USER_BASEMAP_I699.write(self._tak_map_session(),payload.get('revision'),
                                             payload.get('preferences'))
            return self._send_json(result,409 if result.get('conflict') else 200,
                                   headers={'Cache-Control':'no-store'})
        except (ValueError,TypeError,PermissionError) as exc:
            return self._send_json({'ok':False,'error':str(exc)},400)
        except Exception as exc:
            return self._send_json({'ok':False,'error':str(exc)},500)
    return _I699_PREVIOUS_POST(self)

Handler.do_GET = _i699_basemap_get
Handler.do_POST = _i699_basemap_post
