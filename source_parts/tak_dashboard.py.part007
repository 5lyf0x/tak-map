# --- TAK Map i622 Replay Search final served-HTML/runtime correction ---
try:
    _I622_VERSION = 'i622'
    _I622_PACKAGE_VERSION = '1.4.0-i622'
    _I622_PUBLIC_VERSION = '1.4.0'

    # i621 correctly added Replay Search to the Replay integration source, but
    # later HTML finalizers could replace the already-patched document and leave
    # the final served page without the Replay integration.  i622 deliberately
    # runs after every historical finalizer and installs the authoritative Replay
    # runtime into the final document that Handler.do_GET serves.
    def _i622_replay_script():
        script = str(globals().get('_v415_script') or '')
        if not script:
            raise RuntimeError('authoritative Replay integration source is unavailable')
        script = script.replace("const V='i442',RELEASE='1.3.0'", "const V='i622',RELEASE='1.4.0'", 1)
        script = script.replace("packageFile:'tak-map-v442.zip'", "packageFile:'tak-map-v1.4.0-i622.zip'", 1)
        return script

    _I622_REPLAY_SCRIPT = _i622_replay_script()

    def _i622_identity_guard_script():
        guard = str(globals().get('_I620_IDENTITY_GUARD') or '')
        if not guard:
            return ''
        guard = guard.replace('id="takMapIdentityGuardI620"', 'id="takMapIdentityGuardI622"', 1)
        guard = guard.replace("ITERATION='i621',PACKAGE='1.4.0-i621'", "ITERATION='i622',PACKAGE='1.4.0-i622'", 1)
        return guard

    _I622_IDENTITY_GUARD = _i622_identity_guard_script()

    def _i622_patch_main_html(html):
        html = str(html or '')
        # Final release/cache identity.
        html = html.replace('1.4.0-i621', _I622_PACKAGE_VERSION)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i622\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i622\2', html)
        html = re.sub(r'(<span class="release-main">)[^<]*(</span>)', r'\g<1>1.4.0\2', html)

        # Remove any earlier Replay/identity copies, then install one authoritative
        # copy into the final HTML after all previous version patches have run.
        html = re.sub(r'<script[^>]*id=["\']v415ReplayModeIntegrationPatch["\'][\s\S]*?</script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapIdentityGuardI(?:620|622)["\'][\s\S]*?</script>\s*', '', html, flags=re.I)
        if _I622_IDENTITY_GUARD:
            if '</head>' in html:
                html = html.replace('</head>', _I622_IDENTITY_GUARD + '</head>', 1)
            else:
                html = _I622_IDENTITY_GUARD + html
        if '</body>' in html:
            html = html.replace('</body>', _I622_REPLAY_SCRIPT + '\n</body>', 1)
        else:
            html += _I622_REPLAY_SCRIPT
        return html

    def _i622_patch_login_html(html):
        html = str(html or '')
        html = html.replace('1.4.0-i621', _I622_PACKAGE_VERSION)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i622\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i622\2', html)
        return html

    TAK_MAP_HTML = _i622_patch_main_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i622_patch_login_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML

    _i622_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i622_config_before() or {})
        cfg['replay_search_i622'] = {
            'version': _I622_VERSION,
            'package_version': _I622_PACKAGE_VERSION,
            'whole_recording': True,
            'gateway_required_iteration': 'i193',
            'final_served_html_guard': True,
            'search_fields': [
                'flight', 'icao', 'registration', 'owner_operator',
                'aircraft_type', 'aircraft_model', 'eud_callsign', 'eud_uid',
                'vessel_name', 'ais_callsign',
            ],
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i622_exc:
    try:
        print('TAK Map i622 Replay Search final served-HTML correction failed:', _i622_exc)
    except Exception:
        pass
# --- end TAK Map i622 Replay Search final served-HTML/runtime correction ---


