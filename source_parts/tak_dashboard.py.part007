# --- TAK Map v1.4.0-i690: stable integrated status strip ---
# Additive authenticated endpoint. No mutation of saved map, VEIL or EUD data.
_I690_PREVIOUS_GET=Handler.do_GET
_I690_LAN_CACHE={'expires':0.0,'data':None}
_I690_LAN_LOCK=threading.Lock()

def _i690_status_network():
    """Report local link/address availability, not arbitrary peer discovery."""
    import ipaddress as _ip690
    import subprocess as _sub690
    now=time.monotonic()
    with _I690_LAN_LOCK:
        if _I690_LAN_CACHE['data'] is not None and now<_I690_LAN_CACHE['expires']:
            return dict(_I690_LAN_CACHE['data'])
        lan={'state':'Unknown','interface':'','address':'','peerConfirmed':False}
        try:
            proc=_sub690.run(['ip','-j','-4','address','show','up'],capture_output=True,text=True,timeout=2,check=False)
            if proc.returncode==0:
                lan['state']='Offline'
                entries=json.loads(proc.stdout or '[]')
                selected=str(os.environ.get('TAK_MAP_LAN_INTERFACE','')).strip()
                for row in entries:
                    name=str(row.get('ifname') or '')
                    lower=name.lower()
                    if not name or (selected and name!=selected):continue
                    if not selected and (lower=='lo' or lower.startswith(('docker','veth','br-','virbr','tun','tap','zt','tailscale','wg','cni','flannel','podman','vmnet','ppp'))):continue
                    if not selected and not lower.startswith(('eth','en','wl','wlan','bond','br0')):continue
                    if str(row.get('operstate') or '').upper() not in ('UP','UNKNOWN'):continue
                    for addr in row.get('addr_info') or []:
                        if addr.get('family')!='inet':continue
                        try:ip=_ip690.ip_address(str(addr.get('local') or ''))
                        except ValueError:continue
                        if not ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast:continue
                        if int(addr.get('prefixlen') or 0) not in range(1,33):continue
                        lan.update(state='Available',interface=name,address=str(ip));break
                    if lan['state']=='Available':break
        except (OSError,ValueError,TypeError,_sub690.TimeoutExpired):pass
        tak={'configured':False,'enabled':False,'state':'Unknown'}
        try:
            # Deliberately do not infer "enabled" from service running alone.
            unit=_sub690.run(['systemctl','is-enabled','opentakserver.service'],capture_output=True,text=True,timeout=2,check=False)
            tak['enabled']=(unit.stdout or '').strip().lower() in ('enabled','enabled-runtime')
            configured=any(p.exists() for p in (
                Path('/etc/opentakserver/config.yml'),Path('/etc/opentakserver/config.yaml'),
                Path('/opt/opentakserver/config.yml'),Path('/opt/opentakserver/config.yaml'),
                Path('/var/lib/opentakserver/config.yml'),Path('/var/lib/opentakserver/config.yaml')))
            # An explicit deployment flag allows custom OTS configurations outside the typical paths.
            configured=configured or os.environ.get('TAK_MAP_STATUS_TAK_CONFIGURED','').lower() in ('1','yes','true')
            tak['configured']=bool(configured)
            if tak['enabled'] and tak['configured']:
                active=_sub690.run(['systemctl','is-active','opentakserver.service'],capture_output=True,text=True,timeout=2,check=False)
                tak['state']='Running' if (active.stdout or '').strip()=='active' else 'Offline'
        except (OSError,ValueError,_sub690.TimeoutExpired):pass
        result={'ok':True,'lan':lan,'tak':tak}
        _I690_LAN_CACHE.update(expires=now+25.0,data=result)
        return result

def _i690_get(self):
    route=urlparse(self.path).path
    if route in ('/assets/runtime/tak-map-status-strip-i690.css','/assets/runtime/tak-map-status-strip-i690.js'):
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        filename=route.rsplit('/',1)[-1]
        path=Path(__file__).resolve().parent/'assets'/filename
        if not path.is_file():
            self.send_response(404);self.send_header('Content-Length','0');self.send_header('X-Content-Type-Options','nosniff');self.end_headers();return
        body=path.read_bytes()
        self.send_response(200);self.send_header('Content-Type',('text/css' if filename.endswith('.css') else 'application/javascript')+'; charset=utf-8')
        self.send_header('Cache-Control','private, no-store');self.send_header('X-Content-Type-Options','nosniff')
        self.send_header('Content-Length',str(len(body)));self.end_headers()
        if self.command!='HEAD':self.wfile.write(body)
        return
    if route=='/api/tak-map/status-network-i690':
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        return self._send_json(_i690_status_network())
    return _I690_PREVIOUS_GET(self)
Handler.do_GET=_i690_get

