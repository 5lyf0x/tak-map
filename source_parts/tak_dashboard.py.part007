# --- i674: selective TAK Map Backup/Restore (Gateway and NDM data excluded) ---
_I674_CATEGORIES=('points','shapes','routes','basemaps','veil','geofences','adsb','gateway_data','mesh_sync','data_sync','local_data','offline_maps','satellite')
_I674_BACKUPS=DATA_DIR/'backup_restore_i674'
import subprocess as _i674_subprocess

def _i674_worker(action,payload,timeout=600):
    raw=json.dumps(payload,separators=(',',':')).encode()
    if len(raw)>36*1024*1024:raise ValueError('Backup request too large for single operation')
    r=_i674_subprocess.run(['sudo','-n','/usr/local/sbin/tak-map-action','backup-i674',action],input=raw,
                          stdout=_i674_subprocess.PIPE,stderr=_i674_subprocess.PIPE,timeout=timeout)
    try:result=json.loads(r.stdout.decode().splitlines()[-1])
    except Exception:raise ValueError('Backup worker failed: '+r.stderr.decode(errors='replace')[:240])
    if not r.returncode and result.get('ok'):return result
    raise ValueError(str(result.get('error') or 'Backup operation failed'))

_i674_get_previous=Handler.do_GET
def _i674_get(self):
    path=urlparse(self.path).path
    if not path.startswith('/api/tak-map/backup/'):return _i674_get_previous(self)
    if not self._is_secure_request():return self._send_json({'ok':False,'error':'HTTPS required for encrypted backups'},403)
    if path=='/api/tak-map/backup/job-status':
        q=parse_qs(urlparse(self.path).query)
        job=(q.get('job') or [''])[0];token=(q.get('check') or [''])[0]
        if not re.fullmatch(r'[0-9a-f]{24}',job):return self._send_json({'ok':False,'error':'Invalid job'},400)
        authorized=bool(self._tak_map_auth_ok() and _i540_is_admin(self._tak_map_session() or {}))
        if not authorized:
            access=_I674_BACKUPS/('restore-access-'+job+'.json')
            if not re.fullmatch(r'[0-9a-f]{64}',token) or not access.is_file() or access.is_symlink():
                return self._send_json({'ok':False,'error':'Restore status authorization required'},403)
            try:info=json.loads(access.read_text())
            except Exception:return self._send_json({'ok':False,'error':'Invalid restore authorization'},403)
            if int(time.time())>int(info.get('expires',0)) or not hmac.compare_digest(
                hashlib.sha256(token.encode()).hexdigest(),str(info.get('sha256',''))):
                return self._send_json({'ok':False,'error':'Restore status token expired or invalid'},403)
        status=_I674_BACKUPS/('restore-job-'+job+'.json')
        if not status.is_file() or status.is_symlink():return self._send_json({'ok':True,'pending':True})
        return self._send_json(json.loads(status.read_text()))
    if not _i651_authorize(self,admin=True):return
    if path=='/api/tak-map/backup/capabilities':
        return self._send_json({'ok':True,'version':'1.4.0-i674','categories':list(_I674_CATEGORIES),
                                'max_inline_browser_bytes':32*1024*1024})
    if path=='/api/tak-map/backup/download':
        filename=(parse_qs(urlparse(self.path).query).get('file') or [''])[0]
        if not re.fullmatch(r'tak-map-backup-[0-9TZ]+-[0-9a-f]{10}\.takmbk',filename):
            return self._send_json({'ok':False,'error':'Invalid file'},400)
        path=_I674_BACKUPS/filename
        if not path.is_file() or path.is_symlink():return self._send_json({'ok':False,'error':'Backup not found'},404)
        self.send_response(200);self.send_header('Content-Type','application/octet-stream')
        self.send_header('Cache-Control','private, no-store');self.send_header('X-Content-Type-Options','nosniff')
        self.send_header('Content-Disposition','attachment; filename="'+filename+'"')
        self.send_header('Content-Length',str(path.stat().st_size));self.end_headers()
        with path.open('rb') as f:
            while (b:=f.read(1024*1024)):self.wfile.write(b)
        return
    return self._send_json({'ok':False,'error':'Unknown backup endpoint'},404)
Handler.do_GET=_i674_get

_i674_post_previous=Handler.do_POST
def _i674_post(self):
    path=urlparse(self.path).path
    if not path.startswith('/api/tak-map/backup/'):return _i674_post_previous(self)
    if not _i651_authorize(self,admin=True,mutation=True):return
    if not self._is_secure_request():return self._send_json({'ok':False,'error':'HTTPS required'},403)
    try:
        if path=='/api/tak-map/backup/upload':
            n=int(self.headers.get('Content-Length','0') or '0')
            if not 32<=n<=8*1024**3:return self._send_json({'ok':False,'error':'Invalid upload size'},413)
            _I674_BACKUPS.mkdir(parents=True,exist_ok=True)
            filename='tak-map-backup-'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'-'+secrets.token_hex(5)+'.takmbk'
            dest=_I674_BACKUPS/filename
            with dest.open('xb') as f:
                while n>0:
                    block=self.rfile.read(min(n,1024*1024))
                    if not block:raise ValueError('Truncated upload')
                    f.write(block);n-=len(block)
            os.chmod(dest,0o640)
            return self._send_json({'ok':True,'file':filename,'size':dest.stat().st_size})
        n=int(self.headers.get('Content-Length','0') or '0')
        if n<2 or n>36*1024*1024:return self._send_json({'ok':False,'error':'Invalid request size'},413)
        if not self.headers.get('Content-Type','').lower().startswith('application/json'):
            return self._send_json({'ok':False,'error':'JSON required'},415)
        payload=json.loads(self.rfile.read(n))
        if not isinstance(payload,dict):raise ValueError('Expected object')
        if path=='/api/tak-map/backup/create':result=_i674_worker('create',payload,3600)
        elif path=='/api/tak-map/backup/inspect':result=_i674_worker('inspect',payload,1200)
        elif path=='/api/tak-map/backup/restore':result=_i674_worker('restore',payload,3600)
        elif path=='/api/tak-map/backup/schedule':result=_i674_worker('schedule',payload,1200)
        elif path=='/api/tak-map/backup/browser':result=_i674_worker('browser',payload,1200)
        else:return self._send_json({'ok':False,'error':'Unknown operation'},404)
        return self._send_json(result)
    except Exception as exc:
        return self._send_json({'ok':False,'error':str(exc)[:400]},400)
Handler.do_POST=_i674_post

TAK_MAP_HTML=TAK_MAP_HTML.replace('onclick="exportAllData()">Export All Data</button>',
                                  'onclick="TakMapBackupI674.open()">Backup/Restore</button>',1)
TAK_MAP_HTML=re.sub(r'<details class="export-options">.*?</details>','',TAK_MAP_HTML,count=1,flags=re.S)
assert 'onclick="exportAllData()">Export All Data</button>' not in TAK_MAP_HTML
assert TAK_MAP_HTML.count('</body></html>')==1
TAK_MAP_HTML=TAK_MAP_HTML.replace('</body></html>',
   '<script src="/assets/runtime/tak-map-backup-i674.js?v=1.4.0-i674"></script></body></html>',1)
TAK_MAP_HTML=TAK_MAP_HTML.replace("ITERATION='i673'","ITERATION='i674'").replace("const iteration='i673'","const iteration='i674'")
TAK_MAP_HTML=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\g<1>i674\2',TAK_MAP_HTML)
TAK_MAP_HTML=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\g<1>i674\2',TAK_MAP_HTML)
TAK_MAP_HTML=re.sub(r'([?&]v=)1\.4\.0-i\d+',r'\g<1>1.4.0-i674',TAK_MAP_HTML)
INDEX_HTML=TAK_MAP_HTML
TAK_MAP_ITERATION='i674'
_i674_prior_config=tak_map_config
def tak_map_config():
    out=_i674_prior_config()
    if isinstance(out,dict):out.update({'version':'1.4.0-i674','tak_map_iteration':'i674'})
    return out
_i674_assets_get_previous=Handler.do_GET
def _i674_assets_get(self):
    if urlparse(self.path).path!='/assets/runtime/tak-map-backup-i674.js':return _i674_assets_get_previous(self)
    if not _i651_authorize(self):return
    content=(Path(__file__).resolve().parent/'assets'/'tak-map-backup-i674.js').read_bytes()
    self.send_response(200);self.send_header('Content-Type','application/javascript; charset=utf-8')
    self.send_header('Cache-Control','private, no-store');self.send_header('Content-Length',str(len(content)))
    self.end_headers()
    if self.command!='HEAD':self.wfile.write(content)
Handler.do_GET=_i674_assets_get
# --- end i674 ---

# --- TAK Map i675: route-tool package selection, reversible Valhalla activation ---
from tak_map_graph_switch_i675 import GraphSwitcher as _I675GraphSwitcher
_I675_ROUTING_SWITCHER = _I675GraphSwitcher(_i651_catalog)
_i675_prior_get = Handler.do_GET
_i675_prior_post = Handler.do_POST

def _i675_get(self):
    route = urlparse(self.path).path
    if route == '/assets/runtime/tak-map-routing-dropdown-i675.js':
        if not _i651_authorize(self):return
        payload = (Path(__file__).resolve().parent/'assets'/'tak-map-routing-dropdown-i675.js').read_bytes()
        self.send_response(200)
        self.send_header('Content-Type','application/javascript; charset=utf-8')
        self.send_header('Content-Length',str(len(payload)))
        self.send_header('Cache-Control','private, no-store')
        self.end_headers()
        if self.command!='HEAD':self.wfile.write(payload)
        return
    if route == '/api/tak-map/routing/datasets-i675':
        if not _i651_authorize(self):return
        try:return self._send_json({**_I675_ROUTING_SWITCHER.options(),
                                    'router_state':_i651_service_state(_i651_catalog)['router_state']})
        except (OSError,ValueError) as error:
            return self._send_json({'ok':False,'error':str(error)[:200]},400)
    return _i675_prior_get(self)
Handler.do_GET = _i675_get

def _i675_post(self):
    route = urlparse(self.path).path
    if route != '/api/tak-map/routing/activate-i675':
        if route in ('/api/tak-map/routing/resolve','/api/tak-map/routing/snap'):
            if _I675_ROUTING_SWITCHER.job['status'] in ('preparing','restarting'):
                return self._send_json({'ok':False,'code':'ROUTING_SWITCHING',
                                        'error':'Routing graph is being changed; wait until ready'},503)
        return _i675_prior_post(self)
    if not _i651_authorize(self,admin=True,mutation=True):return
    try:
        data = _i651_json_input(self)
        # Never accept filesystem paths or URLs from a browser; only the exact
        # SHA-256 identifier of a registered, validated local routing package.
        result = _I675_ROUTING_SWITCHER.start(data.get('dataset_id'))
        return self._send_json(result,202 if result.get('accepted') else 200)
    except (ValueError,KeyError,OSError) as error:
        code = getattr(error,'code','INVALID_REQUEST')
        return self._send_json({'ok':False,'code':code,'error':str(error)[:300]},
                               409 if code=='SWITCH_BUSY' else 400)
Handler.do_POST = _i675_post

