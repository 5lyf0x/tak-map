        marker_token = ''
        if auth_mode_text.startswith('ots-'):
            auth = dict(auth or {})
            if _i583hf4_text(auth.get('auth_method')) == 'api-auth-token':
                marker_token = _i583hf4_text(auth.get('token'))
                marker_login = {
