# --- TAK Map i673: read-only NDM active routing graph vector tile service ---
import urllib.request as _i673_urllib_request
import urllib.error as _i673_urllib_error

_i673_prev_get=Handler.do_GET

def _i673_get(self):
    path=urlparse(self.path).path
    root='/api/tak-map/ndm/network/'
    if not path.startswith(root):return _i673_prev_get(self)
    if not _i651_authorize(self):return
    if path==root+'status':
        from ndm_valhalla_i651 import service_state as _i673_service_state
        health=_i673_service_state(_i651_catalog)
        catalog=[d for d in _i651_catalog.listing() if d.get('type')=='routing' and d.get('available')]
        graph=[d for d in catalog if d.get('active')]
        active=graph[0] if len(graph)==1 else None
        ready=health.get('router_state')=='ready'
        return self._send_json({'ok':True,'router_ready':ready,
          'dataset_id':active.get('dataset_id') if active else None,
          'graph_revision':active.get('dataset_id') if active else 'runtime-valhalla-unknown',
          'registered_graphs':len(catalog),
          'coverage_note':'MVUM · active Valhalla graph' if active else
             'MVUM · current Valhalla graph (NDM dataset identity unverified)',
          'partial_coverage':len(catalog)>1})
    import re as _i673_re
    m=_i673_re.fullmatch(r'/api/tak-map/ndm/network/tiles/current/(\d{1,2})/(\d{1,9})/(\d{1,9})\.pbf',path)
    if not m:return self._send_json({'ok':False,'error':'Unknown network tile endpoint'},404)
    z,x,y=map(int,m.groups())
    if z<11 or z>16 or x>=2**z or y>=2**z:
        return self._send_json({'ok':False,'error':'Tile out of range'},400)
    request_body={'tile':{'z':z,'x':x,'y':y},
        'tile_options':{'exclude_layers':['nodes','shortcuts','access_restrictions']},
        'generalize':4.0}
    try:
        upstream='http://127.0.0.1:18882/tile?json='+quote(json.dumps(request_body,separators=(',',':')),safe='')
        req=_i673_urllib_request.Request(upstream,headers={'Accept':'application/vnd.mapbox-vector-tile'})
        with _i673_urllib_request.urlopen(req,timeout=12) as resp:
            if resp.status!=200:raise ValueError('Navigation graph tile unavailable')
            data=resp.read(2_500_001)
        if len(data)>2_500_000:raise ValueError('NDM navigation graph tile exceeds size limit')
        if not data:return self._send_json({'ok':False,'error':'Empty navigation tile'},404)
    except (_i673_urllib_error.URLError,OSError,TimeoutError,ValueError) as exc:
        return self._send_json({'ok':False,'error':'NDM graph tile unavailable: '+str(exc)[:140]},503)
    self.send_response(200)
    self.send_header('Content-Type','application/vnd.mapbox-vector-tile')
    self.send_header('Cache-Control','private, max-age=45')
    self.send_header('Content-Length',str(len(data)))
    self.end_headers()
    if self.command!='HEAD':self.wfile.write(data)
Handler.do_GET=_i673_get
# --- end NDM navigation network service ---


# --- TAK Map i673: authenticated read-only NDM terrain sampling for Viewshed ---
from ndm_elevation_i673 import Sampler as _I673TerrainSampler, NdmElevationError as _I673TerrainError
_i673_terrain=_I673TerrainSampler(_i651_catalog)
_i673_prev_get_elevation=Handler.do_GET
_i673_prev_post_elevation=Handler.do_POST

def _i673_get_elevation(self):
    path=urlparse(self.path).path
    if path!='/api/tak-map/ndm/elevation/coverage':return _i673_prev_get_elevation(self)
    if not _i651_authorize(self):return
    try:
        qs=parse_qs(urlparse(self.path).query)
        vals=[float(qs[x][0]) for x in ('west','south','east','north')]
        return self._send_json({'ok':True,**_i673_terrain.coverage(vals)})
    except (KeyError,ValueError,TypeError,OSError) as e:
        return self._send_json({'ok':False,'error':str(e)[:200]},400)
Handler.do_GET=_i673_get_elevation

def _i673_post_elevation(self):
    if urlparse(self.path).path!='/api/tak-map/ndm/elevation/sample':return _i673_prev_post_elevation(self)
    if not _i651_authorize(self,mutation=True):return
    try:
        if self.headers.get('Content-Type','').split(';')[0].strip()!='application/json':
            return self._send_json({'ok':False,'error':'JSON body required'},415)
        length=int(self.headers.get('Content-Length','0') or '0')
        if length<4 or length>300000:return self._send_json({'ok':False,'error':'Elevation batch too large'},413)
        payload=json.loads(self.rfile.read(length))
        if not isinstance(payload,dict):raise _I673TerrainError('JSON object required')
        result=_i673_terrain.sample(payload.get('points'))
        return self._send_json({'ok':True,**result})
    except (_I673TerrainError,ValueError,TypeError,KeyError,OSError,RuntimeError) as e:
        code=503 if 'preparing' in str(e).lower() or 'busy' in str(e).lower() else 422
        return self._send_json({'ok':False,'error':str(e)[:200]},code)
Handler.do_POST=_i673_post_elevation
# --- end TAK Map i673 NDM elevation ---


