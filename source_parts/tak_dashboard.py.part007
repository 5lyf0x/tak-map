async function enroll(){if(busy)return;setBusy(true);output('Discovering standard OpenTAKServer endpoints and enrolling…');try{const j=await request('/api/tak-map/ots/enroll-auto',transport(''));if(j.needs_input){reveal(j.required_fields);output((j.error||'Additional information is required.')+'\n\nOnly the highlighted fields need to be entered.',true)}else{reveal([]);render(j);output(j.message||j,false)}}catch(e){output(e.message||String(e),true)}finally{clearRequestSecrets();setBusy(false)}}
async function disconnect(){if(!confirm('Disable OTS login while keeping connection details and enrollment?'))return;setBusy(true);try{const j=await request('/api/tak-map/ots/disconnect',{q:[]});alert(j.message||'OpenTAKServer disconnected.');location.href='/tak-map/login'}catch(e){output(e.message||String(e),true);setBusy(false)}}
function updateUnenrollState(){const input=slot('u01'),submit=by('o589UnenrollSubmit');if(submit)submit.disabled=busy||!input||input.value!=='UNENROLL'}function openUnenrollDialog(){if(busy)return;const dlg=by('o589UnenrollDialog'),input=slot('u01'),err=by('o589UnenrollError');if(!dlg||!input)return;input.value='';if(err)err.textContent='';updateUnenrollState();dlg.classList.add('active');dlg.setAttribute('aria-hidden','false');setTimeout(()=>input.focus(),60)}function closeUnenrollDialog(){if(busy)return;const dlg=by('o589UnenrollDialog'),input=slot('u01'),err=by('o589UnenrollError');if(input)input.value='';if(err)err.textContent='';if(dlg){dlg.classList.remove('active');dlg.setAttribute('aria-hidden','true')}updateUnenrollState()}async function submitUnenroll(){const input=slot('u01'),c=input?input.value:'';if(busy||c!=='UNENROLL')return;const err=by('o589UnenrollError');if(err)err.textContent='';setBusy(true);try{const j=await request('/api/tak-map/ots/unenroll',transport(c)),remote=j.remote_revocation||{};let msg=j.message||'OpenTAKServer enrollment removed.';if(remote.outstanding&&remote.outstanding.length)msg+='\n\nRemote certificate cleanup outstanding: '+remote.outstanding.length+'.';alert(msg);location.href='/tak-map/login'}catch(e){const msg=e.message||String(e);if(err)err.textContent=msg;output(msg,true);setBusy(false);if(input)input.focus()}finally{clearRequestSecrets()}}
async function loadLocal(){try{const r=await fetch('/api/tak-map/local-users',{cache:'no-store',credentials:'same-origin'}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'Could not load local users');by('o589LocalState').textContent=(j.ots_connected?'OTS connected · local non-admin login disabled':'OTS disconnected · local users enabled')+' · '+j.users.length+' account(s)';by('o589LocalList').innerHTML=j.users.map(u=>'<div class="local-row"><span><b>'+esc(u.username)+'</b><br>'+esc((u.is_admin?'Administrator':'Local user')+' · '+(u.active?'Enabled':'Disabled')+' · '+(u.callsign||'no callsign'))+'</span></div>').join('')}catch(e){by('o589LocalState').textContent=e.message||String(e)}}
async function createLocal(){try{await request('/api/tak-map/local-users/q589',{q:['create',val('a13'),val('a14'),val('a15')]});clearSlots(['a13','a14']);loadLocal()}catch(e){output(e.message||String(e),true)}finally{clearSlots(['a15'])}}
function open(){ensure();clearModalCredentials();relockAll();prepareNoAutofill(true);modal().classList.add('active');modal().setAttribute('aria-hidden','false');[0,60,250,900].forEach(ms=>setTimeout(()=>{modal()&&modal().querySelectorAll(Q).forEach(n=>{if(n.dataset.unlocked!=='1')n.value=n.dataset.appValue||''})},ms));load()}function close(){if(busy)return;closeUnenrollDialog();clearModalCredentials();relockAll();if(modal()){modal().classList.remove('active');modal().setAttribute('aria-hidden','true')}}
function install(){ensure();w.openConfigureOTS=open;w.closeConfigureOTS=close;const b=by('takClientSetupBtn');if(b){b.textContent='Configure OTS';b.onclick=e=>{e.preventDefault();open()}}}
function boot(){install();[200,700,1600,3200,5200].forEach(ms=>setTimeout(install,ms));d.addEventListener('click',e=>{const t=e.target&&e.target.closest&&e.target.closest('#takAccountConfigureV511,#configureV512,[data-action="configure-ots"]');if(t){e.preventDefault();setTimeout(open,0)}},true)}if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapConfigureOtsI589=Object.freeze({version:V,open,close,load,enroll,reveal,transport,prepareNoAutofill,clearRequestSecrets,relockAll,openUnenrollDialog,closeUnenrollDialog,submitUnenroll,updateUnenrollState});
})(window,document);
</script>
'''

    def _i589_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+(?:-[A-Za-z0-9_-]+)?', '1.3.0-i589', html)
        html = re.sub(r'TAKDashboard/i\d+(?:-[A-Za-z0-9_-]+)?', 'TAKDashboard/i589', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i589', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i589\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i589\2', html)
        if 'id="takMapConfigureOtsI589"' not in html:
            html = html.replace('</body></html>', _I589_CONFIGURE_OTS_UI + '</body></html>')
        return html

    # Consolidated i589 package identity on point-save and Data Sync responses.
    if '_i555_save_point' in globals():
        _i589_save_point_before = _i555_save_point
        def _i555_save_point(payload):
            reply, status = _i589_save_point_before(payload)
            if isinstance(reply, dict):
                reply = dict(reply)
                reply['version'] = _I589_VERSION
            return reply, status
        globals()['_i555_save_point'] = _i555_save_point

    if '_i568_response_payload' in globals():
        _i589_response_payload_before = _i568_response_payload
        def _i568_response_payload(state):
            payload = _i589_response_payload_before(state)
            if isinstance(payload, dict):
                payload = dict(payload)
                payload['version'] = _I589_VERSION
                payload['configure_ots_i589'] = {
                    'standard_endpoint_discovery_first': True,
                    'enrollment_manifest': True,
                    'manifest_scoped_unenrollment': True,
                    'configure_ots_autofill_suppression': True,
                    'credential_fields_clear_after_request_and_close': True,
                    'opaque_field_ids_and_names': True,
                    'opaque_positional_request_transport': True,
                    'sentence_case_labels': True,
                    'compact_checkbox_text': True,
                    'all_four_checkboxes_checked_for_new_configuration': True,
                    'ots_default_helper_text': 'OTS Default: https://opentakserver',
                    'protocol_aware_endpoint_classification': True,
                    'certificate_hostname_discovery': True,
                }
            return payload
        globals()['_i568_response_payload'] = _i568_response_payload

    _i589_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i589_config_before() or {})
        cfg['version'] = '1.3.0-i589'
        cfg['tak_map_iteration'] = _I589_VERSION
        cfg['configure_ots_i589'] = {
            'minimum_initial_fields': ['server_address', 'administrator_username', 'administrator_password'],
            'otp_progressive_only': True,
            'standard_endpoint_discovery_first': True,
            'failed_endpoint_overrides_only': True,
            'passwords_never_persisted': True,
            'full_functionality_defaults_checked': True,
            'enrollment_manifest': str(_I589_ENROLLMENT_MANIFEST_FILE),
            'disconnect_helper': 'Disabled OTS login but keeps connection details.',
            'unenroll_helper': 'Disconnects and completely removes OTS enrollment.',
            'manifest_scoped_cleanup_only': True,
            'remote_revocation_when_advertised': True,
            'remote_revocation_failure_does_not_block_local_unenrollment': True,
            'browser_autofill_suppressed': True,
            'password_manager_opt_out_attributes': True,
            'sensitive_fields_readonly_until_user_interaction': True,
            'request_secrets_cleared_after_each_request': True,
            'modal_credentials_cleared_on_close': True,
            'opaque_field_ids_and_names': True,
            'opaque_positional_request_transport': True,
            'semantic_transport_keys_exposed_by_browser': False,
            'connection_section_header_removed': True,
            'sentence_case_labels': True,
            'compact_checkbox_text': True,
            'two_factor_label': '2FA Code (optional)',
            'all_four_checkboxes_checked_for_new_configuration': True,
            'ots_default_helper_text': 'OTS Default: https://opentakserver',
            'protocol_aware_endpoint_classification': True,
            'certificate_hostname_discovery': True,
            'marti_missing_client_certificate_response_is_success': True,
            'enrollment_405_with_post_is_success': True,
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config

    TAK_MAP_HTML = _i589_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i589_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I589_VERSION
except Exception as _i589_exc:
    try:
        print('TAK Map i589 automated Configure OTS patch failed:', _i589_exc)
    except Exception:
        pass
# --- end TAK Map i589 automated Configure OTS and manifest-based unenrollment ---


# --- TAK Map i590 topology-aware local and remote OpenTAKServer Data Sync ---
try:
    _I590_VERSION = 'i590'
    _I590_PACKAGE_VERSION = '1.3.0-i590'
    _I590_MISSING_POSTGRES_ERROR = 'no opentakserver postgresql uri found'

    def _i590_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i590_clone(value):
        try:
            return _i568_clone(value) if '_i568_clone' in globals() else json.loads(json.dumps(value, ensure_ascii=False))
        except Exception:
            return dict(value) if isinstance(value, dict) else value

    def _i590_remote_seed(payload):
        if not isinstance(payload, dict):
            return {}
        for key in ('data_sync_remote_seed_i569', 'data_sync_remote_seed_i568'):
            row = payload.get(key)
            if isinstance(row, dict):
                return row
        return {}

    def _i590_acquisition_summary(payload, acquired=None):
        if isinstance(acquired, dict) and isinstance(acquired.get('summary'), dict):
            return dict(acquired.get('summary') or {})
        if not isinstance(payload, dict):
            return {}
        for key in ('data_sync_background_worker_i569', 'data_sync_background_worker_i568'):
            worker = payload.get(key)
            if isinstance(worker, dict) and isinstance(worker.get('acquisition'), dict):
                return dict(worker.get('acquisition') or {})
        for key in ('data_sync_background_i583','data_sync_background_i582','data_sync_background_i581','data_sync_background_i570','data_sync_background_i569','data_sync_background_i568'):
            bg = payload.get(key)
            if isinstance(bg, dict):
                summary = bg.get('acquisition_summary') or bg.get('acquisition')
                if isinstance(summary, dict):
                    return dict(summary)
        return {}

    def _i590_remote_snapshot(payload, acquired=None):
        if not isinstance(payload, dict):
            return False
        seed = _i590_remote_seed(payload)
        summary = _i590_acquisition_summary(payload, acquired)
        return bool(seed.get('per_user_authenticated_source') or summary.get('discovery_ok') or payload.get('data_sync_background_worker_i569'))

    def _i590_valid_snapshot(payload):
        return isinstance(payload, dict) and isinstance(payload.get('missions'), list) and isinstance(payload.get('objects'), list)

    def _i590_source_rows(payload):
        rows = payload.get('sources') if isinstance(payload, dict) else None
        return [dict(row) for row in rows if isinstance(row, dict)] if isinstance(rows, list) else []

    def _i590_pg_candidates():
        try:
            uris, errors = _candidate_ots_pg_uris()
            return list(uris or []), list(errors or [])
        except Exception as exc:
            return [], [_i590_text(exc)]

    def _i590_first_background(payload):
        if not isinstance(payload, dict):
            return {}
        for key in ('data_sync_background_i583','data_sync_background_i582','data_sync_background_i581','data_sync_background_i570','data_sync_background_i569','data_sync_background_i568'):
            row = payload.get(key)
            if isinstance(row, dict):
                return dict(row)
        return {}

    def _i590_normalize_remote_payload(payload, acquired=None):
        out = _i590_clone(payload) if isinstance(payload, dict) else payload
        if not isinstance(out, dict) or not _i590_remote_snapshot(out, acquired):
            return out

        summary = _i590_acquisition_summary(out, acquired)
        seed = _i590_remote_seed(out)
        valid = _i590_valid_snapshot(out)
        mission_api_ok = bool(summary.get('discovery_ok') or seed.get('per_user_authenticated_source'))
        rows = _i590_source_rows(out)
        pg_uris, pg_config_errors = _i590_pg_candidates()
        pg_rows = [row for row in rows if _i590_text(row.get('source')).casefold().startswith('postgres:')]
        pg_ok = any(bool(row.get('ok')) for row in pg_rows)
        pg_failed = any(not bool(row.get('ok')) for row in pg_rows)
        original_error = _i590_text(out.get('error'))
        missing_pg = _I590_MISSING_POSTGRES_ERROR in original_error.casefold()

        # A successful authenticated Mission API snapshot is authoritative in a
        # remote topology. Absence of a local PostgreSQL URI is an optional,
        # expected condition and must never invalidate the snapshot.
        if mission_api_ok and valid and missing_pg:
            out['ok'] = True
            out['error'] = ''
            out['partial'] = bool(out.get('partial', False))
            out['remote_mission_api_recovered_i590'] = True
            out['nonfatal_source_error_i590'] = original_error

        mission_count = len(out.get('missions') or [])
        object_count = len(out.get('objects') or [])
        content_count = len(out.get('mission_content') or [])
        membership = out.get('data_sync_membership_corroboration_i582')
        membership = dict(membership) if isinstance(membership, dict) else {}
        background = _i590_first_background(out)

        source_status = {
            'mission_api': {
                'source': 'ots-mission-api',
                'ok': mission_api_ok,
                'authoritative_for_remote_topology': True,
                'mission_count': mission_count,
                'object_count': object_count,
                'content_count': content_count,
                'discovery_ok': bool(summary.get('discovery_ok')),
                'authentication_failure_count': int(summary.get('authentication_failure_count') or 0),
            },
            'postgresql': {
                'source': 'local-ots-postgresql',
                'ok': pg_ok,
                'optional_for_remote_topology': True,
                'configured': bool(pg_uris),
                'skipped': not bool(pg_uris),
                'failed': bool(pg_failed),
                'table_source_count': len(pg_rows),
                'configuration_error_count': len(pg_config_errors),
                'reason': 'not-configured-on-tak-map-host' if not pg_uris else ('available' if pg_ok else 'configured-but-unavailable'),
            },
            'mission_membership': {
                'source': 'ots-mission-membership',
                'ok': bool(membership) or mission_api_ok,
                'phase': _i590_text(membership.get('phase') or background.get('requested_mode')),
                'effective_mission_count': int(membership.get('effective_mission_count') or mission_count),
                'effective_uid_count': int(membership.get('effective_uid_count') or object_count),
            },
            'cot_enrichment': {
                'source': 'ots-mission-cot',
                'ok': bool(background.get('last_full_cot_enrichment_at') or summary.get('cot_enrichment_success_count') or mission_api_ok),
                'last_full_cot_enrichment_at': _i590_text(background.get('last_full_cot_enrichment_at')),
                'success_count': int(summary.get('cot_enrichment_success_count') or 0),
                'failure_count': int(summary.get('cot_enrichment_failure_count') or 0),
                'pending_count': int(summary.get('cot_enrichment_pending_count') or 0),
            },
        }

        # Keep existing detailed source rows intact and add concise topology
        # records. These records never contain a PostgreSQL URI or credentials.
        if not any(_i590_text(row.get('source')) == 'ots-mission-api:i590' for row in rows):
            rows.append({
                'source': 'ots-mission-api:i590', 'ok': mission_api_ok,
                'authoritative': True, 'topology': 'remote-or-hybrid',
                'missions': mission_count, 'objects': object_count,
            })
        if not any(_i590_text(row.get('source')) == 'postgres:i590' for row in rows):
            rows.append({
                'source': 'postgres:i590',
                'ok': pg_ok or not pg_uris,
                'optional': True,
                'skipped': not bool(pg_uris),
                'configured': bool(pg_uris),
                'reason': source_status['postgresql']['reason'],
            })
        out['sources'] = rows

        warnings = out.get('warnings')
        warnings = list(warnings) if isinstance(warnings, list) else ([] if not warnings else [_i590_text(warnings)])
        if mission_api_ok and pg_uris and pg_failed:
            warning = 'Optional local OpenTAKServer PostgreSQL access is unavailable; the authenticated Mission API snapshot remains active.'
            if warning not in warnings:
                warnings.append(warning)
            out['partial'] = True
        if warnings:
            out['warnings'] = warnings

        mode = 'hybrid' if pg_ok else 'remote-mission-api'
        out['data_sync_sources_i590'] = source_status
        out['data_sync_topology_i590'] = {
            'version': _I590_VERSION,
            'mode': mode,
            'remote_mission_api_authoritative': True,
            'local_postgresql_preserved': True,
            'local_postgresql_required_for_remote_topology': False,
            'canonical_uid_merge': True,
            'last_known_good_preserved': True,
            'valid_snapshot': valid,
            'original_nonfatal_error': original_error if missing_pg else '',
            'mission_count': mission_count,
            'object_count': object_count,
        }
        out['version'] = _I590_VERSION
        return out

    if '_i568_build_snapshot' in globals():
        _i590_build_snapshot_before = _i568_build_snapshot
        def _i568_build_snapshot(cfg, sess, token, reason):
            result, acquired = _i590_build_snapshot_before(cfg, sess, token, reason)
            return _i590_normalize_remote_payload(result, acquired), acquired
        globals()['_i568_build_snapshot'] = _i568_build_snapshot

    if '_i568_response_payload' in globals():
        _i590_response_payload_before = _i568_response_payload
        def _i568_response_payload(state):
            payload = _i590_response_payload_before(state)
            payload = _i590_normalize_remote_payload(payload, None)
            if isinstance(payload, dict):
                payload['version'] = _I590_VERSION
            return payload
        globals()['_i568_response_payload'] = _i568_response_payload

    _i590_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i590_config_before() or {})
        cfg['version'] = _I590_PACKAGE_VERSION
        cfg['tak_map_iteration'] = _I590_VERSION
        cfg['data_sync_topology_i590'] = {
            'local_postgresql_path_preserved': True,
            'remote_mission_api_path_added': True,
            'hybrid_canonical_uid_merge': True,
            'postgres_optional_for_remote_topology': True,
            'mission_api_authoritative_for_authenticated_remote_users': True,
            'independent_source_status': ['mission_api','postgresql','mission_membership','cot_enrichment'],
            'last_known_good_preserved': True,
            'browser_renders_valid_partial_snapshots': True,
        }
        startup = dict(cfg.get('startup_architecture_i585') or {})
        startup.update({'package_version': _I590_VERSION, 'startup_loader_cache_identity': _I590_PACKAGE_VERSION,
                        'manifest_cache_identity': _I590_PACKAGE_VERSION, 'data_sync_control_cache_identity': _I590_PACKAGE_VERSION})
        cfg['startup_architecture_i590'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i590_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+(?:-[A-Za-z0-9_-]+)?', _I590_PACKAGE_VERSION, html)
        html = re.sub(r'TAKDashboard/i\d+(?:-[A-Za-z0-9_-]+)?', 'TAKDashboard/i590', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i590', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i590\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i590\2', html)
        return html

    TAK_MAP_HTML = _i590_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i590_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I590_VERSION
except Exception as _i590_exc:
    try:
        print('TAK Map i590 topology-aware Data Sync patch failed:', _i590_exc)
    except Exception:
        pass
# --- end TAK Map i590 topology-aware local and remote OpenTAKServer Data Sync ---


# --- TAK Map i591 Mission-password security boundary for local, remote, and hybrid Data Sync ---
try:
    _I591_VERSION = 'i591'
    _I591_PACKAGE_VERSION = '1.3.0-i591'
    _I591_ACCESS_ROOT = DATA_DIR / 'mission_access_index_i591'
    _I591_ACCESS_ROOT.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(_I591_ACCESS_ROOT, 0o700)
    except Exception:
        pass
    _I591_ACCESS_LOCK = threading.RLock()
    _I591_VALIDATION_LOCK = threading.RLock()
    _I591_VALIDATED_MISSIONS = {}
    _I591_VALIDATION_MAX_AGE_SECONDS = 45.0
    _I591_CONTEXT = threading.local()

    def _i591_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i591_scope(sess=None):
        try:
            return _i572_scope(sess if isinstance(sess, dict) else None)
        except Exception:
            try:
                return _i535_user_hash(sess if isinstance(sess, dict) else {})
            except Exception:
                return 'unknown'

    def _i591_validation_key(mission, sess=None):
        return (_i591_scope(sess), _i591_text(mission).casefold())

    def _i591_invalidate_validation(mission, sess=None):
        key = _i591_validation_key(mission, sess)
        with _I591_VALIDATION_LOCK:
            _I591_VALIDATED_MISSIONS.pop(key, None)
        return True

    def _i591_mark_validated(mission, sess=None, token='', source='mission-password-validation'):
        mission = _i591_text(mission)
        if not mission:
            return False
        creator_uid = _i591_text(_i572_creator_uid())
        token = _i591_text(token) or _i591_text(_i572_cached_token(mission, creator_uid))
        if not creator_uid or not token:
            return False
        with _I591_VALIDATION_LOCK:
            _I591_VALIDATED_MISSIONS[_i591_validation_key(mission, sess)] = {
                'mission': mission,
                'creator_uid': creator_uid,
                'token': token,
                'validated_at': time.time(),
                'source': _i591_text(source),
            }
        return True

    def _i591_is_validated(mission, sess=None):
        mission = _i591_text(mission)
        creator_uid = _i591_text(_i572_creator_uid())
        if not mission or not creator_uid:
            return False
        current_token = _i591_text(_i572_cached_token(mission, creator_uid))
        if not current_token:
            _i591_invalidate_validation(mission, sess)
            return False
        with _I591_VALIDATION_LOCK:
            record = dict(_I591_VALIDATED_MISSIONS.get(_i591_validation_key(mission, sess)) or {})
        valid = bool(
            record and
            _i591_text(record.get('creator_uid')).casefold() == creator_uid.casefold() and
            _i591_text(record.get('token')) == current_token and
            time.time() - float(record.get('validated_at') or 0) <= _I591_VALIDATION_MAX_AGE_SECONDS
        )
        if not valid:
            _i591_invalidate_validation(mission, sess)
        return valid

    def _i591_index_path(sess=None):
        return _I591_ACCESS_ROOT / (_i591_scope(sess) + '.json')

    def _i591_load_index(sess=None):
        path = _i591_index_path(sess)
        try:
            raw = json.loads(path.read_text(encoding='utf-8'))
            rows = raw.get('missions') if isinstance(raw, dict) else []
            out = {}
            for row in rows if isinstance(rows, list) else []:
                if not isinstance(row, dict):
                    continue
                name = _i591_text(row.get('mission'))
                if name:
                    out[name.casefold()] = {
                        'mission': name,
                        'protected': bool(row.get('protected')),
                        'last_seen_at': _i591_text(row.get('last_seen_at')),
                    }
            return out
        except Exception:
            return {}

    def _i591_save_index(rows, sess=None):
        safe = []
        for row in (rows or {}).values() if isinstance(rows, dict) else []:
            if not isinstance(row, dict):
                continue
            name = _i591_text(row.get('mission'))
            if not name:
                continue
            safe.append({
                'mission': name[:180],
                'protected': bool(row.get('protected')),
                'last_seen_at': _i591_text(row.get('last_seen_at')) or datetime.now(timezone.utc).isoformat(),
            })
        path = _i591_index_path(sess)
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(path.parent, 0o700)
        except Exception:
            pass
        _i529_atomic_write(path, json.dumps({'version': _I591_VERSION, 'missions': safe}, separators=(',', ':')), 0o600, False)

    def _i591_remember_mission(mission, protected=True, sess=None):
        mission = _i591_text(mission)[:180]
        if not mission:
            return
        with _I591_ACCESS_LOCK:
            rows = _i591_load_index(sess)
            prior = rows.get(mission.casefold()) or {}
            rows[mission.casefold()] = {
                'mission': mission,
                'protected': bool(protected or prior.get('protected')),
                'last_seen_at': datetime.now(timezone.utc).isoformat(),
            }
            _i591_save_index(rows, sess)
        try:
            _i572_set_protected(mission, bool(protected), sess)
        except Exception:
            pass

    def _i591_mission_name(row):
        if isinstance(row, str):
            return _i591_text(row)
        if not isinstance(row, dict):
            return ''
        return _i591_text(row.get('mission') or row.get('mission_name') or row.get('missionName') or row.get('name'))

    def _i591_row_protected(row):
        if not isinstance(row, dict):
            return False
        return bool(row.get('passwordProtected') is True or row.get('password_protected') is True or row.get('protected') is True or row.get('password_stored_server_side') is True or row.get('credential_configured') is True)

    def _i591_uid(row):
        if not isinstance(row, dict):
            return ''
        try:
            return _i568_text(_i555_ci_value(row, ('event_uid','cot_uid','uid','data_uid','id')))
        except Exception:
            return _i591_text(row.get('event_uid') or row.get('cot_uid') or row.get('uid') or row.get('data_uid') or row.get('id'))

    def _i591_index_snapshot(state, sess=None):
        snapshot = state.get('snapshot') if isinstance(state, dict) and isinstance(state.get('snapshot'), dict) else {}
        candidates = []
        for key in ('missions','mission_access_i591','mission_access_i576','mission_access_i575','mission_access_i573','mission_access_i572'):
            rows = snapshot.get(key) if isinstance(snapshot, dict) else None
            if isinstance(rows, list):
                candidates.extend(rows)
        with _I591_ACCESS_LOCK:
            index = _i591_load_index(sess)
            changed = False
            for row in candidates:
                name = _i591_mission_name(row)
                if not name:
                    continue
                protected = _i591_row_protected(row)
                if not protected:
                    try:
                        protected = bool(_i572_protected_status(name, sess).get('protected'))
                    except Exception:
                        protected = False
                previous = index.get(name.casefold()) or {}
                merged_protected = bool(protected or previous.get('protected'))
                if name.casefold() not in index or merged_protected != bool(previous.get('protected')):
                    changed = True
                index[name.casefold()] = {
                    'mission': name,
                    'protected': merged_protected,
                    'last_seen_at': datetime.now(timezone.utc).isoformat(),
                }
                try:
                    _i572_set_protected(name, merged_protected, sess)
                except Exception:
                    pass
            if changed:
                _i591_save_index(index, sess)
        return index

    _i591_subscribe_before = _i572_subscribe_with_password
    def _i572_subscribe_with_password(mission, creator_uid, password, server_host=''):
        result = dict(_i591_subscribe_before(mission, creator_uid, password, server_host) or {})
        sess = _i572_session()
        if result.get('ok') and result.get('token'):
            _i591_mark_validated(mission, sess, result.get('token'), result.get('source') or 'mission-password-subscription-i591')
        else:
            _i591_invalidate_validation(mission, sess)
            if result.get('invalid_password'):
                try:
                    _i572_remove_password(mission, sess)
                except Exception:
                    pass
                try:
                    _i564_invalidate_mission_token(mission, creator_uid)
                except Exception:
                    pass
        return result
    globals()['_i572_subscribe_with_password'] = _i572_subscribe_with_password

    def _i591_validate_stored_password(mission, sess=None, server_host=''):
        mission = _i591_text(mission)
        sess = sess if isinstance(sess, dict) else _i572_session()
        stored = _i572_load_password(mission, sess)
        if not stored.get('ok'):
            _i591_invalidate_validation(mission, sess)
            return {'ok': False, 'status': 423, 'mission_password_required': True,
                    'error': 'Mission password required before any protected Mission request.'}
        if _i591_is_validated(mission, sess):
            creator_uid = _i591_text(_i572_creator_uid())
            return {'ok': True, 'status': 200, 'token': _i572_cached_token(mission, creator_uid),
                    'source': 'validated-session-cache-i591'}
        creator_uid = _i591_text(_i572_creator_uid())
        if not creator_uid:
            return {'ok': False, 'status': 428, 'error': 'The authenticated per-user TAK identity is unavailable.'}
        result = _i572_subscribe_with_password(mission, creator_uid, stored.get('password'), server_host)
        if result.get('ok'):
            _i591_mark_validated(mission, sess, result.get('token'), result.get('source') or 'stored-password-revalidation-i591')
        return result

    def _i591_access_rows(state, sess=None):
        index = _i591_index_snapshot(state, sess)
        rows = []
        for item in index.values():
            mission = _i591_text(item.get('mission'))
            protected = bool(item.get('protected'))
            stored = bool(_i572_load_password(mission, sess).get('ok')) if protected else False
            validated = bool(stored and _i591_is_validated(mission, sess)) if protected else True
            rows.append({
                'ok': True,
                'version': _I591_VERSION,
                'mission': mission,
                'protected': protected,
                'password_protected': protected,
                'unlocked': bool((not protected) or validated),
                'locked': bool(protected and not validated),
                'credential_configured': stored,
                'password_stored_server_side': stored,
                'password_validated_for_current_session': validated,
                'validation_pending': bool(protected and stored and not validated),
                'management_mode': 'explicit-mission-password-security-boundary-i591',
            })
        rows.sort(key=lambda row: row.get('mission','').casefold())
        return rows

    def _i591_locked_rows(state, sess=None):
        return [row for row in _i591_access_rows(state, sess) if row.get('locked')]

    def _i591_locked_uid_set(state, locked_names):
        locked = {str(x).casefold() for x in locked_names if _i591_text(x)}
        out = set()
        snapshot = state.get('snapshot') if isinstance(state, dict) and isinstance(state.get('snapshot'), dict) else {}
        for key in ('objects','mission_uids','mission_content','packages'):
            for row in snapshot.get(key) or []:
                if not isinstance(row, dict):
                    continue
                mission = _i591_mission_name(row).casefold()
                if mission and mission in locked:
                    uid = _i591_uid(row)
                    if uid:
                        out.add(uid.casefold())
        return out

    def _i591_mark_locked_state(state, locked_rows, sess=None):
        names = [_i591_text(row.get('mission')) for row in locked_rows if _i591_text(row.get('mission'))]
        uids = _i591_locked_uid_set(state, names)
        with _I568_STATE_LOCK:
            state['security_locked_i591'] = True
            state['security_locked_missions_i591'] = names
            state['security_locked_uids_i591'] = sorted(uids)
            state['in_flight'] = False
            state['generation'] = int(state.get('generation') or 0) + 1
            state['last_reason'] = 'mission-password-required-i591'
        return names, uids

    def _i591_clear_locked_state(state):
        with _I568_STATE_LOCK:
            state['security_locked_i591'] = False
            state['security_locked_missions_i591'] = []
            state['security_locked_uids_i591'] = []

    def _i591_locked_payload(state, sess=None, locked_rows=None):
        locked_rows = list(locked_rows or _i591_locked_rows(state, sess))
        names, _uids = _i591_mark_locked_state(state, locked_rows, sess)
        return {
            'ok': False,
            'version': _I591_VERSION,
            'locked': True,
            'requires_mission_password': True,
            'mission_password_required': True,
            'objects': [],
            'missions': [],
            'mission_content': [],
            'mission_uids': [],
            'mission_logs': [],
            'mission_roles': [],
            'packages': [],
            'sources': [],
            'message': 'Mission locked. Enter the Mission password before TAK Map downloads or displays Mission data.',
            'error': 'Mission password required.',
            'mission_access_i591': locked_rows,
            'mission_access_i576': locked_rows,
            'data_sync_security_i591': {
                'version': _I591_VERSION,
                'backend_gate': True,
                'locked': True,
                'locked_mission_count': len(names),
                'mission_api_requests_started': False,
                'postgresql_queries_started': False,
                'cached_snapshot_returned': False,
                'browser_cache_eligible': False,
                'per_user_per_mission': True,
            },
        }

    def _i591_filter_security_view(payload, state, sess=None):
        if not isinstance(payload, dict):
            return payload, 200
        locked_rows = _i591_locked_rows(state, sess)
        if not locked_rows:
            _i591_clear_locked_state(state)
            out = _i568_clone(payload)
            out['version'] = _I591_VERSION
            out['mission_access_i591'] = _i591_access_rows(state, sess)
            out['data_sync_security_i591'] = {'version': _I591_VERSION, 'backend_gate': True, 'locked': False, 'per_user_per_mission': True}
            return out, 200
        locked_names = {_i591_text(row.get('mission')).casefold() for row in locked_rows}
        names, locked_uids = _i591_mark_locked_state(state, locked_rows, sess)
        out = _i568_clone(payload)
        mission_keys = ('missions','mission_content','mission_uids','mission_logs','mission_roles','packages','objects')
        for key in mission_keys:
            rows = out.get(key)
            if not isinstance(rows, list):
                out[key] = [] if key in ('missions','objects','mission_content','mission_uids','packages') else rows
                continue
            kept = []
            for row in rows:
                mission = _i591_mission_name(row).casefold()
                uid = _i591_uid(row).casefold()
                if (mission and mission in locked_names) or (uid and uid in locked_uids):
                    continue
                kept.append(row)
            out[key] = kept
        out['mission_access_i591'] = _i591_access_rows(state, sess)
        out['mission_access_i576'] = out['mission_access_i591']
        out['partial'] = True
        out['locked'] = True
        out['requires_mission_password'] = True
        out['version'] = _I591_VERSION
        out['data_sync_security_i591'] = {
            'version': _I591_VERSION,
            'backend_gate': True,
            'locked': True,
            'locked_mission_count': len(names),
            'cached_locked_rows_removed': True,
            'per_user_per_mission': True,
        }
        visible = bool(out.get('missions') or out.get('objects') or out.get('mission_content') or out.get('packages'))
        if not visible:
            return _i591_locked_payload(state, sess, locked_rows), 423
        warnings = list(out.get('warnings') or []) if isinstance(out.get('warnings'), list) else []
        warning = 'One or more protected Missions remain locked. Their data was not downloaded or displayed.'
        if warning not in warnings:
            warnings.append(warning)
        out['warnings'] = warnings
        out['ok'] = True
        return out, 200

    _i591_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i591_response_before(state)
        if not isinstance(payload, dict):
            return payload
        out = _i568_clone(payload)
        out['version'] = _I591_VERSION
        out['data_sync_security_i591'] = {
            'version': _I591_VERSION,
            'backend_gate': True,
            'password_required_before_download': True,
            'local_postgresql_preserved_after_unlock': True,
            'remote_mission_api_preserved_after_unlock': True,
            'hybrid_topology_preserved_after_unlock': True,
        }
        return out
    globals()['_i568_response_payload'] = _i568_response_payload

    # A cached Mission token alone is not authorization. The user must have a
    # securely stored Mission password for every protected Mission.
    _i591_unlocked_before = _i572_unlocked
    def _i572_unlocked(mission, sess=None):
        mission = _i591_text(mission)
        try:
            state = _i572_protected_status(mission, sess)
            protected = bool(state.get('protected'))
        except Exception:
            protected = bool((_i591_load_index(sess).get(mission.casefold()) or {}).get('protected'))
        if protected:
            return bool(_i572_load_password(mission, sess).get('ok') and _i591_is_validated(mission, sess))
        return bool(_i591_unlocked_before(mission, sess))
    globals()['_i572_unlocked'] = _i572_unlocked

    _i591_token_before = _i564_mission_token
    def _i564_mission_token(mission, creator_uid, server_host='', force=False):
        mission = _i591_text(mission)
        index = _i591_load_index(None)
        try:
            protected = bool(_i572_protected_status(mission).get('protected'))
        except Exception:
            protected = False
        protected = bool(protected or (index.get(mission.casefold()) or {}).get('protected'))
        if protected:
            stored = _i572_load_password(mission)
            if not stored.get('ok'):
                _i591_invalidate_validation(mission)
                try:
                    _i564_invalidate_mission_token(mission, creator_uid)
                except Exception:
                    pass
                return {'ok': False, 'status': 423, 'mission_password_required': True,
                        'error': 'Mission password required before any protected Mission request.'}
            validation = _i591_validate_stored_password(mission, _i572_session(), server_host)
            if not validation.get('ok'):
                return validation
            return {'ok': True, 'status': int(validation.get('status') or 200),
                    'token': _i591_text(validation.get('token')) or _i572_cached_token(mission, creator_uid),
                    'source': _i591_text(validation.get('source')) or 'stored-password-revalidation-i591'}
        return _i591_token_before(mission, creator_uid, server_host, force)
    globals()['_i564_mission_token'] = _i564_mission_token

    # Never query the co-located PostgreSQL source while any protected Mission
    # remains locked. The existing PostgreSQL behavior is unchanged after unlock.
    if '_candidate_ots_pg_uris' in globals():
        _i591_pg_before = _candidate_ots_pg_uris
        def _candidate_ots_pg_uris():
            if bool(getattr(_I591_CONTEXT, 'locked_missions', None)):
                return [], ['PostgreSQL source intentionally skipped while a protected Mission is locked.']
            return _i591_pg_before()
        globals()['_candidate_ots_pg_uris'] = _candidate_ots_pg_uris

    # Safe acquisition never calls ?passwordProtected=true. Unprotected Missions
    # come from the bare list. A known protected Mission is fetched only after
    # its stored password is successfully validated through subscription.
    _i591_acquisition_before = _i568_parallel_acquisition
    def _i568_parallel_acquisition(cfg, sess):
        started = time.monotonic()
        marti = _i591_text((cfg or {}).get('marti_url')).rstrip('/')
        api = _i591_text((cfg or {}).get('api_url') or (cfg or {}).get('base_url')).rstrip('/')
        token = _i591_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', '')) if '_I529_REQUEST_CONTEXT' in globals() else ''
        if not marti:
            return _i591_acquisition_before(cfg, sess)
        deadline = time.monotonic() + _I568_OVERALL_REFRESH_DEADLINE_SECONDS
        bare_path = '/Marti/api/missions'
        bare_url = marti + bare_path
        responses, timings = _i569_run_parallel(
            [(bare_url, bare_path, 'discovery:marti-per-user-unprotected-only-i591', _I568_DISCOVERY_TIMEOUT_SECONDS)],
            cfg, sess, token, deadline, 1)
        bare = responses.get(bare_url) or {}
        bare_payload = _i568_result_body(bare)
        mission_rows = _i569_mission_rows(bare_payload) if bare.get('ok') else []
        authorized = []
        seen = set()
        for row in mission_rows:
            name = _i591_mission_name(row)
            if not name or name.casefold() in seen:
                continue
            seen.add(name.casefold())
            row = _i568_clone(row)
            row['passwordProtected'] = False
            authorized.append(row)
            _i591_remember_mission(name, False, sess)

        index = _i591_load_index(sess)
        creator_uid = _i572_creator_uid()
        protected_authorized = 0
        protected_locked = 0
        auth_failures = 0
        for item in list(index.values()):
            if not bool(item.get('protected')):
                continue
            mission = _i591_text(item.get('mission'))
            stored = _i572_load_password(mission, sess)
            if not stored.get('ok'):
                protected_locked += 1
                continue
            if not creator_uid:
                auth_failures += 1
                continue
            subscription = _i572_subscribe_with_password(mission, creator_uid, stored.get('password'))
            if not subscription.get('ok'):
                auth_failures += 1
                _i591_invalidate_validation(mission, sess)
                if subscription.get('invalid_password'):
                    _i572_remove_password(mission, sess)
                    try:
                        _i564_invalidate_mission_token(mission, creator_uid)
                    except Exception:
                        pass
                continue
            _i591_mark_validated(mission, sess, subscription.get('token'), 'safe-acquisition-subscription-i591')
            q = quote(mission, safe='')
            path = '/Marti/api/missions/' + q
            detail = _ots_mission_api_request(path, method='GET', token=subscription.get('token'), timeout=8)
            detail_body = _i568_result_body(detail)
            rows = _i569_mission_rows(detail_body) if detail.get('ok') else []
            row = rows[0] if rows else None
            if not isinstance(row, dict):
                auth_failures += 1
                continue
            row = _i568_clone(row)
            row['name'] = mission
            row['passwordProtected'] = True
            if mission.casefold() not in seen:
                seen.add(mission.casefold())
                authorized.append(row)
            detail_url = marti + path
            responses[detail_url] = detail
            responses[detail_url + '/contents'] = _i569_result(_i569_contents_payload(row), source='i591-authorized-protected-contents-alias', network_request=False)
            cot = _ots_mission_api_request(path + '/cot', method='GET', token=subscription.get('token'), timeout=8)
            responses[detail_url + '/cot'] = cot
            protected_authorized += 1
            _i591_remember_mission(mission, True, sess)

        aggregate = {'version': 3, 'type': 'Mission', 'data': _i568_clone(authorized)}
        authoritative_url = marti + _I569_DISCOVERY_PATH
        responses[authoritative_url] = _i569_result(aggregate, source='i591-authorized-mission-aggregate', network_request=False)
        responses[bare_url] = _i569_result(aggregate, source='i591-safe-bare-discovery-plus-authorized-protected', network_request=bool(bare.get('ok')))
        if api:
            responses[api + '/api/missions'] = _i569_result(aggregate, source='i591-safe-api-alias', network_request=False)
        for row in authorized:
            mission = _i591_mission_name(row)
            q = quote(mission, safe='')
            detail_url = marti + '/Marti/api/missions/' + q
            responses.setdefault(detail_url, _i569_result(_i569_mission_payload(row), source='i591-safe-discovery-row-alias', network_request=False))
            responses.setdefault(detail_url + '/contents', _i569_result(_i569_contents_payload(row), source='i591-safe-discovery-contents-alias', network_request=False))
        return {
            'responses': responses,
            'mission_names': [_i591_mission_name(row) for row in authorized if _i591_mission_name(row)],
            'mission_rows': authorized,
            'timings': timings,
            'summary': {
                'version': _I591_VERSION,
                'phase': 'authorized-discovery',
                'discovery_ok': bool(bare.get('ok') or protected_authorized),
                'authoritative_discovery': 'bare-unprotected-plus-password-authorized-protected',
                'password_protected_bulk_discovery_called': False,
                'mission_count': len(authorized),
                'authorized_protected_mission_count': protected_authorized,
                'locked_protected_mission_count': protected_locked,
                'authentication_failure_count': auth_failures,
                'network_get_contents_calls': 0,
                'per_user_certificate': True,
                'mission_password_gate_before_data': True,
                'duration_seconds': round(time.monotonic() - started, 4),
            },
        }
    globals()['_i568_parallel_acquisition'] = _i568_parallel_acquisition

    _i591_build_before = _i568_build_snapshot
    def _i568_build_snapshot(cfg, sess, token, reason):
        key = _i568_state_key(cfg or {}, sess or {})
        state = _i568_state(key)
        locked = _i591_locked_rows(state, sess)
        _I591_CONTEXT.locked_missions = [_i591_text(row.get('mission')) for row in locked]
        try:
            # When every known protected Mission is locked and no unprotected
            # Mission exists in the retained snapshot, do not touch any source.
            snapshot = state.get('snapshot') if isinstance(state.get('snapshot'), dict) else {}
            visible_missions = [row for row in snapshot.get('missions') or [] if _i591_mission_name(row).casefold() not in {x.casefold() for x in _I591_CONTEXT.locked_missions}]
            if locked and not visible_missions:
                raise PermissionError('Mission password required before Data Sync acquisition.')
            result, acquired = _i591_build_before(cfg, sess, token, reason)
            result, _status = _i591_filter_security_view(result, state, sess)
            return result, acquired
        finally:
            _I591_CONTEXT.locked_missions = []
    globals()['_i568_build_snapshot'] = _i568_build_snapshot

    _i591_schedule_before = _i568_schedule_refresh
    def _i568_schedule_refresh(key, cfg, sess, token, reason, force=False):
        state = _i568_state(key)
        locked = _i591_locked_rows(state, sess)
        snapshot = state.get('snapshot') if isinstance(state.get('snapshot'), dict) else {}
        locked_names = {_i591_text(row.get('mission')).casefold() for row in locked}
        visible = [row for row in snapshot.get('missions') or [] if _i591_mission_name(row).casefold() not in locked_names]
        if locked and not visible:
            _i591_mark_locked_state(state, locked, sess)
            return False, 'mission-password-required-i591'
        return _i591_schedule_before(key, cfg, sess, token, reason, force)
    globals()['_i568_schedule_refresh'] = _i568_schedule_refresh

    _i591_access_before = _i573_access_action
    def _i573_access_action(payload):
        payload = dict(payload or {}) if isinstance(payload, dict) else {}
        mission = _i591_text(payload.get('mission') or payload.get('mission_name'))
        if mission:
            _i591_remember_mission(mission, True, _i572_session())
        reply, status = _i591_access_before(payload)
        try:
            cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
            sess = _i572_session()
            state = _i568_state(_i568_state_key(cfg or {}, sess or {}))
            if bool((reply or {}).get('ok')) and bool((reply or {}).get('unlocked')):
                _i591_mark_validated(mission, sess, _i572_cached_token(mission, _i572_creator_uid()), 'explicit-password-dialog-i591')
                _i591_clear_locked_state(state)
            elif bool((reply or {}).get('ok')):
                _i591_invalidate_validation(mission, sess)
                _i591_mark_locked_state(state, _i591_locked_rows(state, sess), sess)
            else:
                _i591_invalidate_validation(mission, sess)
        except Exception:
            pass
        if isinstance(reply, dict):
            reply = dict(reply)
            reply['version'] = _I591_VERSION
            reply['data_sync_security_i591'] = {'backend_gate': True, 'password_required_before_download': True}
        return reply, status
    globals()['_i573_access_action'] = _i573_access_action

    def _i591_filter_live_payload(payload, state):
        if not isinstance(payload, dict):
            return payload
        locked_names = {_i591_text(x).casefold() for x in state.get('security_locked_missions_i591') or []}
        locked_uids = {_i591_text(x).casefold() for x in state.get('security_locked_uids_i591') or []}
        if not locked_names and not locked_uids:
            return payload
        out = dict(payload)
        for key in ('markers','euds','objects','items','features'):
            rows = out.get(key)
            if not isinstance(rows, list):
                continue
            kept = []
            for row in rows:
                mission = _i591_mission_name(row).casefold()
                uid = _i591_uid(row).casefold()
                mission_derived = bool(isinstance(row, dict) and (row.get('is_mission_object') or row.get('mission_uid') or row.get('mission_name') or row.get('missionName')))
                if (mission and mission in locked_names) or (uid and uid in locked_uids):
                    continue
                if mission_derived and locked_names and not mission:
                    continue
                kept.append(row)
            out[key] = kept
        out['data_sync_security_i591'] = {'version': _I591_VERSION, 'locked_mission_live_objects_suppressed': True}
        return out

    _i591_cot_before = tak_map_cot_markers
    def tak_map_cot_markers(*args, **kwargs):
        payload = _i591_cot_before(*args, **kwargs)
        try:
            sess = _i572_session()
            cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
            state = _i568_state(_i568_state_key(cfg or {}, sess or {}))
            return _i591_filter_live_payload(payload, state)
        except Exception:
            return payload
    globals()['tak_map_cot_markers'] = tak_map_cot_markers

    _i591_euds_before = tak_map_euds
    def tak_map_euds(*args, **kwargs):
        payload = _i591_euds_before(*args, **kwargs)
        try:
            sess = _i572_session()
            cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
            state = _i568_state(_i568_state_key(cfg or {}, sess or {}))
            return _i591_filter_live_payload(payload, state)
        except Exception:
            return payload
    globals()['tak_map_euds'] = tak_map_euds

    _i591_get_before = Handler.do_GET
    def _i591_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/data-sync':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            sess = self._tak_map_session()
            auth_mode = _i591_text((sess or {}).get('auth_mode'))
            if not auth_mode.startswith('ots-'):
                return _i591_get_before(self)
            _i555_set_request_context(self)
            try:
                cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
                token = self._tak_map_token() if callable(getattr(self, '_tak_map_token', None)) else ''
                key = _i568_state_key(cfg or {}, sess or {})
                state = _i568_state(key)
                # A stored password is not itself authorization. Before any cached
                # snapshot can be returned, validate it through the password-only
                # Mission subscription endpoint for the current user/session.
                for item in list(_i591_index_snapshot(state, sess).values()):
                    mission = _i591_text(item.get('mission'))
                    if not mission or not bool(item.get('protected')):
                        continue
                    if _i572_load_password(mission, sess).get('ok') and not _i591_is_validated(mission, sess):
                        _i591_validate_stored_password(mission, sess)
                locked = _i591_locked_rows(state, sess)
                query = parse_qs(parsed.query or '')
                force = _i591_text((query.get('force') or ['0'])[0]).casefold() in ('1','true','yes','on')
                reason = _i591_text((query.get('reason') or [''])[0]) or ('manual' if force else 'poll')
                with _I568_STATE_LOCK:
                    last_success = float(state.get('last_success_epoch') or 0)
                    stale = not last_success or (time.time() - last_success >= _I568_SNAPSHOT_MAX_AGE_SECONDS)
                snapshot = state.get('snapshot') if isinstance(state.get('snapshot'), dict) else {}
                locked_names = {_i591_text(row.get('mission')).casefold() for row in locked}
                visible = [row for row in snapshot.get('missions') or [] if _i591_mission_name(row).casefold() not in locked_names]
                if not (locked and not visible) and (force or stale):
                    _i568_schedule_refresh(key, cfg or {}, sess or {}, token, reason, force=force)
                payload = _i568_response_payload(state)
                payload, status = _i591_filter_security_view(payload, state, sess)
                return self._send_json(payload, status)
            finally:
                _i555_clear_request_context()
        return _i591_get_before(self)
    Handler.do_GET = _i591_do_get

    _i591_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i591_config_before() or {})
        cfg['version'] = _I591_PACKAGE_VERSION
        cfg['tak_map_iteration'] = _I591_VERSION
        cfg['mission_password_security_i591'] = {
            'version': _I591_VERSION,
            'backend_gate_before_mission_api': True,
            'backend_gate_before_postgresql': True,
            'cached_locked_snapshot_not_returned': True,
            'http_locked_status': 423,
            'per_authenticated_user': True,
            'per_mission': True,
            'mission_token_alone_is_not_authorization': True,
            'stored_password_validated_before_cached_snapshot': True,
            'expired_session_revalidated_before_data': True,
            'validation_ttl_seconds': _I591_VALIDATION_MAX_AGE_SECONDS,
            'safe_discovery_excludes_password_protected_bulk_endpoint': True,
            'local_postgresql_preserved_after_unlock': True,
            'remote_mission_api_preserved_after_unlock': True,
            'hybrid_topology_preserved_after_unlock': True,
            'locked_live_mission_objects_suppressed': True,
        }
        startup = dict(cfg.get('startup_architecture_i590') or {})
        startup.update({'package_version': _I591_VERSION, 'startup_loader_cache_identity': _I591_PACKAGE_VERSION,
                        'manifest_cache_identity': _I591_PACKAGE_VERSION, 'data_sync_control_cache_identity': _I591_PACKAGE_VERSION})
        cfg['startup_architecture_i591'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i591_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+(?:-[A-Za-z0-9_-]+)?', _I591_PACKAGE_VERSION, html)
        html = re.sub(r'TAKDashboard/i\d+(?:-[A-Za-z0-9_-]+)?', 'TAKDashboard/i591', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i591', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i591\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i591\2', html)
        return html

    TAK_MAP_HTML = _i591_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i591_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I591_VERSION
except Exception as _i591_exc:
    try:
        print('TAK Map i591 Mission-password security patch failed:', _i591_exc)
    except Exception:
        pass
# --- end TAK Map i591 Mission-password security boundary ---


