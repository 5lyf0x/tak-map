    _I629_REPLAY_SCRIPT = _i629_final_replay_script()

    def _i629_final_identity_guard():
        guard = str(globals().get('_I628_IDENTITY_GUARD') or globals().get('_I627_IDENTITY_GUARD') or '')
        if not guard:
            return ''
        guard = re.sub(r'id="takMapIdentityGuardI\d+"', 'id="takMapIdentityGuardI629"', guard, count=1)
        guard = re.sub(
            r"ITERATION='i\d+',PACKAGE='1\.4\.0-i\d+'",
            "ITERATION='i629',PACKAGE='1.4.0-i629'",
            guard,
            count=1,
        )
        return guard

    _I629_IDENTITY_GUARD = _i629_final_identity_guard()

    def _i629_final_patch_main_html(html):
        html = str(html or '')
        html = re.sub(r'1\.4\.0-i(?:62[0-8])', _I629_PACKAGE_VERSION, html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i629\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i629\2', html)
        html = re.sub(r'<script[^>]*id=["\']v415ReplayModeIntegrationPatch["\'][\s\S]*?</script>\s*', '', html, flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapIdentityGuardI\d+["\'][\s\S]*?</script>\s*', '', html, flags=re.I)
        if _I629_IDENTITY_GUARD:
            html = html.replace('</head>', _I629_IDENTITY_GUARD + '</head>', 1) if '</head>' in html else _I629_IDENTITY_GUARD + html
        html = html.replace('</body>', _I629_REPLAY_SCRIPT + '\n</body>', 1) if '</body>' in html else html + _I629_REPLAY_SCRIPT
        return html

    def _i629_final_patch_login_html(html):
