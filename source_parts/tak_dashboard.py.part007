            break
        return {'ok':False,'mission':mission,'event_uid':uid,'method':'PUT','path':path,'association_endpoint':'mission-contents-uids','error':'Mission Shape UID association through PUT /contents failed.','attempts':attempts}

    def _i643_confirm_shape_mission(mission, creator_uid, uid, geom, token='', deadline_seconds=15.0):
        mission_q=quote(_i643_text(mission),safe=''); primary=f'/Marti/api/missions/{mission_q}/cot'
        creator_path=primary+'?creatorUid='+quote(_i643_text(creator_uid),safe='') if creator_uid else ''
        token_candidates=[]
        if _i643_text(token): token_candidates.append((_i643_text(token),'cached-mission-token'))
        token_candidates.append(('', 'per-user-certificate-tokenless'))
