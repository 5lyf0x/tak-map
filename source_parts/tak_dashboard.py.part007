                'same_uid_update':True,'native_shape_type':_i643_text(contract.get('cot_type')),'native_shape_contract':True,
                'shape_uid_used_as_eud_identity':False,'transport':'per-user-certificate-authenticated-ssl-cot',
                'mission_cot_write_endpoint_used':False,'mission_cot_get_readback_only':True,
                'global_cot_geometry_commit_gate':True,'mission_contents_uid_association':True,
                'mission_contents_method':'PUT','mission_contents_body':'uids-json',
                'generic_public_cot_uid_lookup_commit_gate':False,'aggregate_data_sync_commit_gate':False,
                'ring_compare_cyclic_start_independent':True,'ring_compare_winding_independent':True,
                'authoritative_global_readback_confirmed':True,'authoritative_mission_readback_confirmed':True,
                'send':sent,'global_confirmation':{k:v for k,v in global_confirm.items() if k!='row'},'confirmations':confirmations,
                'commit_gate':'native-shape-global-ingest-then-mission-contents-and-cot-get-readback',
            }
            out['shape_edit_i643']=tx
