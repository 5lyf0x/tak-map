# --- TAK Map i630 FINAL OpenTAKServer 1.7.13 zero-touch enrollment and resilient login ---
try:
    _I630_VERSION = 'i630'
    _I630_PACKAGE_VERSION = '1.4.0-i630'
    _I630_PUBLIC_VERSION = '1.4.0'
    _I630_OTS_COMPATIBILITY_TARGET = '1.7.13'
    _I630_DEFAULT_OTS_SERVER = str(os.environ.get('TAK_MAP_OTS_DEFAULT_SERVER') or os.environ.get('TAK_MAP_DEFAULT_OTS_ADDRESS') or 'https://10.10.10.2').strip()
    _I630_SOCKET_GETADDRINFO_ORIGINAL = socket.getaddrinfo
    _I630_OTS_HOST_ALIASES = {}
    _I630_OTS_ALIAS_LOCK = threading.RLock()

    def _i630_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i630_host(value):
        return _i630_text(value).strip('[]').lower().rstrip('.')

    def _i630_ip(value):
        try:
            return ipaddress.ip_address(_i630_text(value).strip('[]')).compressed
        except Exception:
            return ''

    def _i630_set_transport_pin(tls_host='', transport_host=''):
        tls_host = _i630_host(tls_host)
        transport_ip = _i630_ip(transport_host)
        with _I630_OTS_ALIAS_LOCK:
            _I630_OTS_HOST_ALIASES.clear()
            if tls_host and transport_ip and not _i630_ip(tls_host):
                _I630_OTS_HOST_ALIASES[tls_host] = transport_ip
        return bool(tls_host and transport_ip and not _i630_ip(tls_host))

    def _i630_getaddrinfo(host, port, family=0, type=0, proto=0, flags=0):
        lookup = _i630_host(host)
        with _I630_OTS_ALIAS_LOCK:
            pinned = _I630_OTS_HOST_ALIASES.get(lookup, '')
        return _I630_SOCKET_GETADDRINFO_ORIGINAL(pinned or host, port, family, type, proto, flags)

    # Narrow resolver hook: only the exact OTS certificate hostname selected by
    # Configure OTS is redirected. All other DNS resolution remains untouched.
    socket.getaddrinfo = _i630_getaddrinfo

    _i630_default_ots_before = _i509_default_ots_config
    def _i509_default_ots_config():
        cfg = dict(_i630_default_ots_before())
        cfg.update({
            'version': _I630_VERSION,
            'transport_host': '',
            'tls_server_name': '',
            'transport_pin_enabled': False,
            'ots_compatibility_target': _I630_OTS_COMPATIBILITY_TARGET,
            'managed_dns': {},
            'last_ots_preflight': {},
        })
        return cfg
    globals()['_i509_default_ots_config'] = _i509_default_ots_config

    _i630_normalize_ots_before = _i509_normalize_ots_config
    def _i509_normalize_ots_config(payload=None, current=None):
        cfg = dict(_i630_normalize_ots_before(payload, current))
        source = payload if isinstance(payload, dict) else {}
        prior = current if isinstance(current, dict) else {}
        cfg['version'] = _I630_VERSION
        cfg['transport_host'] = _i630_host(source.get('transport_host', prior.get('transport_host', cfg.get('transport_host'))))
        cfg['tls_server_name'] = _i630_host(source.get('tls_server_name', prior.get('tls_server_name', cfg.get('tls_server_name'))))
        pin_value = source.get('transport_pin_enabled', prior.get('transport_pin_enabled', cfg.get('transport_pin_enabled', False)))
        cfg['transport_pin_enabled'] = _i589_bool(pin_value, False)
        cfg['ots_compatibility_target'] = _I630_OTS_COMPATIBILITY_TARGET
        managed_dns = source.get('managed_dns', prior.get('managed_dns', cfg.get('managed_dns', {})))
        cfg['managed_dns'] = dict(managed_dns) if isinstance(managed_dns, dict) else {}
        preflight = source.get('last_ots_preflight', prior.get('last_ots_preflight', cfg.get('last_ots_preflight', {})))
        cfg['last_ots_preflight'] = dict(preflight) if isinstance(preflight, dict) else {}
        if cfg['transport_pin_enabled'] and cfg['tls_server_name'] and cfg['transport_host']:
            _i630_set_transport_pin(cfg['tls_server_name'], cfg['transport_host'])
        return cfg
    globals()['_i509_normalize_ots_config'] = _i509_normalize_ots_config

    _i630_load_ots_before = _i509_load_ots_config
    def _i509_load_ots_config():
        cfg = dict(_i630_load_ots_before())
        if cfg.get('transport_pin_enabled'):
            _i630_set_transport_pin(cfg.get('tls_server_name'), cfg.get('transport_host'))
        return cfg
    globals()['_i509_load_ots_config'] = _i509_load_ots_config

    _i630_public_ots_before = _i509_public_ots_config
    def _i509_public_ots_config(cfg=None):
        source = dict(cfg or _i509_load_ots_config())
        out = dict(_i630_public_ots_before(source))
        out['version'] = _I630_VERSION
        out['ots_compatibility_target'] = _I630_OTS_COMPATIBILITY_TARGET
        out['recommended_server_address'] = _I630_DEFAULT_OTS_SERVER
        out['transport_pin_enabled'] = bool(source.get('transport_pin_enabled'))
        out['transport_host'] = _i630_text(source.get('transport_host')) if source.get('transport_pin_enabled') else ''
        out['tls_server_name'] = _i630_text(source.get('tls_server_name')) if source.get('transport_pin_enabled') else ''
        managed_dns = source.get('managed_dns') if isinstance(source.get('managed_dns'), dict) else {}
        out['managed_dns'] = {k: managed_dns.get(k) for k in ('ok','ip','hostname','mapped','mapping_required','web_port','certificate_port')}
        preflight = source.get('last_ots_preflight') if isinstance(source.get('last_ots_preflight'), dict) else {}
        out['last_ots_preflight'] = dict(preflight)
        return out
    globals()['_i509_public_ots_config'] = _i509_public_ots_config

    def _i630_rehost_url(url, host):
        parsed = urlparse(_i630_text(url))
        if not parsed.scheme or not host:
            return _i630_text(url)
        netloc = _i589_url_host(host)
        if parsed.port:
            netloc += ':' + str(parsed.port)
        return parsed._replace(netloc=netloc).geturl().rstrip('/')

    def _i630_certificate_name_score(name, entered_ip):
        name = _i630_host(name)
        if not name or name.startswith('*.'):
            return -1
        # Prefer the certificate identity even when LAN DNS is absent. i630's
        # privileged managed-host bootstrap supplies that resolution; the narrow
        # in-process transport pin remains only as a recovery fallback.
        score = 10
        if 'opentakserver' in name:
            score += 100
        elif 'takserver' in name:
            score += 90
        elif 'tak' in name:
            score += 60
        if name in ('localhost', 'localhost.localdomain'):
            score -= 80
        return score

    _i630_adopt_host_before = _i589_adopt_canonical_certificate_host
    def _i589_adopt_canonical_certificate_host(cfg):
        out = dict(_i630_adopt_host_before(cfg))
        metadata = dict(out.get('canonical_discovery') or {})
        entered_host = _i630_host(metadata.get('entered_host') or out.get('entered_host'))
        entered_ip = _i630_ip(entered_host)
        cert = dict(metadata.get('certificate') or {})
        cert_ips = {_i630_ip(v) for v in (cert.get('ip_addresses') or []) if _i630_ip(v)}
        if entered_ip:
            if cert.get('ok') and entered_ip not in cert_ips:
                names = [_i630_host(v) for v in (cert.get('dns_names') or [])]
                names = [v for v in names if v and not v.startswith('*.')]
                if names:
                    canonical = sorted(names, key=lambda n: (-_i630_certificate_name_score(n, entered_ip), n))[0]
                    overrides = dict(out.get('advanced_overrides') or {})
                    base_entered = _i630_text(metadata.get('entered_base_url') or out.get('entered_base_url') or out.get('base_url'))
                    if canonical:
                        if not overrides.get('api_url'):
                            out['base_url'] = _i630_rehost_url(base_entered, canonical)
                            out['api_url'] = out['base_url']
                        else:
                            out['base_url'] = _i630_rehost_url(base_entered, canonical)
                        if not overrides.get('marti_url'):
                            out['marti_url'] = 'https://' + _i589_url_host(canonical) + ':8443'
                        if not overrides.get('enrollment_url'):
                            out['enrollment_url'] = 'https://' + _i589_url_host(canonical) + ':8446'
                        if not overrides.get('cot_host'):
                            out['cot_host'] = canonical
                        out['transport_host'] = entered_ip
                        out['tls_server_name'] = canonical
                        out['transport_pin_enabled'] = True
                        _i630_set_transport_pin(canonical, entered_ip)
                        metadata['canonical_host'] = canonical
                        metadata['canonical_addresses'] = [entered_ip]
                        metadata['adopted_certificate_hostname'] = True
                        metadata['transport_pin_enabled'] = True
                        metadata['transport_host'] = entered_ip
                        metadata['tls_server_name'] = canonical
                        metadata['resolver_requirement'] = 'internal-pin-no-hosts-file-change'
                else:
                    out['transport_host'] = ''
                    out['tls_server_name'] = ''
                    out['transport_pin_enabled'] = False
                    _i630_set_transport_pin('', '')
            else:
                # A certificate that already names the entered IP needs no alias.
                # Clear any pin inherited from a previously configured OTS host.
                out['transport_host'] = ''
                out['tls_server_name'] = ''
                out['transport_pin_enabled'] = False
                _i630_set_transport_pin('', '')
        elif out.get('transport_pin_enabled') and out.get('tls_server_name') and out.get('transport_host'):
            _i630_set_transport_pin(out.get('tls_server_name'), out.get('transport_host'))
        out['ots_compatibility_target'] = _I630_OTS_COMPATIBILITY_TARGET
        out['canonical_discovery'] = metadata
        return out
    globals()['_i589_adopt_canonical_certificate_host'] = _i589_adopt_canonical_certificate_host

    def _i630_bootstrap_managed_dns(ip):
        ip = _i630_ip(ip)
        result = {'ok': False, 'action': 'ots-host-bootstrap', 'ip': ip, 'mapped': False, 'mapping_required': False, 'hostname': '', 'web_port': 0, 'error': ''}
        if not ip:
            result['error'] = 'OTS hostname bootstrap requires a literal IP address.'
            return result
        helper = Path('/usr/local/sbin/tak-map-action')
        if not helper.is_file():
            result['error'] = 'TAK Map privileged OTS hostname helper is not installed.'
            return result
        try:
            proc = subprocess.run(['sudo','-n',str(helper),'ots-host-bootstrap',ip], capture_output=True, text=True, timeout=35)
            lines = [line.strip() for line in (proc.stdout or '').splitlines() if line.strip()]
            parsed = {}
            for line in reversed(lines):
                try:
                    parsed = json.loads(line)
                    if isinstance(parsed, dict): break
                except Exception:
                    continue
            if not isinstance(parsed, dict): parsed = {}
            result.update(parsed)
            result['returncode'] = int(proc.returncode)
            if proc.returncode != 0 and not result.get('error'):
                result['error'] = _i630_text(proc.stderr or proc.stdout or 'OTS hostname bootstrap failed.')
            result['ok'] = bool(parsed.get('ok') and proc.returncode == 0)
        except Exception as exc:
            result['error'] = str(exc)
        return result

    def _i630_origin_with_web_port(raw, web_port):
        raw = _i630_text(raw)
        if not raw or not web_port:
            return raw
        try:
            origin = _i509_origin(raw)
            parsed = urlparse(origin)
            if parsed.port or parsed.scheme != 'https':
                return raw
            host = parsed.hostname or ''
            if not host:
                return raw
            authority = _i589_url_host(host)
            if int(web_port) != 443:
                authority += ':' + str(int(web_port))
            return 'https://' + authority
        except Exception:
            return raw

    _i630_standard_config_before = _i589_standard_config
    def _i589_standard_config(payload=None):
        payload = dict(payload or {})
        raw = _i630_text(payload.get('server_address') or payload.get('base_url'))
        if not raw and not _i630_text((_i509_load_ots_config() or {}).get('base_url')):
            raw = _I630_DEFAULT_OTS_SERVER
            payload['server_address'] = raw
        bootstrap = {}
        if raw:
            try:
                entered_origin = _i509_origin(raw)
                entered_host = urlparse(entered_origin).hostname or ''
                if entered_host and _i589_is_ip_literal(entered_host):
                    bootstrap = _i630_bootstrap_managed_dns(entered_host)
                    discovered_port = int(bootstrap.get('web_port') or 0)
                    if discovered_port:
                        payload['server_address'] = _i630_origin_with_web_port(raw, discovered_port)
                elif entered_host:
                    _i630_set_transport_pin('', '')
            except Exception as exc:
                bootstrap = {'ok': False, 'error': str(exc)}
        cfg = dict(_i630_standard_config_before(payload))
        cfg['ots_compatibility_target'] = _I630_OTS_COMPATIBILITY_TARGET
        cfg['managed_dns'] = dict(bootstrap) if isinstance(bootstrap, dict) else {}
        # Keep the internal exact-host pin as a secondary resilience layer, but
        # i630's preferred path is the installer/wizard-managed /etc/hosts entry.
        cfg = _i589_adopt_canonical_certificate_host(cfg)
        return cfg
    globals()['_i589_standard_config'] = _i589_standard_config

    _i630_install_trust_before = _i589_install_trust
    def _i589_install_trust(cfg, payload=None, manifest=None):
        payload = dict(payload or {})
        result = _i630_install_trust_before(cfg, payload, manifest)
        # OTS documents atakatak as the default CA/truststore password. Try that
        # one public default automatically only when the user supplied no password.
        if (not result.get('ok') and not _i630_text(payload.get('truststore_password')) and
                _i630_text(os.environ.get('TAK_MAP_OTS_TRUSTSTORE_PASSWORD_FALLBACK')) and
                'truststore_password' in list(result.get('required_fields') or [])):
            retry_payload = dict(payload)
            retry_payload['truststore_password'] = _i630_text(os.environ.get('TAK_MAP_OTS_TRUSTSTORE_PASSWORD_FALLBACK'))
            retry = _i630_install_trust_before(cfg, retry_payload, manifest)
            if retry.get('ok'):
                retry['default_truststore_password_used'] = True
                retry['truststore_password_persisted'] = False
                return retry
        return result
    globals()['_i589_install_trust'] = _i589_install_trust

    def _i630_json_versions(value, path=''):
        found = []
        if isinstance(value, dict):
            for key, item in value.items():
                key_path = (path + '.' + str(key)).strip('.')
                if isinstance(item, (str, int, float)) and 'version' in str(key).lower():
                    text = str(item)
                    m = re.search(r'\b(\d+\.\d+\.\d+(?:[-+._][A-Za-z0-9.-]+)?)\b', text)
                    if m:
                        found.append({'path': key_path, 'version': m.group(1)})
                found.extend(_i630_json_versions(item, key_path))
        elif isinstance(value, list):
            for index, item in enumerate(value[:64]):
                found.extend(_i630_json_versions(item, path + '[' + str(index) + ']'))
        return found

    def _i630_detect_ots_version(cfg, auth):
        headers = _i511_auth_headers(cfg, auth)
        base = _i630_text(cfg.get('api_url') or cfg.get('base_url')).rstrip('/')
        probes = []
        detected = ''
        source = ''
        for path in ('/api/status', '/api/health'):
            probe = _i509_http_request(base + path, cfg, headers=headers, timeout=8)
            item = {'path': path, 'status': int(probe.get('status') or 0), 'state': _i509_endpoint_class(probe)}
            body = _i630_text(probe.get('body_preview'))
            if body:
                try:
                    obj = json.loads(body)
                except Exception:
                    obj = {}
                versions = _i630_json_versions(obj)
                item['versions'] = versions[:8]
                if versions and not detected:
                    detected = versions[0]['version']
                    source = path + ':' + versions[0]['path']
            probes.append(item)
        return {
            'target': _I630_OTS_COMPATIBILITY_TARGET,
            'detected': detected,
            'detected_source': source,
            'advertised_match': (detected == _I630_OTS_COMPATIBILITY_TARGET) if detected else None,
            'endpoint_compatible': True,
            'probes': probes,
        }

    def _i630_mtls_probe(cfg, username, client_uid):
        status = _i529_public_certificate_status(username, client_uid)
        safe_status = {k: v for k, v in status.items() if k not in ('key_password', 'private_key_path', 'certificate_path', 'ca_chain_path')}
        result = {'ok': False, 'status': 0, 'endpoint': '', 'certificate': safe_status, 'error': ''}
        if not status.get('ok'):
            result['error'] = _i630_text(status.get('error') or 'Per-user client certificate is not ready.')
            return result
        endpoint = _i630_text(cfg.get('marti_url')).rstrip('/') + '/Marti/api/version/config'
        result['endpoint'] = endpoint
        try:
            ctx = _i529_strict_tls_context(cfg)
            ctx.load_cert_chain(
                certfile=str(status.get('certificate_path')),
                keyfile=str(status.get('private_key_path')),
                password=str(status.get('key_password') or ''),
            )
            req = Request(endpoint, headers={'Accept': 'application/json', 'User-Agent': 'TAK-Map/i630 OTS-mTLS-Preflight'}, method='GET')
            try:
                with urlopen(req, timeout=12, context=ctx) as resp:
                    code = int(getattr(resp, 'status', 200) or 200)
                    body = resp.read(262144).decode('utf-8', 'replace')
            except HTTPError as exc:
                code = int(getattr(exc, 'code', 0) or 0)
                try:
                    body = exc.read(262144).decode('utf-8', 'replace')
                except Exception:
                    body = ''
            result['status'] = code
            result['body_preview'] = body[:500]
            missing = any(token in body.lower() for token in ('required ssl certificate', 'no required ssl certificate was sent', 'client certificate required'))
            result['ok'] = bool(code > 0 and not missing)
            if not result['ok']:
                result['error'] = 'Marti HTTPS did not accept the enrolled client certificate.'
        except Exception as exc:
            result['error'] = str(exc)
        return result

    def _i630_preflight_summary(cfg, strict, version_info, cert_result, mtls_result, profile):
        canonical = dict(cfg.get('canonical_discovery') or {})
        pin = bool(cfg.get('transport_pin_enabled'))
        managed_dns = dict(cfg.get('managed_dns') or {})
        return {
            'version': _I630_VERSION,
            'target_ots_version': _I630_OTS_COMPATIBILITY_TARGET,
            'detected_ots_version': _i630_text((version_info or {}).get('detected')),
            'web_api': bool((strict.get('checks') or {}).get('web')),
            'trust': bool((strict.get('checks') or {}).get('truststore')),
            'marti_https': bool((strict.get('checks') or {}).get('marti')),
            'enrollment_service': bool((strict.get('checks') or {}).get('enrollment')),
            'ssl_cot': bool((strict.get('checks') or {}).get('cot')),
            'administrator': bool((profile or {}).get('is_admin')),
            'per_user_certificate': bool((cert_result or {}).get('ok')),
            'client_certificate_mtls': bool((mtls_result or {}).get('ok')),
            'tls_hostname': _i630_text(cfg.get('tls_server_name') or canonical.get('canonical_host')),
            'transport_host': _i630_text(cfg.get('transport_host')) if pin else '',
            'internal_transport_pin': pin,
            'managed_dns': {k: managed_dns.get(k) for k in ('ok','ip','hostname','mapped','mapping_required','web_port','certificate_port')},
            'strict_tls': True,
            'passwords_persisted': False,
        }

    def _i630_enrollment_message(saved, preflight, trust=None):
        detected = _i630_text(preflight.get('detected_ots_version')) or 'not advertised'
        lines = [
            'OpenTAKServer configuration verified and enabled.',
            'Compatibility target: OTS ' + _I630_OTS_COMPATIBILITY_TARGET + ' (server reported: ' + detected + ')',
            'Web/API + strict TLS: verified',
            'Truststore/CA: verified' + (' (OTS default truststore password handled automatically)' if (trust or {}).get('default_truststore_password_used') else ''),
            'Administrator authentication + /api/me: verified',
            'Certificate enrollment on :8446: verified' if preflight.get('per_user_certificate') else 'Certificate enrollment: disabled by configuration',
            'Client-certificate Marti HTTPS: verified' if preflight.get('client_certificate_mtls') else 'Client-certificate Marti HTTPS: not requested',
            'SSL CoT :8089: verified',
        ]
        dns = dict(preflight.get('managed_dns') or {})
        if dns.get('mapped'):
            lines.append('Managed DNS: /etc/hosts maps ' + _i630_text(dns.get('hostname')) + ' to ' + _i630_text(dns.get('ip')) + ' for certificate-correct OTS access.')
        elif dns.get('ok') and not dns.get('mapping_required'):
            lines.append('Managed DNS: no hostname entry was needed because the OTS certificate is valid for the entered IP.')
        elif preflight.get('internal_transport_pin'):
            lines.append('Managed DNS could not be confirmed; TAK Map retained a narrow internal TLS-host fallback for this OTS connection.')
        lines.append('OTS passwords, 2FA codes, and truststore passwords were not persisted.')
        return '\n'.join(lines)

    def _i589_enroll_server(payload):
        payload = _i589_decode_opaque_transport(payload)
        cfg = _i589_standard_config(payload)
        username = sanitize_ots_username(payload.get('username') or '')
        password = str(payload.get('password') or '')
        otp = _i630_text(payload.get('otp'))
        if not username:
            return _i589_progressive_failure('Enter the OpenTAKServer administrator username.', ['username'], cfg)
        if not password:
            return _i589_progressive_failure('Enter the OpenTAKServer administrator password.', ['password'], cfg)

        initial = _i589_standard_endpoint_checks(cfg, strict=False)
        if initial['required_fields']:
            return _i589_progressive_failure(
                'TAK Map could not identify one or more OpenTAKServer services using OTS 1.7.13 defaults. Enter only the highlighted override values.',
                initial['required_fields'], cfg, initial)

        manifest = _i589_manifest_load()
        manifest['origin'] = cfg['base_url'].rstrip('/')
        manifest['created_at'] = manifest.get('created_at') or _i589_iso_now()
        manifest['status'] = 'enrolling'
        trust = {'ok': True, 'automatic': False}
        if cfg.get('automatic_trust_installation'):
            trust = _i589_install_trust(cfg, payload, manifest)
            if not trust.get('ok'):
                return _i589_progressive_failure(trust.get('error'), trust.get('required_fields'), cfg, initial, {'trust': trust})
            cfg = _i589_adopt_canonical_certificate_host(trust['cfg'])
            manifest = trust['manifest']
        elif not (cfg.get('ca_cert_path') and Path(cfg.get('ca_cert_path')).expanduser().is_file()):
            return _i589_progressive_failure('Strict TLS requires a readable CA certificate path.', ['ca_cert_path'], cfg, initial)

        strict = _i589_standard_endpoint_checks(cfg, strict=True)
        if strict['required_fields']:
            return _i589_progressive_failure(
                'OpenTAKServer services were found, but strict trusted validation still needs only the highlighted value or values.',
                strict['required_fields'], cfg, strict)

        auth = _i509_authenticate_remote(cfg, username, password, otp)
        if not auth.get('ok'):
            auth_text = ' '.join([
                _i630_text(auth.get('error')),
                _i630_text(auth.get('message')),
                json.dumps(auth.get('attempts') or [], default=str),
            ]).lower()
            otp_required = bool(
                auth.get('otp_required') or auth.get('requires_otp') or auth.get('mfa_required') or
                any(token in auth_text for token in ('two-factor', '2fa', 'totp', 'one-time code', 'one time code', 'otp required', 'mfa required'))
            )
            required = ['otp'] if otp_required else ['username', 'password']
            message = auth.get('error') or 'OpenTAKServer administrator authentication failed.'
            message += ' Enter the current 2FA code.' if otp_required else ' Verify the administrator username and password.'
            return _i589_progressive_failure(message, required, cfg, strict, {'auth_attempts': auth.get('attempts', []), 'otp_required': otp_required})

        fetched = _i511_fetch_profile(cfg, auth, username)
        if not fetched.get('ok'):
            return _i589_progressive_failure(
                'Authentication succeeded, but TAK Map could not read the administrator profile from /api/me: ' + _i630_text(fetched.get('error')),
                ['api_url'], cfg, strict)
        profile = dict(fetched.get('profile') or {})
        # _i511_fetch_profile may have derived identity using a previously saved
        # OTS connection. Re-derive against this candidate server before enrollment.
        if '_i512_apply_ots_identity' in globals():
            try:
                profile = _i512_apply_ots_identity(cfg, profile)
            except Exception:
                pass
        if not profile.get('is_admin'):
            return _i589_progressive_failure(
                'The account authenticated successfully but does not have the OpenTAKServer administrator role.',
                ['username', 'password'], cfg, strict)

        version_info = _i630_detect_ots_version(cfg, auth)
        cert_result = {'ok': True, 'skipped': True}
        mtls_result = {'ok': True, 'skipped': True}
        if cfg.get('data_sync_enabled') and cfg.get('automatic_user_certificate_enrollment'):
            client_uid = _i630_text(profile.get('tak_uid'))
            cert_result = _i529_ensure_user_certificate(cfg, username, password, client_uid, False)
            if not cert_result.get('ok'):
                safe_cert = {k: v for k, v in cert_result.items() if k not in ('key_password', 'private_key_path', 'certificate_path', 'ca_chain_path')}
                return _i589_progressive_failure(
                    'OTS authentication succeeded, but the OTS 1.7.13 certificate-enrollment preflight failed: ' + _i630_text(cert_result.get('error')),
                    ['enrollment_url'], cfg, strict, {'certificate_enrollment': safe_cert})
            mtls_result = _i630_mtls_probe(cfg, username, client_uid)
            if not mtls_result.get('ok'):
                return _i589_progressive_failure(
                    'The user certificate enrolled successfully, but the Marti client-certificate preflight failed: ' + _i630_text(mtls_result.get('error')),
                    ['marti_url'], cfg, strict, {'client_certificate_mtls': mtls_result})

        validation = {
            'username': profile.get('username', ''),
            'display_identity': profile.get('display_identity', ''),
            'base_url': cfg['base_url'].rstrip('/'),
            'validated_at': _i589_iso_now(),
            'role_names': list(profile.get('role_names') or []),
        }
        preflight = _i630_preflight_summary(cfg, strict, version_info, cert_result, mtls_result, profile)
        cfg['last_admin_validation'] = validation
        cfg['last_ots_preflight'] = preflight
        cfg['ots_compatibility_target'] = _I630_OTS_COMPATIBILITY_TARGET
        saved = _i509_save_ots_config(cfg)

        # Reload because successful per-user enrollment may have updated the i589
        # enrollment manifest independently.
        manifest = _i589_manifest_load()
        manifest['status'] = 'enrolled'
        manifest['origin'] = saved.get('base_url', '').rstrip('/')
        manifest['created_at'] = manifest.get('created_at') or _i589_iso_now()
        manifest['disconnected_at'] = ''
        manifest['capabilities'] = {
            'remote_revocation': 'discover-on-unenroll',
            'standard_endpoint_discovery': True,
            'protocol_aware_endpoint_classification': True,
            'certificate_hostname_discovery': True,
            'managed_hosts_bootstrap': bool((saved.get('managed_dns') or {}).get('ok')),
            'managed_hosts_mapping': bool((saved.get('managed_dns') or {}).get('mapped')),
            'internal_certificate_hostname_pin': bool(saved.get('transport_pin_enabled')),
            'automatic_trust': bool(saved.get('automatic_trust_installation')),
            'automatic_user_certificate_enrollment': bool(saved.get('automatic_user_certificate_enrollment')),
            'ots_1_7_13_preflight': True,
            'client_certificate_mtls_preflight': bool(preflight.get('client_certificate_mtls')),
        }
        _i589_record_file(manifest, TAK_MAP_OTS_CONFIG_FILE, 'connection-configuration')
        manifest = _i589_manifest_write(manifest)
        try:
            final_discovery = _i509_discover_ots(saved)
        except Exception as exc:
            final_discovery = {'ok': True, 'version': _I630_VERSION, 'summary': strict.get('checks'), 'error': str(exc)}
        final_discovery['configure_ots_i630'] = strict
        return {
            'ok': True,
            'version': _I630_VERSION,
            'message': _i630_enrollment_message(saved, preflight, trust),
            'status_label': 'Connected',
            'config': _i509_public_ots_config(saved),
            'discovery': final_discovery,
            'ots_version': version_info,
            'preflight': preflight,
            'administrator': {k: profile.get(k) for k in ('username', 'display_identity', 'role_names')},
            'manifest': {
                'path': str(_I589_ENROLLMENT_MANIFEST_FILE),
                'status': manifest.get('status'),
                'file_count': len(manifest.get('files') or []),
                'managed_tree_count': len(manifest.get('managed_trees') or []),
            },
            'password_persisted': False,
            'otp_persisted': False,
            'truststore_password_persisted': False,
            'standard_endpoints_used': not bool(saved.get('advanced_overrides')),
            'entered_address': _i630_text((cfg.get('canonical_discovery') or {}).get('entered_base_url')),
            'canonical_address': saved.get('base_url', ''),
            'certificate_hostname_adopted': bool((cfg.get('canonical_discovery') or {}).get('adopted_certificate_hostname')),
            'internal_transport_pin': bool(saved.get('transport_pin_enabled')),
            'managed_dns': dict(saved.get('managed_dns') or {}),
        }
    globals()['_i589_enroll_server'] = _i589_enroll_server

    # OTS authentication is the login gate; Data Sync certificate provisioning is
    # attempted immediately but is no longer allowed to reject an otherwise valid
    # OTS login. Data Sync remains unavailable until its identity is ready.
    def _i630_handle_login(self):
        if not self._is_secure_request() and not ALLOW_INSECURE_UPLOAD_AUTH:
            return self._send_json({'ok': False, 'error': 'TAK Map login requires HTTPS.'}, 403)
        form = self._read_form()
        mode = _i630_text(form.get('mode')).lower()
        username = sanitize_ots_username(form.get('username', ''))
        password = str(form.get('password') or '')
        otp = str(form.get('otp') or '')
        cfg = _i509_load_ots_config()
        ots_connected = bool(cfg.get('enabled') and cfg.get('login_enabled'))
        if not mode:
            mode = 'ots' if ots_connected else 'local'
        if mode in ('local', 'local-user', 'local-admin', 'recovery', 'admin'):
            account, error, status_code = _i512_authenticate_local(self, username, password)
            if not account:
                return self._send_json({'ok': False, 'error': error, 'local_login': True}, status_code)
            session_token = _i512_create_local_session(account)
            reply = _i509_session_public(TAK_MAP_SESSIONS.get(session_token))
            reply['ok'] = True
            reply['version'] = _I630_VERSION
            return self._send_json(reply, 200, headers={'Set-Cookie': self._tak_map_session_cookie(session_token)})
        if mode not in ('ots', 'opentakserver'):
            return self._send_json({'ok': False, 'error': 'Select OpenTAKServer Login or Local Login.'}, 400)
        if not ots_connected:
            return self._send_json({'ok': False, 'error': 'OpenTAKServer Login is not currently enabled. Use Local Login.'}, 403)

        auth = _i509_authenticate_remote(cfg, username, password, otp)
        if not auth.get('ok'):
            return self._send_json({'ok': False, 'error': auth.get('error') or 'OpenTAKServer login failed.', 'attempts': auth.get('attempts', [])}, 401)
        fetched = _i511_fetch_profile(cfg, auth, username)
        if fetched.get('ok'):
            profile = dict(fetched['profile'])
        else:
            profile = _i511_profile_from_me({'username': username, 'roles': [], 'euds': []}, username)
            profile['profile_warning'] = _i630_text(fetched.get('error') or 'OpenTAKServer profile unavailable.')
        if '_i512_apply_ots_identity' in globals():
            try:
                profile = _i512_apply_ots_identity(cfg, profile)
            except Exception:
                pass

        client_uid = _i630_text(profile.get('tak_uid'))
        enrolled = {'ok': False, 'skipped': True, 'error': 'Mission Data Sync certificate enrollment is disabled.'}
        if cfg.get('data_sync_enabled') and cfg.get('automatic_user_certificate_enrollment'):
            enrolled = _i529_ensure_user_certificate(cfg, username, password, client_uid, False)

        session_token = _i511_create_profile_session(username, password, 'ots-user', bool(profile.get('is_admin')), auth, profile)
        with TAK_MAP_SESSIONS_LOCK:
            sess = TAK_MAP_SESSIONS.get(session_token)
            if sess is not None:
                sess['password'] = ''
                sess['tak_uid'] = client_uid
                sess['data_sync_identity_ready'] = bool(enrolled.get('ok'))
                sess['data_sync_certificate_cn'] = enrolled.get('certificate_cn') if enrolled.get('ok') else ''
                sess['data_sync_certificate_expires_at'] = enrolled.get('expires_at') if enrolled.get('ok') else ''
                if not enrolled.get('ok'):
                    sess['data_sync_identity_error'] = _i630_text(enrolled.get('error'))
        reply = _i509_session_public(TAK_MAP_SESSIONS.get(session_token))
        reply['ok'] = True
        reply['version'] = _I630_VERSION
        reply['ots_authentication_succeeded'] = True
        reply['data_sync_identity_ready'] = bool(enrolled.get('ok'))
        if not enrolled.get('ok'):
            reply['data_sync_warning'] = 'OpenTAKServer login succeeded. Mission Data Sync is unavailable until the per-user certificate can be enrolled: ' + _i630_text(enrolled.get('error'))
        if profile.get('profile_warning'):
            reply['profile_warning'] = profile['profile_warning']
        return self._send_json(reply, 200, headers={'Set-Cookie': self._tak_map_session_cookie(session_token)})
    Handler._handle_tak_map_login = _i630_handle_login

    _i630_unenroll_before = _i589_unenroll_server
    def _i589_unenroll_server(payload):
        result = _i630_unenroll_before(payload)
        try:
            if isinstance(result, dict) and result.get('ok'):
                subprocess.run(['sudo','-n','/usr/local/sbin/tak-map-action','ots-host-clear'], capture_output=True, text=True, timeout=20)
        except Exception:
            pass
        return result
    globals()['_i589_unenroll_server'] = _i589_unenroll_server

    _I630_OTS_UI_PATCH = r'''<script id="takMapConfigureOtsI630">
(function(w,d){'use strict';const V='i630',DEFAULT_SERVER=__I630_DEFAULT_OTS_SERVER__;
function field(){return d.querySelector('#o589Modal input[data-x="a01"],.ots589 input[data-x="a01"]')}
function apply(){const modal=d.getElementById('o589Modal')||d.querySelector('.ots589');if(!modal)return;const sub=modal.querySelector('header .sub');if(sub)sub.textContent='Enter the OTS administrator credentials. TAK Map automatically discovers and verifies the OpenTAKServer 1.7.13 Web/API, CA trust, Marti HTTPS, certificate enrollment, SSL CoT, and per-user mTLS path.';const f=field();if(f&&!String(f.value||'').trim()){f.value=DEFAULT_SERVER;f.dataset.appValue=DEFAULT_SERVER}const btn=d.getElementById('o589Enroll');if(btn)btn.textContent='Discover, Configure & Verify';const helper=modal.querySelector('[data-w="a01"] .helper');if(helper)helper.textContent='Deployment default: '+DEFAULT_SERVER+' · certificate-backed hostname mappings are added to a TAK Map-managed /etc/hosts block automatically when needed.'}
function boot(){apply();const mo=new MutationObserver(apply);mo.observe(d.body,{childList:true,subtree:true});[100,400,1000,2200].forEach(ms=>setTimeout(apply,ms))}if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',boot,{once:true});else boot();w.TakMapConfigureOtsI630=Object.freeze({version:V,apply,defaultServer:DEFAULT_SERVER});
})(window,document);
</script>'''.replace('__I630_DEFAULT_OTS_SERVER__', json.dumps(_I630_DEFAULT_OTS_SERVER))

    def _i630_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.4\.0-i629', _I630_PACKAGE_VERSION, html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i630\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i630\2', html)
        html = re.sub(r'id="takMapIdentityGuardI629"', 'id="takMapIdentityGuardI630"', html)
        html = re.sub(r"ITERATION='i629',PACKAGE='1\.4\.0-i(?:629|630)'", "ITERATION='i630',PACKAGE='1.4.0-i630'", html)
        html = html.replace("const V='i629',RELEASE='1.4.0'", "const V='i630',RELEASE='1.4.0'")
        html = html.replace("packageFile:'tak-map-v1.4.0-i629.zip'", "packageFile:'tak-map-v1.4.0-i630.zip'")
        if 'id="takMapConfigureOtsI630"' not in html:
            html = html.replace('</body>', _I630_OTS_UI_PATCH + '\n</body>', 1) if '</body>' in html else html + _I630_OTS_UI_PATCH
        return html

    TAK_MAP_HTML = _i630_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i630_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I630_VERSION

    _i630_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i630_config_before() or {})
        cfg['version'] = _I630_PACKAGE_VERSION
        cfg['tak_map_iteration'] = _I630_VERSION
        cfg['configure_ots_i630'] = {
            'version': _I630_VERSION,
            'package_version': _I630_PACKAGE_VERSION,
            'compatibility_target': _I630_OTS_COMPATIBILITY_TARGET,
            'deployment_default_server': _I630_DEFAULT_OTS_SERVER,
            'standard_ports': {'web_https': 443, 'marti_https': 8443, 'certificate_enrollment': 8446, 'ssl_cot': 8089},
            'web_https_candidates': [443, 8443],
            'truststore_endpoint': '/api/truststore',
            'api_identity_endpoint': '/api/me',
            'certificate_enrollment_endpoint': '/Marti/api/tls/signClient/v2',
            'strict_tls_required': True,
            'certificate_hostname_internal_pin_fallback': True,
            'managed_hosts_bootstrap': True,
            'hosts_file_edit_required_when_certificate_needs_dns_name': True,
            'managed_hosts_file_edit_performed_when_needed': True,
            'managed_hosts_mapping_automatic': True,
            'manual_hosts_file_edit_required': False,
            'default_ots_truststore_password_attempted_when_needed': True,
            'secrets_persisted': False,
            'admin_profile_required': True,
            'per_user_certificate_preflight': True,
            'marti_client_certificate_preflight': True,
            'ots_login_independent_of_data_sync_certificate_failure': True,
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i630_exc:
    try:
        print('TAK Map i630 OTS 1.7.13 enrollment automation patch failed:', _i630_exc)
    except Exception:
        pass
# --- end TAK Map i630 FINAL OpenTAKServer 1.7.13 zero-touch enrollment and resilient login ---


# --- TAK Map i633 FINAL ADS-B marker-scale + 5-second cadence correction ---
try:
    import collections as _i631_collections
    import json as _i631_json
    import threading as _i631_threading
    import time as _i631_time

    _I631_VERSION = 'i633'
    _I631_PACKAGE_VERSION = '1.4.0-i633'
    _I631_ADSB_PRIMARY_RETRY_SECONDS = 600.0
    _I631_ADSB_LOCK = _i631_threading.RLock()
    # Separate client-state lock so an ADS-B OFF notification can revoke a
    # browser request while an upstream HTTP call is still in progress.
    _I631_ADSB_CLIENT_LOCK = _i631_threading.RLock()
    _I631_ADSB_ACTIVE_CLIENTS = {}
    _I631_ADSB_CACHE = _i631_collections.OrderedDict()
    _I631_ADSB_LAST_GOOD = _i631_collections.OrderedDict()
    _I631_ADSB_STATE = {
        'primary_retry_at': 0.0,
        'primary_last_failure_at': 0.0,
        'primary_last_success_at': 0.0,
        'secondary_last_success_at': 0.0,
        'last_request_at': 0.0,
        'last_network_at': 0.0,
        'last_error': '',
        'network_requests': 0,
        'primary_attempts': 0,
        'secondary_attempts': 0,
    }

    # i631 is request-driven. Disable the inherited i464/i465 background collector
    # before serving traffic so an ADS-B OFF browser state cannot leave an upstream
    # provider poll alive for the old last-client grace period.
    try:
        with _I464_ADSB_LOCK:
            _I464_ADSB_STATE['desired_key'] = ''
            _I464_ADSB_STATE['desired_settings'] = None
            _I464_ADSB_STATE['last_client_at'] = 0.0
            _I464_ADSB_STATE['next_allowed_at'] = 0.0
    except Exception:
        pass

    try:
        import urllib3 as _i631_urllib3
        _I631_ADSB_POOL = _i631_urllib3.PoolManager(
            num_pools=4,
            maxsize=4,
            block=True,
            retries=False,
            timeout=_i631_urllib3.Timeout(connect=2.0, read=4.0),
        )
    except Exception:
        _i631_urllib3 = None
        _I631_ADSB_POOL = None

    def _i631_adsb_client_id(value):
        return re.sub(r'[^A-Za-z0-9_.:-]', '', str(value or ''))[:96]

    def _i631_adsb_set_client_active(value, active):
        cid = _i631_adsb_client_id(value)
        if not cid:
            return ''
        with _I631_ADSB_CLIENT_LOCK:
            if active:
                _I631_ADSB_ACTIVE_CLIENTS[cid] = _i631_time.time()
            else:
                _I631_ADSB_ACTIVE_CLIENTS.pop(cid, None)
        return cid

    def _i631_adsb_client_active(value):
        cid = _i631_adsb_client_id(value)
        # Compatibility for non-browser/internal tests that explicitly pass the
        # network sentinel without a client id. The shipped browser always sends
        # a client id, so its OFF notification can revoke follow-on fallbacks.
        if not cid:
            return True
        with _I631_ADSB_CLIENT_LOCK:
            return cid in _I631_ADSB_ACTIVE_CLIENTS

    def _i631_adsb_settings(query_settings=None):
        st = dict(_load_adsb_settings() or {})
        if isinstance(query_settings, dict):
            la = _coerce_float(query_settings.get('center_lat'))
            lo = _coerce_float(query_settings.get('center_lon'))
            if la is not None and lo is not None and -90 <= la <= 90 and -180 <= lo <= 180:
                st['center_lat'] = la
                st['center_lon'] = lo
                st['has_center'] = True
            if query_settings.get('radius_miles') is not None:
                try:
                    st['radius_miles'] = max(1, min(250, int(round(float(query_settings.get('radius_miles'))))))
                except Exception:
                    pass
        return st

    def _i631_adsb_key(st):
        try:
            return '%.5f,%.5f/%d' % (
                float(st.get('center_lat')),
                float(st.get('center_lon')),
                int(st.get('radius_miles') or 10),
            )
        except Exception:
            return 'no-center/%d' % int(st.get('radius_miles') or 10)

    def _i631_adsb_radius(st):
        try:
            return max(1, min(250, int(round(float(st.get('radius_miles') or 10)))))
        except Exception:
            return 10

    def _i631_provider_url(provider, st, hex_id=''):
        host = 'api.airplanes.live' if provider == 'primary' else 'api.adsb.lol'
        if hex_id:
            value = re.sub(r'[^0-9A-Fa-f]', '', str(hex_id or ''))[:12]
            return ('https://' + host + '/v2/hex/' + value) if value else ''
        try:
            lat = float(st.get('center_lat'))
            lon = float(st.get('center_lon'))
        except Exception:
            return ''
        if not (-90 <= lat <= 90 and -180 <= lon <= 180):
            return ''
        return 'https://%s/v2/point/%.6f/%.6f/%d' % (host, lat, lon, _i631_adsb_radius(st))

    def _i631_fetch_provider(provider, url, timeout=5.0):
        if not url:
            raise RuntimeError('ADS-B center is not set.')
        ua = 'TAKMap/1.4.0-i633 ADS-B Backend'
        if _I631_ADSB_POOL is not None:
            r = _I631_ADSB_POOL.request(
                'GET', url,
                headers={'User-Agent': ua, 'Accept': 'application/json'},
                preload_content=True,
                decode_content=True,
                redirect=True,
                timeout=_i631_urllib3.Timeout(connect=min(2.0, float(timeout)), read=max(1.0, min(4.0, float(timeout)))),
            )
            try:
                if int(r.status) < 200 or int(r.status) >= 300:
                    raise RuntimeError('ADS-B upstream HTTP %s' % int(r.status))
                raw = bytes(r.data or b'{}')
            finally:
                r.release_conn()
        else:
            req = Request(url, headers={'User-Agent': ua, 'Accept': 'application/json'})
            with urlopen(req, timeout=timeout) as resp:
                status = int(getattr(resp, 'status', 200) or 200)
                if status < 200 or status >= 300:
                    raise RuntimeError('ADS-B upstream HTTP %s' % status)
                raw = resp.read(8 * 1024 * 1024)
        try:
            data = _i631_json.loads(raw.decode('utf-8', 'replace'))
        except Exception as exc:
            raise RuntimeError('ADS-B upstream returned invalid JSON.') from exc
        # A recognized empty array is a valid successful response. Do not fail over
        # simply because no aircraft are currently inside the requested radius.
        if isinstance(data, dict) and (isinstance(data.get('ac'), list) or isinstance(data.get('aircraft'), list)):
            return data
        raise RuntimeError('ADS-B upstream returned an unrecognized response.')

    def _i631_raw_items(data):
        if isinstance(data, dict):
            if isinstance(data.get('ac'), list):
                return data.get('ac') or []
            if isinstance(data.get('aircraft'), list):
                return data.get('aircraft') or []
        return []

    def _i631_normalize(data, st):
        stale = _adsb_stale_seconds(st)
        by = {}
        raw = _i631_raw_items(data)
        for item in raw:
            if not isinstance(item, dict):
                continue
            # Provider identity is deliberately hidden from the aircraft model/UI.
            ac = _normalize_adsb_aircraft(item, 'ADS-B')
            if not ac:
                continue
            try:
                if ac.get('seen_seconds') is not None and float(ac.get('seen_seconds')) > stale:
                    continue
            except Exception:
                pass
            try:
                if not _adsb_in_radius(ac, st):
                    continue
            except Exception:
                continue
            key = str(ac.get('id') or ac.get('hex') or ac.get('registration') or ac.get('callsign') or '').strip().lower()
            if not key:
                continue
            old = by.get(key)
            def rank(x):
                try:
                    return float(x.get('seen_seconds'))
                except Exception:
                    return 999999.0
            if old is None or rank(ac) < rank(old):
                by[key] = ac
        rows = list(by.values())
        rows.sort(key=lambda x: (float(x.get('range_miles') or 999999), str(x.get('callsign') or x.get('id') or '')))
        return rows, len(raw), stale

    _I631_ADSB_ACTIVE_COALESCE_SECONDS = 0.5

    def _i631_cache_seconds(st):
        # i633: active browser polls are cadence owners. Cache only long enough to
        # coalesce concurrent/near-simultaneous clients; do not consume the next
        # configured poll with a response timestamped at provider completion.
        return _I631_ADSB_ACTIVE_COALESCE_SECONDS

    def _i631_trim_cache(cache, limit=8):
        while len(cache) > limit:
            cache.popitem(last=False)

    def _i631_cached_response(key, st, allow_stale=False):
        now = _i631_time.time()
        ent = _I631_ADSB_CACHE.get(key)
        if ent:
            age = now - float(ent.get('stored_at') or 0.0)
            if allow_stale or age < _i631_cache_seconds(st):
                out = dict(ent.get('response') or {})
                out['cache_age_seconds'] = round(max(0.0, age), 3)
                return out
        return None

    def _i631_result(st, rows, raw_count, stale, ok=True, error='', preserved=False):
        # Keep provider selection invisible to the browser interface. The UI sees
        # only a generic backend source health record.
        return {
            'ok': bool(ok),
            'version': _I631_VERSION,
            'source_mode': 'backend_auto_failover',
            'aircraft': list(rows or []),
            'count': len(rows or []),
            'sources': [{'source': 'adsb-backend', 'ok': bool(ok), 'error': str(error or '')[:240]}],
            'stale_seconds': stale,
            'settings': st,
            'snapshot_ready': True,
            'preserve_last_good': bool(preserved),
            'raw_count': int(raw_count or 0),
        }

    def tak_map_adsb(query_settings=None):
        st = _i631_adsb_settings(query_settings)
        key = _i631_adsb_key(st)
        client_id = _i631_adsb_client_id((query_settings or {}).get('_client_id') if isinstance(query_settings, dict) else '')
        network_allowed = bool(isinstance(query_settings, dict) and query_settings.get('_network_allowed') is True)
        if network_allowed and client_id and not _i631_adsb_client_active(client_id):
            network_allowed = False
        now = _i631_time.time()
        with _I631_ADSB_LOCK:
            _I631_ADSB_STATE['last_request_at'] = now
            fresh = _i631_cached_response(key, st, False)
            if fresh is not None:
                return fresh
            # Hard ADS-B OFF gate: internal status/config callers and legacy ADS-B
            # paths may read the last snapshot, but they can never trigger either
            # public provider. Only the active ADS-B worker route sets this sentinel.
            if not network_allowed:
                stale_cached = _i631_cached_response(key, st, True)
                if stale_cached is not None:
                    return stale_cached
                last = _I631_ADSB_LAST_GOOD.get(key) or {}
                return _i631_result(st, last.get('aircraft') or [], last.get('raw_count') or 0,
                                    last.get('stale_seconds') or _adsb_stale_seconds(st), True, '', bool(last))

            _I631_ADSB_STATE['last_network_at'] = now
            _I631_ADSB_STATE['network_requests'] = int(_I631_ADSB_STATE.get('network_requests') or 0) + 1
            data = None
            errors = []
            primary_retry_at = float(_I631_ADSB_STATE.get('primary_retry_at') or 0.0)
            if now >= primary_retry_at and (not client_id or _i631_adsb_client_active(client_id)):
                _I631_ADSB_STATE['primary_attempts'] = int(_I631_ADSB_STATE.get('primary_attempts') or 0) + 1
                try:
                    data = _i631_fetch_provider('primary', _i631_provider_url('primary', st), 5.0)
                    _I631_ADSB_STATE['primary_retry_at'] = 0.0
                    _I631_ADSB_STATE['primary_last_success_at'] = _i631_time.time()
                    _I631_ADSB_STATE['last_error'] = ''
                except Exception as exc:
                    errors.append(str(exc))
                    _I631_ADSB_STATE['primary_last_failure_at'] = _i631_time.time()
                    _I631_ADSB_STATE['primary_retry_at'] = _i631_time.time() + _I631_ADSB_PRIMARY_RETRY_SECONDS

            # Re-check the browser's active lease before starting the fallback.
            # An ADS-B OFF action can revoke it on the separate client-state lock
            # even while the primary request above is still returning/failing.
            if data is None and (not client_id or _i631_adsb_client_active(client_id)):
                _I631_ADSB_STATE['secondary_attempts'] = int(_I631_ADSB_STATE.get('secondary_attempts') or 0) + 1
                try:
                    data = _i631_fetch_provider('secondary', _i631_provider_url('secondary', st), 5.0)
                    _I631_ADSB_STATE['secondary_last_success_at'] = _i631_time.time()
                    _I631_ADSB_STATE['last_error'] = ''
                except Exception as exc:
                    errors.append(str(exc))
                    _I631_ADSB_STATE['last_error'] = '; '.join(errors)[-300:]
            elif data is None and client_id:
                # Disabled while an enabled request was in flight. Never start a
                # second provider query after the OFF notification.
                last = _I631_ADSB_LAST_GOOD.get(key) or {}
                return _i631_result(st, last.get('aircraft') or [], last.get('raw_count') or 0,
                                    last.get('stale_seconds') or _adsb_stale_seconds(st), True, '', bool(last))

            if data is not None:
                rows, raw_count, stale = _i631_normalize(data, st)
                response = _i631_result(st, rows, raw_count, stale, True, '', False)
                stored = {'stored_at': _i631_time.time(), 'response': dict(response)}
                _I631_ADSB_CACHE[key] = stored
                _I631_ADSB_CACHE.move_to_end(key)
                _i631_trim_cache(_I631_ADSB_CACHE)
                _I631_ADSB_LAST_GOOD[key] = {
                    'stored_at': stored['stored_at'], 'aircraft': list(rows),
                    'raw_count': raw_count, 'stale_seconds': stale,
                }
                _I631_ADSB_LAST_GOOD.move_to_end(key)
                _i631_trim_cache(_I631_ADSB_LAST_GOOD)
                return response

            last = _I631_ADSB_LAST_GOOD.get(key) or {}
            error = '; '.join(errors)[-240:] or 'ADS-B providers unavailable.'
            return _i631_result(st, last.get('aircraft') or [], last.get('raw_count') or 0,
                                last.get('stale_seconds') or _adsb_stale_seconds(st), False, error, bool(last))
    globals()['tak_map_adsb'] = tak_map_adsb

    # Intercept the current ADS-B endpoint before all inherited handlers. The
    # dedicated ADS-B worker marks active requests explicitly. Requests without
    # active=1 are cache-only and therefore cannot reach either upstream service.
    _i631_get_before = Handler.do_GET
    def _i631_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/api/tak-map/adsb':
            if not self._tak_map_auth_ok():
                return self._require_tak_map_login()
            q = parse_qs(parsed.query or '')
            qs = {}
            for key_name in ('center_lat', 'center_lon', 'radius_miles'):
                if key_name in q and q.get(key_name):
                    qs[key_name] = (q.get(key_name) or [''])[0]
            active_value = (q.get('active') or [''])[0]
            client_id = _i631_adsb_client_id((q.get('client_id') or [''])[0])
            if client_id:
                qs['_client_id'] = client_id
            if active_value == '0' and client_id:
                # Explicit OFF is a network-silent control message. Revoke the
                # browser lease immediately without waiting on any provider lock.
                _i631_adsb_set_client_active(client_id, False)
                return self._send_json({'ok': True, 'version': _I631_VERSION, 'aircraft': [], 'count': 0,
                                        'snapshot_ready': True, 'source_mode': 'backend_auto_failover'})
            if active_value == '1' and client_id:
                _i631_adsb_set_client_active(client_id, True)
            qs['_network_allowed'] = (active_value == '1')
            return self._send_json(tak_map_adsb(qs))
        return _i631_get_before(self)
    Handler.do_GET = _i631_get

    def _i631_patch_html(html):
        html = str(html or '')
        html = html.replace('1.4.0-i630', _I631_PACKAGE_VERSION)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i633\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i633\2', html)
        html = html.replace("ITERATION='i630',PACKAGE='1.4.0-i633'", "ITERATION='i633',PACKAGE='1.4.0-i633'")
        html = html.replace("ITERATION='i630',PACKAGE='1.4.0-i630'", "ITERATION='i633',PACKAGE='1.4.0-i633'")
        html = html.replace("const V='i630',RELEASE='1.4.0'", "const V='i633',RELEASE='1.4.0'")
        html = html.replace("packageFile:'tak-map-v1.4.0-i630.zip'", "packageFile:'tak-map-v1.4.0-i633.zip'")
        return html

    TAK_MAP_HTML = _i631_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i631_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I631_VERSION

    _i631_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i631_config_before() or {})
        cfg['version'] = _I631_PACKAGE_VERSION
        cfg['tak_map_iteration'] = _I631_VERSION
        adsb = dict(cfg.get('adsb') or {})
        adsb['settings'] = _load_adsb_settings()
        adsb['source_mode'] = 'backend_auto_failover'
        cfg['adsb'] = adsb
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i631_exc:
    try:
        print('TAK Map i633 ADS-B failover patch failed:', _i631_exc)
    except Exception:
        pass
# --- end TAK Map i633 FINAL ADS-B marker-scale + 5-second cadence correction ---


# --- TAK Map i634 server-authoritative Data Sync + persistent card states + AIS finalization ---
try:
    _I634_VERSION = 'i634'
    _I634_PACKAGE_VERSION = '1.4.0-i634'
    _I634_ROOT = Path(__file__).resolve().parent
    _I634_CARD_STATES_FILE = DATA_DIR / 'tak_map_card_states_i634.json'
    _I634_CARD_LOCK = threading.RLock()
    _I634_CARD_KEY_RE = re.compile(r'^[A-Za-z0-9_.:\-]{1,160}$')

    def _i634_user_key(sess):
        sess = sess or {}
        mode = str(sess.get('auth_mode') or 'user').strip().lower() or 'user'
        username = str(sess.get('username') or (sess.get('profile') or {}).get('username') or '').strip().casefold()
        return mode + ':' + username if username else ''

    def _i634_load_card_states():
        raw = load_json_file(_I634_CARD_STATES_FILE, {'version': 1, 'users': {}})
        if not isinstance(raw, dict): raw = {'version': 1, 'users': {}}
        if not isinstance(raw.get('users'), dict): raw['users'] = {}
        return raw

    def _i634_card_states_for(sess):
        key = _i634_user_key(sess)
        with _I634_CARD_LOCK:
            raw = _i634_load_card_states()
            states = dict((raw.get('users') or {}).get(key) or {}) if key else {}
        return {str(k): bool(v) for k,v in states.items() if _I634_CARD_KEY_RE.fullmatch(str(k))}

    def _i634_save_card_state(sess, key, enabled):
        key = str(key or '').strip()
        user = _i634_user_key(sess)
        if not user: raise ValueError('Authenticated user identity is unavailable.')
        if not _I634_CARD_KEY_RE.fullmatch(key): raise ValueError('Invalid card-state key.')
        with _I634_CARD_LOCK:
            raw = _i634_load_card_states(); users = raw.setdefault('users', {})
            states = dict(users.get(user) or {}); states[key] = bool(enabled); users[user] = states
            raw['version'] = 1; raw['updated_at'] = datetime.now(timezone.utc).isoformat()
            atomic_write_json(_I634_CARD_STATES_FILE, raw)
        return states

    def _i634_uid(row):
        if not isinstance(row, dict): return ''
        for k in ('canonical_uid','canonical_id','object_uid','uid','UID','guid','id'):
            v = str(row.get(k) or '').strip()
            if v: return v
        return ''

    def _i634_mission(row):
        # Association identity must come from explicit Mission fields only.
        # Older generic helpers may treat an object's display `name` as a
        # Mission name, which can silently manufacture an association for an
        # orphan object. i634 deliberately refuses that ambiguity.
        if not isinstance(row, dict): return ''
        for k in ('mission','mission_name','missionName','mission_title','missionTitle','mission_id','missionId'):
            v = str(row.get(k) or '').strip()
            if v: return v
        return ''

    def _i634_normalize_server_authoritative(payload):
        if not isinstance(payload, dict): return payload
        out = _i568_clone(payload) if '_i568_clone' in globals() else json.loads(json.dumps(payload, default=str))
        membership = {}
        for collection in ('mission_uids','mission_content_mission','mission_content','packages'):
            for row in list(out.get(collection) or []):
                if not isinstance(row, dict): continue
                uid, mission = _i634_uid(row), _i634_mission(row)
                if uid and mission: membership.setdefault(uid.casefold(), set()).add(mission)
        merged, order, quarantine = {}, [], 0
        for idx,row in enumerate(list(out.get('objects') or [])):
            if not isinstance(row, dict): continue
            item = dict(row); uid = _i634_uid(item)
            missions = set()
            direct = _i634_mission(item)
            if direct: missions.add(direct)
            for m in item.get('mission_memberships') or []:
                if str(m or '').strip(): missions.add(str(m).strip())
            if uid: missions.update(membership.get(uid.casefold(), set()))
            missions = {m for m in missions if m}
            if not missions:
                quarantine += 1
                continue
            key = ('uid:'+uid.casefold()) if uid else ('row:%d:%s' % (idx, direct.casefold()))
            if key not in merged:
                item['mission_memberships'] = sorted(missions, key=str.casefold)
                item['associations'] = [{'scope':'mission','mission':m} for m in item['mission_memberships']]
                item['association_scope'] = 'mission'
                item['server_authoritative_i634'] = True
                merged[key] = item; order.append(key)
            else:
                cur = merged[key]; ms = set(cur.get('mission_memberships') or []); ms.update(missions)
                cur['mission_memberships'] = sorted(ms, key=str.casefold)
                cur['associations'] = [{'scope':'mission','mission':m} for m in cur['mission_memberships']]
        out['objects'] = [merged[k] for k in order]
        out['version'] = _I634_VERSION
        out['data_sync_association_i634'] = {
            'version': _I634_VERSION, 'server_authoritative': True, 'conflict_resolution': False,
            'canonical_uid_merge': True, 'many_to_many_mission_membership': True,
            'association_invariant': 'Local Data or one-or-more Missions',
            'visible_mission_objects': len(out['objects']), 'quarantined_unassociated_objects': quarantine,
            'security_filter_before_canonical_merge': True,
        }
        return out

    if '_i594_filter_security_view' in globals():
        _i634_filter_before = _i594_filter_security_view
        def _i594_filter_security_view(payload, state, sess=None):
            out, status = _i634_filter_before(payload, state, sess)
            return _i634_normalize_server_authoritative(out), status
        globals()['_i594_filter_security_view'] = _i594_filter_security_view
        if '_i591_filter_security_view' in globals(): globals()['_i591_filter_security_view'] = _i594_filter_security_view

    if 'tak_map_imported' in globals():
        _i634_imported_before = tak_map_imported
        def tak_map_imported(*args, **kwargs):
            out = _i634_imported_before(*args, **kwargs)
            def stamp(v):
                if isinstance(v, list):
                    for x in v: stamp(x)
                elif isinstance(v, dict):
                    looks = any(k in v for k in ('kind','geometry','coords','lat','lon','uid','cot_type'))
                    if looks and not v.get('mission') and not v.get('mission_name'):
                        v.setdefault('association_scope','local_data')
                        v.setdefault('associations',[{'scope':'local_data','name':'Local Data'}])
                    for k in ('features','points','routes','shapes','objects'): 
                        if k in v: stamp(v.get(k))
            if isinstance(out, dict):
                stamp(out); out['local_data_association_i634']={'version':_I634_VERSION,'association':'Local Data','orphan_objects_allowed':False}
            return out
        globals()['tak_map_imported'] = tak_map_imported

    _i634_get_before = Handler.do_GET
    def _i634_do_get(self):
        parsed = urlparse(self.path); path = parsed.path
        if path == '/assets/runtime/tak-map-i634.js':
            try: body = (_I634_ROOT/'assets'/'tak-map-i634.js').read_bytes()
            except Exception: return self.send_error(404)
            self.send_response(200); self.send_header('Content-Type','application/javascript; charset=utf-8'); self.send_header('Cache-Control','no-store, max-age=0'); self.send_header('X-TAK-Map-Module',_I634_VERSION); self.send_header('Content-Length',str(len(body))); self.end_headers()
            if getattr(self,'command','GET') != 'HEAD': self.wfile.write(body)
            return
        if path == '/api/tak-map/card-states':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            return self._send_json({'ok':True,'version':_I634_VERSION,'states':_i634_card_states_for(self._tak_map_session()),'per_user':True})
        return _i634_get_before(self)
    Handler.do_GET = _i634_do_get

    _i634_post_before = Handler.do_POST
    def _i634_do_post(self):
        parsed = urlparse(self.path); path = parsed.path
        if path == '/api/tak-map/card-states':
            if not self._tak_map_auth_ok(): return self._require_tak_map_login()
            try:
                payload = _read_json_body(self); states = _i634_save_card_state(self._tak_map_session(), payload.get('key'), payload.get('enabled'))
                return self._send_json({'ok':True,'version':_I634_VERSION,'states':states,'per_user':True})
            except Exception as exc: return self._send_json({'ok':False,'version':_I634_VERSION,'error':str(exc)},400)
        return _i634_post_before(self)
    Handler.do_POST = _i634_do_post

    _i634_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i634_config_before() or {}); cfg['version']=_I634_PACKAGE_VERSION; cfg['tak_map_iteration']=_I634_VERSION
        cfg['server_authoritative_data_sync_i634']={'version':_I634_VERSION,'conflict_resolution':False,'association_invariant':'Local Data or Mission','canonical_uid_many_to_many_missions':True,'global_mission_object_search':True,'orphan_quarantine':True}
        cfg['card_state_persistence_i634']={'version':_I634_VERSION,'per_authenticated_user':True,'backend_persisted':True,'hydrate_before_card_runtime':True}
        cfg['ais_rendering_i634']={'version':_I634_VERSION,'render_scale':0.5,'drop_shadow':False}
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _I634_LOADER = '<script id="takMapI634Loader" src="/assets/runtime/tak-map-i634.js?v=1.4.0-i634"></script>'
    def _i634_patch_html(html, include_loader=True):
        html = str(html or '')
        html = re.sub(r'<script[^>]*id=["\']takMapI634Loader["\'][^>]*></script>\s*','',html,flags=re.I)
        if include_loader:
            if '<head>' in html: html = html.replace('<head>','<head>'+_I634_LOADER,1)
            else: html = _I634_LOADER + html
        html = html.replace('1.4.0-i633', _I634_PACKAGE_VERSION)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i634\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i634\2', html)
        html = re.sub(r"(const\s+V\s*=\s*['\"])i633(['\"])", r'\1i634\2', html)
        html = re.sub(r"(ITERATION\s*=\s*['\"])i633(['\"])", r'\1i634\2', html)
        return html
    TAK_MAP_HTML = _i634_patch_html(TAK_MAP_HTML, include_loader=True); INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i634_patch_html(TAK_MAP_LOGIN_HTML, include_loader=False); LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I634_VERSION
except Exception as _i634_exc:
    try: print('TAK Map i634 finalization patch failed:', _i634_exc)
    except Exception: pass
# --- end TAK Map i634 ---

# --- TAK Map i635 pre-existing object migration + authoritative multi-Mission membership/delete correction ---
try:
    _I635_VERSION = 'i635'
    _I635_PACKAGE_VERSION = '1.4.0-i635'
    _I635_ROOT = Path(__file__).resolve().parent
    _I635_ASSOC_FILE = DATA_DIR / 'tak_map_data_sync_associations_i635.json'
    _I635_ASSOC_LOCK = threading.RLock()

    def _i635_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i635_session(sess=None):
        if isinstance(sess, dict):
            return sess
        try:
            fn = globals().get('_i572_session')
            return dict(fn() or {}) if callable(fn) else {}
        except Exception:
            return {}

    def _i635_user_key(sess=None):
        sess = _i635_session(sess)
        fn = globals().get('_i634_user_key')
        if callable(fn):
            try:
                return _i635_text(fn(sess))
            except Exception:
                pass
        mode = _i635_text(sess.get('auth_mode') or 'user').lower() or 'user'
        username = _i635_text(sess.get('username') or (sess.get('profile') or {}).get('username')).casefold()
        return mode + ':' + username if username else ''

    def _i635_uid(row):
        if not isinstance(row, dict):
            return ''
        # Source/event UID always wins. Never use canonical_id as a Mission UID.
        for key in ('uid','UID','event_uid','eventUid','cot_uid','cotUid','source_uid','sourceUid','object_uid','objectUid','guid'):
            value = _i635_text(row.get(key))
            if value:
                return value
        if _i635_text(row.get('source_kind')).casefold() == 'datasync':
            value = _i635_text(row.get('source_id'))
            if value:
                return value
        return ''

    def _i635_content_hash(row):
        if not isinstance(row, dict):
            return ''
        nested = row.get('properties') if isinstance(row.get('properties'), dict) else {}
        for source in (row, nested):
            for key in ('sha256','hash','content_hash','contentHash'):
                value = _i635_text(source.get(key))
                if value:
                    return value
        return ''

    def _i635_identity(row):
        uid = _i635_uid(row)
        if uid:
            return 'uid:' + uid.casefold(), uid, 'uid'
        digest = _i635_content_hash(row)
        if digest:
            return 'hash:' + digest.casefold(), digest, 'hash'
        return '', '', ''

    def _i635_mission_names(row):
        out = []
        if not isinstance(row, dict):
            return out
        for key in ('mission','mission_name','missionName','mission_title','missionTitle'):
            value = _i635_text(row.get(key))
            if value and value not in out:
                out.append(value)
        for key in ('mission_memberships','mission_names'):
            values = row.get(key)
            if isinstance(values, (list, tuple, set)):
                for value in values:
                    value = _i635_text(value)
                    if value and value not in out:
                        out.append(value)
        return out

    def _i635_accessible_missions(payload):
        names = set()
        if not isinstance(payload, dict):
            return names
        for key in ('mission_access_i599','mission_access_i596','mission_access_i595','mission_access_i594','mission_access_i591','mission_access_i576'):
            rows = payload.get(key)
            if not isinstance(rows, list):
                continue
            for row in rows:
                if not isinstance(row, dict) or row.get('locked') is True or row.get('unlocked') is False:
                    continue
                mission = _i635_text(row.get('mission') or row.get('mission_name') or row.get('name'))
                if mission:
                    names.add(mission.casefold())
            if names:
                break
        if not names:
            for row in list(payload.get('missions') or []):
                if isinstance(row, str):
                    mission = _i635_text(row)
                elif isinstance(row, dict) and not row.get('locked'):
                    mission = _i635_text(row.get('mission') or row.get('mission_name') or row.get('name'))
                else:
                    mission = ''
                if mission:
                    names.add(mission.casefold())
        return names

    def _i635_load_assoc():
        raw = load_json_file(_I635_ASSOC_FILE, {'version':1,'users':{}})
        if not isinstance(raw, dict): raw = {'version':1,'users':{}}
        if not isinstance(raw.get('users'), dict): raw['users'] = {}
        return raw

    def _i635_saved_for(sess=None):
        user = _i635_user_key(sess)
        if not user:
            return {}
        with _I635_ASSOC_LOCK:
            raw = _i635_load_assoc()
            row = (raw.get('users') or {}).get(user) or {}
            objects = row.get('objects') if isinstance(row, dict) else {}
            return dict(objects or {}) if isinstance(objects, dict) else {}

    def _i635_persist_batch(sess, records):
        user = _i635_user_key(sess)
        if not user or not records:
            return False
        with _I635_ASSOC_LOCK:
            raw = _i635_load_assoc(); users = raw.setdefault('users', {})
            bucket = dict(users.get(user) or {}); objects = dict(bucket.get('objects') or {})
            changed = False
            now = datetime.now(timezone.utc).isoformat()
            for key, rec in records.items():
                if not key or not isinstance(rec, dict):
                    continue
                normalized = {
                    'identity': key,
                    'uid': _i635_text(rec.get('uid')),
                    'hash': _i635_text(rec.get('hash')),
                    'missions': sorted({_i635_text(m) for m in rec.get('missions') or [] if _i635_text(m)}, key=str.casefold),
                    'local_data': bool(rec.get('local_data')),
                    'updated_at': now,
                }
                old = dict(objects.get(key) or {})
                comparable_old = {k:old.get(k) for k in ('identity','uid','hash','missions','local_data')}
                comparable_new = {k:normalized.get(k) for k in ('identity','uid','hash','missions','local_data')}
                if comparable_old != comparable_new:
                    objects[key] = normalized; changed = True
            if not changed:
                return False
            # Bounded persistent migration cache. Keep newest records first.
            if len(objects) > 20000:
                ordered = sorted(objects.items(), key=lambda kv:_i635_text((kv[1] or {}).get('updated_at')), reverse=True)[:20000]
                objects = dict(ordered)
            bucket['objects'] = objects; bucket['updated_at'] = now; users[user] = bucket
            raw['version'] = 1; raw['updated_at'] = now
            atomic_write_json(_I635_ASSOC_FILE, raw)
            return True

    def _i635_is_delete_event(row):
        try:
            checker = globals().get('_i602_is_delete_event') or globals().get('_i563_delete_event')
            return bool(checker(row)) if callable(checker) else False
        except Exception:
            return False

    def _i635_legitimate_preexisting(row):
        if not isinstance(row, dict) or _i635_is_delete_event(row):
            return False
        ident, _, _ = _i635_identity(row)
        if not ident:
            return False
        # Existing TAK objects may be points, routes, shapes, or packaged objects.
        # Missing new i634/i635 association metadata alone is never invalidity.
        if row.get('lat') is not None and (row.get('lon') is not None or row.get('lng') is not None):
            return True
        if isinstance(row.get('coords'), list) and row.get('coords'):
            return True
        if isinstance(row.get('geometry'), dict) or isinstance(row.get('geometry'), list):
            return True
        blob = ' '.join(_i635_text(row.get(k)) for k in ('kind','type','cot_type','source','object_kind')).casefold()
        return any(token in blob for token in ('point','route','shape','marker','mission','datasync','package','file','photo'))

    # Stamp authoritative Mission ownership at the acquisition boundary. This is
    # the primary source of truth for all future snapshots and avoids attempting
    # to infer Mission association from display names or content IDs downstream.
    if callable(globals().get('_i599_project_cot')):
        _i635_project_before = _i599_project_cot
        def _i599_project_cot(acquired, cfg, mission):
            result, rows = _i635_project_before(acquired, cfg, mission)
            mission_name = _i635_text(mission)
            stamped = []
            for raw in list(rows or []):
                if not isinstance(raw, dict):
                    continue
                row = dict(raw)
                if mission_name:
                    row['mission'] = mission_name
                    row['mission_name'] = mission_name
                    row['mission_memberships'] = [mission_name]
                    row['mission_names'] = [mission_name]
                    row['associations'] = [{'scope':'mission','mission':mission_name,'authority':'Mission /cot acquisition i635'}]
                    row['association_scope'] = 'mission'
                    row['mission_membership_authority_i635'] = 'GET /Marti/api/missions/{mission}/cot'
                stamped.append(row)
            return result, stamped
        globals()['_i599_project_cot'] = _i599_project_cot

    def _i635_authoritative_status(payload):
        status = {}
        mission_map_fn = globals().get('_i602_authoritative_mission_map')
        if callable(mission_map_fn):
            try:
                status = dict(mission_map_fn(payload) or {})
            except Exception:
                status = {}
        return status

    def _i635_normalize_server_authoritative(payload, sess=None):
        if not isinstance(payload, dict):
            return payload
        sess = _i635_session(sess)
        out = _i568_clone(payload) if '_i568_clone' in globals() else json.loads(json.dumps(payload, default=str))
        accessible = _i635_accessible_missions(out)
        saved = _i635_saved_for(sess)
        authoritative = _i635_authoritative_status(out)

        # Build association evidence from explicit current rows only. By this
        # point protected-Mission filtering has already removed locked content.
        evidence = {}
        for collection in ('objects','mission_uids','mission_content_mission','mission_content','packages'):
            for row in list(out.get(collection) or []):
                if not isinstance(row, dict):
                    continue
                ident, value, kind = _i635_identity(row)
                if not ident:
                    continue
                missions = _i635_mission_names(row)
                if accessible:
                    missions = [m for m in missions if m.casefold() in accessible]
                if missions:
                    evidence.setdefault(ident, set()).update(missions)

        merged = {}; order = []; quarantined = []; migrated_local = 0; backfilled = 0; duplicate_rows = 0
        persist = {}
        for index, raw in enumerate(list(out.get('objects') or [])):
            if not isinstance(raw, dict):
                continue
            row = dict(raw)
            ident, identity_value, identity_kind = _i635_identity(row)
            if not ident:
                quarantined.append({'index':index,'reason':'missing canonical UID/content identity','name':_i635_text(row.get('name') or row.get('callsign'))[:160]})
                continue
            missions = set(evidence.get(ident) or set())
            direct = _i635_mission_names(row)
            if accessible:
                direct = [m for m in direct if m.casefold() in accessible]
            missions.update(direct)

            old = dict(saved.get(ident) or {})
            # Persisted membership is a migration aid, never a security bypass.
            for mission in old.get('missions') or []:
                mission = _i635_text(mission)
                if mission and (not accessible or mission.casefold() in accessible):
                    missions.add(mission)
            local_data = bool(old.get('local_data'))
            if not missions and not local_data and _i635_legitimate_preexisting(row):
                local_data = True
                migrated_local += 1
            if missions and not direct:
                backfilled += 1
            if not missions and not local_data:
                quarantined.append({'identity':ident,'uid':_i635_uid(row),'reason':'unresolvable object after Mission/local association backfill','name':_i635_text(row.get('name') or row.get('callsign'))[:160]})
                continue

            mission_list = sorted(missions, key=str.casefold)
            associations = ([{'scope':'local_data','name':'Local Data','authority':'pre-existing association backfill i635'}] if local_data else [])
            associations += [{'scope':'mission','mission':m,'authority':'authoritative Mission membership i635'} for m in mission_list]
            delete_records = []
            uid = _i635_uid(row)
            for mission in mission_list:
                stat = authoritative.get(mission.casefold()) or {}
                delete_records.append({
                    'mission':mission, 'target':'uid' if uid else identity_kind,
                    'value':uid if uid else identity_value,
                    'authoritative':bool(stat.get('authoritative', True)),
                    'unlocked':bool(stat.get('unlocked', True)),
                })

            object_id = ''
            if uid:
                object_id = 'datasync-' + hashlib.sha256(('uid:' + uid).encode('utf-8','replace')).hexdigest()[:24]
                row['uid'] = uid; row['source_id'] = uid
            elif identity_kind == 'hash':
                object_id = 'datasync-' + hashlib.sha256(('hash:' + identity_value).encode('utf-8','replace')).hexdigest()[:24]
                row['source_id'] = identity_value
            if object_id:
                row['object_id'] = object_id; row['canonical_id'] = 'datasync:' + object_id; row['source_kind'] = 'datasync'
            row['mission_memberships'] = mission_list
            row['mission_names'] = mission_list
            row['local_data_association'] = bool(local_data)
            row['associations'] = associations
            row['association_scope'] = 'mission' if mission_list and not local_data else ('local_data+mission' if mission_list else 'local_data')
            row['server_authoritative_i635'] = True
            row['preexisting_migration_i635'] = bool(not direct and (missions or local_data))
            row['mission_delete_records_i635'] = delete_records
            # Keep legacy fields for UI compatibility. Multi-Mission deletion uses
            # mission_delete_records_i635 on the backend, not this single field.
            if mission_list and (uid or identity_value):
                row['mission_name'] = mission_list[0]
                row['mission'] = mission_list[0]
                row['mission_delete_target'] = 'uid' if uid else identity_kind
                row['mission_delete_value'] = uid if uid else identity_value
                row['delete_supported'] = True
                row.pop('delete_unavailable_reason', None)
            elif local_data:
                # Data Sync records classified as Local Data are visible but are
                # not falsely presented as Mission-deletable.
                row['mission_name'] = ''
                row['mission'] = ''
                row['mission_delete_target'] = ''
                row['mission_delete_value'] = ''
                row['delete_supported'] = False
                row['delete_unavailable_reason'] = 'Pre-existing object is associated with Local Data, not an OTS Mission.'

            if ident not in merged:
                merged[ident] = row; order.append(ident)
            else:
                duplicate_rows += 1
                cur = merged[ident]
                ms = set(cur.get('mission_memberships') or []); ms.update(mission_list)
                cur['mission_memberships'] = sorted(ms, key=str.casefold); cur['mission_names'] = list(cur['mission_memberships'])
                cur['local_data_association'] = bool(cur.get('local_data_association') or local_data)
                cur['associations'] = ([{'scope':'local_data','name':'Local Data','authority':'pre-existing association backfill i635'}] if cur.get('local_data_association') else []) + [{'scope':'mission','mission':m,'authority':'authoritative Mission membership i635'} for m in cur['mission_memberships']]
                cur['association_scope'] = 'local_data+mission' if cur.get('local_data_association') and cur['mission_memberships'] else ('mission' if cur['mission_memberships'] else 'local_data')
                existing = {(r.get('mission'),r.get('target'),r.get('value')) for r in cur.get('mission_delete_records_i635') or [] if isinstance(r,dict)}
                for rec in delete_records:
                    key = (rec.get('mission'),rec.get('target'),rec.get('value'))
                    if key not in existing:
                        cur.setdefault('mission_delete_records_i635',[]).append(rec); existing.add(key)
                if cur['mission_memberships']:
                    cur['mission_name'] = cur['mission_memberships'][0]; cur['mission'] = cur['mission_memberships'][0]
                    cur['delete_supported'] = True

            persist[ident] = {
                'uid': uid if identity_kind == 'uid' else '',
                'hash': identity_value if identity_kind == 'hash' else '',
                'missions': mission_list,
                'local_data': bool(local_data),
            }

        normalized_objects = [merged[key] for key in order]
        # Recompute aggregate delete records after UID merging so every canonical
        # object exposes one record per visible Mission membership.
        for row in normalized_objects:
            uid = _i635_uid(row); identity_value = uid or _i635_content_hash(row)
            records = []
            for mission in row.get('mission_memberships') or []:
                stat = authoritative.get(_i635_text(mission).casefold()) or {}
                records.append({'mission':mission,'target':'uid' if uid else 'hash','value':identity_value,
                                'authoritative':bool(stat.get('authoritative', True)),
                                'unlocked':bool(stat.get('unlocked', True))})
            row['mission_delete_records_i635'] = records
            if records:
                row['delete_supported'] = True
        out['objects'] = normalized_objects
        _i635_persist_batch(sess, persist)
        out['version'] = _I635_VERSION
        out['data_sync_association_i635'] = {
            'version':_I635_VERSION,
            'server_authoritative':True,
            'conflict_resolution':False,
            'association_invariant':'Local Data or one-or-more Missions',
            'authoritative_membership_stamped_at_cot_acquisition':True,
            'preexisting_non_destructive_backfill':True,
            'canonical_uid_many_to_many_missions':True,
            'visible_object_count':len(normalized_objects),
            'duplicate_rows_collapsed':duplicate_rows,
            'backfilled_membership_count':backfilled,
            'preexisting_local_data_count':migrated_local,
            'quarantined_unresolvable_count':len(quarantined),
            'quarantine_sample':quarantined[:40],
            'security_filter_before_backfill_and_merge':True,
            'persisted_per_user':bool(_i635_user_key(sess)),
        }
        return out

    # i634 wrapped the security projection and could discard rows before i635 had
    # a chance to backfill legacy association metadata. Bypass only that i634
    # normalization wrapper, retain the protected-Mission security filter below it,
    # then run i635 migration/canonicalization.
    _i635_security_base = globals().get('_i634_filter_before') or globals().get('_i594_filter_security_view')
    if callable(_i635_security_base):
        def _i594_filter_security_view(payload, state, sess=None):
            filtered, status = _i635_security_base(payload, state, sess)
            return _i635_normalize_server_authoritative(filtered, sess), status
        globals()['_i594_filter_security_view'] = _i594_filter_security_view
        globals()['_i591_filter_security_view'] = _i594_filter_security_view

    # Ensure object-delete lookup resolves the same canonical multi-Mission object
    # that the browser sees, rather than an arbitrary last duplicate UID row.
    if callable(globals().get('_tak_fresh_data_sync_result')):
        _i635_fresh_before = _tak_fresh_data_sync_result
        def _tak_fresh_data_sync_result():
            raw = _i635_fresh_before()
            sess = _i635_session()
            try:
                cfg = _i509_load_ots_config() if callable(globals().get('_i509_load_ots_config')) else {}
                key = _i568_state_key(cfg or {}, sess or {}) if callable(globals().get('_i568_state_key')) else ''
                state = _i568_state(key) if key and callable(globals().get('_i568_state')) else {}
                if callable(_i635_security_base):
                    raw, _ = _i635_security_base(raw, state, sess)
            except Exception:
                pass
            return _i635_normalize_server_authoritative(raw, sess)
        globals()['_tak_fresh_data_sync_result'] = _tak_fresh_data_sync_result

    # Multi-Mission canonical deletion. The inherited single-Mission primitive is
    # retained intact for token auth, persistent fences, terminal CoT, bounded
    # Mission /cot absence confirmation, marker cleanup, and server-side errors.
    _i635_delete_single_before = _tak_data_sync_delete_record
    def _tak_data_sync_delete_record(obj, server_host=''):
        obj = dict(obj or {}) if isinstance(obj, dict) else {}
        records = [dict(r) for r in (obj.get('mission_delete_records_i635') or []) if isinstance(r, dict)]
        if not records:
            missions = [_i635_text(m) for m in obj.get('mission_memberships') or [] if _i635_text(m)]
            target = _i635_text(obj.get('mission_delete_target'))
            value = _i635_text(obj.get('mission_delete_value')) or _i635_uid(obj) or _i635_content_hash(obj)
            records = [{'mission':m,'target':target or ('uid' if _i635_uid(obj) else 'hash'),'value':value} for m in missions]
        if len(records) <= 1:
            return _i635_delete_single_before(obj, server_host)

        seen = set(); per_mission = []; deleted_missions = []; failed_missions = []
        canonical = _i635_text(obj.get('canonical_id')) or (('datasync:' + _i635_text(obj.get('object_id'))) if obj.get('object_id') else '')
        for rec in records:
            mission = _i635_text(rec.get('mission')); target = _i635_text(rec.get('target'))
            value = _i635_text(rec.get('value'))
            key = (mission.casefold(), target, value)
            if not mission or target not in ('uid','hash') or not value or key in seen:
                continue
            seen.add(key)
            one = dict(obj)
            one['mission'] = mission; one['mission_name'] = mission
            one['mission_delete_target'] = target; one['mission_delete_value'] = value
            one['mission_memberships'] = [mission]; one['mission_names'] = [mission]
            one['mission_delete_records_i635'] = [dict(rec)]
            result = dict(_i635_delete_single_before(one, server_host) or {})
            result['mission'] = mission; result['target'] = target; result['value'] = value
            per_mission.append(result)
            if result.get('status') == 'deleted' and result.get('mission_absence_confirmed', True) is not False:
                deleted_missions.append(mission)
            else:
                failed_missions.append(mission)

        if not per_mission:
            return {'object_id':canonical,'status':'unsupported','version':_I635_VERSION,
                    'error':'No authoritative per-Mission deletion records are available.'}
        complete = bool(deleted_missions and not failed_missions and len(deleted_missions) == len(per_mission))
        reply = {
            'object_id':canonical,
            'status':'deleted' if complete else 'failed',
            'version':_I635_VERSION,
            'multi_mission_delete':True,
            'mission_count':len(per_mission),
            'deleted_missions':deleted_missions,
            'failed_missions':failed_missions,
            'per_mission_results':per_mission,
            'authoritative_readback_required':True,
            'partial':bool(deleted_missions and failed_missions),
        }
        if not complete:
            reply['error'] = ('Object was removed from ' + str(len(deleted_missions)) + ' Mission(s), but ' +
                              str(len(failed_missions)) + ' Mission removal(s) failed or could not be authoritatively confirmed. ' +
                              'TAK Maps will retain the object state that still exists on OTS.')
        return reply
    globals()['_tak_data_sync_delete_record'] = _tak_data_sync_delete_record

    # Surface migration/delete diagnostics and keep Local Data stamping for all
    # pre-existing imported/local objects without requiring a destructive rewrite.
    if callable(globals().get('tak_map_imported')):
        _i635_imported_before = tak_map_imported
        def tak_map_imported(*args, **kwargs):
            out = _i635_imported_before(*args, **kwargs)
            def stamp(value):
                if isinstance(value, list):
                    for item in value: stamp(item)
                elif isinstance(value, dict):
                    looks = any(k in value for k in ('kind','geometry','coords','lat','lon','uid','cot_type','object_id'))
                    if looks and not _i635_mission_names(value):
                        value['association_scope'] = 'local_data'
                        value['local_data_association'] = True
                        value['associations'] = [{'scope':'local_data','name':'Local Data','authority':'TAK Maps local object i635'}]
                    for key in ('features','points','routes','shapes','objects'):
                        if key in value: stamp(value.get(key))
            if isinstance(out, dict):
                stamp(out)
                out['local_data_association_i635'] = {'version':_I635_VERSION,'association':'Local Data','orphan_objects_allowed':False,'preexisting_safe':True}
            return out
        globals()['tak_map_imported'] = tak_map_imported

    _i635_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i635_config_before() or {})
        cfg['version'] = _I635_PACKAGE_VERSION; cfg['tak_map_iteration'] = _I635_VERSION
        cfg['server_authoritative_data_sync_i635'] = {
            'version':_I635_VERSION,
            'conflict_resolution':False,
            'association_invariant':'Local Data or Mission',
            'mission_cot_acquisition_stamps_membership':True,
            'preexisting_non_destructive_backfill':True,
            'backfill_persisted_per_user':True,
            'canonical_uid_many_to_many_missions':True,
            'multi_mission_delete':True,
            'per_mission_authoritative_absence_confirmation':True,
            'partial_delete_preserves_remaining_server_state':True,
            'protected_mission_filter_precedes_merge':True,
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _i635_get_before = Handler.do_GET
    def _i635_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/assets/runtime/tak-map-i635.js':
            try: body = (_I635_ROOT/'assets'/'tak-map-i635.js').read_bytes()
            except Exception: return self.send_error(404)
            self.send_response(200); self.send_header('Content-Type','application/javascript; charset=utf-8'); self.send_header('Cache-Control','no-store, max-age=0'); self.send_header('X-TAK-Map-Module',_I635_VERSION); self.send_header('Content-Length',str(len(body))); self.end_headers()
            if getattr(self,'command','GET') != 'HEAD': self.wfile.write(body)
            return
        return _i635_get_before(self)
    Handler.do_GET = _i635_do_get

    _I635_LOADER = '<script id="takMapI635Loader" src="/assets/runtime/tak-map-i635.js?v=1.4.0-i635"></script>'
    def _i635_patch_html(html, include_loader=True):
        html = str(html or '')
        html = re.sub(r'<script[^>]*id=["\']takMapI634Loader["\'][^>]*></script>\s*','',html,flags=re.I)
        html = re.sub(r'<script[^>]*id=["\']takMapI635Loader["\'][^>]*></script>\s*','',html,flags=re.I)
        if include_loader:
            if '<head>' in html: html = html.replace('<head>','<head>'+_I635_LOADER,1)
            else: html = _I635_LOADER + html
        html = html.replace('1.4.0-i634', _I635_PACKAGE_VERSION)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i635\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i635\2', html)
        html = re.sub(r"(const\s+V\s*=\s*['\"])i634(['\"])", r'\1i635\2', html)
        html = re.sub(r"(ITERATION\s*=\s*['\"])i634(['\"])", r'\1i635\2', html)
        return html
    TAK_MAP_HTML = _i635_patch_html(TAK_MAP_HTML, include_loader=True); INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i635_patch_html(TAK_MAP_LOGIN_HTML, include_loader=False); LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I635_VERSION
except Exception as _i635_exc:
    try: print('TAK Map i635 Mission association migration/multi-delete patch failed:', _i635_exc)
    except Exception: pass
# --- end TAK Map i635 ---

# --- TAK Map i636 canonical TAK shape codec + Mission-only server invariant ---
try:
    import html as _i636_html

    _I636_VERSION = 'i636'
    _I636_PACKAGE_VERSION = '1.4.0-i636'
    _I636_ROOT = Path(__file__).resolve().parent
    _I636_NATIVE_SHAPE_TYPES = {
        'u-d-r':'rectangle',
        'u-d-p':'polygon',
        'u-d-f':'freeform',
        'u-d-f-m':'telestration',
        'u-d-c-c':'circle',
        'u-d-c-e':'ellipse',
        'u-d-v':'vehicle_shape',
        'u-d-v-m':'vehicle_shape_model',
        'u-r-b-c-c':'range_circle',
        'u-r-b-bullseye':'bullseye',
    }

    def _i636_text(value):
        try: return str(value if value is not None else '').strip()
        except Exception: return ''

    def _i636_local_name(tag):
        return _i636_text(tag).rsplit('}', 1)[-1].lower()

    def _i636_float(value, default=None):
        try:
            n=float(value)
            return n if math.isfinite(n) else default
        except Exception:
            return default

    def _i636_int(value, default=None):
        try: return int(str(value).strip(), 0)
        except Exception:
            try: return int(float(value))
            except Exception: return default

    def _i636_argb(value, default='#ffb000', default_alpha=1.0):
        n=_i636_int(value, None)
        if n is None:
            return {'css':default,'alpha':float(default_alpha),'argb':None,'unsigned':None}
        u=n & 0xffffffff
        a=(u >> 24) & 255; r=(u >> 16) & 255; g=(u >> 8) & 255; b=u & 255
        return {'css':f'#{r:02x}{g:02x}{b:02x}','alpha':a/255.0,'argb':str(n),'unsigned':u}

    def _i636_argb_to_kml_abgr(value, fallback='ffffffff'):
        c=_i636_argb(value, '#ffffff', 1.0)
        if c.get('unsigned') is None:
            try: return str(fallback).lower()
            except Exception: return 'ffffffff'
        u=c['unsigned']; a=(u>>24)&255; r=(u>>16)&255; g=(u>>8)&255; b=u&255
        return f'{a:02x}{b:02x}{g:02x}{r:02x}'

    def _i636_point_attr(value):
        text=_i636_text(value)
        if not text: return None
        bits=[x.strip() for x in text.split(',')]
        if len(bits)<2: return None
        lat=_i636_float(bits[0]); lon=_i636_float(bits[1])
        if lat is None or lon is None or not (-90<=lat<=90 and -180<=lon<=180): return None
        return [lat,lon]

    def _i636_same_point(a,b,eps=1e-9):
        try: return abs(float(a[0])-float(b[0]))<=eps and abs(float(a[1])-float(b[1]))<=eps
        except Exception: return False

    def _i636_clean_vertices(points, strip_closing=True):
        out=[]
        for p in points or []:
            try:
                lat=float(p[0]); lon=float(p[1])
                if not (math.isfinite(lat) and math.isfinite(lon) and -90<=lat<=90 and -180<=lon<=180): continue
                q=[lat,lon]
                if not out or not _i636_same_point(out[-1],q): out.append(q)
            except Exception: pass
        if strip_closing and len(out)>2 and _i636_same_point(out[0],out[-1]): out=out[:-1]
        return out

    def _i636_find_first(root, name):
        wanted=_i636_text(name).lower()
        if root is None: return None
        for node in root.iter():
            if _i636_local_name(node.tag)==wanted: return node
        return None

    def _i636_attr_value(root, name, attr='value'):
        node=_i636_find_first(root,name)
        return _i636_text(node.attrib.get(attr)) if node is not None else ''

    def _i636_event_center(root,event=None):
        if root is not None:
            node=_i636_find_first(root,'point')
            if node is not None:
                lat=_i636_float(node.attrib.get('lat')); lon=_i636_float(node.attrib.get('lon'))
                if lat is not None and lon is not None: return [lat,lon]
        if isinstance(event,dict):
            lat=_i636_float(event.get('lat')); lon=_i636_float(event.get('lon'))
            if lat is not None and lon is not None: return [lat,lon]
        return None

    def _i636_link_vertices(root):
        pts=[]
        if root is None: return pts
        for node in root.iter():
            if _i636_local_name(node.tag)!='link': continue
            p=_i636_point_attr(node.attrib.get('point'))
            if p: pts.append(p)
        return pts

    def _i636_embedded_telestration_vertices(root):
        if root is None: return []
        for node in root.iter():
            if _i636_local_name(node.tag)!='link': continue
            raw=_i636_text(node.attrib.get('line'))
            if not raw: continue
            for candidate in (raw,_i636_html.unescape(raw)):
                try:
                    embedded=ET.fromstring(candidate.encode('utf-8'))
                    pts=_i636_link_vertices(embedded)
                    if pts: return pts
                except Exception: pass
        return []

    def _i636_legacy_vertices(root):
        # TAK Maps v345 and earlier stored duplicate __shape/shape polyline
        # containers with <vertex lat= lon=> children plus a GeoJSON copy. Keep
        # reading both forms indefinitely; never rewrite them merely on load.
        pts=[]
        if root is None: return pts
        for node in root.iter():
            if _i636_local_name(node.tag)!='vertex': continue
            lat=_i636_float(node.attrib.get('lat')); lon=_i636_float(node.attrib.get('lon'))
            if lat is not None and lon is not None and -90<=lat<=90 and -180<=lon<=180:
                pts.append([lat,lon])
        if pts: return pts
        tm=_i636_find_first(root,'takmap_shape')
        if tm is not None and _i636_text(tm.text):
            try:
                gj=json.loads(_i636_text(tm.text))
                coords=((gj.get('geometry') or {}).get('coordinates') if isinstance(gj,dict) else None)
                flat=[]
                def walk(x):
                    if isinstance(x,(list,tuple)) and len(x)>=2 and isinstance(x[0],(int,float)) and isinstance(x[1],(int,float)):
                        lon=float(x[0]); lat=float(x[1])
                        if -90<=lat<=90 and -180<=lon<=180: flat.append([lat,lon])
                    elif isinstance(x,(list,tuple)):
                        for y in x: walk(y)
                walk(coords)
                if flat: return flat
            except Exception: pass
        return []

    def _i636_legacy_shape_kind(root, fallback=''):
        if root is None: return fallback
        for node in root.iter():
            if _i636_local_name(node.tag) in ('__shape','shape','takmap_shape'):
                value=_i636_text(node.attrib.get('type')).lower()
                if value in ('rectangle','square','polygon','freehand','circle','ellipse'):
                    return 'rectangle' if value=='square' else ('freeform' if value=='freehand' else value)
        return fallback

    def _i636_ellipse_coords(center, major_m, minor_m, angle_deg=0.0, samples=72):
        if not center or major_m is None or minor_m is None or major_m<=0 or minor_m<=0: return []
        lat0=float(center[0]); lon0=float(center[1]); R=6378137.0
        # ATAK shape ellipse values are distances in meters.  For display, build a
        # tangent-plane approximation; raw CoT is retained so read-only load never
        # rewrites the authoritative representation.
        rotation=math.radians(float(angle_deg or 0.0) if abs(float(angle_deg or 0.0))<359.999 else 0.0)
        coslat=max(1e-6, math.cos(math.radians(lat0)))
        pts=[]
        for i in range(max(24,int(samples))):
            t=2.0*math.pi*i/max(24,int(samples))
            x=float(major_m)*math.cos(t); y=float(minor_m)*math.sin(t)
            xr=x*math.cos(rotation)-y*math.sin(rotation)
            yr=x*math.sin(rotation)+y*math.cos(rotation)
            lat=lat0 + math.degrees(yr/R)
            lon=lon0 + math.degrees(xr/(R*coslat))
            pts.append([lat,lon])
        return pts

    def _i636_shape_style(root):
        stroke_raw=_i636_attr_value(root,'strokeColor') or _i636_attr_value(root,'color')
        fill_raw=_i636_attr_value(root,'fillColor')
        stroke=_i636_argb(stroke_raw,'#ffb000',1.0)
        fill=_i636_argb(fill_raw,'#ffb000',0.18)
        weight=_i636_float(_i636_attr_value(root,'strokeWeight'),2.0)
        line=_i636_attr_value(root,'strokeStyle').lower() or 'solid'
        return {
            'stroke_argb':stroke.get('argb') or stroke_raw,
            'fill_argb':fill.get('argb') or fill_raw,
            'stroke_css':stroke['css'],
            'stroke_opacity':stroke['alpha'],
            'fill_css':fill['css'],
            'fill_opacity':fill['alpha'] if fill_raw else 0.18,
            'weight':max(0.5,min(12.0,float(weight or 2.0))),
            'line_style':'dashed' if line in ('dash','dashed','dot','dotted') else 'solid',
        }

    def _i636_preserved_detail(root):
        if root is None: return {}
        detail=_i636_find_first(root,'detail')
        if detail is None: return {}
        out={}
        for key in ('remarks','archive','__shapeExtras','labels_on','creator','precisionlocation','contact','strokeColor','strokeWeight','strokeStyle','fillColor','color'):
            for node in list(detail):
                if _i636_local_name(node.tag)==key.lower():
                    out[key]={'attributes':dict(node.attrib or {}),'text':_i636_text(node.text)}
                    break
        return out

    def _i636_parse_tak_shape_event(event, mission=''):
        if not isinstance(event,dict): return None
        cot_type=_i636_text(event.get('cot_type') or event.get('type') or event.get('event_type')).lower()
        if cot_type not in _I636_NATIVE_SHAPE_TYPES and not cot_type.startswith('u-d-') and not cot_type.startswith('u-r-b-'):
            return None
        raw=_i636_text(event.get('mission_cot_xml') or event.get('cot_xml') or event.get('xml'))
        root=None
        if raw:
            try: root=ET.fromstring(raw.encode('utf-8'))
            except Exception: root=None
        if root is None: return None
        uid=_i636_text(root.attrib.get('uid') or event.get('uid'))
        if not uid: return None
        name=_i636_text(event.get('callsign'))
        contact=_i636_find_first(root,'contact')
        if contact is not None and _i636_text(contact.attrib.get('callsign')): name=_i636_text(contact.attrib.get('callsign'))
        if not name: name=uid
        shape_kind=_I636_NATIVE_SHAPE_TYPES.get(cot_type,'tak_shape')
        raw_links=_i636_link_vertices(root)
        if cot_type=='u-d-f-m' and not raw_links: raw_links=_i636_embedded_telestration_vertices(root)
        if not raw_links:
            raw_links=_i636_legacy_vertices(root)
            shape_kind=_i636_legacy_shape_kind(root,shape_kind)
        elif cot_type=='u-d-f':
            # v345 used u-d-f for all TAK Maps shapes; retain its semantic type
            # from __shape/takmap_shape metadata when present.
            shape_kind=_i636_legacy_shape_kind(root,shape_kind)
        was_closed=bool(len(raw_links)>=3 and _i636_same_point(raw_links[0],raw_links[-1]))
        vertices=_i636_clean_vertices(raw_links,True)
        center=_i636_event_center(root,event)
        ellipse=_i636_find_first(root,'ellipse')
        major=minor=angle=None
        if ellipse is not None:
            major=_i636_float(ellipse.attrib.get('major')); minor=_i636_float(ellipse.attrib.get('minor')); angle=_i636_float(ellipse.attrib.get('angle'),0.0)
            if major is not None and minor is None: minor=major
            if minor is not None and major is None: major=minor
        closed = cot_type in ('u-d-r','u-d-p','u-d-c-c','u-d-c-e','u-r-b-c-c','u-r-b-bullseye','u-d-v','u-d-v-m') or was_closed
        if cot_type in ('u-d-c-c','u-d-c-e','u-r-b-c-c','u-r-b-bullseye') and center and major and minor:
            vertices=_i636_ellipse_coords(center,major,minor,angle or 0.0,72)
            closed=True
        if cot_type=='u-d-r' and len(vertices)==5 and _i636_same_point(vertices[0],vertices[-1]): vertices=vertices[:-1]
        # Native rectangles should be four unique vertices. Tolerate legacy/non-
        # canonical payloads for rendering instead of silently rewriting them.
        geometry_ok = len(vertices)>=2 if not closed else len(vertices)>=3
        style=_i636_shape_style(root)
        remarks_node=_i636_find_first(root,'remarks')
        labels_node=_i636_find_first(root,'labels_on')
        creator_node=_i636_find_first(root,'creator')
        out=dict(event)
        out.update({
            'uid':uid,'id':uid,'source_id':uid,
            'type':cot_type,'cot_type':cot_type,'event_type':cot_type,'atak_cot_type':cot_type,
            'name':name,'callsign':name,
            'mission':_i636_text(mission or event.get('mission') or event.get('mission_name')),
            'mission_name':_i636_text(mission or event.get('mission_name') or event.get('mission')),
            'geometry':'shape','kind':'shape','source':'OpenTAKServer Mission /cot TAK shape i636',
            'is_mission_object':True,'cot_xml_projected_i598':True,'tak_shape_i636':True,
            'shape_kind_i636':shape_kind,'shape_closed_i636':bool(closed),'shape_geometry_valid_i636':bool(geometry_ok),
            'coords':vertices,
            'lat':center[0] if center else (sum(p[0] for p in vertices)/len(vertices) if vertices else event.get('lat')),
            'lon':center[1] if center else (sum(p[1] for p in vertices)/len(vertices) if vertices else event.get('lon')),
            'color':style['stroke_css'],'fill_color':style['fill_css'],'fill_opacity':style['fill_opacity'],
            'opacity':style['stroke_opacity'],'weight':style['weight'],'line_style':style['line_style'],'strokeStyle':style['line_style'],
            'style_i636':style,'raw_cot_i636':raw,'raw_cot_preserved_i636':True,
            'preserved_detail_i636':_i636_preserved_detail(root),
            'remarks':_i636_text(remarks_node.text) if remarks_node is not None else _i636_text(event.get('remarks')),
            'labels_on_i636':_i636_text(labels_node.attrib.get('value')).lower()=='true' if labels_node is not None else None,
            'creator_i636':dict(creator_node.attrib or {}) if creator_node is not None else {},
            'legacy_closed_link_i636':bool(was_closed),
            'canonical_link_count_i636':len(vertices),
            'major_m_i636':major,'minor_m_i636':minor,'angle_deg_i636':angle,
        })
        return out

    # Mission /cot is authoritative. Parse TAK shape types before any generic link-
    # based route inference and replace any legacy projection of the same UID.
    _i636_mission_objects_before = _i512_mission_api_objects
    def _i512_mission_api_objects(value, mission):
        rows=list(_i636_mission_objects_before(value,mission) or [])
        if not _i598_event_xml(value): return rows
        try: events=_i545_extract_events(None,value)
        except Exception: events={}
        for event in dict(events or {}).values():
            shape=_i636_parse_tak_shape_event(event,mission)
            if not isinstance(shape,dict): continue
            uid=_i636_text(shape.get('uid')).casefold()
            if uid:
                rows=[r for r in rows if not (isinstance(r,dict) and _i636_text(r.get('uid') or r.get('event_uid') or r.get('cot_uid')).casefold()==uid)]
            rows.append(shape)
        return rows
    globals()['_i512_mission_api_objects']=_i512_mission_api_objects

    def _i636_shape_type_for_feature(f):
        props=(f or {}).get('properties') if isinstance((f or {}).get('properties'),dict) else {}
        blob=' '.join(_i636_text(x) for x in (props.get('shape_type'),props.get('type'),(f or {}).get('shape_type'),(f or {}).get('geometry'),(f or {}).get('name'))).lower()
        if 'rect' in blob or 'square' in blob: return 'rectangle','u-d-r'
        if 'circle' in blob: return 'circle','u-d-c-c'
        if 'ellipse' in blob: return 'ellipse','u-d-c-e'
        if 'freehand' in blob: return 'freeform','u-d-f'
        if 'telestrat' in blob: return 'telestration','u-d-f-m'
        return 'polygon','u-d-p'
    _v346_shape_type_for_feature=_i636_shape_type_for_feature
    globals()['_v346_shape_type_for_feature']=_v346_shape_type_for_feature

    def _i636_feature_vertices(f):
        pts=[]
        for p in (_local_data_feature_points(f) or []):
            try: pts.append([float(p[0]),float(p[1])])
            except Exception: pass
        return _i636_clean_vertices(pts,True)

    def _i636_center(vertices,f=None):
        # For canonical output use the actual geometry center. Older TAK Maps files
        # can carry a stale representative point after editing.
        if vertices:
            return sum(p[0] for p in vertices)/len(vertices),sum(p[1] for p in vertices)/len(vertices)
        try:
            return float((f or {}).get('lat')),float((f or {}).get('lon'))
        except Exception: return 0.0,0.0

    def _i636_meter_axes(vertices,center):
        if not vertices or not center: return 0.0,0.0
        R=6378137.0; lat0,lon0=center; coslat=max(1e-6,math.cos(math.radians(lat0)))
        xs=[]; ys=[]
        for lat,lon in vertices:
            xs.append(math.radians(lon-lon0)*R*coslat); ys.append(math.radians(lat-lat0)*R)
        if not xs: return 0.0,0.0
        return max(abs(x) for x in xs),max(abs(y) for y in ys)

    def _i636_add_common_shape_detail(detail,name,style,creator_uid,creator_callsign,now,remarks=''):
        ET.SubElement(detail,'__shapeExtras',{'cpvis':'true','editable':'true'})
        ET.SubElement(detail,'remarks').text=_i636_text(remarks)[:3000]
        ET.SubElement(detail,'archive')
        ET.SubElement(detail,'strokeColor',{'value':str(style.get('stroke_argb') or -37074)})
        ET.SubElement(detail,'strokeWeight',{'value':str(style.get('weight') or '3.0')})
        ET.SubElement(detail,'strokeStyle',{'value':'dashed' if _i636_text(style.get('line_style')).lower()=='dashed' else 'solid'})
        ET.SubElement(detail,'fillColor',{'value':str(style.get('fill_argb') or 1090518784)})
        ET.SubElement(detail,'color',{'value':str(style.get('stroke_argb') or -37074)})
        if creator_uid:
            ET.SubElement(detail,'creator',{'uid':str(creator_uid),'callsign':str(creator_callsign or 'takmap'),'time':_cot_time(now),'type':'a-f-G-U-C-R-V-G'})
        ET.SubElement(detail,'labels_on',{'value':'false'})
        ET.SubElement(detail,'precisionlocation',{'altsrc':'TAK Map'})
        ET.SubElement(detail,'contact',{'callsign':name})

    def _i636_add_kml_style(shape_node,shape_uid,style):
        link=ET.SubElement(shape_node,'link',{'uid':shape_uid+'.Style','type':'b-x-KmlStyle','relation':'p-c'})
        st=ET.SubElement(link,'Style'); ls=ET.SubElement(st,'LineStyle')
        ET.SubElement(ls,'color').text=_i636_argb_to_kml_abgr(style.get('stroke_argb'),'ffffffff')
        ET.SubElement(ls,'width').text=str(style.get('weight') or '3.0')
        ps=ET.SubElement(st,'PolyStyle')
        ET.SubElement(ps,'color').text=_i636_argb_to_kml_abgr(style.get('fill_argb'),'00ffffff')

    def _v346_shape_cot_event_for_feature(f, idx=0, package_uid='', creator_uid='', creator_callsign='takmap'):
        vertices=_i636_feature_vertices(f)
        shape_type,cot_type=_i636_shape_type_for_feature(f)
        minimum=2 if shape_type in ('freeform','telestration') else 3
        if len(vertices)<minimum:
            return {'ok':False,'error':'Shape does not contain enough unique points.','events':[],'shape_uid':''}
        if shape_type=='rectangle' and len(vertices)!=4:
            return {'ok':False,'error':'Rectangle requires exactly four unique corners for canonical TAK u-d-r output.','events':[],'shape_uid':''}
        if not package_uid:
            package_uid='takmap-shape-i636-'+hashlib.sha1((json.dumps(json_safe(f),sort_keys=True)[:4096]+str(idx)).encode('utf-8','ignore')).hexdigest()[:16]
        shape_uid=_v346_feature_uid(f,idx,package_uid)
        name=_v331_name_from_feature(f,'Shape') if callable(globals().get('_v331_name_from_feature')) else 'Shape'
        style=_v345_shape_style(f) if callable(globals().get('_v345_shape_style')) else {'stroke_argb':str(-37074),'fill_argb':str(1090518784),'weight':'3.0','line_style':'solid'}
        center=_i636_center(vertices,f); now=datetime.now(timezone.utc); stale=now+timedelta(days=1)
        event=ET.Element('event',{'version':'2.0','uid':shape_uid,'type':cot_type,'time':_cot_time(now),'start':_cot_time(now),'stale':_cot_time(stale),'how':'h-e','access':'Undefined'})
        ET.SubElement(event,'point',{'lat':f'{center[0]:.7f}','lon':f'{center[1]:.7f}','hae':'0','ce':'9999999.0','le':'9999999.0'})
        detail=ET.SubElement(event,'detail')
        if shape_type in ('circle','ellipse'):
            rx,ry=_i636_meter_axes(vertices,center)
            if shape_type=='circle':
                radius=(rx+ry)/2.0 if rx and ry else max(rx,ry)
                major=minor=max(0.01,radius)
            else:
                major=max(0.01,rx); minor=max(0.01,ry)
            shape_node=ET.SubElement(detail,'shape')
            ET.SubElement(shape_node,'ellipse',{'major':f'{major:.3f}','minor':f'{minor:.3f}','angle':'360.0'})
            _i636_add_kml_style(shape_node,shape_uid,style)
        else:
            # Canonical TAK rectangles/polygons are implicitly closed. Do not add
            # a duplicate first vertex as the final <link point>.
            for p in vertices:
                ET.SubElement(detail,'link',{'point':f'{p[0]:.7f},{p[1]:.7f},0.0'})
        remarks=_v331_remarks_from_feature(f) if callable(globals().get('_v331_remarks_from_feature')) else ''
        _i636_add_common_shape_detail(detail,name,style,creator_uid,creator_callsign,now,remarks)
        xml='<?xml version="1.0" encoding="UTF-8"?>\n'+ET.tostring(event,encoding='unicode',short_empty_elements=True)
        return {'ok':True,'name':name,'shape_uid':shape_uid,'events':[{'uid':shape_uid,'kind':'shape','xml':xml}],
                'associate_uids':[shape_uid],'point_count':len(vertices),'shape_type':shape_type,'cot_type':cot_type,'style':style,
                'canonical_tak_shape_i636':True,'raw_legacy_rewrite':False}
    globals()['_v346_shape_cot_event_for_feature']=_v346_shape_cot_event_for_feature

    # i563 considered a UID active when a historical mission_uids row existed with
    # mission_name=NULL. For a Mission-specific verification, only an exact active
    # Mission name match is authoritative.
    _i636_snapshot_before=globals().get('_i563_snapshot_before') or globals().get('_tak_data_sync_raw_snapshot')
    def _i636_raw_active(uid,mission=''):
        uid_fold=_i636_text(uid).casefold(); mission_fold=_i636_text(mission).casefold()
        if not uid_fold: return False
        try:
            if '_I547_REQUEST_CONTEXT' in globals():
                _I547_REQUEST_CONTEXT.force=True; _I547_REQUEST_CONTEXT.reason='i636-exact-mission-membership-check'
            raw=dict(_i636_snapshot_before() or {}) if callable(_i636_snapshot_before) else {}
        finally:
            if '_I547_REQUEST_CONTEXT' in globals():
                _I547_REQUEST_CONTEXT.force=False; _I547_REQUEST_CONTEXT.reason=''
        for row in raw.get('objects') or []:
            if not isinstance(row,dict) or (callable(globals().get('_i563_delete_event')) and _i563_delete_event(row)): continue
            if _i555_object_uid(row).casefold()!=uid_fold: continue
            row_mission=_i555_object_mission(row).casefold()
            if mission_fold:
                if row_mission==mission_fold: return True
                continue
            if row_mission: return True
        for row in raw.get('mission_uids') or []:
            if not isinstance(row,dict): continue
            candidate=_i636_text(_i555_ci_value(row,('event_uid','cot_uid','uid','data_uid'))).casefold()
            if candidate!=uid_fold: continue
            row_mission=_i636_text(_i555_ci_value(row,('mission_name','missionName','mission'))).casefold()
            if mission_fold:
                if row_mission==mission_fold: return True
                continue
            if row_mission: return True
        return False
    _i563_raw_active=_i636_raw_active
    globals()['_i563_raw_active']=_i563_raw_active

    # Enforce the current server invariant at the Data Sync projection boundary:
    # user map objects obtained from OTS are visible only when associated with an
    # accessible Mission. Device/client Local Data remains a separate feature and
    # is not altered here. No destructive DB action is performed by this filter.
    _i636_normalize_before=_i635_normalize_server_authoritative
    def _i635_normalize_server_authoritative(payload,sess=None):
        out=dict(_i636_normalize_before(payload,sess) or {})
        kept=[]; hidden=[]
        for row in out.get('objects') or []:
            if not isinstance(row,dict): continue
            missions=[_i636_text(x) for x in (row.get('mission_memberships') or row.get('mission_names') or []) if _i636_text(x)]
            if missions:
                row['local_data_association']=False
                row['association_scope']='mission'
                row['associations']=[{'scope':'mission','mission':m,'authority':'authoritative Mission membership i636'} for m in missions]
                kept.append(row)
            else:
                hidden.append({'uid':_i636_text(row.get('uid') or row.get('source_id')),'name':_i636_text(row.get('callsign') or row.get('name')),'reason':'server-backed user object has no active Mission association'})
        out['objects']=kept
        out['version']=_I636_VERSION
        out['data_sync_association_i636']={
            'version':_I636_VERSION,'server_authoritative':True,'conflict_resolution':False,
            'association_invariant':'server-backed user map object requires one-or-more Missions; Local Data is client/device-local',
            'visible_object_count':len(kept),'server_orphans_hidden':len(hidden),'orphan_sample':hidden[:40],
            'destructive_cleanup_performed':False,'ots_final_membership_delete_expected':True,
        }
        return out
    globals()['_i635_normalize_server_authoritative']=_i635_normalize_server_authoritative

    _i636_config_before=tak_map_config
    def tak_map_config():
        cfg=dict(_i636_config_before() or {})
        cfg['version']=_I636_PACKAGE_VERSION; cfg['tak_map_iteration']=_I636_VERSION
        cfg['tak_shape_compat_i636']={
            'version':_I636_VERSION,'canonical_tak_wire_format':True,'type_dispatch_before_link_fallback':True,
            'rectangle':'u-d-r / four unique corners','polygon':'u-d-p / implicitly closed','freeform':'u-d-f',
            'circle':'u-d-c-c / native ellipse geometry','ellipse':'u-d-c-e / native ellipse geometry',
            'telestration_read':'u-d-f-m','legacy_closed_ring_read':True,'raw_cot_preserved_on_read':True,
            'unknown_valid_detail_preserved_in_raw_cot':True,'no_rewrite_on_read':True,
            'style_round_trip_fields':['strokeColor','strokeWeight','strokeStyle','fillColor','labels_on','__shapeExtras','remarks','archive','creator','precisionlocation'],
            'shape_delete_requires_marker_row':False,
        }
        cfg['server_authoritative_data_sync_i636']={
            'version':_I636_VERSION,'association_invariant':'Mission-only for server-backed user map objects',
            'local_data_scope':'client/device-local only','exact_mission_delete_verification':True,
            'null_mission_history_counts_as_active':False,'ots_final_membership_delete_patch_compatible':True,
        }
        return cfg
    globals()['tak_map_config']=tak_map_config

    _i636_get_before=Handler.do_GET
    def _i636_do_get(self):
        parsed=urlparse(self.path)
        if parsed.path=='/assets/runtime/tak-map-i636.js':
            try: body=(_I636_ROOT/'assets'/'tak-map-i636.js').read_bytes()
            except Exception: return self.send_error(404)
            self.send_response(200); self.send_header('Content-Type','application/javascript; charset=utf-8'); self.send_header('Cache-Control','no-store, max-age=0'); self.send_header('X-TAK-Map-Module',_I636_VERSION); self.send_header('Content-Length',str(len(body))); self.end_headers()
            if getattr(self,'command','GET')!='HEAD': self.wfile.write(body)
            return
        return _i636_get_before(self)
    Handler.do_GET=_i636_do_get

    _I636_LOADER='<script id="takMapI636Loader" src="/assets/runtime/tak-map-i636.js?v=1.4.0-i636"></script>'
    def _i636_patch_html(html,include_loader=True):
        html=str(html or '')
        html=re.sub(r'<script[^>]*id=["\']takMapI635Loader["\'][^>]*></script>\s*','',html,flags=re.I)
        html=re.sub(r'<script[^>]*id=["\']takMapI636Loader["\'][^>]*></script>\s*','',html,flags=re.I)
        if include_loader:
            html=html.replace('<head>','<head>'+_I636_LOADER,1) if '<head>' in html else _I636_LOADER+html
        html=html.replace('1.4.0-i635',_I636_PACKAGE_VERSION)
        html=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i636\2',html)
        html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i636\2',html)
        html=re.sub(r"(const\s+V\s*=\s*['\"])(?:i|v)635(['\"])",r'\1i636\2',html)
        html=re.sub(r"(ITERATION\s*=\s*['\"])(?:i|v)635(['\"])",r'\1i636\2',html)
        return html
    TAK_MAP_HTML=_i636_patch_html(TAK_MAP_HTML,True); INDEX_HTML=TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML=_i636_patch_html(TAK_MAP_LOGIN_HTML,False); LOGIN_HTML=TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION=_I636_VERSION
except Exception as _i636_exc:
    try: print('TAK Map i636 canonical TAK shape codec patch failed:',_i636_exc)
    except Exception: pass
# --- end TAK Map i636 ---



