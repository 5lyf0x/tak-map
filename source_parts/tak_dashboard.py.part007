# --- TAK Map i576 authoritative protected-Mission row state and post-unlock enrichment ---
try:
    _I576_ROOT = Path(__file__).resolve().parent

    def _i576_truthy(value):
        if value is True or value == 1:
            return True
        return _i568_text(value).casefold() in ('1', 'true', 'yes', 'on')

    def _i576_access_status(mission, sess=None, protected_hint=None):
        mission = _i568_text(mission)
        sess = sess if isinstance(sess, dict) else _i572_session()
        cached = _i572_protected_status(mission, sess)
        stored = _i572_load_password(mission, sess)
        hint_known = protected_hint is not None
        protected = bool(_i576_truthy(protected_hint) or cached.get('protected') or stored.get('ok'))
        known = bool(hint_known or cached.get('known') or stored.get('configured') or stored.get('ok'))
        if protected:
            _i572_set_protected(mission, True, sess)
        unlocked = bool((not protected) or stored.get('ok'))
        return {
            'ok': True,
            'version': 'i576',
            'mission': mission,
            'protected': protected,
            'password_protected': protected,
            'known': known,
            'unlocked': unlocked,
            'locked': bool(protected and not unlocked),
            'password_stored_server_side': bool(protected and stored.get('ok')),
            'credential_configured': bool(stored.get('ok')),
            'management_mode': 'authoritative-mission-row-i576',
            'stable_user_scope': True,
        }

    def _i576_access_rows(mission_rows, sess=None):
        sess = sess if isinstance(sess, dict) else _i572_session()
        out, seen = [], set()
        for row in list(mission_rows or []):
            if isinstance(row, str):
                mission = _i568_text(row)
                hint = None
            elif isinstance(row, dict):
                mission = _i568_text(row.get('name') or row.get('mission_name') or row.get('missionName') or row.get('uid'))
                if 'passwordProtected' in row:
                    hint = row.get('passwordProtected')
                elif 'password_protected' in row:
                    hint = row.get('password_protected')
                else:
                    hint = None
            else:
                mission = ''
                hint = None
            folded = mission.casefold()
            if not mission or folded in seen:
                continue
            seen.add(folded)
            out.append(_i576_access_status(mission, sess, hint))
        return out

    # Preserve the raw discovery row's passwordProtected flag in the exact user
    # scope used by the worker. Earlier wrappers consulted thread-local request
    # state from a background thread, which could lose this flag before the
    # browser rendered the Mission row.
    _i576_snapshot_before = _i568_build_snapshot
    def _i568_build_snapshot(cfg, sess, token, reason):
        result, acquired = _i576_snapshot_before(cfg, sess, token, reason)
        if isinstance(result, dict):
            result = _i568_clone(result)
            result['version'] = 'i576'
            result['mission_access_i576'] = _i576_access_rows((acquired or {}).get('mission_rows') or [], sess)
            result['protected_mission_row_i576'] = {
                'version': 'i576',
                'raw_discovery_access_state': True,
                'authenticated_worker_session': True,
            }
        return result, acquired
    globals()['_i568_build_snapshot'] = _i568_build_snapshot

    _i576_enriched_before = _i570_build_from_acquired
    def _i570_build_from_acquired(cfg, sess, acquired, previous=None, phase='enrichment'):
        result = _i576_enriched_before(cfg, sess, acquired, previous=previous, phase=phase)
        if isinstance(result, dict):
            result = _i568_clone(result)
            result['version'] = 'i576'
            result['mission_access_i576'] = _i576_access_rows((acquired or {}).get('mission_rows') or [], sess)
            result['protected_mission_row_i576'] = {
                'version': 'i576',
                'phase': phase,
                'raw_discovery_access_state': True,
                'authenticated_worker_session': True,
            }
        return result
    globals()['_i570_build_from_acquired'] = _i570_build_from_acquired

    # Build every public status response from the same explicit authenticated
    # user and stored-credential scope used by save/delete.
    _i576_public_before = _i573_public_status
    def _i573_public_status(mission):
        base = dict(_i576_public_before(mission) or {})
        hint = (base.get('protected') or base.get('password_protected')) if base.get('known') else None
        info = _i576_access_status(mission, _i572_session(), hint)
        base.update(info)
        base['version'] = 'i576'
        return base
    globals()['_i573_public_status'] = _i573_public_status

    _i576_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i576_response_before(state)
        if not isinstance(payload, dict):
            return payload
        payload = _i568_clone(payload)
        sess = _i572_session()
        by_mission = {}
        for key_name in ('mission_access_i572', 'mission_access_i573', 'mission_access_i574', 'mission_access_i575', 'mission_access_i576'):
            for row in list(payload.get(key_name) or []):
                if not isinstance(row, dict):
                    continue
                mission = _i568_text(row.get('mission'))
                if mission:
                    by_mission[mission.casefold()] = dict(row)
        for row in list(payload.get('missions') or []):
            if isinstance(row, str):
                mission = _i568_text(row)
                hint = None
            elif isinstance(row, dict):
                mission = _i568_text(row.get('name') or row.get('mission_name') or row.get('missionName') or row.get('uid'))
                if 'passwordProtected' in row:
                    hint = row.get('passwordProtected')
                elif 'password_protected' in row:
                    hint = row.get('password_protected')
                else:
                    hint = None
            else:
                mission = ''
                hint = None
            if not mission:
                continue
            existing = by_mission.get(mission.casefold()) or {}
            info = _i576_access_status(
                mission,
                sess,
                hint if hint is not None else ((existing.get('protected') or existing.get('password_protected') or
                existing.get('credential_configured') or existing.get('password_stored_server_side')) if existing.get('known') else None))
            existing.update(info)
            by_mission[mission.casefold()] = existing
        payload['version'] = 'i576'
        payload['mission_access_i576'] = list(by_mission.values())
        payload['mission_access_authority_i576'] = {
            'version': 'i576',
            'raw_worker_state': True,
            'stable_authenticated_user_scope': True,
            'partial_refresh_preserves_status': True,
        }
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i576_get_before = Handler.do_GET
    def _i576_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/assets/runtime/tak-map-data-sync-access-i576.js':
            return _i541_send_file(self, _I576_ROOT / 'assets' / 'tak-map-data-sync-access-i576.js',
                                   'application/javascript; charset=utf-8', 'i576-authoritative-mission-access')
        return _i576_get_before(self)
    Handler.do_GET = _i576_do_get

