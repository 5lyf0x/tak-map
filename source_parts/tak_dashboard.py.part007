# --- TAK Map i583 reversible Mission-marker hotfix hf5-r2: publication-complete delayed Mission indexing ---
try:
    _I583_HF5_VERSION = 'i583-hf5-r2'

    def _i583hf5_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i583hf5_float(value, default=None):
        try:
            number = float(value)
            return number if math.isfinite(number) else default
        except Exception:
            return default

    def _i583hf5_clone(value):
        if '_i568_clone' in globals():
            try:
                return _i568_clone(value)
            except Exception:
                pass
        try:
            return json.loads(json.dumps(value))
        except Exception:
            return dict(value) if isinstance(value, dict) else value

    def _i583hf5_delayed_publication(publish):
        """Return the one published/associated point whose Mission /cot read-back is delayed."""
        if not isinstance(publish, dict):
            return None
        points = [row for row in list(publish.get('points') or []) if isinstance(row, dict)]
        if len(points) != 1:
            return None
        row = points[0]
        native = row.get('per_user_cot_ingest') if isinstance(row.get('per_user_cot_ingest'), dict) else row.get('native_mission_cot')
        association = row.get('associate_uid') if isinstance(row.get('associate_uid'), dict) else {}
        readback = row.get('mission_readback') if isinstance(row.get('mission_readback'), dict) else {}
        uid = _i583hf5_text(row.get('uid') or (native or {}).get('event_uid') or (publish.get('event_uids') or [''])[0])
        if not uid or not isinstance(native, dict):
            return None
        if not native.get('ok') or not association.get('ok') or readback.get('ok'):
            return None
        # hf5 is intentionally scoped to the marker-API path proven live in hf4.
        if _i583hf5_text(native.get('i583_hf1_transport')) != 'ots-marker-api':
            return None
        return {
            'uid': uid,
            'point_result': row,
            'native': native,
            'association': association,
            'readback': readback,
        }

    def _i583hf5_row(payload, publish, delayed):
        payload = payload if isinstance(payload, dict) else {}
        symbol = payload.get('symbol') if isinstance(payload.get('symbol'), dict) else {}
        point_result = delayed.get('point_result') if isinstance(delayed, dict) else {}
        native = delayed.get('native') if isinstance(delayed, dict) else {}
        marker = native.get('marker_payload') if isinstance(native.get('marker_payload'), dict) else {}
        uid = _i583hf5_text(delayed.get('uid'))
        mission = _i583hf5_text(payload.get('mission_name') or payload.get('mission') or (publish or {}).get('mission'))
        name = _i583hf5_text(payload.get('name') or point_result.get('name') or marker.get('name')) or 'TAK Map Point'
        lat = _i583hf5_float(payload.get('lat'), _i583hf5_float(point_result.get('lat'), _i583hf5_float(marker.get('latitude'))))
        lon = _i583hf5_float(payload.get('lon'), _i583hf5_float(point_result.get('lon'), _i583hf5_float(marker.get('longitude'))))
        notes = _i583hf5_text(payload.get('notes') or payload.get('remarks'))
        sidc = _i583hf5_text(symbol.get('sidc') or point_result.get('sidc'))
        cot_type = _i583hf5_text(symbol.get('cot_type') or point_result.get('cot_type') or marker.get('type'))
        icon_path = _i583hf5_text(symbol.get('iconsetpath') or symbol.get('iconset_path') or point_result.get('iconset_path'))
        row = {
            'uid': uid,
            'event_uid': uid,
            'cot_uid': uid,
            'canonical_cot_uid_i546': uid,
            'source_id': uid,
            'name': name,
            'callsign': name,
            'point_name': name,
            'lat': lat,
            'lon': lon,
            'raw_lat': lat,
            'raw_lon': lon,
            'coords': [[lat, lon]] if lat is not None and lon is not None else [],
            'notes': notes,
            'remarks': notes,
            'mission': mission,
            'mission_name': mission,
            'mission_names': [mission] if mission else [],
            'kind': 'datasync',
            'is_mission_object': True,
            'cot_type': cot_type,
            'atak_cot_type': cot_type,
            'event_type': cot_type,
            'type': cot_type,
            'sidc': sidc,
            'SIDC': sidc,
            'iconsetpath': icon_path,
            'iconset_path': icon_path,
            'hae': _i583hf5_float(marker.get('hae'), 0.0),
            'ce': _i583hf5_float(marker.get('ce'), 9999999.0),
            'le': _i583hf5_float(marker.get('le'), 9999999.0),
            'affiliation': _i583hf5_text(payload.get('affiliation')),
            'source': 'Published · awaiting Mission index',
            'updated': datetime.now(timezone.utc).isoformat(),
            'mission_delete_target': 'uid',
            'mission_delete_value': uid,
            'delete_supported': True,
            'delete_unavailable_reason': '',
            'data_sync_optimistic_i583': True,
            'data_sync_source_identity_verified_i583_hf1': True,
            'data_sync_confirmation_state_i583_hf1': 'published-source-verified',
            'data_sync_confirmation_state_i583_hf5': 'published-associated-awaiting-mission-index',
            'data_sync_handoff_pending_i583_hf1': True,
            'data_sync_handoff_pending_i583_hf5': True,
            'data_sync_status_label_i583_hf1': 'Published · awaiting Mission index',
            'data_sync_status_label_i583_hf5': 'Published · awaiting Mission index',
            'point_not_eud_i583_hf1': True,
            'point_not_eud_i583_hf5': True,
            'marker_api_publication_confirmed_i583_hf5': True,
            'mission_uid_association_confirmed_i583_hf5': True,
            'mission_cot_readback_deferred_i583_hf5': True,
            'exact_location_preserved_i583_hf5': True,
        }
        for source_key, target_key in (
            ('name', 'mil2525_name'), ('label', 'mil2525_label'), ('file', 'mil2525_file')
        ):
            value = _i583hf5_text(symbol.get(source_key))
            if value:
                row[target_key] = value
        return row

    def _i583hf5_public_point(row):
        try:
            point = dict(_i555_point_public(row) or {})
        except Exception:
            point = {}
        uid = _i583hf5_text(row.get('uid'))
        point.update({
            'uid': uid,
            'event_uid': uid,
            'cot_uid': uid,
            'mission_name': _i583hf5_text(row.get('mission_name') or row.get('mission')),
            'name': _i583hf5_text(row.get('name') or row.get('callsign')),
            'lat': row.get('lat'),
            'lon': row.get('lon'),
            'hae': row.get('hae'),
            'ce': row.get('ce'),
            'le': row.get('le'),
            'mission_delete_target': 'uid',
            'mission_delete_value': uid,
            'delete_supported': True,
            'delete_unavailable_reason': '',
            'source_owned': True,
            'data_sync_confirmation_state_i583_hf5': 'published-associated-awaiting-mission-index',
            'data_sync_status_label_i583_hf5': 'Published · awaiting Mission index',
            'point_not_eud_i583_hf5': True,
        })
        return point

    def _i583hf5_correct_optimistic_record(optimistic, row):
        if not isinstance(optimistic, dict):
            return
        key = _i583hf5_text(optimistic.get('key'))
        shadow_key = _i583hf5_text(optimistic.get('shadow_key'))
        if not key or not shadow_key:
            return
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            shadows = dict(state.get('i583_optimistic_rows') or {})
            record = dict(shadows.get(shadow_key) or {})
            current = record.get('row') if isinstance(record.get('row'), dict) else {}
            merged = _i570_merge_dict_nonempty(current, row) if '_i570_merge_dict_nonempty' in globals() else dict(current, **row)
            if '_i583hf_verified_row' in globals():
                merged = _i583hf_verified_row(merged, row.get('uid'), row.get('mission_name'))
            merged.update({
                'data_sync_confirmation_state_i583_hf5': 'published-associated-awaiting-mission-index',
                'data_sync_status_label_i583_hf5': 'Published · awaiting Mission index',
                'marker_api_publication_confirmed_i583_hf5': True,
                'mission_uid_association_confirmed_i583_hf5': True,
                'mission_cot_readback_deferred_i583_hf5': True,
                'delete_supported': True,
                'delete_unavailable_reason': '',
            })
            record['row'] = merged
            # Mission association is confirmed, but discovery has not yet observed the
            # UID. Keep membership_seen false so a temporarily stale Mission index can
            # never be interpreted as an authoritative deletion of this new point.
            record['membership_seen'] = False
            record['membership_seen_epoch'] = 0
            record['source_identity_verified_i583_hf1'] = True
            record['source_identity_verified_i583_hf5'] = True
            record['marker_api_publication_confirmed_i583_hf5'] = True
            record['mission_uid_association_confirmed_i583_hf5'] = True
            record['mission_cot_readback_deferred_i583_hf5'] = True
            record['published_epoch_i583_hf5'] = time.time()
            shadows[shadow_key] = record
            state['i583_optimistic_rows'] = shadows
            state['snapshot'] = _i583_merge_optimistic(
                state.get('snapshot') if isinstance(state.get('snapshot'), dict) else {
                    'ok': True, 'objects': [], 'mission_uids': [], 'missions': []
                },
                state, 'i583-hf5-r2-published-associated-awaiting-index',
                state.get('i581_membership_map') or {}, allow_retire=False)
            state['last_success_epoch'] = max(float(state.get('last_success_epoch') or 0), time.time())
            state['acquisition_summary'] = dict(state.get('acquisition_summary') or {})
            state['acquisition_summary']['phase'] = 'published-associated-awaiting-mission-index'
            state['i583_hf5_last_delayed_handoff'] = {
                'uid': row.get('uid'),
                'mission': row.get('mission_name'),
                'published': True,
                'mission_uid_associated': True,
                'mission_cot_readback_deferred': True,
                'delete_available': True,
                'single_visible_optimistic_marker': True,
                'updated_epoch': time.time(),
            }
            _i568_persist_success(state)

    _i583hf5_save_before = _i555_save_point
    def _i555_save_point(payload):
        payload = payload if isinstance(payload, dict) else {}
        reply, status = _i583hf5_save_before(payload)
        # Only reinterpret a new marker-API point whose remote marker write and
        # Mission UID association both succeeded. Every earlier failure remains fatal.
        if _i583hf5_text(payload.get('uid')):
            return reply, status
        if int(status or 0) != 502 or not isinstance(reply, dict):
            return reply, status
        publish = reply.get('publish') if isinstance(reply.get('publish'), dict) else {}
        delayed = _i583hf5_delayed_publication(publish)
        if not delayed:
            return reply, status

        row = _i583hf5_row(payload, publish, delayed)
        point = _i583hf5_public_point(row)
        publish_success = _i583hf5_clone(publish)
        publish_success['ok'] = True
        publish_success['publish_succeeded'] = True
        publish_success['readback_confirmed'] = False
        publish_success['mission_readback_deferred'] = True
        publish_success['publication_complete_without_mission_cot_readback_i583_hf5'] = True
        publish_success['close_publish_modal_after_success'] = True
        publish_success['disable_publish_after_success'] = True
        publish_success['data_sync_refresh_recommended'] = True
        publish_success['error'] = ''
        publish_success['message'] = 'Point published and associated with the Data Sync Mission; Mission indexing is continuing in the background.'

        success = {
            'ok': True,
            'version': _I583_HF5_VERSION,
            'message': 'Point published to OpenTAKServer and associated with the Data Sync Mission.',
            'status_label': 'Published · awaiting Mission index',
            'point': point,
            'publish': publish_success,
            'redraw_allowed': True,
            'server_marker_published': True,
            'marker_api_publication_confirmed': True,
            'mission_uid_associated': True,
            'mission_readback_deferred': True,
            'awaiting_mission_index': True,
            'publication_complete': True,
            'delete_supported': True,
            'mission_delete_target': 'uid',
            'mission_delete_value': row.get('uid'),
            'local_data_retained': False,
            'local_data_reconcile_required': False,
            'placement_preview_must_close': True,
            'single_visible_marker_handoff_i583_hf5': True,
            'point_not_eud_i583_hf5': True,
            'exact_location_preserved_i583_hf5': True,
        }

        try:
            optimistic = _i583_store_optimistic(payload, success)
            if optimistic:
                _i583hf5_correct_optimistic_record(optimistic, row)
                success['optimistic_data_sync_handoff_i583'] = {
                    'active': True,
                    'uid': optimistic.get('uid') or row.get('uid'),
                    'mission': optimistic.get('mission') or row.get('mission_name'),
                    'persisted_per_user': True,
                    'older_snapshot_cannot_remove': True,
                    'delete_available_immediately': True,
                    'mission_readback_deferred': True,
                }
                cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
                sess = _i570_context_session() if '_i570_context_session' in globals() else {}
                token = _i583hf5_text((sess or {}).get('_i570_token'))
                _i568_schedule_refresh(
                    optimistic.get('key'), cfg or {}, sess or {}, token,
                    'i583-hf5-r2-post-save-membership-fastpath', force=False)
            else:
                success['optimistic_handoff_warning_i583_hf5'] = 'Publication succeeded, but the immediate optimistic Data Sync row could not be persisted.'
        except Exception as exc:
            # Remote publication and Mission association are already complete; do not
            # mislabel them as failed because local optimistic reconciliation warned.
            success['optimistic_handoff_warning_i583_hf5'] = _i583hf5_text(exc)[:1000]
        return success, 200
    globals()['_i555_save_point'] = _i555_save_point

    _i583hf5_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i583hf5_response_before(state)
        if isinstance(payload, dict):
            payload['data_sync_create_handoff_i583_hf5'] = {
                'version': _I583_HF5_VERSION,
                'marker_write_plus_mission_association_is_completed_publication': True,
                'mission_cot_readback_is_background_indexing': True,
                'delayed_readback_does_not_retain_create_preview': True,
                'delayed_readback_does_not_disable_delete': True,
                'single_optimistic_marker_until_canonical_handoff': True,
                'last_delayed_handoff': dict((state or {}).get('i583_hf5_last_delayed_handoff') or {}),
            }
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload


    _i583hf5r2_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i583hf5r2_config_before() or {})
        cfg['data_sync_create_handoff_i583_hf5'] = {
            'version': _I583_HF5_VERSION,
            'publication_success_gate': ['ots-marker-api-write', 'mission-uid-association'],
            'mission_cot_readback': 'background-canonical-handoff',
            'save_dialog_closes_after_association': True,
            'placement_preview_removed_after_association': True,
            'local_source_duplicate_retained': False,
            'delete_available_immediately': True,
            'single_visible_marker': True,
            'point_not_eud': True,
            'exact_location_preserved': True,
            'modern_i572_create_runtime_path_unchanged': True,
            'icon_registry_runtime': '/assets/runtime/tak-map-icon-registry-i572.js',
            'reversible_hotfix': True,
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i583hf5r2_patch_html(html):
        html = str(html or '')
        # Keep the proven i572 runtime route unchanged. Change only its cache
        # identity so browsers retrieve the in-place patched modern Create Point UI.
        return re.sub(
            r'(/assets/runtime/tak-map-icon-registry-i572\.js)\?v=[^"\']+',
            r'\1?v=1.3.0-i583-hf5-r2',
            html,
        )

    TAK_MAP_HTML = _i583hf5r2_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i583hf5r2_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
except Exception as _i583_hf5_exc:
    try:
        print('TAK Map i583 Mission-marker hotfix hf5-r2 failed:', _i583_hf5_exc)
    except Exception:
        pass
# --- end TAK Map i583 reversible Mission-marker hotfix hf5-r2 ---

