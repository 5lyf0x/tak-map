# --- TAK Map i651: authenticated NDM catalog/import and local routing backend ---
import sys as _i651_sys
if str(Path(__file__).resolve().parent) not in _i651_sys.path:
    _i651_sys.path.insert(0,str(Path(__file__).resolve().parent))
from ndm_packages_i651 import Catalog as _I651Catalog,NDMError as _I651NDMError,MAX_ZIP_BYTES as _I651_MAX_UPLOAD_BYTES
from ndm_valhalla_i651 import prepare_graph as _i651_prepare_graph,service_state as _i651_service_state,route as _i651_route
_i651_catalog=_I651Catalog()
_i651_prev_get=Handler.do_GET
_i651_prev_post=Handler.do_POST
_i651_prev_delete=getattr(Handler,'do_DELETE',None)

def _i651_authorize(self,admin=False,mutation=False):
    if not self._tak_map_auth_ok():
        self._require_tak_map_login()
        return False
    if admin and not _i540_is_admin(self._tak_map_session() or {}):
        self._send_json({'ok':False,'error':'Administrator required'},403)
        return False
    if mutation and not _i645_same_origin(self):
        self._send_json({'ok':False,'error':'Same-origin request required'},403)
        return False
    return True

def _i651_json_input(self):
    if not self.headers.get('Content-Type','').lower().startswith('application/json'):
        raise _I651NDMError('JSON body expected')
    length=int(self.headers.get('Content-Length','0') or '0')
    if length<2 or length>32768:raise _I651NDMError('Invalid request size')
    payload=json.loads(self.rfile.read(length))
    if not isinstance(payload,dict):raise _I651NDMError('JSON object required')
    return payload

def _i651_error(self,e):
    return self._send_json({'ok':False,'error':str(e),'code':getattr(e,'code','INVALID_REQUEST')},
                           404 if getattr(e,'code','')=='NOT_FOUND' else 400)

def _i651_get(self):
    path=urlparse(self.path).path
    if not path.startswith('/api/tak-map/ndm/'):
        return _i651_prev_get(self)
    admin=(path=='/api/tak-map/ndm/discover')
    if not _i651_authorize(self,admin=admin):return
    try:
        if path=='/api/tak-map/ndm/catalog':
            return self._send_json({'ok':True,'datasets':_i651_catalog.listing(),
                                    'max_upload_bytes':_I651_MAX_UPLOAD_BYTES,
                                    'existing_file_size_limit':None})
        if path=='/api/tak-map/ndm/status':
            return self._send_json({'ok':True,**_i651_service_state(_i651_catalog),
                                    'datasets_count':len(_i651_catalog.listing())})
        if path=='/api/tak-map/ndm/discover':
            return self._send_json({'ok':True,'available':_i651_catalog.discover()})
        return self._send_json({'ok':False,'error':'Endpoint not found'},404)
    except (ValueError,OSError) as e:return _i651_error(self,e)
Handler.do_GET=_i651_get

def _i655_check_active_graph_bounds(points):
    """Quick fail-closed check of chosen graph bounds; not a proof of road connectivity."""
    if not isinstance(points,list):return
    active=[e for e in _i651_catalog.listing() if e.get('active') and e.get('type')=='routing']
    if not active:return
    bounds=active[0].get('bounds')
    if not isinstance(bounds,list) or len(bounds)!=4:return
    try:
        west,south,east,north=map(float,bounds)
        for p in points:
            if not isinstance(p,dict):return
            lat,lon=float(p['lat']),float(p['lon'])
            if not(west<=lon<=east and south<=lat<=north):
                raise _I651NDMError('Outside the active road network. Crossing into another state needs a connected multi-state navigation graph.')
    except (KeyError,TypeError,ValueError) as e:
        if isinstance(e,_I651NDMError):raise

def _i651_post(self):
    path=urlparse(self.path).path
    operations={
        '/api/tak-map/ndm/import','/api/tak-map/ndm/register-existing',
        '/api/tak-map/ndm/prepare','/api/tak-map/ndm/activate',
        '/api/tak-map/routing/resolve',
    }
    if path not in operations:return _i651_prev_post(self)
    admin=path!='/api/tak-map/routing/resolve'
    if not _i651_authorize(self,admin=admin,mutation=True):return
    try:
        if path=='/api/tak-map/ndm/import':
            if self.headers.get('Content-Type','').split(';')[0].strip().lower()!='application/zip':
                return self._send_json({'ok':False,'error':'Raw application/zip required'},415)
            size=int(self.headers.get('Content-Length','0') or '0')
            entry,duplicate=_i651_catalog.import_stream(self.rfile,size)
            return self._send_json({'ok':True,'dataset':entry,'duplicate':duplicate})
        payload=_i651_json_input(self)
        if path=='/api/tak-map/ndm/register-existing':
            entry,duplicate=_i651_catalog.register_existing(payload.get('discovery_id'))
            return self._send_json({'ok':True,'dataset':entry,'duplicate':duplicate})
        if path=='/api/tak-map/ndm/prepare':
            return self._send_json({'ok':True,**_i651_prepare_graph(_i651_catalog,str(payload.get('dataset_id','')))})
        if path=='/api/tak-map/ndm/activate':
            # Activation is a deliberate host operation after real Phase A tests, not a
            # network action available simply because a dataset was imported.
            return self._send_json({'ok':False,'code':'ACTIVATION_OPERATOR_GATED',
                                    'error':'Run validated local service/host tests before enabling Valhalla.'},409)
        if path=='/api/tak-map/routing/resolve':
            _i655_check_active_graph_bounds(payload.get('locations'))
            return self._send_json(_i651_route(payload.get('locations'),payload.get('mode','roads'),unrestricted=payload.get('unrestricted') is True))
    except (ValueError,TypeError,KeyError,OSError) as e:return _i651_error(self,e)
Handler.do_POST=_i651_post

def _i651_delete(self):
    path=urlparse(self.path).path
    prefix='/api/tak-map/ndm/datasets/'
    if not path.startswith(prefix):
        if _i651_prev_delete:return _i651_prev_delete(self)
        return self._send_json({'ok':False,'error':'Endpoint not found'},404)
    if not _i651_authorize(self,admin=True,mutation=True):return
    sha=path[len(prefix):]
    if len(sha)!=64 or any(c not in '0123456789abcdef' for c in sha):
        return self._send_json({'ok':False,'error':'Invalid dataset ID'},400)
    try:
        _i651_catalog.unregister(sha)
        return self._send_json({'ok':True,'files_preserved':True})
    except (ValueError,OSError) as e:return _i651_error(self,e)
Handler.do_DELETE=_i651_delete

