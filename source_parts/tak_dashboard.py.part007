                association=_i643_associate_shape_uid(mission,creator_uid,uid,token)
                if not association.get('ok'):
                    return {'ok':False,'error':f'Shape Save reached TAK Server but could not associate UID with Mission "{mission}".','shape_edit_i643':{'stage':'mission-contents-uid-association','failed_mission':mission,'event_uid':uid,'missions':missions,'creator_uid':creator_uid,'association':association,'confirmed_missions':[x.get('mission') for x in confirmations]}}
