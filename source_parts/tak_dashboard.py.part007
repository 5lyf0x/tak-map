# --- TAK Map i692: same-origin NOAA/NWS MRMS radar reliability correction ---
import tak_map_radar_i692 as _radar_i692

_I692_PREVIOUS_GET = Handler.do_GET

def _weather_get_i692(self):
    path = urlparse(self.path).path
    if path in ('/assets/runtime/tak-map-weather-i692.js', '/assets/runtime/tak-map-weather-i692.css'):
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        asset = Path(__file__).resolve().parent / 'assets' / path.rsplit('/', 1)[-1]
        if not asset.is_file():
            self.send_response(404)
            self.send_header('Content-Length', '0')
            self.end_headers()
            return
        payload = asset.read_bytes()
        self.send_response(200)
        self.send_header('Content-Type', ('text/css' if path.endswith('.css') else 'application/javascript') + '; charset=utf-8')
        self.send_header('Cache-Control', 'private, no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Content-Length', str(len(payload)))
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(payload)
        return
    if path == '/api/tak-map/weather/radar/status-i692' or path.startswith('/api/tak-map/weather/radar/tile-i692/'):
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        if path == '/api/tak-map/weather/radar/status-i692':
            payload = _radar_i692.status()
            return self._send_json(payload)
        try:
            z, x, y = _radar_i692.parse_tile(path)
            query = __import__('urllib.parse', fromlist=['parse_qs']).parse_qs(urlparse(self.path).query, keep_blank_values=True)
            if set(query) != {'frame'} or len(query['frame']) != 1:
                raise _radar_i692.RadarError('invalid_frame')
            tile = _radar_i692.tile(z, x, y, query['frame'][0])
            self.send_response(200)
            self.send_header('Content-Type', 'image/png')
            self.send_header('Cache-Control', 'private, max-age=120')
            self.send_header('X-Content-Type-Options', 'nosniff')
            self.send_header('Content-Length', str(len(tile)))
            self.end_headers()
            if self.command != 'HEAD':
                self.wfile.write(tile)
            return
        except _radar_i692.RadarError as exc:
            code = 400 if exc.code.startswith('invalid_') else 409 if exc.code == 'frame_changed' else 503
            payload = _weather_json_i691.dumps({'ok': False, 'error_code': exc.code}).encode('utf-8')
            self.send_response(code)
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.send_header('Cache-Control', 'no-store')
            self.send_header('X-Content-Type-Options', 'nosniff')
            if code == 503:
                self.send_header('Retry-After', '15')
            self.send_header('Content-Length', str(len(payload)))
            self.end_headers()
            if self.command != 'HEAD':
                self.wfile.write(payload)
            return
    return _I692_PREVIOUS_GET(self)

Handler.do_GET = _weather_get_i692
# Preserve i691 native weather storage keys, markup, and unchanged alerts endpoint.
TAK_MAP_HTML = TAK_MAP_HTML.replace(
    '/assets/runtime/tak-map-weather-i691.css?v=1.4.0-i691',
