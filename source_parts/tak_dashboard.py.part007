# --- TAK Map i680: read-only Local Data response recovery ---
def _i680_read_only_import_response():
    """Return complete persisted Local Data when response enrichment cannot encode.

    No writes, migrations, deletions, truncation, or synthetic coordinates.
    A missing or unreadable import file is an error, NOT an empty dataset.
    This fallback is only called after the normal response serializer fails.
    """
    path = Path(TAK_MAP_IMPORT_FILE)
    stored = json.loads(path.read_text(encoding='utf-8'))
    if not isinstance(stored, dict) or not isinstance(stored.get('imports'), list):
        raise ValueError('Saved Local Data is missing the expected imports array')
    imports = stored['imports']
    for imp in imports:
        if not isinstance(imp, dict):
            raise ValueError('Saved Local Data contains an invalid import record')
        if imp.get('features') is None:
            # Some historic imports have no feature array; do not let that
            # hide other healthy imports. This modifies only the response copy.
            imp['features'] = []
        if not isinstance(imp['features'], list):
            raise ValueError('Saved Local Data contains a non-array feature field')
        for feature in imp['features']:
            if not isinstance(feature, dict):
                raise ValueError('Saved Local Data contains an invalid feature')
            if str(feature.get('kind') or '').lower() == 'route' and feature.get('object_id'):
                # The normal view supplies this revision for safe existing-route edits.
                # A calculated revision changes response data only, never the saved file.
                feature['route_revision_i659'] = _i659_route_revision(feature)
    result = {'ok': True, 'imports': imports,
              'local_data_recovery_i680': {'source': 'canonical_storage',
                                           'mode': 'read_only',
                                           'enrichment_deferred': True}}
    return result

