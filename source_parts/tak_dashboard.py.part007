# --- TAK Map 1.4.0-i642 authoritative Mission Shape save transaction ---
try:
    _I642_VERSION='i642'
    _I642_PACKAGE_VERSION='1.4.0-i642'

    def _i642_text(value):
        try: return str(value if value is not None else '').strip()
        except Exception: return ''

    def _i642_unique_missions(geom, xml=''):
        names=[]; seen=set()
        for value in list((geom or {}).get('mission_names') or []):
            name=_i642_text(value)
            if name and name.casefold() not in seen:
                seen.add(name.casefold()); names.append(name)
        if xml:
            try:
                root=ET.fromstring(_i642_text(xml).encode('utf-8'))
                for node in root.iter():
                    if _i636_local_name(node.tag)!='dest': continue
                    name=_i642_text(node.attrib.get('mission'))
                    if name and name.casefold() not in seen:
                        seen.add(name.casefold()); names.append(name)
            except Exception:
                pass
        return names[:128]

    def _i642_point_close(a,b,tol=2e-6):
        try:
            return abs(float(a[0])-float(b[0]))<=tol and abs(float(a[1])-float(b[1]))<=tol
        except Exception:
            return False

    def _i642_ring_equal(a,b,tol=2e-6):
        aa=[list(x[:2]) for x in (a or []) if isinstance(x,(list,tuple)) and len(x)>=2]
        bb=[list(x[:2]) for x in (b or []) if isinstance(x,(list,tuple)) and len(x)>=2]
        if len(aa)>1 and _i642_point_close(aa[0],aa[-1],tol): aa=aa[:-1]
        if len(bb)>1 and _i642_point_close(bb[0],bb[-1],tol): bb=bb[:-1]
        if not aa or len(aa)!=len(bb): return False
        n=len(aa)
        for shift in range(n):
            if all(_i642_point_close(aa[i],bb[(i+shift)%n],tol) for i in range(n)):
                return True
            if all(_i642_point_close(aa[i],bb[(shift-i)%n],tol) for i in range(n)):
                return True
        return False

    def _i642_shape_row_from_result(result, mission, uid):
        if not isinstance(result,dict) or not result.get('ok'): return None
        try:
            events=_i545_extract_events(result.get('json'),result.get('body') or '')
            event=dict((events or {}).get(_i642_text(uid).casefold()) or {})
            if not event:
                for key,value in dict(events or {}).items():
                    if _i642_text(key).casefold()==_i642_text(uid).casefold():
                        event=dict(value or {}); break
            if not event: return None
            row=_i636_parse_tak_shape_event(event,mission)
            return row if isinstance(row,dict) else None
        except Exception:
            return None

    def _i642_geometry_matches_row(row, geom):
        if not isinstance(row,dict) or not isinstance(geom,dict): return False
        kind=_i642_text(row.get('shape_kind_i636') or row.get('shape_kind') or '').lower()
        target_kind=_i642_text(geom.get('kind')).lower()
        if kind and target_kind and kind!=target_kind: return False
        uid=_i642_text(row.get('uid') or row.get('cot_uid') or row.get('event_uid')).casefold()
        target_uid=_i642_text(geom.get('uid')).casefold()
        if uid and target_uid and uid!=target_uid: return False
        cot_type=_i642_text(row.get('cot_type') or row.get('type')).lower()
        target_type=_i642_text(geom.get('cot_type')).lower()
        if cot_type and target_type and cot_type!=target_type: return False
        center=[row.get('lat'),row.get('lon')]
        target_center=geom.get('center') or []
        if len(target_center)>=2 and not _i642_point_close(center,target_center,2e-6): return False
        if target_kind in ('circle','ellipse'):
            try:
                if abs(float(row.get('major_m_i636'))-float(geom.get('major_m')))>.25: return False
                if target_kind=='ellipse' and abs(float(row.get('minor_m_i636'))-float(geom.get('minor_m')))>.25: return False
            except Exception:
                return False
            return True
        return _i642_ring_equal(row.get('coords') or [],geom.get('coords') or [],2e-6)

    def _i642_creator_uid():
        try:
            creator=_i528_strict_creator() if callable(globals().get('_i528_strict_creator')) else {}
            if isinstance(creator,dict) and creator.get('ok') and _i642_text(creator.get('uid')):
                return {'ok':True,'uid':_i642_text(creator.get('uid')),'source':creator.get('source') or 'strict-per-user'}
            return {'ok':False,'uid':'','error':_i642_text((creator or {}).get('error')) or 'Per-user Mission creator identity is unavailable.'}
        except Exception as exc:
            return {'ok':False,'uid':'','error':str(exc)}

    def _i642_mission_token(mission, creator_uid):
        try:
            fn=globals().get('_i572_cached_token')
            return _i642_text(fn(mission,creator_uid)) if callable(fn) else ''
        except Exception:
            return ''

    def _i642_send_shape_mission(mission, creator_uid, xml, token=''):
        body=_i642_text(xml).encode('utf-8')
        mission_q=quote(_i642_text(mission),safe=''); creator_q=quote(_i642_text(creator_uid),safe='')
        attempts=[]
        for method in ('POST','PUT'):
            for suffix in ('','&tool=public'):
                path=f'/Marti/api/missions/{mission_q}/cot?creatorUid={creator_q}{suffix}'
                result=_ots_mission_api_request(path,method=method,body=body,headers={'Content-Type':'application/xml; charset=UTF-8','Content-Length':str(len(body))},token=token,timeout=25)
                record=dict(result or {}); record.update({'method':method,'path':path}); attempts.append(record)
                if record.get('ok'):
                    return {'ok':True,'status':int(record.get('status') or 200),'method':method,'path':path,'attempts':attempts}
        return {'ok':False,'error':'All native Mission Shape /cot update attempts failed.','attempts':attempts}

    def _i642_confirm_shape_mission(mission, creator_uid, uid, geom, token='', deadline_seconds=10.0):
        mission_q=quote(_i642_text(mission),safe='')
        primary=f'/Marti/api/missions/{mission_q}/cot'
        fallback=primary+'?creatorUid='+quote(_i642_text(creator_uid),safe='') if creator_uid else ''
        started=time.monotonic(); attempts=[]; attempt=0
        while time.monotonic()-started < max(1.0,float(deadline_seconds)):
            attempt+=1
            for path in ([primary]+([fallback] if fallback and attempt==1 else [])):
                remaining=max(1.0,float(deadline_seconds)-(time.monotonic()-started))
                result=_ots_mission_api_request(path,method='GET',token=token,timeout=max(1,min(4,int(remaining+0.999))))
                row=_i642_shape_row_from_result(result,mission,uid)
                match=bool(row and _i642_geometry_matches_row(row,geom))
                attempts.append({'attempt':attempt,'path':path,'status':int((result or {}).get('status') or 0) if isinstance(result,dict) else 0,'ok':bool(isinstance(result,dict) and result.get('ok')),'exact_uid_present':bool(row),'geometry_match':match,'readback_kind':_i642_text((row or {}).get('shape_kind_i636')),'readback_type':_i642_text((row or {}).get('cot_type') or (row or {}).get('type')),'readback_coords':(row or {}).get('coords') if row else None,'error':_i642_text((result or {}).get('error'))[:300] if isinstance(result,dict) else 'invalid-result'})
                if match:
                    return {'ok':True,'mission':mission,'event_uid':uid,'source':'direct-mission-cot-readback-i642','attempts':attempts,'geometry_match':True,'row':row}
            if time.monotonic()-started < max(1.0,float(deadline_seconds)):
                time.sleep(0.45)
        return {'ok':False,'mission':mission,'event_uid':uid,'source':'direct-mission-cot-readback-i642','attempts':attempts,'geometry_match':False,'error':'The edited Shape UID was not returned from Mission /cot with matching geometry within the bounded confirmation window.'}

    _i642_popup_before=tak_map_popup_edit_update
    def tak_map_popup_edit_update(payload):
        payload=payload if isinstance(payload,dict) else {}
        geometry=payload.get('shape_geometry_i639')
        if not isinstance(geometry,dict):
            return _i642_popup_before(payload)
        try:
            geom=_i639_validate_shape_geometry(geometry)
            if not geom.get('is_mission_object'):
                result=_i642_popup_before(payload)
                if isinstance(result,dict) and result.get('ok'):
                    result=dict(result); result['shape_edit_i642']={'version':_I642_VERSION,'mission_backed':False,'authoritative_mission_readback_confirmed':False,'commit_gate':'persistent-local-overlay'}
                return result
            geom,xml=_i639_patch_shape_raw_cot(geom)
            uid=_i642_text(geom.get('uid'))
            missions=_i642_unique_missions(geom,xml)
            if not uid: return {'ok':False,'error':'Shape Save requires the existing TAK UID.','shape_edit_i642':{'stage':'validate-uid'}}
            if not missions: return {'ok':False,'error':'Mission-backed Shape Save requires at least one authoritative Mission membership.','shape_edit_i642':{'stage':'resolve-mission-membership','event_uid':uid}}
            creator=_i642_creator_uid()
            if not creator.get('ok'):
                return {'ok':False,'error':'Mission-backed Shape Save cannot use a shared/generic CoT sender: '+_i642_text(creator.get('error')),'shape_edit_i642':{'stage':'resolve-per-user-creator','event_uid':uid,'missions':missions}}
            creator_uid=creator['uid']; confirmations=[]
            for mission in missions:
                token=_i642_mission_token(mission,creator_uid)
                sent=_i642_send_shape_mission(mission,creator_uid,xml,token)
                if not sent.get('ok'):
                    return {'ok':False,'error':f'Shape Save failed while updating Mission "{mission}".','shape_edit_i642':{'stage':'mission-cot-update','failed_mission':mission,'event_uid':uid,'missions':missions,'creator_uid':creator_uid,'send':sent,'confirmed_missions':[x.get('mission') for x in confirmations]}}
                confirmed=_i642_confirm_shape_mission(mission,creator_uid,uid,geom,token)
                public_confirm={k:v for k,v in confirmed.items() if k!='row'}
                public_confirm['send']=sent
                confirmations.append(public_confirm)
                if not confirmed.get('ok'):
                    return {'ok':False,'error':f'Shape Save reached Mission "{mission}" but authoritative /cot read-back did not confirm the edited geometry.','shape_edit_i642':{'stage':'mission-cot-readback','failed_mission':mission,'event_uid':uid,'missions':missions,'creator_uid':creator_uid,'confirmations':confirmations}}
            base_payload={k:v for k,v in payload.items() if k!='shape_geometry_i639'}
            base=_i639_popup_update_before(base_payload)
            if not isinstance(base,dict) or not base.get('ok'): return base
            data=_load_popup_edits(); items=data.get('items') if isinstance(data.get('items'),dict) else {}
            key=_i642_text(payload.get('key'))
            edit=dict(items.get(key) or {})
            edit['shape_geometry_i639']=geom; edit['shape_geometry_confirmed_i642']=True; edit['shape_geometry_confirmed_missions_i642']=missions; edit['updated']=datetime.now(timezone.utc).isoformat()
            items[key]=edit; data['items']=items; _save_popup_edits(data)
            try:
                cfg=_i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
                sess=_i570_context_session() if callable(globals().get('_i570_context_session')) else {}
                state_key=_i570_context_state_key(cfg,sess) if callable(globals().get('_i570_context_state_key')) else None
                if state_key is not None and callable(globals().get('_i568_schedule_refresh')):
                    _i568_schedule_refresh(state_key,cfg or {},sess or {},_i642_text((sess or {}).get('_i570_token') or (sess or {}).get('token')),'i642-post-shape-save',force=True)
            except Exception:
                pass
            out=dict(base); out['edit']=edit; out['edits']=data; out['shape_geometry_i639']=geom
            out['shape_edit_i639']={'canonical_tak_geometry':True,'uid_preserved':True,'mission_membership_preserved':True,'server_cot_updated':True,'persisted_overlay':True,'readback_contract':'direct-mission-cot-authoritative-i642','saved_uid':uid,'saved_at':edit['updated']}
            out['shape_edit_i642']={'version':_I642_VERSION,'mission_backed':True,'event_uid':uid,'missions':missions,'creator_uid':creator_uid,'same_uid_update':True,'transport':'native-mission-cot-api','generic_cot_socket_commit_gate':False,'aggregate_data_sync_commit_gate':False,'ring_compare_cyclic_start_independent':True,'ring_compare_winding_independent':True,'authoritative_mission_readback_confirmed':True,'confirmations':confirmations,'commit_gate':'direct-mission-cot-readback'}
            return out
        except Exception as exc:
            return {'ok':False,'error':str(exc),'shape_edit_i642':{'stage':'exception','error':str(exc)}}
    globals()['tak_map_popup_edit_update']=tak_map_popup_edit_update

    _i642_post_before=Handler.do_POST
    def _i642_do_post(self):
        parsed=urlparse(self.path)
        if parsed.path!='/api/tak-map/popup-edit': return _i642_post_before(self)
        if not self._tak_map_auth_ok(): return self._require_tak_map_login()
        if callable(globals().get('_i555_set_request_context')): _i555_set_request_context(self)
        try:
