                        sess['marker_api_auth_ready_i583_hf4'] = bool(marker_token)
                        sess['marker_api_auth_status_i583_hf4'] = int(marker_login.get('status') or 0)
                        sess['marker_api_auth_source_i583_hf4'] = _i583hf4_text(
                            marker_login.get('source') or ('login-time-flask-security-token' if marker_token else 'unavailable'))
                        sess['marker_api_auth_error_i583_hf4'] = '' if marker_token else _i583hf4_text(marker_login.get('error'))[:1000]
                        sess['marker_api_auth_acquired_epoch_i583_hf4'] = time.time() if marker_token else 0
            except Exception:
                pass
