# --- TAK Map i655: background read-only discovery and safe catalog refresh ---
def _i655_sync_ndm():
    import time as _time
    while True:
        try:
            info=_i651_catalog.sync_existing(max_new=8)
            if info['added']:
                print('[TAK Map i655] Registered %d validated NDM package(s).' % len(info['added']),flush=True)
            for err in info['errors'][:5]:
                print('[TAK Map i655] NDM registration deferred:',err['name'],err['error'],flush=True)
        except Exception as exc:
            print('[TAK Map i655] NDM background sync:',str(exc)[:160],flush=True)
        _time.sleep(60)

# --- TAK Map i659: safe in-place updates of saved, editable routes ---
# Imported non-route data and the existing generic upload/delete APIs are unchanged.
def _i659_route_revision(feature):
    import hashlib as _hashlib_i659
    encoded=json.dumps({'id':str((feature or {}).get('object_id') or ''),
                        'coords':(feature or {}).get('coords') or [],
                        'properties':(feature or {}).get('properties') or {},
                        'name':(feature or {}).get('name') or ''},
                       ensure_ascii=False,sort_keys=True,separators=(',',':')).encode('utf-8')
    return _hashlib_i659.sha256(encoded).hexdigest()

_i659_imported_before=tak_map_imported
def tak_map_imported():
    response=_i659_imported_before()
    if not isinstance(response,dict):return response
    stored=load_json_file(TAK_MAP_IMPORT_FILE, {'imports':[]})
    raw_by_id={str(f.get('object_id') or f.get('local_id') or ''):f
       for imp in (stored.get('imports') or []) for f in (imp.get('features') or []) if isinstance(f,dict)}
    for item in response.get('imports') or []:
        if item.get('id')=='webform-live':continue
        for f in item.get('features') or []:
            if str(f.get('kind') or '').lower()!='route':continue
            # Match the persisted canonical row, not presentation-only popup edits.
            stable=raw_by_id.get(str(f.get('object_id') or f.get('local_id') or ''))
            if stable:f['route_revision_i659']=_i659_route_revision(stable)
    return response

def _i659_update_route(payload):
    import math
    if not isinstance(payload,dict):return {'ok':False,'error':'Invalid route update.'},400
    try:
        if len(json_complete_dumps(payload).encode('utf-8'))>32*1024*1024:return {'ok':False,'error':'Route update exceeds 32 MiB size limit.'},413
        import_id=str(payload.get('import_id') or '')
        object_id=str(payload.get('object_id') or '')
        revision=str(payload.get('expected_revision') or '')
        incoming=payload.get('feature')
        if not (import_id and object_id.startswith('local-') and len(revision)==64 and isinstance(incoming,dict)):
            return {'ok':False,'error':'Missing saved route identity or revision.'},400
        geom=incoming.get('geometry') or {}
        raw=geom.get('coordinates') or []
        if geom.get('type')!='LineString' or not isinstance(raw,list) or not 2<=len(raw)<=200000:
            return {'ok':False,'error':'Invalid route geometry.'},400
        for pair in raw:
            if not isinstance(pair,(list,tuple)) or len(pair)<2:
                return {'ok':False,'error':'Invalid coordinate.'},400
            lon,lat=pair[:2]
            if not isinstance(lon,(int,float)) or not isinstance(lat,(int,float)) or not math.isfinite(lon) or not math.isfinite(lat) or not -180<=lon<=180 or not -90<=lat<=90:
                return {'ok':False,'error':'Invalid coordinate range.'},400
        new_props=incoming.get('properties') or {}
        if not isinstance(new_props,dict) or str(new_props.get('kind'))!='route':
            return {'ok':False,'error':'Only saved routes can be edited.'},400
        if not 1<=len(str(new_props.get('name') or '').strip())<=120:
            return {'ok':False,'error':'Route name is required.'},400
        clean=_parse_geojson_obj({'type':'Feature',
          'geometry':{'type':'LineString','coordinates':raw},'properties':new_props},'TAK Map route edit')
        if len(clean)!=1 or clean[0].get('kind')!='route' or len(clean[0].get('coords') or [])!=len(raw):
            return {'ok':False,'error':'Route could not be parsed without losing vertices.'},400
        with _TAK_LOCAL_OBJECT_LOCK:
            _tak_migrate_local_data_ids(True)
            stored=load_json_file(TAK_MAP_IMPORT_FILE,{'imports':[]})
            imports=stored.get('imports') if isinstance(stored,dict) else None
            if not isinstance(imports,list):return {'ok':False,'error':'Saved route catalog unavailable.'},500
            for imp in imports:
                if str(imp.get('id'))!=import_id:continue
                for i,old in enumerate(imp.get('features') or []):
                    if str(old.get('object_id') or old.get('local_id') or '')!=object_id:continue
                    if old.get('kind')!='route':return {'ok':False,'error':'Only routes may be updated.'},400
                    if revision!=_i659_route_revision(old):
                        return {'ok':False,'error':'Route changed since editing began. Refresh the route before saving.'},409
                    latest=dict(old)
                    latest['coords']=clean[0]['coords']
                    latest['name']=clean[0]['name']
                    latest['lat']=clean[0]['lat'];latest['lon']=clean[0]['lon']
                    latest['properties']=dict(old.get('properties') or {})
                    latest['properties'].update(clean[0]['properties'])
                    latest['updated']=datetime.now(timezone.utc).isoformat()
                    imp['features'][i]=latest
                    imp['counts']=_import_summary(imp['features'])
                    TAK_MAP_IMPORT_DIR.mkdir(parents=True,exist_ok=True)
                    atomic_write_json(TAK_MAP_IMPORT_FILE,{'imports':imports})
                    # Confirm the complete route was persisted before replying success.
                    readback = load_json_file(TAK_MAP_IMPORT_FILE, {'imports': []})
                    saved = next((r for b in readback['imports'] for r in b['features']
                                  if r.get('object_id') == object_id), None)
                    if (not saved or saved.get('coords') != clean[0]['coords']
                            or str(saved.get('name')) != str(clean[0]['name'])):
                        raise RuntimeError('Route update readback did not match full geometry')
                    return {'ok':True,'updated_object_id':object_id,'refresh_required':True,
                            'saved_vertices':len(saved['coords'])},200
                return {'ok':False,'error':'Saved route no longer exists.'},404
            return {'ok':False,'error':'Original import not found.'},404
    except Exception as exc:
        return {'ok':False,'error':'Route update failed: '+str(exc)[:180]},500

_i659_prev_post=Handler.do_POST
def _i659_post(self):
    if urlparse(self.path).path!='/api/tak-map/route-update-i659':return _i659_prev_post(self)
    if not self._tak_map_auth_ok():return self._require_tak_map_login()
    try:
        length=int(self.headers.get('Content-Length','0') or '0')
        if length<=0 or length>32*1024*1024:return self._send_json({'ok':False,'error':'Invalid route update size (maximum 32 MiB).'},413)
        payload=_read_json_body(self)
    except Exception:
        return self._send_json({'ok':False,'error':'Invalid route update body.'},400)
    result,status=_i659_update_route(payload)
    return self._send_json(result,status)
Handler.do_POST=_i659_post
# --- end TAK Map i659 in-place saved-route editing ---

