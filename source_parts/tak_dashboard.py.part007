# --- TAK Map 1.4.0-i643 validated native Mission Shape publication transaction ---
try:
    _I643_VERSION='i643'
    _I643_PACKAGE_VERSION='1.4.0-i643'

    def _i643_text(value):
        try: return str(value if value is not None else '').strip()
        except Exception: return ''

    def _i643_native_shape_contract(geom, xml):
        """Refuse EUD/point substitution; preserve the canonical native TAK Shape identity."""
        try:
            root=ET.fromstring(_i643_text(xml).encode('utf-8'))
        except Exception as exc:
            return {'ok':False,'error':'Edited Shape CoT is invalid: '+str(exc)}
        uid=_i643_text(root.attrib.get('uid'))
        cot_type=_i643_text(root.attrib.get('type')).lower()
        expected_uid=_i643_text((geom or {}).get('uid'))
        expected_type=_i643_text((geom or {}).get('cot_type')).lower()
        if not uid or (expected_uid and uid.casefold()!=expected_uid.casefold()):
            return {'ok':False,'error':'Native Shape UID changed during serialization.'}
        if not cot_type.startswith('u-d-') or cot_type.startswith('a-'):
            return {'ok':False,'error':'Shape Save refused a non-native TAK drawing type: '+cot_type}
        if expected_type and cot_type!=expected_type:
            return {'ok':False,'error':'Native Shape CoT type changed during serialization.'}
        link_points=0; mission_destinations=[]
        for node in root.iter():
            name=_i636_local_name(node.tag) if callable(globals().get('_i636_local_name')) else str(node.tag).split('}')[-1]
            if name=='link' and _i643_text(node.attrib.get('point')): link_points+=1
            if name=='dest' and _i643_text(node.attrib.get('mission')): mission_destinations.append(_i643_text(node.attrib.get('mission')))
        kind=_i643_text((geom or {}).get('kind')).lower()
        if kind in ('rectangle','polygon','freeform') and link_points<3:
            return {'ok':False,'error':'Native vertex Shape serialization lost its TAK link geometry.'}
        return {'ok':True,'uid':uid,'cot_type':cot_type,'kind':kind,'link_points':link_points,'mission_destinations':mission_destinations}

    def _i643_result_shape_row(result, mission, uid):
