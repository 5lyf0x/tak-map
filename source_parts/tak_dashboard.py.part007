        cfg['offline_regions_count'] = 52
    return cfg

_I698_PREVIOUS_GET = Handler.do_GET
def _offline_get_i698(self):
    route = urlparse(self.path).path
    if route in ('/assets/runtime/tak-map-offline-maps-i698.js',
                 '/assets/runtime/tak-map-offline-maps-i698.css'):
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        asset = Path(__file__).resolve().parent / 'assets' / route.rsplit('/',1)[-1]
        if not asset.is_file():
            return self._send_json({'ok':False,'error':'Runtime asset unavailable'},404)
        blob=asset.read_bytes()
        self.send_response(200)
        self.send_header('Content-Type',('text/css' if route.endswith('.css') else 'application/javascript')+'; charset=utf-8')
        self.send_header('Cache-Control','private, no-store')
        self.send_header('X-Content-Type-Options','nosniff')
        self.send_header('Content-Length',str(len(blob)))
        self.end_headers()
        if self.command!='HEAD':self.wfile.write(blob)
        return
    if route == '/api/tak-map/offline-areas-i698':
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        return self._send_json({'ok':True,'catalog':_offline_regions_i698.catalog(),
                                'geojson':_offline_regions_i698.collection(),
                                'internal_tile_limit':TAK_MAP_OFFLINE_DOWNLOAD_MAX_TILES})
    return _I698_PREVIOUS_GET(self)

_I698_PREVIOUS_POST = Handler.do_POST
def _offline_post_i698(self):
    route=urlparse(self.path).path
    if route in ('/api/tak-map/offline-retry-i698','/api/tak-map/offline-finish-i698'):
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        try:
            payload=_read_json_body(self)
            if not isinstance(payload,dict):raise ValueError('Expected JSON object')
            answer=(_OFFLINE_MAPS_I698.retry(payload.get('id')) if route.endswith('retry-i698')
                    else _OFFLINE_MAPS_I698.finish(payload.get('id')))
            return self._send_json(answer,200 if answer.get('ok') else 400)
        except Exception as exc:
            return self._send_json({'ok':False,'error':str(exc)},400)
    return _I698_PREVIOUS_POST(self)

Handler.do_GET = _offline_get_i698
Handler.do_POST = _offline_post_i698
