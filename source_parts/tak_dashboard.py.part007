# --- TAK Map i666: proven DOM hotfix, VEIL Phase 2 and route/UI corrections ---
from tak_map_veil_api_i666 import VeilApiSyncManager as _VeilApiSyncManagerI666
VEIL_API_I666 = _VeilApiSyncManagerI666(VEIL_I665)
_i666_previous_get=Handler.do_GET
_i666_previous_post=Handler.do_POST

def _i666_get(self):
    _route=urlparse(self.path).path
    if _route=='/assets/runtime/tak-map-veil-i666.js':
        _data=(Path(__file__).resolve().parent/'assets'/'tak-map-veil-i666.js').read_bytes()
        self.send_response(200)
        self.send_header('Content-Type','application/javascript; charset=utf-8')
        self.send_header('Content-Length',str(len(_data)))
        self.send_header('Cache-Control','no-cache')
        self.end_headers()
        if self.command!='HEAD':self.wfile.write(_data)
        return
    if _route.startswith('/api/tak-map/veil/'):
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        _sub=_route.rsplit('/',1)[-1]
        if _sub=='status':
            _data=VEIL_I665.status()
            _by_id=VEIL_API_I666.status()
            for _node in _data['nodes']:_node.update(_by_id.get(_node['nodeId'],{}))
            return self._send_json(_data)
        if _sub=='prompt-check':
            if not _veil_admin_authorized_i668(self):
                return self._send_json({'ok':False,'admin_required':True,'error':'VEIL API authorization check requires an administrator login in TAK Map or the Dashboard over HTTPS.'},403)
            from urllib.parse import parse_qs as _parse_qs
            _query=_parse_qs(urlparse(self.path).query)
            try:
                _node=str(_query.get('nodeId',[''])[0])[:120]
                _generation=int(_query.get('generation',[0])[0])
                return self._send_json(VEIL_API_I666.prompt_check(_node,_generation))
            except (ValueError,TypeError):return self._send_json({'ok':True,'show':False})
    return _i666_previous_get(self)
Handler.do_GET=_i666_get

def _i666_post(self):
    _route=urlparse(self.path).path
    if _route not in ('/api/tak-map/veil/pair','/api/tak-map/veil/unpair',
                       '/api/tak-map/veil/remove','/api/tak-map/veil/settings'):
        return _i666_previous_post(self)
    if not _veil_admin_authorized_i668(self):
        return self._send_json({'ok':False,'admin_required':True,'error':'VEIL settings and API pairing require an administrator login in TAK Map or the Dashboard over HTTPS.'},403)
    try:
        _length=int(self.headers.get('Content-Length','0') or '0')
        if not 0<=_length<=16384:raise ValueError('Request too large')
        _data=_read_json_body(self)
        if _route.endswith('/pair'):
            _answer=VEIL_API_I666.pair(str(_data.get('nodeId','')),
                str(_data.get('username','')),str(_data.get('password','')),
                bool(_data.get('remember',False)))
        elif _route.endswith('/unpair'):
            _answer=VEIL_API_I666.unpair(str(_data.get('nodeId','')))
        elif _route.endswith('/settings'):
            _answer=VEIL_I665.settings(_data)
            VEIL_API_I666.on_toggle()
        else:
            _node_id=str(_data.get('nodeId',''))
            _answer=VEIL_I665.remove(_node_id)
            VEIL_API_I666.remove(_node_id)
        return self._send_json(_answer)
    except (__import__('tak_map_veil_api_i666').AuthRequired,) as _exc:
        return self._send_json({'ok':False,'error':'VEIL rejected the login credentials'},401)
    except (__import__('tak_map_veil_api_i666').NodeUnavailable,) as _exc:
        return self._send_json({'ok':False,'error':'VEIL API not reachable or node identity mismatch'},503)
    except (ValueError,TypeError,OSError) as _exc:
        return self._send_json({'ok':False,'error':str(_exc)[:160]},400)
Handler.do_POST=_i666_post
