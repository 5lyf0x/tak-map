            'version': _I595_VERSION,
            'complete_discovery_record_retained_in_authorized_worker_memory': True,
            'authorized_detail_metadata_merged_without_replacing_discovery_contents': True,
            'uids_and_contents_released_only_after_password_validation': True,
            'post_unlock_objects_populate_snapshot_and_map': True,
        }
        startup = dict(cfg.get('startup_architecture_i594') or cfg.get('startup_architecture_i593') or {})
        startup.update({
            'package_version': _I595_VERSION,
            'startup_loader_cache_identity': _I595_PACKAGE_VERSION,
            'manifest_cache_identity': _I595_PACKAGE_VERSION,
            'data_sync_control_cache_identity': _I595_PACKAGE_VERSION,
        })
        cfg['startup_architecture_i595'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i595_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+(?:-[A-Za-z0-9_-]+)?', _I595_PACKAGE_VERSION, html)
        html = re.sub(r'TAKDashboard/i\d+(?:-[A-Za-z0-9_-]+)?', 'TAKDashboard/i595', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i595', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i595\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i595\2', html)
        return html

    TAK_MAP_HTML = _i595_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i595_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I595_VERSION
except Exception as _i595_exc:
    try:
        print('TAK Map i595 protected-Mission content merge patch failed:', _i595_exc)
    except Exception:
        pass
# --- end TAK Map i595 authorized protected-Mission discovery/detail merge ---


# --- TAK Map i596 post-filter Mission access continuity correction ---
try:
    _I596_VERSION = 'i596'
    _I596_PACKAGE_VERSION = '1.3.0-i596'

    def _i596_first_nonempty_access(payload):
        if not isinstance(payload, dict):
            return []
        fallback = []
        for key in ('mission_access_i596', 'mission_access_i594', 'mission_access_i591',
                    'mission_access_i576', 'mission_access_i575', 'mission_access_i573',
                    'mission_access_i572', 'mission_access_i595'):
            rows = payload.get(key)
            if not isinstance(rows, list):
                continue
            fallback = rows
            if rows:
                return rows
        return fallback

    def _i596_access_descriptor(row, refreshing=False):
        row = dict(row or {})
        mission = _i591_text(row.get('mission') or row.get('name'))
        protected = bool(row.get('protected') or row.get('password_protected'))
        unlocked = bool(row.get('unlocked')) if protected else True
        return {
            'name': mission,
            'mission': mission,
            'passwordProtected': protected,
            'password_protected': protected,
            'protected': protected,
            'locked': bool(protected and not unlocked),
            'unlocked': bool(unlocked),
            'metadata_only': True,
            'locked_descriptor_i594': bool(protected and not unlocked),
            'refreshing_contents_i596': bool(refreshing),
            'source': 'ots-mission-access-continuity-i596',
        }

    _i596_filter_before = _i594_filter_security_view
    def _i594_filter_security_view(payload, state, sess=None):
        out, status = _i596_filter_before(payload, state, sess)
        if not isinstance(out, dict):
            return out, status
        out = _i568_clone(out)

        # i595 could publish an empty current-generation array before the final
        # i594 security filter calculated the real Mission access rows. Select
        # the first nonempty post-filter array and promote it only now.
        access_rows = list(_i596_first_nonempty_access(out) or [])
        if not access_rows:
            try:
                access_rows = list(_i594_access_rows(state, sess) or [])
            except Exception:
                access_rows = []

        missions = list(out.get('missions') or []) if isinstance(out.get('missions'), list) else []
        mission_names = {
            _i591_mission_name(row).casefold()
            for row in missions
            if _i591_mission_name(row)
        }
        objects = out.get('objects') if isinstance(out.get('objects'), list) else []
        packages = out.get('packages') if isinstance(out.get('packages'), list) else []
        content = out.get('mission_content') if isinstance(out.get('mission_content'), list) else []
        reconstructed = []
        normalized_access = []

        for raw in access_rows:
            row = dict(raw or {})
            mission = _i591_text(row.get('mission') or row.get('name'))
            if not mission:
                continue
            protected = bool(row.get('protected') or row.get('password_protected'))
            unlocked = bool(row.get('unlocked')) if protected else True
            folded_mission = mission.casefold()
            missing_mission_row = folded_mission not in mission_names
            has_mission_content = any(
                _i591_mission_name(item).casefold() == folded_mission
                for collection in (objects, packages, content)
                for item in collection
                if _i591_mission_name(item)
            )
            refreshing = bool(unlocked and missing_mission_row and not has_mission_content)
            row['version'] = _I596_VERSION
            row['mission'] = mission
            row['protected'] = protected
            row['password_protected'] = protected
            row['unlocked'] = unlocked
            row['locked'] = bool(protected and not unlocked)
            row['refreshing_contents_i596'] = refreshing
            normalized_access.append(row)
            if missing_mission_row:
                descriptor = _i596_access_descriptor(row, refreshing=refreshing)
                missions.append(descriptor)
                mission_names.add(mission.casefold())
                reconstructed.append(mission)

        out['missions'] = missions
        out['mission_access_i596'] = _i568_clone(normalized_access)
        # Keep stale i595 browser assets functional during cache rollover.
        if not isinstance(out.get('mission_access_i595'), list) or not out.get('mission_access_i595'):
            out['mission_access_i595'] = _i568_clone(normalized_access)
        out['version'] = _I596_VERSION
        out['data_sync_transition_i596'] = {
            'version': _I596_VERSION,
            'post_security_filter_access_promotion': True,
            'first_nonempty_access_array': True,
            'mission_rows_reconstructed_from_access': bool(reconstructed),
            'reconstructed_missions': reconstructed,
            'refreshing_contents': any(bool(row.get('refreshing_contents_i596')) for row in normalized_access),
            'empty_transition_does_not_hide_mission': True,
        }
        return out, status
    globals()['_i594_filter_security_view'] = _i594_filter_security_view

    _i596_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i596_config_before() or {})
        cfg['version'] = _I596_PACKAGE_VERSION
        cfg['tak_map_iteration'] = _I596_VERSION
        cfg['data_sync_access_continuity_i596'] = {
            'version': _I596_VERSION,
            'mission_access_generated_after_final_security_filter': True,
            'first_nonempty_access_array_selected': True,
            'mission_rows_reconstructed_from_access_state': True,
            'unlocked_refreshing_contents_state_preserved': True,
            'empty_transitional_snapshot_does_not_hide_mission': True,
            'unrelated_runtime_behavior_unchanged': True,
        }
        startup = dict(cfg.get('startup_architecture_i595') or cfg.get('startup_architecture_i594') or {})
        startup.update({
            'package_version': _I596_VERSION,
            'startup_loader_cache_identity': _I596_PACKAGE_VERSION,
            'manifest_cache_identity': _I596_PACKAGE_VERSION,
            'data_sync_control_cache_identity': _I596_PACKAGE_VERSION,
        })
        cfg['startup_architecture_i596'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i596_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+(?:-[A-Za-z0-9_-]+)?', _I596_PACKAGE_VERSION, html)
        html = re.sub(r'TAKDashboard/i\d+(?:-[A-Za-z0-9_-]+)?', 'TAKDashboard/i596', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i596', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i596\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i596\2', html)
        return html

    TAK_MAP_HTML = _i596_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i596_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I596_VERSION
except Exception as _i596_exc:
    try:
        print('TAK Map i596 Data Sync access-continuity patch failed:', _i596_exc)
    except Exception:
        pass
# --- end TAK Map i596 post-filter Mission access continuity correction ---


# --- TAK Map i597 Mission status-chip package identity ---
try:
    _I597_VERSION = 'i597'
    _I597_PACKAGE_VERSION = '1.3.0-i597'

    _i597_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i597_config_before() or {})
        cfg['version'] = _I597_PACKAGE_VERSION
