                    'status': 200 if marker_token else 401,
                    'source': 'existing-flask-security-login-token',
                }
            if not marker_token:
                cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
                marker_login = _i583hf4_login_marker_token(cfg or {}, username, password)
                marker_token = _i583hf4_text(marker_login.get('token'))
        session_token = _i583hf4_create_profile_session_before(
            username, password, auth_mode, is_admin, auth, profile)
