# --- TAK Map i691: approved native NOAA/NWS weather layers and relief overlay removal ---
import time as _weather_time_i691
import json as _weather_json_i691
import re as _weather_re_i691
import threading as _weather_threading_i691
import urllib.request as _weather_req_i691
import urllib.error as _weather_urlerror_i691
from xml.etree import ElementTree as _weather_xml_i691

_WEATHER_LOCK_I691=_weather_threading_i691.RLock()
_WEATHER_CACHE_I691={}
_WEATHER_RADAR_WMS_I691='https://nowcoast.noaa.gov/arcgis/services/nowcoast/radar_meteo_imagery_nexrad_time/MapServer/WmsServer'
_WEATHER_NWS_I691='https://api.weather.gov/alerts/active'

def _weather_upstream_i691(cache_key,url,ttl,size_limit,accept):
    now=_weather_time_i691.monotonic()
    with _WEATHER_LOCK_I691:
        cached=_WEATHER_CACHE_I691.get(cache_key)
        if cached and now<cached['expires']:return cached['payload']
    req=_weather_req_i691.Request(url,headers={
        'User-Agent':'TAKMap/1.4.0-i691 (native-weather-overlay; tak-map local server)',
        'Accept':accept,'Accept-Encoding':'identity'})
    try:
        with _weather_req_i691.urlopen(req,timeout=12) as resp:
            payload=resp.read(size_limit+1)
            if len(payload)>size_limit:raise ValueError('Weather provider payload exceeds size limit')
    except (OSError,ValueError) as exc:
        # Never silently present expired provider metadata as current.
        raise exc
    with _WEATHER_LOCK_I691:
        _WEATHER_CACHE_I691[cache_key]={'payload':payload,'expires':now+ttl,'observed':now}
    return payload

def _weather_alerts_i691():
    raw=_weather_upstream_i691('alerts',_WEATHER_NWS_I691,90,16000000,'application/geo+json')
    data=_weather_json_i691.loads(raw)
    if not isinstance(data,dict) or data.get('type')!='FeatureCollection' or not isinstance(data.get('features'),list):
        raise ValueError('Unexpected NWS GeoJSON response')
    # Return the provider's original geometries and properties; geometryless
    # alerts remain counted, never replaced with invented area polygons.
    return data

def _weather_radar_i691():
    # WMS GetCapabilities is authoritative for layer name and advertised time.
    uri=_WEATHER_RADAR_WMS_I691+'?service=WMS&request=GetCapabilities&version=1.3.0'
    raw=_weather_upstream_i691('radar',uri,120,2500000,'application/xml,text/xml')
    root=_weather_xml_i691.fromstring(raw)
    layer=None;latest=None
    for item in root.iter():
        if item.tag.rsplit('}',1)[-1]!='Layer':continue
        names=[x.text or '' for x in item if x.tag.rsplit('}',1)[-1]=='Name']
        if names and any('mrms_basereflect' in n.lower() for n in names):
            layer=names[0]
            for c in item:
                if c.tag.rsplit('}',1)[-1] in ('Dimension','Extent') and c.attrib.get('name','').lower()=='time':
                    # Time can be ranges, steps, or comma-separated values;
                    # do not manufacture valid timestamps from fetch time.
                    value=(c.text or '').strip()
                    latest=value.split(',')[-1].split('/')[1] if '/' in value and len(value.split('/'))>=2 else value.split(',')[-1]
            break
    if not layer:raise ValueError('MRMS reflectivity layer not advertised')
    if latest and not _weather_re_i691.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d(?::\d\d)?Z',latest):latest=None
    return {'ok':True,'layer':layer,'valid_time':latest,'source':'NOAA nowCOAST WMS capabilities'}

_I691_PREVIOUS_GET=Handler.do_GET
def _weather_get_i691(self):
    path=urlparse(self.path).path
    if path in ('/assets/runtime/tak-map-weather-i691.js','/assets/runtime/tak-map-weather-i691.css'):
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        filename=path.rsplit('/',1)[-1]
        file=Path(__file__).resolve().parent/'assets'/filename
        if not file.is_file():
            self.send_response(404);self.send_header('Content-Length','0');self.end_headers();return
        body=file.read_bytes()
        self.send_response(200)
        self.send_header('Content-Type',('text/css' if filename.endswith('.css') else 'application/javascript')+'; charset=utf-8')
        self.send_header('Cache-Control','private, no-store')
        self.send_header('X-Content-Type-Options','nosniff')
        self.send_header('Content-Length',str(len(body)));self.end_headers()
        if self.command!='HEAD':self.wfile.write(body)
        return
    if path in ('/api/tak-map/weather/alerts-i691','/api/tak-map/weather/radar-i691'):
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        try:
            result=_weather_alerts_i691() if path.endswith('alerts-i691') else _weather_radar_i691()
            return self._send_json(result)
        except Exception as exc:
            self.send_response(503)
            body=_weather_json_i691.dumps({'ok':False,'error':'Weather provider unavailable'}).encode()
            self.send_header('Content-Type','application/json');self.send_header('Cache-Control','no-store')
            self.send_header('Content-Length',str(len(body)));self.end_headers()
            if self.command!='HEAD':self.wfile.write(body)
            try:print('TAK Map native weather provider failed:',type(exc).__name__,str(exc)[:180])
            except Exception:pass
            return
    return _I691_PREVIOUS_GET(self)
Handler.do_GET=_weather_get_i691

# Narrow template cleanup: the obsolete relief control is an optional overlay,
