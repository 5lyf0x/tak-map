# --- TAK Map i583 reversible Mission-marker hotfix hf4: login-time OTS marker token and query authentication ---
try:
    _I583_HF4_VERSION = 'i583-hf4'
    _I583_HF4_SESSION_TOKEN_FIELD = 'ots_marker_auth_token_i583_hf4'

    def _i583hf4_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i583hf4_extract_authentication_token(payload):
        if not isinstance(payload, dict):
            return ''
        response = payload.get('response') if isinstance(payload.get('response'), dict) else {}
        user = response.get('user') if isinstance(response.get('user'), dict) else {}
        candidates = [
            user.get('authentication_token'),
            user.get('auth_token'),
            response.get('authentication_token'),
            response.get('auth_token'),
            payload.get('authentication_token'),
            payload.get('auth_token'),
        ]
        return next((_i583hf4_text(value) for value in candidates if _i583hf4_text(value)), '')

    def _i583hf4_ssl_context(cfg):
        return _i509_ssl_context(cfg) if '_i509_ssl_context' in globals() else None

    def _i583hf4_login_marker_token(cfg, username, password):
        """Acquire the Flask-Security token while the login password is still in memory."""
        username = _i583hf4_text(username)
        password = str(password or '')
        base = _i583hf4_text((cfg or {}).get('base_url') or (cfg or {}).get('api_url')).rstrip('/')
        if not base:
            return {'ok': False, 'status': 0, 'error': 'OpenTAKServer Web/API URL is not configured.'}
        if not username or not password:
            return {'ok': False, 'status': 401, 'error': 'OTS username/password were unavailable during login.'}
        path = _i583hf4_text((cfg or {}).get('api_login_path') or '/api/login')
        url = base + ('/' + path.lstrip('/')) + ('&' if '?' in path else '?') + 'include_auth_token='
        body = json.dumps({'username': username, 'password': password}, separators=(',', ':')).encode('utf-8')
        headers = {
            'Accept': 'application/json',
            'Content-Type': 'application/json; charset=UTF-8',
            'Content-Length': str(len(body)),
            'Referer': base + '/',
            'User-Agent': 'TAKDashboard/i583-hf4 MarkerTokenLogin',
        }
        request_obj = Request(url, data=body, headers=headers, method='POST')
        started = time.monotonic()
        try:
            with urlopen(request_obj, timeout=15, context=_i583hf4_ssl_context(cfg)) as response:
                raw = response.read(262144).decode('utf-8', errors='replace')
                status = int(getattr(response, 'status', 200) or 200)
                try:
                    parsed = json.loads(raw) if raw else {}
                except Exception:
                    parsed = {}
                token = _i583hf4_extract_authentication_token(parsed)
                if 200 <= status < 300 and token:
                    return {
                        'ok': True,
                        'status': status,
                        'token': token,
                        'duration_seconds': round(time.monotonic() - started, 3),
                    }
                return {
                    'ok': False,
                    'status': status,
                    'error': 'OpenTAKServer login did not return response.user.authentication_token.',
                    'duration_seconds': round(time.monotonic() - started, 3),
                }
        except HTTPError as exc:
            try:
                raw = exc.read(4096).decode('utf-8', errors='replace')
            except Exception:
                raw = ''
            return {
                'ok': False,
                'status': int(getattr(exc, 'code', 0) or 0),
                'error': raw[:1000] or str(exc),
                'duration_seconds': round(time.monotonic() - started, 3),
            }
        except Exception as exc:
            return {
                'ok': False,
                'status': 0,
                'error': str(exc),
                'duration_seconds': round(time.monotonic() - started, 3),
            }

    # Capture the dedicated marker token before i529 clears the OTS password.
    _i583hf4_create_profile_session_before = _i511_create_profile_session
    def _i511_create_profile_session(username, password, auth_mode, is_admin, auth, profile):
        auth_mode_text = _i583hf4_text(auth_mode)
