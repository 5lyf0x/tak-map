# --- TAK Map v1.4.0-i696: NOAA historical radar observation playback ---
# Preserve i693 LIVE radar, NWS alerts, authentication and all existing routes.
import tak_map_radar_history_i696 as _radar_history_i696

_I696_PREVIOUS_GET = Handler.do_GET

def _weather_get_i696(self):
    path = urlparse(self.path).path
    if path in ('/assets/runtime/tak-map-radar-history-i696.js',
                '/assets/runtime/tak-map-radar-history-i696.css'):
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        asset = Path(__file__).resolve().parent / 'assets' / path.rsplit('/', 1)[-1]
        if not asset.is_file():
            self.send_response(404)
            self.send_header('Content-Length', '0')
            self.end_headers()
            return
        payload = asset.read_bytes()
        self.send_response(200)
        self.send_header('Content-Type', ('text/css' if path.endswith('.css') else 'application/javascript') + '; charset=utf-8')
        self.send_header('Cache-Control', 'private, no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Content-Length', str(len(payload)))
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(payload)
        return
    if path == '/api/tak-map/weather/radar/history-i696' or path.startswith('/api/tak-map/weather/radar/history-tile-i696/'):
        if not self._tak_map_auth_ok():
            return self._require_tak_map_login()
        try:
            from urllib.parse import parse_qs as _i696_parse_qs
            params = _i696_parse_qs(urlparse(self.path).query, keep_blank_values=True)
            if path == '/api/tak-map/weather/radar/history-i696':
                if set(params) - {'window'} or len(params.get('window', ['60'])) != 1:
                    raise _radar_i693.RadarError('invalid_window')
                value = params.get('window', ['60'])[0]
                if value not in ('30','60','120','240'):
                    raise _radar_i693.RadarError('invalid_window')
                return self._send_json(_radar_history_i696.history(int(value)))
            if set(params) != {'frame'} or len(params['frame']) != 1:
                raise _radar_i693.RadarError('invalid_frame')
            z, x, y = _radar_history_i696.parse_tile(path)
            payload = _radar_history_i696.tile(z, x, y, params['frame'][0])
            self.send_response(200)
            self.send_header('Content-Type', 'image/png')
            self.send_header('Cache-Control', 'private, max-age=120')
            self.send_header('X-Content-Type-Options', 'nosniff')
            self.send_header('Content-Length', str(len(payload)))
            self.end_headers()
            if self.command != 'HEAD':
                self.wfile.write(payload)
            return
        except _radar_i693.RadarError as exc:
            code = 400 if exc.code.startswith('invalid_') else 409 if 'expired' in exc.code else 503
            return self._send_json({'ok': False, 'error_code': exc.code}, code)
    return _I696_PREVIOUS_GET(self)

Handler.do_GET = _weather_get_i696
TAK_MAP_HTML = TAK_MAP_HTML.replace('</head>',
