            'safe_alias_or_unique_overlap_remap': True,
            'never_cross_recordings_silently': True,
            'i627_state_proxy_preserved': True,
            'live_map_unchanged': True,
        }
        return cfg
    globals()['tak_map_config'] = tak_map_config
except Exception as _i628_final_exc:
    try:
        print('TAK Map i628 final Replay maintenance recovery guard failed:', _i628_final_exc)
    except Exception:
        pass
# --- end TAK Map i628 FINAL Replay maintenance-aware recovery delivery guard ---

