TAK_MAP_HTML=_weather_re_i691.sub(r'<div class="relief-controls(?: tak-relief-controls-v506)?">.*?</div>','',TAK_MAP_HTML,flags=_weather_re_i691.S)
TAK_MAP_HTML=TAK_MAP_HTML.replace('</head>','<link rel="stylesheet" href="/assets/runtime/tak-map-weather-i691.css?v=1.4.0-i691"></head>',1)
TAK_MAP_HTML=TAK_MAP_HTML.replace('</body>','<script defer src="/assets/runtime/tak-map-weather-i691.js?v=1.4.0-i691"></script></body>',1)
TAK_MAP_HTML=TAK_MAP_HTML.replace("ITERATION='i690'","ITERATION='i691'").replace("const iteration='i690'","const iteration='i691'")
TAK_MAP_HTML=_weather_re_i691.sub(r'([?&]v=)1\.4\.0-i\d+',r'\g<1>1.4.0-i691',TAK_MAP_HTML)
TAK_MAP_HTML=_weather_re_i691.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\g<1>i691\2',TAK_MAP_HTML)
TAK_MAP_HTML=_weather_re_i691.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\g<1>i691\2',TAK_MAP_HTML)
TAK_MAP_HTML=TAK_MAP_HTML.replace('tak-map-v1.4.0-i690.zip','tak-map-v1.4.0-i691.zip')
