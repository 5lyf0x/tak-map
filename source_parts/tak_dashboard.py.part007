                sess=_i570_context_session() if callable(globals().get('_i570_context_session')) else {}
                state_key=_i570_context_state_key(cfg,sess) if callable(globals().get('_i570_context_state_key')) else None
                if state_key is not None and callable(globals().get('_i568_schedule_refresh')):
                    _i568_schedule_refresh(state_key,cfg or {},sess or {},_i643_text((sess or {}).get('_i570_token') or (sess or {}).get('token')),'i643-post-native-shape-save',force=True)
            except Exception:
                pass
            out=dict(base); out['edit']=edit; out['edits']=data; out['shape_geometry_i639']=geom
            out['shape_edit_i639']={'canonical_tak_geometry':True,'uid_preserved':True,'mission_membership_preserved':True,'server_cot_updated':True,'persisted_overlay':True,'readback_contract':'native-shape-global-ingest-contents-association-mission-readback-i643','saved_uid':uid,'saved_at':edit['updated']}
            tx={
