        out['marker_api_auth_version'] = _I583_HF4_VERSION
        out['marker_api_relogin_required'] = bool(is_ots and not out['marker_api_auth_ready'])
        return out
    globals()['_i509_session_public'] = _i509_session_public

    _i583hf4_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i583hf4_config_before() or {})
        handoff = dict(cfg.get('data_sync_create_handoff_i583_hf1') or {})
        handoff.update({
