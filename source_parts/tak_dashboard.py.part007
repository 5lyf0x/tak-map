TAK_MAP_HTML = _weather_re_i691.sub(r'([?&]v=)1\.4\.0-i\d+', r'\g<1>1.4.0-i693', TAK_MAP_HTML)
TAK_MAP_HTML = _weather_re_i691.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\g<1>i693\2', TAK_MAP_HTML)
TAK_MAP_HTML = _weather_re_i691.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\g<1>i693\2', TAK_MAP_HTML)
