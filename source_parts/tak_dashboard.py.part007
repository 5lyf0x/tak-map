TAK_MAP_HTML=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\g<1>i687\2',TAK_MAP_HTML)
TAK_MAP_HTML=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\g<1>i687\2',TAK_MAP_HTML)
TAK_MAP_HTML=TAK_MAP_HTML.replace('tak-map-v1.4.0-i684.zip','tak-map-v1.4.0-i687.zip')
TAK_MAP_HTML=TAK_MAP_HTML.replace('</head>', '<link rel="stylesheet" href="/assets/runtime/tak-map-infrastructure-i687.css?v=1.4.0-i687"></head>',1)
TAK_MAP_HTML=TAK_MAP_HTML.replace('</body>', '<script defer src="/assets/runtime/tak-map-infrastructure-i687.js?v=1.4.0-i687"></script></body>',1)
