# --- TAK Map i688: offline-only Infrastructure API, indexed search and per-layer filters ---
from tak_map_infrastructure_i688 import (
    catalog as _infra_catalog_i688, mutate as _infra_mutate_i688,
    get_features as _infra_features_i688, layer_fields as _infra_fields_i688,
    search_features as _infra_search_i688, feature_by_id as _infra_one_i688,
)
_I688_GET_PREVIOUS=Handler.do_GET
_I688_POST_PREVIOUS=Handler.do_POST

def _infra_get_i688(self):
    parsed=urlparse(self.path);route=parsed.path
    if route in ('/assets/runtime/tak-map-infrastructure-i688.js',
                 '/assets/runtime/tak-map-infrastructure-i688.css'):
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        ext='js' if route.endswith('.js') else 'css'
        target=Path(__file__).resolve().parent / ('assets/tak-map-infrastructure-i688.'+ext)
        body=target.read_bytes()
        self.send_response(200)
        self.send_header('Content-Type','application/javascript; charset=utf-8' if ext=='js' else 'text/css; charset=utf-8')
        self.send_header('Cache-Control','private, no-store')
        self.send_header('Content-Length',str(len(body)))
        self.end_headers()
        if self.command!='HEAD':self.wfile.write(body)
        return
    if route not in ('/api/tak-map/infrastructure/state',
                     '/api/tak-map/infrastructure/features',
                     '/api/tak-map/infrastructure/search',
                     '/api/tak-map/infrastructure/feature',
                     '/api/tak-map/infrastructure/fields'):
        return _I688_GET_PREVIOUS(self)
    if not self._tak_map_auth_ok():return self._require_tak_map_login()
    query=parse_qs(parsed.query)
    value=lambda name,default='':(query.get(name) or [default])[0]
    try:
        if route.endswith('/state'):result=_infra_catalog_i688()
        elif route.endswith('/features'):
            result=_infra_features_i688(value('layer'),value('mode','offline'),value('bbox'),float(value('minimum','36')),
                 int(value('offset','0')),int(value('chunk','0')),float(value('zoom')) if value('zoom') else None)
        elif route.endswith('/search'):
            result=_infra_search_i688(value('q'),int(value('limit','24')),float(value('minimum','36')))
        elif route.endswith('/feature'):
            result=_infra_one_i688(value('layer'),value('id'),float(value('minimum','36')))
        else:result=_infra_fields_i688(value('layer'))
        return self._send_json(result)
    except Exception as error:return _infra_api_error_i687(self,error)

def _infra_post_i688(self):
    route=urlparse(self.path).path
    if route!='/api/tak-map/infrastructure/manage':
        return _I688_POST_PREVIOUS(self)
    if not self._tak_map_auth_ok():return self._require_tak_map_login()
    try:
        length=int(self.headers.get('Content-Length') or '-1')
        if length<0 or length>2*1024*1024:raise ValueError('Invalid infrastructure operation size')
        body=json.loads(self.rfile.read(length) or b'{}')
        return self._send_json(_infra_mutate_i688(body))
    except Exception as error:return _infra_api_error_i687(self,error)
