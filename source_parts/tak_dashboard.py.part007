        return {'ok':False,'mission':mission,'event_uid':uid,'source':'mission-cot-get-native-shape-readback-i643','geometry_match':False,'attempts':attempts,'error':'Mission /cot GET did not return the edited native Shape geometry within the bounded confirmation window.'}

