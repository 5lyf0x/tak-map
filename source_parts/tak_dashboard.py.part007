            if _i580_name:
                _I580_NAME_TO_CONCEPT[_i580_name] = _i580_concept
            _i580_sidc = str(_i580_display.get('sidc') or '').strip().upper()
            if _i580_sidc:
                _I580_DISPLAY_SIDC_TO_CONCEPT.setdefault(_i580_sidc, set()).add(_i580_concept)

    def _i580_text(value):
        return str(value or '').strip()

    def _i580_nested_dicts(value, limit=120):
        out, stack, seen = [], [value], set()
        while stack and len(out) < limit:
            current = stack.pop()
            if not isinstance(current, dict) or id(current) in seen:
                continue
            seen.add(id(current)); out.append(current)
            for nested in current.values():
                if isinstance(nested, dict): stack.append(nested)
        return out

    def _i580_value(value, *keys):
        for obj in _i580_nested_dicts(value):
            for key in keys:
                if obj.get(key) not in (None, ''):
                    return obj.get(key)
        return ''

    def _i580_affiliation(value):
        name = _i580_text(_i580_value(value, 'mil2525_name','milstd2525_name','mil2525_file')).lower()
        for word, code in (('friendly-','F'),('hostile-','H'),('neutral-','N'),('unknown-','U')):
            if name.startswith(word): return code
        cot = _i580_text(_i580_value(value, 'cot_type','atak_cot_type','event_type','type')).lower()
        match = re.match(r'^a-([fhnu])(?:-|$)', cot)
        if match: return match.group(1).upper()
        sidc = _i580_text(_i580_value(value, 'sidc','SIDC','mil2525_sidc')).upper()
        if len(sidc) > 1 and sidc[1] in 'FHNU': return sidc[1]
        return 'F'

    def _i580_concept(value):
        explicit = _i580_text(_i580_value(value, 'takmap_symbology_concept_i580','symbologyConceptI580','symbologyConcept')).lower()
        if explicit in _I580_CONCEPTS: return explicit
        name = _i580_text(_i580_value(value, 'mil2525_name','milstd2525_name','mil2525_file','mil2525_svg')).lower()
        name = name.rsplit('/',1)[-1].rsplit('\\',1)[-1].removesuffix('.svg')
        if name in _I580_NAME_TO_CONCEPT: return _I580_NAME_TO_CONCEPT[name]
        for prefix in ('friendly-','hostile-','neutral-','unknown-'):
            if name.startswith(prefix) and name[len(prefix):] in _I580_CONCEPTS:
                return name[len(prefix):]
        sidc = _i580_text(_i580_value(value, 'sidc','SIDC','mil2525_sidc')).upper()
        matches = _I580_DISPLAY_SIDC_TO_CONCEPT.get(sidc) or set()
        return next(iter(matches)) if len(matches) == 1 else ''

    def _i580_pair(concept, affiliation):
        return dict((((_I580_CONCEPTS.get(concept) or {}).get('affiliations') or {}).get(affiliation) or {}))

    def _i580_transport_feature(feature):
        if not isinstance(feature, dict): return feature
        concept = _i580_concept(feature)
        if not concept: return _i580_copy.deepcopy(feature)
        aff = _i580_affiliation(feature)
        pair = _i580_pair(concept, aff)
        display, transport = dict(pair.get('display') or {}), dict(pair.get('transport') or {})
        if not display or not transport: return _i580_copy.deepcopy(feature)
        out = _i580_copy.deepcopy(feature)
        props = out.get('properties') if isinstance(out.get('properties'), dict) else out
        if props is not out and not isinstance(props, dict): props = {}; out['properties'] = props
        for target in (out, props):
            target['takmap_symbology_concept_i580'] = concept
            target['takmap_transport_decision_i580'] = (_I580_CONCEPTS.get(concept) or {}).get('decision') or ''
            target['takmap_display_name_i580'] = display.get('name') or ''
            target['takmap_display_sidc_i580'] = display.get('sidc') or ''
            target['takmap_display_cot_type_i580'] = display.get('cot_type') or ''
            target['takmap_transport_sidc_i580'] = transport.get('sidc') or ''
            target['takmap_transport_cot_type_i580'] = transport.get('cot_type') or ''
            target['takmap_transport_usericon_i580'] = transport.get('usericon_path') or ''
            target['sidc'] = transport.get('sidc') or target.get('sidc') or ''
            target['SIDC'] = target['sidc']
            target['cot_type'] = transport.get('cot_type') or target.get('cot_type') or ''
            target['atak_cot_type'] = target['cot_type']
            # Preserve the reviewed TAK Map artwork identity separately from transport.
            target['mil2525_name'] = display.get('name') or target.get('mil2525_name') or ''
            target['mil2525_label'] = display.get('label') or target.get('mil2525_label') or ''
        return out

    _i580_point_type_before = _i526_point_type
    def _i526_point_type(feature):
        exact = _i580_text(_i580_value(feature, 'takmap_transport_cot_type_i580'))
        return exact[:96] if exact else _i580_point_type_before(feature)
    globals()['_i526_point_type'] = _i526_point_type

    _i580_publish_before = tak_map_publish_native_points_to_mission_i526
    def tak_map_publish_native_points_to_mission_i526(features, mission_name='', server_host='', creator_uid=''):
        mapped = [_i580_transport_feature(row) for row in (features or [])]
        out = _i580_publish_before(mapped, mission_name, server_host, creator_uid)
        if isinstance(out, dict):
            out = dict(out); out['version'] = 'i580'
            out['atak_symbology_transport_i580'] = {'applied': True, 'concept_count': 162, 'affiliation_preserved': True}
        return out
    globals()['tak_map_publish_native_points_to_mission_i526'] = tak_map_publish_native_points_to_mission_i526
    for _i580_alias in ('tak_map_publish_native_points_to_mission_i527','tak_map_publish_native_points_to_mission_i528'):
        if _i580_alias in globals(): globals()[_i580_alias] = tak_map_publish_native_points_to_mission_i526

    _i580_xml_before = _i526_point_xml
    def _i526_point_xml(feature, mission_name, creator_uid=''):
        built = _i580_xml_before(feature, mission_name, creator_uid)
        if not isinstance(built, dict) or not built.get('ok'): return built
        concept = _i580_text(_i580_value(feature, 'takmap_symbology_concept_i580'))
        if not concept: return built
        try:
            root = ET.fromstring(_i580_text(built.get('xml')).encode('utf-8'))
            detail = root.find('detail')
            if detail is None: detail = ET.SubElement(root, 'detail')
            meta = detail.find('takmap_point')
            if meta is None: meta = ET.SubElement(detail, 'takmap_point')
            attrs = {
                'version':'i580', 'symbologyConceptI580':concept,
                'displayNameI580':_i580_text(_i580_value(feature,'takmap_display_name_i580')),
                'displaySidcI580':_i580_text(_i580_value(feature,'takmap_display_sidc_i580')),
                'displayCotTypeI580':_i580_text(_i580_value(feature,'takmap_display_cot_type_i580')),
                'transportDecisionI580':_i580_text(_i580_value(feature,'takmap_transport_decision_i580')),
                'transportSidcI580':_i580_text(_i580_value(feature,'takmap_transport_sidc_i580')),
                'transportCotTypeI580':_i580_text(_i580_value(feature,'takmap_transport_cot_type_i580')),
            }
            for key,value in attrs.items():
                if value: meta.set(key, value[:240])
            # Preserve the authoritative ATAK transport SIDC even for Emergency
            # Management scheme-E symbols that the older S-only normalizer does
            # not understand. The reviewed TAK Map display SIDC remains in the
            # dedicated displaySidcI580 attribute.
            if attrs.get('transportSidcI580'):
                meta.set('sidc', attrs['transportSidcI580'][:32])
            built = dict(built)
            built['xml'] = '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding='unicode', short_empty_elements=True)
            built['sidc'] = attrs.get('transportSidcI580') or built.get('sidc') or ''
            built['cot_type'] = attrs.get('transportCotTypeI580') or built.get('cot_type') or ''
            built['version'] = 'i580'; built['atak_symbology_transport_i580'] = attrs
        except Exception as exc:
            built = dict(built); built['atak_symbology_transport_warning_i580'] = str(exc)
        return built
    globals()['_i526_point_xml'] = _i526_point_xml

    def _i580_xml_meta(value):
        out = {}
        strings = []
        for obj in _i580_nested_dicts(value):
            for raw in obj.values():
                if isinstance(raw, str) and '<takmap_point' in raw: strings.append(raw)
        for raw in strings[:20]:
            for attr,key in (('symbologyConceptI580','concept'),('displayNameI580','display_name'),('displaySidcI580','display_sidc'),('displayCotTypeI580','display_cot_type'),('transportSidcI580','transport_sidc'),('transportCotTypeI580','transport_cot_type'),('transportDecisionI580','decision')):
                m = re.search(r'\b'+re.escape(attr)+r'=["\']([^"\']+)', raw, re.I)
                if m and key not in out: out[key]=m.group(1)
        return out

    def _i580_apply_visible(obj, *raw_values):
        if not isinstance(obj, dict): return obj
        meta = _i580_xml_meta(obj)
        for raw in raw_values:
            if isinstance(raw, dict): meta.update({k:v for k,v in _i580_xml_meta(raw).items() if k not in meta})
        concept = meta.get('concept') or _i580_concept(obj)
        aff = _i580_affiliation(obj)
        pair = _i580_pair(concept, aff) if concept else {}
        display, transport = dict(pair.get('display') or {}), dict(pair.get('transport') or {})
        if meta.get('display_name'): display['name']=meta['display_name']
        if meta.get('display_sidc'): display['sidc']=meta['display_sidc']
        if meta.get('display_cot_type'): display['cot_type']=meta['display_cot_type']
        if meta.get('transport_sidc'): transport['sidc']=meta['transport_sidc']
        if meta.get('transport_cot_type'): transport['cot_type']=meta['transport_cot_type']
        if not display: return obj
        obj['takmap_symbology_concept_i580']=concept
        obj['takmap_transport_decision_i580']=meta.get('decision') or ((_I580_CONCEPTS.get(concept) or {}).get('decision') if concept else '')
        obj['atak_transport_sidc_i580']=transport.get('sidc') or _i580_text(obj.get('sidc'))
        obj['atak_transport_cot_type_i580']=transport.get('cot_type') or _i580_text(obj.get('cot_type') or obj.get('type'))
        obj['sidc']=display.get('sidc') or obj.get('sidc') or ''
        obj['SIDC']=obj['sidc']; obj['mil2525_name']=display.get('name') or obj.get('mil2525_name') or ''
        obj['mil2525_file']=(obj['mil2525_name'].removesuffix('.svg')+'.svg') if obj['mil2525_name'] else obj.get('mil2525_file','')
        if display.get('label'): obj['mil2525_label']=display['label']
        props=obj.get('properties')
        if isinstance(props,dict):
            for key in ('takmap_symbology_concept_i580','takmap_transport_decision_i580','atak_transport_sidc_i580','atak_transport_cot_type_i580','sidc','SIDC','mil2525_name','mil2525_file','mil2525_label'):
                if key in obj: props[key]=obj[key]
        return obj

    if '_i537_apply_symbol' in globals():
        _i580_apply_before = _i537_apply_symbol
        def _i537_apply_symbol(obj, *raw_values):
            return _i580_apply_visible(_i580_apply_before(obj, *raw_values), *raw_values)
        globals()['_i537_apply_symbol'] = _i537_apply_symbol

    if '_i555_point_public' in globals():
        _i580_public_before = _i555_point_public
        def _i555_point_public(row):
            return _i580_apply_visible(_i580_public_before(row), row)
        globals()['_i555_point_public'] = _i555_point_public

    if '_i568_response_payload' in globals():
        _i580_response_before = _i568_response_payload
        def _i568_response_payload(state):
            payload = _i580_response_before(state)
            if not isinstance(payload, dict): return payload
            payload = _i580_copy.deepcopy(payload)
            for row in payload.get('objects') or []:
                if isinstance(row, dict): _i580_apply_visible(row)
            payload['version']='i580'
            payload['atak_symbology_transport_i580']={
                'version':'i580','concept_count':162,'decision_counts':dict(_I580_SYMBOLOGY.get('decision_counts') or {}),
                'display_artwork_preserved':True,'transport_mapped_for_ots_atak':True,'affiliation_preserved':True,
                'official_overrides':['emergency-food-distribution','emergency-hospital','emergency-rescue-helicopter','emergency-search-and-rescue'],
            }
            return payload
        globals()['_i568_response_payload'] = _i568_response_payload

    _i580_get_before = Handler.do_GET
    def _i580_do_get(self):
        parsed = urlparse(self.path)
        if parsed.path == '/assets/runtime/tak-map-package-i580.js':
            return _i541_send_file(self, _I580_ROOT / 'assets' / 'tak-map-package-i580.js', 'application/javascript; charset=utf-8', 'i580-package-identity')
        if parsed.path == '/assets/mil2525/atak-symbology-transport-i580.json':
            return _i541_send_file(self, _I580_MANIFEST_PATH, 'application/json; charset=utf-8', 'i580-atak-symbology-transport')
        return _i580_get_before(self)
    Handler.do_GET = _i580_do_get

    _i580_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i580_config_before() or {})
        cfg['tak_map_iteration']='i580'; cfg['version']='1.3.0-i580'
        cfg['atak_symbology_transport_i580']={
            'version':'i580','concept_count':162,'decision_counts':dict(_I580_SYMBOLOGY.get('decision_counts') or {}),
            'display_artwork_preserved':True,'ots_atak_transport_mapping':True,'affiliation_hard_constraint':True,
            'custom_icon_count':0,'manifest':'/assets/mil2525/atak-symbology-transport-i580.json',
            'official_food_distribution':True,'official_hospital':True,'rescue_helicopter_csar':True,
            'search_and_rescue_csar':True,'medevac_helicopter_official':True,'initial_load_release_gate':True,
        }
        startup = dict(cfg.get('startup_architecture_i579') or {})
        startup.update({'package_version':'i580','startup_loader_cache_identity':'1.3.0-i580','core_cache_identity':'1.3.0-i580','manifest_cache_identity':'1.3.0-i580','milstd2525c_resolver_cache_identity':'1.3.0-i580'})
        cfg['startup_architecture_i580']=startup
        return cfg
    globals()['tak_map_config']=tak_map_config

    def _i580_patch_html(html):
        html=str(html or '')
        html=re.sub(r'1\.3\.0-i\d+','1.3.0-i580',html)
        html=re.sub(r'TAKDashboard/i\d+','TAKDashboard/i580',html)
        html=re.sub(r'TAK-Map/1\.3\.0 i\d+','TAK-Map/1.3.0 i580',html)
        html=re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)',r'\1i580\2',html)
        html=re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)',r'\1i580\2',html)
        html=re.sub(r'/assets/runtime/tak-map-startup-i553\.js\?v=[^"\']+','/assets/runtime/tak-map-startup-i553.js?v=1.3.0-i580',html)
        html=re.sub(r'/assets/runtime/tak-map-context-sidebar-i572\.js\?v=[^"\']+','/assets/runtime/tak-map-context-sidebar-i572.js?v=1.3.0-i580',html)
        html=re.sub(r'/assets/runtime/tak-map-data-sync-access-i576\.js\?v=[^"\']+','/assets/runtime/tak-map-data-sync-access-i576.js?v=1.3.0-i580',html)
        html=re.sub(r'<script[^>]+tak-map-package-i580\.js[^>]*></script>\s*','',html,flags=re.I)
        identity='<script id="takMapPackageI580" defer src="/assets/runtime/tak-map-package-i580.js?v=1.3.0-i580"></script>'
        return html.replace('</body>',identity+'\n</body>',1) if '</body>' in html else html+identity
    TAK_MAP_HTML=_i580_patch_html(TAK_MAP_HTML); INDEX_HTML=TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML=_i580_patch_html(TAK_MAP_LOGIN_HTML); LOGIN_HTML=TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION='i580'
except Exception as _i580_exc:
    try: print('TAK Map i580 ATAK symbology transport patch failed:', _i580_exc)
    except Exception: pass
# --- end TAK Map i580 reviewed ATAK transport symbology ---

# --- TAK Map i581 rapid Data Sync membership and CoT cadence ---
try:
    _I581_ROOT = Path(__file__).resolve().parent
    _I581_MEMBERSHIP_INTERVAL_SECONDS = 10
    _I581_FULL_COT_INTERVAL_SECONDS = 20
    _I581_BROWSER_POLL_SECONDS = 5
    _I581_VERSION = 'i581'

    # The existing authenticated route uses this value to decide whether a new
    # background refresh is due. i581 keeps that route and its request-context
    # wrappers, but replaces the worker/scheduler below so a 10-second due check
    # performs authoritative Mission membership discovery without forcing /cot.
    _I568_SNAPSHOT_MAX_AGE_SECONDS = _I581_MEMBERSHIP_INTERVAL_SECONDS

    def _i581_membership_map_from_acquired(acquired):
        membership = {}
        names = {}
        contents = {}
        for mission_row in list((acquired or {}).get('mission_rows') or []):
            if not isinstance(mission_row, dict):
                continue
            mission = _i568_text(mission_row.get('name') or mission_row.get('mission_name') or mission_row.get('missionName'))
            if not mission:
                continue
            mission_key = mission.casefold()
            names[mission_key] = mission
            uid_values = set()
            for raw in list(mission_row.get('uids') or []):
                if not isinstance(raw, dict):
                    continue
                candidate = _i568_clone(raw)
                candidate['mission'] = mission
                candidate['mission_name'] = mission
                uid = _i568_text(_i555_object_uid(candidate) if '_i555_object_uid' in globals() else _i568_row_uid(candidate)).casefold()
                if uid:
                    uid_values.add(uid)
            membership[mission_key] = sorted(uid_values)

            content_values = set()
            for raw in list(mission_row.get('contents') or []):
                if not isinstance(raw, dict):
                    continue
                nested = raw.get('data') if isinstance(raw.get('data'), dict) else {}
                ident = _i568_text(raw.get('hash') or nested.get('hash') or raw.get('uid') or nested.get('uid') or raw.get('filename') or nested.get('name')).casefold()
                if ident:
                    content_values.add(ident)
            contents[mission_key] = sorted(content_values)
        return membership, names, contents

    def _i581_membership_map_from_snapshot(snapshot):
        membership = {}
        names = {}
        if not isinstance(snapshot, dict):
            return membership, names
        for mission_row in list(snapshot.get('missions') or []):
            if isinstance(mission_row, dict):
                mission = _i568_text(mission_row.get('name') or mission_row.get('mission_name') or mission_row.get('missionName'))
            else:
                mission = _i568_text(mission_row)
            if mission:
                names[mission.casefold()] = mission
                membership.setdefault(mission.casefold(), set())
        for row in list(snapshot.get('mission_uids') or []):
            if not isinstance(row, dict):
                continue
            mission = _i568_text(row.get('mission') or row.get('mission_name') or row.get('missionName'))
            uid = _i568_text(_i555_object_uid(row) if '_i555_object_uid' in globals() else _i568_row_uid(row))
            if not mission:
                continue
            mission_key = mission.casefold()
            names[mission_key] = mission
            membership.setdefault(mission_key, set())
            if uid:
                membership[mission_key].add(uid.casefold())
        return {key: sorted(value) for key, value in membership.items()}, names

    def _i581_membership_signature(membership):
        raw = json.dumps(membership or {}, sort_keys=True, separators=(',', ':'), ensure_ascii=True)
        return hashlib.sha256(raw.encode('utf-8', 'ignore')).hexdigest()

    def _i581_membership_pairs(membership):
        return {(mission, uid) for mission, values in (membership or {}).items() for uid in (values or [])}

    def _i581_prune_authoritative(snapshot, acquired):
        if not isinstance(snapshot, dict):
            return snapshot
        out = _i568_clone(snapshot)
        membership, names, contents = _i581_membership_map_from_acquired(acquired)
        mission_keys = set(membership)
        valid_pairs = _i581_membership_pairs(membership)

        pruned_objects = []
        deleted_object_count = 0
        for row in list(out.get('objects') or []):
            if not isinstance(row, dict):
                pruned_objects.append(row)
                continue
            mission = _i568_text(row.get('mission') or row.get('mission_name') or row.get('missionName')).casefold()
            uid = _i568_text(_i555_object_uid(row) if '_i555_object_uid' in globals() else _i568_row_uid(row)).casefold()
            if not mission:
                pruned_objects.append(row)
                continue
            if mission not in mission_keys:
                deleted_object_count += 1
                continue
            if uid and (mission, uid) not in valid_pairs:
                deleted_object_count += 1
                continue
            pruned_objects.append(row)
        out['objects'] = pruned_objects

        pruned_uids = []
        for row in list(out.get('mission_uids') or []):
            if not isinstance(row, dict):
                continue
            mission = _i568_text(row.get('mission') or row.get('mission_name') or row.get('missionName')).casefold()
            uid = _i568_text(_i555_object_uid(row) if '_i555_object_uid' in globals() else _i568_row_uid(row)).casefold()
            if mission in mission_keys and uid and (mission, uid) in valid_pairs:
                pruned_uids.append(row)
        out['mission_uids'] = pruned_uids

        pruned_content = []
        for row in list(out.get('mission_content') or []):
            if not isinstance(row, dict):
                continue
            mission = _i568_text(row.get('mission') or row.get('mission_name') or row.get('missionName')).casefold()
            if mission not in mission_keys:
                continue
            nested = row.get('data') if isinstance(row.get('data'), dict) else {}
            ident = _i568_text(row.get('hash') or nested.get('hash') or row.get('uid') or nested.get('uid') or row.get('filename') or nested.get('name')).casefold()
            if ident and ident not in set(contents.get(mission) or []):
                continue
            pruned_content.append(row)
        out['mission_content'] = pruned_content

        out['data_sync_authoritative_prune_i581'] = {
            'version': _I581_VERSION,
            'authoritative_mission_count': len(mission_keys),
            'authoritative_uid_count': len(valid_pairs),
            'objects_after_prune': len(pruned_objects),
            'objects_removed': deleted_object_count,
            'deleted_uids_never_preserved_by_lkg': True,
        }
        return out

    _i581_load_persisted_before = _i568_load_persisted_state
    def _i568_load_persisted_state(key):
        state = _i581_load_persisted_before(key)
        try:
            raw = load_json_file(_i568_snapshot_path(key), {})
            if isinstance(raw, dict):
                state['i581_last_membership_success_epoch'] = float(raw.get('i581_last_membership_success_epoch') or 0)
                state['i581_last_full_cot_epoch'] = float(raw.get('i581_last_full_cot_epoch') or 0)
                state['i581_membership_map'] = dict(raw.get('i581_membership_map') or {})
                state['i581_membership_signature'] = _i568_text(raw.get('i581_membership_signature'))
        except Exception:
            pass
        state.setdefault('i581_last_membership_success_epoch', 0.0)
        state.setdefault('i581_last_full_cot_epoch', 0.0)
        state.setdefault('i581_membership_map', {})
        state.setdefault('i581_membership_signature', '')
        state.setdefault('i581_pending_full', False)
        return state
    globals()['_i568_load_persisted_state'] = _i568_load_persisted_state

    def _i568_persist_success(state):
        try:
            _I568_SNAPSHOT_ROOT.mkdir(parents=True, exist_ok=True)
            atomic_write_json(_i568_snapshot_path(state['key']), {
                'version': _I581_VERSION,
                'ots_contract': globals().get('_I569_OTS_CONTRACT', ''),
                'last_success_epoch': state.get('last_success_epoch') or 0,
                'generation': state.get('generation') or 0,
                'endpoint_timings': list(state.get('endpoint_timings') or [])[:240],
                'acquisition_summary': dict(state.get('acquisition_summary') or {}),
                'i581_last_membership_success_epoch': state.get('i581_last_membership_success_epoch') or 0,
                'i581_last_full_cot_epoch': state.get('i581_last_full_cot_epoch') or 0,
                'i581_membership_map': dict(state.get('i581_membership_map') or {}),
                'i581_membership_signature': state.get('i581_membership_signature') or '',
                'snapshot': state.get('snapshot'),
            })
        except Exception as exc:
            state['snapshot_persist_warning'] = _i568_text(exc)
    globals()['_i568_persist_success'] = _i568_persist_success

    def _i581_publish_state(key, generation, snapshot, acquired, phase, membership=None,
                            added=None, deleted=None, keep_in_flight=False, error='',
                            full_cot_completed=False, addition_enrichment_completed=False):
        now = time.time()
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            if int(state.get('generation') or 0) != int(generation):
                return False
            state['snapshot'] = snapshot
            state['last_success_epoch'] = now
            state['last_attempt_completed_epoch'] = now
            state['last_error'] = _i568_text(error)[:1200]
            state['endpoint_timings'] = list((acquired or {}).get('timings') or [])[:240]
            state['acquisition_summary'] = dict((acquired or {}).get('summary') or {})
            state['acquisition_summary']['phase'] = phase
            state['in_flight'] = bool(keep_in_flight)
            if membership is not None:
                state['i581_last_membership_success_epoch'] = now
                state['i581_membership_map'] = _i568_clone(membership)
                state['i581_membership_signature'] = _i581_membership_signature(membership)
                state['i581_last_added'] = sorted([list(value) for value in (added or set())])[:500]
                state['i581_last_deleted'] = sorted([list(value) for value in (deleted or set())])[:500]
                state['i581_last_membership_change_epoch'] = now if (added or deleted) else float(state.get('i581_last_membership_change_epoch') or 0)
            if full_cot_completed:
                state['i581_last_full_cot_epoch'] = now
            if addition_enrichment_completed:
                state['i581_last_addition_enrichment_epoch'] = now
            _i568_persist_success(state)
        return True

    def _i581_enrichment_rows(acquired, mission_keys):
        selected = []
        wanted = set(mission_keys or [])
        for row in list((acquired or {}).get('mission_rows') or []):
            if not isinstance(row, dict):
                continue
            mission = _i568_text(row.get('name') or row.get('mission_name') or row.get('missionName'))
            if not mission or mission.casefold() not in wanted:
                continue
            if _i569_password_protected(row):
                continue
            selected.append(row)
        return selected

    def _i568_refresh_worker(key, cfg, sess, token, reason, generation):
        started_mono = time.monotonic()
        pending_full = False
        _i568_set_context(token, sess)
        try:
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                previous = _i568_clone(state.get('snapshot')) if isinstance(state.get('snapshot'), dict) else None
                requested_full = bool(state.get('i581_requested_full'))
                previous_membership = dict(state.get('i581_membership_map') or {})
            if not previous_membership and previous:
                previous_membership, _previous_names = _i581_membership_map_from_snapshot(previous)

            discovery, acquired = _i568_build_snapshot(cfg, sess, token, reason)
            current_membership, mission_names, _contents = _i581_membership_map_from_acquired(acquired)
            previous_pairs = _i581_membership_pairs(previous_membership)
            current_pairs = _i581_membership_pairs(current_membership)
            added = current_pairs - previous_pairs
            deleted = previous_pairs - current_pairs
            previous_missions = set(previous_membership)
            current_missions = set(current_membership)
            added_missions = current_missions - previous_missions
            deleted_missions = previous_missions - current_missions

            discovery = _i581_prune_authoritative(discovery, acquired)
            if previous and '_i570_merge_snapshot_lkg' in globals():
                discovery = _i570_merge_snapshot_lkg(discovery, previous)
            # LKG is allowed only for exact UIDs that remain in authoritative
            # Mission membership. Re-prune after the merge so deletions cannot be
            # resurrected by any prior snapshot.
            discovery = _i581_prune_authoritative(discovery, acquired)

            addition_mission_keys = {mission for mission, _uid in added} | added_missions
            all_mission_keys = set(current_membership)
            enrich_keys = all_mission_keys if requested_full else addition_mission_keys
            enrich_rows = _i581_enrichment_rows(acquired, enrich_keys)

            summary = dict(acquired.get('summary') or {})
            summary.update({
                'version': _I581_VERSION,
                'phase': 'membership-published',
                'membership_interval_seconds': _I581_MEMBERSHIP_INTERVAL_SECONDS,
                'full_cot_interval_seconds': _I581_FULL_COT_INTERVAL_SECONDS,
                'membership_changed': bool(added or deleted or added_missions or deleted_missions),
                'added_uid_count': len(added),
                'deleted_uid_count': len(deleted),
                'added_mission_count': len(added_missions),
                'deleted_mission_count': len(deleted_missions),
                'requested_full_cot': requested_full,
                'immediate_addition_enrichment': bool(addition_mission_keys),
                'cot_enrichment_selected_mission_count': len(enrich_rows),
            })
            acquired['summary'] = summary
            _i581_publish_state(
                key, generation, discovery, acquired, 'membership-published',
                membership=current_membership, added=added, deleted=deleted,
                keep_in_flight=bool(enrich_rows),
            )

            current_snapshot = discovery
            completed = succeeded = failed = 0
            mission_status = {}
            if enrich_rows:
                marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')
                deadline = time.monotonic() + _I570_COT_OVERALL_SECONDS
                executor = ThreadPoolExecutor(max_workers=max(1, min(_I568_MAX_WORKERS, len(enrich_rows))))
                future_map = {}
                try:
                    for row in enrich_rows:
                        mission = _i568_text(row.get('name'))
                        path = '/Marti/api/missions/' + quote(mission, safe='') + '/cot'
                        url = marti + path
                        future = executor.submit(_i569_call, cfg, sess, token, url, path,
                                                 'mission:' + mission + ':cot', _I570_COT_TIMEOUT_SECONDS)
                        future_map[future] = (mission, url)
                    timeout = max(0.0, deadline - time.monotonic())
                    try:
                        iterator = _i570_as_completed(list(future_map), timeout=timeout)
                        for future in iterator:
                            mission, url = future_map[future]
                            completed += 1
                            try:
                                returned_url, result, timing = future.result()
                            except Exception as exc:
                                returned_url = url
                                result = {'ok': False, 'status': 0, 'body': None, 'json': {}, 'error': _i568_text(exc)}
                                timing = {'endpoint': 'mission:' + mission + ':cot', 'url_path': urlparse(url).path,
                                          'ok': False, 'status': 0, 'duration_seconds': None,
                                          'error': _i568_text(exc)[:300]}
                            acquired.setdefault('responses', {})[returned_url] = result
                            acquired.setdefault('timings', []).append(timing)
                            if result.get('ok'):
                                succeeded += 1
                                mission_status[mission] = {'state': 'ready', 'ok': True,
                                                          'duration_seconds': timing.get('duration_seconds')}
                                phase = 'full-cot-enrichment-published' if requested_full else 'addition-cot-enrichment-published'
                                current_summary = dict(acquired.get('summary') or {})
                                current_summary.update({
                                    'version': _I581_VERSION, 'phase': phase,
                                    'cot_enrichment_completed_count': completed,
                                    'cot_enrichment_success_count': succeeded,
                                    'cot_enrichment_failure_count': failed,
                                    'cot_enrichment_pending_count': max(0, len(enrich_rows) - completed),
                                    'mission_status': _i568_clone(mission_status),
                                    'last_published_mission': mission,
                                })
                                acquired['summary'] = current_summary
                                enriched = _i570_build_from_acquired(cfg, sess, acquired,
                                                                     previous=current_snapshot, phase=phase)
                                enriched = _i581_prune_authoritative(enriched, acquired)
                                current_snapshot = enriched
                                _i581_publish_state(
                                    key, generation, current_snapshot, acquired, phase,
                                    keep_in_flight=completed < len(enrich_rows),
                                )
                            else:
                                failed += 1
                                mission_status[mission] = {
                                    'state': 'last-known-good', 'ok': False,
                                    'status': int(result.get('status') or 0),
                                    'error': _i568_text(result.get('error'))[:300],
                                }
                    except TimeoutError:
                        pass
                    for future, (mission, url) in future_map.items():
                        if future.done():
                            continue
                        future.cancel()
                        failed += 1
                        mission_status[mission] = {'state': 'last-known-good', 'ok': False,
                                                   'error': 'enrichment-deadline'}
                        acquired.setdefault('timings', []).append({
                            'endpoint': 'mission:' + mission + ':cot',
                            'url_path': urlparse(url).path, 'ok': False, 'status': 0,
                            'duration_seconds': None, 'error': 'enrichment-deadline',
                        })
                finally:
                    executor.shutdown(wait=False, cancel_futures=True)

            final_phase = 'ready-full-cot' if requested_full else ('ready-addition-enriched' if enrich_rows else 'ready-membership')
            final_summary = dict(acquired.get('summary') or {})
            final_summary.update({
                'version': _I581_VERSION,
                'phase': final_phase,
                'cot_enrichment_completed_count': completed,
                'cot_enrichment_success_count': succeeded,
                'cot_enrichment_failure_count': failed,
                'cot_enrichment_pending_count': 0,
                'mission_status': _i568_clone(mission_status),
                'duration_seconds': round(time.monotonic() - started_mono, 4),
            })
            acquired['summary'] = final_summary
            warning = '' if not failed else f'{failed} mission CoT enrichment request(s) failed; exact-UID last-known-good data was preserved.'
            _i581_publish_state(
                key, generation, current_snapshot, acquired, final_phase,
                keep_in_flight=False, error=warning,
                full_cot_completed=requested_full,
                addition_enrichment_completed=bool(addition_mission_keys and enrich_rows),
            )
        except Exception as exc:
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                if int(state.get('generation') or 0) == int(generation):
                    state['last_attempt_completed_epoch'] = time.time()
                    state['last_attempt_duration_seconds'] = round(time.monotonic() - started_mono, 4)
                    state['last_error'] = _i568_text(exc)[:1200]
                    state['in_flight'] = False
        finally:
            _i568_clear_context()
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                if int(state.get('generation') or 0) == int(generation):
                    state['last_attempt_duration_seconds'] = round(time.monotonic() - started_mono, 4)
                    state['in_flight'] = False
                    pending_full = bool(state.pop('i581_pending_full', False))
            if pending_full:
                try:
                    _i568_schedule_refresh(key, cfg, sess, token, 'i581-coalesced-manual-full-refresh', force=True)
                except Exception:
                    pass
    globals()['_i568_refresh_worker'] = _i568_refresh_worker

    def _i568_schedule_refresh(key, cfg, sess, token, reason, force=False):
        now = time.time()
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            state.setdefault('i581_last_membership_success_epoch', 0.0)
            state.setdefault('i581_last_full_cot_epoch', 0.0)
            last_full = float(state.get('i581_last_full_cot_epoch') or 0)
            full_due = bool(force or not last_full or now - last_full >= _I581_FULL_COT_INTERVAL_SECONDS)
            if state.get('in_flight'):
                if force or (full_due and not state.get('i581_requested_full')):
                    state['i581_pending_full'] = True
                return False, 'already-running'
            last_attempt = float(state.get('last_attempt_started_epoch') or 0)
            if not force and last_attempt and now - last_attempt < _I568_RETRY_COOLDOWN_SECONDS and not state.get('snapshot'):
                return False, 'retry-cooldown'
            state['generation'] = int(state.get('generation') or 0) + 1
            generation = state['generation']
            state['in_flight'] = True
            state['last_attempt_started_epoch'] = now
            state['last_reason'] = _i568_text(reason) or ('manual' if force else 'automatic')
            state['i581_requested_full'] = full_due
            state['i581_requested_mode'] = 'membership-and-full-cot' if full_due else 'membership-only'
        thread = threading.Thread(
            target=_i568_refresh_worker,
            args=(key, _i568_clone(cfg), _i568_clone(sess), _i568_text(token), _i568_text(reason), generation),
            name='tak-map-i581-data-sync-' + str(key)[:8], daemon=True,
        )
        thread.start()
        return True, 'scheduled-full' if full_due else 'scheduled-membership'
    globals()['_i568_schedule_refresh'] = _i568_schedule_refresh

    _i581_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i581_response_before(state)
        if not isinstance(payload, dict):
            return payload
        payload = _i568_clone(payload)
        now = time.time()
        with _I568_STATE_LOCK:
            last_membership = float(state.get('i581_last_membership_success_epoch') or 0)
            last_full = float(state.get('i581_last_full_cot_epoch') or 0)
            diag = {
                'version': _I581_VERSION,
                'membership_interval_seconds': _I581_MEMBERSHIP_INTERVAL_SECONDS,
                'full_cot_enrichment_interval_seconds': _I581_FULL_COT_INTERVAL_SECONDS,
                'browser_snapshot_poll_seconds': _I581_BROWSER_POLL_SECONDS,
                'last_membership_success_at': _i568_iso(last_membership),
                'last_membership_age_seconds': round(max(0.0, now-last_membership), 3) if last_membership else None,
                'last_full_cot_enrichment_at': _i568_iso(last_full),
                'last_full_cot_age_seconds': round(max(0.0, now-last_full), 3) if last_full else None,
                'requested_mode': state.get('i581_requested_mode') or '',
                'pending_forced_full_refresh': bool(state.get('i581_pending_full')),
                'last_added_uid_count': len(state.get('i581_last_added') or []),
                'last_deleted_uid_count': len(state.get('i581_last_deleted') or []),
                'manual_refresh_forces_membership_and_full_cot': True,
                'membership_additions_trigger_immediate_cot': True,
                'confirmed_deletions_pruned_before_enrichment': True,
            }
        base_diag = dict(payload.get('data_sync_background_i570') or payload.get('data_sync_background_i569') or payload.get('data_sync_background_i568') or {})
        base_diag.update(diag)
        payload['data_sync_background_i581'] = dict(base_diag)
        payload['data_sync_background_i570'] = dict(base_diag)
        payload['version'] = _I581_VERSION
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i581_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i581_config_before() or {})
        cfg['tak_map_iteration'] = _I581_VERSION
        cfg['version'] = '1.3.0-i581'
        cfg['data_sync_background_i581'] = {
            'version': _I581_VERSION,
            'membership_interval_seconds': _I581_MEMBERSHIP_INTERVAL_SECONDS,
            'full_cot_enrichment_interval_seconds': _I581_FULL_COT_INTERVAL_SECONDS,
            'browser_snapshot_poll_seconds': _I581_BROWSER_POLL_SECONDS,
            'membership_additions_trigger_immediate_cot': True,
            'manual_refresh_forces_membership_and_full_cot': True,
            'confirmed_deletions_pruned_before_enrichment': True,
            'last_known_good_exact_uid_only': True,
        }
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version': _I581_VERSION,
            'automatic_poll_seconds': _I581_BROWSER_POLL_SECONDS,
            'minimum_browser_request_interval_seconds': 4,
            'ots_membership_interval_seconds': _I581_MEMBERSHIP_INTERVAL_SECONDS,
            'full_cot_enrichment_interval_seconds': _I581_FULL_COT_INTERVAL_SECONDS,
            'manual_refresh_forces_both': True,
        })
        cfg['data_sync_control'] = control
        startup = dict(cfg.get('startup_architecture_i580') or {})
        startup.update({
            'package_version': _I581_VERSION,
            'startup_loader_cache_identity': '1.3.0-i581',
            'core_cache_identity': '1.3.0-i581',
            'manifest_cache_identity': '1.3.0-i581',
            'data_sync_control_cache_identity': '1.3.0-i581',
            'data_sync_poll_seconds': _I581_BROWSER_POLL_SECONDS,
        })
        cfg['startup_architecture_i581'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i581_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i581', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i581', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i581', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i581\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i581\2', html)
        html = re.sub(r'/assets/runtime/tak-map-startup-i553\.js\?v=[^"\']+', '/assets/runtime/tak-map-startup-i553.js?v=1.3.0-i581', html)
        html = re.sub(r'/assets/runtime/tak-map-context-sidebar-i572\.js\?v=[^"\']+', '/assets/runtime/tak-map-context-sidebar-i572.js?v=1.3.0-i581', html)
        html = re.sub(r'/assets/runtime/tak-map-data-sync-access-i576\.js\?v=[^"\']+', '/assets/runtime/tak-map-data-sync-access-i576.js?v=1.3.0-i581', html)
        html = re.sub(r'/assets/runtime/tak-map-package-i580\.js\?v=[^"\']+', '/assets/runtime/tak-map-package-i580.js?v=1.3.0-i581', html)
        return html

    TAK_MAP_HTML = _i581_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i581_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I581_VERSION
except Exception as _i581_exc:
    try:
        print('TAK Map i581 rapid Data Sync cadence patch failed:', _i581_exc)
    except Exception:
        pass
# --- end TAK Map i581 rapid Data Sync membership and CoT cadence ---



# --- TAK Map i582 corroborated Data Sync membership pruning hotfix ---
try:
    _I582_VERSION = 'i582'
    _I582_MEMBERSHIP_INTERVAL_SECONDS = 10
    _I582_FULL_COT_INTERVAL_SECONDS = 20
    _I582_BROWSER_POLL_SECONDS = 5

    def _i582_uid_from_value(value, mission=''):
        if isinstance(value, str):
            return _i568_text(value)
        if not isinstance(value, dict):
            return ''
        row = _i568_clone(value)
        if mission:
            row.setdefault('mission', mission)
            row.setdefault('mission_name', mission)
        try:
            uid = _i555_object_uid(row) if '_i555_object_uid' in globals() else _i568_row_uid(row)
        except Exception:
            uid = ''
        if not _i568_text(uid):
            details = row.get('details') if isinstance(row.get('details'), dict) else {}
            uid = (row.get('event_uid') or row.get('eventUid') or row.get('cot_uid') or row.get('cotUid') or
                   details.get('event_uid') or details.get('eventUid') or details.get('cot_uid') or details.get('cotUid') or
                   row.get('uid') or (row.get('data') if isinstance(row.get('data'), str) else ''))
        return _i568_text(uid)

    def _i582_discovery_payload(acquired):
        responses = dict((acquired or {}).get('responses') or {})
        for url, result in responses.items():
            if not isinstance(result, dict) or not result.get('ok'):
                continue
            path = _i568_text(urlparse(_i568_text(url)).path)
            raw_url = _i568_text(url)
            if path == '/Marti/api/missions' or raw_url.endswith(_I569_DISCOVERY_PATH):
                body = _i568_result_body(result)
                if isinstance(body, dict):
                    return body
        return None

    def _i582_membership_analysis(acquired):
        summary = dict((acquired or {}).get('summary') or {})
        payload = _i582_discovery_payload(acquired)
        payload_rows = payload.get('data') if isinstance(payload, dict) else None
        global_complete = bool(summary.get('discovery_ok') and isinstance(payload_rows, list))
        membership, names, contents, status, rows = {}, {}, {}, {}, {}
        for mission_row in list((acquired or {}).get('mission_rows') or []):
            if not isinstance(mission_row, dict):
                continue
            mission = _i568_text(mission_row.get('name') or mission_row.get('mission_name') or mission_row.get('missionName'))
            if not mission:
                continue
            key = mission.casefold()
            names[key] = mission
            rows[key] = mission_row
            raw_uids = mission_row.get('uids', None)
            structurally_complete = isinstance(raw_uids, list)
            parsed = []
            malformed = 0
            if structurally_complete:
                seen = set()
                for raw in raw_uids:
                    uid = _i582_uid_from_value(raw, mission).casefold()
                    if not uid:
                        malformed += 1
                        continue
                    if uid not in seen:
                        seen.add(uid)
                        parsed.append(uid)
                if malformed:
                    structurally_complete = False
            membership[key] = sorted(parsed)
            if structurally_complete:
                status[key] = 'complete-nonempty' if parsed else 'complete-empty'
            else:
                status[key] = 'incomplete'

            raw_contents = mission_row.get('contents', None)
            content_values = set()
            if isinstance(raw_contents, list):
                for raw in raw_contents:
                    if not isinstance(raw, dict):
                        continue
                    nested = raw.get('data') if isinstance(raw.get('data'), dict) else {}
                    ident = _i568_text(raw.get('hash') or nested.get('hash') or raw.get('uid') or nested.get('uid') or raw.get('filename') or nested.get('name')).casefold()
                    if ident:
                        content_values.add(ident)
            contents[key] = sorted(content_values)
        return {
            'global_complete': global_complete,
            'membership': membership,
            'names': names,
            'contents': contents,
            'status': status,
            'rows': rows,
            'summary': summary,
        }

    def _i582_candidate_increment(candidates, mission, kind):
        previous = dict((candidates or {}).get(mission) or {})
        count = int(previous.get('count') or 0) + 1 if previous.get('kind') == kind else 1
        candidates[mission] = {'kind': kind, 'count': count, 'last_seen_epoch': time.time()}
        return count

    def _i582_plan_membership(acquired, previous_membership, prior_candidates, requested_full=False):
        analysis = _i582_membership_analysis(acquired)
        current = dict(analysis.get('membership') or {})
        statuses = dict(analysis.get('status') or {})
        rows = dict(analysis.get('rows') or {})
        global_complete = bool(analysis.get('global_complete'))
        previous = {str(k): sorted({_i568_text(v).casefold() for v in (vals or []) if _i568_text(v)})
                    for k, vals in (previous_membership or {}).items()}
        effective = {}
        candidates = _i568_clone(prior_candidates or {})
        pending_cot = set()
        decisions = {}
        mission_keys = set(previous) | set(current)
        for mission in sorted(mission_keys):
            old_values = list(previous.get(mission) or [])
            state = statuses.get(mission)
            new_values = list(current.get(mission) or [])
            if state == 'complete-nonempty':
                effective[mission] = new_values
                candidates.pop(mission, None)
                decisions[mission] = 'accepted-complete-nonempty'
                continue
            if state == 'complete-empty':
                count = _i582_candidate_increment(candidates, mission, 'empty') if old_values else 0
                if old_values and requested_full:
                    # Manual/full refresh never publishes an empty intermediate
                    # snapshot. The existing rows stay visible until /cot either
                    # confirms zero events or restores the remaining event UIDs.
                    effective[mission] = old_values
                    decisions[mission] = 'preserved-full-refresh-pending-cot-corroboration'
                    if mission in rows:
                        pending_cot.add(mission)
                elif old_values and count < 2:
                    effective[mission] = old_values
                    decisions[mission] = 'preserved-pending-empty-corroboration'
                else:
                    effective[mission] = []
                    decisions[mission] = 'accepted-empty-second-read' if old_values else 'accepted-empty-no-prior-membership'
                    if requested_full and mission in rows:
                        pending_cot.add(mission)
                continue
            if state == 'incomplete':
                if old_values:
                    effective[mission] = old_values
                candidates.pop(mission, None)
                decisions[mission] = 'preserved-incomplete-membership'
                if requested_full and mission in rows:
                    pending_cot.add(mission)
                continue
            # A previously visible mission missing from one otherwise valid
            # discovery response is also corroborated before it can be cleared.
            if mission in previous:
                if global_complete:
                    count = _i582_candidate_increment(candidates, mission, 'missing')
                    if old_values and count < 2:
                        effective[mission] = old_values
                        decisions[mission] = 'preserved-pending-missing-mission-corroboration'
                    else:
                        effective[mission] = []
                        decisions[mission] = 'accepted-missing-mission-second-read'
                else:
                    effective[mission] = old_values
                    candidates.pop(mission, None)
                    decisions[mission] = 'preserved-incomplete-global-discovery'

        # A full refresh always asks /cot for every usable current Mission row.
        # This also lets an i581-empty persisted snapshot recover immediately.
        if requested_full:
            pending_cot.update(rows)
        return effective, candidates, pending_cot, decisions, analysis

    def _i582_object_key(row):
        if not isinstance(row, dict):
            return ('', '')
        mission = _i568_text(row.get('mission') or row.get('mission_name') or row.get('missionName')).casefold()
        uid = _i582_uid_from_value(row, mission).casefold()
        return mission, uid

    def _i582_reconcile_snapshot(snapshot, previous, membership, analysis, decisions, phase='membership'):
        if not isinstance(snapshot, dict):
            return snapshot
        out = _i568_clone(snapshot)
        previous = previous if isinstance(previous, dict) else {}
        valid_pairs = _i581_membership_pairs(membership)
        old_objects = {_i582_object_key(row): row for row in list(previous.get('objects') or [])
                       if _i582_object_key(row)[0] and _i582_object_key(row)[1]}
        old_uids = {_i582_object_key(row): row for row in list(previous.get('mission_uids') or [])
                    if _i582_object_key(row)[0] and _i582_object_key(row)[1]}
        current_objects = []
        seen_objects = set()
        removed = 0
        for row in list(out.get('objects') or []):
            if not isinstance(row, dict):
                current_objects.append(row)
                continue
            key = _i582_object_key(row)
            if not key[0] or not key[1]:
                current_objects.append(row)
                continue
            if key not in valid_pairs:
                removed += 1
                continue
            merged = _i570_merge_dict_nonempty(old_objects[key], row) if key in old_objects else row
            current_objects.append(merged)
            seen_objects.add(key)
        for key in sorted(valid_pairs):
            if key in seen_objects:
                continue
            if key in old_objects:
                current_objects.append(_i568_clone(old_objects[key]))
                seen_objects.add(key)
        out['objects'] = current_objects

        current_uid_rows = []
        uid_by_key = {}
        for row in list(out.get('mission_uids') or []):
            if not isinstance(row, dict):
                continue
            key = _i582_object_key(row)
            if key in valid_pairs and key not in uid_by_key:
                uid_by_key[key] = row
        for key in sorted(valid_pairs):
            row = uid_by_key.get(key) or old_uids.get(key) or old_objects.get(key)
            if isinstance(row, dict):
                current_uid_rows.append(_i568_clone(row))
        out['mission_uids'] = current_uid_rows

        current_missions = {}
        mission_order = []
        for row in list(out.get('missions') or []):
            mission = _i568_text((row or {}).get('name') if isinstance(row, dict) else row)
            if mission and mission.casefold() not in current_missions:
                current_missions[mission.casefold()] = _i568_clone(row)
                mission_order.append(mission.casefold())
        for row in list(previous.get('missions') or []):
            mission = _i568_text((row or {}).get('name') if isinstance(row, dict) else row)
            key = mission.casefold()
            if mission and key in membership and key not in current_missions:
                current_missions[key] = _i568_clone(row)
                mission_order.append(key)
        grouped_uids = {}
        for row in current_uid_rows:
            key = _i582_object_key(row)[0]
            grouped_uids.setdefault(key, []).append(_i568_clone(row))
        missions_out = []
        for key in mission_order:
            if key not in membership:
                continue
            row = current_missions[key]
            if isinstance(row, dict):
                row = _i568_clone(row)
                row['uids'] = grouped_uids.get(key, [])
            missions_out.append(row)
        out['missions'] = missions_out

        current_content = list(out.get('mission_content') or [])
        previous_content = list(previous.get('mission_content') or [])
        content_complete = {}
        for key, row in dict((analysis or {}).get('rows') or {}).items():
            content_complete[key] = isinstance(row.get('contents'), list) if isinstance(row, dict) else False
        preserved_content = []
        for row in current_content:
            if not isinstance(row, dict):
                continue
            mission = _i568_text(row.get('mission') or row.get('mission_name') or row.get('missionName')).casefold()
            if mission in membership:
                preserved_content.append(row)
        for row in previous_content:
            if not isinstance(row, dict):
                continue
            mission = _i568_text(row.get('mission') or row.get('mission_name') or row.get('missionName')).casefold()
            if mission in membership and not content_complete.get(mission):
                preserved_content.append(_i568_clone(row))
        out['mission_content'] = preserved_content
        out['version'] = _I582_VERSION
        out['data_sync_membership_corroboration_i582'] = {
            'version': _I582_VERSION,
            'phase': phase,
            'global_discovery_structurally_complete': bool((analysis or {}).get('global_complete')),
            'mission_decisions': dict(decisions or {}),
            'effective_mission_count': len(membership or {}),
            'effective_uid_count': len(valid_pairs),
            'objects_removed': removed,
            'incomplete_success_never_authorizes_pruning': True,
            'nonempty_to_zero_requires_corroboration': True,
            'manual_refresh_has_no_empty_intermediate_publish': True,
            'per_mission_failure_isolation': True,
        }
        return out

    def _i582_cot_event_uids(result):
        if not isinstance(result, dict) or not result.get('ok'):
            return False, set()
        raw_body = result.get('body')
        body = raw_body if isinstance(raw_body, (str, list, dict)) and raw_body not in ({}, None) else _i568_result_body(result)
        uids = set()
        if isinstance(body, str):
            text = body.strip()
            if not text:
                return False, set()
            try:
                root = ET.fromstring(text.encode('utf-8'))
                for element in root.iter():
                    tag = _i568_text(element.tag).split('}')[-1].casefold()
                    if tag == 'event':
                        uid = _i568_text(element.attrib.get('uid')).casefold()
                        if uid:
                            uids.add(uid)
                return True, uids
            except Exception:
                # Some OTS versions return adjacent event fragments. The regex
                # still distinguishes a parseable event-bearing response from a
                # transport failure, but an event-free malformed body is not
                # allowed to clear membership.
                found = re.findall(r'<(?:[A-Za-z0-9_.-]+:)?event\b[^>]*\buid=["\']([^"\']+)["\']', text, re.I)
                if found:
                    return True, {_i568_text(uid).casefold() for uid in found if _i568_text(uid)}
                return False, set()
        if isinstance(body, (dict, list)):
            queue = [body]
            recognized = False
            while queue:
                value = queue.pop(0)
                if isinstance(value, list):
                    queue.extend(value)
                elif isinstance(value, dict):
                    queue.extend(value.values())
                    lowered = {str(k).casefold(): v for k, v in value.items()}
                    if any(key in lowered for key in ('event', 'events', 'cotevent', 'cotevents')):
                        recognized = True
                    uid = _i568_text(lowered.get('uid') or lowered.get('@uid') or lowered.get('event_uid') or lowered.get('cot_uid')).casefold()
                    if uid and any(key in lowered for key in ('type', '@type', 'event_uid', 'cot_uid')):
                        uids.add(uid)
            return bool(recognized or uids or body == []), uids
        return False, set()

    _i582_load_before = _i568_load_persisted_state
    def _i568_load_persisted_state(key):
        state = _i582_load_before(key)
        try:
            raw = load_json_file(_i568_snapshot_path(key), {})
            if isinstance(raw, dict):
                state['i582_zero_candidates'] = dict(raw.get('i582_zero_candidates') or {})
        except Exception:
            pass
        state.setdefault('i582_zero_candidates', {})
        return state
    globals()['_i568_load_persisted_state'] = _i568_load_persisted_state

    def _i568_persist_success(state):
        try:
            _I568_SNAPSHOT_ROOT.mkdir(parents=True, exist_ok=True)
            atomic_write_json(_i568_snapshot_path(state['key']), {
                'version': _I582_VERSION,
                'ots_contract': globals().get('_I569_OTS_CONTRACT', ''),
                'last_success_epoch': state.get('last_success_epoch') or 0,
                'generation': state.get('generation') or 0,
                'endpoint_timings': list(state.get('endpoint_timings') or [])[:240],
                'acquisition_summary': dict(state.get('acquisition_summary') or {}),
                'i581_last_membership_success_epoch': state.get('i581_last_membership_success_epoch') or 0,
                'i581_last_full_cot_epoch': state.get('i581_last_full_cot_epoch') or 0,
                'i581_membership_map': dict(state.get('i581_membership_map') or {}),
                'i581_membership_signature': state.get('i581_membership_signature') or '',
                'i582_zero_candidates': dict(state.get('i582_zero_candidates') or {}),
                'snapshot': state.get('snapshot'),
            })
        except Exception as exc:
            state['snapshot_persist_warning'] = _i568_text(exc)
    globals()['_i568_persist_success'] = _i568_persist_success

    def _i582_publish_state(key, generation, snapshot, acquired, phase, membership=None,
                            candidates=None, added=None, deleted=None, keep_in_flight=False,
                            error='', full_cot_completed=False, addition_enrichment_completed=False):
        now = time.time()
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            if int(state.get('generation') or 0) != int(generation):
                return False
            state['snapshot'] = snapshot
            state['last_success_epoch'] = now
            state['last_attempt_completed_epoch'] = now
            state['last_error'] = _i568_text(error)[:1200]
            state['endpoint_timings'] = list((acquired or {}).get('timings') or [])[:240]
            state['acquisition_summary'] = dict((acquired or {}).get('summary') or {})
            state['acquisition_summary']['phase'] = phase
            state['in_flight'] = bool(keep_in_flight)
            if membership is not None:
                state['i581_last_membership_success_epoch'] = now
                state['i581_membership_map'] = _i568_clone(membership)
                state['i581_membership_signature'] = _i581_membership_signature(membership)
                state['i581_last_added'] = sorted([list(value) for value in (added or set())])[:500]
                state['i581_last_deleted'] = sorted([list(value) for value in (deleted or set())])[:500]
                state['i581_last_membership_change_epoch'] = now if (added or deleted) else float(state.get('i581_last_membership_change_epoch') or 0)
            if candidates is not None:
                state['i582_zero_candidates'] = _i568_clone(candidates)
            if full_cot_completed:
                state['i581_last_full_cot_epoch'] = now
            if addition_enrichment_completed:
                state['i581_last_addition_enrichment_epoch'] = now
            _i568_persist_success(state)
        return True

    def _i582_enrichment_rows(analysis, mission_keys):
        selected = []
        for key in sorted(set(mission_keys or [])):
            row = dict((analysis or {}).get('rows') or {}).get(key)
            if not isinstance(row, dict) or _i569_password_protected(row):
                continue
            selected.append(row)
        return selected

    def _i568_refresh_worker(key, cfg, sess, token, reason, generation):
        started_mono = time.monotonic()
        pending_full = False
        _i568_set_context(token, sess)
        try:
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                previous = _i568_clone(state.get('snapshot')) if isinstance(state.get('snapshot'), dict) else None
                requested_full = bool(state.get('i581_requested_full'))
                previous_membership = dict(state.get('i581_membership_map') or {})
                prior_candidates = dict(state.get('i582_zero_candidates') or {})
            if not previous_membership and previous:
                previous_membership, _previous_names = _i581_membership_map_from_snapshot(previous)

            discovery_raw, acquired = _i568_build_snapshot(cfg, sess, token, reason)
            effective, candidates, pending_cot, decisions, analysis = _i582_plan_membership(
                acquired, previous_membership, prior_candidates, requested_full=requested_full)
            previous_pairs = _i581_membership_pairs(previous_membership)
            effective_pairs = _i581_membership_pairs(effective)
            added = effective_pairs - previous_pairs
            deleted = previous_pairs - effective_pairs
            discovery = _i582_reconcile_snapshot(discovery_raw, previous, effective, analysis, decisions, phase='membership-published')

            addition_mission_keys = {mission for mission, _uid in added}
            enrich_keys = set(pending_cot) | addition_mission_keys
            if requested_full:
                enrich_keys.update((analysis.get('rows') or {}).keys())
            enrich_rows = _i582_enrichment_rows(analysis, enrich_keys)

            summary = dict(acquired.get('summary') or {})
            summary.update({
                'version': _I582_VERSION,
                'phase': 'membership-published',
                'membership_interval_seconds': _I582_MEMBERSHIP_INTERVAL_SECONDS,
                'full_cot_interval_seconds': _I582_FULL_COT_INTERVAL_SECONDS,
                'membership_changed': bool(added or deleted),
                'added_uid_count': len(added),
                'deleted_uid_count': len(deleted),
                'requested_full_cot': requested_full,
                'cot_enrichment_selected_mission_count': len(enrich_rows),
                'membership_global_structurally_complete': bool(analysis.get('global_complete')),
                'membership_decisions': dict(decisions),
                'pending_zero_corroboration_count': len(candidates),
            })
            acquired['summary'] = summary
            _i582_publish_state(
                key, generation, discovery, acquired, 'membership-published',
                membership=effective, candidates=candidates, added=added, deleted=deleted,
                keep_in_flight=bool(enrich_rows),
            )

            current_snapshot = discovery
            current_membership = _i568_clone(effective)
            completed = succeeded = failed = 0
            mission_status = {}
            if enrich_rows:
                marti = _i568_text((cfg or {}).get('marti_url')).rstrip('/')
                deadline = time.monotonic() + _I570_COT_OVERALL_SECONDS
                executor = ThreadPoolExecutor(max_workers=max(1, min(_I568_MAX_WORKERS, len(enrich_rows))))
                future_map = {}
                try:
                    for row in enrich_rows:
                        mission = _i568_text(row.get('name'))
                        path = '/Marti/api/missions/' + quote(mission, safe='') + '/cot'
                        url = marti + path
                        future = executor.submit(_i569_call, cfg, sess, token, url, path,
                                                 'mission:' + mission + ':cot', _I570_COT_TIMEOUT_SECONDS)
                        future_map[future] = (mission, url)
                    timeout = max(0.0, deadline - time.monotonic())
                    try:
                        iterator = _i570_as_completed(list(future_map), timeout=timeout)
                        for future in iterator:
                            mission, url = future_map[future]
                            mission_key = mission.casefold()
                            completed += 1
                            try:
                                returned_url, result, timing = future.result()
                            except Exception as exc:
                                returned_url = url
                                result = {'ok': False, 'status': 0, 'body': None, 'json': {}, 'error': _i568_text(exc)}
                                timing = {'endpoint': 'mission:' + mission + ':cot', 'url_path': urlparse(url).path,
                                          'ok': False, 'status': 0, 'duration_seconds': None,
                                          'error': _i568_text(exc)[:300]}
                            acquired.setdefault('responses', {})[returned_url] = result
                            acquired.setdefault('timings', []).append(timing)
                            cot_complete, cot_uids = _i582_cot_event_uids(result)
                            if result.get('ok'):
                                succeeded += 1
                                mission_status[mission] = {'state': 'ready', 'ok': True,
                                                          'duration_seconds': timing.get('duration_seconds'),
                                                          'cot_membership_complete': cot_complete,
                                                          'cot_uid_count': len(cot_uids)}
                                discovery_state = dict(analysis.get('status') or {}).get(mission_key)
                                if cot_complete and discovery_state in ('complete-empty', 'incomplete'):
                                    current_membership[mission_key] = sorted(cot_uids)
                                    candidates.pop(mission_key, None)
                                    decisions[mission_key] = 'cot-corroborated-' + ('nonempty' if cot_uids else 'empty')
                                raw_enriched = _i570_build_from_acquired(
                                    cfg, sess, acquired, previous=current_snapshot,
                                    phase='full-cot-enrichment-published' if requested_full else 'addition-cot-enrichment-published')
                                current_snapshot = _i582_reconcile_snapshot(
                                    raw_enriched, current_snapshot, current_membership,
                                    analysis, decisions,
                                    phase='full-cot-enrichment-published' if requested_full else 'addition-cot-enrichment-published')
                                now_pairs = _i581_membership_pairs(current_membership)
                                added = now_pairs - previous_pairs
                                deleted = previous_pairs - now_pairs
                                phase = 'full-cot-enrichment-published' if requested_full else 'addition-cot-enrichment-published'
                                current_summary = dict(acquired.get('summary') or {})
                                current_summary.update({
                                    'version': _I582_VERSION, 'phase': phase,
                                    'cot_enrichment_completed_count': completed,
                                    'cot_enrichment_success_count': succeeded,
                                    'cot_enrichment_failure_count': failed,
                                    'cot_enrichment_pending_count': max(0, len(enrich_rows) - completed),
                                    'mission_status': _i568_clone(mission_status),
                                    'last_published_mission': mission,
                                    'membership_decisions': dict(decisions),
                                })
                                acquired['summary'] = current_summary
                                _i582_publish_state(
                                    key, generation, current_snapshot, acquired, phase,
                                    membership=current_membership, candidates=candidates,
                                    added=added, deleted=deleted,
                                    keep_in_flight=completed < len(enrich_rows),
                                )
                            else:
                                failed += 1
                                mission_status[mission] = {
                                    'state': 'last-known-good', 'ok': False,
                                    'status': int(result.get('status') or 0),
                                    'error': _i568_text(result.get('error'))[:300],
                                }
                    except TimeoutError:
                        pass
                    for future, (mission, url) in future_map.items():
                        if future.done():
                            continue
                        future.cancel()
                        failed += 1
                        mission_status[mission] = {'state': 'last-known-good', 'ok': False,
                                                   'error': 'enrichment-deadline'}
                        acquired.setdefault('timings', []).append({
                            'endpoint': 'mission:' + mission + ':cot',
                            'url_path': urlparse(url).path, 'ok': False, 'status': 0,
                            'duration_seconds': None, 'error': 'enrichment-deadline',
                        })
                finally:
                    executor.shutdown(wait=False, cancel_futures=True)

            final_phase = 'ready-full-cot' if requested_full else ('ready-addition-enriched' if enrich_rows else 'ready-membership')
            final_summary = dict(acquired.get('summary') or {})
            final_summary.update({
                'version': _I582_VERSION,
                'phase': final_phase,
                'cot_enrichment_completed_count': completed,
                'cot_enrichment_success_count': succeeded,
                'cot_enrichment_failure_count': failed,
                'cot_enrichment_pending_count': 0,
                'mission_status': _i568_clone(mission_status),
                'membership_decisions': dict(decisions),
                'duration_seconds': round(time.monotonic() - started_mono, 4),
            })
            acquired['summary'] = final_summary
            now_pairs = _i581_membership_pairs(current_membership)
            added = now_pairs - previous_pairs
            deleted = previous_pairs - now_pairs
            warning = '' if not failed else f'{failed} mission CoT enrichment request(s) failed; the prior per-mission snapshot was preserved.'
            _i582_publish_state(
                key, generation, current_snapshot, acquired, final_phase,
                membership=current_membership, candidates=candidates,
                added=added, deleted=deleted,
                keep_in_flight=False, error=warning,
                full_cot_completed=requested_full,
                addition_enrichment_completed=bool(addition_mission_keys and enrich_rows),
            )
        except Exception as exc:
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                if int(state.get('generation') or 0) == int(generation):
                    state['last_attempt_completed_epoch'] = time.time()
                    state['last_attempt_duration_seconds'] = round(time.monotonic() - started_mono, 4)
                    state['last_error'] = _i568_text(exc)[:1200]
                    state['in_flight'] = False
        finally:
            _i568_clear_context()
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                if int(state.get('generation') or 0) == int(generation):
                    state['last_attempt_duration_seconds'] = round(time.monotonic() - started_mono, 4)
                    state['in_flight'] = False
                    pending_full = bool(state.pop('i581_pending_full', False))
            if pending_full:
                try:
                    _i568_schedule_refresh(key, cfg, sess, token, 'i582-coalesced-manual-full-refresh', force=True)
                except Exception:
                    pass
    globals()['_i568_refresh_worker'] = _i568_refresh_worker

    _i582_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i582_response_before(state)
        if not isinstance(payload, dict):
            return payload
        payload = _i568_clone(payload)
        diag = dict(payload.get('data_sync_background_i581') or {})
        diag.update({
            'version': _I582_VERSION,
            'incomplete_success_never_authorizes_pruning': True,
            'nonempty_to_zero_requires_cot_or_second_complete_read': True,
            'manual_refresh_preserves_current_snapshot_until_corroborated': True,
            'per_mission_failure_isolation': True,
            'pending_zero_corroboration_count': len(state.get('i582_zero_candidates') or []),
        })
        payload['data_sync_background_i582'] = diag
        payload['data_sync_background_i581'] = dict(diag)
        payload['version'] = _I582_VERSION
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i582_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i582_config_before() or {})
        cfg['tak_map_iteration'] = _I582_VERSION
        cfg['version'] = '1.3.0-i582'
        cfg['data_sync_background_i582'] = {
            'version': _I582_VERSION,
            'membership_interval_seconds': _I582_MEMBERSHIP_INTERVAL_SECONDS,
            'full_cot_enrichment_interval_seconds': _I582_FULL_COT_INTERVAL_SECONDS,
            'browser_snapshot_poll_seconds': _I582_BROWSER_POLL_SECONDS,
            'incomplete_success_never_authorizes_pruning': True,
            'nonempty_to_zero_requires_cot_or_second_complete_read': True,
            'manual_refresh_preserves_current_snapshot_until_corroborated': True,
            'cot_reconciles_incomplete_membership': True,
            'per_mission_failure_isolation': True,
        }
        startup = dict(cfg.get('startup_architecture_i581') or {})
        startup.update({
            'package_version': _I582_VERSION,
            'startup_loader_cache_identity': '1.3.0-i582',
            'core_cache_identity': '1.3.0-i582',
            'manifest_cache_identity': '1.3.0-i582',
            'data_sync_control_cache_identity': '1.3.0-i582',
        })
        cfg['startup_architecture_i582'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i582_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i582', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i582', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i582', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i582\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i582\2', html)
        html = re.sub(r'/assets/runtime/tak-map-startup-i553\.js\?v=[^"\']+', '/assets/runtime/tak-map-startup-i553.js?v=1.3.0-i582', html)
        html = re.sub(r'/assets/runtime/tak-map-context-sidebar-i572\.js\?v=[^"\']+', '/assets/runtime/tak-map-context-sidebar-i572.js?v=1.3.0-i582', html)
        html = re.sub(r'/assets/runtime/tak-map-data-sync-access-i576\.js\?v=[^"\']+', '/assets/runtime/tak-map-data-sync-access-i576.js?v=1.3.0-i582', html)
        html = re.sub(r'/assets/runtime/tak-map-package-i580\.js\?v=[^"\']+', '/assets/runtime/tak-map-package-i580.js?v=1.3.0-i582', html)
        return html

    TAK_MAP_HTML = _i582_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i582_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I582_VERSION
except Exception as _i582_exc:
    try:
        print('TAK Map i582 corroborated Data Sync membership hotfix failed:', _i582_exc)
    except Exception:
        pass
# --- end TAK Map i582 corroborated Data Sync membership pruning hotfix ---


# --- TAK Map i583 optimistic Data Sync handoff and single-flight cadence ---
try:
    _I583_VERSION = 'i583'
    _I583_MEMBERSHIP_INTERVAL_SECONDS = 10
    _I583_FULL_COT_INTERVAL_SECONDS = 20
    _I583_BROWSER_POLL_SECONDS = 5
    _I583_OPTIMISTIC_MAX_SECONDS = 900

    def _i583_shadow_key(mission, uid):
        return _i568_text(mission).casefold() + '\x1f' + _i568_text(uid).casefold()

    def _i583_shadow_parts(key):
        text = _i568_text(key)
        if '\x1f' not in text:
            return '', ''
        return tuple(text.split('\x1f', 1))

    def _i583_specific_symbol(row):
        if not isinstance(row, dict):
            return False
        sidc = _i568_text(row.get('sidc') or row.get('SIDC'))
        cot_type = _i568_text(row.get('cot_type') or row.get('atak_cot_type') or row.get('event_type') or row.get('type'))
        icon_path = _i568_text(row.get('iconsetpath') or row.get('iconset_path') or row.get('usericon') or row.get('usericon_path'))
        return bool((sidc and len(sidc) >= 10) or (cot_type and cot_type.count('-') >= 3) or icon_path)

    def _i583_exact_rows(snapshot, mission, uid):
        mission_f = _i568_text(mission).casefold()
        uid_f = _i568_text(uid).casefold()
        out = []
        for row in list((snapshot or {}).get('objects') or []):
            if not isinstance(row, dict):
                continue
            row_mission, row_uid = _i582_object_key(row)
            if row_mission == mission_f and row_uid == uid_f:
                out.append(row)
        return out

    def _i583_merge_shadow_row(shadow, current):
        shadow = _i568_clone(shadow or {})
        current = _i568_clone(current or {})
        merged = _i570_merge_dict_nonempty(shadow, current) if '_i570_merge_dict_nonempty' in globals() else dict(shadow, **current)
        # Until exact-UID CoT handoff succeeds, known local/read-back identity and
        # symbol metadata are authoritative. A partial Mission row may add fields,
        # but it may not downgrade a specific icon to the generic affiliation frame.
        protected = (
            'uid', 'event_uid', 'cot_uid', 'canonical_cot_uid_i546',
            'callsign', 'name', 'lat', 'lon', 'raw_lat', 'raw_lon', 'coords',
            'sidc', 'SIDC', 'mil2525_name', 'mil2525_file', 'mil2525_label',
            'cot_type', 'atak_cot_type', 'event_type', 'type',
            'iconsetpath', 'iconset_path', 'usericon', 'usericon_path',
            'mission', 'mission_name', 'mission_names',
        )
        for field in protected:
            value = shadow.get(field)
            if value not in (None, '', [], {}):
                merged[field] = _i568_clone(value)
        merged['data_sync_optimistic_i583'] = True
        merged['data_sync_optimistic_source_i583'] = _i568_text(shadow.get('data_sync_optimistic_source_i583') or 'tak-map-save-readback')
        merged['kind'] = merged.get('kind') or 'datasync'
        merged['is_mission_object'] = True
        return merged

    def _i583_decisions(snapshot):
        diag = (snapshot or {}).get('data_sync_membership_corroboration_i582') if isinstance(snapshot, dict) else {}
        return dict((diag or {}).get('mission_decisions') or {})

    def _i583_merge_optimistic(snapshot, state, phase='', membership=None, allow_retire=True):
        if not isinstance(snapshot, dict):
            return snapshot
        out = _i568_clone(snapshot)
        shadows = dict(state.get('i583_optimistic_rows') or {}) if isinstance(state, dict) else {}
        if not shadows:
            out['data_sync_optimistic_handoff_i583'] = {
                'version': _I583_VERSION, 'active_count': 0, 'phase': _i568_text(phase),
                'older_snapshot_cannot_remove_pending_create': True,
            }
            return out
        membership = membership if isinstance(membership, dict) else dict((state or {}).get('i581_membership_map') or {})
        decisions = _i583_decisions(out)
        now = time.time()
        active = {}
        retired = []
        objects = list(out.get('objects') or [])
        uid_rows = list(out.get('mission_uids') or [])
        phase_l = _i568_text(phase or ((state or {}).get('acquisition_summary') or {}).get('phase')).casefold()
        enriched_phase = ('cot-enrichment' in phase_l or phase_l in ('ready-full-cot', 'ready-addition-enriched'))

        for key, record in shadows.items():
            if not isinstance(record, dict) or not isinstance(record.get('row'), dict):
                continue
            mission, uid = _i583_shadow_parts(key)
            if not mission or not uid:
                continue
            record = _i568_clone(record)
            shadow = _i568_clone(record.get('row'))
            age = max(0.0, now - float(record.get('created_epoch') or now))
            mission_members = {_i568_text(value).casefold() for value in (membership.get(mission) or []) if _i568_text(value)}
            membership_contains = uid in mission_members
            if membership_contains:
                record['membership_seen'] = True
                record['membership_seen_epoch'] = now

            exact = _i583_exact_rows(out, mission, uid)
            authoritative_exact = [row for row in exact if not row.get('data_sync_optimistic_i583')]
            canonical_handoff = bool(record.get('membership_seen') and enriched_phase and authoritative_exact and any(_i583_specific_symbol(row) for row in authoritative_exact))

            decision = _i568_text(decisions.get(mission))
            deletion_confirmed = bool(
                record.get('membership_seen') and not membership_contains and
                decision in (
                    'accepted-complete-nonempty', 'accepted-empty-second-read',
                    'accepted-empty-no-prior-membership', 'accepted-missing-mission-second-read'
                )
            )
            if allow_retire and (canonical_handoff or deletion_confirmed):
                retired.append({'key': key, 'reason': 'canonical-handoff' if canonical_handoff else 'authoritative-deletion'})
                continue

            # A safety expiry only removes an unconfirmed shadow after 15 minutes;
            # it never silently becomes an authoritative deletion decision.
            if allow_retire and age > _I583_OPTIMISTIC_MAX_SECONDS and not record.get('membership_seen'):
                retired.append({'key': key, 'reason': 'unconfirmed-expired'})
                continue

            replaced = False
            next_objects = []
            for row in objects:
                if isinstance(row, dict) and _i582_object_key(row) == (mission, uid):
                    if not replaced:
                        next_objects.append(_i583_merge_shadow_row(shadow, row))
                        replaced = True
                    continue
                next_objects.append(row)
            if not replaced:
                next_objects.append(_i583_merge_shadow_row(shadow, {}))
            objects = next_objects

            uid_replaced = False
            next_uids = []
            for row in uid_rows:
                if isinstance(row, dict) and _i582_object_key(row) == (mission, uid):
                    if not uid_replaced:
                        next_uids.append(_i583_merge_shadow_row(shadow, row))
                        uid_replaced = True
                    continue
                next_uids.append(row)
            if not uid_replaced:
                next_uids.append(_i583_merge_shadow_row(shadow, {}))
            uid_rows = next_uids

            mission_found = False
            missions = []
            for mission_row in list(out.get('missions') or []):
                name = _i568_text((mission_row or {}).get('name') if isinstance(mission_row, dict) else mission_row)
                if name.casefold() != mission:
                    missions.append(mission_row)
                    continue
                mission_found = True
                if isinstance(mission_row, dict):
                    mission_row = _i568_clone(mission_row)
                    rows = list(mission_row.get('uids') or [])
                    if not any(isinstance(row, dict) and _i582_object_key(row) == (mission, uid) for row in rows):
                        rows.append(_i583_merge_shadow_row(shadow, {}))
                    mission_row['uids'] = rows
                missions.append(mission_row)
            if not mission_found:
                missions.append({'name': shadow.get('mission_name') or shadow.get('mission') or mission,
                                 'uids': [_i583_merge_shadow_row(shadow, {})],
                                 'source': 'TAK Map optimistic Data Sync i583'})
            out['missions'] = missions
            record['row'] = shadow
            record['last_merged_epoch'] = now
            active[key] = record

        out['objects'] = objects
        out['mission_uids'] = uid_rows
        if isinstance(state, dict) and allow_retire:
            state['i583_optimistic_rows'] = active
            state['i583_last_optimistic_retired'] = retired[-40:]
        out['version'] = _I583_VERSION
        out['data_sync_optimistic_handoff_i583'] = {
            'version': _I583_VERSION,
            'phase': _i568_text(phase),
            'active_count': len(active),
            'retired_count': len(retired),
            'retired': retired[-20:],
            'exact_uid_required_for_handoff': True,
            'partial_rows_cannot_downgrade_symbol_or_name': True,
            'older_snapshot_cannot_remove_pending_create': True,
        }
        return out

    _i583_load_before = _i568_load_persisted_state
    def _i568_load_persisted_state(key):
        state = _i583_load_before(key)
        try:
            raw = load_json_file(_i568_snapshot_path(key), {})
            if isinstance(raw, dict):
                state['i583_optimistic_rows'] = dict(raw.get('i583_optimistic_rows') or {})
        except Exception:
            pass
        state.setdefault('i583_optimistic_rows', {})
        state.setdefault('i583_pending_membership', False)
        state.setdefault('i583_pending_full', False)
        state.setdefault('i583_active_mode', '')
        state.setdefault('i583_worker_running', False)
        return state
    globals()['_i568_load_persisted_state'] = _i568_load_persisted_state

    def _i568_persist_success(state):
        try:
            _I568_SNAPSHOT_ROOT.mkdir(parents=True, exist_ok=True)
            atomic_write_json(_i568_snapshot_path(state['key']), {
                'version': _I583_VERSION,
                'ots_contract': globals().get('_I569_OTS_CONTRACT', ''),
                'last_success_epoch': state.get('last_success_epoch') or 0,
                'generation': state.get('generation') or 0,
                'endpoint_timings': list(state.get('endpoint_timings') or [])[:240],
                'acquisition_summary': dict(state.get('acquisition_summary') or {}),
                'i581_last_membership_success_epoch': state.get('i581_last_membership_success_epoch') or 0,
                'i581_last_full_cot_epoch': state.get('i581_last_full_cot_epoch') or 0,
                'i581_membership_map': dict(state.get('i581_membership_map') or {}),
                'i581_membership_signature': state.get('i581_membership_signature') or '',
                'i582_zero_candidates': dict(state.get('i582_zero_candidates') or {}),
                'i583_optimistic_rows': dict(state.get('i583_optimistic_rows') or {}),
                'snapshot': state.get('snapshot'),
            })
        except Exception as exc:
            state['snapshot_persist_warning'] = _i568_text(exc)
    globals()['_i568_persist_success'] = _i568_persist_success

    _i583_publish_before = _i582_publish_state
    def _i582_publish_state(key, generation, snapshot, acquired, phase, membership=None,
                            candidates=None, added=None, deleted=None, keep_in_flight=False,
                            error='', full_cot_completed=False, addition_enrichment_completed=False):
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            merged = _i583_merge_optimistic(snapshot, state, phase, membership, allow_retire=True)
        result = _i583_publish_before(
            key, generation, merged, acquired, phase, membership=membership,
            candidates=candidates, added=added, deleted=deleted,
            keep_in_flight=keep_in_flight, error=error,
            full_cot_completed=full_cot_completed,
            addition_enrichment_completed=addition_enrichment_completed,
        )
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            if state.get('i583_worker_running'):
                state['in_flight'] = True
        return result
    globals()['_i582_publish_state'] = _i582_publish_state

    def _i583_store_optimistic(payload, reply):
        if not isinstance(payload, dict) or not isinstance(reply, dict):
            return None
        mission = _i568_text(payload.get('mission_name') or payload.get('mission'))
        point = reply.get('point') if isinstance(reply.get('point'), dict) else {}
        uid = _i568_text(point.get('event_uid') or point.get('cot_uid') or point.get('uid'))
        if not mission or not uid:
            return None
        try:
            full = _i570_snapshot_find(uid, mission) if '_i570_snapshot_find' in globals() else None
        except Exception:
            full = None
        row = _i568_clone(full or point or {})
        symbol = payload.get('symbol') if isinstance(payload.get('symbol'), dict) else {}
        name = _i568_text(payload.get('name') or row.get('callsign') or row.get('name') or 'TAK Map Point')
        lat = payload.get('lat') if payload.get('lat') is not None else row.get('lat')
        lon = payload.get('lon') if payload.get('lon') is not None else row.get('lon')
        row.update({
            'uid': uid, 'event_uid': uid, 'cot_uid': uid,
            'canonical_cot_uid_i546': uid,
            'callsign': name, 'name': name,
            'lat': lat, 'lon': lon, 'raw_lat': lat, 'raw_lon': lon,
            'coords': [[lat, lon]] if lat is not None and lon is not None else row.get('coords'),
            'mission': mission, 'mission_name': mission, 'mission_names': [mission],
            'kind': 'datasync', 'is_mission_object': True,
            'source': 'TAK Map save read-back optimistic handoff i583',
            'data_sync_optimistic_source_i583': 'tak-map-save-readback',
        })
        sidc = _i568_text(symbol.get('sidc') or row.get('sidc') or row.get('SIDC'))
        cot_type = _i568_text(symbol.get('cot_type') or row.get('cot_type') or row.get('type'))
        icon_path = _i568_text(symbol.get('iconsetpath') or symbol.get('iconset_path') or row.get('iconsetpath') or row.get('iconset_path'))
        if sidc:
            row['sidc'] = sidc; row['SIDC'] = sidc
        if cot_type:
            row['cot_type'] = cot_type; row['atak_cot_type'] = cot_type; row['event_type'] = cot_type; row['type'] = cot_type
        if icon_path:
            row['iconsetpath'] = icon_path; row['iconset_path'] = icon_path
        for field in ('name', 'label', 'file'):
            value = _i568_text(symbol.get(field))
            if value:
                row['mil2525_' + field] = value
        key = _i570_context_state_key() if '_i570_context_state_key' in globals() else ''
        if not key:
            return None
        shadow_key = _i583_shadow_key(mission, uid)
        now = time.time()
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            shadows = dict(state.get('i583_optimistic_rows') or {})
            prior = dict(shadows.get(shadow_key) or {})
            shadows[shadow_key] = {
                'row': row,
                'created_epoch': float(prior.get('created_epoch') or now),
                'updated_epoch': now,
                'membership_seen': bool(prior.get('membership_seen')),
                'membership_seen_epoch': float(prior.get('membership_seen_epoch') or 0),
            }
            state['i583_optimistic_rows'] = shadows
            state['snapshot'] = _i583_merge_optimistic(
                state.get('snapshot') if isinstance(state.get('snapshot'), dict) else {'ok': True, 'objects': [], 'mission_uids': [], 'missions': []},
                state, 'post-save-optimistic-published', state.get('i581_membership_map') or {}, allow_retire=False)
            state['last_success_epoch'] = max(float(state.get('last_success_epoch') or 0), now)
            state['acquisition_summary'] = dict(state.get('acquisition_summary') or {})
            state['acquisition_summary']['phase'] = 'post-save-optimistic-published'
            _i568_persist_success(state)
        return {'key': key, 'shadow_key': shadow_key, 'uid': uid, 'mission': mission, 'row': row}

    _i583_save_before = _i555_save_point
    def _i555_save_point(payload):
        reply, status = _i583_save_before(payload)
        if status == 200 and isinstance(reply, dict) and reply.get('ok') and reply.get('redraw_allowed'):
            try:
                optimistic = _i583_store_optimistic(payload, reply)
                if optimistic:
                    reply = dict(reply)
                    reply['version'] = _I583_VERSION
                    reply['optimistic_data_sync_handoff_i583'] = {
                        'active': True, 'uid': optimistic['uid'], 'mission': optimistic['mission'],
                        'persisted_per_user': True, 'older_snapshot_cannot_remove': True,
                    }
                    cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
                    sess = _i570_context_session() if '_i570_context_session' in globals() else {}
                    token = _i568_text((sess or {}).get('_i570_token'))
                    _i568_schedule_refresh(optimistic['key'], cfg or {}, sess or {}, token,
                                           'i583-post-save-membership-fastpath', force=False)
            except Exception as exc:
                reply = dict(reply)
                reply['optimistic_handoff_warning_i583'] = _i568_text(exc)
        return reply, status
    globals()['_i555_save_point'] = _i555_save_point

    _i583_worker_before = _i568_refresh_worker
    def _i568_refresh_worker(key, cfg, sess, token, reason, generation):
        try:
            return _i583_worker_before(key, cfg, sess, token, reason, generation)
        finally:
            next_full = next_membership = False
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                if int(state.get('generation') or 0) == int(generation):
                    state['i583_active_mode'] = ''
                    state['i583_worker_running'] = False
                    state['in_flight'] = False
                    next_full = bool(state.pop('i583_pending_full', False))
                    next_membership = bool(state.pop('i583_pending_membership', False))
                    state['i581_pending_full'] = False
            try:
                if next_full:
                    _i568_schedule_refresh(key, cfg, sess, token, 'i583-coalesced-full-once', force=True)
                elif next_membership:
                    _i568_schedule_refresh(key, cfg, sess, token, 'i583-coalesced-membership-once', force=False)
            except Exception:
                pass
    globals()['_i568_refresh_worker'] = _i568_refresh_worker

    def _i568_schedule_refresh(key, cfg, sess, token, reason, force=False):
        now = time.time()
        reason_text = _i568_text(reason)
        post_save = 'post-save' in reason_text.casefold() or 'new-registry-point' in reason_text.casefold()
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            state.setdefault('i581_last_membership_success_epoch', 0.0)
            state.setdefault('i581_last_full_cot_epoch', 0.0)
            state.setdefault('i583_pending_membership', False)
            state.setdefault('i583_pending_full', False)
            state.setdefault('i583_active_mode', '')
            last_membership = float(state.get('i581_last_membership_success_epoch') or 0)
            last_full = float(state.get('i581_last_full_cot_epoch') or 0)
            membership_due = bool(not last_membership or now - last_membership >= _I583_MEMBERSHIP_INTERVAL_SECONDS)
            full_due = bool(force or not last_full or now - last_full >= _I583_FULL_COT_INTERVAL_SECONDS)
            if state.get('i583_worker_running') or state.get('in_flight'):
                active = _i568_text(state.get('i583_active_mode'))
                if force:
                    # An explicit manual request is retained once, never recursively.
                    state['i583_pending_full'] = True
                elif post_save:
                    # The optimistic row is already visible; queue exactly one
                    # membership pass so canonical handoff follows promptly.
                    state['i583_pending_membership'] = True
                elif full_due and active != 'full':
                    state['i583_pending_full'] = True
                elif membership_due and active not in ('membership', 'full'):
                    state['i583_pending_membership'] = True
                state['i581_pending_full'] = False
                return False, 'already-running-coalesced-i583'
            last_attempt = float(state.get('last_attempt_started_epoch') or 0)
            if not force and last_attempt and now - last_attempt < _I568_RETRY_COOLDOWN_SECONDS and not state.get('snapshot'):
                return False, 'retry-cooldown'
            requested_full = bool(full_due and not post_save)
            state['generation'] = int(state.get('generation') or 0) + 1
            generation = state['generation']
            state['in_flight'] = True
            state['last_attempt_started_epoch'] = now
            state['last_reason'] = reason_text or ('manual' if force else 'automatic')
            state['i581_requested_full'] = requested_full
            state['i581_requested_mode'] = 'membership-and-full-cot' if requested_full else 'membership-only'
            state['i583_active_mode'] = 'full' if requested_full else 'membership'
            state['i583_worker_running'] = True
            state['i581_pending_full'] = False
        thread = threading.Thread(
            target=_i568_refresh_worker,
            args=(key, _i568_clone(cfg), _i568_clone(sess), _i568_text(token), reason_text, generation),
            name='tak-map-i583-data-sync-' + str(key)[:8], daemon=True,
        )
        thread.start()
        return True, 'scheduled-full-i583' if requested_full else 'scheduled-membership-i583'
    globals()['_i568_schedule_refresh'] = _i568_schedule_refresh

    _i583_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i583_response_before(state)
        if not isinstance(payload, dict):
            return payload
        with _I568_STATE_LOCK:
            payload = _i583_merge_optimistic(payload, state,
                ((state.get('acquisition_summary') or {}).get('phase') if isinstance(state, dict) else ''),
                (state.get('i581_membership_map') or {}) if isinstance(state, dict) else {}, allow_retire=False)
            diag = dict(payload.get('data_sync_background_i582') or payload.get('data_sync_background_i581') or {})
            diag.update({
                'version': _I583_VERSION,
                'membership_interval_seconds': _I583_MEMBERSHIP_INTERVAL_SECONDS,
                'full_cot_enrichment_interval_seconds': _I583_FULL_COT_INTERVAL_SECONDS,
                'browser_snapshot_poll_seconds': _I583_BROWSER_POLL_SECONDS,
                'active_mode': state.get('i583_active_mode') or '',
                'worker_running': bool(state.get('i583_worker_running')),
                'pending_membership_once': bool(state.get('i583_pending_membership')),
                'pending_full_once': bool(state.get('i583_pending_full')),
                'optimistic_row_count': len(state.get('i583_optimistic_rows') or {}),
                'recursive_forced_full_chain_prevented': True,
                'post_save_optimistic_snapshot_immediate': True,
                'exact_uid_canonical_handoff': True,
            })
        payload['data_sync_background_i583'] = diag
        payload['data_sync_background_i582'] = dict(diag)
        payload['version'] = _I583_VERSION
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i583_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i583_config_before() or {})
        cfg['tak_map_iteration'] = _I583_VERSION
        cfg['version'] = '1.3.0-i583'
        cfg['data_sync_background_i583'] = {
            'version': _I583_VERSION,
            'membership_interval_seconds': _I583_MEMBERSHIP_INTERVAL_SECONDS,
            'full_cot_enrichment_interval_seconds': _I583_FULL_COT_INTERVAL_SECONDS,
            'browser_snapshot_poll_seconds': _I583_BROWSER_POLL_SECONDS,
            'persistent_per_user_optimistic_rows': True,
            'exact_uid_canonical_handoff': True,
            'partial_rows_cannot_downgrade_known_symbol': True,
            'older_snapshots_cannot_remove_pending_create': True,
            'separate_single_flight_pending_membership_and_full': True,
            'recursive_forced_full_chain_prevented': True,
            'incomplete_success_never_authorizes_pruning': True,
            'nonempty_to_zero_requires_cot_or_second_complete_read': True,
            'manual_refresh_preserves_current_snapshot_until_corroborated': True,
            'cot_reconciles_incomplete_membership': True,
            'per_mission_failure_isolation': True,
        }
        control = dict(cfg.get('data_sync_control') or {})
        control.update({
            'version': _I583_VERSION,
            'automatic_poll_seconds': _I583_BROWSER_POLL_SECONDS,
            'minimum_browser_request_interval_seconds': 4,
            'actual_recurring_browser_timer_installed': True,
        })
        cfg['data_sync_control'] = control
        startup = dict(cfg.get('startup_architecture_i582') or {})
        startup.update({
            'package_version': _I583_VERSION,
            'startup_loader_cache_identity': '1.3.0-i583',
            'core_cache_identity': '1.3.0-i583',
            'manifest_cache_identity': '1.3.0-i583',
            'data_sync_control_cache_identity': '1.3.0-i583',
            'data_sync_poll_seconds': _I583_BROWSER_POLL_SECONDS,
        })
        cfg['startup_architecture_i583'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i583_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+', '1.3.0-i583', html)
        html = re.sub(r'TAKDashboard/i\d+', 'TAKDashboard/i583', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i583', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i583\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i583\2', html)
        html = re.sub(r'/assets/runtime/tak-map-startup-i553\.js\?v=[^"\']+', '/assets/runtime/tak-map-startup-i553.js?v=1.3.0-i583', html)
        html = re.sub(r'/assets/runtime/tak-map-context-sidebar-i572\.js\?v=[^"\']+', '/assets/runtime/tak-map-context-sidebar-i572.js?v=1.3.0-i583', html)
        html = re.sub(r'/assets/runtime/tak-map-data-sync-access-i576\.js\?v=[^"\']+', '/assets/runtime/tak-map-data-sync-access-i576.js?v=1.3.0-i583', html)
        html = re.sub(r'/assets/runtime/tak-map-package-i580\.js\?v=[^"\']+', '/assets/runtime/tak-map-package-i580.js?v=1.3.0-i583', html)
        return html

    TAK_MAP_HTML = _i583_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i583_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I583_VERSION
except Exception as _i583_exc:
    try:
        print('TAK Map i583 optimistic Data Sync handoff patch failed:', _i583_exc)
    except Exception:
        pass
# --- end TAK Map i583 optimistic Data Sync handoff and single-flight cadence ---

# --- TAK Map i583 reversible Mission-marker hotfix hf1 ---
try:
    _I583_HF1_VERSION = 'i583-hf1'
    _I583_HF1_CONFIRM_SECONDS = 30
    _I583_HF1_CONFIRM_INTERVAL_SECONDS = 2
    _I583_HF1_CONFIRM_LOCK = threading.RLock()
    _I583_HF1_CONFIRMING = set()

    def _i583hf_text(value):
        return str(value or '').strip()

    def _i583hf_float(value, default=0.0):
        try:
            number = float(value)
            return number if math.isfinite(number) else float(default)
        except Exception:
            return float(default)

    def _i583hf_uuid4(value):
        text = _i583hf_text(value)
        try:
            parsed = uuid.UUID(text, version=4)
            return str(parsed) if parsed.version == 4 else ''
        except Exception:
            return ''

    def _i583hf_marker_payload(xml):
        root = ET.fromstring(_i583hf_text(xml).encode('utf-8'))
        uid = _i583hf_uuid4(root.attrib.get('uid'))
        cot_type = _i583hf_text(root.attrib.get('type'))
        point = root.find('point')
        if not uid or point is None:
            raise ValueError('The point requires a UUID4 event UID and CoT point element.')
        lat = _i583hf_float(point.attrib.get('lat'), float('nan'))
        lon = _i583hf_float(point.attrib.get('lon'), float('nan'))
        if not math.isfinite(lat) or not math.isfinite(lon) or lat < -90 or lat > 90 or lon < -180 or lon > 180:
            raise ValueError('The point latitude/longitude is invalid.')
        detail = root.find('detail')
        contact = detail.find('contact') if detail is not None else None
        name = _i583hf_text(contact.attrib.get('callsign') if contact is not None else '') or uid
        icon_path = ''
        if detail is not None:
            usericon = detail.find('usericon')
            if usericon is not None:
                icon_path = _i583hf_text(usericon.attrib.get('iconsetpath') or usericon.attrib.get('path'))
        payload = {
            'uid': uid,
            'name': name[:120],
            'latitude': lat,
            'longitude': lon,
            'type': cot_type or 'a-u-G',
            'hae': _i583hf_float(point.attrib.get('hae'), 0.0),
            'ce': _i583hf_float(point.attrib.get('ce'), 9999999.0),
            'le': _i583hf_float(point.attrib.get('le'), 9999999.0),
        }
        return payload, icon_path

    def _i583hf_api_request(path, method='GET', payload=None, timeout=20):
        cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
        sess = _i570_context_session() if '_i570_context_session' in globals() else {}
        token = _i583hf_text((sess or {}).get('_i570_token'))
        base = _i583hf_text((cfg or {}).get('api_url') or (cfg or {}).get('base_url')).rstrip('/')
        if not base:
            return {'ok': False, 'status': 0, 'error': 'OpenTAKServer Web/API URL is not configured.'}
        if not token:
            return {'ok': False, 'status': 401, 'error': 'The authenticated OpenTAKServer session token is unavailable.'}
        url = base + ('/' + _i583hf_text(path).lstrip('/'))
        body = None if payload is None else json.dumps(payload, separators=(',', ':')).encode('utf-8')
        headers = {
            'Accept': 'application/json',
            'Authorization': 'Bearer ' + token,
            'User-Agent': 'TAKDashboard/i583-hf1',
        }
        if body is not None:
            headers['Content-Type'] = 'application/json; charset=UTF-8'
            headers['Content-Length'] = str(len(body))
        request_obj = Request(url, data=body, headers=headers, method=method)
        context = _i509_ssl_context(cfg) if '_i509_ssl_context' in globals() else None
        started = time.monotonic()
        try:
            with urlopen(request_obj, timeout=timeout, context=context) as response:
                raw = response.read().decode('utf-8', errors='replace')
                try:
                    parsed = json.loads(raw) if raw else {}
                except Exception:
                    parsed = {'raw': raw[:4000]}
                status = int(getattr(response, 'status', 200) or 200)
                return {
                    'ok': 200 <= status < 300,
                    'status': status,
                    'json': parsed,
                    'url': url,
                    'duration_seconds': round(time.monotonic() - started, 3),
                }
        except HTTPError as exc:
            try:
                raw = exc.read().decode('utf-8', errors='replace')
            except Exception:
                raw = ''
            return {
                'ok': False,
                'status': int(getattr(exc, 'code', 0) or 0),
                'error': raw[:4000] or str(exc),
                'url': url,
                'duration_seconds': round(time.monotonic() - started, 3),
            }
        except Exception as exc:
            return {
                'ok': False,
                'status': 0,
                'error': str(exc),
                'url': url,
                'duration_seconds': round(time.monotonic() - started, 3),
            }

    _i583hf_native_before = _i526_send_native_mission_cot
    def _i526_send_native_mission_cot(mission, creator_uid, xml, server_host=''):
        try:
            marker, icon_path = _i583hf_marker_payload(xml)
        except Exception as exc:
            out = dict(_i583hf_native_before(mission, creator_uid, xml, server_host) or {})
            out['i583_hf1_transport'] = 'legacy-per-user-cot'
            out['i583_hf1_fallback_reason'] = 'not-a-compatible-uuid4-point: ' + _i583hf_text(exc)
            return out

        # Standard ATAK MIL-STD-2525C icon paths are represented by the CoT type
        # in the marker API. Truly custom iconsets still require the prior transport.
        if icon_path and not icon_path.upper().startswith('COT_MAPPING_2525C/'):
            out = dict(_i583hf_native_before(mission, creator_uid, xml, server_host) or {})
            out['i583_hf1_transport'] = 'legacy-per-user-cot-custom-icon'
            out['i583_hf1_fallback_reason'] = 'custom-usericon-not-supported-by-ots-marker-api'
            return out

        api = dict(_i583hf_api_request('/api/markers', method='POST', payload=marker, timeout=20) or {})
        if not api.get('ok'):
            # Do not silently fall back to an EUD CoT socket for new standard points;
            # that would recreate the ATAK Contacts regression this hotfix targets.
            return {
                'ok': False,
                'status': int(api.get('status') or 502),
                'error': 'OpenTAKServer marker API publication failed: ' + _i583hf_text(api.get('error') or api.get('json')),
                'event_uid': marker['uid'],
                'mission': _i583hf_text(mission),
                'creator_uid': _i583hf_text(creator_uid),
                'publication_stage': 'ots-marker-api-failed-no-eud-fallback',
                'i583_hf1_transport': 'ots-marker-api',
                'live_eud_socket_used': False,
                'point_uid_used_as_eud_identity': False,
                'eud_presence': False,
                'marker_api_result': api,
            }
        return {
            'ok': True,
            'status': int(api.get('status') or 200),
            'event_uid': marker['uid'],
            'mission': _i583hf_text(mission),
            'creator_uid': _i583hf_text(creator_uid),
            'publication_stage': 'ots-marker-api-server-map-object',
            'i583_hf1_transport': 'ots-marker-api',
            'marker_api_result': api,
            'marker_payload': marker,
            'mission_object': True,
            'live_eud_socket_used': False,
            'point_uid_used_as_eud_identity': False,
            'eud_presence': False,
            'takv_emitted_for_point': False,
            'group_presence_emitted_for_point': False,
            'status_presence_emitted_for_point': False,
            'point_name_transport': 'marker-name-and-cot-contact-label',
            'location_preserved': True,
            'exact_latitude': marker['latitude'],
            'exact_longitude': marker['longitude'],
            'hae': marker['hae'],
            'ce': marker['ce'],
            'le': marker['le'],
        }
    globals()['_i526_send_native_mission_cot'] = _i526_send_native_mission_cot

    def _i583hf_verified_row(row, uid='', mission=''):
        row = _i568_clone(row or {}) if '_i568_clone' in globals() else dict(row or {})
        uid = _i583hf_text(uid or row.get('event_uid') or row.get('cot_uid') or row.get('uid'))
        mission = _i583hf_text(mission or row.get('mission_name') or row.get('mission'))
        digest = hashlib.sha256((mission.casefold() + '\x00' + uid.casefold()).encode('utf-8')).hexdigest()[:24]
        object_id = _i583hf_text(row.get('object_id')) or ('datasync-' + digest)
        row.update({
            'uid': uid,
            'event_uid': uid,
            'cot_uid': uid,
            'source_id': uid,
            'object_id': object_id,
            'canonical_id': 'datasync:' + object_id,
            'source_kind': 'datasync',
            'source': 'Published · awaiting Mission index',
            'mission': mission,
            'mission_name': mission,
            'mission_names': [mission] if mission else list(row.get('mission_names') or []),
            'mission_delete_target': 'uid',
            'mission_delete_value': uid,
            'delete_supported': True,
            'delete_unavailable_reason': '',
            'data_sync_source_identity_verified_i583_hf1': True,
            'data_sync_confirmation_state_i583_hf1': 'published-source-verified',
            'data_sync_handoff_pending_i583_hf1': True,
            'data_sync_status_label_i583_hf1': 'Published · awaiting Mission index',
            'data_sync_optimistic_i583': True,
            'point_name': _i583hf_text(row.get('name') or row.get('callsign')),
            'point_not_eud_i583_hf1': True,
        })
        return row

    _i583hf_merge_before = _i583_merge_shadow_row
    def _i583_merge_shadow_row(shadow, current):
        merged = _i583hf_merge_before(shadow, current)
        if isinstance(shadow, dict) and shadow.get('data_sync_source_identity_verified_i583_hf1'):
            merged = _i583hf_verified_row(merged)
        return merged
    globals()['_i583_merge_shadow_row'] = _i583_merge_shadow_row

    def _i583hf_targeted_confirm(key, shadow_key, mission, uid, cfg, sess, token):
        confirm_key = key + '\x1f' + shadow_key
        started = time.time()
        last_error = ''
        try:
            while time.time() - started < _I583_HF1_CONFIRM_SECONDS:
                try:
                    path = '/Marti/api/missions/' + quote(mission, safe='') + '/cot'
                    url = _i583hf_text((cfg or {}).get('marti_url')).rstrip('/') + path
                    _returned_url, result, timing = _i569_call(
                        cfg or {}, sess or {}, token, url, path,
                        'i583-hf1-targeted-exact-uid-confirmation', 4)
                    row = _i570_readback_row(result, mission, uid) if '_i570_readback_row' in globals() else None
                    if isinstance(row, dict) and _i583hf_text(row.get('event_uid') or row.get('cot_uid') or row.get('uid')).casefold() == uid.casefold():
                        with _I568_STATE_LOCK:
                            state = _i568_state(key)
                            shadows = dict(state.get('i583_optimistic_rows') or {})
                            record = dict(shadows.get(shadow_key) or {})
                            current = dict(record.get('row') or {})
                            exact = _i570_merge_dict_nonempty(current, row) if '_i570_merge_dict_nonempty' in globals() else dict(current, **row)
                            record['row'] = _i583hf_verified_row(exact, uid, mission)
                            record['membership_seen'] = True
                            record['membership_seen_epoch'] = time.time()
                            record['targeted_confirmation_complete_i583_hf1'] = True
                            record['targeted_confirmation_seconds_i583_hf1'] = round(time.time() - started, 3)
                            shadows[shadow_key] = record
                            state['i583_optimistic_rows'] = shadows
                            state['snapshot'] = _i583_merge_optimistic(
                                state.get('snapshot') if isinstance(state.get('snapshot'), dict) else {'ok': True, 'objects': [], 'mission_uids': [], 'missions': []},
                                state, 'i583-hf1-targeted-exact-uid-confirmed', state.get('i581_membership_map') or {}, allow_retire=False)
                            state['i583_hf1_last_targeted_confirmation'] = {
                                'uid': uid, 'mission': mission, 'ok': True,
                                'seconds': round(time.time() - started, 3),
                                'timing': timing,
                            }
                            _i568_persist_success(state)
                        try:
                            _i568_schedule_refresh(key, cfg or {}, sess or {}, token,
                                                   'i583-hf1-targeted-confirmed-membership-fastpath', force=False)
                        except Exception:
                            pass
                        return
                    last_error = _i583hf_text((result or {}).get('error') if isinstance(result, dict) else '') or 'Exact UID not returned yet.'
                except Exception as exc:
                    last_error = _i583hf_text(exc)
                time.sleep(_I583_HF1_CONFIRM_INTERVAL_SECONDS)
            with _I568_STATE_LOCK:
                state = _i568_state(key)
                state['i583_hf1_last_targeted_confirmation'] = {
                    'uid': uid, 'mission': mission, 'ok': False,
                    'seconds': round(time.time() - started, 3),
                    'error': last_error or 'Targeted confirmation deadline expired.',
                    'point_remains_visible': True,
                    'delete_remains_available': True,
                }
                _i568_persist_success(state)
        finally:
            with _I583_HF1_CONFIRM_LOCK:
                _I583_HF1_CONFIRMING.discard(confirm_key)

    def _i583hf_start_targeted_confirm(optimistic):
        if not isinstance(optimistic, dict):
            return False
        key = _i583hf_text(optimistic.get('key'))
        shadow_key = _i583hf_text(optimistic.get('shadow_key'))
        mission = _i583hf_text(optimistic.get('mission'))
        uid = _i583hf_text(optimistic.get('uid'))
        if not all((key, shadow_key, mission, uid)):
            return False
        confirm_key = key + '\x1f' + shadow_key
        with _I583_HF1_CONFIRM_LOCK:
            if confirm_key in _I583_HF1_CONFIRMING:
                return False
            _I583_HF1_CONFIRMING.add(confirm_key)
        cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
        sess = _i570_context_session() if '_i570_context_session' in globals() else {}
        token = _i583hf_text((sess or {}).get('_i570_token'))
        thread = threading.Thread(
            target=_i583hf_targeted_confirm,
            args=(key, shadow_key, mission, uid, _i568_clone(cfg or {}), _i568_clone(sess or {}), token),
            name='tak-map-i583-hf1-confirm-' + uid[:8], daemon=True,
        )
        thread.start()
        return True

    _i583hf_store_before = _i583_store_optimistic
    def _i583_store_optimistic(payload, reply):
        result = _i583hf_store_before(payload, reply)
        if not isinstance(result, dict):
            return result
        key = _i583hf_text(result.get('key'))
        shadow_key = _i583hf_text(result.get('shadow_key'))
        uid = _i583hf_text(result.get('uid'))
        mission = _i583hf_text(result.get('mission'))
        with _I568_STATE_LOCK:
            state = _i568_state(key)
            shadows = dict(state.get('i583_optimistic_rows') or {})
            record = dict(shadows.get(shadow_key) or {})
            verified = _i583hf_verified_row(record.get('row') or result.get('row') or {}, uid, mission)
            record['row'] = verified
            # The create request already completed an exact-UID Mission /cot read-back.
            record['membership_seen'] = True
            record['membership_seen_epoch'] = time.time()
            record['source_identity_verified_i583_hf1'] = True
            record['targeted_confirmation_started_i583_hf1'] = time.time()
            shadows[shadow_key] = record
            state['i583_optimistic_rows'] = shadows
            state['snapshot'] = _i583_merge_optimistic(
                state.get('snapshot') if isinstance(state.get('snapshot'), dict) else {'ok': True, 'objects': [], 'mission_uids': [], 'missions': []},
                state, 'i583-hf1-source-verified', state.get('i581_membership_map') or {}, allow_retire=False)
            _i568_persist_success(state)
        result = dict(result)
        result['row'] = verified
        result['delete_supported'] = True
        result['source_identity_verified'] = True
        result['status_label'] = 'Published · awaiting Mission index'
        _i583hf_start_targeted_confirm(result)
        return result
    globals()['_i583_store_optimistic'] = _i583_store_optimistic

    _i583hf_delete_before = _tak_data_sync_delete_record
    def _tak_data_sync_delete_record(obj, server_host=''):
        result = dict(_i583hf_delete_before(obj, server_host) or {})
