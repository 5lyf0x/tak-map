# --- TAK Map i584 integrated Mission-marker publication and handoff ---
try:
    _I584_VERSION = 'i584'

    _i584_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i584_config_before() or {})
        cfg['tak_map_iteration'] = _I584_VERSION
        cfg['version'] = '1.3.0-i584'
        cfg['data_sync_marker_publication_i584'] = {
            'version': _I584_VERSION,
            'transport': 'OpenTAKServer marker API plus Mission UID association',
            'uuid4_event_identity': True,
            'point_not_eud_or_contact': True,
            'creator_identity_separate_from_point_identity': True,
            'point_name_preserved': True,
            'latitude_longitude_preserved': True,
            'hae_ce_le_preserved_when_available': True,
            'milstd2525c_symbol_and_affiliation_preserved': True,
            'login_time_flask_security_marker_token': True,
            'oauth_bearer_not_used_for_marker_api': True,
            'marker_write_plus_mission_association_completes_save': True,
            'mission_cot_indexing_is_background_handoff': True,
            'immediate_delete_metadata': True,
            'single_visible_optimistic_marker': True,
            'create_dialog_and_preview_close_after_association': True,
            'temporary_generic_duplicates_suppressed': True,
            'global_generic_symbol_unchanged': True,
            'live_validated_stack': ['hf1', 'hf4', 'hf5-r2', 'hf6'],
        }
        # Keep the established i583 diagnostic keys for compatibility, while
        # publishing an authoritative i584 release-level summary.
        startup = dict(cfg.get('startup_architecture_i583') or cfg.get('startup_architecture_i582') or {})
        startup.update({
            'package_version': _I584_VERSION,
            'startup_loader_cache_identity': '1.3.0-i584',
            'core_cache_identity': '1.3.0-i584',
            'manifest_cache_identity': '1.3.0-i584',
            'data_sync_control_cache_identity': '1.3.0-i584',
            'icon_registry_cache_identity': '1.3.0-i584',
            'data_sync_poll_seconds': 5,
        })
        cfg['startup_architecture_i584'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    _i584_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i584_response_before(state)
        if isinstance(payload, dict):
            payload['version'] = _I584_VERSION
            payload['data_sync_marker_publication_i584'] = {
                'version': _I584_VERSION,
                'point_not_eud_or_contact': True,
                'publication_success_after_marker_and_mission_association': True,
                'background_mission_index_handoff': True,
                'immediate_delete_metadata': True,
                'single_visible_optimistic_marker': True,
                'temporary_generic_duplicates_suppressed': True,
                'global_generic_symbol_unchanged': True,
            }
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    def _i584_patch_html(html):
        html = str(html or '')
        html = re.sub(r'1\.3\.0-i\d+(?:-hf[\w-]+)?', '1.3.0-i584', html)
        html = re.sub(r'TAKDashboard/i\d+(?:-hf[\w-]+)?', 'TAKDashboard/i584', html)
        html = re.sub(r'TAK-Map/1\.3\.0 i\d+', 'TAK-Map/1.3.0 i584', html)
        html = re.sub(r'(<span class="iteration-chip">)(?:i|v)\d+(</span>)', r'\1i584\2', html)
        html = re.sub(r'(<div class="iteration-marker">)(?:i|v)\d+(</div>)', r'\1i584\2', html)
        for asset in (
            'tak-map-startup-i553.js', 'tak-map-context-sidebar-i572.js',
            'tak-map-data-sync-access-i576.js', 'tak-map-package-i580.js',
            'tak-map-icon-registry-i572.js'):
            html = re.sub(
                r'(/assets/runtime/' + re.escape(asset) + r')\?v=[^"\']+',
                r'\1?v=1.3.0-i584', html)
        return html

    TAK_MAP_HTML = _i584_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i584_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
    TAK_MAP_ITERATION = _I584_VERSION
except Exception as _i584_exc:
    try:
        print('TAK Map i584 integrated Mission-marker release patch failed:', _i584_exc)
    except Exception:
        pass
# --- end TAK Map i584 integrated Mission-marker publication and handoff ---

# --- TAK Map i584 ATAK icon parity hotfix hf1: live delayed read-back + transport visual authority ---
try:
    _I584_PARITY_HF1_VERSION = 'i584-atak-icon-parity-hf1'

    def _i584p_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i584p_uid(value):
        if not isinstance(value, dict):
            return ''
        return _i584p_text(value.get('event_uid') or value.get('cot_uid') or value.get('uid') or value.get('source_uid') or value.get('id'))

    def _i584p_aff_code(value):
        if isinstance(value, dict):
            sidc = _i584p_text(value.get('atak_transport_sidc_i580') or value.get('sidc') or value.get('SIDC')).upper()
            if len(sidc) > 1 and sidc[1] in 'FHNU':
                return sidc[1]
            cot = _i584p_text(value.get('atak_transport_cot_type_i580') or value.get('cot_type') or value.get('type')).lower()
            match = re.match(r'^a-([fhnu])(?:-|$)', cot)
            if match:
                return match.group(1).upper()
            value = value.get('affiliation')
        raw = _i584p_text(value).lower()
        return {'friendly':'F','friend':'F','f':'F','hostile':'H','h':'H','neutral':'N','n':'N','unknown':'U','u':'U'}.get(raw, 'F')

    def _i584p_specific_cot(value):
        raw = _i584p_text(value).lower()
        return bool(re.match(r'^a-[fhnu]-[a-z0-9](?:-|$)', raw)) and raw not in ('a-f-g','a-h-g','a-n-g','a-u-g')

    def _i584p_specific_sidc(value):
        sidc = _i584p_text(value).upper()
        if len(sidc) < 10 or sidc[0] not in ('S','E','G'):
            return False
        core = sidc[4:10].replace('-', '') if sidc[0] == 'S' else sidc[3:10].replace('-', '')
        return len(core) >= 2

    def _i584p_delayed_publication(publish):
        if not isinstance(publish, dict):
            return None
        points = [row for row in list(publish.get('points') or []) if isinstance(row, dict)]
        if len(points) != 1:
            return None
        point = points[0]
        native = point.get('per_user_cot_ingest') if isinstance(point.get('per_user_cot_ingest'), dict) else point.get('native_mission_cot')
        association = point.get('associate_uid') if isinstance(point.get('associate_uid'), dict) else {}
        readback = point.get('mission_readback') if isinstance(point.get('mission_readback'), dict) else {}
        marker_result = (native or {}).get('marker_api_result') if isinstance((native or {}).get('marker_api_result'), dict) else {}
        uid = _i584p_text(point.get('uid') or point.get('event_uid') or (native or {}).get('event_uid') or (publish.get('event_uids') or [''])[0])
        marker_ok = bool(isinstance(native, dict) and native.get('ok') and marker_result.get('ok'))
        association_ok = bool(association.get('ok')) and (
            int(association.get('status') or 0) in range(200, 300)
            or bool(association.get('skipped'))
            or _i584p_text(association.get('association_endpoint')) == 'existing-mission-membership-preserved'
        )
        if not uid or not marker_ok or not association_ok or readback.get('ok'):
            return None
        if _i584p_text((native or {}).get('i583_hf1_transport')) != 'ots-marker-api':
            return None
        return {'uid': uid, 'point_result': point, 'native': native, 'association': association, 'readback': readback}

    def _i584p_transport_meta(payload, delayed):
        payload = payload if isinstance(payload, dict) else {}
        point = delayed.get('point_result') if isinstance(delayed, dict) else {}
        native = delayed.get('native') if isinstance(delayed, dict) else {}
        marker = native.get('marker_payload') if isinstance(native.get('marker_payload'), dict) else {}
        symbol = payload.get('symbol') if isinstance(payload.get('symbol'), dict) else {}
        probe = {
            'takmap_symbology_concept_i580': point.get('takmap_symbology_concept_i580') or symbol.get('takmap_symbology_concept_i580'),
            'mil2525_name': symbol.get('name') or point.get('mil2525_name'),
            'sidc': symbol.get('sidc') or point.get('sidc'),
            'cot_type': symbol.get('cot_type') or point.get('cot_type'),
            'affiliation': payload.get('affiliation') or symbol.get('affiliation'),
        }
        concept = _i584p_text(probe.get('takmap_symbology_concept_i580'))
        if not concept and '_i580_concept' in globals():
            try:
                concept = _i584p_text(_i580_concept(probe))
            except Exception:
                concept = ''
        aff = _i584p_aff_code(probe)
        pair = {}
        if concept and '_i580_pair' in globals():
            try:
                pair = _i580_pair(concept, aff) or {}
            except Exception:
                pair = {}
        display = dict(pair.get('display') or {})
        transport = dict(pair.get('transport') or {})
        sidc = _i584p_text(point.get('atak_transport_sidc_i580') or point.get('sidc') or transport.get('sidc') or symbol.get('sidc'))
        cot_type = _i584p_text(point.get('atak_transport_cot_type_i580') or point.get('cot_type') or marker.get('type') or transport.get('cot_type') or symbol.get('cot_type'))
        usericon = _i584p_text(point.get('atak_transport_usericon_i580') or point.get('iconset_path') or point.get('iconsetpath') or transport.get('usericon_path') or symbol.get('iconsetpath') or symbol.get('iconset_path'))
        # Hard affiliation gate: transport metadata may change identity/artwork, never affiliation.
        sidc_aff = sidc[1].upper() if len(sidc) > 1 and sidc[1].upper() in 'FHNU' else aff
        cot_match = re.match(r'^a-([fhnu])(?:-|$)', cot_type.lower())
        cot_aff = cot_match.group(1).upper() if cot_match else aff
        if sidc_aff != aff or cot_aff != aff:
            sidc = _i584p_text(symbol.get('sidc') or display.get('sidc'))
            cot_type = _i584p_text(symbol.get('cot_type') or display.get('cot_type'))
            usericon = ''
        alias = {}
        if sidc and '_I552_ALIAS_BY_SIDC' in globals():
            alias = dict((_I552_ALIAS_BY_SIDC or {}).get(sidc.upper()) or {})
        return {
            'concept': concept, 'affiliation': aff,
            'display': display, 'transport': transport,
            'sidc': sidc, 'cot_type': cot_type, 'usericon': usericon,
            'alias': alias,
        }

    def _i584p_delayed_row(payload, publish, delayed):
        if '_i583hf5_row' in globals():
            row = dict(_i583hf5_row(payload, publish, delayed) or {})
        else:
            row = {}
        meta = _i584p_transport_meta(payload, delayed)
        point = delayed.get('point_result') or {}
        native = delayed.get('native') or {}
        marker = native.get('marker_payload') if isinstance(native.get('marker_payload'), dict) else {}
        uid = _i584p_text(delayed.get('uid'))
        mission = _i584p_text((payload or {}).get('mission_name') or (payload or {}).get('mission') or (publish or {}).get('mission'))
        name = _i584p_text((payload or {}).get('name') or point.get('name') or marker.get('name')) or 'TAK Map Point'
        row.update({
            'uid': uid, 'event_uid': uid, 'cot_uid': uid, 'canonical_cot_uid_i546': uid,
            'name': name, 'callsign': name, 'point_name': name,
            'mission': mission, 'mission_name': mission, 'mission_names': [mission] if mission else [],
            'sidc': meta['sidc'], 'SIDC': meta['sidc'],
            'cot_type': meta['cot_type'], 'atak_cot_type': meta['cot_type'],
            'event_type': meta['cot_type'], 'type': meta['cot_type'],
            'iconsetpath': meta['usericon'], 'iconset_path': meta['usericon'],
            'atak_transport_sidc_i580': meta['sidc'],
            'atak_transport_cot_type_i580': meta['cot_type'],
            'atak_transport_usericon_i580': meta['usericon'],
            'takmap_transport_sidc_i580': meta['sidc'],
            'takmap_transport_cot_type_i580': meta['cot_type'],
            'takmap_transport_usericon_i580': meta['usericon'],
            'takmap_symbology_concept_i580': meta['concept'],
            'affiliation': meta['affiliation'],
            'data_sync_visible_symbol_authority_i584_hf1': 'reviewed-atak-transport',
            'atak_visual_parity_i584_hf1': True,
            'generic_mission_row_cannot_downgrade_i584_hf1': True,
        })
        display = meta.get('display') or {}
        if display:
            row['takmap_display_name_i580'] = display.get('name') or ''
            row['takmap_display_sidc_i580'] = display.get('sidc') or ''
            row['takmap_display_cot_type_i580'] = display.get('cot_type') or ''
        alias = meta.get('alias') or {}
        if alias:
            row['mil2525_name'] = alias.get('name') or row.get('mil2525_name') or ''
            row['mil2525_file'] = alias.get('file') or row.get('mil2525_file') or ''
            row['mil2525_label'] = alias.get('label') or row.get('mil2525_label') or ''
        return row

    _i584p_save_before = _i555_save_point
    def _i555_save_point(payload):
        payload = payload if isinstance(payload, dict) else {}
        reply, status = _i584p_save_before(payload)
        if int(status or 0) != 502 or not isinstance(reply, dict):
            return reply, status
        publish = reply.get('publish') if isinstance(reply.get('publish'), dict) else {}
        delayed = _i584p_delayed_publication(publish)
        if not delayed:
            return reply, status

        row = _i584p_delayed_row(payload, publish, delayed)
        point = _i583hf5_public_point(row) if '_i583hf5_public_point' in globals() else dict(row)
        point.update({
            'sidc': row.get('sidc'), 'SIDC': row.get('SIDC'),
            'cot_type': row.get('cot_type'), 'atak_cot_type': row.get('atak_cot_type'),
            'event_type': row.get('event_type'), 'type': row.get('type'),
            'iconsetpath': row.get('iconsetpath'), 'iconset_path': row.get('iconset_path'),
            'atak_transport_sidc_i580': row.get('atak_transport_sidc_i580'),
            'atak_transport_cot_type_i580': row.get('atak_transport_cot_type_i580'),
            'atak_transport_usericon_i580': row.get('atak_transport_usericon_i580'),
            'takmap_symbology_concept_i580': row.get('takmap_symbology_concept_i580'),
            'affiliation': row.get('affiliation'),
            'data_sync_visible_symbol_authority_i584_hf1': 'reviewed-atak-transport',
            'atak_visual_parity_i584_hf1': True,
        })
        publish_success = _i583hf5_clone(publish) if '_i583hf5_clone' in globals() else json.loads(json.dumps(publish))
        publish_success.update({
            'ok': True, 'publish_succeeded': True, 'readback_confirmed': False,
            'mission_readback_deferred': True, 'awaiting_mission_index': True,
            'publication_complete_without_mission_cot_readback_i584_hf1': True,
            'error': '',
            'message': 'Point published and associated with the Data Sync Mission; Mission indexing is continuing in the background.',
        })
        success = {
            'ok': True, 'version': _I584_PARITY_HF1_VERSION,
            'message': 'Point published to OpenTAKServer and associated with the Data Sync Mission.',
            'status_label': 'Published · awaiting Mission index',
            'point': point, 'publish': publish_success, 'redraw_allowed': True,
            'server_marker_published': True, 'marker_api_publication_confirmed': True,
            'mission_uid_associated': True, 'mission_readback_deferred': True,
            'awaiting_mission_index': True, 'publication_complete': True,
            'delete_supported': True, 'mission_delete_target': 'uid',
            'mission_delete_value': row.get('uid'), 'local_data_retained': False,
            'local_data_reconcile_required': False, 'placement_preview_must_close': True,
            'single_visible_marker_handoff_i584_hf1': True, 'point_not_eud_i584_hf1': True,
            'exact_location_preserved_i584_hf1': True,
            'atak_transport_visual_authoritative_i584_hf1': True,
            'existing_membership_association_counts_as_success_i584_hf1': bool((delayed.get('association') or {}).get('skipped')),
        }
        try:
            optimistic = _i583_store_optimistic(payload, success) if '_i583_store_optimistic' in globals() else None
            if optimistic:
                if '_i583hf5_correct_optimistic_record' in globals():
                    _i583hf5_correct_optimistic_record(optimistic, row)
                success['optimistic_data_sync_handoff_i584_hf1'] = {
                    'active': True, 'uid': optimistic.get('uid') or row.get('uid'),
                    'mission': optimistic.get('mission') or row.get('mission_name'),
                    'transport_symbol_authoritative': True, 'delete_available_immediately': True,
                    'mission_readback_deferred': True,
                }
                cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
                sess = _i570_context_session() if '_i570_context_session' in globals() else {}
                token = _i584p_text((sess or {}).get('_i570_token'))
                _i568_schedule_refresh(optimistic.get('key'), cfg or {}, sess or {}, token,
                    'i584-atak-parity-hf1-post-save-membership-fastpath', force=False)
        except Exception as exc:
            success['optimistic_handoff_warning_i584_hf1'] = _i584p_text(exc)[:1000]
        return success, 200
    globals()['_i555_save_point'] = _i555_save_point

    def _i584p_transport_authority(row):
        if not isinstance(row, dict):
            return None
        concept = _i584p_text(row.get('takmap_symbology_concept_i580'))
        aff = _i584p_aff_code(row)
        pair = {}
        if concept and '_i580_pair' in globals():
            try:
                pair = _i580_pair(concept, aff) or {}
            except Exception:
                pair = {}
        transport = dict(pair.get('transport') or {})
        sidc = _i584p_text(row.get('atak_transport_sidc_i580') or row.get('takmap_transport_sidc_i580') or transport.get('sidc'))
        cot = _i584p_text(row.get('atak_transport_cot_type_i580') or row.get('takmap_transport_cot_type_i580') or transport.get('cot_type'))
        icon = _i584p_text(row.get('atak_transport_usericon_i580') or row.get('takmap_transport_usericon_i580') or transport.get('usericon_path'))
        if not sidc and _i584p_specific_sidc(row.get('sidc')):
            sidc = _i584p_text(row.get('sidc'))
        if not cot and _i584p_specific_cot(row.get('cot_type') or row.get('type')):
            cot = _i584p_text(row.get('cot_type') or row.get('type'))
        if not icon:
            icon = _i584p_text(row.get('iconsetpath') or row.get('iconset_path'))
        if not (sidc or cot or icon):
            return None
        source_aff = _i584p_aff_code(row)
        sidc_aff = sidc[1].upper() if len(sidc) > 1 and sidc[1].upper() in 'FHNU' else source_aff
        cot_match = re.match(r'^a-([fhnu])(?:-|$)', cot.lower())
        cot_aff = cot_match.group(1).upper() if cot_match else source_aff
        if sidc_aff != source_aff or cot_aff != source_aff:
            return None
        score = 10
        if row.get('atak_visual_parity_i584_hf1') or row.get('marker_api_publication_confirmed_i583_hf5'):
            score += 20
        if row.get('data_sync_optimistic_i583'):
            score += 10
        if concept:
            score += 5
        return {'sidc': sidc, 'cot_type': cot, 'usericon': icon, 'concept': concept, 'affiliation': source_aff, 'score': score}

    def _i584p_apply_authority(row, authority):
        if not isinstance(row, dict) or not isinstance(authority, dict):
            return row
        row_aff = _i584p_aff_code(row)
        if authority.get('affiliation') and row_aff != authority.get('affiliation'):
            return row
        sidc = _i584p_text(authority.get('sidc'))
        cot = _i584p_text(authority.get('cot_type'))
        icon = _i584p_text(authority.get('usericon'))
        if sidc:
            row['sidc'] = sidc; row['SIDC'] = sidc
            row['atak_transport_sidc_i580'] = sidc; row['takmap_transport_sidc_i580'] = sidc
        if cot:
            for key in ('cot_type','atak_cot_type','event_type','type'):
                row[key] = cot
            row['atak_transport_cot_type_i580'] = cot; row['takmap_transport_cot_type_i580'] = cot
        if icon:
            row['iconsetpath'] = icon; row['iconset_path'] = icon
            row['atak_transport_usericon_i580'] = icon; row['takmap_transport_usericon_i580'] = icon
        if authority.get('concept'):
            row['takmap_symbology_concept_i580'] = authority.get('concept')
        alias = dict((_I552_ALIAS_BY_SIDC or {}).get(sidc.upper()) or {}) if sidc and '_I552_ALIAS_BY_SIDC' in globals() else {}
        if alias:
            row['mil2525_name'] = alias.get('name') or row.get('mil2525_name') or ''
            row['mil2525_file'] = alias.get('file') or row.get('mil2525_file') or ''
            row['mil2525_label'] = alias.get('label') or row.get('mil2525_label') or ''
        row['data_sync_visible_symbol_authority_i584_hf1'] = 'reviewed-atak-transport'
        row['atak_visual_parity_i584_hf1'] = True
        row['generic_mission_row_cannot_downgrade_i584_hf1'] = True
        return row

    def _i584p_payload_rows(payload):
        rows = []
        if not isinstance(payload, dict):
            return rows
        for key in ('objects','mission_uids'):
            if isinstance(payload.get(key), list):
                rows.extend([r for r in payload.get(key) if isinstance(r, dict)])
        for mission in payload.get('missions') or []:
            if isinstance(mission, dict) and isinstance(mission.get('uids'), list):
                rows.extend([r for r in mission.get('uids') if isinstance(r, dict)])
        return rows

    _i584p_response_before = _i568_response_payload
    def _i568_response_payload(state):
        payload = _i584p_response_before(state)
        if not isinstance(payload, dict):
            return payload
        payload = _i568_clone(payload) if '_i568_clone' in globals() else json.loads(json.dumps(payload))
        rows = _i584p_payload_rows(payload)
        authorities = {}
        for row in rows:
            uid = _i584p_uid(row).casefold()
            authority = _i584p_transport_authority(row)
            if uid and authority and authority.get('score', 0) > (authorities.get(uid) or {}).get('score', -1):
                authorities[uid] = authority
        promoted = 0
        for row in rows:
            uid = _i584p_uid(row).casefold()
            authority = authorities.get(uid) or _i584p_transport_authority(row)
            if authority:
                _i584p_apply_authority(row, authority)
                promoted += 1
        payload['atak_icon_parity_i584_hf1'] = {
            'version': _I584_PARITY_HF1_VERSION,
            'transport_visual_authority': True,
            'exact_uid_authority_count': len(authorities),
            'rows_promoted': promoted,
            'generic_mission_rows_cannot_downgrade': True,
            'affiliation_preserved': True,
            'friendly_civilian_magenta_test_concepts': 8,
        }
        return payload
    globals()['_i568_response_payload'] = _i568_response_payload

    _i584p_config_before = tak_map_config
    def tak_map_config():
        cfg = dict(_i584p_config_before() or {})
        cfg['atak_icon_parity_i584_hf1'] = {
            'version': _I584_PARITY_HF1_VERSION,
            'same_reviewed_transport_symbol_as_atak': True,
            'affiliation_preserved': True,
            'friendly_civilian_magenta_test_concepts': 8,
            'friendly_military_symbols_remain_blue': True,
            'manifest': '/assets/mil2525/atak-symbology-transport-i580.json',
        }
        startup = dict(cfg.get('startup_architecture_i584') or {})
        startup['icon_registry_cache_identity'] = _I584_PARITY_HF1_VERSION
        cfg['startup_architecture_i584_atak_icon_parity_hf1'] = startup
        return cfg
    globals()['tak_map_config'] = tak_map_config

    def _i584p_patch_html(html):
        html = str(html or '')
        html = re.sub(
            r'(/assets/runtime/tak-map-icon-registry-i572\.js)\?v=[^"\']+',
            r'\1?v=' + _I584_PARITY_HF1_VERSION, html)
        return html
    TAK_MAP_HTML = _i584p_patch_html(TAK_MAP_HTML)
    INDEX_HTML = TAK_MAP_HTML
    TAK_MAP_LOGIN_HTML = _i584p_patch_html(TAK_MAP_LOGIN_HTML)
    LOGIN_HTML = TAK_MAP_LOGIN_HTML
except Exception as _i584p_exc:
    try:
        print('TAK Map i584 ATAK icon parity hotfix hf1 failed:', _i584p_exc)
    except Exception:
        pass
# --- end TAK Map i584 ATAK icon parity hotfix hf1 ---

# --- TAK Map i584 ATAK icon parity hotfix hf2: persistent exact-UID transport authority ---
try:
    _I584_PARITY_HF2_VERSION = 'i584-atak-icon-parity-hf2'
    _I584_PARITY_HF2_ROOT = DATA_DIR / 'data_sync_transport_authority_i584_hf2'
    _I584_PARITY_HF2_LOCK = threading.RLock()
    _I584_PARITY_HF2_MAX_RECORDS = 5000

    def _i584p2_text(value):
        try:
            return str(value if value is not None else '').strip()
        except Exception:
            return ''

    def _i584p2_uid(row):
        if not isinstance(row, dict):
            return ''
        return _i584p2_text(row.get('event_uid') or row.get('cot_uid') or row.get('uid') or row.get('source_uid') or row.get('id')).casefold()

    def _i584p2_specific_cot(value):
        raw = _i584p2_text(value).lower()
        return bool(re.match(r'^a-[fhnu]-[a-z0-9](?:-|$)', raw)) and raw not in ('a-f-g', 'a-h-g', 'a-n-g', 'a-u-g')

    def _i584p2_specific_sidc(value):
        sidc = _i584p2_text(value).upper()
        if len(sidc) < 10 or sidc[0] not in ('S', 'E', 'G'):
            return False
        core = sidc[4:10].replace('-', '') if sidc[0] == 'S' else sidc[3:10].replace('-', '')
        return len(core) >= 2

    def _i584p2_explicit_affiliation(row):
        if not isinstance(row, dict):
            return ''
        sidc = _i584p2_text(row.get('atak_transport_sidc_i580') or row.get('takmap_transport_sidc_i580') or row.get('sidc') or row.get('SIDC')).upper()
        if len(sidc) > 1 and sidc[1] in 'FHNU':
            return sidc[1]
        cot = _i584p2_text(row.get('atak_transport_cot_type_i580') or row.get('takmap_transport_cot_type_i580') or row.get('cot_type') or row.get('event_type') or row.get('type')).lower()
        match = re.match(r'^a-([fhnu])(?:-|$)', cot)
        if match:
            return match.group(1).upper()
        raw = _i584p2_text(row.get('affiliation')).lower()
        return {'friendly':'F','friend':'F','f':'F','hostile':'H','h':'H','neutral':'N','n':'N','unknown':'U','u':'U'}.get(raw, '')

    def _i584p2_current_state_key():
        try:
            if '_i570_context_state_key' in globals():
                return _i584p2_text(_i570_context_state_key())
            cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
            sess = _i570_context_session() if '_i570_context_session' in globals() else {}
            return _i584p2_text(_i568_state_key(cfg or {}, sess or {}))
        except Exception:
            return ''

    def _i584p2_store_path(state_key):
        safe = re.sub(r'[^a-zA-Z0-9_.-]+', '_', _i584p2_text(state_key))[:96]
        return _I584_PARITY_HF2_ROOT / ((safe or 'unscoped') + '.json')

    def _i584p2_load_store(state_key):
        path = _i584p2_store_path(state_key)
        try:
            raw = load_json_file(path, {})
        except Exception:
            raw = {}
        authorities = dict(raw.get('authorities') or {}) if isinstance(raw, dict) else {}
        clean = {}
        for uid, record in authorities.items():
            uid_key = _i584p2_text(uid).casefold()
            if uid_key and isinstance(record, dict):
                clean[uid_key] = dict(record)
        return clean

    def _i584p2_write_store(state_key, authorities):
        authorities = dict(authorities or {})
        if len(authorities) > _I584_PARITY_HF2_MAX_RECORDS:
            ordered = sorted(authorities.items(), key=lambda item: float((item[1] or {}).get('updated_epoch') or 0), reverse=True)
            authorities = dict(ordered[:_I584_PARITY_HF2_MAX_RECORDS])
        _I584_PARITY_HF2_ROOT.mkdir(parents=True, exist_ok=True)
        atomic_write_json(_i584p2_store_path(state_key), {
            'version': _I584_PARITY_HF2_VERSION,
            'updated_epoch': time.time(),
            'authorities': authorities,
        })

    def _i584p2_authority_from_row(row, source='row'):
        if not isinstance(row, dict):
            return None
        base = _i584p_transport_authority(row) if '_i584p_transport_authority' in globals() else None
        base = dict(base or {})
        sidc = _i584p2_text(base.get('sidc') or row.get('atak_transport_sidc_i580') or row.get('takmap_transport_sidc_i580') or row.get('sidc') or row.get('SIDC')).upper()
        cot = _i584p2_text(base.get('cot_type') or row.get('atak_transport_cot_type_i580') or row.get('takmap_transport_cot_type_i580') or row.get('cot_type') or row.get('event_type') or row.get('type'))
        icon = _i584p2_text(base.get('usericon') or row.get('atak_transport_usericon_i580') or row.get('takmap_transport_usericon_i580') or row.get('iconsetPath') or row.get('iconsetpath') or row.get('iconset_path') or row.get('usericon_path'))
        aff = _i584p2_explicit_affiliation({'sidc': sidc, 'cot_type': cot, 'affiliation': base.get('affiliation') or row.get('affiliation')})
        if not aff or not (_i584p2_specific_sidc(sidc) or _i584p2_specific_cot(cot) or icon):
            return None
        if len(sidc) > 1 and sidc[1] in 'FHNU' and sidc[1] != aff:
            return None
        cot_match = re.match(r'^a-([fhnu])(?:-|$)', cot.lower())
        if cot_match and cot_match.group(1).upper() != aff:
            return None
        return {
            'sidc': sidc,
            'cot_type': cot,
            'usericon': icon,
            'concept': _i584p2_text(base.get('concept') or row.get('takmap_symbology_concept_i580')),
            'affiliation': aff,
            'mission': _i584p2_text(row.get('mission_name') or row.get('mission')),
            'name': _i584p2_text(row.get('point_name') or row.get('name') or row.get('callsign')),
            'lat': row.get('lat') if row.get('lat') is not None else row.get('latitude'),
            'lon': row.get('lon') if row.get('lon') is not None else row.get('longitude'),
            'hae': row.get('hae'), 'ce': row.get('ce'), 'le': row.get('le'),
            'source': _i584p2_text(source),
            'updated_epoch': time.time(),
        }

    def _i584p2_strong_exact_row(row):
        if not isinstance(row, dict) or not _i584p2_uid(row):
            return False
        cot = _i584p2_text(row.get('atak_transport_cot_type_i580') or row.get('takmap_transport_cot_type_i580') or row.get('cot_type') or row.get('event_type') or row.get('type'))
        sidc = _i584p2_text(row.get('atak_transport_sidc_i580') or row.get('takmap_transport_sidc_i580') or row.get('sidc') or row.get('SIDC'))
        icon = _i584p2_text(row.get('atak_transport_usericon_i580') or row.get('takmap_transport_usericon_i580') or row.get('iconsetPath') or row.get('iconsetpath') or row.get('iconset_path') or row.get('usericon_path'))
        return bool(_i584p2_specific_cot(cot) and (_i584p2_specific_sidc(sidc) or icon))

    def _i584p2_save_authority(state_key, uid, authority):
        uid = _i584p2_text(uid).casefold()
        if not state_key or not uid or not isinstance(authority, dict):
            return False
        with _I584_PARITY_HF2_LOCK:
            authorities = _i584p2_load_store(state_key)
            authority = dict(authority)
            authority['uid'] = uid
            authority['updated_epoch'] = time.time()
            authorities[uid] = authority
            _i584p2_write_store(state_key, authorities)
        return True

    def _i584p2_remove_authority(state_key, uid):
        uid = _i584p2_text(uid).casefold()
        if not state_key or not uid:
            return False
        with _I584_PARITY_HF2_LOCK:
            authorities = _i584p2_load_store(state_key)
            if uid not in authorities:
                return False
            authorities.pop(uid, None)
            _i584p2_write_store(state_key, authorities)
        return True

    def _i584p2_apply_authority(row, authority):
        if not isinstance(row, dict) or not isinstance(authority, dict):
            return row
        explicit_aff = _i584p2_explicit_affiliation(row)
        stored_aff = _i584p2_text(authority.get('affiliation')).upper()
        # A real, specific exact-UID record may replace the saved authority. A
        # partial/generic row has no affiliation authority and is promoted.
        if explicit_aff and stored_aff and explicit_aff != stored_aff and _i584p2_strong_exact_row(row):
            return row
        sidc = _i584p2_text(authority.get('sidc')).upper()
        cot = _i584p2_text(authority.get('cot_type'))
        icon = _i584p2_text(authority.get('usericon'))
        if sidc:
            row['sidc'] = sidc; row['SIDC'] = sidc
            row['atak_transport_sidc_i580'] = sidc; row['takmap_transport_sidc_i580'] = sidc
        if cot:
            for key in ('cot_type', 'atak_cot_type', 'event_type', 'type'):
                row[key] = cot
            row['atak_transport_cot_type_i580'] = cot; row['takmap_transport_cot_type_i580'] = cot
        if icon:
            for key in ('iconsetPath', 'iconsetpath', 'iconset_path', 'usericon_path'):
                row[key] = icon
            row['atak_transport_usericon_i580'] = icon; row['takmap_transport_usericon_i580'] = icon
        if authority.get('concept'):
            row['takmap_symbology_concept_i580'] = authority.get('concept')
        if stored_aff:
            row['affiliation'] = {'F':'friendly','H':'hostile','N':'neutral','U':'unknown'}.get(stored_aff, row.get('affiliation'))
        alias = dict((_I552_ALIAS_BY_SIDC or {}).get(sidc.upper()) or {}) if sidc and '_I552_ALIAS_BY_SIDC' in globals() else {}
        if alias:
