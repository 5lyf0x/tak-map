# VEIL i668 administrator authorization: a secure TAK Map admin session is
# sufficient; an existing secure Dashboard admin session is also accepted.
# Both paths require a valid TAK Map login and a verified HTTPS proxy request.
def _veil_admin_authorized_i668(handler):
    if not handler._is_secure_request() or not handler._tak_map_auth_ok():
        return False
    session = handler._tak_map_session() or {}
    return bool(handler._auth_ok() or (isinstance(session, dict) and session.get('is_admin') is True))

# --- TAK Map i665: VEIL Phase 1 receiver, NWS compact context, authoritative release ---
from tak_map_veil_i665 import VeilReceiver as _VeilReceiverI665
VEIL_I665 = _VeilReceiverI665(DATA_DIR/'tak_map_veil')
_i665_get_prev=Handler.do_GET
_i665_post_prev=Handler.do_POST

def _i665_get(self):
    route=urlparse(self.path).path
    if route in ('/assets/runtime/tak-map-veil-i665.js','/assets/runtime/xtak-veil-discover-i665.svg'):
        name=route.rsplit('/',1)[-1]
        fp=Path(__file__).resolve().parent/'assets'/name
        if not fp.is_file():return self._send_json({'ok':False,'error':'Asset not available'},404)
        blob=fp.read_bytes()
        self.send_response(200);self.send_header('Content-Type','image/svg+xml' if name.endswith('.svg') else 'application/javascript; charset=utf-8')
        self.send_header('Content-Length',str(len(blob)));self.send_header('Cache-Control','public, max-age=86400');self.end_headers()
        if self.command!='HEAD':self.wfile.write(blob)
        return
    if route.startswith('/api/tak-map/veil/'):
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        sub=route.rsplit('/',1)[-1]
        if sub=='status':return self._send_json(VEIL_I665.status())
        if sub=='objects':return self._send_json(VEIL_I665.snapshot())
        return self._send_json({'ok':False,'error':'Unknown VEIL API'},404)
    return _i665_get_prev(self)
Handler.do_GET=_i665_get

def _i665_post(self):
    route=urlparse(self.path).path
    if not route.startswith('/api/tak-map/veil/'):return _i665_post_prev(self)
    if not _veil_admin_authorized_i668(self):
        return self._send_json({'ok':False,'admin_required':True,'error':'VEIL management requires an administrator login in TAK Map or the Dashboard over HTTPS.'},403)
    try:
        n=int(self.headers.get('Content-Length','0') or '0')
        if n<0 or n>32768:raise ValueError('Request exceeds maximum allowed size')
        data=_read_json_body(self);sub=route.rsplit('/',1)[-1]
        if sub=='settings':answer=VEIL_I665.settings(data)
        elif sub=='discover':answer=__import__('tak_map_veil_i665').discover()
        elif sub=='add':answer=VEIL_I665.add(data.get('nodes'))
        elif sub=='remove':answer=VEIL_I665.remove(data.get('nodeId'))
        else:return self._send_json({'ok':False,'error':'Unknown VEIL action'},404)
        return self._send_json(answer,200 if answer.get('ok') else 503)
    except (ValueError,TypeError,OverflowError) as exc:
        return self._send_json({'ok':False,'error':str(exc)},400)
Handler.do_POST=_i665_post
_i665_previous_config=tak_map_config
