    globals()['_i511_create_profile_session'] = _i511_create_profile_session

    def _i583hf4_current_session():
        local_session_token = ''
        try:
            local_session_token = _i583hf4_text(getattr(_I529_REQUEST_CONTEXT, 'session_token', ''))
        except Exception:
            local_session_token = ''
        if not local_session_token:
            return '', {}, 'TAK Map request session is unavailable.'
        try:
            with TAK_MAP_SESSIONS_LOCK:
                session = dict(TAK_MAP_SESSIONS.get(local_session_token) or {})
        except Exception:
            session = {}
        if not session:
            return local_session_token, {}, 'TAK Map session record is unavailable.'
        return local_session_token, session, ''

    def _i583hf4_clear_marker_token(local_session_token):
        if not local_session_token:
            return
        try:
            with TAK_MAP_SESSIONS_LOCK:
                session = TAK_MAP_SESSIONS.get(local_session_token)
                if session is not None:
                    session[_I583_HF4_SESSION_TOKEN_FIELD] = ''
                    session['marker_api_auth_ready_i583_hf4'] = False
                    session['marker_api_auth_status_i583_hf4'] = 401
                    session['marker_api_auth_error_i583_hf4'] = 'OpenTAKServer marker API authentication expired. Log out and sign in again.'
        except Exception:
            pass

    def _i583hf4_read_http_response(response, started):
        raw = response.read(4 * 1024 * 1024).decode('utf-8', errors='replace')
        status = int(getattr(response, 'status', 200) or 200)
        try:
            parsed = json.loads(raw) if raw else {}
        except Exception:
            parsed = {'raw': raw[:4000]}
        return {
            'ok': 200 <= status < 300,
            'status': status,
            'json': parsed,
            'duration_seconds': round(time.monotonic() - started, 3),
            'i583_hf4_auth': {
                'version': _I583_HF4_VERSION,
                'method': 'auth_token-query',
                'marker_api_auth_ready': True,
                'authorization_bearer_used': False,
                'authentication_token_header_used': False,
                'token_exposed': False,
            },
        }

    def _i583hf4_send_marker_request(cfg, base, endpoint_path, method, body, timeout, marker_token, auth_mode):
        url = base + endpoint_path
        headers = {
            'Accept': 'application/json',
            'Referer': base + '/',
            'User-Agent': 'TAKDashboard/i583-hf4 MarkerAPI',
        }
        if auth_mode == 'authentication-token-header':
            headers['Authentication-Token'] = marker_token
        elif auth_mode == 'auth_token-query':
            separator = '&' if '?' in url else '?'
            url = url + separator + urlencode({'auth_token': marker_token})
        else:
            raise ValueError('Unsupported marker API authentication mode.')
        if body is not None:
            headers['Content-Type'] = 'application/json; charset=UTF-8'
            headers['Content-Length'] = str(len(body))
        request_obj = Request(url, data=body, headers=headers, method=method)
        started = time.monotonic()
        try:
            with urlopen(request_obj, timeout=timeout, context=_i583hf4_ssl_context(cfg)) as response:
                result = _i583hf4_read_http_response(response, started)
                result['i583_hf4_auth']['method'] = auth_mode
                result['i583_hf4_auth']['authentication_token_header_used'] = auth_mode == 'authentication-token-header'
                result['i583_hf4_auth']['query_fallback_used'] = auth_mode == 'auth_token-query'
                return result
        except HTTPError as exc:
            try:
                raw = exc.read(4096).decode('utf-8', errors='replace')
            except Exception:
                raw = ''
            return {
                'ok': False,
                'status': int(getattr(exc, 'code', 0) or 0),
                'error': raw[:4000] or str(exc),
                'duration_seconds': round(time.monotonic() - started, 3),
                'i583_hf4_auth': {
                    'version': _I583_HF4_VERSION,
                    'method': auth_mode,
                    'marker_api_auth_ready': True,
                    'authorization_bearer_used': False,
                    'authentication_token_header_used': auth_mode == 'authentication-token-header',
                    'query_fallback_used': auth_mode == 'auth_token-query',
                    'token_exposed': False,
                },
            }
        except Exception as exc:
            return {
                'ok': False,
                'status': 0,
                'error': str(exc),
                'duration_seconds': round(time.monotonic() - started, 3),
                'i583_hf4_auth': {
                    'version': _I583_HF4_VERSION,
                    'method': auth_mode,
                    'marker_api_auth_ready': True,
                    'authorization_bearer_used': False,
                    'authentication_token_header_used': auth_mode == 'authentication-token-header',
                    'query_fallback_used': auth_mode == 'auth_token-query',
                    'token_exposed': False,
                },
            }

    def _i583hf_api_request(path, method='GET', payload=None, timeout=20):
        cfg = _i509_load_ots_config() if '_i509_load_ots_config' in globals() else {}
        base = _i583hf4_text((cfg or {}).get('base_url') or (cfg or {}).get('api_url')).rstrip('/')
        if not base:
            return {
                'ok': False,
                'status': 0,
                'error': 'OpenTAKServer Web/API URL is not configured.',
                'i583_hf4_auth': {'version': _I583_HF4_VERSION, 'marker_api_auth_ready': False},
            }
        local_session_token, session, session_error = _i583hf4_current_session()
        if session_error:
            return {
                'ok': False,
                'status': 401,
                'error': session_error,
                'reauthentication_required': True,
                'i583_hf4_auth': {'version': _I583_HF4_VERSION, 'marker_api_auth_ready': False},
            }
        marker_token = _i583hf4_text(session.get(_I583_HF4_SESSION_TOKEN_FIELD))
        if not marker_token:
            return {
                'ok': False,
                'status': 401,
                'error': 'OpenTAKServer marker API authentication is not initialized. Log out of TAK Map and sign in again once after installing hf4.',
                'reauthentication_required': True,
                'i583_hf4_auth': {
                    'version': _I583_HF4_VERSION,
                    'method': 'login-time-dedicated-token',
                    'marker_api_auth_ready': False,
                    'authorization_bearer_used': False,
                    'token_exposed': False,
                },
            }

        endpoint_path = '/' + _i583hf4_text(path).lstrip('/')
        body = None if payload is None else json.dumps(payload, separators=(',', ':')).encode('utf-8')

        # The user's direct OTS test proved Authentication-Token reaches marker
        # validation (HTTP 400 for the deliberately invalid UID) and auth_token
        # query creation succeeds with a UUID4. Prefer the header so the token is
        # not present in ordinary access URLs, then use the proven query form only
        # as a compatibility retry after HTTP 401.
        primary = _i583hf4_send_marker_request(
            cfg, base, endpoint_path, method, body, timeout, marker_token,
            'authentication-token-header')
        if primary.get('ok') or int(primary.get('status') or 0) != 401:
            primary['i583_hf4_attempts'] = [
                {'method': 'authentication-token-header', 'status': int(primary.get('status') or 0)}]
            return primary

        fallback = _i583hf4_send_marker_request(
            cfg, base, endpoint_path, method, body, timeout, marker_token,
            'auth_token-query')
        fallback['i583_hf4_attempts'] = [
            {'method': 'authentication-token-header', 'status': int(primary.get('status') or 0)},
            {'method': 'auth_token-query', 'status': int(fallback.get('status') or 0)},
        ]
        if int(fallback.get('status') or 0) == 401:
            _i583hf4_clear_marker_token(local_session_token)
            fallback['error'] = 'OpenTAKServer marker API authentication expired. The point remains local; log out of TAK Map and sign in again.'
            fallback['reauthentication_required'] = True
            fallback['i583_hf4_auth']['marker_api_auth_ready'] = False
        return fallback
    globals()['_i583hf_api_request'] = _i583hf_api_request

    _i583hf4_session_public_before = _i509_session_public
    def _i509_session_public(sess):
        out = dict(_i583hf4_session_public_before(sess) or {})
