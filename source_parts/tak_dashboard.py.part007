# --- TAK Map i687: approved Infrastructure overhaul (multimode, bounded geometry, colors) ---
# All user-owned Local Data, Token Mesh, terrain, and basemap stores unchanged.
from tak_map_infrastructure_i687 import (
    catalog as _infra_catalog_i687, mutate as _infra_mutate_i687,
    job_action as _infra_jobs_i687, import_dataset as _infra_import_i687,
    export_dataset as _infra_export_i687, get_features as _infra_features_i687,
    get_count as _infra_count_i687,
    MAX_UPLOAD_BYTES as _INFRA_MAX_UPLOAD_I687,
)

_I687_GET_PREVIOUS = Handler.do_GET
_I687_POST_PREVIOUS = Handler.do_POST

def _infra_api_error_i687(handler, exc):
    code=400 if isinstance(exc, (ValueError, KeyError, TypeError)) else 502
    print('[TAK Map infrastructure i687]',type(exc).__name__,str(exc)[:200],flush=True)
    return handler._send_json({'ok':False,'error':str(exc)[:400]},code)


def _infra_get_i687(self):
    route=urlparse(self.path).path
    static={
        '/assets/runtime/tak-map-infrastructure-i687.js':('assets/tak-map-infrastructure-i687.js','application/javascript; charset=utf-8'),
        '/assets/runtime/tak-map-infrastructure-i687.css':('assets/tak-map-infrastructure-i687.css','text/css; charset=utf-8'),
    }
    if route in static:
        if not self._tak_map_auth_ok():return self._require_tak_map_login()
        path,ctype=static[route]
        body=(Path(__file__).resolve().parent/path).read_bytes()
        self.send_response(200);self.send_header('Content-Type',ctype)
        self.send_header('Cache-Control','private, no-store')
        self.send_header('Content-Length',str(len(body)));self.end_headers()
        if self.command!='HEAD':self.wfile.write(body)
        return
    if not route.startswith('/api/tak-map/infrastructure/'):
        return _I687_GET_PREVIOUS(self)
    if not self._tak_map_auth_ok():return self._require_tak_map_login()
    q=parse_qs(urlparse(self.path).query)
    val=lambda key,default='':(q.get(key) or [default])[0]
    try:
        if route.endswith('/state'):return self._send_json(_infra_catalog_i687())
        if route.endswith('/features'):
            return self._send_json(_infra_features_i687(val('layer'),val('mode'),val('bbox'),float(val('minimum','36')),int(val('offset','0')),int(val('chunk','0')),float(val('zoom')) if val('zoom') else None))
        if route.endswith('/count'):
            return self._send_json(_infra_count_i687(val('layer'),val('mode'),val('bbox'),float(val('zoom')) if val('zoom') else None))
        if route.endswith('/export'):
            file=_infra_export_i687(val('layer'),val('format','gpkg'))
            try:
                self.send_response(200)
                self.send_header('Content-Type','application/octet-stream')
                self.send_header('Content-Disposition','attachment; filename="'+file.name+'"')
                self.send_header('Cache-Control','no-store')
                self.send_header('Content-Length',str(file.stat().st_size))
                self.end_headers()
                if self.command!='HEAD':
                    with file.open('rb') as src:shutil.copyfileobj(src,self.wfile,1024*1024)
            finally:file.unlink(missing_ok=True)
            return
        return self._send_json({'ok':False,'error':'Unknown Infrastructure endpoint'},404)
    except Exception as error:return _infra_api_error_i687(self,error)

def _infra_post_i687(self):
    route=urlparse(self.path).path
    if not route.startswith('/api/tak-map/infrastructure/'):
        return _I687_POST_PREVIOUS(self)
    if not self._tak_map_auth_ok():return self._require_tak_map_login()
    try:
        size=int(self.headers.get('Content-Length') or '-1')
        if size<0 or size>_INFRA_MAX_UPLOAD_I687:
            return self._send_json({'ok':False,'error':'Invalid upload size'},413)
        if route.endswith('/import'):
            from tak_map_infrastructure_i687 import _root as infra_root
            query=parse_qs(urlparse(self.path).query)
            v=lambda key,default='':(query.get(key) or [default])[0]
            filename=Path(v('filename','import.geojson').replace('\\','/')).name
            suffix=Path(filename).suffix.lower()
            if suffix not in ('.geojson','.json','.gpkg','.zip','.shp','.kml','.kmz'):
                raise ValueError('Unsupported file extension')
            infra_root().mkdir(parents=True,exist_ok=True)
            with tempfile.NamedTemporaryFile(prefix='infra-upload-',suffix=suffix,dir=str(infra_root()),delete=False) as tmp:
                remaining=size
                while remaining:
                    part=self.rfile.read(min(1024*1024,remaining))
                    if not part:raise ValueError('Incomplete infrastructure upload')
                    tmp.write(part);remaining-=len(part)
                path=Path(tmp.name)
            try:
                result=_infra_import_i687(path,v('category'),v('name',Path(filename).stem),v('kind','other'))
            finally:path.unlink(missing_ok=True)
            return self._send_json(result)
        if size>2*1024*1024:raise ValueError('Infrastructure control request too large')
        data=json.loads(self.rfile.read(size) or b'{}')
        if route.endswith('/manage'):return self._send_json(_infra_mutate_i687(data))
        if route.endswith('/jobs'):return self._send_json(_infra_jobs_i687(data))
        return self._send_json({'ok':False,'error':'Unknown Infrastructure operation'},404)
    except Exception as error:return _infra_api_error_i687(self,error)

Handler.do_GET = _infra_get_i687
Handler.do_POST = _infra_post_i687

