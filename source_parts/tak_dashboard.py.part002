    #adsbV278Menu{display:flex;flex-direction:column;gap:8px;margin:0;padding:0;contain:layout style;}#adsbV278Menu label{display:flex;flex-direction:column;gap:4px;margin:0;color:#aebfc6;font-size:.68rem;font-weight:850;text-transform:none;letter-spacing:.02em}.adsb-v278-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:end}.adsb-v278-full{display:block;width:100%}.adsb-v278-actions{display:flex;justify-content:space-between;gap:8px}.adsb-v278-toggle{width:100%;justify-content:center;margin:1px 0 0}#adsbV278Menu select,#adsbV278Menu input{width:100%;min-width:0;box-sizing:border-box;background:#0c171f;border:1px solid rgba(255,255,255,.12);border-radius:9px;color:#edf6f8;padding:7px 9px;font-size:.76rem;outline:none}.adsb-v278-filters{border:1px solid rgba(255,255,255,.09);border-radius:12px;background:rgba(255,255,255,.035);padding:7px 8px;display:grid;gap:4px}.adsb-v278-filter-row{display:flex!important;flex-direction:row!important;align-items:center;justify-content:space-between;gap:10px;color:#c7d6dc;font-size:.72rem;font-weight:750}.adsb-v278-filter-row input{width:15px!important;height:15px!important;accent-color:#ff6f2e}.adsb-v278-status{min-height:18px;line-height:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#8fa1aa;font-size:.68rem;border-top:1px solid rgba(255,255,255,.07);padding-top:5px}.adsb-v278-status.err{color:#ffb3a8}
    .tak-stepper{display:inline-grid!important;grid-template-columns:minmax(0,1fr) 19px!important;align-items:stretch!important;width:100%!important}.tak-stepper>input{border-top-right-radius:0!important;border-bottom-right-radius:0!important;min-width:0!important}.tak-stepper-controls{display:grid!important;grid-template-rows:1fr 1fr!important;border:1px solid rgba(255,255,255,.12)!important;border-left:0!important;border-radius:0 9px 9px 0!important;overflow:hidden!important;background:#0e1a22!important}.tak-stepper-controls button{width:19px!important;min-width:19px!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.02))!important;color:#d5e2e7!important;font-size:.48rem!important;line-height:1!important;display:grid!important;place-items:center!important;cursor:pointer!important}.tak-stepper-controls button+button{border-top:1px solid rgba(255,255,255,.10)!important}.tak-stepper-controls button:hover{background:rgba(255,111,46,.18)!important;color:#fff!important}input[type=number].v278-native-number{-moz-appearance:textfield!important;appearance:textfield!important}input[type=number].v278-native-number::-webkit-outer-spin-button,input[type=number].v278-native-number::-webkit-inner-spin-button{-webkit-appearance:none!important;margin:0!important}
