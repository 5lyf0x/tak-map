    map.on('mousedown touchstart',ev=>{try{if(activeMapTool==='draw'){window.v272DrawPointerDown=true;if(map.dragging)map.dragging.disable();if(ev&&ev.originalEvent){try{L.DomEvent.stop(ev.originalEvent)}catch(_){try{ev.originalEvent.preventDefault();ev.originalEvent.stopPropagation()}catch(__){}}}}}catch(_){}});
