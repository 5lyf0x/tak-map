_v276_js = '\n/* v276 ADS-B performance/layout, single transient drawing dialog, no broad boot loop */\n(function(){\n  const V=\'v276\';\n  const $=id=>document.getElementById(id);\n  const clamp=(v,min,max,def)=>{v=Number(v);return Number.isFinite(v)?Math.max(min,Math.min(max,v)):def};\n  let refreshTimer=null, refreshBusy=false, refreshQueued=false, lastSearchRebuild=0;\n  function addCss(){try{if($(\'v276Style\'))return;const css=`\n    .aircraft-wrap,.aircraft-wrap.v270-adsb,.aircraft-wrap.v240-adsb,.leaflet-marker-icon .aircraft-wrap{filter:none!important;text-shadow:none!important;box-shadow:none!important;background:transparent!important;}\n    .aircraft-wrap::before,.aircraft-wrap::after,.aircraft-glyph::before,.aircraft-glyph::after,.adsb-png-icon::before,.adsb-png-icon::after{display:none!important;content:none!important;box-shadow:none!important;filter:none!important;}\n    .aircraft-glyph,.aircraft-glyph.selected,.adsb-png-icon,.aircraft-wrap img{filter:none!important;drop-shadow:none!important;box-shadow:none!important;text-shadow:none!important;outline:none!important;}\n    .aircraft-label{box-shadow:none!important;text-shadow:none!important;background:rgba(5,8,12,.86)!important;border:1px solid rgba(255,255,255,.10)!important;}\n    .leaflet-popup.adsb-object-popup .leaflet-popup-content-wrapper,.leaflet-popup.tak-object-popup .leaflet-popup-content-wrapper{background:linear-gradient(180deg,rgba(11,18,25,.98),rgba(5,9,14,.99))!important;color:#eaf2f5!important;border:1px solid rgba(255,255,255,.16)!important;border-radius:12px!important;box-shadow:0 14px 34px rgba(0,0,0,.56)!important;}\n    .leaflet-popup.adsb-object-popup .leaflet-popup-tip,.leaflet-popup.tak-object-popup .leaflet-popup-tip{background:rgba(7,12,18,.99)!important;border:1px solid rgba(255,255,255,.12)!important;box-shadow:none!important;}\n    #adsbV275CenterBlock{display:grid!important;gap:7px!important;margin:6px 0 8px!important;min-height:92px!important;contain:layout paint!impor