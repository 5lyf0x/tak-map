  function cleanupPanels(){try{qsa('#drawOptionsPanel').forEach(p=>{p.classList.remove('active','open');p.style.display='none';p.style.visibility='hidden';p.setAttribute('aria-hidden','true')})}catch(_){}try{qsa('.iteration-chip,.iteration-marker').forEach(el=>el.textContent=V)}catch(_){}}
