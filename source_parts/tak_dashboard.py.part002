  function positionViewshedDefault(force){try{const m=field('viewshedModule');if(!m)return;const saved=!force?savedViewshedModulePos():null;if(saved){m.dataset.viewshedUserPosition='1';m.style.left=saved.left+'px';m.style.top=saved.top+'px';m.style.right='auto';clampViewshedModule();return}const gap=12,size=viewshedSize(m),tb=viewshedToolbarRect();let left=window.innerWidth-size.width-gap,top=96;if(tb){left=tb.left-size.width-gap;top=tb.top}m.dataset.viewshedUserPosition='0';m.style.left=Math.max(8,left)+'px';m.style.top=Math.max(8,top)+'px';m.style.right='auto';clampViewshedModule()}catch(_){} }
