  </style>`)}
  function setDefaultDisabled(){try{localStorage.setItem(ADSB_KEY,'1')}catch(_){}window._v278AdsbEnabled=false;window._v277AdsbEnabled=false;try{if(window.state&&state.live)state.live.adsb_aircraft=false}catch(_){}}
