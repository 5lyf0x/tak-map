_v270_initial_adsb_body = """<div id=\"adsbV270Menu\" class=\"adsb-v270-menu\"><div class=\"adsb-v270-top\"><button id=\"adsbToggleBtn\" class=\"layer-button\" type=\"button\">Disable ADS-B</button></div><div class=\"adsb-v270-grid\"><label>Radius miles<input id=\"adsbRadiusMiles\" type=\"number\" min=\"1\" max=\"250\" step=\"1\" inputmode=\"numeric\"></label><label>Poll sec<input id=\"adsbUpdateInterval\" type=\"number\" min=\"1\" max=\"300\" step=\"1\" inputmode=\"numeric\"></label><label>Center source<select id=\"adsbCenterSource\"><option value=\"manual\">Manual</option><option value=\"map_center\">Map center</option></select></label><label>Center lat<input id=\"adsbCenterLat\" type=\"text\" inputmode=\"decimal\" placeholder=\"34.000000\"></label><label>Center lon<input id=\"adsbCenterLon\" type=\"text\" inputmode=\"decimal\" placeholder=\"-118.000000\"></label></div><div class=\"adsb-v270-actions\"><button class=\"layer-button\" type=\"button\" onclick=\"useMapCenterForAdsb()\">Use Map Center</button><button class=\"layer-button\" type=\"button\" onclick=\"refreshAdsb()\">Refresh</button></div><div class=\"adsb-filter-box\"><label class=\"adsb-filter-row\"><span>Civil</span><input id=\"adsbFilterCivil\" type=\"checkbox\" checked></label><label class=\"adsb-filter-row\"><span>Military</span><input id=\"adsbFilterMilitary\" type=\"checkbox\" checked></label><label class=\"adsb-filter-row\"><span>Govt</span><input id=\"adsbFilterGovt\" type=\"checkbox\" checked></label><label class=\"adsb-filter-row\"><span>Unknown</span><input id=\"adsbFilterUnknown\" type=\"checkbox\" checked></label></div><div id=\"adsbSettingsStatus\" class=\"adsb-status-v270\"></div></div>"""
try:
    TAK_MAP_HTML = re.sub(r'(<div class="panel collapsible" data-collapse-key="adsbSettings"><h2[^>]*>ADS-B.*?</h2><div class="panel-body">).*?(</div></div><div class="panel"><h2>Data Sync</h2>)', r'\1' + _v270_initial_adsb_body + r'\2', TAK_MAP_HTML, count=1, flags=re.S)
except Exception:
    pass
