  function settings(){return window.lastAdsbSettings||window.config?.adsb?.settings||{}}
  function stored(k,d){return localStorage.getItem('takmap.adsb.'+k)??d}function writeStored(k,v){try{localStorage.setItem('takmap.adsb.'+k,String(v))}catch(_){}}
  function getCenter(){let v=($('adsbCenterLatLon')?.value||stored('center','')).trim();let m=v.match(/(-?\d+(?:\.\d+)?)\s*[,\s]+\s*(-?\d+(?:\.\d+)?)/);if(m){let lat=Number(m[1]),lon=Number(m[2]);if(Number.isFinite(lat)&&Number.isFinite(lon))return {lat,lon}}const lat=Number(settings().center_lat),lon=Number(settings().center_lon);if(Number.isFinite(lat)&&Number.isFinite(lon))return {lat,lon};if(window.map){const c=map.getCenter();return {lat:c.lat,lon:c.lng}}return null}
  function writeCenter(lat,lon){if(!Number.isFinite(Number(lat))||!Number.isFinite(Number(lon)))return;const txt=Number(lat).toFixed(6)+', '+Number(lon).toFixed(6);if($('adsbCenterLatLon'))$('adsbCenterLatLon').value=txt;writeStored('center',txt);qsa('#adsbCenterLat,#adsbCenterLon').forEach(inp=>{try{inp.value=inp.id==='adsbCenterLat'?Number(lat).toFixed(6):Number(lon).toFixed(6)}catch(_){}})}
  function centerSource(){return $('adsbCenterSourceV278')?.value||stored('centerSource','manual')||'manual'}
  function useMapCenter(){if(!window.map)return;const c=map.getCenter();writeCenter(c.lat,c.lng);const s=$('adsbCenterSourceV278');if(s){s.value='map_center';writeStored('centerSource','map_center')}if(window._v278AdsbEnabled)schedulePoll(150)}
  function radius(){return clamp($('adsbRadiusMiles')?.value||settings().radius_miles||50,1,250,50)}function interval(){const v=clamp($('adsbUpdateInterval')?.value||settings().update_interval_seconds||10,1,300,10);if($('adsbUpdateInterval'))$('adsbUpdateInterval').value=String(v);return v}function filters(){return {civil:$('adsbFilterCivil')?.checked!==false,military:$('adsbFilterMilitary')?.checked!==false,govt:$('adsbFilterGovt')?.checked!==false,unknown:$('adsbFilterUnknown')?.checked!==false}}
  function ensureMenu(){const panel=qs('[data-collapse-key="adsbSettings"] .panel-body')||$('adsbV270Menu');if(!panel)return;removeDuplicateMenu();let menu=$('adsbV278Menu');if(!menu){menu=document.createElement('div');menu.id='adsbV278Menu';panel.insertBefore(menu,panel.firstChild)}const c=getCenter();menu.innerHTML=`<button id="adsbToggleBtn" class="layer-button adsb-v278-toggle adsb-disabled" type="button">Enable ADS-B</button><div class="adsb-v278-row"><label>Radius miles<input id="adsbRadiusMiles" type="number" min="1" max="250" step="1" value="${esc(radius())}"></label><label>Update Interval (sec)<input id="adsbUpdateInterval" type="number" min="1" max="300" step="1" value="${esc(interval())}"></label></div><label class="adsb-v278-full">Center Source<select id="adsbCenterSourceV278"><option value="manual">Manual</option><option value="map_center">Select Center</option><option value="follow_map_center">Follow Map Center</option></select></label><label class="adsb-v278-full">Center Lat/Lon<input id="adsbCenterLatLon" type="text" inputmode="decimal" placeholder="34.000000, -118.000000"></label><div class="adsb-v278-actions"><button id="adsbUseMapCenterV278" class="layer-button" type="button">Use Map Center</button><span></span></div><div class="adsb-v278-filters"><label class="adsb-v278-filter-row"><span>Civil</span><input id="adsbFilterCivil" type="checkbox" checked></label><label class="adsb-v278-filter-row"><span>Military</span><input id="adsbFilterMilitary" type="checkbox" checked></label><label class="adsb-v278-filter-row"><span>Govt</span><input id="adsbFilterGovt" type="checkbox" checked></label><label class="adsb-v278-filter-row"><span>Unknown</span><input id="adsbFilterUnknown" type="checkbox" checked></label></div><div id="adsbV278Status" class="adsb-v278-status">ADS-B disabled.</div>`;const src=$('adsbCenterSourceV278');src.value=stored('centerSource','manual');src.onchange=()=>{writeStored('centerSource',src.value);if(src.value==='follow_map_center'&&window.map){const m=map.getCenter();writeCenter(m.lat,m.lng)}if(window._v278AdsbEnabled)schedulePoll(250)};if(c)writeCenter(c.lat,c.lon);$('adsbUseMapCenterV278').onclick=useMapCenter;$('adsbToggleBtn').onclick=()=>setAdsbEnabled(!window._v278AdsbEnabled);['adsbRadiusMiles','adsbFilterCivil','adsbFilterMilitary','adsbFilterGovt','adsbFilterUnknown'].forEach(id=>{const el=$(id);if(el){el.addEventListener('input',()=>{if(window._v278AdsbEnabled)schedulePoll(600)});el.addEventListener('change',()=>{if(window._v278AdsbEnabled)schedulePoll(200)})}});$('adsbUpdateInterval').addEventListener('input',()=>{clearTimeout(window._v278IntervalDebounce);window._v278IntervalDebounce=setTimeout(()=>{if(window._v278AdsbEnabled)reschedulePoll(false)},600)});$('adsbUpdateInterval').addEventListener('change',()=>{if(window._v278AdsbEnabled)reschedulePoll(false)});enhanceNumberInputs(menu);updateButton()}
  function enhanceNumberInputs(root=document){qsa('input[type="number"]',root).forEach(inp=>{if(inp.closest('.tak-stepper'))return;inp.classList.add('v278-native-number');const wrap=document.createElement('span');wrap.className='tak-stepper';inp.parentNode.insertBefore(wrap,inp);wrap.appendChild(inp);const ctr=document.createElement('span');ctr.className='tak-stepper-controls';ctr.innerHTML='<button type="button" aria-label="Increase">▲</button><button type="button" aria-label="Decrease">▼</button>';wrap.appendChild(ctr);const step=dir=>{const st=Number(inp.step||1)||1;const mn=inp.min===''?-Infinity:Number(inp.min),mx=inp.max===''?Infinity:Number(inp.max);let v=Number(inp.value);if(!Number.isFinite(v))v=0;inp.value=String(Math.max(mn,Math.min(mx,v+dir*st)));inp.dispatchEvent(new Event('input',{bubbles:true}));inp.dispatchEvent(new Event('change',{bubbles:true}))};ctr.children[0].onclick=()=>step(1);ctr.children[1].onclick=()=>step(-1)})}
  function iconFor(a){try{if(typeof window.v270AdsbIconUrl==='function')return window.v270AdsbIconUrl(a)}catch(_){}const cls=(a.category||a.category_class||'civil'),rot=a.is_helo||a.is_rotor;let n=cls==='military'?'mil':cls==='govt'?'gov':cls==='unknown'?'unk':'civ';return `/assets/adsb/adsb_${n}_${rot?'helo':'fixed'}.png`}
  function popup(a){const rows=[['Callsign',a.callsign||a.flight||a.registration||a.hex||'Aircraft'],['Class',a.category||'civil'],['Type',a.aircraft_type||a.type||''],['Alt',a.altitude_ft!=null?Math.round(Number(a.altitude_ft))+' ft':''],['Speed',a.speed_kt!=null?Math.round(Number(a.speed_kt))+' kt':''],['Track',a.track_deg!=null?Math.round(Number(a.track_deg))+'°':''],['Range',a.range_miles!=null?Number(a.range_miles).toFixed(1)+' mi':''],['Owner/Op',a.owner_operator||a.ownOp||''],['Squawk',a.squawk||'']].filter(r=>r[1]);return `<div class="feature-popup adsb-popup"><h3>${esc(rows[0]?.[1]||'ADS-B Aircraft')}</h3><div class="kvp">${rows.slice(1).map(r=>`<b>${esc(r[0])}</b><span>${esc(r[1])}</span>`).join('')}</div></div>`}
  function ensureLayer(){try{if(!window.aircraftLayer&&window.L)window.aircraftLayer=L.layerGroup();if(window.aircraftLayer&&window.map&&!map.hasLayer(aircraftLayer))aircraftLayer.addTo(map)}catch(_){}}
  function drawAircraftDiff(list){if(!window._v278AdsbEnabled)return;ensureLayer();window._v278Markers=window._v278Markers||{};const markers=window._v278Markers,seen=new Set(),f=filters();const arr=(list||[]).filter(a=>f[a.category||a.category_class||'civil']!==false);arr.forEach(a=>{if(!Number.isFinite(Number(a.lat))||!Number.isFinite(Number(a.lon)))return;const id=String(a.id||a.hex||a.icao||a.callsign||Math.random()).toLowerCase();seen.add(id);let m=markers[id];const ll=[Number(a.lat),Number(a.lon)],url=iconFor(a);if(!m){const icon=L.divIcon({className:'adsb-v278-marker',iconSize:[32,32],iconAnchor:[16,16],html:`<div class="aircraft-wrap"><img src="${esc(url)}" style="width:32px;height:32px;display:block;transform:rotate(${Number(a.track_deg)||0}deg);filter:none!important;box-shadow:none!important"></div>`});m=L.marker(ll,{icon,zIndexOffset:900,interactive:true}).addTo(aircraftLayer);m.bindPopup(popup(a),{className:'adsb-v278-popup adsb-object-popup',autoPan:false,closeButton:false});m.on('mouseover',()=>{if(!window._v278PinnedPopup)try{m.openPopup()}catch(_){}});m.on('mouseout',()=>{if(!window._v278PinnedPopup)try{m.closePopup()}catch(_){}});m.on('click',ev=>{try{L.DomEvent.stop(ev);window._v278PinnedPopup=id;m.openPopup()}catch(_){}});markers[id]=m}else{m.setLatLng(ll);const el=m.getElement();if(el){const img=el.querySelector('img');if(img){if(img.src.indexOf(url)<0)img.src=url;img.style.transform=`rotate(${Number(a.track_deg)||0}deg)`;img.style.filter='none';img.style.boxShadow='none'}}if(!m.isPopupOpen()||window._v278PinnedPopup!==id){try{m.setPopupContent(popup(a))}catch(_){}}}m._v278Data=a});Object.keys(markers).forEach(id=>{if(!seen.has(id)){try{aircraftLayer.removeLayer(markers[id])}catch(_){}delete markers[id];if(window._v278PinnedPopup===id)window._v278PinnedPopup=null}});try{if(window.lastBanner){lastBanner.adsb_aircraft=arr.length;if(typeof renderTopBanner==='function')renderTopBanner(lastBanner)}if($('adsbStatus'))$('adsbStatus').textContent=arr.length+' active'}catch(_){}}
  function workerCode(){return `const gov=['POLICE','SHERIFF','STATE POLICE','HIGHWAY PATROL','CHP','CAL FIRE','CALFIRE','FIRE','RESCUE','PUBLIC SAFETY','LAW ENFORCEMENT','EMS','MEDEVAC','USFS','FOREST SERVICE',' BLM','NIFC','FEMA','DHS','CBP','CUSTOMS','BORDER PATROL','DEA','FBI','MARSHAL','NASA','NOAA','NPS','PARK SERVICE','COAST GUARD','USCG','LIFE FLIGHT'];function text(o){return ['flight','callsign','r','registration','t','type','desc','description','ownOp','operator','owner','squawk','hex'].map(k=>o&&o[k]).filter(Boolean).join(' ').toUpperCase()}function cls(o){const flags=parseInt(o&& (o.dbFlags??o.dbflags) ||0)||0;if(flags&1)return 'military';const b=text(o);if(gov.some(x=>b.includes(x)))return 'govt';if(!String((o&& (o.hex||o.flight||o.r||o.t))||'').trim())return 'unknown';return 'civil'}function helo(o){const b=text(o);return /\\b(H|HEL|HELI|HELO|ROTOR)\\b/.test(b)||['B407','B412','B429','B206','R22','R44','R66','S76','S92','H135','H145','UH60','MH60','HH60','CH47','AH64'].some(x=>b.includes(x))}function dmi(a,b,c,d){const R=3958.7613,rad=Math.PI/180,x=(c-a)*rad,y=(d-b)*rad;const s=Math.sin(x/2)**2+Math.cos(a*rad)*Math.cos(c*rad)*Math.sin(y/2)**2;return 2*R*Math.atan2(Math.sqrt(s),Math.sqrt(1-s))}function norm(o,c){let lat=Number(o&&o.lat),lon=Number(o&&o.lon);if(!Number.isFinite(lat)||!Number.isFinite(lon)||lat<-90||lat>90||lon<-180||lon>180)return null;let alt=o.alt_baro;if(String(alt).toLowerCase()==='ground')alt=0;if(alt==null)alt=o.alt_geom??o.altitude;const category=cls(o),hex=String(o.hex||o.icao||'').trim().toUpperCase(),reg=String(o.r||o.registration||'').trim().toUpperCase(),flight=String(o.flight||o.callsign||'').trim(),id=hex||reg||flight||('aircraft-'+lat.toFixed(4)+'-'+lon.toFixed(4));const seen=o.seen_pos??o.seen;return {id,hex,icao:hex,registration:reg,callsign:flight||reg||hex||'ADS-B',flight,lat,lon,altitude_ft:alt,speed_kt:o.gs??o.speed,track_deg:o.track??o.true_heading??o.mag_heading,seen_seconds:seen,category,category_class:category,is_military:category==='military',is_govt:category==='govt',is_unknown:category==='unknown',is_helo:helo(o),is_rotor:helo(o),type:o.t||o.type||'',aircraft_type:o.t||o.type||'',owner_operator:o.ownOp||o.operator||o.owner||'',ownOp:o.ownOp||'',dbFlags:o.dbFlags??o.dbflags??0,squawk:o.squawk||'',emergency:o.emergency||'',range_miles:Math.round(dmi(c.lat,c.lon,lat,lon)*100)/100,source:'Airplanes.live Client Direct',updated:new Date().toISOString()}}self.onmessage=async ev=>{const m=ev.data||{};if(m.cmd!=='fetch')return;try{const url='https://api.airplanes.live/v2/point/'+Number(m.center.lat).toFixed(6)+'/'+Number(m.center.lon).toFixed(6)+'/'+Math.round(m.radius||50);const r=await fetch(url,{mode:'cors',credentials:'omit',cache:'no-store',headers:{Accept:'application/json'}});if(!r.ok){self.postMessage({id:m.id,ok:false,error:'HTTP '+r.status});return}const j=await r.json();const src=Array.isArray(j.ac)?j.ac:(Array.isArray(j.aircraft)?j.aircraft:[]);const by={};for(const raw of src){const a=norm(raw,m.center);if(!a)continue;const seen=Number(a.seen_seconds);if(Number.isFinite(seen)&&seen>60)continue;const k=String(a.id).toLowerCase();if(!by[k])by[k]=a}self.postMessage({id:m.id,ok:true,all:Object.values(by)})}catch(e){self.postMessage({id:m.id,ok:false,error:String(e&&e.message||e)})}}`}
  function getWorker(){if(window._v278AdsbWorker)return window._v278AdsbWorker;const w=new Worker(URL.createObjectURL(new Blob([workerCode()],{type:'text/javascript'})));window._v278Seq=0;window._v278Jobs={};w.onmessage=ev=>{const d=ev.data||{},j=window._v278Jobs&&window._v278Jobs[d.id];if(!j)return;delete window._v278Jobs[d.id];d.ok?j.resolve(d):j.reject(new Error(d.error||'fetch failed'))};window._v278AdsbWorker=w;return w}
