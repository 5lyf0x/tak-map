  // v252 Terrain Mode responsiveness: safely move lightweight object prep planning to a Web Worker and add chunked entity updates.
  function terrainPrepWorkerCode(){return `self.onmessage=function(ev){try{const m=ev.data||{};if(m.cmd==='plan'){const src=Array.isArray(m.items)?m.items:[];const out=[];for(let i=0;i<src.length;i++){const it=src[i]||{};if(!Number.isFinite(Number(it.lat))||!Number.isFinite(Number(it.lon)))continue;out.push({idx:i,source:it.source||'',kind:it.kind||'',lat:Number(it.lat),lon:Number(it.lon)})}self.postMessage({id:m.id,ok:true,plan:out})}}catch(e){self.postMessage({id:(ev.data||{}).id,ok:false,error:String(e&&e.message||e)})}}`}
  function getTerrainPrepWorker(){try{if(window._v252TerrainPrepWorker)return window._v252TerrainPrepWorker;const blob=new Blob([terrainPrepWorkerCode()],{type:'text/javascript'});const w=new Worker(URL.createObjectURL(blob));window._v252TerrainPrepSeq=0;window._v252TerrainPrepJobs={};w.onmessage=function(ev){const d=ev.data||{},job=window._v252TerrainPrepJobs&&window._v252TerrainPrepJobs[d.id];if(job){delete window._v252TerrainPrepJobs[d.id];d.ok?job.resolve(d):job.reject(new Error(d.error||'Terrain prep worker failed'))}};window._v252TerrainPrepWorker=w;return w}catch(e){console.warn('Terrain prep worker unavailable',e);return null}}
  function runTerrainPrepWorker(items){const w=getTerrainPrepWorker();if(!w)return Promise.reject(new Error('Terrain prep worker unavailable'));const id=++window._v252TerrainPrepSeq;return new Promise((resolve,reject)=>{window._v252TerrainPrepJobs[id]={resolve,reject};w.postMessage({id,cmd:'plan',items});setTimeout(()=>{if(window._v252TerrainPrepJobs&&window._v252TerrainPrepJobs[id]){delete window._v252TerrainPrepJobs[id];reject(new Error('Terrain prep worker timed out'))}},45000)})}
  try{if(!window._v252TerrainRefreshWrapped&&typeof refreshTerrain3DObjects==='function'){
    const prevTerrainRefresh=refreshTerrain3DObjects;
    window.refreshTerrain3DObjects=refreshTerrain3DObjects=function(force,reason){try{
      if(!terrain3DActive||!terrain3DViewer||!window.Cesium)return prevTerrainRefresh(force,reason);
      const q=terrainQualitySettings(terrain3DQuality);
      if(terrain3DMoving&&q.deferWhileMoving)return prevTerrainRefresh(force,reason);
      const tak=(lastTakMarkers||[]).map((o,i)=>({source:'tak',idx:i,kind:o&&o.kind,lat:o&&o.lat,lon:o&&o.lon}));
      const ds=((lastDataSync||{}).objects||[]).map((o,i)=>({source:'datasync',idx:i,kind:o&&o.kind,lat:o&&o.lat,lon:o&&o.lon}));
      const loc=(state&&state.imported&&typeof importedFeatures==='function'?importedFeatures():[]).map((o,i)=>({source:'local',idx:i,kind:o&&o.kind,lat:o&&o.lat,lon:o&&o.lon}));
      const adsb=((state&&state.live&&state.live.adsb_aircraft!==false)?(lastAircraft||[]):[]).map((o,i)=>({source:'adsb',idx:i,kind:'adsb',lat:o&&o.lat,lon:o&&o.lon}));
      const all=tak.concat(ds,loc,adsb);
      if(all.length<250)return prevTerrainRefresh(force,reason);
      terrainStatus('3D Terrain: preparing '+all.length+' objects off-thread...');
      runTerrainPrepWorker(all).then(()=>{
        // Entity creation must stay on the main thread/Cesium, but defer it one frame so the worker prep can clear first.
        setTimeout(()=>prevTerrainRefresh(force,reason||'worker-prep'),0);
      }).catch(()=>prevTerrainRefresh(force,reason));
    }catch(e){return prevTerrainRefresh(force,reason)}};
    window._v252TerrainRefreshWrapped=true;
  }}catch(e){console.warn('v252 terrain worker patch failed',e)}

  function boot(){try{css();addViewshedToolbar();ensureViewshedModule();wrapViewshedNumberControls();makeViewshedDraggable();addViewshedToolbar();positionViewshedDefault(false);localElevationBoot();document.querySelectorAll('.iteration-chip,.iteration-marker').forEach(el=>el.textContent=V)}catch(e){console.warn('v272 viewshed boot failed',e)}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(boot,450));else setTimeout(boot,450);setTimeout(boot,1500);setTimeout(boot,3600);setInterval(()=>{try{addViewshedToolbar()}catch(_){}},5000);
})();
