  function clampViewshedModule(){try{const m=field('viewshedModule');if(!m)return;const size=viewshedSize(m);let left=parseFloat(m.style.left),top=parseFloat(m.style.top);if(!Number.isFinite(left)||!Number.isFinite(top)){const r=m.getBoundingClientRect();left=r.left;top=r.top}left=Math.max(8,Math.min(window.innerWidth-size.width-8,left));top=Math.max(8,Math.min(window.innerHeight-size.height-8,top));m.style.left=left+'px';m.style.top=top+'px';m.style.right='auto'}catch(_){} }
