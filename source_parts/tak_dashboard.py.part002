  window.togglePanelCollapse=function(target){try{let p=null;if(typeof target==='string')p=qs(`[data-collapse-key="${target}"]`);else p=target&&target.closest?target.closest('.panel.collapsible,[data-collapse-key]'):null;if(!p)return;const body=p.querySelector('.panel-body');const collapsed=p.classList.toggle('collapsed');if(body)body.style.display=collapsed?'none':'';const t=p.querySelector('.panel-toggle');if(t)t.textContent=collapsed?'▸':'▾'}catch(e){console.warn('togglePanelCollapse failed',e)}};
  function clearAdsbTimers(){try{((window.__takMapTimers&&window.__takMapTimers.intervals)||[]).slice().forEach(t=>{const s=String(t.src||'').toLowerCase();if(/adsb|aircraft|v27[0-7]|refreshadsb|scheduleadsb/.test(s))try{clearInterval(t.id)}catch(_){}});((window.__takMapTimers&&window.__takMapTimers.timeouts)||[]).slice().forEach(t=>{const s=String(t.src||'').toLowerCase();if(/refreshadsb|scheduleadsb|v27[0-7].*adsb|adsb.*refresh/.test(s))try{clearTimeout(t.id)}catch(_){}})}catch(_){}}
  function killWorkers(){['_v271AdsbWorker','_v275AdsbWorker','_v276AdsbWorker','_v277AdsbWorker','_v278AdsbWorker','_adsbWorker'].forEach(k=>{try{if(window[k]&&window[k].terminate)window[k].terminate()}catch(_){};try{window[k]=null}catch(_){}})}
  function updateButton(){const b=$('adsbToggleBtn');if(!b)return;const on=!!window._v278AdsbEnabled;b.textContent=on?'Disable ADS-B':'Enable ADS-B';b.classList.toggle('adsb-disabled',!on);b.classList.toggle('adsb-enabled',on)}
  function hardDisableAdsb(){setDefaultDisabled();clearAdsbTimers();killWorkers();try{if(window.aircraftLayer){aircraftLayer.clearLayers();if(window.map&&map.hasLayer(aircraftLayer))map.removeLayer(aircraftLayer)}}catch(_){}try{window.lastAircraft=[];lastAircraft=[]}catch(_){window.lastAircraft=[]}status('ADS-B disabled.');updateButton()}
  function oldNoop(){return Promise.resolve([])}
  function patchLegacyFns(){['scheduleAdsbRefreshTimer','saveAdsbInterval','saveAdsbSettings','loadAdsbSettings','setAdsbOtsJobDisabled','toggleAdsbOtsJob','v274TestAdsb'].forEach(k=>{try{window[k]=oldNoop}catch(_){}});window.refreshAdsb=function(){return window._v278AdsbEnabled?pollAdsb():Promise.resolve([])};window.drawAircraft=function(list){return window._v278AdsbEnabled?drawAircraftDiff(list||[]):null};window.enableTakMapAdsbLocal=function(){setAdsbEnabled(true)};window.disableTakMapAdsbLocal=function(){setAdsbEnabled(false)};window.toggleTakMapAdsbLocal=function(){setAdsbEnabled(!window._v278AdsbEnabled)};window.useMapCenterForAdsb=function(){useMapCenter()}}
