.zoom-indicator{position:fixed!important;right:14px!important;top:64px!important;z-index:850!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;width:max-content!important;min-width:0!important;max-width:360px!important;height:42px!important;padding:0 16px!important;border:1px solid rgba(255,255,255,.10)!important;border-radius:16px!important;background:rgba(8,13,18,.90)!important;color:#d7e1e8!important;font-size:.76rem!important;font-weight:850!important;letter-spacing:.02em!important;text-align:center!important;white-space:nowrap!important;overflow:hidden!important;box-shadow:0 14px 34px rgba(0,0,0,.34)!important;backdrop-filter:none!important;text-shadow:none!important}.zoom-indicator::before{content:''!important;display:inline-block!important;width:9px!important;height:9px!important;margin-right:0!important;border-radius:999px!important;background:var(--good)!important;box-shadow:0 0 8px rgba(57,217,138,.78)!important;flex:0 0 auto!important}.local-actions{display:block!important;position:relative!important;bottom:auto!important;margin:0 8px 8px!important;border:1px solid rgba(53,69,86,.88)!important;border-radius:12px!important;background:rgba(9,16,24,.82)!important;padding:8px!important}.local-actions-top{display:block!important;margin:0 0 6px!important}.local-actions-top .chip{display:none!important}.local-actions .local-selected-count{font-size:.72rem!important;color:var(--muted)!important}.local-action-buttons{display:flex!important;justify-content:flex-start!important;align-items:center!important;flex-wrap:nowrap!important;gap:4px!important}.local-action-buttons .layer-button,.local-actions .layer-button{padding:4px 5px!important;font-size:.62rem!important;line-height:1.05!important;white-space:nowrap!important;min-width:0!important}.floating-toolbar-dock{position:fixed;right:14px;top:154px;z-index:875;display:flex;align-items:flex-start;gap:8px;user-select:none}.floating-map-toolbar,.map-mini-toolbar{border:1px solid rgba(53,69,86,.95);border-radius:14px;background:rgba(6,10,14,.90);box-shadow:0 18px 42px rgba(0,0,0,.46);padding:5px}.floating-map-toolbar{width:46px}.map-mini-toolbar{display:none;width:46px}.map-mini-toolbar.active{display:block}.toolbar-grip{height:14px;display:grid;place-items:center;color:#617680;font-size:16px;line-height:1;cursor:grab}.toolbar-grip:active{cursor:grabbing}.tool-btn{position:relative;width:34px;height:34px;margin:4px auto;display:grid;place-items:center;color:#9aaab1;background:#121d25;border:1px solid #334553;border-radius:10px;cursor:pointer;padding:0}.tool-btn svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}.tool-btn:hover{border-color:#5b707a;background:#17252d;color:#c7d1d7}.tool-btn.active{border-color:#6c8089;background:rgba(155,170,178,.10);color:#d0d9de;box-shadow:0 0 0 1px rgba(200,213,219,.06),0 0 12px rgba(160,178,187,.08)}.tool-label{position:absolute;right:44px;top:50%;transform:translateY(-50%);background:rgba(6,10,14,.94);border:1px solid rgba(53,69,86,.9);border-radius:10px;padding:5px 8px;color:var(--text);font-size:.66rem;white-space:nowrap;opacity:0;pointer-events:none;transition:.12s ease}.tool-btn:hover .tool-label{opacity:1}.map-mini-toolbar .tool-label{right:44px}.map-tool-readout{display:none;position:fixed;top:112px;left:calc(396px + (100vw - 396px)/2);transform:translateX(-50%);z-index:865;align-items:center;gap:10px;padding:9px 13px;border:1px solid rgba(111,131,139,.60);border-radius:13px;background:rgba(6,10,14,.90);box-shadow:0 14px 34px rgba(0,0,0,.42);color:#c7d1d7;font-size:.76rem;font-weight:900;white-space:nowrap}.map-tool-readout.active{display:flex}.map-tool-readout .mode{color:#9aaab1;text-transform:uppercase;letter-spacing:.08em;font-size:.64rem}.map-tool-readout .pinned{color:#d4dde2;border-left:1px solid rgba(255,255,255,.14);padding-left:10px}.sidebar.collapsed~.map-tool-readout{left:50%}.measure-seg-label{border:1px solid rgba(155,170,178,.45);border-radius:999px;background:rgba(6,10,14,.82);color:#c6d0d5;font-size:.66rem;font-weight:850;padding:3px 6px;white-space:nowrap;box-shadow:0 8px 18px rgba(0,0,0,.32);opacity:.90}.measure-point-dot{width:12px;height:12px;border-radius:999px;background:#bac5ca;border:2px solid #071014;box-shadow:0 0 8px rgba(0,0,0,.5)}.measure-popup-box{width:248px;border:1px solid rgba(111,131,139,.56);border-radius:14px;background:rgba(6,10,14,.88);box-shadow:0 16px 38px rgba(0,0,0,.40);padding:10px;font-size:.72rem;color:#c7d1d7}.measure-popup-box h3{margin:0 0 7px;color:#d0d9de;font-size:.76rem;text-transform:uppercase;letter-spacing:.07em}.measure-popup-row{display:flex;justify-content:space-between;gap:8px;padding:4px 0;border-bottom:1px solid rgba(255,255,255,.06);color:var(--muted)}.measure-popup-row b{color:#d2dce1}.measure-popup-total{margin-top:7px;padding-top:7px;border-top:1px solid rgba(155,170,178,.25);color:#d2dce1;font-weight:900}.toolbar-3d-placeholder{opacity:.92}
#map.coords-tool-active{cursor:crosshair!important}#map.coords-tool-active:before,#map.coords-tool-active:after{content:"";position:absolute;z-index:860;pointer-events:none;background:rgba(199,209,215,.42);box-shadow:0 0 8px rgba(199,209,215,.20)}#map.coords-tool-active:before{left:0;right:0;top:50%;height:1px}#map.coords-tool-active:after{top:0;bottom:0;left:50%;width:1px}.floating-map-toolbar{display:block!important;flex:0 0 46px}.measure-seg-label{background:rgba(6,10,14,.94)!important;border-color:rgba(199,209,215,.75)!important;text-shadow:0 1px 3px #000}.measure-popup-box{position:relative;z-index:10000;background:rgba(6,10,14,.96)!important}.tool-color{width:34px;height:34px;margin:4px auto;display:grid;place-items:center;border:1px solid #334553;border-radius:10px;background:#121d25;cursor:pointer;position:relative}.tool-color input{width:26px;height:26px;border:0;padding:0;background:transparent;cursor:pointer}.tool-color .tool-label{right:44px}.local-section-title{display:flex!important;align-items:center!important;gap:7px!important}.local-section-title .subgroup-label{flex:1;min-width:0}.unselect-local-btn{font-size:.62rem!important;padding:4px 7px!important;margin-left:auto!important}.basemap-import-row{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:7px}.basemap-import-row .layer-button{font-size:.68rem;padding:5px 7px}.basemap-import-status{display:block;margin-top:5px;color:var(--muted);font-size:.68rem}.map-mini-toolbar{flex:0 0 46px}.leaflet-popup{z-index:890!important}

.terrain3d-pane{display:none;position:fixed;top:86px;left:396px;right:0;bottom:0;z-index:820;background:#081018;overflow:hidden}.terrain3d-pane.active{display:block}.sidebar.collapsed~.terrain3d-pane{left:0}.terrain3d-pane #terrain3dCanvas,.terrain3d-pane .cesium-widget,.terrain3d-pane .cesium-widget canvas{width:100%!important;height:100%!important}.terrain3d-status{position:absolute;left:12px;bottom:12px;z-index:3;max-width:430px;border:1px solid rgba(53,69,86,.88);border-radius:13px;background:rgba(6,10,14,.90);box-shadow:0 14px 34px rgba(0,0,0,.34);color:#c7d1d7;font-size:.72rem;font-weight:850;padding:9px 11px}.terrain3d-close{position:absolute;right:12px;bottom:12px;z-index:4}.terrain3d-pane .cesium-viewer-toolbar,.terrain3d-pane .cesium-viewer-animationContainer,.terrain3d-pane .cesium-viewer-timelineContainer,.terrain3d-pane .cesium-viewer-bottom{font-size:.68rem}.terrain-3d-active #tool3d{border-color:#6c8089;background:rgba(155,170,178,.10);color:#d0d9de;box-shadow:0 0 0 1px rgba(200,213,219,.06),0 0 12px rgba(160,178,187,.08)}
@media(max-width:900px){.zoom-indicator{top:112px!important;right:12px!important;font-size:.68rem!important}.floating-toolbar-dock{right:10px;top:154px}.map-tool-readout{left:50%;max-width:calc(100vw - 88px);overflow:auto;font-size:.68rem}.tool-label{display:none}}

/* v228 map UI refinements */
.measure-seg-label{background:transparent!important;border:0!important;box-shadow:none!important;text-shadow:0 1px 3px #000,0 -1px 3px #000,1px 0 3px #000,-1px 0 3px #000!important;padding:0!important;font-weight:850!important;opacity:.96!important}.measure-popup-dock{position:fixed;z-index:10050;display:none;cursor:grab;touch-action:none}.measure-popup-dock:active{cursor:grabbing}.measure-popup-box{width:248px!important;max-width:248px!important;border:1px solid rgba(111,131,139,.56)!important;border-radius:14px!important;background:rgba(6,10,14,.94)!important;box-shadow:0 16px 38px rgba(0,0,0,.44)!important;padding:9px!important;font-size:.70rem!important;color:#c7d1d7!important}.measure-popup-box h3{margin:0 0 6px!important;color:#d0d9de!important;font-size:.74rem!important;text-transform:uppercase!important;letter-spacing:.07em!important}.measure-popup-row{display:flex!important;justify-content:space-between!important;gap:8px!important;padding:3px 0!important;border-bottom:1px solid rgba(255,255,255,.06)!important;color:var(--muted)!important}.measure-popup-row span:last-child{color:#d2dce1!important;font-weight:400!important}.measure-popup-total{margin-top:6px!important;padding-top:6px!important;border-top:1px solid rgba(155,170,178,.25)!important;color:#d2dce1!important;font-weight:400!important}.basemap-button-row{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;margin-top:7px!important}.basemap-button-row .layer-button{font-size:.68rem!important;padding:5px 5px!important;white-space:nowrap!important}.basemap-import-status{grid-column:1/-1}.export-check-list{display:grid;gap:5px;margin-top:7px}.export-check-list label{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:.76rem}.export-options{margin-top:7px;border:1px solid rgba(255,255,255,.08);border-radius:10px;background:rgba(255,255,255,.025);padding:0 8px 7px}.export-options summary{cursor:pointer;color:var(--muted);font-size:.74rem;font-weight:850;letter-spacing:.04em;text-transform:uppercase;list-style:none;padding:7px 0}.export-options summary::-webkit-details-marker{display:none}.export-options summary:before{content:'▸';display:inline-block;margin-right:6px;color:#ff9f86}.export-options[open] summary:before{content:'▾'}.export-options{margin-top:7px;border:1px solid rgba(255,255,255,.08);border-radius:10px;background:rgba(255,255,255,.025);padding:0 8px 7px}.export-options summary{cursor:pointer;color:var(--muted);font-size:.74rem;font-weight:850;letter-spacing:.04em;text-transform:uppercase;list-style:none;padding:7px 0}.export-options summary::-webkit-details-marker{display:none}.export-options summary:before{content:'▸';display:inline-block;margin-right:6px;color:#ff9f86;transition:transform .16s ease}.export-options[open] summary:before{transform:rotate(90deg)}.leaflet-popup{z-index:890!important}.leaflet-popup-content-wrapper{max-width:min(340px,calc(100vw - 28px))}.feature-popup .kvp b{white-space:nowrap}

/* v233 ADS-B settings/icons/timing + status dropdown refinements */
.terrain3d-elevation{top:64px!important;left:56px!important;z-index:6!important}
.terrain3d-status{left:82px!important;bottom:28px!important;z-index:4!important;max-width:430px!important}
.terrain3d-pane .cesium-credit-logoContainer,.terrain3d-pane .cesium-credit-textContainer,.terrain3d-pane .cesium-credit-expand-link{z-index:9!important}
.adsb-settings-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:7px;margin-top:8px;width:100%;max-width:100%;overflow:hidden}
.adsb-settings-grid label{display:flex;flex-direction:column;gap:4px;color:var(--muted);font-size:.70rem;text-transform:uppercase;letter-spacing:.07em;font-weight:850;min-width:0}
.adsb-settings-grid input,.adsb-settings-grid select{background:#091018;border:1px solid #334553;border-radius:10px;color:var(--text);padding:8px 9px;min-width:0;width:100%;max-width:100%;font-size:.78rem}.adsb-settings-grid input[type=number]{min-height:36px;font-size:.9rem}.adsb-coord-input{appearance:textfield;-moz-appearance:textfield}.adsb-coord-input::-webkit-outer-spin-button,.adsb-coord-input::-webkit-inner-spin-button{display:none;-webkit-appearance:none;margin:0}.adsb-apply-row .layer-button{font-weight:600}
.adsb-apply-row{display:flex;gap:7px;align-items:center;margin-top:8px;flex-wrap:wrap}
</style></head><body><div class="topbar"><div class="title"><img src="/tak-map-logo.png" alt=""><span>TAK Map</span></div><div class="top-actions"><button onclick="logoutTakMap()">Map Logout</button></div></div><div id="mapStatusBanner" class="map-status-banner"><span class="status-item status-dropdown-trigger" id="bannerEudsItem" onclick="toggleStatusDropdown('euds',event)"><span class="status-dot unknown" id="bannerEudsDot"></span>EUDs: <b id="bannerEuds">0 Connected</b></span><span class="status-item status-dropdown-trigger" id="bannerNonTakItem" onclick="toggleStatusDropdown('nontak',event)"><span class="status-dot unknown" id="bannerNonTakDot"></span>Non-TAK Sensor: <b id="bannerNonTak">0</b></span><span class="status-item" id="bannerTakItem"><span class="status-dot unknown" id="bannerTakDot"></span>TAK Server: <b id="bannerTak">Checking</b></span><span class="status-item" id="bannerInternetItem"><span class="status-dot unknown" id="bannerInternetDot"></span>Internet: <b id="bannerInternet">Checking</b></span><span class="status-item status-dropdown-trigger" id="bannerAdsbItem" onclick="toggleStatusDropdown('adsb',event)"><span class="status-dot unknown" id="bannerAdsbDot"></span>ADS-B: <b id="bannerAdsb">0 Aircraft</b></span><span class="status-item" id="bannerDownloadsItem"><span class="status-dot unknown" id="bannerDownloadsDot"></span>Downloads: <b id="bannerDownloads">0 Active</b></span></div><div id="statusDropdown" class="status-dropdown"></div><aside id="sidebar" class="sidebar"><div class="panel"><div class="search-wrap"><input id="layerSearch" class="search" placeholder="Search callsign / mission / route / source..." oninput="handleMapSearch()" autocomplete="off"><button class="search-clear" onclick="clearMapSearch()" title="Clear search">×</button><div id="searchResults" class="search-results"></div></div><div class="muted" id="mapStatus">Loading map configuration...</div></div><div class="panel"><h2>Basemap</h2><select id="basemapSelect" class="select" onchange="setBasemap(this.value)"></select><div class="relief-controls"><label><input type="checkbox" id="reliefOverlayToggle" onchange="toggleReliefOverlay(this.checked)"> USGS Shaded Relief</label><input id="reliefOpacity" type="range" min="0" max="100" value="35" oninput="setReliefOpacity(this.value)"></div><input id="basemapXmlInput" type="file" accept=".xml,.txt" multiple style="display:none" onchange="importBasemapXmlFiles()"><div class="basemap-button-row"><button class="layer-button" onclick="openSendLiveBasemapSource()">Send Map</button><button class="layer-button" onclick="triggerBasemapXmlImport()">Add Basemap</button><button class="layer-button" onclick="clearCustomBasemaps()">Clear Custom</button><small id="customBasemapStatus" class="basemap-import-status"></small></div></div><div class="panel"><h2>Live TAK</h2><div id="liveRows"></div></div><div class="panel collapsible" data-collapse-key="adsbSettings"><h2 onclick="togglePanelCollapse(this)">ADS-B <span class="panel-toggle">▾</span></h2><div class="panel-body"><div class="muted">TAK Map-side ADS-B display filter only. Does not modify OTS config.yml.</div><div class="adsb-settings-grid"><label>Radius miles<input id="adsbRadiusMiles" class="adsb-radius-input" type="number" min="1" max="250" step="1" value="5" inputmode="numeric"></label><label>Update Interval (sec)<input id="adsbUpdateInterval" class="adsb-radius-input" type="number" min="1" max="300" step="1" value="5" inputmode="numeric"></label><label>Center source<select id="adsbCenterSource"><option value="manual">Manual lat/lon</option><option value="map_center">Current map center</option><option value="receiver">ADS-B receiver/default</option></select></label><label>Center lat<input id="adsbCenterLat" class="adsb-coord-input" type="text" inputmode="decimal" placeholder="34.000000"></label><label>Center lon<input id="adsbCenterLon" class="adsb-coord-input" type="text" inputmode="decimal" placeholder="-118.000000"></label></div><div class="adsb-apply-row"><button class="layer-button" onclick="useMapCenterForAdsb()">Use Map Center</button><button class="layer-button" onclick="saveAdsbSettings(false)">Save Filter</button></div><div id="adsbSettingsStatus" class="muted" style="margin-top:7px"></div></div></div><div class="panel" id="tokenMeshCardI660" data-collapse-key="meshSync" data-skip-auto-collapsible="true"><h2>MESH SYNC <span class="chip" id="tokenMeshStateI660">Not enrolled</span></h2><div class="muted" id="tokenMeshInfoI660">Separate from Gateway/OTS. Encrypted peer exchange runs on the TAK Map server.</div><div class="row" id="tokenMeshButtonsI660"><button class="layer-button" type="button" onclick="tokenMeshCreateI660()">Create Mesh</button><button class="layer-button" type="button" onclick="tokenMeshJoinI660()">Join Mesh</button><button class="layer-button" type="button" onclick="tokenMeshUploadI660()">Upload QR Image</button></div><div class="row" id="tokenMeshMembersI660" style="display:none"><button class="layer-button" type="button" onclick="tokenMeshShowI660()">Show Join Code</button><button class="layer-button" type="button" onclick="tokenMeshLeaveI660()">Leave Mesh</button></div><div class="row"><button class="layer-button" type="button" onclick="tokenMeshMissionI660()">Join Mission (XMS1)</button></div><div class="muted" id="tokenMeshMissionsI660"></div></div><script>(function(){'use strict';
  async function api(path, payload) {
    const options={credentials:'same-origin',cache:'no-store'};
    if(payload!==undefined){options.method='POST';options.headers={'Content-Type':'application/json'};options.body=JSON.stringify(payload);}
    const r=await fetch('/api/tak-map/mesh/'+path,options);
    const result=await r.json();
    if(!r.ok || !result.ok) throw new Error(result.error||'Mesh API failed');
    return result;
  }
  const update=async()=>{
    try{
      const v=await api('status');
      const state=document.getElementById('tokenMeshStateI660');if(!state)return;
      state.textContent=v.enrolled?(v.authenticatedPeers?'Authenticated':v.transportReady?'Discovering':'Enrolled / offline'):'Not enrolled';
      document.getElementById('tokenMeshInfoI660').textContent=v.enrolled?('Group: '+v.name+' | Peers: '+(v.authenticatedPeers||0)+' authenticated / '+(v.visiblePeers||0)+' visible | Mission bindings: '+(v.missionBindings||[]).filter(x=>x.enabled).length+' | Last sync: '+(v.lastSuccessfulSync?new Date(v.lastSuccessfulSync.time*1000).toLocaleString():'Never')+(v.transportError?' | Network: '+v.transportError:'')):'Not enrolled. Create or join a Token Mesh group to enable discovery.';
      document.getElementById('tokenMeshButtonsI660').style.display=v.enrolled?'none':'';
      document.getElementById('tokenMeshMembersI660').style.display=v.enrolled?'flex':'none';
      document.getElementById('tokenMeshMissionsI660').textContent='Mission bindings: '+((v.missionBindings||[]).map(x=>x.name+(x.enabled?' (enabled)':' (disabled)')).join(', ')||'none')+' | Objects in mesh journal: '+(v.journalOperations||0); if(window.refreshTokenMeshMapI660)window.refreshTokenMeshMapI660();
    }catch(e){const state=document.getElementById('tokenMeshStateI660');if(state)state.textContent='Status error';}
  };
  async function act(path,payload){try{const r=await api(path,payload);await update();return r;}catch(e){alert('Token Mesh: '+e.message+'\nSensitive operations require both TAK Map login and Dashboard administrator login over HTTPS.');}}
  window.tokenMeshCreateI660=async()=>{const name=prompt('New Token Mesh group name:');if(name===null)return;const v=await act('create',{name});if(v){const invite=await act('invite');showToken(v.invite,invite&&invite.qrPngBase64);}};
  window.tokenMeshJoinI660=async()=>{const token=prompt('Paste the complete XTM1 Token Mesh invitation:');if(!token)return;if(!confirm('Join this Token Mesh group? The current enrollment must be empty.'))return;await act('join',{token});};
  window.tokenMeshShowI660=async()=>{const v=await act('invite');if(v)showToken(v.invite,v.qrPngBase64);};
  window.tokenMeshLeaveI660=async()=>{if(confirm('Leave Token Mesh? This removes the local group secret; journal and Mission bindings are kept. Previously exported tokens remain usable on other devices.'))await act('leave',{confirm:true});};
  window.tokenMeshUploadI660=async()=>{
    const picker=document.createElement('input');picker.type='file';picker.accept='image/png,image/jpeg,image/webp';
    picker.onchange=async()=>{const file=picker.files&&picker.files[0];if(!file)return;if(file.size>4*1024*1024){alert('QR image limit: 4 MiB');return;}
      if(typeof BarcodeDetector==='undefined'){alert('This browser cannot decode QR images locally. Paste the complete XTM1 token instead.');return;}
      try{const bmp=await createImageBitmap(file);if(bmp.width>4096||bmp.height>4096){bmp.close();throw Error('QR image dimensions exceed 4096px');}
        const decoder=new BarcodeDetector({formats:['qr_code']});const codes=await decoder.detect(bmp);bmp.close();
        if(codes.length!==1||!codes[0].rawValue.startsWith('XTM1:'))throw Error('Exactly one XTM1 QR code is required');
        if(confirm('Join group from this QR invitation?'))await act('join',{token:codes[0].rawValue});
      }catch(e){alert('QR import failed: '+e.message);}
    };picker.click();
  };
  window.tokenMeshMissionI660=async()=>{const token=prompt('Paste complete XMS1 Mission invitation. Matching Mission bindings are required on both devices:');if(token)await act('mission-join',{token});};
  function showToken(value,qrBase64){
    // Keep secret in ephemeral dialog only; not localStorage or request URL.
    const dialog=document.createElement('dialog');dialog.style.cssText='max-width:min(90vw,720px);background:#172129;color:#f0f4f6;border:1px solid #50616c;border-radius:10px;padding:20px';
    const title=document.createElement('h3');title.textContent='Token Mesh invitation (secret)';dialog.append(title);
    const desc=document.createElement('p');desc.textContent='Anyone with this complete token can join your Mesh group. Store it securely. The QR and complete printed code contain the same sensitive token.';dialog.append(desc);
    if(qrBase64){const qr=document.createElement('img');qr.src='data:image/png;base64,'+qrBase64;qr.alt='Complete Token Mesh join code, including readable token';qr.style.cssText='display:block;max-width:100%;max-height:45vh;object-fit:contain;margin:10px auto';dialog.append(qr);const save=document.createElement('button');save.textContent='Save QR Image';save.onclick=()=>{const a=document.createElement('a');a.href=qr.src;a.download='token-mesh-private-invite.png';a.click()};dialog.append(save);}
    const code=document.createElement('textarea');code.readOnly=true;code.value=value;code.rows=6;code.style.cssText='width:100%;box-sizing:border-box;background:#0c151c;color:#cde6f3;overflow-wrap:anywhere';dialog.append(code);
    const copy=document.createElement('button');copy.textContent='Copy Token';copy.onclick=async()=>{try{await navigator.clipboard.writeText(value)}catch(_){code.select();document.execCommand('copy')}};dialog.append(copy);
    const done=document.createElement('button');done.textContent='Done';done.style.marginLeft='12px';done.onclick=()=>{dialog.close();dialog.remove();};dialog.append(done);
    document.body.append(dialog);dialog.showModal();dialog.addEventListener('close',()=>dialog.remove());
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>{update();setInterval(update,15000)});
  else {update();setInterval(update,15000)}
})();
</script><script>(function(){'use strict';let group=null;let groupMap=null;let previous='';
function leafletMap(){
  const valid=x=>!!x&&typeof x.on==='function'&&typeof x.addLayer==='function'&&typeof x.removeLayer==='function'&&typeof x.getBounds==='function';
  let lexical=null;try{if(typeof map!=='undefined')lexical=map}catch(_){};
  for(const x of [window.takLeafletMap,lexical,window.map])if(valid(x))return x;
  return null;
}
async function load(){
  const meshMap=leafletMap();if(!meshMap||!window.L)return;
  try{const r=await fetch('/api/tak-map/mesh/objects',{cache:'no-store',credentials:'same-origin'});if(!r.ok)return;const j=await r.json();if(!j.ok)return;
  const stamp=JSON.stringify(j.objects||[]);if(groupMap!==meshMap){if(group&&groupMap)try{groupMap.removeLayer(group)}catch(_){}group=null;groupMap=meshMap;previous=''}
  if(stamp===previous)return;
  if(!group)group=L.layerGroup().addTo(meshMap);group.clearLayers();
  for(const obj of j.objects||[]){const cc=obj.coords||[];if(!cc.length)continue;let layer;
    if(obj.kind==='AREA'&&cc.length>=3)layer=L.polygon(cc,{color:'#39addd',weight:2,fillOpacity:.10});
    else if(obj.kind==='ROUTE'&&cc.length>=2)layer=L.polyline(cc,{color:'#39addd',weight:3});
    else layer=L.circleMarker(cc[0],{radius:6,color:'#39addd',fillOpacity:.5});
    const div=document.createElement('div');div.textContent=obj.name+' | Mesh • '+obj.mission+' | '+obj.kind;
    layer.bindPopup(div);layer.addTo(group);
  }
  previous=stamp;
  }catch(e){console.warn('Mesh object refresh:',e)}
}window.refreshTokenMeshMapI660=load;setInterval(load,12000);setTimeout(load,3000);})();</script><div class="panel"><h2>Data Sync</h2><div class="row"><button class="layer-button" onclick="refreshDataSync()">Refresh Data Sync</button><span class="chip" id="missionCount">0 missions</span></div><div class="row"><label><input type="checkbox" checked onchange="toggleDataSyncObjects(this.checked)"><span>Show Data Sync objects</span></label><span class="chip" id="dataSyncObjectCount">0 objects</span></div><div id="dataSyncRows" class="sync-list"><div class="muted">Loading missions...</div></div></div><div class="panel"><h2>Local Data</h2><div class="row"><button class="layer-button" onclick="refreshLocalData()">Refresh local data</button><span class="chip" id="localDataCount">0</span></div><input id="importFileInput" type="file" multiple style="display:none" onchange="uploadImportFiles()"><div id="localDataRows"><div class="muted">Loading local data...</div></div></div><div class="panel"><h2>Offline Maps</h2><div class="subgroup-title">Create Offline Map Pack</div><input id="offlinePackName" class="search" placeholder="Pack name, e.g. Big Bear Topo"><div class="row"><span class="muted">Source basemap</span><span class="chip" id="offlineSourceText">Current basemap</span></div><div class="row"><span class="muted">Area</span><button class="layer-button" onclick="useCurrentViewForOffline()">Current View</button><button class="layer-button" onclick="startOfflineAreaDraw()">Draw Area</button><button class="layer-button" onclick="clearOfflineArea()">Clear</button></div><div id="offlineDrawHelp" class="draw-help" style="display:none">Drag on the map to draw the download rectangle.</div><div class="row"><span class="muted" id="offlineBoundsText">No area selected yet.</span></div><div id="offlineEstimate" class="muted">Use Current View or Draw Area, then choose zoom range to estimate download size.</div><div class="row"><label><span>Min zoom</span></label><input id="offlineMinZoom"