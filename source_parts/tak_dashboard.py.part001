ace:nowrap}.cmd-command-kind.default{color:#ffd0bb;border:1px solid rgba(255,106,42,.42);background:rgba(255,106,42,.08)}.cmd-command-kind.custom{color:#c7ffdd;border:1px solid rgba(57,217,138,.38);background:rgba(57,217,138,.06)}.cmd-command-desc{font-size:.82rem;color:var(--muted);margin-bottom:8px}.cmd-command-code{display:block;font-size:.78rem;line-height:1.3;max-height:4.5em;overflow:auto;padding:7px 8px;border-radius:8px;background:#070a0f;border:1px solid var(--line);color:#ffd0bb}.cmd-command-actions{display:flex;flex-direction:column;gap:6px;align-items:stretch}.cmd-command-actions button{width:88px;margin:0}.cmd-command-actions .mini-remove{font-size:.72rem;padding:6px 8px}
