(function(){
  const st=document.createElement('style');st.id='tak-v233-style';st.textContent="\n.adsb-popup{min-width:260px;color:#edf5fa!important;background:transparent!important}.leaflet-popup-content .adsb-popup h3{color:#fff!important}.leaflet-popup-content .adsb-popup .kvp b{color:#ffd0b2!important}.leaflet-popup-content .adsb-popup .kvp span{color:#f0f6fa!important}.leaflet-popup-content .adsb-popup .kvp{grid-template-columns:auto minmax(0,1fr)}\n.adsb-settings-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important}.adsb-settings-grid label:nth-of-type(3){grid-column:1 / -1}.adsb-settings-grid label:nth-of-type(4),.adsb-settings-grid label:nth-of-type(5){grid-column:auto!important}.adsb-settings-grid input,.adsb-settings-grid select{box-sizing:border-box}.adsb-apply-row .layer-button{font-weight:650!important}\n.status-adsb-head span{cursor:pointer;user-select:none}.status-adsb-head span:hover{color:#fff}.status-sort-ind{color:var(--accent);font-size:.72em;margin-left:3px}.status-dropdown-row .status-dropdown-name.uid-fallback{color:#ffd0b2}\n.tool-submenu{display:none;position:absolute;left:54px;top:0;min-width:170px;border:1px solid rgba(255,255,255,.12);border-radius:13px;background:rgba(6,10,14,.93);backdrop-filter:blur(10px);box-shadow:0 18px 42px rgba(0,0,0,.46);padding:6px;z-index:960}.tool-submenu.active{display:block}.tool-submenu button{display:block;width:100%;text-align:left;margin:2px 0;border:1px solid rgba(255,255,255,.08);border-radius:10px;background:rgba(255,255,255,.04);color:#dfe9ef;padding:7px 9px;font-size:.72rem;cursor:pointer}.tool-submenu button:hover{border-color:rgba(255,111,46,.45);background:rgba(255,111,46,.10)}\n.map-mini-toolbar.v233-mini{min-width:268px;max-width:min(470px,calc(100vw - 26px));gap:5px;align-items:center}.map-mini-toolbar.v233-mini input,.map-mini-toolbar.v233-mini select,.tak-floating-panel input,.tak-floating-panel textarea,.tak-floating-panel select{background:#091018;border:1px solid #334553;border-radius:9px;