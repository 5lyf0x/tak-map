}catch(_){}return out}
function takMapStampSelectionIdentityV478(group,o,sourceKey,primary){try{
  const meta=takMapSelectionDeleteMetaForObjectV478(o,sourceKey),owned=takMapSelectionOwnedLayersV478(o,primary);if(!owned.length)return null;
  try{o._takSelectionOwnedLayers=owned;if(meta){o._takSelectionDeleteMeta=Object.assign({},meta);o._takSelectionCanonicalId=meta.canonicalId}}catch(_){}
  for(const ownedLayer of owned){
    ownedLayer._takSelectionObject=o;ownedLayer._takSelectionOwnerGroup=group;ownedLayer._takSelectionOwnedLayers=owned;
    if(meta){ownedLayer._takSelectionDeleteMeta=Object.assign({},meta);ownedLayer._takSelectionCanonicalId=meta.canonicalId}
  }
  return meta
}catch(_){return null}}
function addObjectLayer(group,o,sourceKey){
  const cat=dataSyncCategory(o);let layer=null;const cen=objectCenter(o);
  try{
    if(cen&&(!isFiniteLatLon(o?.lat,o?.lon))){o.lat=cen[0];o.lon=cen[1]}
    if(cat==='Routes'){
      const pts=routeCoords(o);
      if(pts.length>=2){
        const dash=(o.lineStyle==='dashed'||o.style==='dashed'||o.line_style==='dashed'||o.route_style==='dashed')?'8,7':null;
        const popupHtml=layerPopupForObject(o,cat),popupOpts={autoPan:false,keepInView:false,autoClose:false,closeOnClick:false};
        layer=L.polyline(pts,{color:(o.color||'#ff7a1a'),weight:3,opacity:.9,dashArray:dash,bubblingMouseEvents:false}).bindPopup(popupHtml,popupOpts).addTo(group);
        try{
          /* The hit line must own an independent popup. Sharing the visible
             route's Popup instance makes Leaflet and the legacy popup managers
             disagree about which layer is pinned, so the popup opens and then
             immediately closes. */
          const hit=L.polyline(pts,{color:'#000',weight:16,opacity:0,interactive:true,bubblingMouseEvents:false}).addTo(group);
          hit.bindPopup(popupHtml,popupOpts);
          stabilizeLayerPopup(hit);
          o.__hitLayer=hit
        }catch(_){}
      }
    }else if(cat==='Shapes / Areas'){
      const pts=shapeCoords(o),flat=collectCoordPairs(pts);
      if(flat.length>=3)layer=L.polygon(pts,{color:'#ffb000',weight:2,fillOpacity:.18,bubblingMouseEvents:false}).bindPopup(layerPopupForObject(o,cat),{autoPan:false,keepInView:false,autoClose:false,closeOnClick:false}).addTo(group)
    }else if(cen){
      layer=L.marker(cen,{icon:dataSyncIcon(o)}).bindPopup(layerPopupForObject(o,cat)).addTo(group);
      layer.on('click',()=>map.panTo(cen,{animate:true}))
    }
  }catch(e){try{console.warn('Skipped invalid map object',o,e)}catch(_){}}
  if(layer){
    stabilizeLayerPopup(layer);o.__layer=layer;
    /* i478 propagates one explicit source-owned identity to every known representation. */
    try{takMapStampSelectionIdentityV478(group,o,sourceKey,layer)}catch(_){}
    const center=cen||objectCenter(o);
    if(center)addSearchItem(sourceKey||'datasync',(sourceKey==='imported'?'Imported ':'Data Sync ')+cat,o.callsign||o.name||o.uid||o.id||cat,center[0],center[1],layer,o)
  }
  return layer
}
async function centerDataSyncIndex(idx){await autoSaveActivePopupEdit('switch-data-sync-item');const o=(lastDataSync?.objects||[])[Number(idx)];const cen=objectCenter(o);if(!o||!cen)return;map.panTo(cen,{animate:true});if(o.__layer){setTimeout(()=>{try{o.__layer.openPopup()}catch(e){}},180)}}async function openDataSyncItemEdit(idx,ev){if(ev)ev.stopPropagation();await centerDataSyncIndex(idx);setTimeout(()=>{try{const box=document.querySelector('.leaflet-popup .popup-edit');if(box){box.open=true;popupEditToggle(box);const first=popupEditInputs(box)[0];if(first)first.focus()}}catch(e){}},320)}async function deleteDataSyncItem(idx,ev){if(ev&&ev.stopPropagation)ev.stopPropagation();const lifecycle=window.TakMapObjectLifecycleV486;if(lifecycle&&typeof lifecycle.deleteDataSyncItem==='function')return lifecycle.deleteDataSyncItem(idx,ev);alert('The TAK Map delete dialog is not ready. Reload TAK Map and try again.');return false}function drawDataSyncObjects(items){if(terrain3DActive){handleMapSearch();refreshTerrain3DObjects(false,'datasync');return}dataSyncLayer.clearLayers();clearSearchSource('datasync');if(!state.dataSync){handleMapSearch();refreshTerrain3DObjects(false,'datasync-off');return}for(let idx=0;idx<(items||[]).length;idx++){addObjectLayer(dataSyncLayer,items[idx],'datasync')}handleMapSearch();refreshTerrain3DObjects(false,'datasync')}function toggleDataSyncSection(kind){try{state.dataSyncCollapsed[kind]=!state.dataSyncCollapsed[kind];saveTakMapUiPrefs();renderDataSyncRows()}catch(e){try{console.warn('toggleDataSyncSection failed',e)}catch(_){}}}function renderDataSyncSection(kind,title,items,renderItem,limit){items=items||[];limit=limit||80;const collapsed=!!state.dataSyncCollapsed[kind];let html=`<div class="datasync-section ${collapsed?'collapsed':''}"><div class="datasync-section-title subgroup-title" onclick="toggleDataSyncSection('${kind}')" role="button" aria-expanded="${collapsed?'false':'true'}"><span class="toggle">${collapsed?'›':'⌄'}</span><span cl