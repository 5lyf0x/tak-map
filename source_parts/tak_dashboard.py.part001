  }
}catch(_){}return null}
function takMapSelectionOwnedLayersV478(o,primary){const out=[];function add(v){if(takMapSelectionLayerLikeV478(v)&&!out.includes(v))out.push(v)}try{
  add(primary);if(!o||typeof o!=='object')return out;
