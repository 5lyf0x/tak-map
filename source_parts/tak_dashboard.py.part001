e-space:nowrap}.sidebar,.sync-list,.search-results,.status-dropdown{scrollbar-width:thin;scrollbar-color:rgba(255,111,46,.62) rgba(255,255,255,.04)}.sidebar::-webkit-scrollbar,.sync-list::-webkit-scrollbar,.search-results::-webkit-scrollbar,.status-dropdown::-webkit-scrollbar{width:10px;height:10px}.sidebar::-webkit-scrollbar-track,.sync-list::-webkit-scrollbar-track,.search-results::-webkit-scrollbar-track,.status-dropdown::-webkit-scrollbar-track{background:rgba(255,255,255,.035);border-radius:999px}.sidebar::-webkit-scrollbar-thumb,.sync-list::-webkit-scrollbar-thumb,.search-results::-webkit-scrollbar-thumb,.status-dropdown::-webkit-scrollbar-thumb{background:linear-gradient(180deg,rgba(255,111,46,.75),rgba(255,204,102,.42));border-radius:999px;border:2px solid rgba(6,10,14,.92)}.search-dim{opacity:.24;filter:grayscale(.72)}.search-hit{filter:drop-shadow(0 0 12px rgba(255,111,46,.80))}.muted{color:var(--muted);font-size:.84rem}.danger{color:var(--bad);font-size:.84rem}.row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.055)}.row:last-child{border-bottom:0}.row label{display:flex;align-items:center;gap:8px;min-width:0}.row span{min-width:0}.row small{display:block;color:var(--muted);font-size:.72rem;margin-top:1px}.row input{accent-color:var(--accent)}.chip{border:1px solid rgba(255,111,46,.4);background:rgba(255,111,46,.08);border-radius:999px;padding:3px 8px;color:#ffd0b0;font-size:.72rem;white-space:nowrap}.subgroup{margin-top:8px}.subgroup-title{font-size:.72rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);margin:8px 0 3px}.map-footer{display:none!important}.sidebar.collapsed~.map-footer{left:14px}.aircraft-wrap{display:flex;flex-direction:column;align-items:center;pointer-events:none}.aircraft-glyph{width:38px;height:48px;display:block;overflow:visible;filter:drop-shadow(0 0 10px rgba(0,0,0,.82))}.aircraft-glyph.selected{filter:drop-shadow(0 0 12px currentColor)