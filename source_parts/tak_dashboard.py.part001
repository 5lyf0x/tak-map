el">Pin Coordinate</span></button><button class="tool-btn" onclick="coordClearPin()" title="Clear Pin"><svg viewBox="0 0 24 24"><path d="M12 21s6-6.1 6-11a6 6 0 0 0-12 0c0 4.9 6 11 6 11Z"/><circle cx="12" cy="10" r="1.8"/><path d="M4 20 20 4"/></svg><span class="tool-label">Clear Pin</span></button><button class="tool-btn" onclick="coordCopy()" title="Copy Coordinate"><svg viewBox="0 0 24 24"><rect x="8" y="5" width="11" height="13" rx="2"/><rect x="5" y="8" width="11" height="13" rx="2"/></svg><span class="tool-label">Copy Coordinate</span></button><button class="tool-btn" onclick="coordFormatToggle()" title="Format Toggle"><svg viewBox="0 0 24 24"><text x="2" y="8" font-size="6.5" font-weight="900" fill="currentColor" stroke="none">DD</text><text x="2" y="20" font-size="5" font-weight="900" fill="currentColor" stroke="none">MGRS</text><path d="M17.5 5.5l4 4-4 4"/><path d="M17.5 18.5l4-4-4-4" opacity=".82"/></svg><span class="tool-label">Format Toggle</span></button><button class="tool-btn" onclick="coordSaveLocalPoint()" title="Save Local Point"><svg viewBox="0 0 24 24"><path d="M9 20s5-5.2 5-9a5 5 0 0 0-10 0c0 3.8 5 9 5 9Z"/><circle cx="9" cy="11" r="1.4"/><rect x="12" y="12" width="8" height="8" rx="1"/><path d="M14 12v3h4v-3"/><path d="M14 18h4"/></svg><span class="tool-label">Save Local Point</span></button><button class="tool-btn" onclick="coordGoTo()" title="Go To Coordinate"><svg viewBox="0 0 24 24"><circle cx="11" cy="12" r="5"/><path d="M11 3v4"/><path d="M11 17v4"/><path d="M2 12h4"/><path d="M16 12h6"/><path d="M18 8l4 4-4 4"/></svg><span class="tool-label">Go To Coordinate</span></button></div><div id="measureMiniToolbar" class="map-mini-toolbar" aria-label="Measure tools"><button class="tool-btn" onclick="measureUndo()" title="Undo Last Point"><svg viewBox="0 0 24 24"><path d="M4 12 10 5h10v14H10Z"/><path d="M12 9l5 5"/><path d="M17 9l-5 5"/></svg><span class="tool-label">Undo Last Point</span></button><button class="tool-btn" onclick="measureClear()"