function shapeAreaSqMeters(o){try{const pts=collectCoordPairs(o?.coords||o);if(!pts||pts.length<3)return 0;const lat0=pts.reduce((a,p)=>a+Number(p[0]||0),0)/pts.length;const lon0=pts.reduce((a,p)=>a+Number(p[1]||0),0)/pts.length;const R=6378137;const xy=pts.map(p=>{const lat=Number(p[0])*Math.PI/180,lon=Number(p[1])*Math.PI/180;return {x:R*(lon-lon0*Math.PI/180)*Math.cos(lat0*Math.PI/180),y:R*(lat-lat0*Math.PI/180)}});let a=0;for(let i=0,j=xy.length-1;i<xy.length;j=i++){a+=(xy[j].x*xy[i].y-xy[i].x*xy[j].y)}return Math.abs(a/2)}catch(e){return 0}}
function shapeAreaPopupRows(o){const m2=shapeAreaSqMeters(o);if(!m2)return'';const sqft=m2*10.7639104167;return `<b>Area</b><span>${Math.round(sqft).toLocaleString()} sq ft · ${Math.round(m2).toLocaleString()} sq m</span>`}
function objectCenter(o){if(o&&isFiniteLatLon(o.lat,o.lon))return [Number(o.lat),Number(o.lon)];const pts=collectCoordPairs(o?.coords);if(pts.length)return [pts.reduce((a,p)=>a+p[0],0)/pts.length,pts.reduce((a,p)=>a+p[1],0)/pts.length];return null}function layerPopupForObject(o,cat){if(cat==='Point Markers')return pointPopupHtml(o,cat);const name=o?.name||o?.callsign||o?.uid||o?.id||cat;const notes=popupNotes(o);const cen=objectCenter(o);const coordText=cen?formatCoords(cen[0],cen[1]):formatCoords(o?.lat,o?.lon);const assetRow=(cat==='Shapes / Areas')?shapeAreaPopupRows(o):`<b>Asset</b><span>${esc(assetDescriptor(o))}</span>`;return `<div class="feature-popup"><h3>${esc(name)}</h3><div class="kvp"><b>Name</b><span>${esc(name)}</span><b>Added</b><span>${esc(addedTime(o))}</span><b>Coordinates</b><span>${esc(coordText)}</span>${assetRow}<b>Category</b><span>${esc(cat)}</span>${notes?`<b>Notes</b><span>${esc(notes)}</span>`:''}</div>${popupEditForm({...o,lat:cen?cen[0]:o?.lat,lon:cen?cen[1]:o?.lon},cat||'Data Sync')}</div>`}function takMapSelectionExplicitLocalIdV478(o){try{
  if(!o||typeof o!=='object')return '';
  const direct=String(o._local_id||o.local_id||'').trim();if(direct)return direct;
  const idx=o.import_feature_index!==undefined?String(o.import_feature_index).trim():'';
  const importId=o.import_id!==undefined?String(o.import_id).trim():'';if(importId&&idx)return importId+':'+idx;
  const importName=o.import_name!==undefined?String(o.import_name).trim():'';if(importName&&idx)return importName+':'+idx;
}catch(_){}return ''}
function takMapSelectionLayerLikeV478(v){try{return !!(v&&typeof v==='object'&&(typeof v.getLatLng==='function'||typeof v.getLatLngs==='function'||typeof v.getBounds==='function'||typeof v.addTo==='function'||typeof v.remove==='function'))}catch(_){return false}}
function takMapSelectionDeleteMetaForObjectV478(o,sourceKey){try{
  if(!o||typeof o!=='object')return null;
  if(sourceKey==='imported'||sourceKey==='local'){
    const localId=takMapSelectionExplicitLocalIdV478(o);
    if(localId)return {supported:true,kind:'local',canonicalId:'local:'+localId,localId:localId,source:'Local Data',identityOrigin:'source-object'};
    return null
  }
  if(sourceKey==='datasync'||sourceKey==='data-sync'||!sourceKey){
    const stableId=String(o.uid||o.id||'').trim();if(!stableId)return null;
    const source=String(o.source||o.source_table||'Data Sync').trim()||'Data Sync';
    let key='';try{if(typeof popupEditKey==='function')key=popupEditKey(Object.assign({},o,{uid:o.uid||'',id:o.id||''}))}catch(_){}
    if(!key)key=source+':'+stableId;
